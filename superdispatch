          // Pax count
          const paxMatch = lower.match(/(\d+)[-\s]*(?:passenger|pax|seater?)/);
          const paxCount = paxMatch ? Math.min(6, Math.max(1, parseInt(paxMatch[1]))) : 4;
          // Named-rotor counts (tricopter/hexa/octo/etc) and explicit N rotors
          const NAMED = { 'bicopter':2,'bi-copter':2,'tricopter':3,'tri-copter':3,'tri copter':3,'quadcopter':4,'quad-copter':4,'quadrotor':4,'pentacopter':5,'hexacopter':6,'hex-copter':6,'hexarotor':6,'septacopter':7,'septcopter':7,'octocopter':8,'oct-copter':8,'octacopter':8,'octorotor':8,'decacopter':10,'dodecacopter':12 };
          let totalRotors = null;
          let isCopterSuffix = false;     // true if the count came from "X-copter" (means drone style)
          for (const [name, n] of Object.entries(NAMED)) {
            if (lower.includes(name)) { totalRotors = n; isCopterSuffix = true; break; }
          }
          const rotorCountMatch = lower.match(/(\d+)\s*(?:rotors?|propellers?|motors?|fans?|thrusters?|ducts?|props?)/);
