      pointer-events: none;
    }

    .fleet-route-info {
      position: absolute;
      top: 18px;
      left: 18px;
      display: flex;
      align-items: center;
      gap: 12px;
      font-family: var(--font-mono);
      font-size: 11px;
      letter-spacing: 0.06em;
      background: rgba(2, 8, 23, 0.78);
      border: 1px solid var(--border-hi);
      padding: 8px 14px;
      border-radius: 3px;
      backdrop-filter: blur(6px);
