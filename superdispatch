      // Avoid picking the same variant two clicks in a row per brand —
      // small UX touch so repeated clicks feel meaningfully different.
      const _lastVariantIdx = {};
      function pickBrandVariant(brand) {
        const pool = BRAND_VARIANTS[brand];
        if (!pool || pool.length === 0) return null;
        if (pool.length === 1) return pool[0];
        let idx;
        const lastIdx = _lastVariantIdx[brand];
        do { idx = Math.floor(Math.random() * pool.length); }
        while (idx === lastIdx);
        _lastVariantIdx[brand] = idx;
        return pool[idx];
      }

      async function buildBrandVariant(brand) {
        const variant = pickBrandVariant(brand);
        if (!variant) return;
        if (typeof pushUndo === 'function') pushUndo();
        if (typeof buildEVTOL === 'function' && variant.spec) {
          buildEVTOL(variant.spec);
        }
        // Apply variant livery via the existing paint pipeline so the
        // user can still re-paint manually afterward without surprises.
        if (variant.color && typeof parseCommand === 'function' && typeof executeCommand === 'function') {
          try {
            const parsed = parseCommand(`paint it ${variant.color}`);
            await executeCommand(parsed);
          } catch (e) { console.warn('Variant paint failed:', e); }
        }
        // Echo the chosen variant + architecture to the AI history pane
        // so the user can see exactly what changed (not just the visuals).
        const hist = document.getElementById('ai-history');
        const label = `${brand.toUpperCase()} · ${variant.name}`;
        const subLabel = variant.arch || '';
        if (hist) {
          const div = document.createElement('div');
          div.className = 'chat-msg ai info';
          div.innerHTML = `<div class="chat-result"><span class="check">▸</span><span class="val">${label}</span>${subLabel ? ' · ' + subLabel : ''}</div>`;
          hist.appendChild(div);
          hist.scrollTop = hist.scrollHeight;
