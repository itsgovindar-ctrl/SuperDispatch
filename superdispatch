          // Determine target (default primary)
          let target = 'primary';
          if (/\baccent\b/.test(lower)) target = 'accent';
          else if (/\btrim\b/.test(lower)) target = 'trim';
          const verb = target === 'primary' ? 'paint it' : `make ${target}`;
          return [{
            label: `Apply ${colorParseResult.name} paint to ${target}`,
            cmd: `${verb} ${colorParseResult.hex}`
          }];
        }

        // Other short single-edit commands (move/remove/scale) also bypass the
        // full aircraft builder
        const isSingleEditVerb = /^\s*(move|translate|rotate|scale|resize|remove|delete|drop|hide|show|wireframe|solid)\b/.test(lower);
        if (isShortPrompt && isSingleEditVerb) {
          // Fall through to legacy path (which handles single-edit verbs correctly)
        } else {

        // ===== SPEC-DRIVEN MONOLITHIC FAST-PATH =====
        // For any "build an aircraft" prompt, extract a spec from the description
        // and call the coordinated buildEVTOL function. This produces photo-style
        // geometry instead of stacking primitives blindly. Knowledge baked in:
        // Archer/Joby/Volocopter/EHang patterns mapped to placement options.
        // Falls through to legacy path only if the user wants raw CAD commands
        // (single-part instructions like "add a box" without a vehicle context).
        const looksLikeAircraftPrompt = /\b(aircraft|evtol|air taxi|drone|copter|rotor|airframe|hover|fly|midnight|joby|archer|volo|ehang|lilium|stol|hybrid|build|create|design)\b/.test(lower)
          // "make" alone is too generic — only treat as aircraft prompt if combined with other aircraft keywords
          || (/\bmake\b/.test(lower) && /\b(an?|the|new|fresh|complete|full)\s+\w*\s*(aircraft|evtol|air.?taxi|drone|copter|rotor)\b/.test(lower));
