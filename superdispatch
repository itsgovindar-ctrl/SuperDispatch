    function getOperatorFlights() {
      try {
        const raw = localStorage.getItem(OPERATOR_FLIGHTS_KEY);
        const n = parseInt(raw || '0', 10);
        return Number.isFinite(n) && n >= 0 ? n : 0;
      } catch (e) {
        return 0;
      }
    }
    function getCustomerFlights() {
      try {
        const raw = localStorage.getItem(CUSTOMER_FLIGHTS_KEY);
        const n = parseInt(raw || '0', 10);
        return Number.isFinite(n) && n >= 0 ? n : 0;
      } catch (e) {
        return 0;
      }
    }
    // Back-compat function — operator counter is what was previously
    // displayed as "total flights" in code that hasn't been updated yet.
    function getTotalFlights() {
      return getOperatorFlights();
    }

    // Increment helpers. These are the ONLY sites that write to the
    // FLIGHTS_KEYs in the user-flow — bg simulation pools no longer
    // touch counters at all (per user: "have the counters be the same
    // number 0 and 0, unless there are multistop flights").
    //
    //   incrementOperatorFlights() — call at dispatch (mission sent
    //     to aircraft). One increment per mission, regardless of
    //     stops. User said: "the mission gets sent to the aircraft
    //     at that moment the operator count should update."
    //   incrementCustomerFlights() — call at customer dropoff
    //     (customer delivered). For single-stop missions this fires
    //     once per mission (matching the operator increment, so the
    //     two counters stay equal). For multistop missions, it fires
    //     once per dropoff, so customer can exceed operator.
    function incrementOperatorFlights() {
      try {
        const next = getOperatorFlights() + 1;
        localStorage.setItem(OPERATOR_FLIGHTS_KEY, String(next));
      } catch (_) { /* localStorage full; counter ticks next dispatch */ }
      pushRecentEvent('operator', 'Mission dispatched');
      try { updateSplashOperatorFlights(); } catch (_) {}
      try { updateSplashTotalFlights(); } catch (_) {}
      // Force the fleet sync heartbeat to retick immediately so all
      // surfaces (splash + hub sidebar) reflect the new state without
      // waiting up to 1s for the next interval.
      try { if (typeof window !== 'undefined' && window.__tickFleetSync) window.__tickFleetSync(); } catch (_) {}
    }
    function incrementCustomerFlights() {
      try {
        const next = getCustomerFlights() + 1;
        localStorage.setItem(CUSTOMER_FLIGHTS_KEY, String(next));
      } catch (_) { /* localStorage full; counter ticks next dropoff */ }
      pushRecentEvent('customer', 'Customer dropoff');
      try { updateSplashCustomerFlights(); } catch (_) {}
      try { if (typeof window !== 'undefined' && window.__tickFleetSync) window.__tickFleetSync(); } catch (_) {}
    }

    // Recent-events ring buffer. The CREW ACTIVITY section reads this
    // when no live crew figures are visible (which is the splash's
    // normal state — crew only spawns inside the launch pad scene).
    // User: "I need a summary of what is going on here." So instead
    // of just saying "Hub idle", show the most recent dispatches and
    // dropoffs as a live feed with relative timestamps. Capacity 12
    // — enough to show a minute's worth of activity in steady state
    // without growing unbounded. Pushes happen at the moment each
    // counter ticks, so the feed mirrors exactly what's happening in
    // the simulated network.
    // Recent events ring buffer — persisted across sessions so the
    // user doesn't see "Watching network..." every reload as if
    // nothing ever happened. User: "it starts from scratch when i
    // open. should represent data."
    //
    // Uses Date.now() (wall-clock) for timestamps so age computes
    // correctly across reloads. Stored in localStorage; entries
    // older than 1 hour are dropped on load to keep the feed
    // relevant. Ring buffer is small (max 12) so the localStorage
    // write per push is trivial.
    const RECENT_EVENTS_KEY = 'sdx_recent_events_v1';
    const RECENT_EVENTS_MAX_AGE_MS = 60 * 60 * 1000;     // 1 hour
    function loadRecentEvents() {
      try {
        const raw = localStorage.getItem(RECENT_EVENTS_KEY);
        if (!raw) return [];
        const arr = JSON.parse(raw);
        if (!Array.isArray(arr)) return [];
        const cutoff = Date.now() - RECENT_EVENTS_MAX_AGE_MS;
        return arr
          .filter(e => e && typeof e.t === 'number' && e.t >= cutoff && e.kind && e.label)
          .slice(0, 12);
      } catch (_) {
        return [];
      }
    }
    function saveRecentEvents() {
      try {
        if (typeof window === 'undefined' || !window.__recentEvents) return;
        localStorage.setItem(RECENT_EVENTS_KEY, JSON.stringify(window.__recentEvents));
      } catch (_) { /* best-effort — quota errors swallowed */ }
    }
    if (typeof window !== 'undefined') {
      // Restore from previous session
      window.__recentEvents = loadRecentEvents();
    }
    function pushRecentEvent(kind, label) {
      try {
        if (typeof window === 'undefined') return;
        if (!window.__recentEvents) window.__recentEvents = [];
        // Wall-clock timestamp (Date.now), not performance.now —
        // performance.now resets every page load and would make
        // persisted events look like they're from the future.
        const now = Date.now();
        window.__recentEvents.unshift({ kind, label, t: now });
        // Cap at 12 entries
        if (window.__recentEvents.length > 12) {
          window.__recentEvents.length = 12;
        }
        saveRecentEvents();
      } catch (_) { /* best-effort */ }
    }
    if (typeof window !== 'undefined') {
      window.__pushRecentEvent = pushRecentEvent;
      window.__loadRecentEvents = loadRecentEvents;
      window.__saveRecentEvents = saveRecentEvents;
    }

    // ============================================================
    // FAULT HISTORY — persistent per-kind tally
    // ============================================================
    // User: "Fault injections need to be counted on the splash screen."
    // We persist a running count of every fault that has manifested
    // so the splash can show total + per-kind breakdown across
    // sessions. Increments happen at the abort-phase trigger (where
    // the failure becomes real, not at fault-roll which can race
    // before the abort actually plays out).
    const FAULT_HISTORY_KEY = 'sdx_fault_history_v1';
    function loadFaultHistory() {
      try {
        const raw = localStorage.getItem(FAULT_HISTORY_KEY);
        if (!raw) return { total: 0, byKind: {} };
        const obj = JSON.parse(raw);
        if (!obj || typeof obj !== 'object') return { total: 0, byKind: {} };
        return {
          total: typeof obj.total === 'number' ? obj.total : 0,
          byKind: (obj.byKind && typeof obj.byKind === 'object') ? obj.byKind : {},
        };
      } catch (_) { return { total: 0, byKind: {} }; }
    }
    function recordFault(kind) {
      try {
        const h = loadFaultHistory();
        h.total = (h.total || 0) + 1;
        if (kind) h.byKind[kind] = (h.byKind[kind] || 0) + 1;
        localStorage.setItem(FAULT_HISTORY_KEY, JSON.stringify(h));
        // Refresh splash if currently visible
        try {
          if (typeof updateSplashFaultCounter === 'function') updateSplashFaultCounter();
        } catch (_) {}
      } catch (err) { console.warn('[fault history] record failed:', err); }
    }
    if (typeof window !== 'undefined') {
      window.__loadFaultHistory = loadFaultHistory;
      window.__recordFault = recordFault;
    }

    // Re-renders the splash fault counter from persisted state. Idempotent.
    function updateSplashFaultCounter() {
      try {
        const h = loadFaultHistory();
        const totalEl = document.getElementById('splash-fault-total');
        if (totalEl) totalEl.textContent = String(h.total || 0);
        const breakdownEl = document.getElementById('splash-fault-breakdown');
        if (breakdownEl) {
          const order = ['motor_out', 'battery_thermal', 'control_link_loss', 'avionics_failure', 'compressor_stall'];
          const labels = {
            motor_out: 'motor', battery_thermal: 'thermal', control_link_loss: 'link',
            avionics_failure: 'avionics', compressor_stall: 'stall',
          };
          breakdownEl.innerHTML = order.map(k => {
            const n = h.byKind[k] || 0;
            return `<span class="splash-fault-cell"><b>${n}</b><em>${labels[k]}</em></span>`;
          }).join('');
        }
      } catch (_) {}
    }
    if (typeof window !== 'undefined') window.__updateSplashFaultCounter = updateSplashFaultCounter;

    // ============================================================
    // FAULT INJECTION
    // ============================================================
    // User: "add random failures that cause the air taxi to return
    // back mainly motor outs, and other critical failures. the
    // failure rate should be proportional to the fleet count. but
    // not high, not low like 3-5%."
    //
    // Roll happens at dispatch time for customer flights. If a
    // failure is rolled, the mission's post-pickup phases are
    // replaced with an abort-and-return-to-hub trajectory. The
    // failure manifests at a random fraction (40-80%) of the
    // outbound-to-pickup cruise — late enough to be plausibly
    // detected by avionics, early enough that the customer hasn't
    // been picked up yet (the user said "going from navigation only
    // when the taxi is on the way to pickup").
    //
    // Failure types (severity-ordered, all critical enough to abort):
    //   - motor_out         (most common — single motor lost)
    //   - battery_thermal   (battery temp out of bounds)
    //   - control_link_loss (datalink degraded, return per LOST_LINK procedure)
    //   - avionics_failure  (flight computer fault)
    //   - compressor_stall  (less common, applies to turbine variants)
    const FAILURE_TYPES = [
      { kind: 'motor_out',         weight: 0.45, label: 'motor out' },
      { kind: 'battery_thermal',   weight: 0.18, label: 'battery thermal event' },
      { kind: 'control_link_loss', weight: 0.18, label: 'control link loss' },
      { kind: 'avionics_failure',  weight: 0.12, label: 'avionics failure' },
      { kind: 'compressor_stall',  weight: 0.07, label: 'compressor stall' },
    ];
    function rollFlightFailure(fleetSize) {
      // Failure rate scales with fleet size: starts at 3% with a
      // small fleet, climbs toward 5% as the fleet grows. Each
      // additional aircraft beyond 5 adds 0.2% to the rate. Cap at
      // 5%. User: "not high, not low like 3-5%."
      const baseRate = 0.03;
      const perAircraftBonus = 0.002;
      const maxRate = 0.05;
      const fleetBonus = Math.max(0, (fleetSize || 0) - 5) * perAircraftBonus;
      const rate = Math.min(maxRate, baseRate + fleetBonus);
      if (Math.random() >= rate) return null;
      // Weighted pick among failure types
      const totalWeight = FAILURE_TYPES.reduce((s, t) => s + t.weight, 0);
      let r = Math.random() * totalWeight;
      let chosen = FAILURE_TYPES[0];
      for (const t of FAILURE_TYPES) {
        r -= t.weight;
        if (r <= 0) { chosen = t; break; }
      }
      return {
        kind: chosen.kind,
        label: chosen.label,
        // Where in the outbound cruise the failure manifests
        // (40-80% so the user sees the aircraft go partway out
        // before turning around — too early feels suspicious,
        // too late and the customer is almost picked up)
        manifestAtFraction: 0.40 + Math.random() * 0.40,
      };
    }
    // Mutate the mission.phases array IN PLACE to abort during the
    // outbound-to-pickup cruise. The mission is given to the dispatch
    // record by reference, so editing this array means the 2D and 3D
    // animators (which both read flight.phases) see the abort
    // trajectory directly.
    function applyFailureToMission(mission, failure) {
      if (!mission || !mission.phases || !failure) return false;
      const phases = mission.phases;
      // Find the outbound-to-pickup cruise phase. Schema:
      //   [0] preflight, [1] vertical_climb, [2] CRUISE outbound to pickup,
      //   [3] vertical_descent at pickup, [4] hover boarding, ...
      const outboundIdx = phases.findIndex((p, i) =>
        p.kind === 'cruise' && i >= 2 && p.withPassenger === false &&
        p.label && /to pickup/i.test(p.label));
      if (outboundIdx < 0) return false;
      const outbound = phases[outboundIdx];
      // Truncate the outbound cruise to the manifest fraction. After
      // that, the aircraft turns around at its current position and
      // flies back to hub.
      const fraction = Math.max(0.20, Math.min(0.85, failure.manifestAtFraction || 0.6));
      const truncatedDur = Math.max(60, outbound.dur * fraction);
      // Build the abort phases. We splice everything after the
      // truncated outbound cruise and replace with:
      //   - a shorter "aborting · returning to hub" cruise (mirror
      //     of the truncated outbound)
      //   - vertical_descent at hub
      //   - docked at hub
      // Pull the durations from the LAST phases of the original
      // mission so visible time stays roughly consistent.
      const dropoffDescent = phases.find(p => p.kind === 'vertical_descent' && p.label && /hub/i.test(p.label || ''));
      const docked = phases[phases.length - 1] && phases[phases.length - 1].kind === 'docked'
        ? phases[phases.length - 1] : { kind: 'docked', dur: 32, label: 'docked, charging' };
      const VERT_DESCENT_SEC = (dropoffDescent && dropoffDescent.dur) || 540;
      // Distance flown out before manifesting = truncated outbound miles
      const milesOut = (outbound.miles || 0) * fraction;
      const ABORT_RETURN_SEC_PER_MILE = 11;     // empty cruise speed
      const abortReturn = {
        kind: 'cruise',
        from: outbound.to,                    // start position is where we turned around (best-approx)
        to: phases[0].from,                   // back to hub
        dur: 8 + milesOut * ABORT_RETURN_SEC_PER_MILE,
        miles: milesOut,
        label: `ABORT — return to hub (${failure.label})`,
        withPassenger: false,
        levelFlight: true,
        isAbortLeg: true,
      };
      const abortDescent = {
        kind: 'vertical_descent',
        from: phases[0].from,
        to: phases[0].from,
        dur: VERT_DESCENT_SEC,
        label: 'vertical descent · emergency return',
        isAbortLeg: true,
      };
      // Truncate the outbound cruise
      outbound.dur = truncatedDur;
      outbound.label = `${outbound.label} · ${failure.label.toUpperCase()} DETECTED`;
      outbound.miles = milesOut;
      outbound.failureManifests = true;
      // Splice everything after the outbound with the abort sequence
      phases.splice(outboundIdx + 1, phases.length - outboundIdx - 1,
        abortReturn, abortDescent, docked);
      // Recompute totalMiles
      mission.totalMiles = milesOut * 2;     // out + back
      return true;
    }
    if (typeof window !== 'undefined') {
      window.__rollFlightFailure = rollFlightFailure;
      window.__applyFailureToMission = applyFailureToMission;
      window.__FAILURE_TYPES = FAILURE_TYPES;
    }

    // ============================================================
    // FLEET BATTERY PERSISTENCE
    // ============================================================
    // User: "it starts from scratch when i open. should represent
    // data." So each aircraft's battery state (charge level +
    // charging flag + last-update wall-clock time) is persisted to
    // localStorage. On launchpad open, batteries are restored and
    // ADVANCED for the wall-clock time the user was away — aircraft
    // sitting on the apron continue to charge at 1.5%/sec exactly
    // as they would in-session, capped at 95%. This makes the open
    // state reflect what actually happened: a heavily-flown aircraft
    // returns drained (still recharging), a never-flown aircraft
    // remains topped off. Active flights are NOT persisted (they're
    // runtime-only state that ends with the tab closing).
    const FLEET_BATTERY_MAX_SOC = 95;
    const FLEET_BATTERY_CHARGE_RATE = 1.5;     // %/sec — matches in-session rate

    function loadFleetBatteryState() {
      try {
        const raw = localStorage.getItem(FLEET_BATTERY_KEY);
        if (!raw) return {};
        const obj = JSON.parse(raw);
        if (!obj || typeof obj !== 'object') return {};
        // Advance each entry for wall-clock time elapsed since lastWallMs.
        // Each entry shape: { battery, isCharging, lastWallMs }. We use
        // wall-clock (Date.now) here, not performance.now, because the
        // persisted timestamp must survive across sessions where
        // performance.now resets to 0.
        const nowWall = Date.now();
        const out = {};
        for (const [id, entry] of Object.entries(obj)) {
          if (!entry || typeof entry.battery !== 'number') continue;
          const elapsedSec = Math.max(0, (nowWall - (entry.lastWallMs ?? nowWall)) / 1000);
          // Only advance charging if it WAS charging when saved (or if
          // it's just below MAX_SOC). Don't speculatively recharge a
          // 95% aircraft to 95.0001%.
          let battery = entry.battery;
          if (battery < FLEET_BATTERY_MAX_SOC - 0.05) {
            battery = Math.min(FLEET_BATTERY_MAX_SOC, battery + FLEET_BATTERY_CHARGE_RATE * elapsedSec);
          }
          out[id] = {
            battery,
            isCharging: battery < FLEET_BATTERY_MAX_SOC - 0.05,
            // lastUpdate is performance.now() in-session; we leave it
            // unset here so the in-session battery loop initializes
            // it correctly on first tick after load.
          };
        }
        return out;
      } catch (_) {
        return {};
      }
    }

    // Save the entire battery map. Throttled by the caller — the in-session
    // tick should only invoke this every ~2s to avoid hammering localStorage.
    function saveFleetBatteryState(batteryMap) {
      try {
        if (!batteryMap || typeof batteryMap.forEach !== 'function') return;
        const obj = {};
        const nowWall = Date.now();
        batteryMap.forEach((entry, id) => {
          if (!entry || typeof entry.battery !== 'number') return;
          obj[id] = {
            battery: entry.battery,
            isCharging: !!entry.isCharging,
            lastWallMs: nowWall,
          };
        });
        localStorage.setItem(FLEET_BATTERY_KEY, JSON.stringify(obj));
      } catch (_) { /* localStorage full or unavailable */ }
    }
    if (typeof window !== 'undefined') {
      window.__loadFleetBatteryState = loadFleetBatteryState;
      window.__saveFleetBatteryState = saveFleetBatteryState;
    }

    function getAllFlightLogs() {
      try {
        const raw = localStorage.getItem(FLIGHT_LOGS_KEY);
        if (!raw) return {};
        const obj = JSON.parse(raw);
        return (obj && typeof obj === 'object') ? obj : {};
      } catch (e) {
        return {};
      }
    }

    function getFlightLogsForDesign(designId) {
      const all = getAllFlightLogs();
      const list = all[designId];
      return Array.isArray(list) ? list : [];
    }

    function recordFlightCompletion(entry) {
      // entry: { designId, tail, from, to, customer, totalMiles, durSec }
      // Pushes onto the per-design log array. Counter increments are
      // handled separately:
      //   - OPERATOR FLIGHTS: incrementOperatorFlights() at dispatch
      //   - CUSTOMER FLIGHTS: incrementCustomerFlights() at dropoff
      // This function only writes the per-design "X flights completed"
      // log (which represents missions completed back at hub). Called
      // from the 2D animator at TOTAL_MS = mission fully complete.
      //
      // The localStorage write is best-effort — if localStorage is full
      // / unavailable, we just log and continue (flight still completes
      // visually).
      try {
        const all = getAllFlightLogs();
        if (entry.designId) {
          if (!Array.isArray(all[entry.designId])) all[entry.designId] = [];
          all[entry.designId].push({
            tail: entry.tail || '',
            from: entry.from || '',
            to:   entry.to   || '',
            customer:   entry.customer   || '',
            totalMiles: entry.totalMiles || 0,
            durSec:     entry.durSec     || 0,
            completedAt: Date.now(),
          });
          // No artificial cap on log length — let the user accumulate as
          // many flight records as they want. If localStorage's quota is
          // ever hit, the design-save path's catch-and-prune handler in
          // persistDesigns() will drop the oldest logs to make room
          // (designs are higher-value than logs). Until then, no limit.
          try {
            localStorage.setItem(FLIGHT_LOGS_KEY, JSON.stringify(all));
          } catch (writeErr) {
            // Quota hit on log write specifically — prune logs to half size
            // and retry, so the new entry isn't silently dropped.
            const isQuota = (writeErr && (writeErr.name === 'QuotaExceededError' ||
                                          writeErr.code === 22 || writeErr.code === 1014 ||
                                          /quota/i.test(writeErr.message || '')));
            if (isQuota) {
              for (const key of Object.keys(all)) {
                if (Array.isArray(all[key]) && all[key].length > 50) {
                  all[key] = all[key].slice(-50);
                }
              }
              try {
                localStorage.setItem(FLIGHT_LOGS_KEY, JSON.stringify(all));
              } catch (_) { /* give up; entry lost but counter survived */ }
            } else {
              throw writeErr;
            }
          }
        }
      } catch (e) {
        console.warn('flight log write failed:', e);
      }
      // Refresh splash counter if it's currently visible
      try { updateSplashTotalFlights(); } catch (_) {}
      // Live-update the YOUR HANGAR panel's per-design flight counts
      // so users see the count tick up the moment a flight completes
      // (instead of being stale until the next full panel re-render).
      try { updateHangarFlightCounts(); } catch (_) {}
    }

    // Updates the OPERATOR counter — your flights from the launchpad.
    // Static between events; only changes when you dispatch or a flight
    // completes. Includes:
    //   - persisted operator total (your completed dispatches)
    //   - currently in-flight operator/customer-mode flights from
    //     window.__padFlightStates (these will increment the persisted
    //     total when they complete; counted live so the displayed value
    //     stays consistent across the completion event)
    // Updates the OPERATOR counter. Three sources of activity, summed:
    //   - persisted operator total (your completed dispatches +
    //     other-operators' completed flights — both write to the same
    //     OPERATOR_FLIGHTS_KEY so the displayed total represents the
    //     wider operator network's activity)
    //   - your currently in-flight dispatches (window.__padFlightStates)
    //   - other operators' currently in-flight aircraft (background
    //     operator fleet pool — simulates other taxi companies in the
    //     network sending flights)
    // The user explicitly asked: "I can't be the only operator. have
    // other operators as well sending flights, and update the counter
    // ============================================================
    // FLEET STATE — single source of truth
    // ============================================================
    // User: "14/14 can't be printed like this if it is not actually
    // true. you see the sync bug." The bug was that three different
    // call sites computed "in flight" three different ways:
    //   - splash availability subline: only padFlightStates  (BROKEN)
    //   - launchpad sidebar X/N IN FLIGHT: only padFlightStates (BROKEN)
    //   - FLEET section "X AIRBORNE": padFlightStates ∪ bg op pool (CORRECT)
    //   - hub apron renderer: padFlightStates ∪ bg op pool (CORRECT)
    // So the splash could show "14/14 available" while the FLEET
    // section right next to it showed "8 yours flying" — same fleet,
    // contradicting itself in pixels touching each other.
    //
    // computeFleetState() is now the ONLY way to ask "what's flying,
    // what's charging, what's available". Every display reads from
    // it. Single source of truth, no drift.
    function computeFleetState() {
      const designs = (typeof getAllSavedDesigns === 'function') ? getAllSavedDesigns() : [];
      const flightStates = (typeof window !== 'undefined' && window.__padFlightStates) || [];
      // launchpadInFlightIds = ACTIVE flights only (used as the canonical
      // "scene visible" set for the apron renderer's hide logic).
      const launchpadInFlightIds = new Set(
        flightStates.filter(f => f && f.active && f.designId).map(f => f.designId)
      );
      // visibleInFlight = active OR transitioning. This is the count
      // displayed by labels that say "X IN FLIGHT" — the splash subline
      // and the hub badge both read this so they match what the user
      // sees on the map. User: "how is it that 1 in flight on hub and
      // 4 in flight on splash subline." Same words, must mean the
      // same thing. The map shows aircraft until their transitioning
      // clone fully despawns, so the count must include transitioning.
      const visibleInFlightIds = new Set(
        flightStates.filter(f => f && (f.active || f.transitioning) && f.designId).map(f => f.designId)
      );
      const bgOpFleet = (typeof window !== 'undefined' && window.__backgroundOperatorFleet) || [];
      const bgOpDesignIds = new Set(
        bgOpFleet.filter(f => f && f.designId).map(f => f.designId)
      );
      const customerActive = !!(typeof window !== 'undefined' && window.__customerModeActive);
      const customerAircraftId = customerActive ? window.__customerAircraftId : null;
      // Union: a design is in flight (any pool, any kind) if it's in
      // EITHER pool, plus the customer's hailed taxi during customer
      // mode. Used for "available to send" math because abstract bg
      // simulations also commit a design — it's not truly available.
      const inFlightIds = new Set([...launchpadInFlightIds, ...bgOpDesignIds]);
      if (customerAircraftId) inFlightIds.add(customerAircraftId);
      const pendingIds = (typeof window !== 'undefined' && window.__pendingDispatchIds) || new Set();
      const batteries = (typeof window !== 'undefined' && window.__padDesignBatteries) || null;
      const MIN_BATTERY_TO_LAUNCH = 95 - 0.05;
      // Classify every design EXACTLY ONCE. Mutually exclusive
      // categories so total counts match the fleet size.
      let inFlight = 0, prepping = 0, charging = 0, available = 0;
      for (const d of designs) {
        if (inFlightIds.has(d.id)) { inFlight++; continue; }
        if (pendingIds.has && pendingIds.has(d.id)) { prepping++; continue; }
        if (batteries) {
          const entry = batteries.get(d.id);
          if (entry && entry.battery !== undefined && entry.battery < MIN_BATTERY_TO_LAUNCH) {
            charging++;
            continue;
          }
        }
        available++;
      }
      return {
        total: designs.length,
        inFlight,
        // visibleInFlight = aircraft visible in launchpad scene
        // (active OR transitioning). The number displayed when a
        // label says "X IN FLIGHT" — must match what the map shows.
        visibleInFlight: visibleInFlightIds.size,
        prepping,
        charging,
        available,
        // Expose the underlying ID set for renderers that need to
        // know WHICH designs are flying (apron, sidebar)
        inFlightIds,
        launchpadInFlightIds,
        visibleInFlightIds,
        bgOpDesignIds,
      };
    }
    if (typeof window !== 'undefined') {
      window.__computeFleetState = computeFleetState;
    }

    // there too in non customer mode." This satisfies that.
    function updateSplashOperatorFlights() {
      const el = document.getElementById('splash-operator-flights');
      const liveEl = document.getElementById('splash-operator-live');
      const availEl = document.getElementById('splash-operator-available');
      const persisted = getOperatorFlights();
      const flightStates = (typeof window !== 'undefined' && window.__padFlightStates) || [];
      const yourActiveNow = flightStates.filter(f => f && f.active).length;
      const otherOperatorFleet = (typeof window !== 'undefined' && window.__backgroundOperatorFleet) || [];
      const otherOperatorsActiveNow = otherOperatorFleet.length;
      const totalActive = yourActiveNow + otherOperatorsActiveNow;
      // Big number = persisted ticks ONLY. User: "have the counters be
      // the same number 0 and 0." The displayed value must match what
      // was ticked by real semantic events (dispatch for operator,
      // dropoff for customer) — not be inflated by live in-flight
      // counts from bg simulation pools. Live activity has its own
      // subline below.
      if (el) el.textContent = persisted.toLocaleString();
      // Operator-side live subline — HONEST about what's actually
      // happening. User: "this needs to update saying that there are
      // no flights, can't say this if it is not happening." Rules:
      //   - "X YOURS IN FLIGHT" any time the user has real flights
      //     airborne (verifiable in __padFlightStates).
      //   - "X OTHER OPERATORS" only when persisted > 0 (the network
      //     has shown real activity at least once). Until that point,
      //     the bg simulation pool is just a spawn buffer the user
      //     hasn't seen confirmed via a real counter tick — claiming
      //     it as live activity creates the "splash lies" feeling
      //     the user reported.
      //   - Otherwise hide the live line entirely (silence is honest).
      if (liveEl) {
        const networkHasRealActivity = persisted > 0;
        if (yourActiveNow > 0 && otherOperatorsActiveNow > 0 && networkHasRealActivity) {
          liveEl.textContent = `⏵ ${yourActiveNow} YOURS · ${otherOperatorsActiveNow} OTHERS`;
          liveEl.style.display = '';
        } else if (yourActiveNow > 0) {
          liveEl.textContent = `⏵ ${yourActiveNow} YOURS IN FLIGHT`;
          liveEl.style.display = '';
        } else if (otherOperatorsActiveNow > 0 && networkHasRealActivity) {
          liveEl.textContent = `⏵ ${otherOperatorsActiveNow} OTHER OPERATORS`;
          liveEl.style.display = '';
        } else {
          liveEl.style.display = 'none';
        }
      }
      // "X available to send" — your saved designs that aren't currently
      // in flight, not reserved by a worker walking to them, and not
      // charging. NOW USES computeFleetState() so the numbers stay
      // synced with the FLEET section, the launchpad sidebar, and the
      // hub apron. User: "14/14 can't be printed like this if it is
      // not actually true. you see the sync bug."
      if (availEl) {
        const fs = computeFleetState();
        if (fs.total === 0) {
          availEl.textContent = 'design an aircraft to send flights';
        } else {
          // Build breakdown — only show statuses that are non-zero, so
          // the line stays compact when nothing's happening.
          //
          // "X in flight" here refers to VISIBLE aircraft in the
          // launchpad scene — same definition the hub badge uses.
          // User: "1/14 IN FLIGHT" (hub) vs "4 in flight" (splash) —
          // the labels must mean the same thing. Splash now reads
          // fs.visibleInFlight too.
          //
          // "Available to send" still uses the union math because a
          // design abstractly committed to a bg simulation isn't
          // truly available to dispatch.
          const parts = [];
          if (fs.visibleInFlight > 0) parts.push(`${fs.visibleInFlight} in flight`);
          if (fs.prepping > 0) parts.push(`${fs.prepping} prepping`);
          if (fs.charging > 0) parts.push(`${fs.charging} charging`);
          const breakdown = parts.length ? ` · ${parts.join(' · ')}` : '';
          availEl.textContent = `${fs.available}/${fs.total} available to send${breakdown}`;
        }
      }
    }

    // Updates the CUSTOMER counter — global air-taxi-network activity.
    // Persisted total increments via the background world activity
    // tick (every 4-9s a flight lands somewhere in the network). The
    // live in-flight count comes from the background fleet pool, capped
    // at hangar size so the displayed in-flight number is grounded in
    // visible aircraft.
    function updateSplashCustomerFlights() {
      const el = document.getElementById('splash-customer-flights');
      const liveEl = document.getElementById('splash-flights-live');
      const persisted = getCustomerFlights();
      const backgroundFleet = (typeof window !== 'undefined' && window.__backgroundWorldFleet) || [];
      const backgroundActiveNow = backgroundFleet.length;
      // Big number = persisted ticks ONLY (each tick = one customer
      // dropoff). Live activity is in the subline. User: "have the
      // counters be the same number 0 and 0."
      if (el) el.textContent = persisted.toLocaleString();
      // HONEST live subline — User: "this needs to update saying
      // that there are no flights, can't say this if it is not
      // happening." We only claim "X IN FLIGHT NOW" once the network
      // has shown REAL activity (persisted > 0). Until that point
      // the bg world fleet is simulation that hasn't been validated
      // by a real counter increment, and saying "11 IN FLIGHT NOW"
      // when the persisted total is 0 is exactly the dishonesty the
      // user complained about. After the first dropoff, the bg pool
      // earns trust.
      if (liveEl) {
        if (backgroundActiveNow > 0 && persisted > 0) {
          liveEl.textContent = `⏵ ${backgroundActiveNow} IN FLIGHT NOW`;
          liveEl.style.display = '';
        } else {
          liveEl.style.display = 'none';
        }
      }
    }

    // Back-compat alias — older code calls updateSplashTotalFlights.
    // Routes to both updaters so the existing call sites still work.
    function updateSplashTotalFlights() {
      updateSplashOperatorFlights();
      updateSplashCustomerFlights();
      try { updateSplashActivityPanel(); } catch (_) {}
    }

    // Splash-only fast refresh — the bg simulation tick fires every
    // 4–9 seconds, but the activity panel needs to count down the
    // ETA and re-poll bg pool state more responsively. This 1-second
    // interval ONLY runs while the splash view is active so it doesn't
    // fight with the launchpad's RAF loop or burn cycles when the
    // splash is hidden. Honors the same try/catch-per-call discipline
    // as the bg tick — a panel render failure must never stall the
    // page.
    if (typeof window !== 'undefined' && !window.__splashFastRefresh) {
      window.__splashFastRefresh = setInterval(() => {
        try {
          const splashView = document.getElementById('splash-view');
          if (!splashView || !splashView.classList.contains('active')) return;
          // Refresh the activity panel AND the OPERATOR FLIGHTS subline
          // ("X/N AVAILABLE TO SEND") so both track live state. Without
          // the operator update, the subline showed whatever was true
          // at first paint and never refreshed — so the user saw a
          // brief "6/14" at load while bg pool was warming up, then
          // never updated to reality (1/14, 8 in flight). User: "it
          // briefly spawns at 6/14 and then reverts to 1/14 that is
          // another bug. needs to update live."
          updateSplashActivityPanel();
          updateSplashOperatorFlights();
        } catch (_) { /* best-effort */ }
      }, 1000);
    }

    // Live splash activity panel — shows fleet summary counters + per-worker
    // status. User: "the splash screen needs to update what all is
    // happening and what the workers are working on, as well as the
    // counters like a summary."
    function updateSplashActivityPanel() {
      // ---- Read every backend signal that contributes to "what's happening" ----
      // User: "dashboard is not synced with what is currently happening
      // in the background. that needs to summarize what is happening
      // behind the scenes." So the dashboard reads from EVERY source
      // of real activity: launchpad flights, pending dispatches,
      // battery charging state, AND the bg simulation pools (operator
      // and customer). A user design appearing in the bg operator
      // pool genuinely IS flying in the simulated network, so we
      // count it as airborne.
      const designs = (typeof getAllSavedDesigns === 'function') ? getAllSavedDesigns() : [];
      const flightStates = (typeof window !== 'undefined' && window.__padFlightStates) || [];
      const launchpadInFlightIds = new Set(flightStates.filter(f => f && f.active && f.designId).map(f => f.designId));
      const bgOpFleet = (typeof window !== 'undefined' && window.__backgroundOperatorFleet) || [];
      const bgCustFleet = (typeof window !== 'undefined' && window.__backgroundWorldFleet) || [];
      const bgOpDesignIds = new Set(bgOpFleet.filter(f => f && f.designId).map(f => f.designId));
      // Use computeFleetState for the FLEET section counts so this
      // panel and the OPERATOR FLIGHTS subline agree by construction.
      // User: "14/14 can't be printed like this if it is not actually
      // true. you see the sync bug." — and now follow-up: "still
      // defaults to 0/14 ... fix the darn setTimeout." Both bugs
      // root-caused by separate code paths drifting; consolidating
      // to computeFleetState() eliminates the possibility.
      const fs = (typeof computeFleetState === 'function') ? computeFleetState() : null;
      const total    = fs ? fs.total    : designs.length;
      const available = fs ? fs.available : 0;
      const flying   = fs ? fs.inFlight : 0;
      const charging = fs ? fs.charging : 0;
      const prepping = fs ? fs.prepping : 0;
      const setText = (id, val) => { const el = document.getElementById(id); if (el) el.textContent = val; };
      setText('splash-fleet-total', total);
      setText('splash-fleet-available', available);
      setText('splash-fleet-flying', flying);
      setText('splash-fleet-charging', charging);
      setText('splash-fleet-prepping', prepping);

      // ---- Network activity (bg pools — operator and customer) ----
      // Summarizes what's running in the simulation pools. User: "that
      // needs to summarize what is happening behind the scenes."
      // For the operator pool we split into "yours" (bg flight has a
      // design attached → it's one of your designs out doing
      // background work) vs "others" (no design attachment → other
      // operator's flight). The customer pool is opaque global-network
      // dropoffs.
      const bgYoursActive = bgOpFleet.filter(f => f && f.designId).length;
      const bgOthersActive = bgOpFleet.filter(f => !f || !f.designId).length;
      const bgCustActive = bgCustFleet.length;
      // ETA of next bg event = soonest landAt across both pools
      const now = (typeof performance !== 'undefined' && performance.now) ? performance.now() : Date.now();
      let nextLandMs = Infinity;
      for (const f of bgOpFleet)   if (f && f.landAt && f.landAt > now && f.landAt < nextLandMs) nextLandMs = f.landAt;
      for (const f of bgCustFleet) if (f && f.landAt && f.landAt > now && f.landAt < nextLandMs) nextLandMs = f.landAt;
      const nextEtaSec = (nextLandMs !== Infinity) ? Math.max(0, Math.round((nextLandMs - now) / 1000)) : null;
      setText('splash-network-yours', bgYoursActive);
      setText('splash-network-others', bgOthersActive);
      setText('splash-network-customers', bgCustActive);
      const etaEl = document.getElementById('splash-network-eta');
      if (etaEl) {
        if (nextEtaSec === null) {
          etaEl.textContent = '—';
        } else if (nextEtaSec === 0) {
          etaEl.textContent = '<1s';     // "0s" implies nothing queued; "<1s" makes the imminent landing clear
        } else if (nextEtaSec < 60) {
          etaEl.textContent = nextEtaSec + 's';
        } else {
          etaEl.textContent = Math.round(nextEtaSec / 60) + 'm';
        }
      }

      // ---- Crew activity ----
      const list = document.getElementById('splash-crew-list');
      if (!list) return;
      const getActivity = (typeof window !== 'undefined' && window.__getCrewActivity) || null;
      const activity = getActivity ? getActivity() : [];
      if (!activity || activity.length === 0) {
        // Splash sees no crew figures (those only exist in the
        // launchpad scene). User: "I need a summary of what is
        // going on here." So instead of a static "Hub idle"
        // message, render the recent-events ring buffer as a live
        // feed of dispatches and dropoffs with relative
        // timestamps. This is the actual thing that's happening
        // behind the scenes — making it visible turns the splash
        // from a static dashboard into a live feed.
        const events = (typeof window !== 'undefined' && window.__recentEvents) || [];
        if (events.length === 0) {
          // No events yet — bg simulation hasn't landed anything
          // since the page loaded. Be honest about that state.
          const padOpen = !!(typeof window !== 'undefined' && window.__padActive);
          const msg = padOpen
            ? 'Hub is staffed — crew working in launch pad.'
            : 'Watching network. Activity feed populates as flights complete.';
          list.innerHTML = `<span class="splash-activity-empty">${msg}</span>`;
          return;
        }
        // Events use wall-clock timestamps (Date.now) so they
        // survive across reloads. Compare with Date.now too.
        const eventNow = Date.now();
        const eventRows = events.map(ev => {
          const ageS = Math.max(0, Math.round((eventNow - ev.t) / 1000));
          const ageStr = ageS < 5 ? 'just now'
                       : ageS < 60 ? `${ageS}s ago`
                       : ageS < 3600 ? `${Math.round(ageS / 60)}m ago`
                       : `${Math.round(ageS / 3600)}h ago`;
          const stateClass = ev.kind === 'customer' ? 'is-working' : 'is-walking';
          const tag = (ev.kind === 'customer' ? 'CUSTOMER' : 'OPERATOR');
          return `<div class="splash-crew-row">
            <span class="splash-crew-role">${tag}</span>
            <span class="splash-crew-status ${stateClass}">${escapeHtml(ev.label || ev.kind)}</span>
            <span class="splash-crew-status is-idle" style="text-align:right">${ageStr}</span>
          </div>`;
        }).join('');
        list.innerHTML = eventRows;
        return;
      }
      // Sort: working > walking_to > walking_back > idle, so the user
      // sees what's actively happening at the top of the list
      const order = { working: 0, walking_to: 1, walking_back: 2, idle: 3 };
      activity.sort((a, b) => (order[a.state] ?? 9) - (order[b.state] ?? 9));
      const rows = activity.map(w => {
        const stateClass =
          w.state === 'working'      ? 'is-working'   :
          w.state === 'walking_to'   ? 'is-walking'   :
          w.state === 'walking_back' ? 'is-returning' :
                                       'is-idle';
        const tail = w.tailNumber ? ` <span class="tail">${escapeHtml(w.tailNumber)}</span>` : '';
        const status = `${escapeHtml(w.label || w.state)}${tail}`;
        const role = escapeHtml(w.slotKey || w.role || '');
        return `<div class="splash-crew-row">
          <span class="splash-crew-role">${role}</span>
          <span class="splash-crew-status ${stateClass}">${status}</span>
          <span class="splash-crew-dot ${stateClass}"></span>
        </div>`;
      }).join('');
      list.innerHTML = rows;
    }
    // Render the hangar (saved-designs panel) on the splash screen
    function renderSavedDesignsHangar() {
      const panel = document.getElementById('saved-designs-panel');
      const list  = document.getElementById('saved-designs-list');
      const count = document.getElementById('saved-designs-count');
      if (!panel || !list) return;
      const designs = getAllSavedDesigns();
      // Hide the panel when empty so it doesn't sit on top of the play button.
      // The launch pad is still reachable from the design view's action bar.
      if (designs.length === 0) {
        panel.hidden = true;
        return;
      }
      panel.hidden = false;
      count.textContent = `${designs.length} design${designs.length === 1 ? '' : 's'}`;
      list.innerHTML = '';
      // Sort newest first
      designs.sort((a, b) => (b.savedAt || 0) - (a.savedAt || 0));
      for (const d of designs) {
        const card = document.createElement('button');
        card.className = 'saved-design-card';
        const dateStr = new Date(d.savedAt).toLocaleDateString(undefined, { month: 'short', day: 'numeric' });
        const partsCount = d.scene?.object?.children?.length ?? 0;
        const flightCount = getFlightLogsForDesign(d.id).length;
        card.innerHTML = `
          <span class="saved-design-name">${escapeHtml(d.name || 'Untitled')}</span>
          <span class="saved-design-tail">${escapeHtml(d.tailNumber || '—')}</span>
          <span class="saved-design-meta">
            <span>${partsCount} part${partsCount === 1 ? '' : 's'}</span>
            <span>·</span>
            <span>${dateStr}</span>
            <span>·</span>
            <span>${escapeHtml(d.operator || 'no operator')}</span>
          </span>
          <button class="saved-design-delete" data-id="${d.id}" title="Delete">DEL</button>
          <div class="saved-design-flight-row" style="grid-column: 1 / -1;">
            <span class="saved-design-flight-count" data-flight-count-id="${escapeHtml(d.id)}">
              <span class="num">${flightCount}</span>flight${flightCount === 1 ? '' : 's'} completed
            </span>
            <button class="saved-design-logs-btn" data-logs-id="${d.id}" data-logs-name="${escapeHtml(d.name || 'Untitled')}" data-logs-tail="${escapeHtml(d.tailNumber || '—')}" title="View flight logs for this aircraft">VIEW LOGS</button>
          </div>
        `;
        // Click card → load and go to design view (but ignore clicks on the
        // delete button OR the logs button — they have their own handlers).
        card.addEventListener('click', (e) => {
          if (e.target.classList.contains('saved-design-delete')) return;
          if (e.target.classList.contains('saved-design-logs-btn')) return;
          window.__pendingLoadDesign = d;
          launch();
        });
        // Delete button (stop propagation so it doesn't load)
        const delBtn = card.querySelector('.saved-design-delete');
        delBtn.addEventListener('click', (e) => {
          e.stopPropagation();
          if (!confirm(`Delete "${d.name}"?`)) return;
          deleteSavedDesign(d.id);
        });
        // Logs button — opens the flight log modal for this design
        const logsBtn = card.querySelector('.saved-design-logs-btn');
        logsBtn.addEventListener('click', (e) => {
          e.stopPropagation();
          openFlightLogsModal(d.id, d.name || 'Untitled', d.tailNumber || '—');
        });
        list.appendChild(card);
      }
    }

    // Surgically update each hangar card's "X flights completed" count
    // without rebuilding the entire panel. The user wanted "this log
    // needs to update flights to live like the live main flight
    // counter" — the main counter ticks every time a flight lands;
    // this helper does the same for per-design counts.
    //
    // Reads the current flight log for each design and writes the count
    // + correct singular/plural text into the matching count span.
    // Called from recordFlightCompletion (when a flight from the
    // launchpad finishes) and from the bg operator pool tick (when
    // background "other operators" complete flights using user designs).
    function updateHangarFlightCounts() {
      try {
        const spans = document.querySelectorAll('[data-flight-count-id]');
        if (!spans || spans.length === 0) return;     // panel not in DOM
        for (const span of spans) {
          const id = span.getAttribute('data-flight-count-id');
          if (!id) continue;
          const count = (typeof getFlightLogsForDesign === 'function')
            ? getFlightLogsForDesign(id).length : 0;
          span.innerHTML = `<span class="num">${count}</span>flight${count === 1 ? '' : 's'} completed`;
        }
      } catch (_) { /* DOM unavailable; safe no-op */ }
    }

    function escapeHtml(s) {
      return String(s).replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
    }

    // ============================================================
    // FLIGHT LOGS MODAL — list every recorded flight for a design,
    // with route, customer, miles, and timestamp.
    // ============================================================
    function openFlightLogsModal(designId, designName, tailNumber) {
      const logs = getFlightLogsForDesign(designId);
      // Sort newest first
      const sorted = logs.slice().sort((a, b) => (b.completedAt || 0) - (a.completedAt || 0));
      const totalMiles = sorted.reduce((s, e) => s + (e.totalMiles || 0), 0);

      const backdrop = document.createElement('div');
      backdrop.className = 'flight-logs-modal-backdrop';
      backdrop.innerHTML = `
        <div class="flight-logs-modal" role="dialog" aria-label="Flight logs">
          <div class="flight-logs-modal-header">
            <span class="flight-logs-modal-title">FLIGHT LOGS · ${escapeHtml(designName)} · ${escapeHtml(tailNumber)}</span>
            <button class="flight-logs-modal-close" type="button">CLOSE ✕</button>
          </div>
          <div class="flight-logs-modal-summary">
            <span class="total">${sorted.length}</span> flight${sorted.length === 1 ? '' : 's'} ·
            <span class="total">${totalMiles.toFixed(0)}</span> total miles flown
          </div>
          <div class="flight-logs-modal-list" id="flight-logs-modal-list"></div>
        </div>
      `;
      document.body.appendChild(backdrop);

      const listEl = backdrop.querySelector('#flight-logs-modal-list');
      if (sorted.length === 0) {
        listEl.innerHTML = '<div class="flight-logs-empty">No flights recorded yet · dispatch this aircraft to see logs here</div>';
      } else {
        listEl.innerHTML = sorted.map(e => {
          const when = e.completedAt
            ? new Date(e.completedAt).toLocaleString(undefined, { month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit' })
            : '—';
          return `
            <div class="flight-log-row">
              <span class="log-when">${escapeHtml(when)}</span>
              <span class="log-route">${escapeHtml(e.from || '—')}<span class="arrow">→</span>${escapeHtml(e.to || '—')}</span>
              <span class="log-customer">${escapeHtml(e.customer || '—')}</span>
              <span class="log-tail">${escapeHtml(e.tail || '—')}</span>
              <span class="log-miles">${(e.totalMiles || 0).toFixed(0)} mi</span>
            </div>
          `;
        }).join('');
      }

      // Close on backdrop click, close button, or Escape
      const closeModal = () => {
        backdrop.style.opacity = '0';
        setTimeout(() => backdrop.remove(), 180);
        document.removeEventListener('keydown', escHandler);
      };
      const escHandler = (e) => { if (e.key === 'Escape') closeModal(); };
      document.addEventListener('keydown', escHandler);
      backdrop.addEventListener('click', (e) => {
        if (e.target === backdrop) closeModal();
      });
      backdrop.querySelector('.flight-logs-modal-close').addEventListener('click', closeModal);
    }

    // ============================================================
    // DRAGGABLE HANGAR PANEL — header acts as the grip. Position
    // persists across sessions in localStorage so the user's choice
    // is remembered. Without this, the panel sat on top of the
    // SuperDispatch wordmark and blocked the title.
    // ============================================================
    const PANEL_POS_KEY = 'sdx_hangar_panel_pos';
    function initHangarPanelDrag() {
      const panel = document.getElementById('saved-designs-panel');
      const header = document.getElementById('saved-designs-header');
      if (!panel || !header) return;

      // The wordmark sits inside .hero with padding-top: 110px, so any
      // panel position with top < ~120px overlaps the title area and
      // makes the header unreachable for dragging. Clamp restored
      // positions away from that zone. User: "now make this window
      // moveable again, since it is stuck and frozen" — the panel had
      // been dragged behind the title and the drag handle was no
      // longer clickable.
      const MIN_TOP = 130;     // safe distance below the wordmark
      const MIN_LEFT = 8;
      // Restore saved position if present, but clamp away from the
      // wordmark zone. If the restored position would be unreachable,
      // discard it and fall back to the default CSS position.
      try {
        const raw = localStorage.getItem(PANEL_POS_KEY);
        if (raw) {
          const { left, top } = JSON.parse(raw);
          if (Number.isFinite(left) && Number.isFinite(top)) {
            // Discard positions that would put the header behind the
            // wordmark or off-screen (a prior bad drag could persist
            // a value like { top: 0 } which makes the panel
            // unreachable on next load).
            const safeLeft = Math.max(MIN_LEFT, Math.min(window.innerWidth - 100, left));
            const safeTop  = Math.max(MIN_TOP,  Math.min(window.innerHeight - 100, top));
            panel.style.left = safeLeft + 'px';
            panel.style.top = safeTop + 'px';
            panel.style.right = 'auto';
          }
        }
      } catch (_) {}

      let dragging = false;
      let startX = 0, startY = 0, originLeft = 0, originTop = 0;

      // Shared press-handler for both mouse and touch — extracts the
      // pointer (x, y) from whichever event type fired.
      function pressFromEvent(e) {
        const t = e.touches && e.touches[0];
        return { x: t ? t.clientX : e.clientX, y: t ? t.clientY : e.clientY };
      }

      function startDrag(e) {
        // Don't start a drag if the user clicked a button inside the header
        if (e.target && e.target.tagName === 'BUTTON') return;
        e.preventDefault();
        dragging = true;
        panel.classList.add('dragging');
        const rect = panel.getBoundingClientRect();
        // If panel is still positioned via `right`, switch to left/top first
        if (panel.style.left === '' || panel.style.left === 'auto') {
          panel.style.left = rect.left + 'px';
          panel.style.right = 'auto';
        }
        if (panel.style.top === '' || panel.style.top === 'auto') {
          panel.style.top = rect.top + 'px';
        }
        originLeft = rect.left;
        originTop = rect.top;
        const p = pressFromEvent(e);
        startX = p.x;
        startY = p.y;
      }

      function moveDrag(e) {
        if (!dragging) return;
        const p = pressFromEvent(e);
        let nextLeft = originLeft + (p.x - startX);
        let nextTop  = originTop  + (p.y - startY);
        const rect = panel.getBoundingClientRect();
        const maxLeft = window.innerWidth - rect.width;
        const maxTop  = window.innerHeight - rect.height;
        // Clamp left to viewport AND top to MIN_TOP so the user can
        // never drag the panel back behind the wordmark.
        nextLeft = Math.max(MIN_LEFT, Math.min(maxLeft, nextLeft));
        nextTop  = Math.max(MIN_TOP,  Math.min(maxTop,  nextTop));
        panel.style.left = nextLeft + 'px';
        panel.style.top  = nextTop  + 'px';
      }

      function endDrag() {
        if (!dragging) return;
        dragging = false;
        panel.classList.remove('dragging');
        // Persist position
        try {
          const rect = panel.getBoundingClientRect();
          localStorage.setItem(PANEL_POS_KEY, JSON.stringify({ left: rect.left, top: rect.top }));
        } catch (_) {}
      }

      // Mouse events
      header.addEventListener('mousedown', startDrag);
      document.addEventListener('mousemove', moveDrag);
      document.addEventListener('mouseup', endDrag);
      // Touch events for tablets/touchscreens — same handlers
      header.addEventListener('touchstart', startDrag, { passive: false });
      document.addEventListener('touchmove', moveDrag, { passive: false });
      document.addEventListener('touchend', endDrag);
      document.addEventListener('touchcancel', endDrag);

      // Expose a one-shot reset so users (or other code paths) can
      // unstick the panel without clearing localStorage manually.
      window.__resetHangarPanelPosition = function () {
        try { localStorage.removeItem(PANEL_POS_KEY); } catch (_) {}
        panel.style.left = '';
        panel.style.top = '';
        panel.style.right = '';
      };
    }
    initHangarPanelDrag();

    // Initial hangar render on splash
    renderSavedDesignsHangar();
    // Initial splash flight counter render — the FLEET SYNC HEARTBEAT
    // (defined below) takes over for live updates. This call only
    // ensures the persisted big-number counters render once on boot
    // before the heartbeat's first tick.
    updateSplashTotalFlights();

    // ============================================================
    // FLEET SYNC HEARTBEAT
    // ============================================================
    // User: "is it not possible for you to sync the splash screen
    // with the hub entry? cause I have to repeat myself alot with
    // you." The repeated drift bug came from each display surface
    // reading state at its OWN render time:
    //   - splash subline updated on tick events
    //   - splash FLEET section updated on activity-panel tick (1s)
    //   - sidebar badge updated on launchpad tick (per-frame)
    //   - hub apron updated on flight transitions
    // Each surface read fresh state from window.__padFlightStates
    // and window.__backgroundOperatorFleet — but those mutate
    // continuously. So even with computeFleetState as the helper,
    // splash and hub could read different SNAPSHOTS taken
    // milliseconds apart.
    //
    // Fix: ONE heartbeat caches a snapshot via computeFleetState,
    // then updates every display element from that cached snapshot
    // synchronously. They CANNOT disagree because there's only one
    // snapshot at any given moment.
    if (typeof window !== 'undefined' && !window.__fleetSyncHeartbeat) {
      function tickFleetSync() {
        try {
          // ONE snapshot for this tick. Every reader uses this exact
          // object — no fresh reads of mutable pools per surface.
          const snap = (typeof computeFleetState === 'function')
            ? computeFleetState() : null;
          window.__fleetSyncSnapshot = snap;
          if (!snap) return;

          // ---- SPLASH (only when splash-view is active) ----
          const splashView = document.getElementById('splash-view');
          if (splashView && splashView.classList.contains('active')) {
            try { updateSplashTotalFlights(); } catch (_) {}
            try { updateSplashActivityPanel(); } catch (_) {}
          }

          // ---- LAUNCHPAD SIDEBAR (only when pad-view is active) ----
          const padView = document.getElementById('pad-view');
          if (padView && padView.classList.contains('active')) {
            const flightCountEl = document.getElementById('pad-map-flight-count');
            if (flightCountEl) {
              // Badge displays VISIBLE flights (active or transitioning
              // clones in the launchpad scene) — same definition the
              // splash subline uses, so the two labels agree on what
              // "X IN FLIGHT" means. User: "1/14 IN FLIGHT" on hub vs
              // "4 in flight" on splash subline — same words, must
              // mean the same thing.
              const visibleInFlight = snap.visibleInFlight || 0;
              flightCountEl.textContent = `${visibleInFlight}/${snap.total} IN FLIGHT`;
              flightCountEl.classList.remove('partial', 'heavy');
              if (visibleInFlight > 0 && snap.total > 0) {
                if (visibleInFlight / snap.total >= 0.5) flightCountEl.classList.add('heavy');
                else flightCountEl.classList.add('partial');
              }
            }
            // Apron re-render safety net — if a dispatch path forgets
            // to call renderFleetAprons, or fires it BEFORE
            // padFlightStates mutates (race), the apron lies. The
            // heartbeat re-renders every 1s so the apron catches up.
            // renderFleetAprons is idempotent (it diffs against
            // padApronGroups and only does work for state changes),
            // so re-running it every second is cheap.
            try {
              if (typeof renderFleetAprons === 'function') renderFleetAprons();
            } catch (_) {}
          }
        } catch (_) { /* heartbeat must never throw */ }
      }
      // Expose so other code paths can force-tick on demand
      // (e.g. immediately after a dispatch or landing event).
      window.__tickFleetSync = tickFleetSync;
      // First tick now so first paint reflects current state
      tickFleetSync();
      window.__fleetSyncHeartbeat = setInterval(tickFleetSync, 1000);
    }

    // ============================================================
    // BACKGROUND WORLD ACTIVITY — two simultaneous simulations
    //
    // The user pointed out: "I can't be the only operator. have other
    // operators as well sending flights, and update the counter there
    // too in non customer mode." So we now run TWO background pools:
    //
    // 1. CUSTOMER fleet — represents customers being served by aircraft
    //    in the user's hangar (or aircraft of the user's design type).
    //    Pool size capped at HANGAR SIZE so the in-flight count never
    //    exceeds the number of aircraft the user owns. (User: "how can
    //    there be 11 in flight, when there are only 5-6 aircraft? does
    //    that make sense?") Increments CUSTOMER counter.
    //
    // 2. OPERATOR fleet — represents OTHER air-taxi companies/operators
    //    in the wider network sending flights with THEIR own aircraft.
    //    Pool size scales independently of the user's hangar (those are
    //    other operators' aircraft, not yours). Increments OPERATOR
    //    counter live so the counter feels alive even before the user
    //    dispatches anything themselves.
    //
    // Both write to localStorage so the persisted totals survive
    // reloads. Both have their own pool array tracked on window.
    // ============================================================
    if (!window.__backgroundWorldActivity) {
      // Customer pool target: cap at HANGAR SIZE so the in-flight count
      // is grounded in the visible fleet. With 0 designs → minimum
      // floor of 2 so the splash doesn't feel completely dead. With 5
      // designs → 1-5 in flight at a time. Never exceeds n.
      function targetCustomerFleetSize() {
        const designs = (typeof getAllSavedDesigns === 'function') ? getAllSavedDesigns() : [];
        const n = designs.length;
        if (n === 0) return 1 + Math.floor(Math.random() * 2);     // 1-2 with empty hangar
        // Random in [1, n] — pool fluctuates within hangar size
        return 1 + Math.floor(Math.random() * n);
      }

      // Operator pool target: simulates OTHER operators in the network.
      // Independent of user's hangar size (they have their own fleets).
      // 3-8 simultaneous flights from other operators feels like a live
      // network without overwhelming the splash visually.
      function targetOperatorFleetSize() {
        return 3 + Math.floor(Math.random() * 6);     // 3-8 in flight
      }

      window.__backgroundWorldFleet = window.__backgroundWorldFleet || [];
      window.__backgroundOperatorFleet = window.__backgroundOperatorFleet || [];

      // Seed each pool
      const seedCustomer = targetCustomerFleetSize();
      for (let i = 0; i < seedCustomer; i++) {
        window.__backgroundWorldFleet.push({
          id: 'bgc_' + (window.__bgcSeq = (window.__bgcSeq || 0) + 1),
          landAt: performance.now() + 4000 + Math.random() * 25000,
          designId: null,
        });
      }
      const seedOperator = targetOperatorFleetSize();
      // Seeding loop for operator pool — pick distinct user designs so
      // the splash counter shows them as busy from the very first tick
      const seedDesignsList = (typeof getAllSavedDesigns === 'function')
        ? getAllSavedDesigns() : [];
      const seedCap = Math.max(1, Math.floor(seedDesignsList.length * 0.7));
      const seedUsed = new Set();
      for (let i = 0; i < seedOperator; i++) {
        let designId = null;
        if (seedDesignsList.length > 0 && seedUsed.size < seedCap) {
          const free = seedDesignsList.filter(d => !seedUsed.has(d.id));
          if (free.length > 0) {
            const pick = free[Math.floor(Math.random() * free.length)];
            designId = pick.id;
            seedUsed.add(pick.id);
          }
        }
        window.__backgroundOperatorFleet.push({
          id: 'bgo_' + (window.__bgoSeq = (window.__bgoSeq || 0) + 1),
          landAt: performance.now() + 4000 + Math.random() * 25000,
          designId,
        });
      }

      // ===== IMMEDIATE SUBLINE REFRESH AFTER SEED =====
      // User: "still defaults to 0/14 how hard is it for you to fix
      // a simple counter reset bug motherfucker. fix the darn
      // setTimeout." The bug: line 6974 (boot-time updateSplashTotalFlights)
      // ran BEFORE this seed loop populated __backgroundOperatorFleet,
      // so the subline rendered with empty bg pool (14/14) — but
      // never refreshed until the 1s interval tick, by which time
      // the pool was already full. The user saw a frozen incorrect
      // value at first paint. Refreshing the counter inline RIGHT
      // HERE (synchronously, in the same tick the seed runs) closes
      // that race — first paint shows live state.
      try {
        if (typeof updateSplashOperatorFlights === 'function') updateSplashOperatorFlights();
        if (typeof updateSplashCustomerFlights === 'function') updateSplashCustomerFlights();
        if (typeof updateSplashActivityPanel === 'function') updateSplashActivityPanel();
        // Heartbeat tick so EVERY surface (splash + hub) sees the
        // freshly-seeded pool synchronously, in the same boot block
        if (typeof window !== 'undefined' && window.__tickFleetSync) window.__tickFleetSync();
      } catch (_) { /* best-effort */ }

      // Generic tick function — used by both pools. Lands any expired
      // flights (incrementing the matching counter), tops up to target.
      // tickPool with per-flight designId support. The operator pool
      // attaches a real user design to ~70% of flights — the user's
      // aircraft are out doing background operator work. The customer
      // pool runs opaque flights (no design attachment).
      //
      // designsForFleet: optional function returning the list of
      // candidate user designs. When provided, each new flight tries
      // to pick a design NOT already used by another flight in the
      // same pool.
      function tickPool(fleet, getTarget, getPersistedFn, storageKey, idPrefix, seqProp, designsForFleet, onLandingFn) {
        const now = performance.now();
        let landed = 0;
        for (let i = fleet.length - 1; i >= 0; i--) {
          if (now >= fleet[i].landAt) {
            fleet.splice(i, 1);
            landed++;
          }
        }
        // Bg simulation pools tick the persisted counters when their
        // flights LAND. User: "should not be floored at 0, needs to
        // update during dropoffs with integrity." Integrity is
        // preserved because we only tick on actual landAt crossings
        // — exactly the same threshold the pool uses to remove the
        // flight from itself. Each customer-pool landing = one
        // dropoff. Each operator-pool landing = one mission complete.
        // Counter ticks once per landing (no double-counting). The
        // launchpad's incrementCustomerFlights at the disembark phase
        // remains the source of truth for user-flown missions; bg
        // pools fill in the network activity that's happening
        // outside the user's direct view. Together the persisted
        // counters reflect the FULL state of the simulated world.
        if (landed > 0 && typeof onLandingFn === 'function') {
          for (let k = 0; k < landed; k++) {
            try { onLandingFn(); } catch (_) { /* best-effort */ }
          }
        }
        // Bg operator pool keeps user designs attached at all times,
        // including while the launchpad is open. PRIOR BUG: this code
        // used to null every designId when launchpad opened, which
        // made the hub sidebar's "X/N IN FLIGHT" badge read 0 because
        // computeFleetState saw an empty bg-design Set, even while
        // the splash subline correctly showed "5 IN FLIGHT". User:
        // "0/14 IN FLIGHT ... nope still 0 in flight what bug is
        // still not getting fixed."
        //
        // The launchpad-dispatched real flights go into
        // __padFlightStates (a separate array), NOT this fleet. So
        // bg designIds and launchpad designIds never overlap by
        // construction. computeFleetState unions both and dedupes
        // via Set — no double-counting possible.
        //
        // To be extra-safe, when the launchpad is open we exclude
        // designs currently flying in __padFlightStates from new bg
        // attachments, so a single design ID can never appear in
        // both pools simultaneously even if the seed loop and a
        // launchpad dispatch race.
        const launchpadOpen = !!(typeof window !== 'undefined' && window.__padActive);
        const target = getTarget();
        while (fleet.length < target) {
          let designId = null;
          if (typeof designsForFleet === 'function') {
            const designs = designsForFleet();
            if (designs.length > 0) {
              const cap = Math.max(1, Math.floor(designs.length * 0.7));
              const usedNow = new Set(
                fleet.filter(f => f.designId).map(f => f.designId)
              );
              // Exclude designs currently dispatched from launchpad
              // (real flights) so a single design never appears in
              // both pools at the same time.
              const launchpadFlying = (typeof window !== 'undefined' && window.__padFlightStates)
                ? new Set(window.__padFlightStates
                    .filter(f => f && f.active && f.designId)
                    .map(f => f.designId))
                : new Set();
              if (usedNow.size < cap) {
                const free = designs.filter(d =>
                  !usedNow.has(d.id) && !launchpadFlying.has(d.id)
                );
                if (free.length > 0) {
                  designId = free[Math.floor(Math.random() * free.length)].id;
                }
              }
            }
          }
          fleet.push({
            id: idPrefix + (window[seqProp] = (window[seqProp] || 0) + 1),
            landAt: now + 5000 + Math.random() * 25000,
            designId,
          });
        }
      }

      const tick = () => {
        tickPool(
          window.__backgroundWorldFleet,
          targetCustomerFleetSize,
          getCustomerFlights,
          CUSTOMER_FLIGHTS_KEY,
          'bgc_', '__bgcSeq',
          // Customer pool: no design attachment (these are abstract
          // global-network flights, not the user's aircraft)
          null,
          // Each landing in this pool = one customer dropoff in the
          // network. User: "needs to update during dropoffs with
          // integrity." Integrity = ticks ONLY when an actual landAt
          // is crossed.
          () => incrementCustomerFlights(),
        );
        tickPool(
          window.__backgroundOperatorFleet,
          targetOperatorFleetSize,
          getOperatorFlights,
          OPERATOR_FLIGHTS_KEY,
          'bgo_', '__bgoSeq',
          // Operator pool: attach user designs so the splash counter
          // shows the user's own aircraft as in flight
          () => (typeof getAllSavedDesigns === 'function' ? getAllSavedDesigns() : []),
          // Each landing = one mission completed by an operator.
          () => incrementOperatorFlights(),
        );
        // Refresh both splash counters
        try {
          updateSplashCustomerFlights();
          updateSplashOperatorFlights();
          // Sync all surfaces from the same snapshot
          if (typeof window !== 'undefined' && window.__tickFleetSync) window.__tickFleetSync();
        } catch (_) {}
        window.__backgroundWorldActivity = setTimeout(tick, 4000 + Math.random() * 5000);
      };
      window.__backgroundWorldActivity = setTimeout(tick, 2000);
    }

    // Splash → Launch Pad shortcut. Loads the most recent saved design (or
    // launches with the empty design if none exist), routes through the
    // manufacturing init, then opens the launch pad immediately.
    document.getElementById('splash-launchpad-btn')?.addEventListener('click', () => {
      const designs = getAllSavedDesigns();
      if (designs.length > 0) {
        // Use the most recently saved design as the active aircraft for the launch pad
        const newest = designs.slice().sort((a, b) => (b.savedAt || 0) - (a.savedAt || 0))[0];
        window.__pendingLoadDesign = newest;
      }
      // Flag that we want to skip the design view and go straight to launch pad
      window.__pendingOpenLaunchPad = true;
      launch();
    });

    // ============================================================
    // CUSTOMER MODE — passenger-perspective dispatch
    //
    // The user picks pickup city, dropoff city, and which of their saved
    // aircraft hails them. We then route through the same dispatch flow
    // that operator mode uses, but with a couple of distinguishing flags:
    //   - window.__customerModeActive: tells the cabin-camera code to
    //     attach to the seat once the aircraft is in cruise phase
    //   - window.__customerPickup / __customerDropoff: customer-chosen
    //     city names (the dispatch flow reads these instead of the chat
    //     order's from/to)
    //
    // Customer mode coexists with operator mode — the splash has both
    // entry buttons, and the user picks their lane.
    // ============================================================
    window.__customerModeState = {
      pickup: null,
      dropoff: null,
      aircraftId: null,
      active: false,            // true while customer view is open
      inCabin: false,           // true while cabin-chair view is active
      cabinAircraft: null,      // ref to the in-flight aircraft we're riding
    };
    // CABIN PANNING — yaw/pitch the user can drag to look around the cabin.
    // These are deltas added on top of the aircraft's forward heading. Reset
    // to 0 when boarding. Updated by the same mouse-look handler that
    // serves ground mode (we just route input by which mode is active).
    window.__padCabinCam = false;
    window.__padCabinPan = { yaw: 0, pitch: 0 };

    function openCustomerView(options) {
      options = options || {};
      const view = document.getElementById('customer-view');
      if (!view) return;
      view.classList.add('active');
      // Hide the splash content if it's currently showing. If we're being
      // opened from inside the launchpad (re-hail flow), there's no splash
      // to hide — the launchpad stays behind the customer-view modal.
      const splash = document.getElementById('splash-view');
      if (splash && splash.classList.contains('active')) {
        splash.style.visibility = 'hidden';
      }
      window.__customerModeState.active = true;
      // For re-hail (user just disembarked at dropoff and wants another
      // ride), pre-fill pickup with the dropoff city they just arrived at.
      // Reset dropoff + aircraft so they pick fresh.
      if (options.preFillPickup) {
        window.__customerModeState.pickup = options.preFillPickup;
        window.__customerModeState.dropoff = null;
        window.__customerModeState.aircraftId = null;
      }
      renderCustomerCitySelectors();
      renderCustomerAircraftList();
      updateCustomerSummary();

      // Refresh the aircraft list every 1.5s while the customer view is
      // open so "in flight · serving another customer" badges update as
      // AI dispatches start/finish in the background. Cleared on close.
      if (window.__customerAircraftRefreshInterval) {
        clearInterval(window.__customerAircraftRefreshInterval);
      }
      window.__customerAircraftRefreshInterval = setInterval(() => {
        if (!window.__customerModeState.active) {
          clearInterval(window.__customerAircraftRefreshInterval);
          window.__customerAircraftRefreshInterval = null;
          return;
        }
        try { renderCustomerAircraftList(); } catch (_) {}
      }, 1500);
    }

    function closeCustomerView() {
      const view = document.getElementById('customer-view');
      if (view) view.classList.remove('active');
      const splash = document.getElementById('splash-view');
      if (splash) splash.style.visibility = '';
      window.__customerModeState.active = false;
      if (window.__customerAircraftRefreshInterval) {
        clearInterval(window.__customerAircraftRefreshInterval);
        window.__customerAircraftRefreshInterval = null;
      }
      // Re-roll the fleet simulation on next view open ("vary it up on
      // reload" per user instruction). Without clearing this, the same
      // mix of in-flight/charging/available would persist across opens.
      window.__customerFleetSimState = null;
    }
    // Expose for tests + manual re-renders (e.g. after dispatch state changes)
    window.__renderCustomerAircraftList = renderCustomerAircraftList;
    window.__closeCustomerView = closeCustomerView;
    window.__openCustomerView = openCustomerView;

    function getCurrentRegionPads() {
      // Read from window.__sdxCurrentRegionKey which is set at script-tag
      // scope (default 'SF BAY') and updated by the dispatch system's
      // switchRegion() hook. This works BEFORE initManufacturing() runs,
      // which is when the customer-mode controller may need it (user can
      // hit "I'M THE CUSTOMER" before ever opening the design view).
      const key = window.__sdxCurrentRegionKey || 'SF BAY';
      return REGIONS[key] || REGIONS['SF BAY'];
    }

    function distMiles(a, b) {
      return Math.hypot(a.x - b.x, a.z - b.z);
    }

    function renderCustomerCitySelectors() {
      const region = getCurrentRegionPads();
      const hub = region.pads[region.hubName];
      // Sort cities by distance from hub for stable presentation
      const allCities = Object.entries(region.pads).map(([name, pos]) => ({
        name, pos, isHub: name === region.hubName,
        miFromHub: distMiles(hub, pos),
      })).sort((a, b) => a.miFromHub - b.miFromHub);

      const pickupGrid = document.getElementById('customer-pickup-grid');
      const dropoffGrid = document.getElementById('customer-dropoff-grid');
      if (!pickupGrid || !dropoffGrid) return;

      const state = window.__customerModeState;
      const renderGrid = (gridEl, kind) => {
        gridEl.innerHTML = '';
        for (const c of allCities) {
          const isSelected = state[kind] === c.name;
          // Pickup and dropoff can't be the same city
          const isOtherSelected = (kind === 'pickup' ? state.dropoff : state.pickup) === c.name;
          if (isOtherSelected) continue;
          const btn = document.createElement('button');
          btn.type = 'button';
          btn.className = 'customer-city-btn' + (isSelected ? ' selected' : '');
          btn.innerHTML = `${escapeHtml(c.name)}${c.isHub ? ' (HUB)' : ''}<span class="city-distance">${c.miFromHub.toFixed(0)} mi from hub</span>`;
          btn.addEventListener('click', () => {
            state[kind] = c.name;
            renderCustomerCitySelectors();
            updateCustomerSummary();
          });
          gridEl.appendChild(btn);
        }
      };
      renderGrid(pickupGrid, 'pickup');
      renderGrid(dropoffGrid, 'dropoff');
    }

    // Simulated initial fleet activity. Each time the customer view
    // opens, we roll a random distribution of "what is this aircraft
    // doing right now" so the picker isn't always all-available — the
    // hangar feels alive even before the user hails. The seed is
    // stored on window so it persists across re-renders within the
    // same view session, and re-rolled when the view closes.
    //
    // Possible per-aircraft initial states: 'available' | 'in_flight' | 'charging'
    // Distribution defaults: 50% available, 30% in flight, 20% charging.
    // (Battery for 'charging' is randomized 60-94%.)
    function rollFleetSimState(designs) {
      const sim = {};
      for (const d of designs) {
        const r = Math.random();
        const now = performance.now();
        if (r < 0.50) {
          sim[d.id] = { state: 'available', battery: 95, expiresAt: 0 };
        } else if (r < 0.80) {
          // Fake in-flight mission lasts 8-25 seconds (real flights are
          // ~120s but we want sim states to turnover visibly so the
          // picker shows live status changes — user wanted statuses to
          // update live as missions complete).
          sim[d.id] = {
            state: 'in_flight',
            battery: 95,
            customer: pickFakeCustomer(),
            expiresAt: now + 8000 + Math.random() * 17000,
          };
        } else {
          // Fake charging — current battery and an expiry that scales
          // with how far the battery has to climb to 95%. Charging rate
          // ~1.5%/sec so a 60% battery takes ~23s.
          const initialBatt = 60 + Math.floor(Math.random() * 30);
          const secondsToFull = (95 - initialBatt) / 1.5;
          sim[d.id] = {
            state: 'charging',
            battery: initialBatt,
            startBattery: initialBatt,
            chargeStartAt: now,
            expiresAt: now + secondsToFull * 1000,
          };
        }
      }
      return sim;
    }

    // Advance simulated aircraft states so the picker shows live status
    // changes — fake "in flight" aircraft eventually finish, fake
    // "charging" aircraft eventually charge to full and become
    // available. This runs every render tick (1.5s while picker is
    // open).
    function advanceFleetSimState(sim) {
      const now = performance.now();
      for (const id in sim) {
        const s = sim[id];
        if (!s || s.state === 'available') continue;
        if (s.state === 'in_flight') {
          // Update charging-at-completion battery for the smooth handoff
          if (now >= s.expiresAt) {
            // Mission complete — start charging from a low battery
            const initialBatt = 30 + Math.floor(Math.random() * 25);
            const secondsToFull = (95 - initialBatt) / 1.5;
            sim[id] = {
              state: 'charging',
              battery: initialBatt,
              startBattery: initialBatt,
              chargeStartAt: now,
              expiresAt: now + secondsToFull * 1000,
            };
          }
        } else if (s.state === 'charging') {
          // Update battery percentage as time passes. Use ?? rather than
          // || because chargeStartAt could be 0 (test scenarios) or a
          // very small timestamp early in app lifetime — || would treat
          // 0 as falsy and use `now` instead, breaking the elapsed math.
          const startAt = (s.chargeStartAt != null) ? s.chargeStartAt : now;
          const elapsedSec = (now - startAt) / 1000;
          const startBatt = (s.startBattery != null) ? s.startBattery : s.battery;
          const batt = Math.min(95, startBatt + 1.5 * elapsedSec);
          s.battery = batt;
          if (now >= s.expiresAt || batt >= 95 - 0.05) {
            sim[id] = { state: 'available', battery: 95, expiresAt: 0 };
          }
        }
      }
    }
    function pickFakeCustomer() {
      const names = ['J. Patel', 'A. Rodriguez', 'M. Chen', 'S. Okafor',
                     'L. Nakamura', 'R. Singh', 'D. Kowalski', 'K. Anand',
                     'T. Vargas', 'C. Werner', 'B. Aldridge'];
      return names[Math.floor(Math.random() * names.length)];
    }

    function renderCustomerAircraftList() {
      const listEl = document.getElementById('customer-aircraft-list');
      if (!listEl) return;
      const designs = getAllSavedDesigns();
      const state = window.__customerModeState;
      if (designs.length === 0) {
        listEl.innerHTML = `<div class="customer-no-aircraft">
          You haven't designed any aircraft yet.<br>
          Go back and click the launch button to design and save your first taxi.
        </div>`;
        return;
      }

      // Initialize fleet sim state on first render of this view session.
      // Stored on window so it persists across the 1.5s re-render interval
      // until the customer view closes.
      if (!window.__customerFleetSimState) {
        window.__customerFleetSimState = rollFleetSimState(designs);
      }
      const fleetSim = window.__customerFleetSimState;
      // Make sure newly-added designs (saved during this session) get a
      // sim state too — without this, a saved design appears with
      // undefined status.
      for (const d of designs) {
        if (!fleetSim[d.id]) {
          // New designs default to available
          fleetSim[d.id] = { state: 'available', battery: 95, expiresAt: 0 };
        }
      }
      // Advance simulated aircraft through their lifecycles. This is
      // what makes the picker statuses update LIVE — without this, fake
      // "in flight" aircraft would stay in flight forever from the
      // user's POV until they close and reopen the picker.
      advanceFleetSimState(fleetSim);

      // Real runtime state ALWAYS overrides simulated state. If an
      // aircraft is actually mid-flight (because the AI fleet manager
      // dispatched it during a re-hail flow), it's truly in-flight and
      // shows that, not whatever the simulation picked.
      const realInFlightIds = new Set();
      const flightStates = window.__padFlightStates || [];
      for (const fs of flightStates) {
        if (fs && fs.active && fs.designId) realInFlightIds.add(fs.designId);
      }

      // Compute final status per design
      function statusFor(designId) {
        if (realInFlightIds.has(designId)) {
          return { state: 'in_flight', battery: 95, customer: 'another customer' };
        }
        // Real battery overrides sim if present.
        // padDesignBatteries lives inside initLaunchPad's scope and may
        // not exist yet (when the picker renders from splash before the
        // launchpad has been opened). Guard with typeof check.
        if (typeof padDesignBatteries !== 'undefined' && padDesignBatteries) {
          const realBatt = padDesignBatteries.get(designId);
          if (realBatt && typeof realBatt.battery === 'number') {
            if (realBatt.battery < 95 - 0.05) {
              return { state: 'charging', battery: realBatt.battery };
            }
            return { state: 'available', battery: realBatt.battery };
          }
        }
        return fleetSim[designId] || { state: 'available', battery: 95 };
      }

      // Clear stale selection — if the user picked an aircraft that's
      // no longer available (became in-flight or charging), unselect it
      if (state.aircraftId) {
        const s = statusFor(state.aircraftId);
        if (s.state !== 'available') {
          state.aircraftId = null;
        }
      }

      designs.sort((a, b) => (b.savedAt || 0) - (a.savedAt || 0));
      listEl.innerHTML = '';
      // Tally for the summary header
      let availCount = 0, flightCount = 0, chargeCount = 0;
      for (const d of designs) {
        const s = statusFor(d.id);
        if (s.state === 'available') availCount++;
        else if (s.state === 'in_flight') flightCount++;
        else if (s.state === 'charging') chargeCount++;
      }
      // Header showing fleet-wide tally
      const header = document.createElement('div');
      header.className = 'customer-fleet-summary';
      header.innerHTML = `
        <span class="fleet-stat fleet-stat-available">● ${availCount} AVAILABLE</span>
        <span class="fleet-stat fleet-stat-flight">⏵ ${flightCount} IN FLIGHT</span>
        <span class="fleet-stat fleet-stat-charging">⚡ ${chargeCount} CHARGING</span>
      `;
      listEl.appendChild(header);

      for (const d of designs) {
        const s = statusFor(d.id);
        const card = document.createElement('button');
        card.type = 'button';
        const isSel = state.aircraftId === d.id;
        const isAvailable = s.state === 'available';
        let className = 'customer-aircraft-card';
        if (isSel) className += ' selected';
        className += ' status-' + s.state;     // status-available | status-in_flight | status-charging
        card.className = className;
        card.disabled = !isAvailable;
        const priorFlights = getFlightLogsForDesign(d.id).length;

        // Build status pill + status line by state
        let statusPill, statusLine;
        if (s.state === 'available') {
          statusPill = `<span class="status-pill pill-available">● AVAILABLE</span>`;
          statusLine = `<span class="customer-aircraft-meta">${priorFlights} prior flight${priorFlights === 1 ? '' : 's'} · ${escapeHtml(d.operator || 'no operator')}</span>`;
        } else if (s.state === 'in_flight') {
          statusPill = `<span class="status-pill pill-flight">⏵ IN FLIGHT</span>`;
          statusLine = `<span class="customer-aircraft-status">serving ${escapeHtml(s.customer || 'another customer')}</span>`;
        } else { // charging
          statusPill = `<span class="status-pill pill-charging">⚡ CHARGING</span>`;
          statusLine = `<span class="customer-aircraft-status">battery ${s.battery.toFixed(0)}% · ETA ${Math.ceil((95 - s.battery) / 1.5)}s</span>`;
        }

        card.innerHTML = `
          <div class="customer-aircraft-row">
            <span class="customer-aircraft-name">${escapeHtml(d.name || 'Untitled')}</span>
            ${statusPill}
          </div>
          <span class="customer-aircraft-tail">${escapeHtml(d.tailNumber || '—')}</span>
          ${statusLine}
        `;
        if (isAvailable) {
          card.addEventListener('click', () => {
            state.aircraftId = d.id;
            renderCustomerAircraftList();
            updateCustomerSummary();
          });
        }
        listEl.appendChild(card);
      }
    }

    function updateCustomerSummary() {
      const state = window.__customerModeState;
      const sumEl = document.getElementById('customer-summary');
      const hailBtn = document.getElementById('customer-hail-btn');
      if (!sumEl || !hailBtn) return;
      const region = getCurrentRegionPads();
      let pickupPos = null, dropoffPos = null;
      if (state.pickup) pickupPos = region.pads[state.pickup];
      if (state.dropoff) dropoffPos = region.pads[state.dropoff];
      // User picks LOCATION only; taxi is random. So readiness gate
      // is just pickup + dropoff. Aircraft selection happens inside
      // hailCustomerTaxi at click time. User: "I should be able to
      // choose the location, just the taxi is random."
      const ready = !!(state.pickup && state.dropoff);
      hailBtn.disabled = !ready;
      if (!state.pickup || !state.dropoff) {
        sumEl.innerHTML = `<span style="color:var(--text-secondary)">
          ${!state.pickup ? '◯' : '✓'} Pickup ·
          ${!state.dropoff ? '◯' : '✓'} Dropoff
        </span>`;
        return;
      }
      const tripDist = distMiles(pickupPos, dropoffPos);
      sumEl.innerHTML = `
        <strong>Booking summary</strong><br>
        Pickup: <span class="pickup">${escapeHtml(state.pickup)}</span><br>
        Dropoff: <span class="dropoff">${escapeHtml(state.dropoff)}</span><br>
        Aircraft: <span class="aircraft" style="color:#FFD580">random available taxi</span><br>
        Trip distance: <strong style="color:#fff">${tripDist.toFixed(0)} mi</strong>
      `;
    }

    // Hail taxi → enter the dispatch flow with customer-chosen pickup/dropoff.
    // User: "I should be able to choose the location, just the taxi
    // is random." So pickup + dropoff come from state (user picked
    // them in the picker grid); aircraft is chosen randomly from the
    // AVAILABLE pool right here at click time. The legacy path where
    // state.aircraftId was pre-set (e.g. by re-hail or full-random
    // splash flow) still works — we only randomize when it's missing.

    // Customer hail BYPASS launch path. The default launch() routes
    // splash → mfg-view → pad-view, but mfg-view is the design/CAD
    // editor — we don't want the customer to see it even briefly. The
    // .view CSS opacity transition was making mfg-view fade in to full
    // opacity for ~250-600ms before pad-view took over, producing a
    // visible "CAD view flicker." User: "when I choose hail taxi, it
    // shows the CAD view before spawning at the location, cut out
    // that bug it should spawn directly there."
    //
    // This bypass:
    //   1. Initializes mfg's three.js scene if it's never been built
    //      (needed for shared infrastructure on any future operator
    //      visit) — but does NOT add mfg-view's .active class, so the
    //      CAD UI never becomes visible.
    //   2. Loads the pending design synchronously (the launchpad reads
    //      designs from localStorage anyway, but loadSavedDesign keeps
    //      the mfg scene in sync for round-trips).
    //   3. Removes splash's .active and opens the launchpad directly.
    //      Splash crossfades out via the .view 0.5s opacity transition
    //      while pad-view crossfades in — clean splash → pad transition.
    function customerLaunchDirect() {
      try {
        if (!mfgInitialized) {
          // Init mfg's three.js infrastructure WITHOUT activating the
          // mfg-view. opacity:0 doesn't break canvas size/layout, so
          // initManufacturing's renderer/scene setup still works.
          try { initManufacturing(); mfgInitialized = true; }
          catch (err) { console.warn('[customer launch] mfg init failed:', err); }
        } else if (window.__pendingLoadDesign && typeof window.__loadSavedDesign === 'function') {
          const toLoad = window.__pendingLoadDesign;
          window.__pendingLoadDesign = null;
          try { window.__loadSavedDesign(toLoad); }
          catch (err) { console.warn('[customer launch] design load failed:', err); }
        }
        // Defensive: pendingLoadDesign may still be set if mfg was
        // first-time initialized (the init pass didn't consume it).
        // Load it now so the design is in mfg's scene before pad opens.
        if (window.__pendingLoadDesign && typeof window.__loadSavedDesign === 'function') {
          const toLoad = window.__pendingLoadDesign;
          window.__pendingLoadDesign = null;
          try { window.__loadSavedDesign(toLoad); }
          catch (err) { console.warn('[customer launch] late design load failed:', err); }
        }
        window.__pendingOpenLaunchPad = false;
        // Splash → pad crossfade. openLaunchPad already removes mfg's
        // .active and adds pad's, but it doesn't touch splash — so we
        // do that here. Also strip 'launching' in case some prior path
        // left it set.
        const splash = document.getElementById('splash-view');
        if (splash) {
          splash.classList.remove('active');
          splash.classList.remove('launching');
        }
        // Belt-and-suspenders: ensure mfg-view isn't somehow active.
        document.getElementById('mfg-view')?.classList.remove('active');
        if (typeof window.__openLaunchPad === 'function') {
          try { window.__openLaunchPad(); }
          catch (err) { console.error('[customer launch] open launchpad failed:', err); }
        }
      } catch (err) {
        // Fallback to the long path if the bypass throws — at least the
        // user lands SOMEWHERE rather than getting stuck on the picker.
        console.error('[customer launch] bypass failed, falling back to launch():', err);
        try { launch(); } catch (_) {}
      }
    }
    if (typeof window !== 'undefined') window.__customerLaunchDirect = customerLaunchDirect;

    function hailCustomerTaxi() {
      const state = window.__customerModeState;
      if (!state.pickup || !state.dropoff) return;
      const designs = getAllSavedDesigns();
      if (designs.length === 0) return;

      // If no aircraft is pre-selected, pick a random AVAILABLE one
      if (!state.aircraftId) {
        const realInFlightIds = new Set();
        const flightStates = (typeof window !== 'undefined' && window.__padFlightStates) || [];
        for (const fs of flightStates) {
          if (fs && fs.active && fs.designId) realInFlightIds.add(fs.designId);
        }
        const batteries = (typeof window !== 'undefined' && window.__padDesignBatteries) || null;
        const MIN_BATT = 95 - 0.05;
        const available = designs.filter(d => {
          if (realInFlightIds.has(d.id)) return false;
          if (batteries) {
            const b = batteries.get(d.id);
            if (b && typeof b.battery === 'number' && b.battery < MIN_BATT) return false;
          }
          return true;
        });
        if (available.length === 0) {
          // Every aircraft busy — show the user the live status so
          // they know to wait. Reveal the aircraft list (normally
          // hidden in the location-only flow) by toggling display.
          const list = document.getElementById('customer-aircraft-list');
          if (list) {
            list.style.display = '';
            try { renderCustomerAircraftList(); } catch (_) {}
          }
          const sumEl = document.getElementById('customer-summary');
          if (sumEl) {
            sumEl.innerHTML = `<span style="color:#FFB347">All taxis are currently busy. Watch the fleet status above — the HAIL button will work as soon as one returns.</span>`;
          }
          return;
        }
        const pick = available[Math.floor(Math.random() * available.length)];
        state.aircraftId = pick.id;
      }

      const aircraft = designs.find(d => d.id === state.aircraftId);
      if (!aircraft) return;

      // Set flags the dispatch flow reads to route through customer mode
      window.__pendingLoadDesign = aircraft;
      window.__pendingOpenLaunchPad = true;
      window.__customerModeActive = true;
      window.__customerPickup = state.pickup;
      window.__customerDropoff = state.dropoff;
      window.__customerAircraftId = state.aircraftId;
      // Wipe any in-flight comic speech bubbles. They were spawned by
      // hub crew figures whose world positions are about to project
      // into the customer's POV camera and float against random
      // buildings — see suppression in spawnCrewBubble for the rule.
      try { if (typeof window.__clearAllCrewBubbles === 'function') window.__clearAllCrewBubbles(); }
      catch (_) {}

      // CUSTOMER GROUND POSITION — the live (x, z) of where the user
      // physically is in the world. This is the SINGLE source of truth
      // for "where should the taxi land?" — initialized to the chosen
      // pickup city's pad coord, but updated when the user walks in
      // ground mode. The dispatch system reads this every frame and
      // re-points the inbound cruise waypoint at it, so the taxi
      // always tracks the user's actual position. Locked at the start
      // of final approach so the taxi commits to a touchdown spot.
      const region = getCurrentRegionPads();
      const pickupCoord = region.pads[state.pickup];
      if (pickupCoord) {
        window.__customerGroundPos = { x: pickupCoord.x, z: pickupCoord.z };
      } else {
        window.__customerGroundPos = { x: 0, z: 0 };
      }
      window.__customerPickupLocked = false;     // becomes true on final approach

      // Reset and open the SMS chat panel — operator greets the customer
      // and will send proactive updates as the mission progresses.
      try {
        if (typeof customerChatReset === 'function') customerChatReset();
        if (typeof customerChatOpen === 'function') customerChatOpen();
      } catch (err) { console.warn('[customer chat] open failed:', err); }

      closeCustomerView();

      // Re-hail short-circuit: if we're already in the launchpad (the
      // user just disembarked from a previous ride and is hailing again
      // from the dropoff city), skip launch()'s splash transition + UI
      // teardown and go straight to dispatching the new mission. Detect
      // by checking if pad-view is currently active.
      const padViewActive = document.getElementById('pad-view')?.classList.contains('active');
      if (padViewActive && typeof window.__runCustomerAutoDispatch === 'function') {
        window.__pendingOpenLaunchPad = false;     // already open
        window.__pendingLoadDesign = null;          // no load needed
        window.__runCustomerAutoDispatch();
      } else {
        // First-time customer hail (pad isn't open yet). Use the direct
        // bypass to skip mfg-view's CAD flicker — splash → pad-view in
        // one crossfade, no intermediate editor view ever shown.
        customerLaunchDirect();
      }
    }

    // Wire splash buttons. User: "I should be able to choose the
    // location, just the taxi is random." So clicking opens the
    // picker view — pickup + dropoff selectable by the user, aircraft
    // list hidden, and the HAIL button (inside the picker) picks a
    // random available taxi at click time via hailCustomerTaxi.
    document.getElementById('splash-customer-btn')?.addEventListener('click', () => {
      openCustomerView();
    });

    // Random-everything hail. Picks:
    //   - pickup: random city in current region
    //   - dropoff: random DIFFERENT city
    //   - aircraft: random AVAILABLE aircraft from user's saved fleet
    // If no designs exist or none are available, falls back to opening
    // the picker view (so the user gets a clear empty-state message
    // instead of a silent no-op).
    function hailRandomTaxi() {
      const designs = (typeof getAllSavedDesigns === 'function') ? getAllSavedDesigns() : [];
      if (designs.length === 0) {
        // Nothing to dispatch — fall back to the picker which has the
        // proper empty-state messaging
        openCustomerView();
        return;
      }
      // Determine which aircraft are AVAILABLE (not in flight, not
      // charging). Real runtime state takes priority; the customer
      // fleet sim is consulted otherwise.
      const realInFlightIds = new Set();
      const flightStates = (typeof window !== 'undefined' && window.__padFlightStates) || [];
      for (const fs of flightStates) {
        if (fs && fs.active && fs.designId) realInFlightIds.add(fs.designId);
      }
      const batteries = (typeof window !== 'undefined' && window.__padDesignBatteries) || null;
      const MIN_BATT = 95 - 0.05;
      const available = designs.filter(d => {
        if (realInFlightIds.has(d.id)) return false;
        if (batteries) {
          const b = batteries.get(d.id);
          if (b && typeof b.battery === 'number' && b.battery < MIN_BATT) return false;
        }
        return true;
      });
      if (available.length === 0) {
        // All aircraft busy / charging — fall back to the picker so
        // the user sees the live status of every aircraft and can
        // pick one when it frees up.
        openCustomerView();
        return;
      }
      const aircraft = available[Math.floor(Math.random() * available.length)];

      // Pick random pickup + DIFFERENT random dropoff
      const region = getCurrentRegionPads();
      const cityNames = Object.keys(region.pads);
      if (cityNames.length < 2) {
        // Region has fewer than 2 cities — can't randomize a route;
        // fall back to picker
        openCustomerView();
        return;
      }
      const pickup = cityNames[Math.floor(Math.random() * cityNames.length)];
      let dropoff;
      do {
        dropoff = cityNames[Math.floor(Math.random() * cityNames.length)];
      } while (dropoff === pickup);

      // Stuff the customer mode state and route through the existing
      // dispatch pipeline (hailCustomerTaxi reads these globals).
      window.__customerModeState = window.__customerModeState || {};
      window.__customerModeState.pickup = pickup;
      window.__customerModeState.dropoff = dropoff;
      window.__customerModeState.aircraftId = aircraft.id;
      hailCustomerTaxi();
    }
    if (typeof window !== 'undefined') window.__hailRandomTaxi = hailRandomTaxi;

    document.getElementById('customer-back-btn')?.addEventListener('click', closeCustomerView);
    document.getElementById('customer-hail-btn')?.addEventListener('click', hailCustomerTaxi);

    // Re-hail button: opens customer view pre-filled with the dropoff city
    // (where the user just arrived) as the new pickup. Lets the user place
    // a second/third/etc ride without going back to the splash. Visibility
    // is driven by the dispatch loop's stage tracker.
    document.getElementById('customer-rehail-btn')?.addEventListener('click', () => {
      const newPickup = window.__customerDropoff;
      // Hide this button immediately so it doesn't sit visible behind the
      // customer view modal (the dispatch loop will re-hide it correctly
      // once the new mission starts and the stage changes).
      const btn = document.getElementById('customer-rehail-btn');
      if (btn) btn.hidden = true;
      openCustomerView({ preFillPickup: newPickup });
    });

    // Show a brief notice when the user tries to exit cabin midflight
    // — the only way out should be disembarking at the dropoff. User:
    // "I should not be able to exit the cabin midflight."
    function showCabinLockedToast() {
      let toast = document.getElementById('cabin-locked-toast');
      if (!toast) {
        toast = document.createElement('div');
        toast.id = 'cabin-locked-toast';
        toast.className = 'cabin-locked-toast';
        toast.textContent = 'BUCKLE UP — DISEMBARK AT THE DESTINATION';
        document.body.appendChild(toast);
      }
      toast.classList.remove('show');
      // force reflow so the animation re-fires on rapid re-presses
      void toast.offsetWidth;
      toast.classList.add('show');
      // Clear the auto-hide timer if user spams ESC
      if (window.__cabinLockedToastTimer) clearTimeout(window.__cabinLockedToastTimer);
      window.__cabinLockedToastTimer = setTimeout(() => {
        toast.classList.remove('show');
      }, 1800);
    }

    // Wire cabin HUD exit button
    document.getElementById('cabin-hud-exit')?.addEventListener('click', () => {
      // Same context-aware logic as ESC: at dropoff disembark prompt, do
      // a full ground-mode disembark. Mid-cruise the exit is LOCKED —
      // user must stay in cabin until the aircraft reaches the dropoff
      // hover and the disembark prompt appears.
      const promptEl = document.getElementById('cabin-board-prompt');
      const promptActive = promptEl && promptEl.classList.contains('active');
      if (promptActive) {
        disembarkAtDropoff();
        if (promptEl) promptEl.classList.remove('active');
      } else {
        // Midflight — refuse the exit and explain why
        showCabinLockedToast();
      }
    });

    // ESC key exits cabin view (does not close customer view — that has its own back button)
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && window.__customerModeState.inCabin) {
        // ESC behavior depends on context: if the dropoff disembark prompt
        // is active, treat ESC like E/Enter (full disembark to ground mode
        // at the dropoff city). Mid-cruise the exit is LOCKED — user
        // must stay in cabin until reaching the dropoff hover.
        const promptEl = document.getElementById('cabin-board-prompt');
        const promptActive = promptEl && promptEl.classList.contains('active');
        if (promptActive) {
          disembarkAtDropoff();
          if (promptEl) promptEl.classList.remove('active');
        } else {
          // Midflight — block the exit, show toast
          showCabinLockedToast();
        }
      }
      // E or Enter: board the taxi when prompt is showing pickup, or disembark at dropoff.
      // Both keys work because the natural intuition is "press Enter to enter the taxi"
      // even though the on-screen prompt shows "E" (we now show both in the prompt).
      if ((e.key === 'e' || e.key === 'E' || e.key === 'Enter') && window.__customerModeActive) {
        // Skip if user is typing in an input (chat field). The chat input
        // already calls stopPropagation on Enter, but this is a defensive
        // second layer in case any input doesn't (or new inputs get added).
        const activeTag = document.activeElement?.tagName;
        if (activeTag === 'INPUT' || activeTag === 'TEXTAREA') return;
        const prompt = document.getElementById('cabin-board-prompt');
        if (prompt && prompt.classList.contains('active')) {
          if (window.__customerModeState.inCabin) {
            // We were in cabin; this is the disembark prompt at the
            // dropoff hover. Use disembarkAtDropoff which moves the
            // user's ground pos to the dropoff coord and enters ground
            // walk mode — same first-person experience as at pickup.
            disembarkAtDropoff();
            prompt.classList.remove('active');
          } else {
            // We're at the pickup hover; board the taxi.
            // Try the dispatch-loop stash first (set every frame the
            // customer's flight is the primary). If that's missing for
            // any reason, fall back to scanning __padFlightStates by
            // designId — robust to whatever order things initialize in.
            let flight = window.__customerModeState.activeFlight;
            if (!flight && window.__padFlightStates) {
              flight = window.__padFlightStates.find(f =>
                f && f.active && f.designId === window.__customerAircraftId);
            }
            if (flight && flight.acGroup) {
              enterCabinView(flight.acGroup);
              prompt.classList.remove('active');
            }
          }
        }
      }
    });

    // ============================================================
    // CABIN CHAIR VIEW
    //
    // When the customer's hailed taxi reaches cruise altitude, we attach
    // the dispatch camera to the seat (boardingOffset in the aircraft's
    // local frame) so the user gets a first-person ride. The cabin HUD
    // overlay shows over the 3D scene.
    //
    // Exit triggers:
    //   - ESC key (mid-flight teleport-out)
    //   - "EXIT CABIN" button on the HUD
    //   - Auto-exit when aircraft lands (mission complete)
    // ============================================================
    function enterCabinView(acGroup) {
      window.__customerModeState.inCabin = true;
      window.__customerModeState.cabinAircraft = acGroup;
      // Switch the camera mode FROM whatever it was (ground walk or chase)
      // to dedicated cabin-cam. The dispatch loop has a separate cabin
      // block that positions the camera AT the seat and allows mouse-look
      // panning (drag to rotate yaw/pitch in place). We toggle off the
      // ground-walk and unified-lerp paths so neither stomps on us.
      if (typeof window.__setPadGroundCam === 'function') {
        window.__setPadGroundCam(false);
      }
      window.__padCabinCam = true;
      // Build the luxurious cabin interior — floor, ceiling, walls with
      // windows, seats, dashboard. Without this the user looking around
      // inside their saved aircraft sees only the raw mesh parts they
      // designed (rotors, fuselage struts) which looks like floating
      // pieces. The interior is parented to acGroup so it travels with
      // the aircraft and is hidden when not in cabin view (so chase cam
      // doesn't show a box around the aircraft).
      try {
        if (typeof window.__buildCabinInterior === 'function') {
          window.__buildCabinInterior(acGroup);
        }
        if (typeof window.__setCabinInteriorVisible === 'function') {
          window.__setCabinInteriorVisible(true);
        }
      } catch (err) { console.warn('[cabin interior] build failed:', err); }
      // Reset pan to look-forward on entry — yaw 0 means no offset from
      // the aircraft's heading, pitch 0 means level. The cabin block
      // applies these as deltas from the aircraft's forward direction.
      if (window.__padCabinPan) {
        window.__padCabinPan.yaw = 0;
        window.__padCabinPan.pitch = 0;
      }
      const hud = document.getElementById('cabin-hud');
      if (hud) hud.classList.add('active');
      const status = document.getElementById('cabin-hud-status');
      if (status) status.textContent = 'CABIN VIEW · IN FLIGHT · ' +
        (window.__customerDropoff || '—');
    }

    function exitCabinView() {
      window.__customerModeState.inCabin = false;
      window.__customerModeState.cabinAircraft = null;
      window.__padCabinCam = false;
      // Tear down the cabin interior — it's not needed when chase cam is
      // showing the aircraft from outside, and leaving it visible would
      // show a wall-shaped box wrapping the aircraft body in chase view.
      try {
        if (typeof window.__destroyCabinInterior === 'function') {
          window.__destroyCabinInterior();
        }
      } catch (err) { console.warn('[cabin interior] destroy failed:', err); }
      const hud = document.getElementById('cabin-hud');
      if (hud) hud.classList.remove('active');
    }

    // Disembark at the dropoff city — user gets out of the taxi and stands
    // on the ground in first-person walk mode. Distinct from exitCabinView,
    // which is also used for mid-cruise ESC and mission-complete cleanup
    // (cases where teleporting the user to the dropoff city would be wrong).
    // Updates __customerGroundPos to dropoff coords so the camera-override
    // and ground-mode spawn both anchor on the dropoff pad, then triggers
    // ground walk mode the same way customer mode auto-spawn does.
    function disembarkAtDropoff() {
      // Move the user's ground pos to the dropoff city coord so the
      // camera-override block + ground-mode spawn both anchor here.
      const region = (typeof getCurrentRegionPads === 'function')
        ? getCurrentRegionPads() : null;
      const dropoffCoord = region?.pads?.[window.__customerDropoff];
      if (dropoffCoord) {
        window.__customerGroundPos = { x: dropoffCoord.x, z: dropoffCoord.z };
      }
      // Tear down cabin view first
      exitCabinView();
      // Programmatically click GROUND so the user lands in first-person
      // walk mode at the dropoff city, just like at pickup spawn.
      try {
        const groundBtn = document.querySelector('.pad-cam-btn[data-cam="ground"]');
        if (groundBtn) groundBtn.click();
      } catch (err) {
        console.warn('[customer mode] dropoff ground-mode trigger failed:', err);
      }
    }
    window.__disembarkAtDropoff = disembarkAtDropoff;

    // Expose for dispatch code to call
    window.__enterCabinView = enterCabinView;
    window.__exitCabinView = exitCabinView;

    /* ==================================================== */
    /* CUSTOMER ↔ OPERATOR SMS CHAT                          */
    /*                                                       */
    /* Realistic dispatcher chatter: when the user opens     */
    /* customer view + hits hail, the operator greets and    */
    /* sends mission updates as the flight progresses        */
    /* (taxi inbound, taxi arrived, in flight, arrived).     */
    /* User can type messages and operator responds with     */
    /* context-aware canned replies.                         */
    /* ==================================================== */
    const customerChat = {
      messages: [],          // {who: 'me'|'them'|'system', text, t}
      panelEl: null,
      bodyEl: null,
      typingEl: null,
      inputEl: null,
      lastStage: null,       // mission stage we last reacted to
    };

    // Lookup helper — returns the customer's chosen aircraft as
    // { name, tail, operator } or null if not yet selected. The dispatcher
    // uses this in messages so the customer sees the operator is actually
    // tracking the specific vehicle they picked (design name + tail
    // number), not just generic "a taxi" language. Reads from the saved
    // designs registry via the customer-mode aircraftId set at hail time.
    function customerChatGetAircraftInfo() {
      try {
        const id = window.__customerAircraftId;
        if (!id || typeof getAllSavedDesigns !== 'function') return null;
        const designs = getAllSavedDesigns();
        const d = designs.find(x => x.id === id);
        if (!d) return null;
        return {
          name: d.name || 'Untitled',
          tail: d.tailNumber || '—',
          operator: d.operator || '',
        };
      } catch (err) {
        console.warn('[customer chat] aircraft lookup failed:', err);
        return null;
      }
    }

    function customerChatOpen() {
      const panel = document.getElementById('customer-chat-panel');
      if (!panel) return;
      panel.classList.add('active');
      panel.classList.remove('collapsed');
      customerChat.panelEl  = panel;
      customerChat.bodyEl   = document.getElementById('customer-chat-body');
      customerChat.typingEl = document.getElementById('customer-chat-typing');
      customerChat.inputEl  = document.getElementById('customer-chat-input');
      // Update the header subtitle to show the assigned aircraft, so the
      // operator's awareness of the booking is visible at a glance — not
      // just embedded in messages. Falls back to the generic brand line
      // if no aircraft is known yet.
      const statusEl = document.getElementById('customer-chat-status');
      if (statusEl) {
        const ac = customerChatGetAircraftInfo();
        statusEl.textContent = ac
          ? `ONLINE · ASSIGNED ${ac.tail}`
          : 'ONLINE · NEXTBYTE AIR TAXI';
      }
      // Greet the user. Use setTimeout so the typing indicator can show.
      if (customerChat.messages.length === 0) {
        customerChatTyping(true);
        setTimeout(() => {
          customerChatTyping(false);
          // Operator MUST know which aircraft is dispatched — the user
          // explicitly picked it. Reference the design name + tail number
          // so the customer sees the operator is actually tracking the
          // assigned vehicle, not just generically "a taxi."
          const ac = customerChatGetAircraftInfo();
          const acDesc = ac
            ? `Your ride — ${ac.name} (tail ${ac.tail})${ac.operator ? `, operated by ${ac.operator}` : ''} — `
            : 'Your taxi ';
          customerChatPushThem(
            `Hi! I'm your dispatcher. ${acDesc}is being prepped at the hub for your trip to ` +
            `${window.__customerDropoff || 'your dropoff'}. ETA to pickup ~3 min. ` +
            `Text me here if you need anything.`
          );
        }, 900);
      }
    }
    function customerChatClose() {
      if (customerChat.panelEl) customerChat.panelEl.classList.remove('active');
      // Reset the header subtitle so a future ride doesn't briefly show
      // the previous aircraft's tail before customerChatOpen updates it.
      const statusEl = document.getElementById('customer-chat-status');
      if (statusEl) statusEl.textContent = 'ONLINE · NEXTBYTE AIR TAXI';
      // Keep messages so re-opening shows history; clear only on full reset.
    }
    function customerChatReset() {
      customerChat.messages = [];
      customerChat.lastStage = null;
      if (customerChat.bodyEl) {
        // Remove all message nodes but keep the typing element
        const typing = customerChat.typingEl;
        customerChat.bodyEl.innerHTML = '';
        if (typing) customerChat.bodyEl.appendChild(typing);
      }
    }
    function customerChatScroll() {
      if (customerChat.bodyEl) {
        customerChat.bodyEl.scrollTop = customerChat.bodyEl.scrollHeight;
      }
    }
    function customerChatPush(who, text) {
      customerChat.messages.push({ who, text, t: Date.now() });
      const bubble = document.createElement('div');
      bubble.className = 'customer-chat-msg ' + who;
      bubble.textContent = text;
      // Insert before typing indicator so typing stays at the end
      if (customerChat.typingEl && customerChat.bodyEl) {
        customerChat.bodyEl.insertBefore(bubble, customerChat.typingEl);
      } else if (customerChat.bodyEl) {
        customerChat.bodyEl.appendChild(bubble);
      }
      customerChatScroll();
    }
    function customerChatPushMe(text)     { customerChatPush('me', text); }
    function customerChatPushThem(text)   { customerChatPush('them', text); }
    function customerChatPushSystem(text) { customerChatPush('system', text); }
    function customerChatTyping(on) {
      if (!customerChat.typingEl) return;
      customerChat.typingEl.classList.toggle('active', !!on);
      if (on) customerChatScroll();
    }

    // Operator's response generator: reads the user's text + the current
    // mission stage, picks a contextually appropriate canned reply.
    function customerChatPickResponse(userText) {
      const t = (userText || '').toLowerCase();
      const stage = window.__customerModeState?.stage || 'inbound_to_pickup';
      const pickup  = window.__customerPickup  || 'pickup';
      const dropoff = window.__customerDropoff || 'dropoff';
      const ac = customerChatGetAircraftInfo();
      const acRef = ac ? `${ac.name} (${ac.tail})` : 'your taxi';

      // "What aircraft / which taxi / what model" — operator names the
      // specific vehicle the user is being assigned. Most-specific keywords
      // first so this catches before a generic ETA fallback.
      if (/\b(what aircraft|which aircraft|what taxi|which taxi|what model|what vehicle|which vehicle|which one|tail number|tail #)\b/.test(t)) {
        if (ac) {
          return `You're booked on ${ac.name}, tail ${ac.tail}` +
                 (ac.operator ? `, operated by ${ac.operator}` : '') +
                 `. ${stage === 'inbound_to_pickup' ? 'Look for it on final approach to ' + pickup + '.' : ''}`;
        }
        return `Let me check the assignment — one moment.`;
      }

      // Question-pattern detection — order matters (most specific first)
      if (/\b(eta|how long|when|arrive|how far)\b/.test(t)) {
        if (stage === 'inbound_to_pickup') return `${acRef} is inbound. ETA to ${pickup} ~2 min.`;
        if (stage === 'at_pickup')          return `${acRef} has just landed. Press E or Enter to board.`;
        if (stage === 'in_cabin')           return `In flight to ${dropoff} on ${acRef}. ETA ~4 min based on current cruise.`;
        if (stage === 'at_dropoff')         return `You've arrived at ${dropoff}. Have a great day!`;
        return `${acRef} is on the way.`;
      }
      if (/\b(cancel|abort|refund)\b/.test(t)) {
        return `I can cancel — just confirm with "yes cancel" and I'll route ${acRef} back. ` +
               `(Note: cancellation in flight isn't possible mid-cruise.)`;
      }
      if (/\b(price|cost|fare|how much|charge)\b/.test(t)) {
        return `This trip from ${pickup} to ${dropoff} on ${acRef} runs about $84 base + $2.10/mi. ` +
               `Final fare posts to your card after dropoff.`;
      }
      if (/\b(safe|safety|emergency|crash|accident)\b/.test(t)) {
        return `${acRef} is FAA Part 135 certified with redundant flight controls. ` +
               `Safety briefing is on the seatback screen once you board.`;
      }
      if (/\b(weather|wind|storm|rain|fog)\b/.test(t)) {
        return `Conditions look good — light winds, ceiling unrestricted. We'd auto-divert if not.`;
      }
      if (/\b(hi|hey|hello|yo|sup)\b/.test(t)) {
        return `Hey! Anything I can help with?`;
      }
      if (/\b(thanks|thx|thank you|appreciate)\b/.test(t)) {
        return `You got it. Safe travels!`;
      }
      if (/\b(bathroom|restroom|toilet|food|drink|water|hungry)\b/.test(t)) {
        return `No amenities on this short hop — but we're touching down soon. ` +
               `Plenty of options at ${dropoff}.`;
      }
      if (/\?$/.test(t.trim())) {
        // Generic question
        return `Good question — let me check on that for you. Anything urgent?`;
      }
      // Default fallback — short acknowledgment
      const fallbacks = [
        'Got it.',
        'Roger that.',
        'Acknowledged. Standing by.',
        'Copy. Anything else?',
      ];
      return fallbacks[Math.floor(Math.random() * fallbacks.length)];
    }

    function customerChatSend() {
      if (!customerChat.inputEl) return;
      const text = customerChat.inputEl.value.trim();
      if (!text) return;
      customerChatPushMe(text);
      customerChat.inputEl.value = '';
      // Operator types, then responds
      customerChatTyping(true);
      const reply = customerChatPickResponse(text);
      const delay = 600 + Math.min(text.length * 25, 1400);
      setTimeout(() => {
        customerChatTyping(false);
        customerChatPushThem(reply);
      }, delay);
    }

    // Stage-driven proactive operator messages — fired when the customer
    // mode state machine transitions to a new stage. These are the "your
    // taxi has arrived" / "you've boarded — enjoy the ride" notifications
    // that come in unprompted.
    function customerChatOnStageChange(newStage) {
      if (newStage === customerChat.lastStage) return;
      const prevStage = customerChat.lastStage;
      customerChat.lastStage = newStage;
      const pickup  = window.__customerPickup  || 'pickup';
      const dropoff = window.__customerDropoff || 'dropoff';
      const ac = customerChatGetAircraftInfo();
      const acRef = ac ? `${ac.name} (${ac.tail})` : 'Your taxi';
      // Only fire for transitions, not initial mount
      if (prevStage === null) return;
      let msg = null;
      if (newStage === 'at_pickup') {
        // Operator names the specific tail number that just landed —
        // matches what the user sees on the actual aircraft.
        msg = `${acRef} has touched down at ${pickup}. Walk up and press E or Enter to board.`;
      } else if (newStage === 'in_cabin') {
        msg = `Boarded — enjoy your ride to ${dropoff} on ${acRef}. ` +
              `I'll text when we're approaching.`;
      } else if (newStage === 'at_dropoff') {
        msg = `Arrived at ${dropoff}. Thanks for choosing NEXTBYTE — text us anytime.`;
      }
      if (msg) {
        customerChatTyping(true);
        setTimeout(() => {
          customerChatTyping(false);
          customerChatPushThem(msg);
        }, 700);
      }
    }
    // Expose for the dispatch loop to call (it knows when stage changes)
    window.__customerChatOnStageChange = customerChatOnStageChange;
    window.__customerChatOpen  = customerChatOpen;
    window.__customerChatClose = customerChatClose;
    window.__customerChatReset = customerChatReset;

    // Wire up the chat UI handlers (one-time setup)
    function wireCustomerChat() {
      const header = document.getElementById('customer-chat-header');
      const toggle = document.getElementById('customer-chat-toggle');
      const send   = document.getElementById('customer-chat-send');
      const input  = document.getElementById('customer-chat-input');
      const panel  = document.getElementById('customer-chat-panel');
      if (header) header.addEventListener('click', (e) => {
        // Only toggle when header itself is clicked (not the input below)
        if (panel) panel.classList.toggle('collapsed');
        if (toggle) toggle.textContent = panel?.classList.contains('collapsed') ? '▴' : '▾';
      });
      if (send) send.addEventListener('click', customerChatSend);
      if (input) input.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') {
          // Enter to send. Block this Enter from also triggering the cabin
          // boarding handler — the user is typing a message, not boarding.
          e.stopPropagation();
          customerChatSend();
        }
      });
    }
    wireCustomerChat();

    /* ==================================================== */
    /* MANUFACTURING: Three.js scene                        */
    /* ==================================================== */
    function initManufacturing() {
      const canvas = document.getElementById('three-canvas');
      const scene = new THREE.Scene();
      scene.fog = new THREE.Fog(0x020817, 14, 32);

      // Far clip bumped from 100 to 2000 so parts placed far from
      // origin in the now-infinite design area still render. User:
      // "the designing section needs to be an infinity design area,
      // not limited."
      const camera = new THREE.PerspectiveCamera(35, 1, 0.1, 2000);
      camera.position.set(6, 4, 6);

      const renderer = new THREE.WebGLRenderer({ canvas, antialias: true, alpha: true });
      renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
      renderer.shadowMap.enabled = true;
      renderer.shadowMap.type = THREE.PCFSoftShadowMap;
      renderer.outputColorSpace = THREE.SRGBColorSpace;
      renderer.toneMapping = THREE.ACESFilmicToneMapping;
      renderer.toneMappingExposure = 1.45;

      const controls = new OrbitControls(camera, canvas);
      controls.enableDamping = true;
      controls.dampingFactor = 0.07;
      controls.minDistance = 4;
      // Max zoom-out 14→500 so the user can pan/zoom anywhere in the
      // infinite design area without hitting an artificial wall.
      controls.maxDistance = 500;
      controls.maxPolarAngle = Math.PI / 2.05;
      controls.target.set(0, 0, 0);
      // Expose mfg camera + controls so the AI team button can
      // auto-frame the build action (at default zoom-out the figures
      // are tiny — pull in close so the user actually sees them
      // walking parts in).
      if (typeof window !== 'undefined') {
        window.__mfgCamera = camera;
        window.__mfgControls = controls;
      }

      // ===== DIRECT MANIPULATION: TransformControls + selection =====
      const transformGizmo = new TransformControls(camera, canvas);
      transformGizmo.size = 0.7;
      transformGizmo.setSpace('local');
      // Disable orbit while user is dragging the gizmo handles
      transformGizmo.addEventListener('dragging-changed', (e) => {
        controls.enabled = !e.value;
        if (e.value) {
          // Drag started — capture undo snapshot before mutation
          if (typeof pushUndo === 'function') pushUndo();
        } else {
          // Drag ended — sync inputs and selection box (no snapping — fully free movement)
          syncInspectorInputs();
          if (selectionBoxHelper) selectionBoxHelper.update();
        }
      });
      transformGizmo.addEventListener('change', () => {
        // Live update of inspector inputs while dragging
        if (transformGizmo.dragging) syncInspectorInputs();
        if (selectionBoxHelper) selectionBoxHelper.update();
      });
      scene.add(transformGizmo);

      // Selection state
      let selectedPartName = null;
      let selectionBoxHelper = null;
      const selectRaycaster = new THREE.Raycaster();
      const selectMouse = new THREE.Vector2();
      let pointerDownPos = null;

      // Snap a dragged rotor onto the nearest boom/arm cylinder axis if within reach.
      // The user can fine-tune motor positions along an arm by dragging — but the rotor
      // gets gently locked to the arm's axis so it doesn't float off into space.
      function snapRotorToNearestArm(name) {
        const info = partsRegistry.get(name);
        if (!info?.object || info.kind !== 'rotor') return;
        const armParts = [];
        for (const [n, p] of partsRegistry) {
          if ((p.kind === 'boom' || p.kind === 'arm') && p.object) armParts.push({ n, p });
        }
        if (armParts.length === 0) return;

        const rotorPos = new THREE.Vector3();
        info.object.getWorldPosition(rotorPos);

        // For each boom, find closest point on its line segment (along its long axis).
        // Use the boom's bounding box to derive its endpoints.
        let bestArm = null, bestDist = Infinity, bestPt = null;
        const SNAP_THRESHOLD = 0.85;  // scene units — only snap if within this distance
        for (const { n, p } of armParts) {
          const box = new THREE.Box3().setFromObject(p.object);
          if (box.isEmpty()) continue;
          const size = new THREE.Vector3(); box.getSize(size);
          const center = new THREE.Vector3(); box.getCenter(center);
          // Pick the longest axis as the boom's long direction
          let axis = 'x';
          if (size.y > size.x && size.y > size.z) axis = 'y';
          else if (size.z > size.x && size.z > size.y) axis = 'z';
          const halfLen = size[axis] / 2;
          const a = center.clone(); a[axis] -= halfLen;
          const b = center.clone(); b[axis] += halfLen;
          // Closest point on segment ab to rotor
          const ab = b.clone().sub(a);
          const ap = rotorPos.clone().sub(a);
          const t = Math.max(0, Math.min(1, ap.dot(ab) / ab.lengthSq()));
          const pt = a.clone().add(ab.multiplyScalar(t));
          const d = pt.distanceTo(rotorPos);
          if (d < bestDist) { bestDist = d; bestPt = pt; bestArm = { n, p, axis }; }
        }

        if (bestArm && bestDist < SNAP_THRESHOLD && bestPt) {
          // Snap rotor to the closest point on the boom axis (only Y and the perpendicular axes — not the long axis)
          // This way the rotor can SLIDE along the boom but is locked to its line in the other 2 dims.
          const newWorldPos = bestPt.clone();
          // Rotor sits on top of the boom (offset in Y by ~0.1)
          const boomBox = new THREE.Box3().setFromObject(bestArm.p.object);
          const boomTopY = boomBox.max.y;
          newWorldPos.y = boomTopY + 0.10;
          // Convert world → taxi-local position
          const taxiInverse = new THREE.Matrix4().copy(taxi.matrixWorld).invert();
          const localPos = newWorldPos.applyMatrix4(taxiInverse);
          info.object.position.copy(localPos);
          info.object.userData.snappedTo = bestArm.n;
          // Visual feedback: brief flash on inspector name
          const insName = document.getElementById('ins-name');
          if (insName) {
            const orig = insName.textContent;
            insName.textContent = `${name}  →  snapped to ${bestArm.n}`;
            setTimeout(() => { insName.textContent = orig; }, 1100);
          }
        }
      }

      function selectPart(name) {
        if (!partsRegistry.has(name)) return;
        const info = partsRegistry.get(name);
        if (!info?.object) return;
        selectedPartName = name;

        transformGizmo.attach(info.object);

        if (selectionBoxHelper) scene.remove(selectionBoxHelper);
        selectionBoxHelper = new THREE.BoxHelper(info.object, 0x00E5FF);
        selectionBoxHelper.material.depthTest = false;
        selectionBoxHelper.material.transparent = true;
        selectionBoxHelper.material.opacity = 0.85;
        selectionBoxHelper.renderOrder = 999;
        scene.add(selectionBoxHelper);

        showInspector(name);
      }

      function deselectPart() {
        selectedPartName = null;
        transformGizmo.detach();
        if (selectionBoxHelper) {
          scene.remove(selectionBoxHelper);
          selectionBoxHelper.dispose?.();
          selectionBoxHelper = null;
        }
        hideInspector();
      }

      // Click handler — raycast and select
      canvas.addEventListener('pointerdown', (e) => {
        pointerDownPos = { x: e.clientX, y: e.clientY };
      });
      canvas.addEventListener('pointerup', (e) => {
        if (!pointerDownPos) return;
        const dx = e.clientX - pointerDownPos.x;
        const dy = e.clientY - pointerDownPos.y;
        pointerDownPos = null;
        // If moved more than 4px, treat as drag (orbit), not click
        if (Math.hypot(dx, dy) > 4) return;
        // Don't reselect while gizmo is active in a drag
        if (transformGizmo.dragging) return;

        const rect = canvas.getBoundingClientRect();
        selectMouse.x = ((e.clientX - rect.left) / rect.width) * 2 - 1;
        selectMouse.y = -((e.clientY - rect.top) / rect.height) * 2 + 1;
        selectRaycaster.setFromCamera(selectMouse, camera);

        const hits = selectRaycaster.intersectObject(taxi, true);
        if (hits.length === 0) {
          deselectPart();
          return;
        }
        // Walk up the hierarchy until we find a registered part
        let obj = hits[0].object;
        while (obj && !obj.userData?.partName && obj !== taxi) {
          obj = obj.parent;
        }
        if (obj?.userData?.partName && partsRegistry.has(obj.userData.partName)) {
          selectPart(obj.userData.partName);
        } else {
          deselectPart();
        }
      });

      scene.add(new THREE.HemisphereLight(0x88a8d8, 0x152038, 0.95));
      scene.add(new THREE.AmbientLight(0xa0b8d8, 0.35));

      const key = new THREE.DirectionalLight(0xffffff, 1.65);
      key.position.set(6, 9, 5);
      key.castShadow = true;
      key.shadow.mapSize.set(2048, 2048);
      key.shadow.camera.left = -7; key.shadow.camera.right = 7;
      key.shadow.camera.top = 7; key.shadow.camera.bottom = -7;
      key.shadow.bias = -0.0005;
      scene.add(key);

      const fill = new THREE.DirectionalLight(0xa8c8ff, 0.85);
      fill.position.set(-5, 4, -3);
      scene.add(fill);

      const rim1 = new THREE.PointLight(0x00e5ff, 0.85, 14);
      rim1.position.set(-4, 2, 5);
      scene.add(rim1);

      const rim2 = new THREE.PointLight(0xffd060, 0.55, 12);
      rim2.position.set(4, 1.5, -4);
      scene.add(rim2);

      // INFINITE DESIGN AREA — user: "the designing section needs to
      // be an infinity design area, not limited."
      // Grid bumped from 24u (48 divs) to 1000u (1000 divs, 1u cells).
      // Far edges fade into the scene's background via fog (added below)
      // so there's no visible "end of the world" wall.
      const grid = new THREE.GridHelper(1000, 1000, 0x4a6a98, 0x2a4068);
      grid.position.y = -1.0;
      grid.material.transparent = true;
      grid.material.opacity = 0.8;
      // Disable depth-write so distant grid lines don't z-fight with
      // each other or with the floor at glancing camera angles
      grid.material.depthWrite = false;
      scene.add(grid);

      const floor = new THREE.Mesh(
        new THREE.CircleGeometry(1000, 64),
        new THREE.MeshStandardMaterial({ color: 0x0a1830, roughness: 1, metalness: 0 })
      );
      floor.rotation.x = -Math.PI / 2;
      floor.position.y = -1.0;
      floor.receiveShadow = true;
      scene.add(floor);

      // Fog fades the grid + floor into the scene background as
      // distance increases. Far enough away that close-up design
      // work is unaffected; close enough that the 1000u grid edge
      // is invisible at any reasonable camera distance.
      scene.fog = new THREE.Fog(0x0a1424, 60, 350);

      // ============================================================
      // AI BUILD-TEAM FIGURES (mfg scene)
      //
      // User: "people figures need to come and build it piece by
      // piece, not spit out something."
      //
      // 3 figures live in the design studio. They're hidden until
      // the AI team button is clicked. During the build, they walk
      // in toward the central origin (where parts assemble) and
      // play a "place part" gesture per build step. After the
      // build, they walk back to their perimeter stations.
      //
      // Geometry comes from the same buildCrewFigure helper the
      // launchpad uses — keeps look consistent across both views.
      // ============================================================
      const mfgBuildTeamFigures = [];
      const mfgBuildTeamStations = [
        // OFF-SCREEN positions — workers WALK IN from outside the
        // visible frame for each delivery, then walk back out. User:
        // "they need to actually come in and out of frame with
        // different parts of the aircraft." At default auto-frame
        // (camera at (7,3.5,7) looking at origin) the visible
        // workspace is roughly origin ± 4u. (-10,-8) etc. is well
        // outside the frame.
        { x: -10.0, z: -8.0 },     // back-left, off-screen
        { x:  10.0, z: -8.0 },     // back-right, off-screen
        { x:   0.0, z: 12.0 },     // front center, off-screen
      ];
      const mfgBuildTeamRoles = ['MAINT', 'MAINT', 'OPS'];     // builder mix
      // Self-contained figure builder — does NOT depend on the
      // launchpad having been initialized first. Previously the mfg
      // scene used window.__buildCrewFigure which is only defined
      // after the launchpad init runs. If the user opened the design
      // studio directly (without visiting the hub first), the figure
      // setup silently skipped and NO PEOPLE APPEARED. User caught
      // this: "where are the people bro. are you hallucinating?"
      const MFG_FIG_COLORS = {
        DISPATCH: 0x00E5FF, MAINT: 0xf59e0b, GROUND: 0x4ade80,
        OPS: 0xa78bfa, ATC: 0x60a5fa,
      };
      function buildFigureLocal(roleColor) {
        const fig = new THREE.Group();
        // Body — torso (vest, role-colored)
        const torsoMat = new THREE.MeshStandardMaterial({
          color: roleColor, emissive: roleColor, emissiveIntensity: 0.15,
          roughness: 0.6, metalness: 0.1,
        });
        const torso = new THREE.Mesh(new THREE.BoxGeometry(0.42, 0.62, 0.28), torsoMat);
        torso.position.y = 1.05;
        torso.castShadow = true;
        fig.add(torso);
        // Head — pale flesh tone
        const headMat = new THREE.MeshStandardMaterial({ color: 0xd9c2a6, roughness: 0.7 });
        const head = new THREE.Mesh(new THREE.SphereGeometry(0.16, 12, 10), headMat);
        head.position.y = 1.55;
        head.castShadow = true;
        fig.add(head);
        // Helmet — dark cap with role-colored stripe
        const capMat = new THREE.MeshStandardMaterial({ color: 0x111820, roughness: 0.85 });
        const cap = new THREE.Mesh(new THREE.CylinderGeometry(0.17, 0.17, 0.06, 16), capMat);
        cap.position.y = 1.69;
        fig.add(cap);
        const stripeMat = new THREE.MeshStandardMaterial({
          color: roleColor, emissive: roleColor, emissiveIntensity: 0.7,
        });
        const stripe = new THREE.Mesh(new THREE.TorusGeometry(0.165, 0.012, 6, 16), stripeMat);
        stripe.rotation.x = Math.PI / 2;
        stripe.position.y = 1.71;
        fig.add(stripe);
        // Arms
        const armMat = new THREE.MeshStandardMaterial({ color: 0x2a3848, roughness: 0.8 });
        const armGeo = new THREE.CylinderGeometry(0.07, 0.06, 0.55, 8);
        const armL = new THREE.Mesh(armGeo, armMat);
        armL.position.set(-0.27, 1.05, 0);
        armL.castShadow = true;
        fig.add(armL);
        const armR = new THREE.Mesh(armGeo, armMat);
        armR.position.set(0.27, 1.05, 0);
        armR.castShadow = true;
        fig.add(armR);
        // Legs
        const legMat = new THREE.MeshStandardMaterial({ color: 0x1a242e, roughness: 0.9 });
        const legGeo = new THREE.CylinderGeometry(0.09, 0.07, 0.7, 8);
        const legL = new THREE.Mesh(legGeo, legMat);
        legL.position.set(-0.11, 0.4, 0);
        legL.castShadow = true;
        fig.add(legL);
        const legR = new THREE.Mesh(legGeo, legMat);
        legR.position.set(0.11, 0.4, 0);
        legR.castShadow = true;
        fig.add(legR);
        fig.userData.parts = { torso, head, armL, armR, legL, legR };
        fig.userData.anim = { phase: Math.random() * Math.PI * 2, baseY: 0, facing: 0 };
        return fig;
      }
      try {
        const figFn = buildFigureLocal;     // always defined, no init-order dep
        const colors = MFG_FIG_COLORS;
        for (let i = 0; i < mfgBuildTeamStations.length; i++) {
          const station = mfgBuildTeamStations[i];
          const role = mfgBuildTeamRoles[i];
          const fig = figFn(colors[role]);
          // Mfg scene is offset — floor is at y=-1.0 (vs padScene 0)
          fig.position.set(station.x, -1.0, station.z);
          fig.rotation.y = Math.atan2(0 - station.x, 0 - station.z);
          // Attach a "carried part" placeholder — a small glowing
          // box that rides in front of the torso between the
          // hands. Visible only while walking_in (figure delivering
          // a part). Hidden during placing/idle/walking_back.
          // User: "people need to come as real animations and bring
          // in parts to assemble the aircraft."
          const carriedMat = new THREE.MeshStandardMaterial({
            color: colors[role], emissive: colors[role],
            emissiveIntensity: 0.55, roughness: 0.4, metalness: 0.3,
          });
          const carriedPart = new THREE.Mesh(
            new THREE.BoxGeometry(0.32, 0.20, 0.20), carriedMat
          );
          // Position in front of body, between the raised hands
          carriedPart.position.set(0, 1.05, 0.32);
          carriedPart.visible = false;
          fig.add(carriedPart);
          // Save for animation
          fig.userData.carriedPart = carriedPart;
          // State machine for build choreography
          fig.userData.buildTask = {
            state: 'idle',     // 'idle' | 'walking_in' | 'placing' | 'walking_back'
            homeX: station.x,
            homeZ: station.z,
            targetX: station.x,
            targetZ: station.z,
            gestureUntil: 0,
            walkSpeed: 1.4,
            role: role,
            // Promise resolver — onBuildStep hands a resolver to the
            // task when it dispatches a figure. The mfg tick calls
            // it when the figure reaches placing state, unblocking
            // executeBuildPlan to add the part.
            arrivalResolver: null,
          };
          // Hidden until AI build kicks off
          fig.visible = false;
          scene.add(fig);
          mfgBuildTeamFigures.push(fig);
        }
        console.log('[mfg build team] created', mfgBuildTeamFigures.length, 'figures');
      } catch (err) {
        console.error('[mfg build team] figure setup failed:', err);
      }
      // Expose so the AI team click handler + executeBuildPlan can drive
      window.__mfgBuildTeamFigures = mfgBuildTeamFigures;

      const axesGeo = new THREE.BufferGeometry();
      const axesLines = new Float32Array([
        0,-0.99,0, 0.6,-0.99,0,
        0,-0.99,0, 0,-0.39,0,
        0,-0.99,0, 0,-0.99,0.6
      ]);
      axesGeo.setAttribute('position', new THREE.BufferAttribute(axesLines, 3));
      const axesColors = new Float32Array([
        1,0.37,0.43, 1,0.37,0.43,
        0.29,0.87,0.5, 0.29,0.87,0.5,
        0,0.9,1, 0,0.9,1
      ]);
      axesGeo.setAttribute('color', new THREE.BufferAttribute(axesColors, 3));
      scene.add(new THREE.LineSegments(axesGeo, new THREE.LineBasicMaterial({ vertexColors: true, transparent: true, opacity: 0.7 })));

      const materials = {
        primary: new THREE.MeshStandardMaterial({ color: 0xF0F4FF, metalness: 0.45, roughness: 0.38 }),
        accent:  new THREE.MeshStandardMaterial({ color: 0x1E3A8A, metalness: 0.55, roughness: 0.42 }),
        trim:    new THREE.MeshStandardMaterial({ color: 0x00E5FF, metalness: 0.6,  roughness: 0.28, emissive: 0x00B0CC, emissiveIntensity: 0.45 }),
        glass:   new THREE.MeshStandardMaterial({ color: 0x0a1530, metalness: 0.85, roughness: 0.08, transparent: true, opacity: 0.62 }),
        blade:   new THREE.MeshStandardMaterial({ color: 0x1F2235, metalness: 0.7,  roughness: 0.3,  transparent: true, opacity: 0.78 }),
        housing: new THREE.MeshStandardMaterial({ color: 0x1A2B4A, metalness: 0.75, roughness: 0.4 }),
        gear:    new THREE.MeshStandardMaterial({ color: 0x222233, metalness: 0.85, roughness: 0.32 })
      };

      const taxi = new THREE.Group();
      scene.add(taxi);
      let rotors = [];

      function buildVehicle(type = 'standard', staged = false) {
        while (taxi.children.length) {
          const c = taxi.children[0];
          taxi.remove(c);
          if (c.geometry) c.geometry.dispose();
        }
        rotors = [];

        const dims = {
          standard: { l: 1.30, w: 0.70, h: 0.45, mass: 920,  pax: 4, range: 180, cruise: 240 },
          compact:  { l: 1.10, w: 0.70, h: 0.55, mass: 780,  pax: 2, range: 140, cruise: 220 },
          heavy:    { l: 1.55, w: 0.82, h: 0.50, mass: 1180, pax: 6, range: 220, cruise: 210 },
          sport:    { l: 1.20, w: 0.62, h: 0.36, mass: 820,  pax: 2, range: 240, cruise: 290 }
        }[type];

        // Helper that tags a mesh with its stage and (when staged) hides it initially
        const tag = (mesh, stageName) => {
          mesh.userData.stage = stageName;
          if (staged) mesh.visible = false;
          return mesh;
        };

        const fuselageGeo = new THREE.SphereGeometry(1, 56, 28);
        fuselageGeo.scale(dims.l, dims.h, dims.w);
        const fuselage = new THREE.Mesh(fuselageGeo, materials.primary);
        fuselage.castShadow = true;
        fuselage.receiveShadow = true;
        taxi.add(tag(fuselage, 'shell'));

        const cockpitGeo = new THREE.SphereGeometry(0.97, 36, 18);
        cockpitGeo.scale(dims.l * 0.62, dims.h * 0.62, dims.w * 0.88);
        const cockpit = new THREE.Mesh(cockpitGeo, materials.glass);
        cockpit.position.set(dims.l * 0.18, dims.h * 0.32, 0);
        taxi.add(tag(cockpit, 'shell'));

        const bellyGeo = new THREE.SphereGeometry(1, 32, 16, 0, Math.PI * 2, Math.PI * 0.62, Math.PI * 0.4);
        bellyGeo.scale(dims.l * 0.97, dims.h * 0.97, dims.w * 0.97);
        const belly = new THREE.Mesh(bellyGeo, materials.accent);
        belly.castShadow = true;
        taxi.add(tag(belly, 'accent'));

        const trimGeo = new THREE.TorusGeometry(dims.l * 0.78, 0.025, 10, 96);
        const trim = new THREE.Mesh(trimGeo, materials.trim);
        trim.rotation.x = Math.PI / 2;
        trim.scale.set(1, dims.w / dims.l * 1.04, 1);
        trim.position.y = -0.04;
        taxi.add(tag(trim, 'trim'));

        const noseGeo = new THREE.SphereGeometry(0.13, 20, 14);
        const nose = new THREE.Mesh(noseGeo, materials.accent);
        nose.position.set(dims.l * 0.96, -0.04, 0);
        taxi.add(tag(nose, 'accent'));

        const lightMatRed = new THREE.MeshStandardMaterial({ color: 0xff3344, emissive: 0xff3344, emissiveIntensity: 1.5 });
        const lightMatGreen = new THREE.MeshStandardMaterial({ color: 0x44ff66, emissive: 0x44ff66, emissiveIntensity: 1.5 });
        const lightGeo = new THREE.SphereGeometry(0.05, 12, 8);

        const lL = new THREE.Mesh(lightGeo, lightMatRed);
        lL.position.set(0, 0, -dims.w * 0.96);
        taxi.add(tag(lL, 'trim'));

        const lR = new THREE.Mesh(lightGeo, lightMatGreen);
        lR.position.set(0, 0, dims.w * 0.96);
        taxi.add(tag(lR, 'trim'));

        const armR = Math.max(dims.l, dims.w * 1.7) + 0.55;
        const armY = dims.h * 0.42;

        for (let i = 0; i < 6; i++) {
          const a = (i / 6) * Math.PI * 2 + Math.PI / 6;
          const x = Math.cos(a) * armR;
          const z = Math.sin(a) * armR;
          const innerX = Math.cos(a) * 0.45;
          const innerZ = Math.sin(a) * 0.45;
          const armLen = Math.hypot(x - innerX, z - innerZ);

          const armGeo = new THREE.CylinderGeometry(0.065, 0.085, armLen, 14);
          const arm = new THREE.Mesh(armGeo, materials.accent);
          arm.castShadow = true;
          arm.position.set((x + innerX) / 2, armY, (z + innerZ) / 2);
          arm.rotation.z = Math.PI / 2;
          arm.rotation.y = -a;
          taxi.add(tag(arm, 'arms'));

          const housing = new THREE.Mesh(
            new THREE.CylinderGeometry(0.36, 0.36, 0.16, 36),
            materials.housing
          );
          housing.position.set(x, armY + 0.11, z);
          housing.castShadow = true;
          taxi.add(tag(housing, 'rotors'));

          const ring = new THREE.Mesh(
            new THREE.TorusGeometry(0.34, 0.014, 8, 36),
            materials.trim
          );
          ring.rotation.x = Math.PI / 2;
          ring.position.set(x, armY + 0.19, z);
          taxi.add(tag(ring, 'trim'));

          const hub = new THREE.Mesh(
            new THREE.CylinderGeometry(0.05, 0.05, 0.07, 16),
            materials.trim
          );
          hub.position.set(x, armY + 0.225, z);
          taxi.add(tag(hub, 'trim'));

          const rotorGroup = new THREE.Group();
          rotorGroup.position.set(x, armY + 0.225, z);

          const bladeGeo = new THREE.BoxGeometry(0.72, 0.014, 0.058);
          const b1 = new THREE.Mesh(bladeGeo, materials.blade);
          b1.castShadow = true;
          const b2 = new THREE.Mesh(bladeGeo, materials.blade);
          b2.rotation.y = Math.PI / 2;
          b2.castShadow = true;

          rotorGroup.add(b1);
          rotorGroup.add(b2);
          taxi.add(tag(rotorGroup, 'rotors'));
          rotors.push(rotorGroup);
        }

        const skidLen = dims.l * 1.4;
        const skidGeo = new THREE.CylinderGeometry(0.055, 0.055, skidLen, 14);
        [-dims.w * 0.55, dims.w * 0.55].forEach(z => {
          const skid = new THREE.Mesh(skidGeo, materials.gear);
          skid.position.set(0, -dims.h * 0.92, z);
          skid.rotation.z = Math.PI / 2;
          skid.castShadow = true;
          taxi.add(tag(skid, 'gear'));
          [-dims.l * 0.4, dims.l * 0.4].forEach(x => {
            const strut = new THREE.Mesh(
              new THREE.CylinderGeometry(0.038, 0.038, dims.h * 0.55, 8),
              materials.gear
            );
            strut.position.set(x, -dims.h * 0.62, z);
            taxi.add(tag(strut, 'gear'));
          });
        });

        const set = (id, v) => { const el = document.getElementById(id); if (el) el.textContent = v; };
        set('spec-length', (dims.l * 2).toFixed(1) + ' m');
        set('spec-width', (dims.w * 2 + 1.5).toFixed(1) + ' m');
        set('spec-height', (dims.h * 2.4).toFixed(1) + ' m');
        set('spec-mass', dims.mass.toLocaleString() + ' kg');
        set('spec-pax', dims.pax + ' pax');
        set('spec-range', dims.range + ' km');
        set('spec-cruise', dims.cruise + ' km/h');

        let v = 0, f = 0;
        taxi.traverse(o => {
          if (o.geometry && o.geometry.attributes.position) {
            v += o.geometry.attributes.position.count;
            if (o.geometry.index) f += o.geometry.index.count / 3;
            else f += o.geometry.attributes.position.count / 3;
          }
        });
        set('geo-verts', Math.round(v).toLocaleString());
        set('geo-faces', Math.round(f).toLocaleString());

        const costs = { standard: '$1.4M', compact: '$1.1M', heavy: '$1.8M', sport: '$1.6M' };
        set('unit-cost', costs[type]);
        set('lead-time', '14 DAYS');
        set('geo-mats', '7');
        set('render-mode', document.getElementById('toggle-wireframe')?.classList.contains('active') ? 'WIREFRAME' : 'SOLID');
        set('spec-ceiling', '3,000 m');

        // Build ID derived from fuselage + tail
        const tailVal = document.getElementById('tail-number')?.value || '';
        const buildId = tailVal ? `SDX-${tailVal.replace(/[^A-Z0-9]/gi, '').slice(0, 6).toUpperCase()}` : 'SDX-0001';
        set('build-id', buildId);

        // Mark viewport as populated and activate rotor config row
        document.getElementById('viewport').classList.add('has-vehicle');
        document.getElementById('rotor-hexacopter')?.classList.add('active');
      }

      function clearVehicle() {
        if (typeof deselectPart === 'function') deselectPart();
        while (taxi.children.length) {
          taxi.remove(taxi.children[0]);   // detach only, no dispose
        }
        rotors.length = 0;
        // Clear the AI parts registry too (defined later — guard with typeof)
        if (typeof partsRegistry !== 'undefined') {
          partsRegistry.clear();
        }
        document.getElementById('viewport').classList.remove('has-vehicle');
        document.querySelectorAll('[data-fuselage]').forEach(b => b.classList.remove('active'));
        document.getElementById('rotor-hexacopter')?.classList.remove('active');

        const blank = (id, v) => { const el = document.getElementById(id); if (el) el.textContent = v; };
        ['spec-length','spec-width','spec-height','spec-mass','spec-pax','spec-range','spec-cruise','spec-ceiling'].forEach(id => blank(id, '—'));
        blank('geo-verts', '0'); blank('geo-faces', '0'); blank('geo-mats', '—'); blank('render-mode', '—');
        blank('build-id', '—'); blank('unit-cost', '—'); blank('lead-time', '—');

        document.getElementById('tail-number').value = '';
        document.getElementById('operator').value = '';
        const hist = document.getElementById('ai-history');
        if (hist) hist.innerHTML = '';
      }

      // Empty start state — vehicle only builds when user picks fuselage or runs AI design
      // (Reset returns to this state too)

      let rotorsOn = true;
      let mfgIsActive = () => document.getElementById('mfg-view').classList.contains('active');

      // Nose cam state — declared HERE (before tick() is invoked
      // below) so tick's reference to noseCamState doesn't hit the
      // Temporal Dead Zone on the first synchronous call. The rest
      // of the nose cam code (functions, listeners) is defined later
      // — those are only invoked on user interaction so TDZ doesn't
      // matter.
      const noseCamState = {
        active: false,
        yaw: Math.PI / 2,     // initial: look outward (-X) from nose tip
        pitch: 0,
        dragging: false,
        lastX: 0, lastY: 0,
      };

      function tick() {
        requestAnimationFrame(tick);
        if (!mfgIsActive()) return;
        if (rotorsOn) rotors.forEach(r => r.rotation.y += 0.4);
        // ---- BUILD-TEAM FIGURE ANIMATION ----
        // Each figure walks toward its target, swings legs/arms
        // while moving, and pulses arms during 'placing' gestures.
        // Frame-rate-independent via dt.
        try {
          const cars = mfgBuildTeamFigures;     // alias for brevity
          if (cars && cars.length > 0) {
            const lastT = window.__mfgFigLastTime || performance.now();
            const nowT = performance.now();
            const dt = Math.min(0.1, (nowT - lastT) / 1000);
            window.__mfgFigLastTime = nowT;
            for (const fig of cars) {
              if (!fig.visible) continue;
              const task = fig.userData && fig.userData.buildTask;
              const parts = fig.userData && fig.userData.parts;
              if (!task || !parts) continue;
              const dx = task.targetX - fig.position.x;
              const dz = task.targetZ - fig.position.z;
              const dist = Math.hypot(dx, dz);
              const isWalking = (task.state === 'walking_in' || task.state === 'walking_back') && dist > 0.05;
              // Show carried part only while delivering a part (walking_in)
              const carried = fig.userData.carriedPart;
              if (carried) carried.visible = (task.state === 'walking_in');
              if (isWalking) {
                const step = task.walkSpeed * dt;
                if (step >= dist) {
                  fig.position.x = task.targetX;
                  fig.position.z = task.targetZ;
                } else {
                  fig.position.x += (dx / dist) * step;
                  fig.position.z += (dz / dist) * step;
                }
                // Face direction of travel
                fig.rotation.y = Math.atan2(dx, dz);
                // Leg/arm swing — sine on a stride phase
                task.stepPhase = (task.stepPhase || 0) + dt * 7.0;
                const swing = Math.sin(task.stepPhase) * 0.45;
                if (parts.legL) parts.legL.rotation.x =  swing;
                if (parts.legR) parts.legR.rotation.x = -swing;
                // While carrying a part, arms stay raised (cradling the
                // part); while empty-handed walking back, normal swing.
                if (task.state === 'walking_in') {
                  if (parts.armL) parts.armL.rotation.x = -0.85;
                  if (parts.armR) parts.armR.rotation.x = -0.85;
                } else {
                  if (parts.armL) parts.armL.rotation.x = -swing * 0.7;
                  if (parts.armR) parts.armR.rotation.x =  swing * 0.7;
                }
              } else {
                // Reached target — settle limbs
                if (parts.legL) parts.legL.rotation.x = 0;
                if (parts.legR) parts.legR.rotation.x = 0;
                if (task.state === 'walking_in' && dist <= 0.05) {
                  task.state = 'placing';
                  task.gestureUntil = nowT + 1500;     // 1.5s of drilling — long enough to see
                  // ARRIVAL: hand the part off. Resolve the Promise
                  // so executeBuildPlan adds the actual part to the
                  // aircraft right when the figure puts it down.
                  if (typeof task.arrivalResolver === 'function') {
                    try { task.arrivalResolver(); } catch (_) {}
                    task.arrivalResolver = null;
                  }
                }
                if (task.state === 'walking_back' && dist <= 0.05) {
                  task.state = 'idle';
                  // Return to home facing
                  fig.rotation.y = Math.atan2(0 - task.homeX, 0 - task.homeZ);
                }
              }
              // Placing gesture — DRILLING motion. User: "details
              // need to be shown like, them screwing in parts,
              // drilling, not parts just appearing in air." Arms
              // are held forward toward the build site and the
              // figure leans slightly. Fast 8 Hz oscillation in arm
              // pitch + a small body lean simulates working with
              // tools (screwdriver, drill).
              if (task.state === 'placing') {
                const tElapsed = (task.gestureUntil - nowT) / 1000;
                // Drilling oscillation — fast 8 Hz, ±0.18 rad on top
                // of a base forward-reach pose
                const phase = nowT * 0.012;     // ~8 Hz
                const drillL = -0.7 + Math.sin(phase) * 0.18;
                const drillR = -0.7 + Math.sin(phase + Math.PI) * 0.18;     // anti-phase
                if (parts.armL) parts.armL.rotation.x = drillL;
                if (parts.armR) parts.armR.rotation.x = drillR;
                // Slight forward body lean — figure is "into" the work
                if (parts.torso) parts.torso.rotation.x = -0.12;
                if (parts.head)  parts.head.rotation.x  = -0.12;
                if (nowT > task.gestureUntil) {
                  // Done placing — head back home (or wait for next assignment)
                  task.targetX = task.homeX;
                  task.targetZ = task.homeZ;
                  task.state = (Math.hypot(task.homeX - fig.position.x, task.homeZ - fig.position.z) > 0.1)
                    ? 'walking_back' : 'idle';
                  // Reset body posture for the walk back
                  if (parts.torso) parts.torso.rotation.x = 0;
                  if (parts.head)  parts.head.rotation.x  = 0;
                }
              }
            }
          }
        } catch (err) { /* don't kill the loop */ }
        // Nose cam: snap camera to nose tip + apply yaw/pitch each
        // frame (so even if fuselage changes, camera tracks correctly)
        if (noseCamState.active) {
          camera.position.set(getNoseTipX(), 1.45, 0);
          camera.rotation.order = 'YXZ';
          camera.rotation.y = noseCamState.yaw;
          camera.rotation.x = noseCamState.pitch;
          camera.rotation.z = 0;
        } else {
          controls.update();
        }
        renderer.render(scene, camera);
      }
      tick();

      function resize() {
        const w = canvas.clientWidth;
        const h = canvas.clientHeight;
        if (w === 0 || h === 0) return;
        camera.aspect = w / h;
        camera.updateProjectionMatrix();
        renderer.setSize(w, h, false);
      }
      window.__mfgResize = resize;
      new ResizeObserver(resize).observe(canvas);
      resize();

      const colorMap = { 'color-primary': 'primary', 'color-accent': 'accent', 'color-trim': 'trim' };
      Object.entries(colorMap).forEach(([id, matKey]) => {
        const picker = document.getElementById(id);
        const hex = document.getElementById(id.replace('color-', 'hex-'));
        picker.addEventListener('input', () => {
          materials[matKey].color.set(picker.value);
          if (matKey === 'trim') {
            materials.trim.emissive.set(picker.value);
            materials.trim.emissive.multiplyScalar(0.7);
          }
          hex.value = picker.value.replace('#', '').toUpperCase();
          clearActivePreset();
        });
        hex.addEventListener('change', () => {
          let v = hex.value.replace('#', '');
          if (!/^[0-9A-Fa-f]{6}$/.test(v)) { hex.value = picker.value.replace('#', '').toUpperCase(); return; }
          const c = '#' + v;
          picker.value = c;
          materials[matKey].color.set(c);
          if (matKey === 'trim') { materials.trim.emissive.set(c); materials.trim.emissive.multiplyScalar(0.7); }
          clearActivePreset();
        });
      });

      function clearActivePreset() {
        document.querySelectorAll('.preset-card.active').forEach(el => el.classList.remove('active'));
      }

      const presets = {
        classic:  { primary: '#F0F4FF', accent: '#1E3A8A', trim: '#FFD700' },
        stealth:  { primary: '#181820', accent: '#3A3A48', trim: '#FF003C' },
        aurora:   { primary: '#9D4EDD', accent: '#FF006E', trim: '#00F5D4' },
        solar:    { primary: '#FF6B35', accent: '#FFBA08', trim: '#FFE5B4' },
        mint:     { primary: '#5EEAD4', accent: '#0F766E', trim: '#FFFFFF' },
        carbon:   { primary: '#0E0E14', accent: '#2A2A38', trim: '#FF2A6D' },
        sunset:   { primary: '#FB7185', accent: '#FB923C', trim: '#FBBF24' },
        arctic:   { primary: '#E0F2FE', accent: '#0C4A6E', trim: '#67E8F9' },
        midnight: { primary: '#1E1B4B', accent: '#312E81', trim: '#FACC15' },
        forest:   { primary: '#14532D', accent: '#365314', trim: '#FACC15' }
      };

      const presetGrid = document.getElementById('preset-grid');
      Object.entries(presets).forEach(([key, p]) => {
        const card = document.createElement('button');
        card.className = 'preset-card';
        card.dataset.preset = key;
        card.innerHTML = `
          <div class="preset-swatch">
            <span style="background:${p.primary}"></span>
            <span style="background:${p.accent}"></span>
            <span style="background:${p.trim}"></span>
          </div>
          <div class="preset-name">${key}</div>
        `;
        card.addEventListener('click', () => applyPreset(key, card));
        presetGrid.appendChild(card);
      });

      function applyPreset(name, cardEl) {
        const p = presets[name];
        materials.primary.color.set(p.primary);
        materials.accent.color.set(p.accent);
        materials.trim.color.set(p.trim);
        materials.trim.emissive.set(p.trim);
        materials.trim.emissive.multiplyScalar(0.7);

        const setVal = (id, v) => { document.getElementById(id).value = v; };
        setVal('color-primary', p.primary);
        setVal('color-accent', p.accent);
        setVal('color-trim', p.trim);
        setVal('hex-primary', p.primary.replace('#', '').toUpperCase());
        setVal('hex-accent', p.accent.replace('#', '').toUpperCase());
        setVal('hex-trim', p.trim.replace('#', '').toUpperCase());

        clearActivePreset();
        cardEl?.classList.add('active');
      }

      document.querySelector('[data-preset="classic"]')?.classList.add('active');

      document.querySelectorAll('[data-fuselage]').forEach(btn => {
        btn.addEventListener('click', () => {
          document.querySelectorAll('[data-fuselage]').forEach(b => b.classList.remove('active'));
          btn.classList.add('active');
          buildVehicle(btn.dataset.fuselage);
        });
      });

      document.querySelectorAll('[data-view]').forEach(btn => {
        btn.addEventListener('click', () => {
          document.querySelectorAll('[data-view]').forEach(b => b.classList.remove('active'));
          btn.classList.add('active');
          const v = btn.dataset.view;
          if (v === 'nosecam') {
            // First-person: camera anchors to nose cone tip; tick loop
            // updates position + rotation each frame.
            setNoseCam(true);
            return;
          }
          // Switching to any other view exits nose cam if active
          if (noseCamState.active) setNoseCam(false);
          const targets = {
            front: [0, 0.5, 8],
            side:  [8, 0.5, 0],
            top:   [0.001, 9, 0.001],
            iso:   [6, 4, 6]
          };
          const [x, y, z] = targets[v];
          animateCamera(x, y, z);
        });
      });

      function animateCamera(x, y, z) {
        const start = camera.position.clone();
        const end = new THREE.Vector3(x, y, z);
        const startTarget = controls.target.clone();
        const endTarget = new THREE.Vector3(0, 0, 0);
        const dur = 700;
        const t0 = performance.now();
        function step() {
          const t = Math.min(1, (performance.now() - t0) / dur);
          const k = 1 - Math.pow(1 - t, 3);
          camera.position.lerpVectors(start, end, k);
          controls.target.lerpVectors(startTarget, endTarget, k);
          if (t < 1) requestAnimationFrame(step);
        }
        step();
      }

      // ============================================================================
      // NOSE CAM — first-person camera mounted on the nose cone with
      // 360° look-around. User: "put the taxi view camera on the nose
      // cone with a 360 view." Mouse drag rotates yaw + pitch in
      // FPS-style (YXZ Euler order). Yaw is unbounded (full 360°);
      // pitch clamps to ±π/2 so the user never flips upside down.
      // ESC or any other view button exits. (noseCamState itself is
      // declared earlier, before the tick loop, to avoid a TDZ
      // ReferenceError on first tick — that bug killed the whole
      // studio when nose cam was first added.)
      // ============================================================================

      function getNoseTipX() {
        // Nose cone is at x = -fuselageLen/2 - 0.35 with cone length
        // 0.9 → tip extends to -fuselageLen/2 - 0.80. Camera sits a
        // hair forward of that so the tip itself doesn't clip into
        // the camera's near plane.
        const fus = (typeof partsRegistry !== 'undefined') ? partsRegistry.get('evtol_fuselage') : null;
        const len = (fus && fus.dims) ? fus.dims.l : 5.6;
        return -(len / 2) - 0.85;
      }

      function setNoseCam(on) {
        noseCamState.active = !!on;
        if (controls) controls.enabled = !on;
        if (canvas) canvas.style.cursor = on ? 'grab' : '';
        if (on) {
          // Snap to nose tip + look outward in -X direction.
          // FPS-style rotation order: yaw around Y, then pitch around X.
          noseCamState.yaw = Math.PI / 2;
          noseCamState.pitch = 0;
          camera.rotation.order = 'YXZ';
        } else {
          // Restore default rotation when leaving
          camera.rotation.set(0, 0, 0);
          camera.rotation.order = 'XYZ';
        }
      }
      if (typeof window !== 'undefined') {
        window.__setNoseCam = setNoseCam;
        window.__noseCamState = noseCamState;
      }

      // Mouse drag — yaw + pitch
      canvas.addEventListener('mousedown', (e) => {
        if (!noseCamState.active) return;
        noseCamState.dragging = true;
        noseCamState.lastX = e.clientX;
        noseCamState.lastY = e.clientY;
        canvas.style.cursor = 'grabbing';
      });
      window.addEventListener('mousemove', (e) => {
        if (!noseCamState.active || !noseCamState.dragging) return;
        const dx = e.clientX - noseCamState.lastX;
        const dy = e.clientY - noseCamState.lastY;
        noseCamState.lastX = e.clientX;
        noseCamState.lastY = e.clientY;
        noseCamState.yaw   -= dx * 0.005;     // unbounded — full 360°
        noseCamState.pitch -= dy * 0.005;
        // Clamp pitch to ±~88° so the user can't flip upside down
        const lim = Math.PI / 2 - 0.02;
        if (noseCamState.pitch >  lim) noseCamState.pitch =  lim;
        if (noseCamState.pitch < -lim) noseCamState.pitch = -lim;
      });
      window.addEventListener('mouseup', () => {
        if (noseCamState.dragging) {
          noseCamState.dragging = false;
          if (canvas && noseCamState.active) canvas.style.cursor = 'grab';
        }
      });
      // Touch drag for mobile
      canvas.addEventListener('touchstart', (e) => {
        if (!noseCamState.active || !e.touches[0]) return;
        noseCamState.dragging = true;
        noseCamState.lastX = e.touches[0].clientX;
        noseCamState.lastY = e.touches[0].clientY;
      }, { passive: true });
      canvas.addEventListener('touchmove', (e) => {
        if (!noseCamState.active || !noseCamState.dragging || !e.touches[0]) return;
        const dx = e.touches[0].clientX - noseCamState.lastX;
        const dy = e.touches[0].clientY - noseCamState.lastY;
        noseCamState.lastX = e.touches[0].clientX;
        noseCamState.lastY = e.touches[0].clientY;
        noseCamState.yaw   -= dx * 0.005;
        noseCamState.pitch -= dy * 0.005;
        const lim = Math.PI / 2 - 0.02;
        if (noseCamState.pitch >  lim) noseCamState.pitch =  lim;
        if (noseCamState.pitch < -lim) noseCamState.pitch = -lim;
      }, { passive: true });
      canvas.addEventListener('touchend', () => {
        noseCamState.dragging = false;
      });

      // ESC exits nose cam back to ISO 3D
      window.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && noseCamState.active) {
