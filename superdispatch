      // Run a single command through the parser/executor (mirrors runCommand path
      // but doesn't echo into the chat textarea — keeps the parts bank quiet).
      // Snapshots state before each stateful command so UNDO works for parts-bank
      // clicks too, not just AI prompt commands.
      async function runPartCommand(cmd) {
        if (cmd === '__clear_all__') {
          // Capture undo BEFORE wiping so user can recover
          if (typeof pushUndo === 'function' && partsRegistry.size > 0) pushUndo();
          if (typeof clearAllParts === 'function') clearAllParts();
          return;
        }
        if (cmd === '__build_evtol__') {
          if (typeof pushUndo === 'function') pushUndo();
          if (typeof buildEVTOL === 'function') buildEVTOL({ paxCount: 4 });
          return;
        }
        if (cmd === '__build_wisk__')   { await buildBrandVariant('wisk');   return; }
        if (cmd === '__build_joby__')   { await buildBrandVariant('joby');   return; }
        if (cmd === '__build_archer__') { await buildBrandVariant('archer'); return; }
        try {
          const parsed = parseCommand(cmd);
          // Snapshot only if this is a stateful action (same gating as the AI prompt path)
          const isStateful = parsed && parsed.action && !NON_STATEFUL_ACTIONS.has(parsed.action);
          if (isStateful && typeof pushUndo === 'function') pushUndo();
          const out = await executeCommand(parsed);
          // If the command failed without changing state, drop the snapshot we pushed
          if (isStateful && out?.error && typeof undoStack !== 'undefined' && undoStack.length > 0) {
            undoStack.pop();
            if (typeof updateUndoButton === 'function') updateUndoButton();
          }
        } catch (e) { console.warn('Part-bank command failed:', cmd, e); }
      }

      document.querySelectorAll('.part-btn').forEach(btn => {
        btn.addEventListener('click', async () => {
          const preset = btn.dataset.preset;
          if (preset && PRESET_CHAINS[preset]) {
            const chain = PRESET_CHAINS[preset];
            // SAFETY: if this preset would wipe the user's existing build,
            // confirm first. The "empty" preset is the only one explicitly
            // intended to clear (so skip the prompt for it).
            const willWipe = chain.includes('__clear_all__') && preset !== 'empty';
            const hasExisting = (typeof partsRegistry !== 'undefined') && partsRegistry.size > 0;
            if (willWipe && hasExisting) {
              const presetName = btn.textContent.trim();
              const partCount = partsRegistry.size;
              const confirmed = confirm(
                `"${presetName}" is a starter template — it will REPLACE your current ` +
                `design (${partCount} parts) with a new one.\n\n` +
                `Continue and replace, or cancel to keep your build?\n\n` +
                `Tip: use SAVE DESIGN first if you want to keep both.`
              );
              if (!confirmed) return;
            }
            // Run preset chain sequentially so each step finishes before the next
            for (const cmd of chain) {
              await runPartCommand(cmd);
              await new Promise(r => setTimeout(r, 80));
            }
            return;
          }
          const cmd = btn.dataset.cmd;
          if (cmd) await runPartCommand(cmd);
        });
      });

      // ============================================================================
      // DRAG-AND-DROP PART PLACEMENT
      // ============================================================================
      // Every non-preset part button is also draggable. Dragging onto the 3D
      // viewport raycasts the cursor to the ground plane and places the new
      // part at that world position (overriding the default origin placement).
      //
      // Mechanism:
      //   1. dragstart on part-btn → stash the data-cmd on the dataTransfer
      //   2. dragover on viewport  → preventDefault to allow drop, show overlay
      //   3. drop on viewport      → raycast to ground, run command, reposition new part
      //
      // We compare the parts-registry size before/after the command to find
      // exactly which parts were added by this drop, so we can move them as a group.
      const dropTarget = document.getElementById('viewport');
      const dropCanvas = canvas;     // the THREE.js canvas inside the viewport

      // Make every non-preset part button draggable
      document.querySelectorAll('.part-btn').forEach(btn => {
        if (btn.classList.contains('part-btn-preset')) return;
        btn.draggable = true;
        btn.addEventListener('dragstart', (e) => {
          const cmd = btn.dataset.cmd;
          if (!cmd) { e.preventDefault(); return; }
          e.dataTransfer.effectAllowed = 'copy';
          e.dataTransfer.setData('text/sdx-cmd', cmd);
          // Fallback for browsers that need plaintext
          e.dataTransfer.setData('text/plain', cmd);
          btn.classList.add('dragging');
        });
        btn.addEventListener('dragend', () => {
          btn.classList.remove('dragging');
        });
      });

      // ===== Snap-placement button handlers =====
      // These let the user place parts at well-defined anchor points on
      // boom/wing/fuselage instead of dragging in 3D. Critically: the chosen
      // target part is auto-detected (most boom-like part wins) so the user
      // doesn't have to click a target first.
      function flashStatusOrLog(msg) {
        if (typeof flashStatus === 'function') flashStatus(msg);
        else console.log(msg);
      }
      function snapHandler(anchor) {
        return () => {
          if (!selectedPartName) {
            flashStatusOrLog('Select a part first (click on it in the 3D view), then snap');
            return;
          }
          const target = findBoomLikePart();
          if (!target) {
            flashStatusOrLog('No boom/arm/wing found — add one first');
            return;
          }
          if (target === selectedPartName) {
            flashStatusOrLog(`Cannot snap "${selectedPartName}" to itself — select a different part to snap`);
            return;
          }
          // Resolve the anchor based on the TARGET's long axis. The buttons
          // are labeled "+Tip"/"-Tip"/"Corner FL" etc. — semantically these
          // mean "the tip of the long axis" and "the long-axis-aligned
          // corner." For an X-axis boom that's tip-pos-x / corner-fr; for
          // a Z-axis boom (or wing oriented forward-back) that's tip-pos-z
          // / corner-... — without this resolution the same button sends a
          // rotor to a SIDE WALL of a Z-axis boom instead of its tip.
          const resolvedAnchor = resolveAnchorForTarget(target, anchor);
          const ok = snapPartToAnchor(selectedPartName, target, resolvedAnchor);
          if (ok) {
            flashStatusOrLog(`Snapped "${selectedPartName}" → ${resolvedAnchor} of "${target}"`);
            if (typeof updateUndoButton === 'function') updateUndoButton();
          } else {
            flashStatusOrLog(`Snap failed — geometry not measurable`);
          }
        };
      }

      // Map a button's intent (e.g. 'tip-pos-x' from the +Tip button) to the
      // target's actual long axis. If the target's bbox is longer in Z than
      // in X, +Tip means tip-pos-z, not tip-pos-x. Without this, snap
      // buttons appear "broken" on Z-oriented booms — clicking "+Tip" puts
      // the rotor at the boom's side, not its end.
      function resolveAnchorForTarget(targetName, requestedAnchor) {
        const box = partWorldBounds(targetName);
        if (!box) return requestedAnchor;
        const sx = box.max.x - box.min.x;
        const sz = box.max.z - box.min.z;
        const longIsZ = sz > sx;
        if (!longIsZ) return requestedAnchor;     // X-axis boom — original anchor is correct
        // Z-axis boom: remap tip-* and corner-* anchors
        switch (requestedAnchor) {
          case 'tip-pos-x':   return 'tip-pos-z';
          case 'tip-neg-x':   return 'tip-neg-z';
          // Corner intent: "FL" = forward-left = (max-X, min-Z) for X-axis boom.
          // For a Z-axis boom, "forward" is +Z and "left" is +X. So FL becomes
          // (max-X-of-target, max-Z-of-target) which is the corner with both
          // axes positive. The anchorPointOnTarget cases are:
          //   corner-fl: (max.x, yTop, min.z)
          //   corner-fr: (max.x, yTop, max.z)
          //   corner-bl: (min.x, yTop, min.z)
          //   corner-br: (min.x, yTop, max.z)
          // For a Z-axis boom (very narrow X), the four "corners" are still
          // the four corners of the bbox, just oriented differently in the
          // world. We pass the requested corner through unchanged — the user
          // gets the corresponding bbox corner. The +Tip/-Tip remap is the
          // critical fix; corners-on-narrow-targets are already at sensible
          // positions (they're tips of the long axis, just slightly offset).
          default: return requestedAnchor;
        }
      }
      const snapBtnAuto = document.getElementById('snap-rotors-auto');
      if (snapBtnAuto) snapBtnAuto.addEventListener('click', () => {
        const result = autoSnapRotorsToBoom();
        if (result.error) {
          flashStatusOrLog(result.error);
        } else {
          flashStatusOrLog(`Snapped ${result.placed} rotor(s) to "${result.target}"`);
          if (typeof updateUndoButton === 'function') updateUndoButton();
        }
      });
      const snapBindings = {
        'snap-selected-tip-pos':   'tip-pos-x',
        'snap-selected-tip-neg':   'tip-neg-x',
        'snap-selected-center':    'center',
        'snap-selected-corner-fl': 'corner-fl',
        'snap-selected-corner-fr': 'corner-fr',
        'snap-selected-corner-bl': 'corner-bl',
        'snap-selected-corner-br': 'corner-br'
      };
      for (const [id, anchor] of Object.entries(snapBindings)) {
        const b = document.getElementById(id);
        if (b) b.addEventListener('click', snapHandler(anchor));
      }

      // Raycast a screen-space (clientX, clientY) to a world point on the ground plane (Y=0)
      function raycastToGround(clientX, clientY) {
        if (!dropCanvas || !camera) return new THREE.Vector3(0, 0, 0);
        const rect = dropCanvas.getBoundingClientRect();
        const ndc = new THREE.Vector2(
          ((clientX - rect.left) / rect.width) * 2 - 1,
          -((clientY - rect.top) / rect.height) * 2 + 1
        );
        const raycaster = new THREE.Raycaster();
        raycaster.setFromCamera(ndc, camera);
        const groundPlane = new THREE.Plane(new THREE.Vector3(0, 1, 0), 0);
        const hit = new THREE.Vector3();
        const intersected = raycaster.ray.intersectPlane(groundPlane, hit);
        if (!intersected) return new THREE.Vector3(0, 0, 0);
        // Clamp to a reasonable design build volume so wild off-canvas drops don't
        // create a part 50 units away
        hit.x = Math.max(-3.5, Math.min(3.5, hit.x));
        hit.z = Math.max(-3.5, Math.min(3.5, hit.z));
        return hit;
      }

      dropTarget?.addEventListener('dragover', (e) => {
        // Only handle drags that originated from our part bank (have our type)
        if (!e.dataTransfer.types.includes('text/sdx-cmd') &&
            !e.dataTransfer.types.includes('text/plain')) return;
        e.preventDefault();
        e.dataTransfer.dropEffect = 'copy';
        dropTarget.classList.add('drop-active');
      });
      dropTarget?.addEventListener('dragleave', (e) => {
        // Only clear when leaving the viewport entirely (not when crossing into
        // a child element) — fired with relatedTarget pointing to the new element
        if (e.relatedTarget && dropTarget.contains(e.relatedTarget)) return;
        dropTarget.classList.remove('drop-active');
      });
      dropTarget?.addEventListener('drop', async (e) => {
        e.preventDefault();
        dropTarget.classList.remove('drop-active');
        const cmd = e.dataTransfer.getData('text/sdx-cmd') || e.dataTransfer.getData('text/plain');
        if (!cmd) return;
        const dropPos = raycastToGround(e.clientX, e.clientY);
        // Capture which parts existed before, so we can identify what this drop added
        const before = new Set(partsRegistry.keys());
        await runPartCommand(cmd);
        // Translate every newly-added part by dropPos, anchored on the first one
        const added = [];
        for (const [name, info] of partsRegistry) {
          if (!before.has(name) && info.object) added.push({ name, info });
        }
        if (added.length === 0) return;
        // Compute the centroid of the newly-added parts so we can shift them as a
        // group (so that 'add 4 rotors' lands as a 4-rotor cluster centered on the
        // drop point, not all stacked at one spot)
        const centroid = new THREE.Vector3();
        for (const a of added) {
          const wp = new THREE.Vector3();
          a.info.object.getWorldPosition(wp);
          centroid.add(wp);
        }
        centroid.divideScalar(added.length);
        const offset = new THREE.Vector3().subVectors(dropPos, centroid);
        // Don't shift Y — we want parts to stay at their natural height (rotors above
        // fuselage, gear below, seats inside). Only shift in the XZ plane.
        offset.y = 0;
        for (const a of added) {
          a.info.object.position.x += offset.x;
          a.info.object.position.z += offset.z;
        }
        // Auto-select the first newly-added part so user can immediately fine-tune
        if (added.length === 1 && typeof selectPart === 'function') {
          try { selectPart(added[0].name); } catch {}
        }
        if (typeof refreshGeometryStats === 'function') refreshGeometryStats();
      });

      // ============================================================================
      // 3D PART THUMBNAILS
      // ============================================================================
      // Each draggable part button gets a small 3D-rendered preview image as a
      // thumbnail. We use a tiny offscreen Three.js renderer to bake each part
      // type once at startup and inject the resulting PNG dataURL into the button.
      //
      // The preview model for each part is a stylized representation that hints
      // at the actual built geometry without costing us full real-time previews.
      function buildPartThumbnails() {
        const SIZE = 112;     // 56px logical × 2 for HiDPI
        const offCanvas = document.createElement('canvas');
        offCanvas.width = SIZE;
        offCanvas.height = SIZE;
        const oRenderer = new THREE.WebGLRenderer({
          canvas: offCanvas, antialias: true, alpha: true, preserveDrawingBuffer: true
        });
        oRenderer.setPixelRatio(1);
        oRenderer.setSize(SIZE, SIZE, false);
        oRenderer.setClearColor(0x000000, 0);
        oRenderer.outputColorSpace = THREE.SRGBColorSpace;

        const oScene = new THREE.Scene();
        // Lighting: top-down key + soft fill so cyan accents pop
        const keyL = new THREE.DirectionalLight(0xffffff, 1.4);
        keyL.position.set(2, 4, 2);
        oScene.add(keyL);
        const fillL = new THREE.DirectionalLight(0x00e5ff, 0.45);
        fillL.position.set(-2, 1, -2);
        oScene.add(fillL);
        oScene.add(new THREE.AmbientLight(0xb0d8ff, 0.35));

        const oCamera = new THREE.PerspectiveCamera(35, 1, 0.1, 50);

        // Material palette: matches the in-app aircraft accents
        const matBody   = new THREE.MeshStandardMaterial({ color: 0xe8eef5, roughness: 0.45, metalness: 0.15 });
        const matAccent = new THREE.MeshStandardMaterial({ color: 0x00e5ff, roughness: 0.3, metalness: 0.5, emissive: 0x004a55, emissiveIntensity: 0.5 });
        const matDark   = new THREE.MeshStandardMaterial({ color: 0x1a2433, roughness: 0.6, metalness: 0.3 });
        const matMid    = new THREE.MeshStandardMaterial({ color: 0x6c7888, roughness: 0.5, metalness: 0.3 });

        // Per-part geometry recipes — each returns a Group + suggested camera distance
        const RECIPES = {
          // BODIES
          'add aircraft fuselage 2.8x0.7x0.7': () => {
            const g = new THREE.Group();
            const m = new THREE.Mesh(new THREE.CapsuleGeometry(0.32, 1.4, 8, 16), matBody);
            m.rotation.z = Math.PI / 2;
            g.add(m);
            return { group: g, dist: 3.4 };
          },
          'add capsule fuselage 2.4x0.65x0.65': () => {
            const g = new THREE.Group();
            const m = new THREE.Mesh(new THREE.CapsuleGeometry(0.3, 1.2, 8, 16), matBody);
            m.rotation.z = Math.PI / 2;
            g.add(m);
            return { group: g, dist: 3.0 };
          },
          'add teardrop fuselage 2.6x0.7x0.55': () => {
            const g = new THREE.Group();
            const m = new THREE.Mesh(new THREE.SphereGeometry(0.45, 24, 16), matBody);
            m.scale.set(1.5, 0.7, 0.65);
            g.add(m);
            return { group: g, dist: 3.0 };
          },
          'add wedge fuselage 2.5x0.5x0.9': () => {
            const g = new THREE.Group();
            // Wedge: triangular prism extruded
            const shape = new THREE.Shape();
            shape.moveTo(-0.7, -0.2);
            shape.lineTo(0.6, 0.0);
            shape.lineTo(0.6, 0.4);
            shape.lineTo(-0.7, 0.4);
            shape.closePath();
            const m = new THREE.Mesh(new THREE.ExtrudeGeometry(shape, { depth: 0.5, bevelEnabled: true, bevelSize: 0.04, bevelThickness: 0.04 }), matBody);
            m.position.set(0, -0.1, -0.25);
            g.add(m);
            return { group: g, dist: 2.8 };
          },
          'add cuboid fuselage 2.4x0.7x0.7': () => {
            const g = new THREE.Group();
            const m = new THREE.Mesh(new THREE.BoxGeometry(1.4, 0.45, 0.45), matBody);
            g.add(m);
            return { group: g, dist: 2.8 };
          },
          'add sphere fuselage 1.4x1.4x1.4': () => {
            const g = new THREE.Group();
            const m = new THREE.Mesh(new THREE.SphereGeometry(0.65, 24, 18), matBody);
            g.add(m);
            return { group: g, dist: 2.5 };
          },
          // CANOPIES
          'add canopy': () => {
            const g = new THREE.Group();
            // Body hint
            const body = new THREE.Mesh(new THREE.CapsuleGeometry(0.2, 0.9, 8, 12), matBody);
            body.rotation.z = Math.PI / 2; body.position.y = -0.15;
            g.add(body);
            // Canopy
            const c = new THREE.Mesh(new THREE.SphereGeometry(0.32, 18, 12, 0, Math.PI * 2, 0, Math.PI / 2), matAccent);
            c.position.set(0.18, 0.1, 0); c.scale.set(1, 0.8, 0.8);
            g.add(c);
            return { group: g, dist: 2.2 };
          },
          'add bubble canopy': () => {
            const g = new THREE.Group();
            const body = new THREE.Mesh(new THREE.CapsuleGeometry(0.2, 0.9, 8, 12), matBody);
            body.rotation.z = Math.PI / 2; body.position.y = -0.18;
            g.add(body);
            const c = new THREE.Mesh(new THREE.SphereGeometry(0.42, 22, 16, 0, Math.PI * 2, 0, Math.PI / 2), matAccent);
            c.position.y = 0.05;
            g.add(c);
            return { group: g, dist: 2.4 };
          },
          'add nose': () => {
            const g = new THREE.Group();
            const body = new THREE.Mesh(new THREE.CapsuleGeometry(0.18, 0.6, 8, 12), matBody);
            body.rotation.z = Math.PI / 2; body.position.x = -0.15;
            g.add(body);
            const cone = new THREE.Mesh(new THREE.ConeGeometry(0.22, 0.55, 18), matAccent);
            cone.rotation.z = -Math.PI / 2; cone.position.x = 0.55;
            g.add(cone);
            return { group: g, dist: 2.4 };
          },
          // WINGS / ARMS / BOOMS
          'add wing': () => {
            const g = new THREE.Group();
            const body = new THREE.Mesh(new THREE.CapsuleGeometry(0.18, 0.7, 8, 10), matBody);
            body.rotation.z = Math.PI / 2;
            g.add(body);
            for (const z of [-0.7, 0.7]) {
              const w = new THREE.Mesh(new THREE.BoxGeometry(0.5, 0.05, 0.55), matAccent);
              w.position.set(0, 0, z);
              g.add(w);
            }
            return { group: g, dist: 2.8 };
          },
          'add 2 booms above fuselage': () => {
            const g = new THREE.Group();
            const body = new THREE.Mesh(new THREE.CapsuleGeometry(0.18, 0.9, 8, 10), matBody);
            body.rotation.z = Math.PI / 2; body.position.y = -0.15;
            g.add(body);
            for (const z of [-0.45, 0.45]) {
              const boom = new THREE.Mesh(new THREE.CylinderGeometry(0.04, 0.04, 1.5, 12), matAccent);
              boom.rotation.z = Math.PI / 2; boom.position.set(0, 0.18, z);
              g.add(boom);
              const py = new THREE.Mesh(new THREE.BoxGeometry(0.13, 0.16, 0.09), matBody);
              py.position.set(0, 0.06, z);
              g.add(py);
            }
            return { group: g, dist: 2.6 };
          },
          'add 4 arms on corners': () => {
            const g = new THREE.Group();
            const hub = new THREE.Mesh(new THREE.BoxGeometry(0.4, 0.18, 0.4), matBody);
            g.add(hub);
            for (const [dx, dz] of [[1,1],[1,-1],[-1,1],[-1,-1]]) {
              const a = new THREE.Mesh(new THREE.CylinderGeometry(0.04, 0.04, 0.7, 10), matAccent);
              a.position.set(dx * 0.35, 0, dz * 0.35);
              a.rotation.set(0, Math.atan2(-dz, dx), Math.PI / 2);
              g.add(a);
            }
            return { group: g, dist: 2.6 };
          },
          'add 6 arms on corners': () => {
            const g = new THREE.Group();
            const hub = new THREE.Mesh(new THREE.CylinderGeometry(0.18, 0.18, 0.16, 18), matBody);
            g.add(hub);
            for (let i = 0; i < 6; i++) {
              const a = new THREE.Mesh(new THREE.CylinderGeometry(0.035, 0.035, 0.7, 10), matAccent);
              const ang = (i / 6) * Math.PI * 2;
              a.position.set(Math.cos(ang) * 0.35, 0, Math.sin(ang) * 0.35);
              a.rotation.set(Math.PI / 2, 0, -ang);
              g.add(a);
            }
            return { group: g, dist: 2.6 };
          },
          'add 8 arms on corners': () => {
            const g = new THREE.Group();
            const hub = new THREE.Mesh(new THREE.CylinderGeometry(0.18, 0.18, 0.16, 18), matBody);
            g.add(hub);
            for (let i = 0; i < 8; i++) {
              const a = new THREE.Mesh(new THREE.CylinderGeometry(0.03, 0.03, 0.65, 10), matAccent);
              const ang = (i / 8) * Math.PI * 2;
              a.position.set(Math.cos(ang) * 0.32, 0, Math.sin(ang) * 0.32);
              a.rotation.set(Math.PI / 2, 0, -ang);
              g.add(a);
            }
            return { group: g, dist: 2.6 };
          },
          // TAILS
          'add V-tail': () => {
            const g = new THREE.Group();
            const body = new THREE.Mesh(new THREE.CapsuleGeometry(0.18, 0.8, 8, 10), matBody);
            body.rotation.z = Math.PI / 2;
            g.add(body);
            for (const sign of [-1, 1]) {
              const f = new THREE.Mesh(new THREE.BoxGeometry(0.2, 0.5, 0.05), matAccent);
              f.position.set(-0.55, 0.18, sign * 0.18);
              f.rotation.x = sign * 0.5;
              g.add(f);
            }
            return { group: g, dist: 2.4 };
          },
          'add T-tail': () => {
            const g = new THREE.Group();
            const body = new THREE.Mesh(new THREE.CapsuleGeometry(0.18, 0.8, 8, 10), matBody);
            body.rotation.z = Math.PI / 2;
            g.add(body);
            const v = new THREE.Mesh(new THREE.BoxGeometry(0.18, 0.55, 0.05), matAccent);
            v.position.set(-0.55, 0.28, 0); g.add(v);
            const h = new THREE.Mesh(new THREE.BoxGeometry(0.2, 0.04, 0.55), matAccent);
            h.position.set(-0.55, 0.55, 0); g.add(h);
            return { group: g, dist: 2.4 };
          },
          'add conventional tail': () => {
            const g = new THREE.Group();
            const body = new THREE.Mesh(new THREE.CapsuleGeometry(0.18, 0.8, 8, 10), matBody);
            body.rotation.z = Math.PI / 2;
            g.add(body);
            const v = new THREE.Mesh(new THREE.BoxGeometry(0.18, 0.45, 0.04), matAccent);
            v.position.set(-0.55, 0.18, 0); g.add(v);
            const h = new THREE.Mesh(new THREE.BoxGeometry(0.18, 0.04, 0.5), matAccent);
            h.position.set(-0.55, 0.05, 0); g.add(h);
            return { group: g, dist: 2.4 };
          },
          'add delta tail': () => {
            const g = new THREE.Group();
            const body = new THREE.Mesh(new THREE.CapsuleGeometry(0.18, 0.8, 8, 10), matBody);
            body.rotation.z = Math.PI / 2;
            g.add(body);
            const shape = new THREE.Shape();
            shape.moveTo(0, 0); shape.lineTo(-0.4, 0.5); shape.lineTo(0, 0.5); shape.closePath();
            const v = new THREE.Mesh(new THREE.ExtrudeGeometry(shape, { depth: 0.04, bevelEnabled: false }), matAccent);
            v.position.set(-0.4, 0, -0.02); g.add(v);
            return { group: g, dist: 2.4 };
          },
          'add H-tail': () => {
            const g = new THREE.Group();
            const body = new THREE.Mesh(new THREE.CapsuleGeometry(0.18, 0.8, 8, 10), matBody);
            body.rotation.z = Math.PI / 2;
            g.add(body);
            for (const sign of [-1, 1]) {
              const fin = new THREE.Mesh(new THREE.BoxGeometry(0.18, 0.4, 0.04), matAccent);
              fin.position.set(-0.55, 0.18, sign * 0.22);
              g.add(fin);
            }
            const h = new THREE.Mesh(new THREE.BoxGeometry(0.18, 0.04, 0.5), matAccent);
            h.position.set(-0.55, 0.18, 0); g.add(h);
            return { group: g, dist: 2.4 };
          },
          // ROTORS
          'add 2 rotors on boom tips': () => {
            const g = new THREE.Group();
            for (const z of [-0.5, 0.5]) {
              const r = new THREE.Mesh(new THREE.CylinderGeometry(0.32, 0.32, 0.04, 24), matAccent);
              r.position.set(0, 0, z); g.add(r);
              const hub = new THREE.Mesh(new THREE.CylinderGeometry(0.06, 0.06, 0.1, 12), matDark);
              hub.position.set(0, 0.06, z); g.add(hub);
            }
            return { group: g, dist: 2.6 };
          },
