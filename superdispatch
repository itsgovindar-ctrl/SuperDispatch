            return {
              parsed: `<span class="pkey">action:</span> <span class="pval">MIRROR</span> &nbsp; <span class="pkey">name:</span> <span class="pval">${cmd.name}</span> &nbsp; <span class="pkey">axis:</span> <span class="pval">${cmd.axis.toUpperCase()}</span>`,
              result: `<span class="check">✓</span>created <span class="val">${r.name}</span> at (${fmt(r.position.x)}, ${fmt(r.position.y)}, ${fmt(r.position.z)})`
            };
          }

          case 'FILLET': {
            const r = applyFillet(cmd.name, cmd.radius);
            if (!r.ok) return { error: r.error };
            const mm = (r.radius * 1000).toFixed(0);
            return {
              parsed: `<span class="pkey">action:</span> <span class="pval">FILLET</span> &nbsp; <span class="pkey">name:</span> <span class="pval">${cmd.name}</span> &nbsp; <span class="pkey">radius:</span> <span class="pval">${mm}mm</span>`,
              result: `<span class="check">✓</span>filleted edges of <span class="val">${cmd.name}</span> with ${mm}mm radius`
            };
          }

          case 'CHAMFER': {
            const r = applyChamfer(cmd.name, cmd.distance);
            if (!r.ok) return { error: r.error };
            const mm = (r.distance * 1000).toFixed(0);
            return {
              parsed: `<span class="pkey">action:</span> <span class="pval">CHAMFER</span> &nbsp; <span class="pkey">name:</span> <span class="pval">${cmd.name}</span> &nbsp; <span class="pkey">distance:</span> <span class="pval">${mm}mm</span>`,
              result: `<span class="check">✓</span>chamfered edges of <span class="val">${cmd.name}</span> at ${mm}mm`
            };
          }

          case 'SHELL': {
            const r = applyShell(cmd.name, cmd.thickness);
            if (!r.ok) return { error: r.error };
            const mm = (r.thickness * 1000).toFixed(0);
            return {
              parsed: `<span class="pkey">action:</span> <span class="pval">SHELL</span> &nbsp; <span class="pkey">name:</span> <span class="pval">${cmd.name}</span> &nbsp; <span class="pkey">thickness:</span> <span class="pval">${mm}mm</span>`,
              result: `<span class="check">✓</span>shelled <span class="val">${cmd.name}</span> · wall thickness ${mm}mm (${r.count} surface${r.count===1?'':'s'})`
            };
          }

          case 'CUT_EXTRUDE': {
            const r = applyExtrudedCut(cmd.name, cmd.depth);
            if (!r) return { error: 'cut-extrude failed' };
            const mm = (cmd.depth * 1000).toFixed(0);
            return {
              parsed: `<span class="pkey">action:</span> <span class="pval">CUT_EXTRUDE</span> &nbsp; <span class="pkey">target:</span> <span class="pval">${cmd.name}</span> &nbsp; <span class="pkey">depth:</span> <span class="pval">${mm}mm</span>`,
              result: `<span class="check">✓</span>extruded cut applied to <span class="val">${cmd.name}</span> · ${mm}mm depth · drag the gizmo to position`
            };
          }

          case 'PATTERN_LINEAR': {
            const r = applyLinearPattern(cmd.name, cmd.count, cmd.spacing, cmd.axis);
            if (!r.ok) return { error: r.error };
            const mm = (cmd.spacing * 1000).toFixed(0);
            return {
              parsed: `<span class="pkey">action:</span> <span class="pval">LINEAR_PATTERN</span> &nbsp; <span class="pkey">source:</span> <span class="pval">${cmd.name}</span> &nbsp; <span class="pkey">count:</span> <span class="pval">${cmd.count}</span> &nbsp; <span class="pkey">spacing:</span> <span class="pval">${mm}mm·${cmd.axis.toUpperCase()}</span>`,
              result: `<span class="check">✓</span>created ${r.created.length} cop${r.created.length===1?'y':'ies'} along ${cmd.axis.toUpperCase()} (total ${cmd.count} instances)`
            };
          }

          case 'PATTERN_CIRCULAR': {
            const r = applyCircularPattern(cmd.name, cmd.count, cmd.axis);
            if (!r.ok) return { error: r.error };
            return {
              parsed: `<span class="pkey">action:</span> <span class="pval">CIRCULAR_PATTERN</span> &nbsp; <span class="pkey">source:</span> <span class="pval">${cmd.name}</span> &nbsp; <span class="pkey">count:</span> <span class="pval">${cmd.count}</span> &nbsp; <span class="pkey">axis:</span> <span class="pval">${cmd.axis.toUpperCase()}</span>`,
              result: `<span class="check">✓</span>created ${r.created.length} cop${r.created.length===1?'y':'ies'} around ${cmd.axis.toUpperCase()}-axis (total ${cmd.count} instances)`
            };
          }

          case 'SUPPRESS': {
            const r = toggleSuppress(cmd.name);
            if (!r.ok) return { error: r.error };
            return {
              parsed: `<span class="pkey">action:</span> <span class="pval">${r.suppressed ? 'SUPPRESS' : 'UNSUPPRESS'}</span> &nbsp; <span class="pkey">name:</span> <span class="pval">${cmd.name}</span>`,
              result: `<span class="check">✓</span>${cmd.name} is now <span class="val">${r.suppressed ? 'SUPPRESSED' : 'VISIBLE'}</span>`
            };
          }

          case 'REMOVE': {
            // Try registry first
            if (partsRegistry.has(cmd.name)) {
              disposeRegistered(cmd.name);
              if (partsRegistry.size === 0) document.getElementById('viewport').classList.remove('has-vehicle');
              refreshGeometryStats();
              return {
                parsed: `<span class="pkey">action:</span> <span class="pval">REMOVE</span> &nbsp; <span class="pkey">name:</span> <span class="pval">${cmd.name}</span>`,
                result: `<span class="check">✓</span>removed <span class="val">${cmd.name}</span>`
              };
            }
            // Try removing all parts of a kind
            const kindMap = {
              fuselage: 'fuselage', body: 'fuselage', cockpit: 'cockpit', canopy: 'cockpit',
              nose: 'nose', tail: 'tail', fin: 'tail',
              arm: 'arm', arms: 'arm', boom: 'boom', booms: 'boom',
              rotor: 'rotor', rotors: 'rotor', propeller: 'rotor', propellers: 'rotor',
              skid: 'skid', skids: 'skid', gear: 'gear', wheel: 'gear', wheels: 'gear',
              wing: 'wing', wings: 'wing'
            };
            const kind = kindMap[cmd.name.toLowerCase()];
            if (kind) {
              const removed = [];
              for (const [n, p] of Array.from(partsRegistry.entries())) {
                if (p.kind === kind) { removed.push(n); disposeRegistered(n); }
              }
              if (kind === 'rotor') rotors = [];
              if (removed.length === 0) return { error: `no ${cmd.name} parts found` };
              refreshGeometryStats();
              if (partsRegistry.size === 0) document.getElementById('viewport').classList.remove('has-vehicle');
              return {
                parsed: `<span class="pkey">action:</span> <span class="pval">REMOVE</span> &nbsp; <span class="pkey">kind:</span> <span class="pval">${kind.toUpperCase()}</span>`,
                result: `<span class="check">✓</span>removed ${removed.length} part${removed.length === 1 ? '' : 's'}: <span class="val">${removed.join(', ')}</span>`
              };
            }
            return { error: `no part or kind named "${cmd.name}"` };
          }

          case 'SET_COLOR':
            await setColor(cmd.target, cmd.color);
            return {
              parsed: `<span class="pkey">action:</span> <span class="pval">SET_COLOR</span> &nbsp; <span class="pkey">target:</span> <span class="pval">${cmd.target.toUpperCase()}</span> &nbsp; <span class="pkey">value:</span> <span class="pval">${cmd.color}</span>`,
              result: `<span class="check">✓</span>painted <span class="val">${cmd.target}</span> → <span class="val">${cmd.colorName || cmd.color}</span><span class="swatch" style="background:${cmd.color}"></span>`
            };

          case 'SET_TAIL_NUMBER': {
            document.getElementById('tail-number').value = cmd.value;
