    .fleet-list { display: flex; flex-direction: column; gap: 4px; }
    .fleet-list-item {
      display: grid;
      grid-template-columns: auto 1fr auto auto;
      gap: 8px;
      align-items: center;
      padding: 6px 8px;
      font-family: var(--font-mono);
      font-size: 10px;
      background: rgba(255, 255, 255, 0.02);
      border: 1px solid var(--border);
      border-radius: 3px;
    }
    .fleet-list-item.active { border-color: var(--accent-cyan); background: rgba(0, 229, 255, 0.06); }
    .fleet-list-item .dot {
      width: 8px; height: 8px; border-radius: 50%;
      background: #4ade80;
    }
    .fleet-list-item .dot.charging { background: #f59e0b; }
