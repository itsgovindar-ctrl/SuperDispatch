    .pad-speech-bubble {
      position: absolute;
      background: #ffffff;
      color: #0a0a0a;
      border: 2.5px solid #000;
      border-radius: 16px;
      padding: 7px 12px 8px;
      font-family: 'Comic Sans MS', 'Marker Felt', 'Chalkboard SE', system-ui, sans-serif;
      font-size: 12.5px;
      font-weight: 600;
      line-height: 1.32;
      letter-spacing: 0.005em;
      max-width: 230px;
      min-width: 60px;
      box-shadow: 3px 3px 0 rgba(0, 0, 0, 0.45);
      pointer-events: none;
      /* anchor: bottom-center of the bubble sits on the projected point
         (head-top + small offset). Tail then drops just below. */
      transform: translate(-50%, calc(-100% - 14px));
      transform-origin: bottom center;
      animation: bubble-pop-in 0.22s cubic-bezier(0.34, 1.56, 0.64, 1);
      white-space: normal;
      word-wrap: break-word;
      will-change: transform, left, top, opacity;
    }
    /* Tail — two stacked triangles, black outer + white inner, makes a
       proper outlined comic tail pointing down at the speaker's head. */
    .pad-speech-bubble::before,
    .pad-speech-bubble::after {
      content: '';
      position: absolute;
      left: 50%;
      width: 0;
      height: 0;
    }
    .pad-speech-bubble::before {
      bottom: -13px;
      transform: translateX(-50%);
      border: 11px solid transparent;
      border-top: 13px solid #000;
      border-bottom: 0;
    }
    .pad-speech-bubble::after {
      bottom: -9px;
      transform: translateX(-50%);
      border: 8px solid transparent;
      border-top: 11px solid #ffffff;
      border-bottom: 0;
    }
    /* Variant with tail on the right side — used when speaker is on the
       left side of the scene so the tail visually points back toward them. */
    .pad-speech-bubble.tail-right::before { left: auto; right: 18px; transform: none; }
    .pad-speech-bubble.tail-right::after  { left: auto; right: 21px; transform: none; }
    .pad-speech-bubble.tail-left::before  { left: 18px; transform: none; }
    .pad-speech-bubble.tail-left::after   { left: 21px; transform: none; }
    /* Role-tinted bubbles — tiny color band in the upper-left so you
       can tell which crew is speaking even before reading the text. */
    .pad-speech-bubble .speaker-name {
      display: block;
      font-size: 9px;
      font-weight: 800;
      letter-spacing: 0.10em;
      text-transform: uppercase;
      margin-bottom: 3px;
      color: #555;
      font-family: var(--font-mono);
    }
    .pad-speech-bubble.role-DISPATCH .speaker-name { color: #008caa; }
    .pad-speech-bubble.role-MAINT    .speaker-name { color: #b06a00; }
    .pad-speech-bubble.role-GROUND   .speaker-name { color: #1d8c3a; }
    .pad-speech-bubble.role-OPS      .speaker-name { color: #6446c2; }
    .pad-speech-bubble.role-ATC      .speaker-name { color: #2a5db8; }
    /* Fade-out class added when bubble is about to expire */
    .pad-speech-bubble.fading {
      animation: bubble-fade-out 0.45s ease-out forwards;
    }
    @keyframes bubble-pop-in {
      0%   { opacity: 0; transform: translate(-50%, calc(-100% - 14px)) scale(0.4); }
      70%  { opacity: 1; transform: translate(-50%, calc(-100% - 14px)) scale(1.08); }
      100% { opacity: 1; transform: translate(-50%, calc(-100% - 14px)) scale(1); }
    }
    @keyframes bubble-fade-out {
      0%   { opacity: 1; }
      100% { opacity: 0; transform: translate(-50%, calc(-100% - 22px)) scale(0.92); }
    }
    /* Bubble hidden when offscreen (projection returns out-of-frustum) */
    .pad-speech-bubble.offscreen { opacity: 0; }
