    // ============================================================
    // FLIGHT LOGS + TWO INDEPENDENT FLIGHT COUNTERS
    //
    // Persisted across sessions in localStorage:
    //   sdx_operator_flights — flights YOU dispatched as an operator
    //                           from the launchpad. Starts at 0,
    //                           increments only on real operator
    //                           completions, never ticks live.
    //   sdx_customer_flights — global customer-network activity
    //                           (other operators flying their taxis).
    //                           Starts at 0, ticks live based on
    //                           hangar size.
    //   sdx_flight_logs      — per-design flight history
    //
    // The OLD `sdx_total_flights` key is wiped on load (user requested
    // "start both counters from 0"). Old entries from previous sessions
    // are not migrated — the user wanted a fresh slate.
    // ============================================================
    const OPERATOR_FLIGHTS_KEY = 'sdx_operator_flights';
    const CUSTOMER_FLIGHTS_KEY = 'sdx_customer_flights';
    const TOTAL_FLIGHTS_KEY    = OPERATOR_FLIGHTS_KEY;     // back-compat alias for operator counter
    const FLIGHT_LOGS_KEY      = 'sdx_flight_logs';
    // Per-design battery state. User: "it starts from scratch when i
    // open. should represent data." So the launchpad now persists
    // each aircraft's battery + charging state and reloads it on
    // entry, advancing for wall-clock time the user was away
    // (aircraft sitting on the apron continue to charge).
    const FLEET_BATTERY_KEY    = 'sdx_fleet_battery_v1';

    // One-time wipe of the legacy combined counter so the user starts
    // fresh per their instruction. Guarded so it only runs once per
    // browser via a marker key. Bumped to v8 — user: "start the
    // counters from 0, maybe the bug will go away what do you think."
    // This wipe is broader than v7: in addition to the operator and
    // customer counters, we also drop the persisted FLEET BATTERY map
    // and the RECENT EVENTS feed. Those could each be the source of
    // a phantom "0/14 available" — if every saved design has a
    // restored battery entry below 95% from a prior session, the
    // splash classifies all 14 as "charging" → available=0. Wiping
    // forces a clean slate so we can tell whether the bug is
    // stale-data-driven or a live code-path issue.
    try {
      if (!localStorage.getItem('sdx_counter_split_v9')) {
        localStorage.removeItem('sdx_total_flights');
        localStorage.removeItem(OPERATOR_FLIGHTS_KEY);
        localStorage.removeItem(CUSTOMER_FLIGHTS_KEY);
        // Wipe persisted battery state — when restored entries are
        // all <95%, every design gets classified as "charging" and
        // the splash subline shows 0/N available. Fresh state means
        // every aircraft loads at the default full charge.
        localStorage.removeItem(FLEET_BATTERY_KEY);
        // Wipe the recent activity feed — stale events from prior
        // sessions confused the live indicators
        localStorage.removeItem('sdx_recent_events_v1');
        // Drop all prior counter-split markers
        localStorage.removeItem('sdx_counter_split_v1');
        localStorage.removeItem('sdx_counter_split_v2');
        localStorage.removeItem('sdx_counter_split_v3');
        localStorage.removeItem('sdx_counter_split_v4');
        localStorage.removeItem('sdx_counter_split_v5');
        localStorage.removeItem('sdx_counter_split_v6');
        localStorage.removeItem('sdx_counter_split_v7');
        localStorage.removeItem('sdx_counter_split_v8');
        localStorage.setItem('sdx_counter_split_v9', '1');
      }
    } catch (_) { /* localStorage unavailable; counters default to 0 anyway */ }

    // One-time reset of the hangar panel position. User: "now make
    // this window moveable again, since it is stuck and frozen." The
    // panel had been dragged behind the wordmark area and the drag
    // handle was no longer reachable. The drag init now clamps
    // restored positions away from the wordmark zone, but users with
    // an existing bad position need this one-time wipe to snap the
    // panel back to its default top-right corner. Independent of v8
    // counter wipe so users who already passed v8 still get the
    // unstuck behavior.
    try {
      if (!localStorage.getItem('sdx_panel_unstick_v1')) {
        localStorage.removeItem('sdx_hangar_panel_pos');
        localStorage.setItem('sdx_panel_unstick_v1', '1');
      }
