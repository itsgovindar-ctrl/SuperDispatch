            return {
              parsed: `<span class="pkey">action:</span> <span class="pval">SET_OPERATOR</span>`,
              result: `<span class="check">✓</span>operator: <span class="val">${cmd.value}</span>`
            };

          case 'UNKNOWN':
          default:
            return {
              error: `couldn't parse "${cmd.text}". Type <span class="val">help</span> for the command vocabulary.`
            };
        }
      }

      // ==================== CHAT UI ====================
      function escapeHtml(s) {
        return String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
      }

      function addUserMsg(text) {
        const hist = document.getElementById('ai-history');
        const m = document.createElement('div');
        m.className = 'chat-msg user';
        m.textContent = text;
        hist.appendChild(m);
        m.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      }

      function addAIMsg(parsedHtml, resultHtml, kind = 'success') {
        const hist = document.getElementById('ai-history');
        const m = document.createElement('div');
        m.className = 'chat-msg ai ' + kind;
        const parts = [];
        if (parsedHtml) parts.push('<div class="chat-parsed">' + parsedHtml + '</div>');
        if (resultHtml) parts.push('<div class="chat-result">' + resultHtml + '</div>');
        m.innerHTML = parts.join('');
        hist.appendChild(m);
        m.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      }

      async function runCommand() {
        const promptEl = document.getElementById('ai-prompt');
        const text = promptEl.value.trim();
        if (!text) { promptEl.focus(); return; }

        const btn = document.getElementById('ai-design-btn');
        if (btn.classList.contains('analyzing')) return;
        btn.classList.add('analyzing');
        const btnText = btn.querySelector('.ai-btn-text');
        btnText.textContent = 'BUILDING…';

        addUserMsg(text);
        promptEl.value = '';
        await new Promise(r => setTimeout(r, 180));

        const cmd = parseCommand(text);

        // Capture snapshot before stateful commands so user can undo
        const isStateful = cmd && cmd.action && !NON_STATEFUL_ACTIONS.has(cmd.action);
        if (isStateful) pushUndo();

        const out = await executeCommand(cmd);

        // If the command failed without changing state, drop the snapshot we just pushed
        if (isStateful && out?.error) {
          undoStack.pop();
          updateUndoButton();
        }

        if (out) {
          if (out.error) addAIMsg(out.parsed || '', out.error, 'error');
          else addAIMsg(out.parsed, out.result, 'success');
        }

        btn.classList.remove('analyzing');
        btnText.textContent = 'SEND ▸';
        promptEl.focus();
      }

