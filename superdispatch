    function launch() {
      const splash = document.getElementById('splash-view');
      if (splash.classList.contains('launching')) return;
      splash.classList.add('launching');
      const messages = [
        'DISPATCH SEQUENCE INITIATED',
        'SPOOLING ROTORS · 0X4A7C',
        'CLEARED FOR TAKEOFF'
      ];
      let i = 0;
      const textEl = document.getElementById('launch-text');
      const cycle = setInterval(() => {
        i++;
        if (i >= messages.length) { clearInterval(cycle); return; }
        textEl.textContent = messages[i];
      }, 700);

      setTimeout(showManufacturing, 2400);
