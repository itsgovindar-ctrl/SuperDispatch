      letter-spacing: 0.06em;
      color: var(--text-primary);
    }
    .fleet-badge {
      background: var(--accent-cyan);
      color: #001a22;
      font-family: var(--font-mono);
      font-size: 10px;
      font-weight: 700;
      letter-spacing: 0.12em;
      padding: 3px 7px;
      border-radius: 2px;
