      // ====================================================================
      // SAVE FLOW — opens dialog, persists to localStorage, then routes to launch pad
      // ====================================================================
      let designJustSaved = null;   // when set, closing fleet view goes to launch pad

      function openSaveDialog() {
        const tail = document.getElementById('tail-number')?.value || `SDX-${Math.floor(Math.random() * 9000) + 1000}`;
        document.getElementById('save-name-input').value = '';
