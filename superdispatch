            spec.fwdRotors = 4; spec.rearRotors = 2;
            spec.fwdBlades = 5; spec.rearBlades = 5;
            spec.tail = 'v';
            if (totalRotors) { spec.fwdRotors = Math.min(4, totalRotors); spec.rearRotors = Math.max(0, totalRotors - spec.fwdRotors); }
