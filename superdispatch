      //   - tilt visibly bent (~12-20° random tilt on Z)
      //   - get a red emissive warning ring child mesh
      //   - blade material darkens to look damaged
      function markRotorDead(rotor) {
        if (!rotor || !rotor.userData || rotor.userData.isDead) return;
        rotor.userData.isDead = true;
        rotor.userData.deadTilt = (Math.random() < 0.5 ? -1 : 1) * (0.20 + Math.random() * 0.15);
        try { rotor.rotation.z += rotor.userData.deadTilt; } catch (_) {}
        // Add a red emissive damage ring as a child so it follows the
        // rotor through the rest of the abort flight + landing.
        try {
          if (typeof THREE !== 'undefined' && THREE.RingGeometry && THREE.MeshStandardMaterial) {
            const ringGeo = new THREE.RingGeometry(0.32, 0.46, 16);
            const ringMat = new THREE.MeshStandardMaterial({
              color: 0xff3030,
              emissive: 0xff3030,
              emissiveIntensity: 1.4,
              transparent: true,
              opacity: 0.85,
              side: THREE.DoubleSide,
            });
            const ring = new THREE.Mesh(ringGeo, ringMat);
            ring.rotation.x = Math.PI / 2;
            ring.position.y = 0.06;
            ring.userData.isDamageRing = true;
            rotor.add(ring);
            // Animate the ring's intensity for a pulsing warning effect.
            // Read by the per-frame loop if it cares; cheap to ignore.
            ring.userData.pulsePhase = 0;
          }
        } catch (_) {}
        // Darken the blades + give them a faint red glow so the
        // damaged rotor reads at-a-glance even when not pulsing.
        try {
          rotor.traverse(child => {
            if (!child || !child.isMesh || !child.material) return;
            if (child.userData && child.userData.isDamageRing) return;
            // Don't mutate shared materials — clone if shared
            try {
              if (!child.material.userData || !child.material.userData._faultCloned) {
                child.material = child.material.clone();
                child.material.userData = child.material.userData || {};
                child.material.userData._faultCloned = true;
              }
              if (child.material.color && child.material.color.lerp) {
                child.material.color.lerp(new THREE.Color(0x141414), 0.55);
              }
              if (child.material.emissive) {
                child.material.emissive.setHex(0x220000);
                if (typeof child.material.emissiveIntensity === 'number') {
                  child.material.emissiveIntensity = Math.max(child.material.emissiveIntensity, 0.4);
                }
              }
            } catch (_) {}
          });
        } catch (_) {}
      }
      if (typeof window !== 'undefined') {
        window.__markRotorDead = markRotorDead;
        window.__dispatchCrewForEmergencyLanding = dispatchCrewForEmergencyLanding;
      }

      // ============================================================
      // IR VEHICLE DISPATCH
      // ============================================================
      // Sends the recovery truck out to a target XZ on the scene
      // (typically the abort point or the inbound aircraft's last
      // known position). Per-frame motion is handled in tickPad's
      // state machine; this just primes the state.
      function dispatchIRVehicle(targetX, targetZ) {
        try {
          if (!padScene || !padScene.userData || !padScene.userData.irVehicle) return false;
          const veh = padScene.userData.irVehicle;
          if (!veh.userData) return false;
          // If already out, retarget instead of stomping state
          veh.userData.targetX = targetX;
          veh.userData.targetZ = targetZ;
          if (veh.userData.state === 'parked') {
            veh.userData.state = 'driving_out';
          } else if (veh.userData.state === 'on_scene') {
            // Refresh hold time
            veh.userData.stateUntil = performance.now() + 6000;
          }
          return true;
        } catch (err) { console.warn('[IR dispatch] failed:', err); return false; }
      }
      if (typeof window !== 'undefined') window.__dispatchIRVehicle = dispatchIRVehicle;

      // ============================================================
      // OWNER-ADDRESSED MESSAGES
      // ============================================================
      // VO field reports + occasional MAINT updates address the
      // operator (the user) directly rather than another crew member.
      // Visually distinguished by the .addressed-to-owner CSS class
      // which prepends "@ OWNER · " before the body and tints the
      // background. User: "VO reporting information to me, the owner.
      // Maintenance should also communicate with me too."
      function postCrewMessageToOwner(crew, body) {
        if (!crew) return;
        const msg = {
          name: crew.name, role: crew.role, cls: crew.cls + ' addressed-to-owner',
          icon: crew.icon, body, t: Date.now(),
          addressedToOwner: true,
        };
        padCrewMessages.unshift(msg);
        if (padCrewMessages.length > PAD_CREW_MAX_MESSAGES) padCrewMessages.length = PAD_CREW_MAX_MESSAGES;
        renderCrewFeed();
      }
      if (typeof window !== 'undefined') window.__postCrewMessageToOwner = postCrewMessageToOwner;

      // ============================================================
      // VO FIELD REPORTS (idle)
      // ============================================================
      // Periodic owner-addressed reports from the Visual Observer.
      // Pulled from a small bank of templates that reference real
      // fleet state where possible (active flight count, current
      // pad). Runs on its own slower timer so it doesn't drown the
      // crew-to-crew chatter.
      function generateVOReport() {
        const vo = pickCrewByRole('VO');
        if (!vo) return;
        const designs = (typeof getAllSavedDesigns === 'function') ? getAllSavedDesigns() : [];
        const tails = designs.map(d => d.tailNumber).filter(Boolean);
        const tail = tails.length ? tails[Math.floor(Math.random() * tails.length)] : 'SDX-####';
        const flightStates = (typeof window !== 'undefined' && window.__padFlightStates) || [];
        const airborne = flightStates.filter(f => f && f.active).length;
        const REPORTS = [
          () => `Boss, line-of-sight on the apron is clear. ${airborne} bird${airborne === 1 ? '' : 's'} airborne.`,
          () => `Eyes up, boss — <span class="tail">${tail}</span> tracking nominal at altitude.`,
          () => `Ramp is clean. No FOD, no traffic conflicts.`,
          () => `Visibility is unrestricted. Tracking ${airborne} active flight${airborne === 1 ? '' : 's'}.`,
          () => `Boss, just confirmed ${airborne === 0 ? 'all aircraft on the ground' : airborne + ' inbound on the scope'}.`,
          () => `All quiet on my side. Wind from the west, light.`,
        ];
        const body = REPORTS[Math.floor(Math.random() * REPORTS.length)]();
        postCrewMessageToOwner(vo, body);
        // Comic bubble at hub view (suppressed in customer mode by
        // spawnCrewBubble's gate, same as everyone else)
        try {
          const fig = findCrewFigureByName(vo.name);
          if (fig) {
            const plain = stripBubbleHtml(body);
            spawnCrewBubble(fig, plain, { holdMs: 5000 });
          }
        } catch (_) {}
      }
      if (typeof window !== 'undefined') window.__generateVOReport = generateVOReport;

      // Periodic MAINT updates addressed to the owner. Lower frequency
      // than the VO reports — MAINT mostly chatters with DISPATCH
      // (existing idle chatter); these are the "boss check-ins."
      function generateMaintOwnerUpdate() {
        const mech = pickCrewByRole('MAINT');
        if (!mech) return;
        const designs = (typeof getAllSavedDesigns === 'function') ? getAllSavedDesigns() : [];
        const tails = designs.map(d => d.tailNumber).filter(Boolean);
        const tail = tails.length ? tails[Math.floor(Math.random() * tails.length)] : 'SDX-####';
        const charged = (typeof padDesignBatteries !== 'undefined' && padDesignBatteries) ?
          [...padDesignBatteries.values()].filter(b => b && b.battery >= (95 - 0.05)).length : 0;
        const UPDATES = [
          () => `Boss, <span class="tail">${tail}</span> is back in service. Cleared post-flight.`,
          () => `Quick update — ${charged} aircraft topped off and ready to dispatch.`,
          () => `Working through the inspection queue. No critical findings so far.`,
          () => `Boss, <span class="tail">${tail}</span> is due for the next firmware cycle. Not urgent.`,
          () => `Battery health on the fleet looks good. No outliers this week.`,
        ];
        const body = UPDATES[Math.floor(Math.random() * UPDATES.length)]();
        postCrewMessageToOwner(mech, body);
        try {
          const fig = findCrewFigureByName(mech.name);
          if (fig) {
            const plain = stripBubbleHtml(body);
            spawnCrewBubble(fig, plain, { holdMs: 5000 });
          }
        } catch (_) {}
      }
      if (typeof window !== 'undefined') window.__generateMaintOwnerUpdate = generateMaintOwnerUpdate;

      // Expose for tests
      if (typeof window !== 'undefined') {
        window.__generateCrewConversation = generateCrewConversation;
        window.__triggerCrewFaultConversation = triggerCrewFaultConversation;
        // User-friendly aliases for the browser console — type these to
        // verify the comic bubbles are working without waiting on the
        // timer:
        //   __triggerConvo()                  → fire a random conversation now
        //   __testBubble('Park','hi')         → pop a single test bubble
        //   __triggerFault('motor_out','SDX-0001')  → simulate a fault dialogue
        window.__triggerConvo = generateCrewConversation;
        window.__testBubble = function(name, text) {
          const fig = findCrewFigureByName(name);
          if (!fig) { console.warn('[bubble] no figure for', name, '— roster:', padCrewRoster.map(r => r.name)); return null; }
          return spawnCrewBubble(fig, String(text || 'test bubble'), { holdMs: 6000 });
        };
        window.__triggerFault = triggerCrewFaultConversation;
      }

      function renderCrewFeed() {
        const feed = document.getElementById('pad-crew-feed');
        const countEl = document.getElementById('pad-crew-count');
        if (countEl) {
          // Show roster size + how many figures are currently doing work.
          // "Working" = not idle (walking_to / working / walking_back).
          // Pulled from the live state machine state, not the roster.
          let working = 0, total = 0;
          try {
            if (padScene && padScene.userData && Array.isArray(padScene.userData.crewFigures)) {
              total = padScene.userData.crewFigures.length;
              working = padScene.userData.crewFigures.filter(f =>
                f.userData.task && f.userData.task.state !== 'idle'
              ).length;
            }
          } catch (_) {}
          if (total > 0) {
            countEl.textContent = `${padCrewRoster.length} on shift · ${working}/${total} working`;
          } else {
            countEl.textContent = `${padCrewRoster.length} on shift`;
          }
        }
        if (!feed) return;
        if (padCrewMessages.length === 0) {
          feed.innerHTML = '<div class="pad-crew-empty">Crew clocking in…</div>';
          return;
        }
        // Render newest-first (already reverse-ordered in padCrewMessages)
        feed.innerHTML = padCrewMessages.map(m => {
          const t = new Date(m.t);
          const hh = t.getHours().toString().padStart(2, '0');
          const mm = t.getMinutes().toString().padStart(2, '0');
          const ss = t.getSeconds().toString().padStart(2, '0');
          // Body content already contains escaped/safe markup (template
          // literals build only span tags around our trusted strings)
          return `
            <div class="pad-crew-msg ${m.cls}">
              <div class="pad-crew-msg-head">
                <span class="pad-crew-msg-name">${m.icon} ${m.name}</span>
                <span class="pad-crew-msg-role">${m.role}</span>
                <span class="pad-crew-msg-time">${hh}:${mm}:${ss}</span>
              </div>
              <div class="pad-crew-msg-body">${m.body}</div>
            </div>
          `;
        }).join('');
      }

      function startOpsCrewSimulation() {
        padCrewRoster = buildCrewRoster();
        padCrewMessages = [];
        renderCrewFeed();
        // Pair roster names ↔ 3D figures so speech bubbles can find the
        // right figure to attach to. Safe to call even if figures aren't
        // built yet (no-ops); we re-call below after a short delay so
        // late scene assembly still gets named.
        try { pairCrewNamesToFigures(); } catch (_) {}
        setTimeout(() => { try { pairCrewNamesToFigures(); } catch (_) {} }, 300);
        // Seed a couple of clock-in messages so the panel isn't empty
        const seedDispatcher = pickCrewByRole('DISPATCH');
        if (seedDispatcher) postCrewMessage(seedDispatcher, 'on shift · monitoring queue');
        const seedOps = pickCrewByRole('OPS');
        if (seedOps) {
          setTimeout(() => postCrewMessage(seedOps, `${padCrewRoster.length}-person crew online`), 600);
        }
        // Idle chatter ticks every 4-9s. Different cadence from the
        // customer chat (18-32s) so the two feeds don't sync up.
        if (padCrewGenInterval) clearInterval(padCrewGenInterval);
        const tick = () => {
          try { generateIdleCrewChatter(); }
          catch (err) { console.warn('[OPS CREW] tick failed:', err); }
          padCrewGenInterval = setTimeout(tick, 4000 + Math.random() * 5000);
        };
        padCrewGenInterval = setTimeout(tick, 3000 + Math.random() * 2000);
        // Conversation tick — runs in parallel with idle chatter on a
        // longer cadence (12-22s between starts) so the feed gets a mix
        // of one-shot status posts AND named back-and-forth exchanges.
        // Each conversation itself takes ~3-5s to play out across its
        // 2-3 turns, then the next is scheduled.
        if (padCrewConvoInterval) clearTimeout(padCrewConvoInterval);
        const convoTick = () => {
          try { generateCrewConversation(); }
          catch (err) { console.warn('[OPS CREW] convo tick failed:', err); }
          // Tighter cadence — every 6-12s — so the user is much more
          // likely to catch a conversation in progress, especially in
          // ground-cam mode where they're walking around and may only
          // have 2-3 figures in view at once.
          padCrewConvoInterval = setTimeout(convoTick, 6000 + Math.random() * 6000);
        };
        // Kick off the FIRST conversation almost immediately (1.5-2.5s
        // after sim start) so the user sees comic bubbles within a few
        // seconds of opening the launchpad — instead of waiting through
        // a 6-10s gap and wondering if anything is happening. Name
        // pairing has a small delay so we wait briefly for figures to
        // be paired before the bubble system has someone to attach to.
        padCrewConvoInterval = setTimeout(convoTick, 1500 + Math.random() * 1000);
        // VO field reports — owner-addressed, every 16-30s. User wants
        // the Visual Observer "reporting information to me, the owner."
        if (padCrewVOInterval) clearTimeout(padCrewVOInterval);
        const voTick = () => {
          try { generateVOReport(); }
          catch (err) { console.warn('[VO report] failed:', err); }
          padCrewVOInterval = setTimeout(voTick, 16000 + Math.random() * 14000);
        };
        // First VO check-in lands shortly after sim start so the user
        // sees the role appear in the feed.
        padCrewVOInterval = setTimeout(voTick, 4000 + Math.random() * 3000);
        // MAINT-to-owner check-ins, every 22-40s. Keeps maintenance
        // visible to the owner without crowding the chatter feed.
        if (padCrewMaintOwnerInterval) clearTimeout(padCrewMaintOwnerInterval);
        const maintOwnerTick = () => {
          try { generateMaintOwnerUpdate(); }
          catch (err) { console.warn('[MAINT owner update] failed:', err); }
          padCrewMaintOwnerInterval = setTimeout(maintOwnerTick, 22000 + Math.random() * 18000);
        };
        padCrewMaintOwnerInterval = setTimeout(maintOwnerTick, 9000 + Math.random() * 4000);
        // Start the autonomous maintenance patrol — the mechanic
        // figure walks between aircraft on its own, no dispatch needed.
        startMaintPatrol();
        // Ground patrol runs in parallel — pre-flight checks on parked
        // aircraft so the ground crew figure is also constantly active.
        startGroundPatrol();
        // Periodic counter refresh — the "X working" count needs to
        // update independently of message posts so it reflects live
        // worker state. Just touches the header DOM, doesn't re-render
        // the message feed.
        if (padCrewCountInterval) clearInterval(padCrewCountInterval);
        padCrewCountInterval = setInterval(() => {
          const countEl = document.getElementById('pad-crew-count');
          if (!countEl) return;
          let working = 0, total = 0;
          try {
            if (padScene && padScene.userData && Array.isArray(padScene.userData.crewFigures)) {
              total = padScene.userData.crewFigures.length;
              working = padScene.userData.crewFigures.filter(f =>
                f.userData.task && f.userData.task.state !== 'idle'
              ).length;
            }
          } catch (_) {}
          if (total > 0) {
            countEl.textContent = `${padCrewRoster.length} on shift · ${working}/${total} working`;
          }
        }, 800);
      }

      function stopOpsCrewSimulation() {
        if (padCrewGenInterval) { clearTimeout(padCrewGenInterval); padCrewGenInterval = null; }
        if (padCrewConvoInterval) { clearTimeout(padCrewConvoInterval); padCrewConvoInterval = null; }
        if (padCrewVOInterval) { clearTimeout(padCrewVOInterval); padCrewVOInterval = null; }
        if (padCrewMaintOwnerInterval) { clearTimeout(padCrewMaintOwnerInterval); padCrewMaintOwnerInterval = null; }
        if (padCrewCountInterval) { clearInterval(padCrewCountInterval); padCrewCountInterval = null; }
        // Yank any in-flight comic bubbles so reopening the launchpad
        // doesn't show stale ones from the previous session.
        try { clearAllCrewBubbles(); } catch (_) {}
        stopMaintPatrol();
        stopGroundPatrol();
        // Don't wipe roster/messages — keeping them lets the next
        // openLaunchPad start fresh via startOpsCrewSimulation()
      }

      // Expose for tests + lifecycle hooks
      window.__startOpsCrewSimulation = startOpsCrewSimulation;
      window.__stopOpsCrewSimulation  = stopOpsCrewSimulation;
      window.__padCrewRoster   = () => padCrewRoster;
      window.__padCrewMessages = () => padCrewMessages;

      function openLaunchPad() {
        const view = document.getElementById('pad-view');
        if (!view) {
          console.error('[LAUNCH PAD] pad-view element not found in DOM');
          return;
        }
        // Hide the manufacturing view, show the launch pad as a full page
        document.getElementById('mfg-view')?.classList.remove('active');
        view.classList.add('active');
        padActive = true;
        window.__padActive = true;     // expose for bg operator pool
        padStartTime = performance.now();
        // SPEECH SYNTHESIS PRIMER
        // Chrome can silently swallow the first speak() call if it
        // hasn't received a user gesture targeted at the audio API.
        // Attach a one-shot pointerdown listener that primes the
        // synth — empty utterance, near-zero volume, but the act of
        // calling speak() inside a gesture handler unlocks all
        // subsequent calls (including those from setTimeout-based
        // crew chatter timers).
        try {
          const primeOnce = () => {
            if (typeof window.__primeCrewVoice === 'function') {
              window.__primeCrewVoice();
            }
            view.removeEventListener('pointerdown', primeOnce, true);
          };
          view.addEventListener('pointerdown', primeOnce, true);
        } catch (_) { /* prime is best-effort */ }
        // Populate pad UI
        const tail = document.getElementById('tail-number')?.value || 'SDX-0001';
        const op = document.getElementById('operator')?.value || 'SDX OPERATIONS';
        // Pick a starting pad from the active region's pickup-style sites
        const padNames = REGIONS[currentRegionKey]?.pickupNames || Object.keys(PAD_GEOGRAPHY).filter(n => n !== MAIN_HUB_NAME);
        const pad = padNames[Math.floor(Math.random() * padNames.length)];
        document.getElementById('pad-info-id').textContent = tail;
        document.getElementById('pad-info-detail').textContent = `${pad} · CHARGED · ENGINES COLD`;
        document.getElementById('pad-tail').textContent = tail;
        document.getElementById('pad-operator').textContent = op;
        document.getElementById('pad-location').textContent = pad;
        // Fleet rank — "1ST", "2ND", "3RD", "4TH", … of the fleet
        const rankEl = document.getElementById('pad-fleet-rank');
        if (rankEl) rankEl.textContent = fleetRankLabel();
        if (designJustSaved?.name) {
          document.getElementById('pad-saved-name').textContent = `DESIGN: ${designJustSaved.name}`;
        } else {
          document.getElementById('pad-saved-name').textContent = `DESIGN: UNSAVED`;
        }

        // Render the 2D dispatch network map (initially with no order selected)
        try {
          renderDispatchMap(pad, null, tail);
        } catch (err) {
          console.warn('[LAUNCH PAD] map render failed:', err);
        }

        // Note: roster, apron, and chat sim init are deferred into the RAF
        // callback below where the 3D scene is initialized. They depend on
        // padScene/padGroup, which don't exist until ensurePadScene() runs.

        // Clock
        if (padClockInterval) clearInterval(padClockInterval);
        const updateClock = () => {
          const d = new Date();
          const hh = d.getUTCHours().toString().padStart(2, '0');
          const mm = d.getUTCMinutes().toString().padStart(2, '0');
          const ss = d.getUTCSeconds().toString().padStart(2, '0');
          document.getElementById('pad-clock').textContent = `${hh}:${mm}:${ss} UTC`;
        };
        updateClock();
        padClockInterval = setInterval(updateClock, 1000);

        // Init scene + load aircraft. THEN render the roster, apron, and start
        // the chat sim — those depend on padScene/padGroup existing, which is
        // only after ensurePadScene() runs. Doing them synchronously before RAF
        // would silently fail in loadDesignIntoPadGroup (`if (!padGroup) return`).
        requestAnimationFrame(() => {
          try {
            ensurePadScene();
            loadAircraftIntoPad();
          } catch (err) {
            console.error('[LAUNCH PAD] 3D scene init failed (map still works):', err);
          }
          // Now that the scene exists, render dependent UI/3D state
          try { renderFleetRoster(); } catch (err) { console.warn('[LAUNCH PAD] roster render failed:', err); }
          try { renderFleetAprons(); } catch (err) { console.warn('[LAUNCH PAD] apron render failed:', err); }
          try { startCustomerChatSimulation(pad); } catch (err) { console.warn('[LAUNCH PAD] chat sim failed:', err); }
          try { startOpsCrewSimulation(); } catch (err) { console.warn('[LAUNCH PAD] crew sim failed:', err); }

          // ===== CUSTOMER MODE: SNAP CAMERA TO PICKUP IMMEDIATELY =====
          // User: "in customer mode when I choise the location it
          // spawns at the hub for 2 seconds, and then it goes to spawn
          // at the location." The 2s window came from a 500ms+800ms
          // timeout chain inside __runCustomerAutoDispatch — the
          // camera-to-pickup snap was inside the second timeout's
          // callback. So the user saw the hub view for 1.3s+ before
          // anything fired. Now we snap the camera the very first
          // frame the launchpad scene exists, before the dispatch
          // chain even starts, so the customer experience is "splash
          // → pickup view" with no hub-flicker in between.
          if (window.__customerModeActive && window.__customerPickup) {
            try {
              const region = (typeof getCurrentRegionPads === 'function')
                ? getCurrentRegionPads() : null;
              const pickupCoord = region?.pads?.[window.__customerPickup]
                || window.__customerGroundPos
                || null;
              if (pickupCoord && padCamera) {
                padCamera.position.set(pickupCoord.x, 1.7, pickupCoord.z);
                const dx = -pickupCoord.x, dz = -pickupCoord.z;
                const mag = Math.hypot(dx, dz) || 1;
                padCamera.lookAt(
                  pickupCoord.x + (dx / mag) * 40,
                  12,
                  pickupCoord.z + (dz / mag) * 40
                );
                if (padControls) {
                  padControls.target.set(
                    pickupCoord.x + (dx / mag) * 40,
                    12,
                    pickupCoord.z + (dz / mag) * 40
                  );
                  padControls.update();
                }
                // Tighten fog so the user can't see the hub from
                // their pickup vantage point even for a frame.
                if (padScene && padScene.fog) {
                  padScene.fog.near = 12;
                  padScene.fog.far = 60;
                }
              }
              const infoEl = document.getElementById('pad-info-detail');
              if (infoEl) infoEl.textContent =
                `${window.__customerPickup} · WAITING FOR TAXI · INCOMING FROM HUB`;
            } catch (err) {
              console.warn('[customer mode] early camera snap failed:', err);
            }
          }

          // ========== CUSTOMER MODE AUTO-DISPATCH ==========
          // Extracted as window.__runCustomerAutoDispatch so re-hailing
          // (subsequent customer rides while already in the launchpad)
          // can trigger another dispatch without re-running launch() and
          // re-opening the whole UI.
          window.__runCustomerAutoDispatch = function runCustomerAutoDispatch() {
            if (!(window.__customerModeActive && window.__customerPickup &&
                  window.__customerDropoff && window.__customerAircraftId)) return;
            try {
              setTimeout(() => {
                // Keep the chat order generator running. The user is one
                // customer in a busy fleet — AI customers continue placing
                // orders that the AI fleet manager picks up and dispatches
                // to OTHER aircraft, so the world feels alive (other taxis
                // visibly fly missions while the user takes their ride).
                // Customer order is APPENDED so the user's order joins the
                // active queue rather than replacing the AI traffic.
                const customerOrder = {
                  id: `order_${padChatNextId++}`,
                  customer: 'YOU (Customer Mode)',
                  from: window.__customerPickup,
                  to: window.__customerDropoff,
                  body: `Pickup at ${window.__customerPickup}, drop off at ${window.__customerDropoff}.`,
                  time: Date.now(),
                  status: 'pending',
                  isCustomerMode: true,
                };
                // Filter out any prior pending customer orders (only one
                // pending at a time), keep dispatched/completed history
                // and any AI orders that may also be pending.
                padChatOrders = padChatOrders.filter(o =>
                  !(o.isCustomerMode && o.status === 'pending')
                );
                padChatOrders.push(customerOrder);
                renderChatFeed();
                // Auto-select this order
                padSelectedOrder = customerOrder;
                // Auto-select the customer's chosen aircraft
                const designs = (typeof getAllSavedDesigns === 'function') ? getAllSavedDesigns() : [];
                const aircraft = designs.find(d => d.id === window.__customerAircraftId);
                if (aircraft) {
                  // Build the same wrapper the fleet roster uses
                  padSelectedAircraft = {
                    id: aircraft.id,
                    tail: aircraft.tailNumber || 'SDX-####',
                    name: aircraft.name || 'Untitled',
                    operator: aircraft.operator || 'Customer',
                  };
                  // Re-render UI to reflect selection
                  try { renderFleetRoster(); } catch {}
                  try { renderChatFeed(); } catch {}
                  try { renderDispatchMap(window.__customerPickup, window.__customerDropoff, padSelectedAircraft.tail); } catch {}
                  // Auto-trigger dispatch after a short delay so the user sees
                  // the booking summary on screen first
                  setTimeout(() => {
                    try { dispatchSelectedOrder(); } catch (err) { console.warn('[customer mode] auto-dispatch failed:', err); }

                    // CUSTOMER POV: the every-frame camera override in the
                    // primary flight loop pins the camera to the pickup city
                    // (eye-height, looking toward incoming taxi) once the
                    // flight is in PHASES. Until then (the brief moment
                    // before dispatch fires the first frame), snap the
                    // camera AT the pickup pad coordinate so the user
                    // isn't briefly viewing the hub.
                    try {
                      // Use the live __customerGroundPos as the user's
                      // standing point — set by hailCustomerTaxi to the
                      // chosen pickup city's pad coord initially. This is
                      // the SAME coordinate the per-frame phase-patch will
                      // use to re-route the taxi, keeping camera and taxi
                      // pickup target in lockstep.
                      const userPos = window.__customerGroundPos
                        || REGIONS[window.__sdxCurrentRegionKey || 'SF BAY']?.pads?.[window.__customerPickup];
                      if (userPos && padCamera) {
                        padCamera.position.set(userPos.x, 1.7, userPos.z);
                        const dx = -userPos.x, dz = -userPos.z;
                        const mag = Math.hypot(dx, dz) || 1;
                        padCamera.lookAt(
                          userPos.x + (dx/mag) * 40,
                          12,
                          userPos.z + (dz/mag) * 40
                        );
                        if (padControls) {
                          padControls.target.set(
                            userPos.x + (dx/mag) * 40,
                            12,
                            userPos.z + (dz/mag) * 40
                          );
                          padControls.update();
                        }
                        // Tighten fog NOW so the user never sees the hub from
                        // the city. The per-frame override will keep it tight,
                        // but this ensures tightness from the very first
                        // rendered frame after entering customer mode.
                        if (padScene && padScene.fog) {
                          padScene.fog.near = 12;
                          padScene.fog.far = 60;
                        }
                      }
                      const infoEl = document.getElementById('pad-info-detail');
                      if (infoEl) infoEl.textContent =
                        `${window.__customerPickup} · WAITING FOR TAXI · INCOMING FROM HUB`;
                    } catch (err) {
                      console.warn('[customer mode] info text update failed:', err);
                    }

                    // AUTO-ENTER GROUND WALK MODE — customer-mode users
                    // are real people standing in their pickup city, not
                    // operators flying a chase cam. Programmatically click
                    // the GROUND button so they spawn at eye level on the
                    // ground without having to hunt for the camera preset.
                    try {
                      const groundBtn = document.querySelector('.pad-cam-btn[data-cam="ground"]');
                      if (groundBtn) groundBtn.click();
                    } catch (err) {
                      console.warn('[customer mode] auto-enter ground mode failed:', err);
                    }
                  }, 200);
                }
              }, 100);
            } catch (err) {
              console.error('[customer mode] init failed:', err);
            }
          };
          // Run it now (first-launch path)
          window.__runCustomerAutoDispatch();

          // ========== AI FLEET MANAGER ==========
          // Workers visibly launch aircraft. Each tick:
          //   1. Find an idle aircraft (charged, not already flying,
          //      not currently being prepped by a walking worker)
          //   2. Find/generate an order for it
          //   3. SEND THE DISPATCHER WORKER TO WALK TO IT
          //   4. When the worker arrives, THE TAKEOFF FIRES.
          // The aircraft is "reserved" the moment the worker is sent so
          // subsequent ticks don't double-pick it during the ~2-3s walk.
          //
          // This is what the user wanted: visibly worker-caused launches.
          // Workers walk to aircraft, you see them arrive, THEN takeoff.
          let aiFleetInterval = null;
          // Set of designIds whose dispatcher is currently walking to
          // them. They're not in flight yet but shouldn't be picked
          // again. Cleared when the dispatch actually fires (or fails).
          const pendingDispatchIds = new Set();
          // Expose for outer-scope splash counter — needs to know which
          // aircraft workers are reserving (walking to) so they don't
          // count as "available to send"
          window.__pendingDispatchIds = pendingDispatchIds;

          function tryDispatchOneAiOrder() {
            // Bail conditions
            // (Previously this was gated on __customerModeActive — that
            // meant the AI fleet only ran while the user was riding as a
            // customer. The user explicitly wants workers to actively
            // launch aircraft in OPERATOR mode too: "actually make them
            // lauch aircraft if they are not already". So we now run
            // any time the launch pad scene is alive.)
            if (!padScene) return false;
            if (!padActive) return false;
            // Don't queue another dispatch task if the dispatcher figure
            // is already mid-task or has queued tasks. Otherwise the AI
            // fleet manager (especially in fast-poll high-demand mode)
            // would reserve aircraft faster than the dispatcher can walk
            // to them, leading to: all aircraft reserved → idle.length
            // === 0 → no more dispatches → "frozen" feeling. The user
            // reported: "I launched 2, they lauched 1 and now they are
            // frozen." Each tick now waits for the dispatcher to finish
            // their current task before queueing the next one.
            try {
              if (padScene.userData && Array.isArray(padScene.userData.crewFigures)) {
                const dispatcher = padScene.userData.crewFigures.find(f => f.userData.role === 'DISPATCH');
                if (dispatcher && dispatcher.userData.task) {
                  const tk = dispatcher.userData.task;
                  if (tk.state !== 'idle' || tk.taskQueue.length > 0) {
                    return false;
                  }
                }
              }
            } catch (_) { /* if the check fails, fall through to attempt dispatch */ }
            // No artificial cap on concurrent AI flights — the user's
            // explicit instruction was: "all aircraft need to be busy
            // unless they are charging." Every charged idle aircraft
            // (other than the user's reserved one) gets dispatched.
            const userAcId = window.__customerAircraftId;

            // Find idle aircraft eligible for AI dispatch
            const designs = (typeof getAllSavedDesigns === 'function')
              ? getAllSavedDesigns() : [];
            const inFlightIds = new Set(padFlightStates
              .filter(f => f && f.active)
              .map(f => f.designId));
            const idle = designs.filter(d => {
              if (d.id === userAcId) return false;     // reserved for user
              if (inFlightIds.has(d.id)) return false; // already flying
              if (pendingDispatchIds.has(d.id)) return false; // worker walking to it
              const batt = padDesignBatteries.get(d.id)?.battery ?? 95;
              if (batt < 95 - 0.05) return false;       // not charged
              return true;
            });
            if (idle.length === 0) return false;

            // Build exclusion list of pads the AI fleet should NOT touch
            // — the user's pickup and dropoff. The user wants ONE taxi at
            // their location, not AI taxis landing on top of them. Also
            // exclude any pad an active AI flight is currently routing
            // to/from so the AI fleet doesn't pile multiple AI flights
            // onto a single pad either.
            const userExclusions = [];
            if (window.__customerPickup)  userExclusions.push(window.__customerPickup);
            if (window.__customerDropoff) userExclusions.push(window.__customerDropoff);
            // Also include in-flight AI destinations to spread the fleet out
            const inFlightDestinations = padFlightStates
              .filter(f => f && f.active && f.designId !== userAcId)
              .flatMap(f => [f.from, f.to])
              .filter(Boolean);

            // Find or generate a pending non-user order. Skip pending
            // orders that conflict with user's pickup/dropoff — those
            // would route an AI taxi to the user's pad.
            let order = padChatOrders.find(o =>
              o.status === 'pending' &&
              !o.isCustomerMode &&
              !userExclusions.includes(o.from) &&
              !userExclusions.includes(o.to)
            );
            if (!order) {
              const currentPad = document.getElementById('pad-location')?.textContent || MAIN_HUB_NAME;
              const allExclusions = [...userExclusions, ...inFlightDestinations];
              order = generateCustomerOrder(currentPad, allExclusions);
              if (!order) return false;
              padChatOrders.push(order);
              renderChatFeed();
            }

            // Pick a random idle aircraft for this order
            const pick = idle[Math.floor(Math.random() * idle.length)];
            // Reserve it so the next tick doesn't double-pick it while
            // the worker is walking to it
            pendingDispatchIds.add(pick.id);
            // Safety net — if fireTakeoff hasn't cleared the reservation
            // within 30 seconds, force-clear it. Defense against any
            // path where the worker gets stuck or never arrives. Without
            // this, a single stuck reservation would permanently
            // exclude that aircraft, eventually leading to idle.length
            // === 0 and the AI fleet "freezing".
            setTimeout(() => {
              if (pendingDispatchIds.has(pick.id)) {
                console.warn(`[AI fleet] reservation for ${pick.id} timed out, force-clearing`);
                pendingDispatchIds.delete(pick.id);
              }
            }, 30000);

            // The actual takeoff fires when the dispatcher worker
            // arrives at the aircraft. Capture all the state we need
            // in a closure so we can fire the dispatch from the
            // worker's onArrive callback.
            const fireTakeoff = () => {
              try {
                const prevSelOrder = padSelectedOrder;
                const prevSelAircraft = padSelectedAircraft;
                // Selection is set HERE (at takeoff time) rather than at
                // tick time. By the time the worker arrives, the previous
                // selection state has already moved on; we set fresh.
                padSelectedOrder = order;
                padSelectedAircraft = {
                  id: pick.id,
                  tail: pick.tailNumber || 'SDX-####',
                  name: pick.name || 'Untitled',
                  operator: pick.operator || 'AI',
                };
                dispatchSelectedOrder();
                console.log(`[AI fleet] worker-launched ${pick.name} (${pick.tailNumber}) for ${order.customer}: ${order.from} → ${order.to}`);
                padSelectedOrder = prevSelOrder;
                padSelectedAircraft = prevSelAircraft;
              } catch (err) {
                console.warn('[AI fleet] dispatch failed:', err);
              } finally {
                // Always clear the reservation, even on failure, so
                // the aircraft becomes pickable again.
                pendingDispatchIds.delete(pick.id);
              }
            };

            // Send the dispatcher worker to walk to the aircraft.
            // When they arrive (after ~2-3s of walking), onArrive fires
            // and the takeoff happens — visibly caused by the worker.
            // Falls back to immediate dispatch if the crew sim isn't
            // ready (e.g. before the 3D scene initializes).
            let workerDispatched = false;
            try {
              if (typeof window.__assignCrewWork === 'function') {
                window.__assignCrewWork('DISPATCH', pick.id, 2500, fireTakeoff);
                workerDispatched = true;
              }
            } catch (_) {}
            if (!workerDispatched) {
              // Fallback: scene not ready — fire takeoff immediately so
              // dispatches don't get stuck on a missing crew sim
              fireTakeoff();
            }

            // Tell the ops crew panel — message + (sometimes) ATC follow-up.
            // The text panel posts immediately, but the actual aircraft
            // takeoff waits for the worker to arrive.
            try {
              if (typeof window.__opsCrewLogDispatch === 'function') {
                window.__opsCrewLogDispatch(pick.tailNumber || 'SDX-####', order.from, order.to, pick.id);
              }
            } catch (_) { /* crew sim failure must not break the dispatch */ }

            return true;
          }

          // Saturate the idle fleet: dispatch every eligible idle aircraft
          // in a loop until tryDispatchOneAiOrder returns false (no idle
          // aircraft left, or quota hit). This is what makes the fleet
          // visibly "busy" — instead of trickling one dispatch every 5-9
          // seconds, on each tick we send out every aircraft that's
          // charged and not already flying.
          // Stagger AI dispatches across time. Previously saturateAiFleet()
          // dispatched every idle aircraft in one tick, which made multiple
          // taxis take off from the hub simultaneously — they ended up
          // visually stacked through the climb-out phase (the "mid-air
          // collision" look the user reported). Spacing dispatches over
          // multiple seconds means aircraft launch one at a time and have
          // time to clear the hub airspace before the next one departs.
          function startAiFleetManager() {
            if (aiFleetInterval) return;
            // ADAPTIVE TICK CADENCE:
            //   - Normal: 2.5-4.5s (gives staggered launches when fleet
            //     is partly idle).
            //   - High demand: 0.8-1.5s when there are pending orders
            //     AND aircraft might become available soon. The user
            //     said workers should respond "based on orders and
            //     demand" — when orders pile up, dispatcher should be
            //     ready to launch the next aircraft the instant one
            //     completes its turnaround.
            // Tick rate adapts each cycle based on the queue state.
            const tick = () => {
              try { tryDispatchOneAiOrder(); }
              catch (err) { console.warn('[AI fleet] tick failed:', err); }
              // Compute next-tick delay based on demand pressure.
              let nextDelay;
              try {
                const pendingOrders = (typeof padChatOrders !== 'undefined' && Array.isArray(padChatOrders))
                  ? padChatOrders.filter(o => o.status === 'pending' && !o.isCustomerMode).length
                  : 0;
                if (pendingOrders >= 2) {
                  // High demand: poll fast so we catch newly-charged
                  // aircraft within ~1s of becoming idle.
                  nextDelay = 800 + Math.random() * 700;     // 0.8-1.5s
                } else if (pendingOrders === 1) {
                  // Some demand: medium cadence.
                  nextDelay = 1500 + Math.random() * 1500;     // 1.5-3s
                } else {
                  // Quiet: standard cadence.
                  nextDelay = 2500 + Math.random() * 2000;     // 2.5-4.5s
                }
              } catch (_) {
                nextDelay = 2500 + Math.random() * 2000;
              }
              aiFleetInterval = setTimeout(tick, nextDelay);
            };
            // Initial delay — first dispatch fires shortly after launchpad
            // opens so the user immediately sees something happening.
            aiFleetInterval = setTimeout(tick, 1200);
          }

          // saturateAiFleet kept for the existing test API but no longer
          // used by the manager itself — it would collapse the staggered
          // launches we just spent effort to introduce. Tests can still
          // call it for synthetic single-tick scenarios.
          function saturateAiFleet() {
            for (let i = 0; i < 50; i++) {
              if (!tryDispatchOneAiOrder()) break;
            }
          }

          function stopAiFleetManager() {
            if (aiFleetInterval) { clearTimeout(aiFleetInterval); aiFleetInterval = null; }
          }

          // Expose for tests + lifecycle hooks
          window.__startAiFleetManager = startAiFleetManager;
          window.__stopAiFleetManager  = stopAiFleetManager;
          window.__tryDispatchOneAiOrder = tryDispatchOneAiOrder;
          window.__saturateAiFleet = saturateAiFleet;

          // Kick off the manager. The first interval tick (at 800ms)
          // saturates the entire idle fleet so every charged aircraft is
          // mid-takeoff by the time the user finishes orienting in the
          // scene. Subsequent ticks pick up any aircraft that just
          // recharged from a completed mission.
          startAiFleetManager();
        });
      }

      function closeLaunchPad() {
        document.getElementById('pad-view')?.classList.remove('active');
        // Restore the manufacturing view (the editor)
        document.getElementById('mfg-view')?.classList.add('active');
        padActive = false;
        window.__padActive = false;     // expose for bg operator pool
        if (padClockInterval) { clearInterval(padClockInterval); padClockInterval = null; }
        // Stop the map vehicle animation
        if (padMapAnimRAF) { cancelAnimationFrame(padMapAnimRAF); padMapAnimRAF = null; }
        // Stop chat simulation + active flights
        stopCustomerChatSimulation();
        // Stop ops crew chatter
        try {
          if (typeof window.__stopOpsCrewSimulation === 'function') window.__stopOpsCrewSimulation();
        } catch (_) {}
        // Stop the AI fleet manager (no more AI dispatches after the user
        // exits the launchpad — otherwise the interval would keep firing
        // and try to dispatch into a torn-down scene).
        try {
          if (typeof window.__stopAiFleetManager === 'function') window.__stopAiFleetManager();
        } catch (_) {}
        // Silence the propeller synth — drive throttle to zero so audio fades out cleanly
        try { propellerSynth.setState(0, 100); } catch (e) {}
      }

      document.getElementById('pad-close')?.addEventListener('click', closeLaunchPad);
      // ============================================================
      // VOICE DEBUG PANEL — toggleable in-page diagnostic
      // ============================================================
      // User: "audio is still not working. Write a test to debug this."
      // The panel surfaces every gate in the speakCrewLine path AND
      // exposes three test buttons:
      //   1. DIRECT  — bypass speakCrewLine entirely, call speak()
      //                directly inside the click handler. Tells us if
      //                the browser API itself works at all.
      //   2. CREW    — go through the full speakCrewLine pipeline.
      //                If DIRECT works but CREW doesn't, the bug is
      //                in our pipeline (gates, voice assignment, etc.)
      //   3. RESUME  — speechSynthesis.resume() for the case where
      //                the synth got stuck in a paused state.
      const debugBtn   = document.getElementById('pad-voice-debug-btn');
      const debugPanel = document.getElementById('pad-voice-debug');
      const debugClose = document.getElementById('pad-voice-debug-close');
      let pvdRefreshInterval = null;
      function pvdSetCell(id, value, cls) {
        const el = document.getElementById(id);
        if (!el) return;
        el.textContent = String(value);
        el.className = cls || '';
      }
      function pvdRefresh() {
        const synthOK = typeof speechSynthesis !== 'undefined';
        pvdSetCell('pvd-api-status',
          synthOK ? '✓ available' : '✗ MISSING',
          synthOK ? 'ok' : 'err');
        const rawCount = synthOK ? (speechSynthesis.getVoices() || []).length : 0;
        pvdSetCell('pvd-raw-voices', rawCount,
          rawCount > 0 ? 'ok' : 'warn');
        const poolSize = padCrewVoiceState.voicePool.length;
        pvdSetCell('pvd-pool-size', poolSize,
          poolSize > 0 ? 'ok' : 'warn');
        pvdSetCell('pvd-enabled',
          padCrewVoiceState.enabled ? '✓ yes' : '✗ DISABLED',
          padCrewVoiceState.enabled ? 'ok' : 'err');
        const cust = !!window.__customerModeActive;
        pvdSetCell('pvd-customer',
          cust ? '⚠ YES (suppresses speech)' : 'no',
          cust ? 'warn' : 'ok');
        const propMuted = (typeof propellerSynth !== 'undefined') && !!propellerSynth.muted;
        pvdSetCell('pvd-prop-muted',
          propMuted ? 'yes (does NOT block voice)' : 'no');
        if (synthOK) {
          pvdSetCell('pvd-speaking', speechSynthesis.speaking ? 'yes' : 'no');
          pvdSetCell('pvd-pending',  speechSynthesis.pending  ? 'yes' : 'no');
          pvdSetCell('pvd-paused',
            speechSynthesis.paused ? '⚠ YES — stuck' : 'no',
            speechSynthesis.paused ? 'err' : 'ok');
        }
        const D = padCrewVoiceState.diagnostics;
        pvdSetCell('pvd-speak-calls', D.speakCalls);
        pvdSetCell('pvd-spoken', D.spoken,
          D.spoken > 0 ? 'ok' : (D.speakCalls > 0 ? 'err' : ''));
        pvdSetCell('pvd-blocked-queue', D.blockedQueueFull || 0,
          (D.blockedQueueFull || 0) > 0 ? 'warn' : '');
        pvdSetCell('pvd-primed',
          D.primed ? '✓ yes' : '✗ no — click anywhere first',
          D.primed ? 'ok' : 'warn');
        pvdSetCell('pvd-last-error', D.lastError || '—',
          D.lastError ? 'err' : '');
        const list = document.getElementById('pvd-pool-list');
        if (list) {
          list.innerHTML = '';
          for (const v of padCrewVoiceState.voicePool) {
            const li = document.createElement('li');
            li.textContent = `${v.name} (${v.lang})`;
            list.appendChild(li);
          }
        }
      }
      function pvdSetResult(text, cls) {
        const el = document.getElementById('pvd-result');
        if (!el) return;
        el.textContent = text;
        el.className = 'pvd-result' + (cls ? ' ' + cls : '');
      }
      debugBtn?.addEventListener('click', () => {
        if (!debugPanel) return;
        const showing = !debugPanel.hasAttribute('hidden');
        if (showing) {
          debugPanel.setAttribute('hidden', '');
          if (pvdRefreshInterval) { clearInterval(pvdRefreshInterval); pvdRefreshInterval = null; }
        } else {
          debugPanel.removeAttribute('hidden');
          pvdRefresh();
          // Refresh state every 500ms while panel is open
          pvdRefreshInterval = setInterval(pvdRefresh, 500);
          // The click on this button itself counts as a user gesture —
          // prime the synth so future timer-driven speech works.
          if (typeof window.__primeCrewVoice === 'function') {
            try { window.__primeCrewVoice(); } catch (_) {}
          }
        }
      });
      debugClose?.addEventListener('click', () => {
        if (debugPanel) debugPanel.setAttribute('hidden', '');
        if (pvdRefreshInterval) { clearInterval(pvdRefreshInterval); pvdRefreshInterval = null; }
      });

      // TEST 1 — direct speak. The most minimal possible path:
      // create utterance, speak it. No cancel, no resume, no state
      // tracking, no voice selection. If this doesn't produce audio,
      // the issue is below our code (browser/system level) and no
      // amount of pipeline tweaking will help.
      document.getElementById('pvd-test-direct')?.addEventListener('click', () => {
        try {
          if (typeof speechSynthesis === 'undefined') {
            pvdSetResult('FAIL: speechSynthesis API not present in this browser.', 'err');
            return;
          }
          // Bare-minimum utterance — no voice selection, no rate/pitch
          // tweaks, just default everything at full volume.
          const u = new SpeechSynthesisUtterance(
            'Direct speech test. If you hear this, the browser audio API is working.');
          u.volume = 1.0;
          let didStart = false, didEnd = false, errMsg = null;
          u.onstart = () => { didStart = true; pvdSetResult('▶ utterance started — should be playing now', 'ok'); };
          u.onend   = () => { didEnd = true; pvdSetResult('✓ utterance completed end-to-end. If you heard nothing despite this success: macOS Settings → Accessibility → Spoken Content → System Voice volume is independent of browser volume and a common silent culprit.', 'ok'); };
          u.onerror = (ev) => {
            errMsg = (ev && ev.error) || 'unknown';
            pvdSetResult(
              '✗ utterance error: "' + errMsg + '"\n' +
              (errMsg === 'canceled'
                ? 'The synth is in a stuck state from a prior cancel(). Click ⟲ HARD RESET, then try again.'
                : ''), 'err');
          };
          pvdSetResult('… queued. Speaking shortly.', '');
          speechSynthesis.speak(u);
          setTimeout(() => {
            if (errMsg) return;
            if (!didStart) {
              pvdSetResult(
                '✗ utterance never started after 3 seconds.\n' +
                'Synth state: speaking=' + speechSynthesis.speaking +
                ', pending=' + speechSynthesis.pending +
                ', paused=' + speechSynthesis.paused + '\n' +
                'The synth is hung. Click ⟲ HARD RESET, then try again.\n' +
                'If still silent after reset: check macOS Settings → ' +
                'Accessibility → Spoken Content → System Voice volume.',
                'err');
              return;
            }
            if (didStart && !didEnd) {
              pvdSetResult('… still speaking. Should finish soon.', 'ok');
            }
          }, 3000);
        } catch (err) {
          pvdSetResult('✗ exception thrown: ' + err.message, 'err');
        }
      });

      // TEST 2 — full crew-line pipeline.
      document.getElementById('pvd-test-crew')?.addEventListener('click', () => {
        try {
          const before = { ...padCrewVoiceState.diagnostics };
          const crewName = (padCrewRoster && padCrewRoster[0] && padCrewRoster[0].name) || 'TEST';
          // First: prime in this gesture context
          if (typeof window.__primeCrewVoice === 'function') {
            try { window.__primeCrewVoice(); } catch (_) {}
          }
          // Chrome stuck-state workaround
          try { if (speechSynthesis.paused) speechSynthesis.resume(); } catch (_) {}
          speakCrewLine(crewName,
            'Crew line test from ' + crewName + '. Pipeline working.');
          setTimeout(() => {
            const after = padCrewVoiceState.diagnostics;
            const delta = {
              spoken:  after.spoken  - before.spoken,
              calls:   after.speakCalls - before.speakCalls,
              error:   after.lastError,
            };
            if (delta.spoken > 0) {
              pvdSetResult(
                '✓ speakCrewLine path ran. spoken+=' + delta.spoken + '. Crew=' + crewName +
                '. If you didn\'t hear it: try DIRECT SPEAK first to confirm the browser plays sound.',
                'ok');
            } else if (delta.calls > 0 && delta.spoken === 0) {
              pvdSetResult(
                '✗ speakCrewLine was called but blocked by a gate.\n' +
                'Check the table above — one of the "blocked*" diagnostic counters incremented.\n' +
                'Last error: ' + (delta.error || 'none'),
                'err');
            } else {
              pvdSetResult('✗ speakCrewLine did not even fire. Possible: not loaded yet, or speechSynthesis missing.', 'err');
            }
          }, 1500);
        } catch (err) {
          pvdSetResult('✗ exception thrown: ' + err.message, 'err');
        }
      });

      // TEST 3 — force-resume the synth in case it got stuck paused.
      document.getElementById('pvd-resume')?.addEventListener('click', () => {
        try {
          if (typeof speechSynthesis === 'undefined') {
            pvdSetResult('✗ speechSynthesis not available.', 'err'); return;
          }
          const wasPaused = speechSynthesis.paused;
          try { speechSynthesis.cancel(); } catch (_) {}
          try { speechSynthesis.resume(); } catch (_) {}
          // Also clear our internal queue so dropped-counters and
          // recentUtterances reflect the post-reset state.
          padCrewVoiceState.recentUtterances.length = 0;
          pvdSetResult(
            '↻ called cancel() + resume(). Was paused: ' + wasPaused +
            '. Now: paused=' + speechSynthesis.paused +
            ', speaking=' + speechSynthesis.speaking +
            ', pending=' + speechSynthesis.pending,
            'ok');
        } catch (err) {
          pvdSetResult('✗ exception: ' + err.message, 'err');
        }
      });

      // TEST 4 — HARD RESET. Full state reset. Use when the synth is
      // wedged in a zombie state (speaking=yes + pending=yes + nothing
      // playing). Clears recentUtterances, resets diagnostics, calls
      // cancel+resume, then waits 200ms and fires a verification
      // utterance. The 200ms gap is critical — Chrome's cancel-then-
      // speak bug only triggers when speak() comes IMMEDIATELY after
      // cancel(); a short delay lets the synth settle before we try.
      document.getElementById('pvd-hard-reset')?.addEventListener('click', () => {
        try {
          if (typeof speechSynthesis === 'undefined') {
            pvdSetResult('✗ speechSynthesis not available.', 'err'); return;
          }
          // 1. Clear our internal queue
          padCrewVoiceState.recentUtterances.length = 0;
          // 2. Reset all diagnostic counters
          const D = padCrewVoiceState.diagnostics;
          D.speakCalls = 0;
          D.spoken = 0;
          D.blockedNoSynth = 0;
          D.blockedDisabled = 0;
          D.blockedCustomerMode = 0;
          D.blockedMuted = 0;
          D.blockedEmpty = 0;
          D.blockedQueueFull = 0;
          D.lastError = null;
          // 3. Force the synth back to a known state
          try { speechSynthesis.cancel(); } catch (_) {}
          try { speechSynthesis.resume(); } catch (_) {}
          // 4. Re-enable voice (in case it was disabled somewhere)
          padCrewVoiceState.enabled = true;
          pvdSetResult('⟲ reset complete. Firing verification utterance in 200ms…', 'ok');
          // 5. Wait, then fire a fresh utterance to verify recovery
          setTimeout(() => {
            try {
              const u = new SpeechSynthesisUtterance(
                'Reset verified. Audio should be working now.');
              u.volume = 1.0;
              let started = false, errored = null;
              u.onstart = () => { started = true; pvdSetResult('✓ verification utterance started — RESET SUCCEEDED', 'ok'); };
              u.onend   = () => pvdSetResult('✓ RESET SUCCEEDED. Verification utterance completed. Crew voices should now work.', 'ok');
              u.onerror = (ev) => {
                errored = (ev && ev.error) || 'unknown';
                pvdSetResult(
                  '✗ verification utterance errored: "' + errored + '"\n' +
                  'The synth is in a deeper stuck state. Try refreshing the page.',
                  'err');
              };
              speechSynthesis.speak(u);
              // Last-resort timeout
              setTimeout(() => {
                if (errored) return;
                if (!started) {
                  pvdSetResult(
                    '✗ verification utterance never started.\n' +
                    'The reset cleared our internal state but the browser synth ' +
                    'is still hung. This usually requires a page refresh.\n' +
                    'Also check: macOS Settings → Accessibility → Spoken Content ' +
                    '→ System Voice volume.',
                    'err');
                }
              }, 3000);
            } catch (err) {
              pvdSetResult('✗ verification threw: ' + err.message, 'err');
            }
          }, 200);
        } catch (err) {
          pvdSetResult('✗ exception: ' + err.message, 'err');
        }
      });
      // Audio mute toggle — one-button on/off for BOTH propeller audio
      // AND crew voice synthesis. They're separate state variables now
      // (decoupled to avoid silent breakage when one fails to init), but
      // the audio button keeps a unified UX: one click, everything off.
      // Also acts as a speech-synthesis primer — clicking it inside a
      // user gesture handler unlocks browser autoplay policy for
      // subsequent timer-driven utterances.
      const audioBtn = document.getElementById('pad-audio-toggle');
      audioBtn?.addEventListener('click', () => {
        const nowMuted = !propellerSynth.muted;
        propellerSynth.setMuted(nowMuted);
        // Mirror the toggle in the voice subsystem so unmuting also
        // re-enables crew voices (and vice versa).
        if (typeof window !== 'undefined' && typeof window.__setCrewVoiceEnabled === 'function') {
          try { window.__setCrewVoiceEnabled(!nowMuted); } catch (_) {}
        }
        if (nowMuted && typeof speechSynthesis !== 'undefined') {
          try { speechSynthesis.cancel(); } catch (_) {}
        }
        // Prime the synth on UNMUTE — the click qualifies as a user
        // gesture, so calling speak() here (even for a moment) unlocks
        // future utterances on browsers with strict autoplay policies.
        if (!nowMuted && typeof window !== 'undefined' && typeof window.__primeCrewVoice === 'function') {
          try { window.__primeCrewVoice(); } catch (_) {}
        }
        audioBtn.textContent = nowMuted ? '🔇 MUTED' : '🔊 AUDIO';
        audioBtn.classList.toggle('muted', nowMuted);
      });
      // ============================================================================
      // REGION SELECTOR
      //
      // Switches between SF BAY / NYC METRO / SOCAL. Each region has its own
      // pad coordinates, hub name, and intercity routes. Switching mid-session:
      //  - cancels any active flights (their pad coords no longer exist)
      //  - reassigns the current pad from the new region's pickup names
      //  - clears chat orders (they reference old pad names) and seeds new ones
      //  - re-renders the dispatch map
      //  - updates the launch-pad info tag with new pad/hub names
      // ============================================================================
      const padRegionSelectEl = document.getElementById('pad-region-select');
      if (padRegionSelectEl) {
        // Initialize selector to match the active region (in case it's been
        // changed via JS console or persisted somewhere)
        padRegionSelectEl.value = currentRegionKey;
        padRegionSelectEl.addEventListener('change', () => {
          const newKey = padRegionSelectEl.value;
          if (!newKey || newKey === currentRegionKey) return;
          if (!setActiveRegion(newKey)) {
            console.warn('[region] unknown region:', newKey);
            padRegionSelectEl.value = currentRegionKey;     // revert
            return;
          }
          // Cancel any in-flight missions — their pickup/dropoff pads are now
          // in a different region's coordinate space and would teleport.
          // Mark them inactive and let the cleanup loop tear them down.
          for (const fs of padFlightStates) {
            if (fs && fs.active) {
              fs.active = false;
              if (fs.acGroup && fs.acGroup !== padGroup && padScene) {
                try { padScene.remove(fs.acGroup); } catch {}
              }
              for (const obj of (fs.sceneAdds || [])) {
                try { padScene.remove(obj); } catch {}
              }
            }
          }
          padFlightStates.length = 0;
          padFlightState = null;
          padDispatchedFlights.length = 0;
          // Pick a new starting pad from the new region's pickup list
          const newPickups = REGIONS[newKey].pickupNames || [];
          const newPad = newPickups[Math.floor(Math.random() * Math.max(newPickups.length, 1))] || MAIN_HUB_NAME;
          // Update the pad info tag
          const padInfoDetail = document.getElementById('pad-info-detail');
          const padLocation   = document.getElementById('pad-location');
          if (padInfoDetail) padInfoDetail.textContent = `${newPad} · CHARGED · ENGINES COLD`;
          if (padLocation)   padLocation.textContent   = newPad;
          // Wipe and regenerate chat orders so they reference the new pads
          padChatOrders.length = 0;
          // Seed 2 fresh orders
          for (let i = 0; i < 2; i++) {
            const o = generateCustomerOrder(newPad);
            if (o) padChatOrders.push(o);
          }
          padSelectedOrder = null;
          if (typeof renderChatFeed === 'function') renderChatFeed();
          // Re-render the 2D dispatch map for the new region
          try {
            const tail = document.getElementById('pad-tail')?.textContent || 'SDX-0001';
            renderDispatchMap(newPad, null, tail);
          } catch (err) {
            console.warn('[region] dispatch map redraw failed:', err);
          }
          // Re-render fleet aprons (their positions are the same, but the
          // background scene state may have changed)
          if (typeof renderFleetAprons === 'function') {
            try { renderFleetAprons(); } catch {}
          }
          // Reset camera target to hub (0,0) — the user is now over a new city
          if (padControls) {
            padControls.target.set(0, 0.5, 0);
            padControls.update();
          }
        });
      }

      // Camera preset buttons — TOP / SIDE / BACK / GROUND / AUTO
      document.querySelectorAll('.pad-cam-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          const mode = btn.dataset.cam;
          // Highlight the active preset
          document.querySelectorAll('.pad-cam-btn').forEach(b => b.classList.remove('active'));
          btn.classList.add('active');
          // Where is the aircraft right now?
          const acX = padGroup ? padGroup.position.x : 0;
          const acZ = padGroup ? padGroup.position.z : 0;
          const acY = padGroup ? padGroup.position.y : 0.4;
          // Leaving ground mode? Re-enable orbit controls
          if (mode !== 'ground' && padGroundCam) {
            padGroundCam = false;
            if (padControls) padControls.enabled = true;
            // Hide the WASD overlay + restore cursor
            const overlay = document.getElementById('pad-ground-hud');
            if (overlay) overlay.style.display = 'none';
            const canvas = document.getElementById('pad-canvas');
            if (canvas) canvas.style.cursor = '';
          }
          // Snap camera to preset; engages manual-cam mode for 4s before auto resumes
          if (mode === 'top') {
            // Bird's-eye / 3/4 from above — high enough to clear any
            // tall components on big multi-fuselage designs, slightly
            // off-axis (not perfectly vertical) so the user retains
            // depth perspective and orbit controls feel natural to drag
            // around the aircraft. A pure straight-down view (camera
            // directly above lookAt) makes orbit controls unstable and
            // shows only the top silhouette — the user reported this as
            // "obstructed" because they couldn't actually see the taxi
            // from any angle. Now: 35 units up, 12 units back so the
            // initial frame is a proper 3/4 bird's-eye, and the user
            // can drag-orbit to any angle they want.
            padCamera.position.set(acX, acY + 35, acZ + 12);
            padCamera.lookAt(acX, acY, acZ);
            if (padControls) {
              padControls.target.set(acX, acY, acZ);
              // Make sure the orbit controls aren't constrained — let
              // the user rotate fully around the aircraft.
              padControls.enabled = true;
              if (padControls.minPolarAngle !== undefined) padControls.minPolarAngle = 0;
              if (padControls.maxPolarAngle !== undefined) padControls.maxPolarAngle = Math.PI;
            }
            padManualCam = true;
            padStickyCam = true;     // STICKY — don't auto-revert after 4s
            padManualCamTime = performance.now();
          } else if (mode === 'side') {
            padCamera.position.set(acX, acY + 3, acZ + 12);
            padCamera.lookAt(acX, acY, acZ);
            if (padControls) padControls.target.set(acX, acY, acZ);
            padManualCam = true;
            padStickyCam = true;
            padManualCamTime = performance.now();
          } else if (mode === 'back') {
            padCamera.position.set(acX + 10, acY + 4, acZ);
            padCamera.lookAt(acX, acY, acZ);
            if (padControls) padControls.target.set(acX, acY, acZ);
            padManualCam = true;
            padStickyCam = true;
            padManualCamTime = performance.now();
          } else if (mode === 'auto') {
            // AUTO clears the sticky flag — auto-cam resumes lerping.
            padStickyCam = false;
            padManualCam = false;
          } else if (mode === 'ground') {
            // Enter first-person ground mode. In customer mode, spawn at the
            // pickup city (or dropoff city after disembark) so the user
            // walks around the city they're actually IN, not at the hub.
            // In operator mode, spawn at the hub plaza edge facing inward
            // — far enough from the launch pad and apron row that the
            // initial frame is a clean overview, not a confusing close-up.
            // Old default (8, 8) was inside the apron cluster at distance
            // ~11u from origin, eye-height 1.7u next to parked aircraft —
            // produced a "very disorienting view" the user reported.
            padGroundCam = true;
            padManualCam = true;     // suppress auto-cam
            // Plaza edge is at HUB_PLAZA_RADIUS=40u. Spawn 5u inside that
            // (35u from origin), positioned south of origin so the user
            // is naturally behind/below the apron row at z=8 — looking
            // north gives the hub + apron + pad in clear frame.
            let spawnX = 0, spawnZ = 35;
            if (window.__customerModeActive && window.__customerPickup) {
              // Prefer the LIVE __customerGroundPos — that's the truth of
              // where the user is right now in customer mode. The taxi is
              // tracking this exact point, so spawning here keeps the user
              // and taxi-pickup-target perfectly aligned.
              if (window.__customerGroundPos) {
                spawnX = window.__customerGroundPos.x;
                spawnZ = window.__customerGroundPos.z;
              } else {
                // Fallback: stage-based city (initial spawn before
                // __customerGroundPos has been written)
                const region = REGIONS[window.__sdxCurrentRegionKey || 'SF BAY'];
                const stage = window.__customerModeState?.stage || 'inbound_to_pickup';
                const anchorName = (stage === 'at_dropoff')
                  ? window.__customerDropoff
                  : window.__customerPickup;
                const cityPos = region?.pads?.[anchorName];
                if (cityPos) {
                  spawnX = cityPos.x;
                  spawnZ = cityPos.z;
                  // Initialize ground pos so the taxi sees us
                  window.__customerGroundPos = { x: spawnX, z: spawnZ };
                }
              }
            }
            padGroundState.pos.set(spawnX, 1.7, spawnZ);
            // Look toward origin from spawn point (works for both hub plaza
            // edge AND city edge — origin is always meaningful)
            padGroundState.yaw = Math.atan2(-padGroundState.pos.z, -padGroundState.pos.x);
            padGroundState.pitch = 0.15;
            // Disable OrbitControls — WASD/mouse-look take over
            if (padControls) padControls.enabled = false;
            // Show WASD HUD overlay + grab cursor on canvas
            const overlay = document.getElementById('pad-ground-hud');
            if (overlay) overlay.style.display = 'flex';
            const canvas = document.getElementById('pad-canvas');
            if (canvas) canvas.style.cursor = 'grab';
            // In customer mode, walking around the city means the hub and
            // other distant cities should NOT be visible (real eVTOL
            // passenger experience: you can only see the city you're in).
            // Tighten fog. In operator mode, keep the wide silhouettes view.
            if (padScene && padScene.fog) {
              if (window.__customerModeActive) {
                padScene.fog.near = 12;
                padScene.fog.far = 60;
              } else {
                padScene.fog.near = 80;
                padScene.fog.far = 550;
              }
            }
            padStickyCam = true;     // ground mode is sticky too
          }
        });
      });
      document.getElementById('pad-edit')?.addEventListener('click', closeLaunchPad);
      document.getElementById('pad-launch')?.addEventListener('click', () => {
        // If user has selected a customer order + aircraft, dispatch the order with that taxi
        if (padSelectedOrder && padSelectedAircraft) {
          dispatchSelectedOrder();
        } else if (!padSelectedOrder) {
          // No order selected — flash the chat panel as a hint
          const panel = document.querySelector('.pad-chat-panel');
          if (panel) {
            panel.style.boxShadow = '0 0 0 2px #f87171 inset';
            setTimeout(() => { panel.style.boxShadow = ''; }, 800);
          }
          alert('Click a customer order in INCOMING ORDERS to select pickup/dropoff first.');
        } else {
          alert('Select an aircraft from the FLEET ROSTER first.');
        }
      });
      // "+ NEW REQUEST" button — manually trigger a new fake order (for demo/testing)
      document.getElementById('pad-chat-refresh')?.addEventListener('click', () => {
        const padEl = document.getElementById('pad-location');
        const currentPad = padEl?.textContent || 'EMBARCADERO-7';
        padChatOrders.push(generateCustomerOrder(currentPad));
        renderChatFeed();
      });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && document.getElementById('pad-view')?.classList.contains('active')) {
          closeLaunchPad();
        }
        if (e.key === 'Escape' && document.getElementById('save-modal')?.classList.contains('active')) {
          closeSaveDialog();
        }
      });

      // ====================================================================
      // LOAD A SAVED DESIGN — restore from localStorage into the design view
      // ====================================================================
      function loadSavedDesign(design) {
        if (!design || !design.scene) return false;
        // Clear existing scene
        clearVehicle();
        partsRegistry.clear();
        try {
          const loader = new THREE.ObjectLoader();
          const restored = loader.parse(design.scene);
          // Move all children of restored into taxi, registering each by uuid → metadata
          while (restored.children.length) {
            const c = restored.children[0];
            taxi.add(c);
            // Find the registered metadata for this object's uuid
            const meta = design.partsMeta?.[c.uuid];
            if (meta) {
              registerPart(meta.name, { object: c, type: meta.type, kind: meta.kind });
            } else {
              // Fallback registration with synthetic name
              const synth = uniqueName('restored_part');
              registerPart(synth, { object: c, type: 'unknown', kind: 'feature' });
            }
          }
          // Restore tail/operator
          if (design.tailNumber) {
            const t = document.getElementById('tail-number'); if (t) t.value = design.tailNumber;
          }
          if (design.operator) {
            const o = document.getElementById('operator'); if (o) o.value = design.operator;
          }
          // Restore materials — apply to existing shared materials so future parts match
          if (design.materials) {
            if (design.materials.primary !== undefined) materials.primary.color.setHex(design.materials.primary);
            if (design.materials.accent  !== undefined) materials.accent.color.setHex(design.materials.accent);
            if (design.materials.trim    !== undefined) materials.trim.color.setHex(design.materials.trim);
          }
          // UI updates
          document.getElementById('viewport').classList.add('has-vehicle');
          if (typeof refreshGeometryStats === 'function') refreshGeometryStats();
          if (partsRegistry.has('fuselage') && typeof refreshSpecsFromFuselage === 'function') {
            refreshSpecsFromFuselage();
          }
          // Echo to chat
          const hist = document.getElementById('ai-history');
          if (hist) {
            const div = document.createElement('div');
            div.className = 'chat-msg ai info';
            div.innerHTML = `<div class="chat-result"><span class="check">📂</span>loaded design <span class="val">${escapeHtml(design.name)}</span> from hangar · ${partsRegistry.size} parts restored</div>`;
            hist.appendChild(div);
            hist.scrollTop = hist.scrollHeight;
          }
          return true;
        } catch (e) {
          console.error('loadSavedDesign failed:', e);
          return false;
        }
      }

      // Expose for splash → re-entry path (when user returns to splash and picks another design)
      window.__loadSavedDesign = loadSavedDesign;
      // Expose launch pad opener for the splash shortcut button
      window.__openLaunchPad = openLaunchPad;

      // ===== TEST BRIDGE =====
      // Exposes internal state so headless tests can verify duplication-bug
      // fixes. Exists in production (small, no behavior change). Returns
      // live references — callers must not mutate.
      window.__SDX_TEST = () => ({
        padScene, padCamera, padGroup, padControls,
        padFlightState, padFlightStates,
        padApronGroups,
        padDispatchedFlights,
        padSelectedAircraft, padSelectedOrder,
        padChatOrders,
        padDesignBatteries,         // Map<designId, {battery, isCharging, lastUpdate}>
        padRotors,                  // primary rotor list (for blade animation)
        renderFleetAprons, renderFleetRoster, dispatchSelectedOrder,
        loadDesignIntoPadGroup
      });
      // Test-only helper: set up + dispatch in one call, bypassing the chat-sim
      // timer so headless tests don't have to wait for orders to auto-generate.
      window.__SDX_TEST_DISPATCH = (designId, fromPad, toPad, customer) => {
        // Find the design summary in saved designs
        const all = getAllSavedDesigns();
        const design = all.find(d => d.id === designId);
        if (!design) return { error: 'design not found: ' + designId };
        // Set selected aircraft
        padSelectedAircraft = {
          id: design.id, name: design.name,
          tail: design.tailNumber || 'SDX-?', fromHangar: true
        };
        // Inject + select an order
        const order = {
          id: 'test-order-' + Date.now(),
          customer: customer || 'Test Customer',
          from: fromPad || 'EMBARCADERO-7',
          to:   toPad   || 'MISSION BAY',
          status: 'pending',
          timestamp: Date.now()
        };
        padChatOrders.push(order);
        padSelectedOrder = order;
        // Dispatch via the production code path
        dispatchSelectedOrder();
        return { ok: true, orderId: order.id, designId: design.id };
      };

      // Check if splash launched with a pending design to load
      if (window.__pendingLoadDesign) {
        const toLoad = window.__pendingLoadDesign;
        window.__pendingLoadDesign = null;
        // Defer until the scene is ready
        setTimeout(() => loadSavedDesign(toLoad), 80);
      }
    }

    // =========================================================
    // UNIFIED COUNTER SYNCHRONIZER — last-word writer
    // =========================================================
    // User: "Gemini is right." This is Gemini's approach adapted
    // to the actual element IDs in this file. Lives at the very
    // end of the script so nothing else can run after it and
    // stomp the displayed values. Both labels read from a single
    // source — counts visible flying clones in the launchpad
    // scene (active OR transitioning padFlightStates entries).
    //
    // Fires every 500ms. If any earlier system writes a different
    // value to these elements, this overwrite restores the truth
    // within half a second.
    (function installUnifiedCounterSync() {
      function syncCounters() {
        try {
          const padFlightStates = (typeof window !== 'undefined' && window.__padFlightStates) || [];
          // Visible-in-scene = active OR transitioning, with a
          // designId (anonymous flights don't represent saved designs).
          const visibleIds = new Set(
            padFlightStates
              .filter(f => f && (f.active || f.transitioning) && f.designId)
              .map(f => f.designId)
          );
          const visibleInFlight = visibleIds.size;
          // Total saved designs — lifted from localStorage directly so
          // we don't depend on any IIFE-scoped helpers being in scope.
          let total = 0;
          try {
            const raw = localStorage.getItem('sdx_designs_v1');
            if (raw) total = (JSON.parse(raw) || []).length;
          } catch (_) { /* localStorage unavailable */ }

          // ---- HUB BADGE ----
          // Element id: pad-map-flight-count. Lives next to the
          // dispatch map. Format: "X/N IN FLIGHT".
          const hubBadge = document.getElementById('pad-map-flight-count');
          if (hubBadge) {
            hubBadge.textContent = `${visibleInFlight}/${total} IN FLIGHT`;
            hubBadge.classList.remove('partial', 'heavy');
            if (visibleInFlight > 0 && total > 0) {
              if (visibleInFlight / total >= 0.5) hubBadge.classList.add('heavy');
              else hubBadge.classList.add('partial');
            }
          }

          // ---- SPLASH SUBLINE ----
          // Element id: splash-operator-available. Lives under the
          // OPERATOR FLIGHTS big number. Format:
          //    "X/N available to send · Y in flight"
          // Where Y is the SAME visibleInFlight value the hub badge
          // shows. Available = total - everything-committed (visible
          // launchpad + bg pool + customer hailed taxi).
          const splashSub = document.getElementById('splash-operator-available');
          if (splashSub && total > 0) {
            // Compute available with the same definition used elsewhere:
            // total minus designs committed to ANY pool.
            const launchpadCommitted = visibleIds;
            const bgFleet = (window.__backgroundOperatorFleet || []);
            const bgIds = new Set(bgFleet.filter(f => f && f.designId).map(f => f.designId));
            const customerId = window.__customerModeActive ? window.__customerAircraftId : null;
            const allCommitted = new Set([...launchpadCommitted, ...bgIds]);
            if (customerId) allCommitted.add(customerId);
            const available = Math.max(0, total - allCommitted.size);
            const parts = [];
            if (visibleInFlight > 0) parts.push(`${visibleInFlight} in flight`);
            const breakdown = parts.length ? ` · ${parts.join(' · ')}` : '';
            splashSub.textContent = `${available}/${total} available to send${breakdown}`;
          } else if (splashSub) {
            splashSub.textContent = 'design an aircraft to send flights';
          }
        } catch (_) { /* synchronizer must never throw */ }
      }
      // First tick now so the very first paint after page load
      // shows synchronized values, not whatever the in-page system
      // wrote during boot.
      syncCounters();
      // Persistent 500ms tick. Faster than the heartbeat (1Hz) so
      // any drift caused by other writers gets corrected within a
      // visible-update interval. Survives view switches because
      // it doesn't gate on splash/pad-view active state — both
      // elements just no-op via getElementById when not visible.
      setInterval(syncCounters, 500);
      // Expose so the user / debugging code can manually trigger.
      if (typeof window !== 'undefined') {
        window.__unifiedCounterSync = syncCounters;
      }
    })();
  </script>
</body>
</html>
