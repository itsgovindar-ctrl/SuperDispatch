      // Detect archetype from free-form text.
      function detectArchetype(lower) {
        if (/\bjoby|tilting rotors?|tilt-rotor|s4\b/.test(lower))                          return 'joby';
        if (/\bbell|nexus|paired (?:rotors?|ducts?|fans?)|ducted fans?\b/.test(lower))     return 'bell';
        if (/\blilium|embedded fans?|wing-embedded|jet-style\b/.test(lower))               return 'lilium';
        if (/\behang|216|octocopter|x-?frame\b/.test(lower))                               return 'ehang';
        if (/\bwisk(?:\s*aero)?|generation\s*6|gen\s*6|self.flying\s+air\s+taxi|autonomous\s+air\s+taxi\b/.test(lower)) return 'wisk';
        if (/\barcher|midnight|12 rotors?\b/.test(lower))                                  return 'archer';
        if (/\bvolocopter|volo|halo|ring of rotors?\b/.test(lower))                        return 'volo';
        if (/\bstealth|recon|flying.?wing|concealed|hidden rotors?\b/.test(lower))         return 'stealth';
