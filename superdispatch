      } catch (_) {}

      // If splash requested direct launch-pad routing, jump there once the
      // design has had a chance to load. Wait a bit longer if a design is loading.
      if (window.__pendingOpenLaunchPad) {
        window.__pendingOpenLaunchPad = false;
        const delay = window.__pendingLoadDesign ? 600 : 250;
        setTimeout(() => {
          if (typeof window.__openLaunchPad === 'function') {
