        if (/\bsport(?:y|ish|ing)?|aggressive|agile|racing|race\s|race-?car|sleek\s+racer\b/.test(lower)) return 'ehang';
        // Heuristic: explicit "tilting" or "wing.tip" keywords → joby-style
        if (/\bwing.tip rotors?\b/.test(lower)) return 'joby';
