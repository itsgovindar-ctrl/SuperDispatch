<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <!-- Cache-busting: this file changes every time the user reports a
       bug. Serving a cached version means the user is looking at a
       file BEFORE the fix and reporting the bug as still present. -->
  <meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate">
  <meta http-equiv="Pragma" content="no-cache">
  <meta http-equiv="Expires" content="0">
  <title>SuperDispatch · Air Taxi Operations · build 2026.05.06.r2</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400;500;700&family=JetBrains+Mono:wght@300;400;500&display=swap" rel="stylesheet">

  <style>
    :root {
      --bg-deep: #020817;
      --bg-mid: #061330;
      --bg-grid: #0F1B36;
      --bg-panel: #0A1428;
      --bg-panel-hi: #0F1F40;
      --text-primary: #F0F4FF;
      --text-secondary: #6E8AB8;
      --text-muted: #2D3F65;
      --border: #1A2B4A;
      --border-hi: #2D4775;
      --accent-cyan: #00E5FF;
      --accent-cyan-dim: #0088B0;
      --accent-amber: #FFB627;
      --accent-success: #4ADE80;
      --accent-danger: #FF5F6D;
      --boom: #1B3A6B;
      --boom-hi: #3D72BD;
      --rotor-housing: #0A1A38;
      --body-blue: #1F3A6B;
      --body-blue-hi: #2D5391;
      --font-display: 'Bricolage Grotesque', system-ui, sans-serif;
      --font-mono: 'JetBrains Mono', 'Courier New', monospace;
    }

    * { margin: 0; padding: 0; box-sizing: border-box; }

    html, body {
      height: 100%;
      overflow: hidden;
      background: var(--bg-deep);
      color: var(--text-primary);
      font-family: var(--font-display);
    }

    /* ===== VIEW SWITCHING ===== */
    .view {
      position: fixed;
      inset: 0;
      transition: opacity 0.5s ease;
      opacity: 0;
      pointer-events: none;
    }
    .view.active {
      opacity: 1;
      pointer-events: auto;
    }

    /* ============================================================ */
    /* SPLASH VIEW                                                  */
    /* ============================================================ */
    #splash-view {
      background:
        radial-gradient(ellipse 80% 60% at 50% 50%, var(--bg-mid) 0%, var(--bg-deep) 70%),
        var(--bg-deep);
    }

    .grid-bg {
      position: absolute;
      inset: 0;
      background-image:
        linear-gradient(var(--bg-grid) 1px, transparent 1px),
        linear-gradient(90deg, var(--bg-grid) 1px, transparent 1px);
      background-size: 64px 64px;
      opacity: 0.5;
      mask-image: radial-gradient(ellipse at center, black 25%, transparent 75%);
      -webkit-mask-image: radial-gradient(ellipse at center, black 25%, transparent 75%);
      pointer-events: none;
    }

    .stars { position: absolute; inset: 0; pointer-events: none; }
    .star {
      position: absolute;
      background: var(--text-primary);
      border-radius: 50%;
      animation: twinkle var(--dur, 3s) ease-in-out infinite;
      animation-delay: var(--delay, 0s);
    }
    @keyframes twinkle {
      0%, 100% { opacity: 0.2; }
      50% { opacity: var(--peak, 0.9); }
    }

    .corner-bracket {
      position: absolute;
      width: 28px;
      height: 28px;
      border: 1px solid var(--accent-cyan-dim);
      opacity: 0.45;
      pointer-events: none;
      z-index: 5;
    }
    .corner-bracket.tl { top: 72px; left: 40px; border-right: 0; border-bottom: 0; }
    .corner-bracket.tr { top: 72px; right: 40px; border-left: 0; border-bottom: 0; }
    .corner-bracket.bl { bottom: 72px; left: 40px; border-right: 0; border-top: 0; }
    .corner-bracket.br { bottom: 72px; right: 40px; border-left: 0; border-top: 0; }

    .splash-hud-top {
      position: absolute;
      top: 0; left: 0; right: 0;
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 22px 40px;
      font-family: var(--font-mono);
      font-size: 11px;
      letter-spacing: 1.4px;
      color: var(--text-secondary);
      text-transform: uppercase;
      z-index: 10;
    }
    .splash-hud-top .group { display: flex; gap: 28px; align-items: center; }
    .system-id {
      color: var(--accent-cyan);
      font-weight: 500;
      font-size: 12px;
      letter-spacing: 2.5px;
      display: flex;
      align-items: center;
      gap: 8px;
    }
    .divider { width: 1px; height: 14px; background: var(--text-muted); }

    .status-dot {
      display: inline-block;
      width: 6px; height: 6px;
      border-radius: 50%;
      background: var(--accent-success);
      margin-right: 8px;
      vertical-align: middle;
      box-shadow: 0 0 6px var(--accent-success);
      animation: blink 1.6s ease-in-out infinite;
    }
    @keyframes blink {
      0%, 100% { opacity: 0.5; }
      50% { opacity: 1; }
    }

    .splash-hud-bottom {
      position: absolute;
      bottom: 0; left: 0; right: 0;
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
      padding: 22px 40px;
      font-family: var(--font-mono);
      font-size: 10px;
      letter-spacing: 1.4px;
      color: var(--text-muted);
      text-transform: uppercase;
      z-index: 10;
    }
    .data-grid { display: flex; gap: 40px; }
    .data-readout { display: flex; flex-direction: column; gap: 4px; }
    .data-readout .label { color: var(--text-muted); font-size: 9px; }
    .data-readout .value { color: var(--text-secondary); font-size: 11px; font-weight: 500; }
    .data-readout.right-align { text-align: right; }

    .hero {
      position: relative;
      height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      z-index: 5;
      /* Top padding pushes content below browser chrome so the
         SuperDispatch wordmark isn't clipped by the URL bar /
         tab strip. User said "bring the title down so the browser
         does not block it" multiple times — 48px wasn't enough.
         110px clears Chrome's tabs+URL+bookmarks bar combined. */
      padding: 110px 24px 0;
    }

    .wordmark {
      font-family: var(--font-display);
      font-size: clamp(64px, 9vw, 120px);
      font-weight: 500;
      letter-spacing: -3.5px;
      line-height: 0.95;
      margin-bottom: 18px;
      color: var(--text-primary);
      opacity: 0;
      transform: translateY(24px);
      animation: rise 1s cubic-bezier(0.2, 0.8, 0.2, 1) 0.2s forwards;
      text-align: center;
    }
    .wordmark .super { font-weight: 400; }
    .wordmark .dispatch { font-weight: 700; font-style: italic; }

    .tagline {
      font-family: var(--font-mono);
      font-size: 11px;
      letter-spacing: 8px;
      text-transform: uppercase;
      color: var(--accent-cyan);
      margin-bottom: 56px;
      opacity: 0;
      transform: translateY(20px);
      animation: rise 1s cubic-bezier(0.2, 0.8, 0.2, 1) 0.5s forwards;
    }
    .tagline .sep { color: var(--accent-cyan-dim); margin: 0 14px; }

    @keyframes rise { to { opacity: 1; transform: translateY(0); } }

    .launch-btn {
      background: transparent;
      border: 0;
      cursor: pointer;
      padding: 0;
      position: relative;
      z-index: 10;             /* above the hangar panel (z-index: 5) so clicks always land */
      outline: none;
      opacity: 0;
      transform: translateY(20px) scale(0.95);
      animation: rise-scale 1.1s cubic-bezier(0.2, 0.8, 0.2, 1) 0.8s forwards;
      transition: transform 0.3s cubic-bezier(0.2, 0.8, 0.2, 1);
      filter: drop-shadow(0 0 24px rgba(0, 229, 255, 0.15));
    }
    .launch-btn:hover {
      transform: translateY(0) scale(1.04);
      filter: drop-shadow(0 0 36px rgba(0, 229, 255, 0.35));
    }
    .launch-btn:active { transform: translateY(0) scale(0.97); }
    .launch-btn:focus-visible {
      outline: 1px solid var(--accent-cyan);
      outline-offset: 12px;
      border-radius: 50%;
    }
    @keyframes rise-scale { to { opacity: 1; transform: translateY(0) scale(1); } }

    .air-taxi { display: block; overflow: visible; }

    .halo {
      animation: pulse 2.8s ease-in-out infinite;
      transform-origin: 160px 135px;
      transform-box: fill-box;
    }
    .halo-2 {
      animation: pulse 2.8s ease-in-out 0.7s infinite;
      transform-origin: 160px 135px;
      transform-box: fill-box;
    }
    @keyframes pulse {
      0%, 100% { opacity: 0.1; transform: scale(0.96); }
      50% { opacity: 0.5; transform: scale(1.03); }
    }

    .rotor-blades { animation: spin 0.5s linear infinite; transform-box: fill-box; transform-origin: center; }
    @keyframes spin { to { transform: rotate(360deg); } }

    .launch-btn:hover .rotor-blades { animation-duration: 0.18s; }
    .launch-btn:hover .halo { animation-duration: 1.4s; }
    .launch-btn:hover .halo-2 { animation-duration: 1.4s; }

    .radar-sweep {
      animation: sweep 4s linear infinite;
      transform-origin: 160px 135px;
      transform-box: fill-box;
    }
    @keyframes sweep { to { transform: rotate(360deg); } }

    .body-group { animation: float 4s ease-in-out infinite; transform-origin: center; transform-box: fill-box; }
    @keyframes float {
      0%, 100% { transform: translateY(0); }
      50% { transform: translateY(-3px); }
    }

    .launch-hint {
      margin-top: 56px;
      font-family: var(--font-mono);
      font-size: 11px;
      letter-spacing: 4px;
      text-transform: uppercase;
      color: var(--text-secondary);
      display: flex;
      align-items: center;
      gap: 14px;
      opacity: 0;
      animation: rise 1s cubic-bezier(0.2, 0.8, 0.2, 1) 1.1s forwards, hint-fade 2.6s ease-in-out 2.5s infinite;
    }
    @keyframes hint-fade { 0%, 100% { opacity: 0.55; } 50% { opacity: 1; } }
    .launch-hint .arrow { color: var(--accent-cyan); font-size: 14px; }

    /* Launching state */
    #splash-view.launching .hero > *:not(.launch-btn) { opacity: 0; transition: opacity 0.5s ease; }
    #splash-view.launching .launch-btn {
      transform: translateY(-40px) scale(1.15);
      transition: transform 1.4s cubic-bezier(0.4, 0, 0.2, 1), filter 1.4s ease;
      filter: drop-shadow(0 0 60px rgba(0, 229, 255, 0.6));
    }
    #splash-view.launching .rotor-blades { animation-duration: 0.08s; }

    .launch-overlay {
      position: absolute;
      inset: 0;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      pointer-events: none;
      opacity: 0;
      transition: opacity 0.4s ease;
      z-index: 20;
    }
    #splash-view.launching .launch-overlay { opacity: 1; transition-delay: 0.6s; }
    .launch-text {
      font-family: var(--font-mono);
      font-size: 13px;
      letter-spacing: 6px;
      text-transform: uppercase;
      color: var(--accent-cyan);
      margin-top: 220px;
    }
    .launch-progress {
      width: 280px;
      height: 1px;
      background: var(--text-muted);
      margin-top: 24px;
      position: relative;
      overflow: hidden;
    }
    .launch-progress .bar {
      position: absolute; inset: 0;
      width: 0;
      background: var(--accent-cyan);
      box-shadow: 0 0 8px var(--accent-cyan);
      transition: width 1.6s cubic-bezier(0.4, 0, 0.2, 1);
    }
    #splash-view.launching .launch-progress .bar { width: 100%; transition-delay: 0.7s; }

    /* ============================================================ */
    /* MANUFACTURING VIEW                                           */
    /* ============================================================ */
    #mfg-view {
      display: flex;
      flex-direction: column;
      min-width: 1100px;
    }

    .hud-top {
      height: 60px;
      flex-shrink: 0;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 24px;
      background: var(--bg-panel);
      border-bottom: 1px solid var(--border);
      font-family: var(--font-mono);
      font-size: 11px;
      letter-spacing: 1.4px;
      color: var(--text-secondary);
      text-transform: uppercase;
      z-index: 10;
    }
    .logo-block { display: flex; align-items: center; gap: 24px; }
    .breadcrumb { display: flex; align-items: center; gap: 10px; color: var(--text-muted); }
    .breadcrumb a { color: var(--text-muted); text-decoration: none; transition: color 0.15s; cursor: pointer; }
    .breadcrumb a:hover { color: var(--text-secondary); }
    .breadcrumb .current { color: var(--accent-cyan); }
    .breadcrumb .sep { opacity: 0.5; }
    .hud-readouts { display: flex; gap: 24px; align-items: center; }

    .workspace { flex: 1; display: flex; overflow: hidden; }

    .panel {
      background: var(--bg-panel);
      overflow-y: auto;
      flex-shrink: 0;
    }
    .panel-left { width: 260px; border-right: 1px solid var(--border); }
    .panel-right { width: 340px; border-left: 1px solid var(--border); }

    .panel-section { padding: 18px 20px; border-bottom: 1px solid var(--border); }

    .section-label {
      font-family: var(--font-mono);
      font-size: 10px;
      letter-spacing: 2px;
      color: var(--text-muted);
      text-transform: uppercase;
      margin-bottom: 12px;
      display: flex;
      align-items: center;
      gap: 8px;
    }
    .section-label::before {
      content: '';
      width: 4px; height: 4px;
      background: var(--accent-cyan);
      display: inline-block;
    }

    .component-list { display: flex; flex-direction: column; gap: 6px; }
    .section-meta {
      font-family: var(--font-mono);
      font-size: 9px;
      color: var(--text-secondary);
      letter-spacing: 0.05em;
      text-transform: none;
      opacity: 0.6;
      margin-left: 6px;
    }
    .parts-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 5px;
    }
    .part-card {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 4px;
      padding: 6px 4px 5px;
      background: rgba(255,255,255,0.015);
      border: 1px solid var(--border);
      border-radius: 4px;
      cursor: pointer;
      transition: all 0.15s;
      font-family: var(--font-mono);
      color: var(--text-secondary);
    }
    .part-card:hover {
      border-color: var(--accent-cyan);
      background: rgba(0, 229, 255, 0.05);
      color: var(--text-primary);
      transform: translateY(-1px);
    }
    .part-card .part-thumb {
      width: 100%;
      height: 38px;
      display: block;
    }
    .part-card .part-name {
      font-size: 9px;
      letter-spacing: 0.04em;
      text-align: center;
      line-height: 1.2;
    }
    .component {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 10px 12px;
      background: transparent;
      border: 1px solid var(--border);
      border-radius: 4px;
      cursor: pointer;
      transition: all 0.18s;
      font-family: var(--font-display);
      font-size: 13px;
      color: var(--text-secondary);
      text-align: left;
      width: 100%;
    }
    .component:hover {
      border-color: var(--border-hi);
      color: var(--text-primary);
      background: var(--bg-panel-hi);
    }
    .component.active {
      border-color: var(--accent-cyan);
      background: rgba(0, 229, 255, 0.06);
      color: var(--text-primary);
    }
    .component .index {
      font-family: var(--font-mono);
      font-size: 10px;
      color: var(--text-muted);
      min-width: 22px;
    }
    .component.active .index { color: var(--accent-cyan); }
    .component .name { flex: 1; font-weight: 500; }
    .component .meta { font-family: var(--font-mono); font-size: 10px; color: var(--text-muted); }

    .specs { display: grid; grid-template-columns: 1fr auto; gap: 7px 16px; font-family: var(--font-mono); font-size: 11px; }
    .specs .label { color: var(--text-muted); text-transform: uppercase; letter-spacing: 1.5px; }
    .specs .value { color: var(--text-primary); font-weight: 500; }

    .viewport {
      flex: 1;
      position: relative;
      background: radial-gradient(ellipse at center, #0a1933 0%, var(--bg-deep) 80%);
      overflow: hidden;
      min-width: 480px;
    }
    #three-canvas { display: block; width: 100%; height: 100%; }

    .viewport-overlay { position: absolute; inset: 0; pointer-events: none; }

    .viewport-corner {
      position: absolute;
      font-family: var(--font-mono);
      font-size: 10px;
      letter-spacing: 1.5px;
      color: var(--text-secondary);
      text-transform: uppercase;
      pointer-events: auto;
    }
    .viewport-corner.tl { top: 16px; left: 20px; }
    .viewport-corner.tr { top: 16px; right: 20px; }
    .viewport-corner.bl { bottom: 16px; left: 20px; }
    .viewport-corner.br { bottom: 16px; right: 20px; }

    .viewport-corner .group { display: flex; gap: 8px; align-items: center; }
    .pill {
      padding: 5px 10px;
      border: 1px solid var(--border);
      border-radius: 3px;
      background: rgba(10, 20, 40, 0.7);
      backdrop-filter: blur(6px);
      -webkit-backdrop-filter: blur(6px);
    }

    .view-btn {
      background: rgba(10, 20, 40, 0.7);
      border: 1px solid var(--border);
      color: var(--text-secondary);
      font-family: var(--font-mono);
      font-size: 10px;
      letter-spacing: 1.5px;
      text-transform: uppercase;
      padding: 6px 10px;
      cursor: pointer;
      transition: all 0.15s;
      backdrop-filter: blur(6px);
      -webkit-backdrop-filter: blur(6px);
    }
    .view-btn:hover { border-color: var(--accent-cyan); color: var(--accent-cyan); }
    .view-btn.active { border-color: var(--accent-cyan); color: var(--accent-cyan); background: rgba(0, 229, 255, 0.1); }
    .view-btn.tool-btn {
      border-color: rgba(0, 229, 255, 0.35);
      color: var(--accent-cyan);
      background: rgba(0, 229, 255, 0.04);
      letter-spacing: 0.08em;
    }
    .view-btn.tool-btn:hover {
      background: rgba(0, 229, 255, 0.15);
      box-shadow: 0 0 8px rgba(0, 229, 255, 0.25);
    }
    .view-btn.tool-btn.flash {
      animation: btnFlash 0.5s;
    }
    @keyframes btnFlash {
      0%   { background: rgba(0, 229, 255, 0.5); }
      100% { background: rgba(0, 229, 255, 0.04); }
    }

    .axes-gizmo {
      position: absolute;
      top: 70px;
      left: 24px;
      width: 90px;
      height: 90px;
      pointer-events: none;
    }

    /* ===== INSPECTOR PANEL — direct-edit UI for selected part ===== */
    .inspector {
      position: absolute;
      top: 70px;
      right: 24px;
      width: 320px;
      background: rgba(8, 12, 24, 0.94);
      border: 1px solid var(--border-hi);
      border-radius: 6px;
      padding: 10px 12px;
      pointer-events: auto;
      backdrop-filter: blur(12px);
      box-shadow: 0 12px 36px rgba(0, 0, 0, 0.5), 0 0 0 1px rgba(0, 229, 255, 0.08);
      font-family: var(--font-mono);
      animation: insSlideIn 180ms cubic-bezier(0.2, 0.8, 0.2, 1);
      z-index: 5;
      user-select: none;
    }
    .inspector[hidden] { display: none; }
    @keyframes insSlideIn {
      from { opacity: 0; transform: translateY(-8px); }
      to   { opacity: 1; transform: translateY(0); }
    }
    .inspector-header {
      display: flex;
      align-items: center;
      gap: 10px;
      padding-bottom: 8px;
      margin-bottom: 10px;
      border-bottom: 1px solid var(--border);
      cursor: grab;
    }
    .inspector-header:active { cursor: grabbing; }
    .inspector.dragging { box-shadow: 0 16px 48px rgba(0, 0, 0, 0.6), 0 0 0 1px var(--accent-cyan); }
    .inspector-header::before {
      content: '⋮⋮';
      color: var(--text-secondary);
      opacity: 0.4;
      font-size: 14px;
      letter-spacing: -2px;
      margin-right: -2px;
    }
    .inspector-label {
      font-size: 9px;
      letter-spacing: 0.18em;
      color: var(--text-secondary);
    }
    .inspector-name {
      flex: 1;
      font-size: 13px;
      color: var(--accent-cyan);
      letter-spacing: 0.04em;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
    .inspector-close {
      background: transparent;
      border: 1px solid var(--border);
      color: var(--text-secondary);
      width: 22px;
      height: 22px;
      border-radius: 3px;
      cursor: pointer;
      font-size: 16px;
      line-height: 1;
      padding: 0;
      transition: all 120ms;
    }
    .inspector-close:hover {
      border-color: var(--accent-cyan);
      color: var(--accent-cyan);
    }
    .inspector-modes {
      display: flex;
      gap: 4px;
      margin-bottom: 10px;
    }
    .ins-mode {
      flex: 1;
      background: transparent;
      border: 1px solid var(--border);
      color: var(--text-secondary);
      font-family: var(--font-mono);
      font-size: 10px;
      letter-spacing: 0.1em;
      padding: 6px 4px;
      cursor: pointer;
      border-radius: 3px;
      transition: all 120ms;
    }
    .ins-mode:hover { border-color: var(--border-hi); color: var(--text-primary); }
    .ins-mode.active {
      border-color: var(--accent-cyan);
      color: var(--accent-cyan);
      background: rgba(0, 229, 255, 0.08);
    }
    .inspector-fields {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 6px;
      margin-bottom: 10px;
    }
    .inspector-fields[data-mode-fields="scale"] {
      grid-template-columns: repeat(2, 1fr);
    }
    .inspector-fields[hidden] { display: none; }
    .inspector-fields label {
      display: flex;
      flex-direction: column;
      gap: 3px;
      font-size: 9px;
      letter-spacing: 0.1em;
      color: var(--text-secondary);
    }
    .inspector-fields label > span { padding-left: 2px; }
    .inspector-fields input {
      background: rgba(255, 255, 255, 0.03);
      border: 1px solid var(--border);
      color: var(--text-primary);
      font-family: var(--font-mono);
      font-size: 12px;
      padding: 5px 6px;
      border-radius: 3px;
      outline: none;
      width: 100%;
      box-sizing: border-box;
      -moz-appearance: textfield;
    }
    .inspector-fields input::-webkit-outer-spin-button,
    .inspector-fields input::-webkit-inner-spin-button {
      -webkit-appearance: none;
      margin: 0;
    }
    .inspector-fields input:focus {
      border-color: var(--accent-cyan);
      background: rgba(0, 229, 255, 0.05);
    }
    .inspector-actions {
      display: flex;
      gap: 6px;
      margin-bottom: 8px;
    }
    .ins-btn {
      flex: 1;
      font-size: 10px;
      letter-spacing: 0.1em;
      padding: 6px 8px;
    }
    .ins-danger {
      border-color: rgba(245, 158, 11, 0.4);
      color: #f59e0b;
    }
    .ins-danger:hover {
      border-color: #f59e0b;
      background: rgba(245, 158, 11, 0.1);
    }
    .inspector-hint {
      font-size: 9px;
      color: var(--text-secondary);
      letter-spacing: 0.05em;
      text-align: center;
      opacity: 0.7;
    }
    .inspector-hint kbd {
      display: inline-block;
      background: rgba(255, 255, 255, 0.06);
      border: 1px solid var(--border);
      border-radius: 2px;
      padding: 0 4px;
      font-family: var(--font-mono);
      font-size: 9px;
      color: var(--text-primary);
      margin: 0 1px;
    }
    .color-row { display: flex; align-items: center; justify-content: space-between; margin-bottom: 12px; }
    .color-row:last-child { margin-bottom: 0; }
    .color-row .label {
      font-family: var(--font-mono);
      font-size: 11px;
      color: var(--text-secondary);
      text-transform: uppercase;
      letter-spacing: 1.5px;
    }
    .color-input-wrap { display: flex; align-items: center; gap: 8px; }
    .color-input-wrap input[type="color"] {
      width: 36px; height: 28px;
      border: 1px solid var(--border);
      background: transparent;
      border-radius: 3px;
      cursor: pointer;
      padding: 0;
    }
    .color-input-wrap input[type="color"]::-webkit-color-swatch-wrapper { padding: 2px; }
    .color-input-wrap input[type="color"]::-webkit-color-swatch { border: none; border-radius: 2px; }
    .color-input-wrap input[type="color"]::-moz-color-swatch { border: none; border-radius: 2px; }
    .hex-input {
      font-family: var(--font-mono);
      font-size: 11px;
      color: var(--text-secondary);
      width: 70px;
      background: var(--bg-deep);
      border: 1px solid var(--border);
      padding: 6px 8px;
      border-radius: 3px;
      text-transform: uppercase;
    }
    .hex-input:focus { outline: none; border-color: var(--accent-cyan); color: var(--text-primary); }

    .preset-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 8px; }
    .preset-card {
      background: var(--bg-panel-hi);
      border: 1px solid var(--border);
      border-radius: 4px;
      padding: 9px;
      cursor: pointer;
      transition: all 0.18s;
      text-align: left;
      font-family: var(--font-display);
      color: var(--text-secondary);
    }
    .preset-card:hover { border-color: var(--border-hi); color: var(--text-primary); }
    .preset-card.active { border-color: var(--accent-cyan); background: rgba(0, 229, 255, 0.05); }
    .preset-swatch {
      height: 22px;
      border-radius: 2px;
      margin-bottom: 7px;
      display: flex;
      overflow: hidden;
    }
    .preset-swatch span { flex: 1; }
    .preset-name {
      font-weight: 500;
      text-transform: uppercase;
      letter-spacing: 1.2px;
      font-size: 10px;
      font-family: var(--font-mono);
    }

    .text-input {
      width: 100%;
      background: var(--bg-deep);
      border: 1px solid var(--border);
      color: var(--text-primary);
      font-family: var(--font-mono);
      font-size: 12px;
      padding: 9px 10px;
      border-radius: 3px;
      text-transform: uppercase;
    }
    .text-input:focus { outline: none; border-color: var(--accent-cyan); }
    .text-input + .text-input { margin-top: 8px; }

    .action-bar {
      height: 64px;
      flex-shrink: 0;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 24px;
      background: var(--bg-panel);
      border-top: 1px solid var(--border);
    }

    .build-info {
      display: flex;
      gap: 24px;
      font-family: var(--font-mono);
      font-size: 11px;
      text-transform: uppercase;
      letter-spacing: 1.5px;
    }
    .build-info > div { display: flex; gap: 8px; }
    .build-info .key { color: var(--text-muted); }
    .build-info .val { color: var(--text-secondary); font-weight: 500; }

    .actions { display: flex; gap: 10px; }
    .btn {
      background: transparent;
      border: 1px solid var(--border);
      color: var(--text-secondary);
      font-family: var(--font-mono);
      font-size: 11px;
      letter-spacing: 2px;
      text-transform: uppercase;
      padding: 11px 18px;
      cursor: pointer;
      transition: all 0.15s;
    }
    .btn:hover { border-color: var(--border-hi); color: var(--text-primary); }
    .btn:disabled { opacity: 0.35; cursor: not-allowed; }
    .btn:disabled:hover { border-color: var(--border); color: var(--text-secondary); }
    .btn.primary {
      border-color: var(--accent-cyan);
      color: var(--accent-cyan);
      background: rgba(0, 229, 255, 0.06);
    }
    .btn.primary:hover {
      background: var(--accent-cyan);
      color: var(--bg-deep);
      box-shadow: 0 0 24px rgba(0, 229, 255, 0.45);
    }
    .btn.flash-success { color: var(--accent-success) !important; border-color: var(--accent-success) !important; }

    /* ===== MODAL ===== */
    .modal-backdrop {
      position: fixed; inset: 0;
      background: rgba(2, 8, 23, 0.85);
      backdrop-filter: blur(8px);
      -webkit-backdrop-filter: blur(8px);
      display: flex;
      align-items: center;
      justify-content: center;
      z-index: 100;
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.3s;
    }
    .modal-backdrop.active { opacity: 1; pointer-events: auto; }
    .modal {
      background: var(--bg-panel);
      border: 1px solid var(--accent-cyan);
      padding: 36px 44px;
      max-width: 480px;
      text-align: center;
      transform: scale(0.95);
      transition: transform 0.3s;
    }
    .modal-backdrop.active .modal { transform: scale(1); }
    .modal h2 {
      font-family: var(--font-display);
      font-size: 22px;
      font-weight: 500;
      margin-bottom: 10px;
      letter-spacing: -0.5px;
    }
    .modal p {
      font-family: var(--font-mono);
      font-size: 11px;
      color: var(--text-secondary);
      letter-spacing: 1.5px;
      margin-bottom: 18px;
      text-transform: uppercase;
    }
    .modal-progress {
      width: 100%; height: 1px;
      background: var(--border);
      position: relative;
      margin-bottom: 18px;
    }
    .modal-progress .bar {
      position: absolute; inset: 0;
      width: 0;
      background: var(--accent-cyan);
      box-shadow: 0 0 8px var(--accent-cyan);
      transition: width 2.6s linear;
    }
    .modal-backdrop.active .modal-progress .bar { width: 100%; }

    /* ===== FLIGHT TEST CHAMBER ===== */
    .test-backdrop { background: rgba(2, 6, 18, 0.92); }
    .test-chamber {
      background: var(--bg-panel);
      border: 1px solid var(--accent-cyan);
      width: min(1180px, 96vw);
      height: min(780px, 92vh);
      display: flex;
      flex-direction: column;
      transform: scale(0.97);
      transition: transform 0.3s;
      box-shadow: 0 0 0 1px rgba(0, 229, 255, 0.15), 0 24px 80px rgba(0, 0, 0, 0.7);
      border-radius: 4px;
      overflow: hidden;
    }
    .modal-backdrop.active .test-chamber { transform: scale(1); }

    .test-header {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 14px 18px;
      border-bottom: 1px solid var(--border);
      background: rgba(0, 0, 0, 0.25);
    }
    .test-title {
      display: flex;
      align-items: center;
      gap: 10px;
      flex: 1;
      font-family: var(--font-display);
      font-size: 14px;
      letter-spacing: 0.06em;
      color: var(--text-primary);
    }
    .test-badge {
      background: var(--accent-cyan);
      color: #001a22;
      font-family: var(--font-mono);
      font-size: 10px;
      font-weight: 700;
      letter-spacing: 0.12em;
      padding: 3px 7px;
      border-radius: 2px;
    }
    .test-unit-id {
      font-family: var(--font-mono);
      font-size: 11px;
      color: var(--text-secondary);
      letter-spacing: 0.1em;
      margin-left: 8px;
      padding-left: 12px;
      border-left: 1px solid var(--border);
    }
    .test-status-pill {
      font-family: var(--font-mono);
      font-size: 10px;
      letter-spacing: 0.18em;
      padding: 5px 10px;
      border-radius: 2px;
      background: rgba(245, 158, 11, 0.12);
      color: #f59e0b;
      border: 1px solid rgba(245, 158, 11, 0.3);
      text-transform: uppercase;
    }
    .test-status-pill.running { background: rgba(0, 229, 255, 0.12); color: var(--accent-cyan); border-color: rgba(0, 229, 255, 0.3); }
    .test-status-pill.passed  { background: rgba(74, 222, 128, 0.12); color: #4ade80; border-color: rgba(74, 222, 128, 0.3); }
    .test-status-pill.failed  { background: rgba(245, 70, 70, 0.12); color: #f87171; border-color: rgba(245, 70, 70, 0.3); }

    .test-close {
      background: transparent;
      border: 1px solid var(--border);
      color: var(--text-secondary);
      width: 28px;
      height: 28px;
      border-radius: 3px;
      cursor: pointer;
      font-size: 18px;
      line-height: 1;
      padding: 0;
      transition: all 120ms;
    }
    .test-close:hover { border-color: var(--accent-cyan); color: var(--accent-cyan); }

    .test-body {
      flex: 1;
      display: flex;
      min-height: 0;
    }

    .test-viewport-wrap {
      flex: 1;
      position: relative;
      background: linear-gradient(180deg, #050a18 0%, #020714 50%, #030a1a 100%);
      overflow: hidden;
    }
    .test-viewport-wrap canvas { display: block; width: 100%; height: 100%; }
    .test-grid-overlay {
      position: absolute; inset: 0;
      pointer-events: none;
    }
    .test-grid-overlay svg { width: 100%; height: 100%; }

    .test-readout {
      position: absolute;
      font-family: var(--font-mono);
      font-size: 10px;
      letter-spacing: 0.08em;
      color: var(--text-secondary);
      background: rgba(2, 8, 23, 0.7);
      border: 1px solid var(--border);
      padding: 6px 10px;
      border-radius: 3px;
      backdrop-filter: blur(4px);
      pointer-events: none;
    }
    .test-readout.tl { top: 14px; left: 14px; }
    .test-readout.tr { top: 14px; right: 14px; }
    .test-readout.bl { bottom: 14px; left: 14px; }
    .test-readout.br { bottom: 14px; right: 14px; }
    .readout-row { display: flex; gap: 12px; justify-content: space-between; min-width: 110px; }
    .readout-row span:first-child { color: var(--text-secondary); }
    .readout-row span:last-child { color: var(--accent-cyan); font-variant-numeric: tabular-nums; }

    .test-results {
      width: 340px;
      border-left: 1px solid var(--border);
      background: rgba(0, 0, 0, 0.22);
      overflow-y: auto;
      padding: 14px 0;
    }
    .test-section {
      padding: 10px 18px 14px;
      border-bottom: 1px solid var(--border);
    }
    .test-section:last-child { border-bottom: 0; }
    .test-section-title {
      font-family: var(--font-mono);
      font-size: 9px;
      letter-spacing: 0.18em;
      color: var(--text-secondary);
      margin-bottom: 8px;
    }
    .test-row {
      display: grid;
      grid-template-columns: 1fr auto 16px;
      gap: 10px;
      align-items: center;
      padding: 5px 0;
      font-family: var(--font-mono);
      font-size: 11px;
    }
    .test-row .test-label { color: var(--text-secondary); letter-spacing: 0.04em; }
    .test-row .test-value {
      color: var(--text-primary);
      font-variant-numeric: tabular-nums;
      text-align: right;
    }
    .test-row .test-marker { color: var(--border-hi); font-size: 14px; line-height: 1; text-align: center; }
    .test-row.running .test-marker { color: var(--accent-cyan); animation: pulse 1.2s ease-in-out infinite; }
    .test-row.pass .test-marker { color: #4ade80; }
    .test-row.pass .test-marker::before { content: '✓'; }
    .test-row.pass .test-marker { font-weight: 700; }
    .test-row.fail .test-marker { color: #f87171; }
    .test-row.fail .test-marker::before { content: '✕'; }
    .test-row.fail .test-marker { font-weight: 700; }
    .test-row.warn .test-marker { color: #f59e0b; }
    .test-row.warn .test-marker::before { content: '!'; }
    .test-row.warn .test-marker { font-weight: 700; }
    .test-row.fail .test-value { color: #f87171; }
    .test-row.warn .test-value { color: #f59e0b; }
    .test-row.pass .test-value { color: #4ade80; }
    @keyframes pulse {
      0%, 100% { opacity: 0.4; transform: scale(0.85); }
      50%      { opacity: 1; transform: scale(1.1); }
    }

    .test-verdict {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 10px 12px;
      border: 1px solid var(--border);
      border-radius: 3px;
      background: rgba(255, 255, 255, 0.02);
    }
    .test-verdict.pass { border-color: rgba(74, 222, 128, 0.4); background: rgba(74, 222, 128, 0.06); }
    .test-verdict.fail { border-color: rgba(245, 70, 70, 0.4); background: rgba(245, 70, 70, 0.06); }
    .verdict-icon { font-size: 22px; line-height: 1; }
    .verdict-text {
      flex: 1;
      font-family: var(--font-mono);
      font-size: 11px;
      letter-spacing: 0.04em;
      line-height: 1.4;
      color: var(--text-primary);
    }

    .test-footer {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 12px 18px;
      border-top: 1px solid var(--border);
      background: rgba(0, 0, 0, 0.25);
    }
    .test-footer-info {
      flex: 1;
      font-family: var(--font-mono);
      font-size: 11px;
      color: var(--text-secondary);
      letter-spacing: 0.04em;
    }
    .test-footer-actions { display: flex; gap: 8px; }
    .test-footer .btn { padding: 9px 14px; }

    /* ===== MANUFACTURING COMPLETE MODAL (upgraded) ===== */
    .mfg-modal { padding: 32px 38px; max-width: 460px; }
    .mfg-checkmark {
      width: 56px; height: 56px;
      margin: 0 auto 16px;
      border: 2px solid #4ade80;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      color: #4ade80;
      font-size: 30px;
      font-weight: 700;
      animation: checkPop 0.45s cubic-bezier(0.2, 0.9, 0.3, 1.4) backwards;
    }
    @keyframes checkPop {
      from { transform: scale(0.3); opacity: 0; }
      50%  { transform: scale(1.1); }
      to   { transform: scale(1); opacity: 1; }
    }
    .mfg-deploy-btn {
      margin-top: 10px;
      padding: 12px 20px;
      width: 100%;
      letter-spacing: 0.08em;
    }

