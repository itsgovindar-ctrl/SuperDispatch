      // ============================================================
      // MOTORS / PROPULSION UNITS
      //
      // Distinct from rotors: a motor is the electric drive housing (nacelle).
      // The rotor/propeller is the spinning blade assembly that mounts on top.
      // Real eVTOLs visually distinguish these — the motor reads as a stout
      // cylindrical pod with cooling fins/vents and a hub spindle, while the
      // rotor is the disk of blades. These builders create only the housing.
      // ============================================================

      // Materials specific to motor housings: dark-graphite nacelle body,
      // brushed-aluminium cooling rings, glowing copper indicator strips.
      const motorMaterials = {
        nacelleBody:   new THREE.MeshStandardMaterial({ color: 0x1a232f, roughness: 0.55, metalness: 0.45 }),
        nacelleAccent: new THREE.MeshStandardMaterial({ color: 0x9aa6b8, roughness: 0.30, metalness: 0.85 }),
        nacelleCopper: new THREE.MeshStandardMaterial({ color: 0xc9763e, emissive: 0x4a2510, emissiveIntensity: 0.45, roughness: 0.4, metalness: 0.7 }),
        nacelleGlow:   new THREE.MeshStandardMaterial({ color: 0x00e5ff, emissive: 0x00a5b8, emissiveIntensity: 0.85, roughness: 0.2, metalness: 0.4 }),
        ductRing:      new THREE.MeshStandardMaterial({ color: 0x2b3548, roughness: 0.5, metalness: 0.55 }),
        propeller:     new THREE.MeshStandardMaterial({ color: 0x121822, roughness: 0.6, metalness: 0.3 })
      };

      // 1. TILTING MOTOR POD — Joby/Archer-style cylindrical nacelle that tilts
      //    between hover and forward-flight orientations. Hub at one end, cooling
      //    fins along the body, spinner cone at the front.
      function addTiltingMotor() {
        const grp = new THREE.Group();
        const len = 0.42, r = 0.13;
        // Main nacelle body — cylinder along X
        const body = new THREE.Mesh(new THREE.CylinderGeometry(r, r * 0.85, len, 24), motorMaterials.nacelleBody);
        body.rotation.z = Math.PI / 2;
        grp.add(body);
        // Cooling fin rings — three brushed-aluminium bands around the body
        for (const xOff of [-0.08, 0, 0.08]) {
          const ring = new THREE.Mesh(new THREE.CylinderGeometry(r * 1.05, r * 1.05, 0.018, 24), motorMaterials.nacelleAccent);
          ring.rotation.z = Math.PI / 2;
          ring.position.x = xOff;
          grp.add(ring);
        }
        // Spinner cone at the front (X+)
        const spinner = new THREE.Mesh(new THREE.ConeGeometry(r * 0.78, 0.12, 18), motorMaterials.nacelleAccent);
        spinner.rotation.z = -Math.PI / 2;
        spinner.position.x = len / 2 + 0.06;
        grp.add(spinner);
        // Glowing status LED ring at the rear
        const led = new THREE.Mesh(new THREE.TorusGeometry(r * 0.85, 0.012, 6, 24), motorMaterials.nacelleGlow);
        led.rotation.y = Math.PI / 2;
        led.position.x = -len / 2 - 0.005;
        grp.add(led);
        // Mounting bracket underneath (where it attaches to wing/boom)
        const bracket = new THREE.Mesh(new THREE.BoxGeometry(len * 0.6, 0.05, 0.1), motorMaterials.nacelleBody);
        bracket.position.set(0, -r - 0.025, 0);
        grp.add(bracket);
        grp.traverse(o => { if (o.isMesh) o.castShadow = true; });
        // Default placement: above fuselage where a wing/boom would mount
        const D = getFuselageDims();
        grp.position.set(0, D.H * 0.5 + 0.4, 0);
        return _placeAndSelect(grp, 'tilt_motor', 'tilt_motor', 'motor');
      }

      // 2. LIFT MOTOR — vertical-axis electric drive unit, what sits on a
      //    quadcopter arm tip. Shorter, fatter housing with axial cooling slots.
      function addLiftMotor() {
        const grp = new THREE.Group();
        const r = 0.11, h = 0.09;
        // Squat cylindrical housing — axis vertical (Y)
        const body = new THREE.Mesh(new THREE.CylinderGeometry(r, r, h, 22), motorMaterials.nacelleBody);
        grp.add(body);
        // Top cap with shaft
        const cap = new THREE.Mesh(new THREE.CylinderGeometry(r * 0.9, r * 0.9, 0.015, 22), motorMaterials.nacelleAccent);
        cap.position.y = h / 2 + 0.008;
        grp.add(cap);
        // Output shaft sticking up (where rotor hub mounts)
        const shaft = new THREE.Mesh(new THREE.CylinderGeometry(0.018, 0.018, 0.045, 12), motorMaterials.nacelleAccent);
        shaft.position.y = h / 2 + 0.038;
        grp.add(shaft);
        // Axial cooling slots — 6 vertical cuts around the body
        for (let i = 0; i < 6; i++) {
          const ang = (i / 6) * Math.PI * 2;
          const slot = new THREE.Mesh(new THREE.BoxGeometry(0.018, h * 0.7, 0.012), libMaterials.cutoutDark);
          slot.position.set(Math.cos(ang) * (r + 0.001), 0, Math.sin(ang) * (r + 0.001));
          slot.rotation.y = -ang;
          grp.add(slot);
        }
        // Copper stator hint visible through the slots
        const stator = new THREE.Mesh(new THREE.CylinderGeometry(r * 0.78, r * 0.78, h * 0.65, 16), motorMaterials.nacelleCopper);
        grp.add(stator);
        // Mounting flange at base
        const flange = new THREE.Mesh(new THREE.CylinderGeometry(r * 1.15, r * 1.15, 0.012, 22), motorMaterials.nacelleAccent);
        flange.position.y = -h / 2 - 0.006;
        grp.add(flange);
        grp.traverse(o => { if (o.isMesh) o.castShadow = true; });
        const D = getFuselageDims();
        grp.position.set(0, D.H * 0.5 + 0.35, 0);
        return _placeAndSelect(grp, 'lift_motor', 'lift_motor', 'motor');
      }

      // 3. DUCTED FAN — shrouded propeller. Annular outer duct enclosing a small
      //    inner motor with multiple thin blades. Reads as the "EHang/Lilium" look.
      function addDuctedFan() {
        const grp = new THREE.Group();
        const outerR = 0.22, innerR = 0.18, ductH = 0.16;
        // Outer duct ring — torus-like shroud
        const outerShape = new THREE.Shape();
        outerShape.absarc(0, 0, outerR, 0, Math.PI * 2, false);
        const innerHole = new THREE.Path();
        innerHole.absarc(0, 0, innerR, 0, Math.PI * 2, true);
        outerShape.holes.push(innerHole);
        const ductGeom = new THREE.ExtrudeGeometry(outerShape, {
          depth: ductH, bevelEnabled: true, bevelSize: 0.012, bevelThickness: 0.012, bevelSegments: 2, curveSegments: 24
        });
        ductGeom.translate(0, 0, -ductH / 2);
        ductGeom.rotateX(Math.PI / 2);
        const duct = new THREE.Mesh(ductGeom, motorMaterials.ductRing);
        grp.add(duct);
        // Inner ring trim — cyan accent at top of duct
        const trim = new THREE.Mesh(new THREE.TorusGeometry(innerR + 0.005, 0.008, 6, 32), motorMaterials.nacelleGlow);
        trim.rotation.x = Math.PI / 2;
        trim.position.y = ductH / 2 - 0.005;
        grp.add(trim);
        // Central motor hub
        const hub = new THREE.Mesh(new THREE.CylinderGeometry(0.04, 0.05, 0.08, 16), motorMaterials.nacelleBody);
        grp.add(hub);
        // Motor support struts — 4 thin spokes from hub to inner ring
        for (let i = 0; i < 4; i++) {
          const ang = (i / 4) * Math.PI * 2;
          const strut = new THREE.Mesh(new THREE.BoxGeometry(innerR - 0.04, 0.012, 0.014), motorMaterials.nacelleAccent);
          strut.position.set(Math.cos(ang) * ((innerR + 0.04) / 2), 0, Math.sin(ang) * ((innerR + 0.04) / 2));
          strut.rotation.y = -ang;
          grp.add(strut);
        }
        // Propeller blades — 5 thin angled blades
        for (let i = 0; i < 5; i++) {
          const ang = (i / 5) * Math.PI * 2;
          const blade = new THREE.Mesh(new THREE.BoxGeometry(innerR * 0.85, 0.005, 0.04), motorMaterials.propeller);
          blade.position.set(Math.cos(ang) * (innerR * 0.5), 0.005, Math.sin(ang) * (innerR * 0.5));
          blade.rotation.y = -ang;
          blade.rotation.x = 0.18;     // pitch
          grp.add(blade);
        }
        grp.traverse(o => { if (o.isMesh) o.castShadow = true; });
        const D = getFuselageDims();
        grp.position.set(0, D.H * 0.5 + 0.3, 0);
        return _placeAndSelect(grp, 'ducted_fan', 'ducted_fan', 'motor');
      }

      // 4. PUSHER MOTOR — horizontal-axis thrust motor mounted at rear, with a
      //    small forward-flight propeller. The "cruise rotor" on Archer/Joby.
      function addPusherMotor() {
        const grp = new THREE.Group();
        const len = 0.34, r = 0.10;
        // Streamlined nacelle body
        const body = new THREE.Mesh(new THREE.CapsuleGeometry(r, len * 0.65, 8, 16), motorMaterials.nacelleBody);
        body.rotation.z = Math.PI / 2;
        grp.add(body);
        // Cyan accent stripe along the body
        const stripe = new THREE.Mesh(new THREE.BoxGeometry(len * 0.85, 0.012, 0.022), motorMaterials.nacelleGlow);
        stripe.position.y = r;
        grp.add(stripe);
        // Output shaft at rear (X-)
        const shaft = new THREE.Mesh(new THREE.CylinderGeometry(0.014, 0.014, 0.06, 10), motorMaterials.nacelleAccent);
        shaft.rotation.z = Math.PI / 2;
        shaft.position.x = -len / 2 - 0.025;
        grp.add(shaft);
        // 3-blade pusher prop at the rear
        const propHub = new THREE.Mesh(new THREE.CylinderGeometry(0.025, 0.025, 0.025, 12), motorMaterials.nacelleAccent);
        propHub.rotation.z = Math.PI / 2;
        propHub.position.x = -len / 2 - 0.06;
        grp.add(propHub);
        for (let i = 0; i < 3; i++) {
          const ang = (i / 3) * Math.PI * 2;
          const blade = new THREE.Mesh(new THREE.BoxGeometry(0.012, 0.22, 0.038), motorMaterials.propeller);
          blade.position.set(-len / 2 - 0.06, Math.sin(ang) * 0.11, Math.cos(ang) * 0.11);
          blade.rotation.x = ang + Math.PI / 2;
          blade.rotation.z = 0.16;     // pitch
          grp.add(blade);
        }
        // Mount bracket on top
        const bracket = new THREE.Mesh(new THREE.BoxGeometry(len * 0.5, 0.04, 0.08), motorMaterials.nacelleBody);
        bracket.position.set(0, r + 0.02, 0);
        grp.add(bracket);
        grp.traverse(o => { if (o.isMesh) o.castShadow = true; });
        const D = getFuselageDims();
        grp.position.set(-D.L * 0.55, D.H * 0.45, 0);
        return _placeAndSelect(grp, 'pusher_motor', 'pusher_motor', 'motor');
      }

      // ============================================================
      // CAD OPERATIONS (SOLIDWORKS-inspired)
      //
      // SOLIDWORKS classifies features as:
      //   - SKETCH-BASED: extrude (boss), cut-extrude, revolve, sweep, loft
      //   - APPLIED: fillet, chamfer, shell  (no sketch — applied to existing geometry)
      //   - PATTERN: linear pattern, circular pattern, mirror
      //
      // We implement applied features + patterns + extruded cuts on top of our
      // simpler geometry model. Real SOLIDWORKS uses parametric history-based
      // boolean operations; we use approximations that read clearly visually.
      // ============================================================

      // Helper: build a rounded box geometry by hand (RoundedBoxGeometry isn't in core three.js)
      function buildRoundedBoxGeometry(w, h, d, radius, segments = 4) {
        radius = Math.min(radius, w / 2 - 0.001, h / 2 - 0.001, d / 2 - 0.001);
        if (radius <= 0.005) return new THREE.BoxGeometry(w, h, d);
        // Use ExtrudeGeometry on a rounded rectangle profile, extruded to depth d
        const shape = new THREE.Shape();
        const hw = w / 2, hh = h / 2, r = radius;
        shape.moveTo(-hw + r, -hh);
        shape.lineTo(hw - r, -hh);
        shape.absarc(hw - r, -hh + r, r, -Math.PI / 2, 0, false);
        shape.lineTo(hw, hh - r);
        shape.absarc(hw - r, hh - r, r, 0, Math.PI / 2, false);
        shape.lineTo(-hw + r, hh);
        shape.absarc(-hw + r, hh - r, r, Math.PI / 2, Math.PI, false);
        shape.lineTo(-hw, -hh + r);
        shape.absarc(-hw + r, -hh + r, r, Math.PI, 1.5 * Math.PI, false);
        const geo = new THREE.ExtrudeGeometry(shape, {
          depth: d - radius * 2,
          bevelEnabled: true,
          bevelThickness: radius,
          bevelSize: radius,
          bevelSegments: segments,
          curveSegments: segments * 2
        });
        // Extrude pushes geometry along +Z from origin; recenter
        geo.translate(0, 0, -(d - radius * 2) / 2 - radius);
        return geo;
      }

      // Apply a fillet (rounded edges) to the selected part.
      // Replaces the geometry with a rounded-corner box of equivalent dimensions.
      // Works for both BoxGeometry (uses .parameters) and any mesh whose
      // bounding box is roughly box-shaped (uses bbox extents).
      function applyFillet(name, radius = 0.06) {
        const p = partsRegistry.get(name);
        if (!p?.object) return { ok: false, error: `no part "${name}"` };

        // Find the primary mesh — for groups, fillet the largest mesh child
        let target = null;
        if (p.object.isMesh) {
          target = p.object;
        } else {
          let bestVol = 0;
          p.object.traverse(o => {
            if (!o.isMesh || !o.geometry) return;
            // Compute bbox volume to pick the biggest piece
            if (!o.geometry.boundingBox) o.geometry.computeBoundingBox();
            const bb = o.geometry.boundingBox;
            if (!bb) return;
            const v = (bb.max.x - bb.min.x) * (bb.max.y - bb.min.y) * (bb.max.z - bb.min.z);
            if (v > bestVol) { bestVol = v; target = o; }
          });
        }
        if (!target || !target.geometry) return { ok: false, error: `${name} has no fillettable mesh` };

        // Read dimensions from .parameters if available (true BoxGeometry),
        // otherwise from the geometry's bounding box (works for baked / custom geos)
        let w, h, d;
        const params = target.geometry.parameters;
        if (params && params.width !== undefined) {
          w = params.width;
          h = params.height;
          d = params.depth;
        } else {
          if (!target.geometry.boundingBox) target.geometry.computeBoundingBox();
          const bb = target.geometry.boundingBox;
          if (!bb) return { ok: false, error: `${name}: cannot determine dimensions` };
          w = bb.max.x - bb.min.x;
          h = bb.max.y - bb.min.y;
          d = bb.max.z - bb.min.z;
        }
        if (w <= 0 || h <= 0 || d <= 0) {
          return { ok: false, error: `${name} has zero-volume bounds — can't fillet` };
        }
        // Cap radius so it can't exceed half of the smallest dimension
        const safeRadius = Math.min(radius, w / 2 - 0.005, h / 2 - 0.005, d / 2 - 0.005);
        if (safeRadius < 0.01) {
          return { ok: false, error: `${name} too thin to fillet at ${radius * 1000 | 0}mm — try a smaller radius` };
        }

        const newGeo = buildRoundedBoxGeometry(w, h, d, safeRadius, 5);
        // Preserve the geometry's center: the rounded-box geometry is centered
        // at origin, so if the original mesh was OFFSET (e.g. fuselage at y=0
        // but built from a box centered at y=H/2), we need to either translate
        // the new geometry or move the mesh. Easiest: translate new geometry
        // to the original geometry's centroid.
        if (!target.geometry.boundingBox) target.geometry.computeBoundingBox();
        const oldCenter = new THREE.Vector3();
        target.geometry.boundingBox.getCenter(oldCenter);
        if (oldCenter.lengthSq() > 1e-6) {
          newGeo.translate(oldCenter.x, oldCenter.y, oldCenter.z);
        }
        target.geometry.dispose?.();
        target.geometry = newGeo;
        target.userData.appliedFeatures = target.userData.appliedFeatures || [];
        target.userData.appliedFeatures.push({ type: 'fillet', radius: safeRadius });
        if (selectionBoxHelper && selectedPartName === name) selectionBoxHelper.update();
        refreshGeometryStats();
        return { ok: true, radius: safeRadius };
      }

      // Build a chamfered (beveled-edge) box geometry
      function buildChamferedBoxGeometry(w, h, d, distance) {
        distance = Math.min(distance, w / 2 - 0.001, h / 2 - 0.001, d / 2 - 0.001);
        if (distance <= 0.005) return new THREE.BoxGeometry(w, h, d);
        const shape = new THREE.Shape();
        const hw = w / 2, hh = h / 2, c = distance;
        // Octagonal cross-section (chamfered rectangle)
        shape.moveTo(-hw + c, -hh);
        shape.lineTo(hw - c, -hh);
        shape.lineTo(hw, -hh + c);
        shape.lineTo(hw, hh - c);
        shape.lineTo(hw - c, hh);
        shape.lineTo(-hw + c, hh);
        shape.lineTo(-hw, hh - c);
        shape.lineTo(-hw, -hh + c);
        shape.closePath();
        const geo = new THREE.ExtrudeGeometry(shape, {
          depth: d - distance * 2,
          bevelEnabled: true,
          bevelThickness: distance,
          bevelSize: distance,
          bevelSegments: 1,         // hard bevel — chamfer not fillet
          curveSegments: 1
        });
        geo.translate(0, 0, -(d - distance * 2) / 2 - distance);
        return geo;
      }

      // Apply chamfer (beveled edges) to the selected part
      function applyChamfer(name, distance = 0.05) {
        const p = partsRegistry.get(name);
        if (!p?.object) return { ok: false, error: `no part "${name}"` };
        let target = null;
        if (p.object.isMesh) target = p.object;
        else {
          let bestVol = 0;
          p.object.traverse(o => {
            if (!o.isMesh || !o.geometry) return;
            if (!o.geometry.boundingBox) o.geometry.computeBoundingBox();
            const bb = o.geometry.boundingBox;
            if (!bb) return;
            const v = (bb.max.x - bb.min.x) * (bb.max.y - bb.min.y) * (bb.max.z - bb.min.z);
            if (v > bestVol) { bestVol = v; target = o; }
          });
        }
        if (!target?.geometry) return { ok: false, error: `${name} has no chamferable mesh` };

        // Same dimension-finding as fillet: prefer .parameters, fall back to bbox
        let w, h, d;
        const params = target.geometry.parameters;
        if (params && params.width !== undefined) {
          w = params.width; h = params.height; d = params.depth;
        } else {
          if (!target.geometry.boundingBox) target.geometry.computeBoundingBox();
          const bb = target.geometry.boundingBox;
          if (!bb) return { ok: false, error: `${name}: cannot determine dimensions` };
          w = bb.max.x - bb.min.x;
          h = bb.max.y - bb.min.y;
          d = bb.max.z - bb.min.z;
        }
        if (w <= 0 || h <= 0 || d <= 0) {
          return { ok: false, error: `${name} has zero-volume bounds — can't chamfer` };
        }
        const safeDist = Math.min(distance, w / 2 - 0.005, h / 2 - 0.005, d / 2 - 0.005);
        if (safeDist < 0.005) {
          return { ok: false, error: `${name} too thin to chamfer at ${distance * 1000 | 0}mm` };
        }

        const newGeo = buildChamferedBoxGeometry(w, h, d, safeDist);
        if (!target.geometry.boundingBox) target.geometry.computeBoundingBox();
        const oldCenter = new THREE.Vector3();
        target.geometry.boundingBox.getCenter(oldCenter);
        if (oldCenter.lengthSq() > 1e-6) {
          newGeo.translate(oldCenter.x, oldCenter.y, oldCenter.z);
        }
        target.geometry.dispose?.();
        target.geometry = newGeo;
        target.userData.appliedFeatures = target.userData.appliedFeatures || [];
        target.userData.appliedFeatures.push({ type: 'chamfer', distance: safeDist });
        if (selectionBoxHelper && selectedPartName === name) selectionBoxHelper.update();
        refreshGeometryStats();
        return { ok: true, distance: safeDist };
      }

      // Shell — hollow out a part by replacing its solid material with a thin-walled appearance.
      // (True shell is a CSG operation; we approximate by switching material to wireframe-edged
      // semi-transparent and reducing the rendered "thickness" visually.)
      function applyShell(name, thickness = 0.05) {
        const p = partsRegistry.get(name);
        if (!p?.object) return { ok: false, error: `no part "${name}"` };
        const shellMat = new THREE.MeshStandardMaterial({
          color: 0xc0c8d4, roughness: 0.4, metalness: 0.6,
          transparent: true, opacity: 0.45,
          side: THREE.DoubleSide
        });
        // Add an edge wireframe overlay so the hollowed look reads
        let count = 0;
        p.object.traverse(o => {
          if (o.isMesh) {
            o.material = shellMat;
            // add edge lines
            const edges = new THREE.LineSegments(
              new THREE.EdgesGeometry(o.geometry, 30),
              new THREE.LineBasicMaterial({ color: 0x00E5FF, transparent: true, opacity: 0.6 })
            );
            o.add(edges);
            count++;
          }
        });
        p.object.userData.appliedFeatures = p.object.userData.appliedFeatures || [];
        p.object.userData.appliedFeatures.push({ type: 'shell', thickness });
        refreshGeometryStats();
        return { ok: true, thickness, count };
      }

      // Linear pattern — clone a part N times along an axis at a fixed spacing
      function applyLinearPattern(name, count = 3, spacing = 0.5, axis = 'x') {
        const p = partsRegistry.get(name);
        if (!p?.object) return { ok: false, error: `no part "${name}"` };
        if (count < 2) return { ok: false, error: 'pattern count must be at least 2' };
        const created = [];
        for (let i = 1; i < count; i++) {  // i=0 is the original
          const cloned = p.object.clone(true);
          // Recurse to give every descendant a fresh material reference if needed
          cloned.position[axis] += spacing * i;
          const newName = uniqueName(name.replace(/_\d+$/, '') + '_pat');
          cloned.userData = { ...p.object.userData, partName: newName };
          taxi.add(cloned);
          registerPart(newName, { ...p, object: cloned });
          created.push(newName);
        }
        refreshGeometryStats();
        return { ok: true, count, created };
      }

      // Circular pattern — clone N times around an axis (default Y/vertical)
      function applyCircularPattern(name, count = 4, axis = 'y') {
        const p = partsRegistry.get(name);
        if (!p?.object) return { ok: false, error: `no part "${name}"` };
        if (count < 2) return { ok: false, error: 'pattern count must be at least 2' };
        const origin = p.object.position.clone();
        const angleStep = (Math.PI * 2) / count;
        const created = [];
        for (let i = 1; i < count; i++) {
          const cloned = p.object.clone(true);
          const angle = angleStep * i;
          // Rotate position around the chosen axis
          if (axis === 'y') {
            const x = origin.x * Math.cos(angle) - origin.z * Math.sin(angle);
            const z = origin.x * Math.sin(angle) + origin.z * Math.cos(angle);
            cloned.position.set(x, origin.y, z);
            cloned.rotation.y = (p.object.rotation.y || 0) + angle;
          } else if (axis === 'x') {
            const y = origin.y * Math.cos(angle) - origin.z * Math.sin(angle);
            const z = origin.y * Math.sin(angle) + origin.z * Math.cos(angle);
            cloned.position.set(origin.x, y, z);
            cloned.rotation.x = (p.object.rotation.x || 0) + angle;
          } else {
            const x = origin.x * Math.cos(angle) - origin.y * Math.sin(angle);
            const y = origin.x * Math.sin(angle) + origin.y * Math.cos(angle);
            cloned.position.set(x, y, origin.z);
            cloned.rotation.z = (p.object.rotation.z || 0) + angle;
          }
          const newName = uniqueName(name.replace(/_\d+$/, '') + '_circ');
          cloned.userData = { ...p.object.userData, partName: newName };
          taxi.add(cloned);
          registerPart(newName, { ...p, object: cloned });
          created.push(newName);
        }
        refreshGeometryStats();
        return { ok: true, count, created };
      }

      // Suppress / unsuppress — temporarily hide a part without deleting it.
      // SOLIDWORKS lets you suppress features in the FeatureManager tree to view a model
      // without them. We do the same by toggling visibility and tracking state.
      function toggleSuppress(name) {
        const p = partsRegistry.get(name);
        if (!p?.object) return { ok: false, error: `no part "${name}"` };
        const newSuppressed = !p.object.userData.suppressed;
        p.object.visible = !newSuppressed;
        p.object.userData.suppressed = newSuppressed;
        refreshGeometryStats();
        return { ok: true, suppressed: newSuppressed };
      }

      // Extruded cut — places a deep-cutout marker through the selected part.
      // Real CSG would carve the geometry; we render a deep dark recess that visually
      // reads as a through-hole when placed on a surface.
      function applyExtrudedCut(name, depth = 0.18) {
        const p = partsRegistry.get(name);
        if (!p?.object) return { ok: false, error: `no part "${name}"` };
        const grp = new THREE.Group();
        // Outer frame: thin amber outline
        const frame = new THREE.Mesh(
          new THREE.BoxGeometry(0.32, 0.32, 0.012),
          libMaterials.cutoutEdge
        );
        // Deep dark interior — extruded inward
        const inner = new THREE.Mesh(
          new THREE.BoxGeometry(0.28, 0.28, depth),
          libMaterials.cutoutDark
        );
        inner.position.z = -depth / 2 - 0.003;
        grp.add(frame, inner);
        // Position relative to the selected part — offset along its local +Z by half its size
        const box = new THREE.Box3().setFromObject(p.object);
        const size = new THREE.Vector3(); box.getSize(size);
        const center = new THREE.Vector3(); box.getCenter(center);
        grp.position.copy(center);
        grp.position.z += size.z / 2 + 0.005;
        return _placeAndSelect(grp, 'cut_extrude', 'extruded-cut', 'feature');
      }

      // =====================================================================
      // SYMMETRY / EQUALIZE / AUTO-BALANCE
      // =====================================================================

      // Make the design left/right symmetric across Z=0.
      // For every part not on the centerline, ensure there's a mirrored counterpart at -Z.
      // If a counterpart already exists nearby, snap their X/Y to match (averaged) and fix Z to be exact mirror.
      // Skips parts already at the centerline (|z| < 0.05) and registry items without an object.
      function applySymmetry() {
        const SYM_THRESHOLD = 0.05;     // parts within this Z of centerline are "centered" — leave them
        const PAIR_TOLERANCE = 0.6;     // parts within this Z-distance of each other's mirror are "pairs" — snap them
        const created = [];
        const snapped = [];

        // Collect parts grouped by side (positive Z = right, negative Z = left)
        const allParts = [];
        for (const [name, info] of partsRegistry) {
          if (!info.object) continue;
          // Skip already-mirrored support pieces and synthetic features
          if (info.kind === 'support' && /crossbeam/.test(name)) continue;
          allParts.push({ name, info, z: info.object.position.z });
        }

        const matched = new Set();
        for (let i = 0; i < allParts.length; i++) {
          if (matched.has(i)) continue;
          const a = allParts[i];
          // Skip centered parts
          if (Math.abs(a.z) < SYM_THRESHOLD) {
            // Force exactly to centerline if "almost"
            a.info.object.position.z = 0;
            continue;
          }
          // Look for a matching part of the same kind on the other side
          let bestMatchIdx = -1, bestDiff = Infinity;
          for (let j = i + 1; j < allParts.length; j++) {
            if (matched.has(j)) continue;
            const b = allParts[j];
            if (b.info.kind !== a.info.kind) continue;
            // Both must be on opposite sides
            if (Math.sign(a.z) === Math.sign(b.z)) continue;
            // How close is b to being a's mirror?
            const targetZ = -a.z;
            const diff = Math.abs(b.z - targetZ);
            if (diff < PAIR_TOLERANCE && diff < bestDiff) {
              bestDiff = diff;
              bestMatchIdx = j;
            }
          }
          if (bestMatchIdx >= 0) {
            // Found a pair — snap them to perfect mirror positions, average their X/Y
            const b = allParts[bestMatchIdx];
            const avgX = (a.info.object.position.x + b.info.object.position.x) / 2;
            const avgY = (a.info.object.position.y + b.info.object.position.y) / 2;
            const avgZmag = (Math.abs(a.z) + Math.abs(b.z)) / 2;
            a.info.object.position.set(avgX, avgY, Math.sign(a.z) * avgZmag);
            b.info.object.position.set(avgX, avgY, Math.sign(b.z) * avgZmag);
            // Also equalize their scales to the average
            const sa = a.info.object.scale, sb = b.info.object.scale;
            const avgScale = new THREE.Vector3(
              (sa.x + sb.x) / 2, (sa.y + sb.y) / 2, (sa.z + sb.z) / 2
            );
            a.info.object.scale.copy(avgScale);
            b.info.object.scale.copy(avgScale);
            matched.add(i); matched.add(bestMatchIdx);
            snapped.push(a.name, b.name);
          } else {
            // No pair found — create a mirrored clone on the other side
            const mirroredName = mirrorByName(a.name, 'z');
            if (mirroredName) {
              created.push(mirroredName);
              matched.add(i);
            }
          }
        }
        if (selectionBoxHelper && selectedPartName) selectionBoxHelper.update();
        refreshGeometryStats();
        return { snapped, created };
      }

      // Equalize dimensions: for each kind of part (rotor, boom, wing, etc.),
      // snap all instances to the average size of that group.
      function applyEqualizeDimensions() {
        const groups = {};   // kind -> [parts]
        for (const [name, info] of partsRegistry) {
          if (!info.object) continue;
          if (info.kind === 'support' || info.kind === 'feature') continue; // skip helpers
          (groups[info.kind] = groups[info.kind] || []).push({ name, info });
        }
        const equalized = [];
        for (const [kind, list] of Object.entries(groups)) {
          if (list.length < 2) continue;  // need at least 2 to equalize
          // Average bounding-box size across the group, in world units
          const sizes = list.map(({ info }) => {
            const box = new THREE.Box3().setFromObject(info.object);
            const sz = new THREE.Vector3(); box.getSize(sz);
            return sz;
          });
          const avg = new THREE.Vector3(0, 0, 0);
          sizes.forEach(s => avg.add(s));
          avg.divideScalar(sizes.length);
          // Snap each part's scale to make its current size match the average
          list.forEach(({ name, info }, idx) => {
            const cur = sizes[idx];
            if (cur.x < 0.001 || cur.y < 0.001 || cur.z < 0.001) return;
            // Compute scale ratio to apply on top of current scale
            const ratio = new THREE.Vector3(avg.x / cur.x, avg.y / cur.y, avg.z / cur.z);
            info.object.scale.x *= ratio.x;
            info.object.scale.y *= ratio.y;
            info.object.scale.z *= ratio.z;
            equalized.push(name);
          });
        }
        if (selectionBoxHelper && selectedPartName) selectionBoxHelper.update();
        refreshGeometryStats();
        return { equalized, kinds: Object.keys(groups) };
      }

      // ============================================================================
      // MONOLITHIC ARCHETYPE BUILDERS
      // ============================================================================
      // These build a complete, coordinated aircraft as ONE coherent geometry,
      // with hand-tuned proportions matching real reference vehicles. Unlike the
      // part-by-part assembly path, every component is positioned by a single
      // function so geometry stays consistent. Colors flow through materials.primary
      // and materials.accent so post-build paint commands still work.

      // Wipes the entire vehicle and clears the parts registry. Used at the start
      // of every monolithic build.
      function clearAllParts() {
        for (const name of Array.from(partsRegistry.keys())) {
          disposeRegistered(name);
        }
        // Also remove any orphaned children that didn't go through registerPart
        while (taxi.children.length) {
          const c = taxi.children[0];
          taxi.remove(c);
        }
      }

      // ---------------------------------------------------------------------------
      // Generic eVTOL builder — drives ALL "build me an aircraft" requests.
      // Knowledge baked in from real-world references:
      //   - Archer Midnight: 12 tilt 6 (6 forward 5-blade, 6 rear 2-blade), high wing, V-tail
      //   - Joby S4:        6 wing-tip tilt-rotors, V-tail
      //   - Volocopter:     halo of 18 small rotors, no wing
      //   - EHang 216:      X-frame with 8 rotors at corners, no wing
      //   - STOL hybrid:    fixed wing with prop, conventional tail (AIAA spec)
      // Spec controls every degree of freedom; parser fills it from description.
      // Geometry stays coordinated because a SINGLE function owns all proportions.
      //
      // Local axes: nose at -X, wing along Z, up = +Y (matches dispatch heading).
      // 1 unit ≈ 1 meter.
      // ---------------------------------------------------------------------------
      function buildEVTOL(spec = {}) {
        clearAllParts();
        const s = {
          paxCount:       Math.max(1, Math.min(spec.paxCount || 4, 6)),
          fuselageLen:    spec.fuselageLen    || 5.6,
          fuselageRadius: spec.fuselageRadius || 0.7,
          fuselageFlat:   spec.fuselageFlat   || 0.85,
          canopy:         spec.canopy         || 'bubble',
          wingPresent:    spec.wingPresent !== false,
          wingSpan:       spec.wingSpan       || 12.0,
          wingChord:      spec.wingChord      || 1.4,
          fwdRotors:      spec.fwdRotors ?? 6,
          rearRotors:     spec.rearRotors ?? 6,
          fwdBlades:      spec.fwdBlades      || 5,
          rearBlades:     spec.rearBlades     || 2,
          rotorRadius:    spec.rotorRadius    || 0.55,
          tail:           ('tail' in spec) ? spec.tail : 'v',
          gear:           spec.gear           || 'tricycle',
          rotorPlacement: spec.rotorPlacement || 'wing'
        };
        // Wing sits clearly ABOVE the fuselage with a visible gap, so the body
        // remains a distinct silhouette from any camera angle. Old layout had wing
        // height = fuselage top, which made them merge into a single blob.
        const wingY = 2.45;             // was 2.05 (fuselage top is ~2.04)
        const tiltY = wingY + 0.02;

        // ===== 1. FUSELAGE =====
        const fusGeom = new THREE.CapsuleGeometry(s.fuselageRadius, s.fuselageLen - 2*s.fuselageRadius, 12, 24);
        fusGeom.rotateZ(Math.PI / 2);
        const fuselage = new THREE.Mesh(fusGeom, materials.primary);
        fuselage.scale.y = s.fuselageFlat;
        fuselage.position.set(0, 1.45, 0);
        fuselage.castShadow = true; fuselage.receiveShadow = true;
        taxi.add(fuselage);
        registerPart('evtol_fuselage', { object: fuselage, type: 'capsule', kind: 'fuselage',
          dims: { l: s.fuselageLen, w: s.fuselageRadius * 2, h: s.fuselageRadius * 2 * s.fuselageFlat } });

        // ===== 2. NOSE =====
        const noseGeom = new THREE.ConeGeometry(s.fuselageRadius * 0.95, 0.9, 24);
        noseGeom.rotateZ(Math.PI / 2);
        const nose = new THREE.Mesh(noseGeom, materials.primary);
        nose.scale.y = s.fuselageFlat;
        nose.position.set(-s.fuselageLen/2 - 0.35, 1.45, 0);
        nose.castShadow = true;
        taxi.add(nose);
        registerPart('evtol_nose', { object: nose, type: 'cone', kind: 'nose',
          dims: { l: 0.9, w: s.fuselageRadius * 1.9, h: s.fuselageRadius * 1.9 * s.fuselageFlat } });

        // ===== 3. CANOPY =====
        if (s.canopy === 'bubble') {
          const canopyGeom = new THREE.SphereGeometry(0.78, 24, 16, 0, Math.PI * 2, 0, Math.PI / 2);
          canopyGeom.scale(1.55, 0.7, 1.0);
          const canopy = new THREE.Mesh(canopyGeom, materials.glass);
          canopy.position.set(-s.fuselageLen/4, 1.45 + s.fuselageRadius * s.fuselageFlat * 0.55, 0);
          taxi.add(canopy);
          registerPart('evtol_canopy', { object: canopy, type: 'sphere', kind: 'cockpit',
            dims: { l: 1.6, w: 1.55, h: 0.55 } });
        }

        // ===== 4. WING (optional, elevated with visible pylon to fuselage) =====
        if (s.wingPresent) {
          const wing = new THREE.Mesh(new THREE.BoxGeometry(s.wingChord, 0.16, s.wingSpan), materials.primary);
          wing.position.set(0.1, wingY, 0);
          wing.castShadow = true; wing.receiveShadow = true;
          taxi.add(wing);
          registerPart('evtol_wing', { object: wing, type: 'box', kind: 'wing',
            dims: { l: s.wingChord, w: s.wingSpan, h: 0.16 } });
          // Wing-mount pylon — a single tapered pylon connecting fuselage top to
          // wing underside. Without this the wing looks like it's floating.
          const fusTopY = 1.45 + s.fuselageRadius * s.fuselageFlat;
          const pylonHeight = wingY - fusTopY;
          if (pylonHeight > 0.05) {
            const pylonGeom = new THREE.BoxGeometry(s.fuselageRadius * 1.6, pylonHeight, s.fuselageRadius * 1.5);
            const pylon = new THREE.Mesh(pylonGeom, materials.primary);
            pylon.position.set(0.1, fusTopY + pylonHeight / 2, 0);
            pylon.castShadow = true; pylon.receiveShadow = true;
            taxi.add(pylon);
            registerPart('evtol_wing_pylon', { object: pylon, type: 'box', kind: 'support',
              dims: { l: s.fuselageRadius * 1.6, w: s.fuselageRadius * 1.5, h: pylonHeight } });
          }
        }

        // ===== 5. ROTORS — placement-dependent =====
        // Each rotor has a spinner cone + hub + blades so it reads as a propeller,
        // not a flat disc. Booms use the dark gear material (recede visually) so
        // the white airframe stays the dominant silhouette.
        const makeRotor = (radius, numBlades) => {
          const grp = new THREE.Group();
          // Spinner cone — points forward, gives a clear propeller silhouette
          const spinnerGeom = new THREE.ConeGeometry(0.08, 0.18, 12);
          spinnerGeom.rotateX(-Math.PI / 2);
          const spinner = new THREE.Mesh(spinnerGeom, materials.gear);
          spinner.position.y = 0.05;
          grp.add(spinner);
          // Hub
          grp.add(new THREE.Mesh(new THREE.SphereGeometry(0.08, 12, 8), materials.gear));
          // Blades
          const bladesGroup = new THREE.Group();
          for (let b = 0; b < numBlades; b++) {
            const bs = new THREE.Shape();
            bs.moveTo(0, -0.025); bs.lineTo(radius * 0.95, -0.018);
            bs.lineTo(radius, 0); bs.lineTo(radius * 0.95, 0.018);
            bs.lineTo(0, 0.025); bs.lineTo(0, -0.025);
            const blade = new THREE.Mesh(new THREE.ExtrudeGeometry(bs, { depth: 0.018, bevelEnabled: false }), materials.blade);
            blade.rotation.y = (b / numBlades) * Math.PI * 2;
            bladesGroup.add(blade);
          }
          grp.add(bladesGroup);
          return grp;
        };
        const computeZPositions = (count, span) => {
          if (count <= 0) return [];
          if (count === 1) return [0];
          const positions = [];
          const halfCount = Math.floor(count / 2);
          const step = span / (count + 1);
          for (let i = 0; i < halfCount; i++) {
            positions.push((i + 1) * step); positions.push(-(i + 1) * step);
          }
          if (count % 2 === 1) positions.push(0);
          return positions;
        };

        if (s.rotorPlacement === 'wing' && s.wingPresent) {
          // Distributed on wing leading + trailing edges (Archer Midnight pattern)
          const fwdZs = computeZPositions(s.fwdRotors, s.wingSpan * 0.95);
          const rearZs = computeZPositions(s.rearRotors, s.wingSpan * 0.95);
          const tiltX = -s.wingChord/2 - 0.1;
          const fixedX = s.wingChord/2 + 0.1;
          fwdZs.forEach((z, i) => {
            const boomGeom = new THREE.CylinderGeometry(0.045, 0.045, 0.85, 10);
            boomGeom.rotateZ(Math.PI / 2);
            const boom = new THREE.Mesh(boomGeom, materials.gear);
            boom.position.set(tiltX - 0.025, tiltY, z);
            taxi.add(boom);
            registerPart(`evtol_fwd_boom_${i}`, { object: boom, type: 'cylinder', kind: 'boom', dims: { l: 0.85, w: 0.14, h: 0.14 } });
            const nacGeom = new THREE.CylinderGeometry(0.16, 0.13, 0.5, 16);
            nacGeom.rotateZ(Math.PI / 2);
            const nac = new THREE.Mesh(nacGeom, materials.primary);
            nac.position.set(tiltX - 0.75, tiltY, z);
            taxi.add(nac);
            registerPart(`evtol_fwd_nacelle_${i}`, { object: nac, type: 'cylinder', kind: 'feature', dims: { l: 0.5, w: 0.32, h: 0.32 } });
            const rotor = makeRotor(s.rotorRadius, s.fwdBlades);
            rotor.position.set(tiltX - 1.0, tiltY, z);
            rotor.rotation.z = -0.18;
            taxi.add(rotor);
            registerPart(`evtol_fwd_rotor_${i}`, { object: rotor, type: 'rotor', kind: 'rotor', dims: { l: s.rotorRadius * 2, w: s.rotorRadius * 2, h: 0.12 } });
          });
          rearZs.forEach((z, i) => {
            const boomGeom = new THREE.CylinderGeometry(0.045, 0.045, 0.85, 10);
            boomGeom.rotateZ(Math.PI / 2);
            const boom = new THREE.Mesh(boomGeom, materials.gear);
            boom.position.set(fixedX + 0.025, tiltY, z);
            taxi.add(boom);
            registerPart(`evtol_rear_boom_${i}`, { object: boom, type: 'cylinder', kind: 'boom', dims: { l: 0.85, w: 0.14, h: 0.14 } });
            const nac = new THREE.Mesh(new THREE.CylinderGeometry(0.13, 0.15, 0.32, 16), materials.primary);
            nac.position.set(fixedX + 0.45, tiltY + 0.18, z);
            taxi.add(nac);
            registerPart(`evtol_rear_nacelle_${i}`, { object: nac, type: 'cylinder', kind: 'feature', dims: { l: 0.32, w: 0.3, h: 0.32 } });
            const rotor = makeRotor(s.rotorRadius * 0.95, s.rearBlades);
            rotor.position.set(fixedX + 0.45, tiltY + 0.36, z);
            taxi.add(rotor);
            registerPart(`evtol_rear_rotor_${i}`, { object: rotor, type: 'rotor', kind: 'rotor', dims: { l: s.rotorRadius * 2, w: s.rotorRadius * 2, h: 0.12 } });
          });
        } else if (s.rotorPlacement === 'wing_tips' && s.wingPresent) {
          // Joby S4 pattern: tilting rotors at wing/tail-boom tips
          const total = s.fwdRotors + s.rearRotors;
          const tipPositions = [
            { x: -s.wingChord/2 - 0.3, z:  s.wingSpan/2 - 0.2 },
            { x: -s.wingChord/2 - 0.3, z: -s.wingSpan/2 + 0.2 },
            { x: -s.wingChord/2 - 0.3, z:  s.wingSpan/4 },
            { x: -s.wingChord/2 - 0.3, z: -s.wingSpan/4 },
            { x:  s.wingChord/2 + 0.3, z:  s.wingSpan/3 },
            { x:  s.wingChord/2 + 0.3, z: -s.wingSpan/3 }
          ].slice(0, total);
          tipPositions.forEach((p, i) => {
            const nacGeom = new THREE.CylinderGeometry(0.16, 0.13, 0.5, 16);
            nacGeom.rotateZ(Math.PI / 2);
            const nac = new THREE.Mesh(nacGeom, materials.primary);
            nac.position.set(p.x - 0.15, tiltY, p.z);
            taxi.add(nac);
            registerPart(`evtol_tip_nacelle_${i}`, { object: nac, type: 'cylinder', kind: 'feature', dims: { l: 0.5, w: 0.32, h: 0.32 } });
            const rotor = makeRotor(s.rotorRadius, s.fwdBlades);
            rotor.position.set(p.x - 0.4, tiltY, p.z);
            rotor.rotation.z = -0.18;
            taxi.add(rotor);
            registerPart(`evtol_tip_rotor_${i}`, { object: rotor, type: 'rotor', kind: 'rotor', dims: { l: s.rotorRadius * 2, w: s.rotorRadius * 2, h: 0.12 } });
          });
        } else if (s.rotorPlacement === 'halo') {
          // Volocopter-style: ring of small rotors above fuselage.
          // Checked BEFORE the arms branch because the arms branch
          // also catches !wingPresent, which would otherwise eat halo.
          const total = Math.max(s.fwdRotors + s.rearRotors, 8);
          const haloR = 1.6;
          const ring = new THREE.Mesh(new THREE.TorusGeometry(haloR, 0.06, 10, 36), materials.accent);
          ring.position.set(0, tiltY + 0.3, 0);
          ring.rotation.x = Math.PI / 2;
          taxi.add(ring);
          registerPart('evtol_halo_ring', { object: ring, type: 'torus', kind: 'support', dims: { l: haloR * 2, w: haloR * 2, h: 0.12 } });
          for (let i = 0; i < total; i++) {
            const ang = (i / total) * Math.PI * 2;
            const rotor = makeRotor(s.rotorRadius * 0.7, 2);
            rotor.position.set(Math.cos(ang) * haloR, tiltY + 0.4, Math.sin(ang) * haloR);
            taxi.add(rotor);
            registerPart(`evtol_halo_rotor_${i}`, { object: rotor, type: 'rotor', kind: 'rotor', dims: { l: s.rotorRadius * 1.4, w: s.rotorRadius * 1.4, h: 0.1 } });
          }
        } else if (s.rotorPlacement === 'arms' || !s.wingPresent) {
          // Drone-style: rotors on arms radiating from fuselage.
          // User: "parts can't be floating around. need to be
          // connected." Previously the arms sat at y=2.37 floating
          // 0.3 units above the fuselage with no visible connection.
          // Now: a central HUB mesh sits ON the fuselage top at
          // y=2.05, arms radiate horizontally FROM the hub, and
          // each arm has a vertical pylon strut anchoring it to the
          // fuselage. No more floating.
          const total = Math.max(s.fwdRotors + s.rearRotors, 3);
          const armReach = 1.8;
          const fuselageTop = 1.45 + s.fuselageRadius * s.fuselageFlat;     // ~2.05 default
          const armY = fuselageTop + 0.18;     // arm centerline just above fuselage top
          // Central hub — a chunky cylinder sitting on the fuselage,
          // visually "owns" the arm cluster
          const hubGeom = new THREE.CylinderGeometry(0.28, 0.34, 0.32, 16);
          const hub = new THREE.Mesh(hubGeom, materials.gear);
          hub.position.set(0, fuselageTop + 0.10, 0);
          hub.castShadow = true;
          taxi.add(hub);
          registerPart('evtol_arm_hub', {
            object: hub, type: 'cylinder', kind: 'hub',
            dims: { l: 0.56, w: 0.56, h: 0.32 },
          });
          for (let i = 0; i < total; i++) {
            const ang = (i / total) * Math.PI * 2 - Math.PI / 2;
            const ax = Math.cos(ang) * armReach;
            const az = Math.sin(ang) * armReach;
            // Arm — radiates horizontally from hub
            const armGeom = new THREE.CylinderGeometry(0.05, 0.05, armReach, 10);
            const arm = new THREE.Mesh(armGeom, materials.gear);
            arm.position.set(ax/2, armY, az/2);
            arm.lookAt(ax, armY, az);
            arm.rotateX(Math.PI / 2);
            arm.castShadow = true;
            taxi.add(arm);
            registerPart(`evtol_arm_${i}`, {
              object: arm, type: 'cylinder', kind: 'arm',
              dims: { l: armReach, w: 0.1, h: 0.1 },
            });
            // Rotor sits ON the arm tip (slightly above so blades clear)
            const rotor = makeRotor(s.rotorRadius, s.fwdBlades);
            rotor.position.set(ax, armY + 0.10, az);
            taxi.add(rotor);
            registerPart(`evtol_arm_rotor_${i}`, {
              object: rotor, type: 'rotor', kind: 'rotor',
              dims: { l: s.rotorRadius * 2, w: s.rotorRadius * 2, h: 0.12 },
            });
          }
        } else if (s.rotorPlacement === 'rail') {
          // Twin-boom RAIL: parallel longitudinal booms run along the
          // length of the fuselage with rotors mounted on vertical
          // posts at evenly-spaced points. Heavy-lift cargo platform
          // / skycrane / RAFT style. User: "AI team needs to know
          // how to build things like this."
          //
          // FLOATING PARTS RULE: every part anchors to the fuselage
          // top dynamically, NOT a fixed y. User: "the AI needs to
          // know that floating parts is not acceptable."
          const total = Math.max(s.fwdRotors + s.rearRotors, 6);
          const perSide = Math.ceil(total / 2);
          const fuselageTop = 1.45 + s.fuselageRadius * s.fuselageFlat;
          const railZ = 1.4;                      // boom outboard offset
          const railY = fuselageTop + 0.05;       // boom rides on the fuselage shoulder, NOT floating
          const railLength = s.fuselageLen * 1.05;
          for (let side = 0; side < 2; side++) {
            const sign = side === 0 ? 1 : -1;
            // Two lateral struts per side connect fuselage→boom. Strut
            // passes through the fuselage centerline so it visibly
            // emerges from the fuselage shoulder at z=±radius and
            // reaches the boom at z=±railZ.
            for (let strut = 0; strut < 2; strut++) {
              const strutX = strut === 0 ? -s.fuselageLen * 0.3 : s.fuselageLen * 0.3;
              const lat = new THREE.Mesh(
                new THREE.CylinderGeometry(0.08, 0.08, railZ * 2, 8), materials.gear);
              lat.position.set(strutX, railY, 0);
              lat.rotation.x = Math.PI / 2;
              lat.castShadow = true;
              taxi.add(lat);
              registerPart(`evtol_rail_strut_${side}_${strut}`, {
                object: lat, type: 'cylinder', kind: 'rail',
                dims: { l: railZ * 2, w: 0.16, h: 0.16 },
              });
            }
            // Long boom along X axis — sitting on the fuselage shoulder
            const boomGeom = new THREE.CylinderGeometry(0.12, 0.12, railLength, 12);
            boomGeom.rotateZ(Math.PI / 2);
            const boom = new THREE.Mesh(boomGeom, materials.accent);
            boom.position.set(0, railY, sign * railZ);
            boom.castShadow = true;
            taxi.add(boom);
            registerPart(`evtol_rail_boom_${side}`, {
              object: boom, type: 'cylinder', kind: 'rail',
              dims: { l: railLength, w: 0.24, h: 0.24 },
            });
            // Rotors on vertical posts, evenly spaced along the boom
            for (let i = 0; i < perSide; i++) {
              const t = perSide === 1 ? 0.5 : (i / (perSide - 1));
              const rx = -railLength * 0.45 + t * railLength * 0.9;
              // Vertical mounting post — sits ON the boom, NOT floating
              const post = new THREE.Mesh(
                new THREE.CylinderGeometry(0.05, 0.05, 0.3, 6), materials.gear);
              post.position.set(rx, railY + 0.15, sign * railZ);
              post.castShadow = true;
              taxi.add(post);
              registerPart(`evtol_rail_post_${side}_${i}`, {
                object: post, type: 'cylinder', kind: 'rail',
                dims: { l: 0.10, w: 0.10, h: 0.30 },
              });
              // Rotor on top of post — kind: 'rotor' so test flight spins it
              const rotor = makeRotor(s.rotorRadius, s.fwdBlades);
              rotor.position.set(rx, railY + 0.35, sign * railZ);
              taxi.add(rotor);
              registerPart(`evtol_rail_rotor_${side}_${i}`, {
                object: rotor, type: 'rotor', kind: 'rotor',
                dims: { l: s.rotorRadius * 2, w: s.rotorRadius * 2, h: 0.12 },
              });
            }
          }
        } else if (s.rotorPlacement === 'pusher') {
          // Fixed-wing PUSHER configuration — props at the rear,
          // axis along X. User: "make the taxi's fixed wing capable
          // with different kind of motors like push motors."
          // FLOATING PARTS RULE: every prop mounts to actual fuselage
          // or wing geometry, NOT hardcoded altitudes.
          const fuselageTop = 1.45 + s.fuselageRadius * s.fuselageFlat;
          const total = Math.max(s.fwdRotors, 1);
          const propRadius = s.rotorRadius * 1.2;
          if (total <= 1) {
            // Single rear pusher — behind fuselage, axis along X
            const mount = new THREE.Group();
            mount.position.set(s.fuselageLen / 2 + 0.45, 1.45, 0);
            mount.rotation.z = Math.PI / 2;     // tip prop disc to face aft
            const rotor = makeRotor(propRadius, s.fwdBlades);
            mount.add(rotor);
            taxi.add(mount);
            // The SPINNING object is the rotor (child); the mount is
            // just for orientation. Test flight iterates partsRegistry
            // entries with kind:'rotor' and spins them via rotation.y,
            // which after the mount's rotation.z=π/2 is world's X axis.
            registerPart('evtol_pusher_rotor_0', {
              object: rotor, type: 'rotor', kind: 'rotor',
              dims: { l: propRadius * 2, w: propRadius * 2, h: 0.15 },
            });
            // Pylon mounting the prop mount to fuselage — short cylinder
            // from fuselage rear to prop hub
            const pylon = new THREE.Mesh(
              new THREE.CylinderGeometry(0.10, 0.10, 0.45, 8), materials.gear);
            pylon.position.set(s.fuselageLen / 2 + 0.225, 1.45, 0);
            pylon.rotation.z = Math.PI / 2;     // horizontal pylon
            taxi.add(pylon);
            registerPart('evtol_pusher_pylon_0', {
              object: pylon, type: 'cylinder', kind: 'pusher',
              dims: { l: 0.45, w: 0.20, h: 0.20 },
            });
          } else {
            // Twin pushers — wing-mounted (one on each wing trailing edge)
            const span = s.wingSpan || 10.0;
            const wingY = 2.45;     // wing altitude (matches wing-mount in the wing branch)
            for (let side = 0; side < 2; side++) {
              const sign = side === 0 ? 1 : -1;
              const mount = new THREE.Group();
              mount.position.set(s.wingChord / 2 + 0.4, wingY, sign * span * 0.25);
              mount.rotation.z = Math.PI / 2;
              const rotor = makeRotor(propRadius * 0.85, s.fwdBlades);
              mount.add(rotor);
              taxi.add(mount);
              registerPart(`evtol_pusher_rotor_${side}`, {
                object: rotor, type: 'rotor', kind: 'rotor',
                dims: { l: propRadius * 1.7, w: propRadius * 1.7, h: 0.15 },
              });
              // Nacelle housing the engine — sits on the wing
              const nacelle = new THREE.Mesh(
                new THREE.CylinderGeometry(0.18, 0.18, 0.7, 12),
                materials.housing);
              nacelle.position.set(s.wingChord / 2, wingY, sign * span * 0.25);
              nacelle.rotation.z = Math.PI / 2;
              taxi.add(nacelle);
              registerPart(`evtol_pusher_nacelle_${side}`, {
                object: nacelle, type: 'cylinder', kind: 'pusher',
                dims: { l: 0.7, w: 0.36, h: 0.36 },
              });
            }
          }
        } else if (s.rotorPlacement === 'tractor') {
          // Fixed-wing TRACTOR configuration — single prop on nose,
          // pulls air forward. Cessna / turboprop layout.
          const propRadius = s.rotorRadius * 1.3;
          const noseTipX = -(s.fuselageLen / 2 + 0.55);     // just past nose cone
          const mount = new THREE.Group();
          mount.position.set(noseTipX, 1.45, 0);
          mount.rotation.z = Math.PI / 2;     // tip disc to face forward
          const rotor = makeRotor(propRadius, s.fwdBlades);
          mount.add(rotor);
          taxi.add(mount);
          registerPart('evtol_tractor_rotor_0', {
            object: rotor, type: 'rotor', kind: 'rotor',
            dims: { l: propRadius * 2, w: propRadius * 2, h: 0.15 },
          });
          // Spinner cone fairing — visible chrome cone behind the prop
          const spinner = new THREE.Mesh(
            new THREE.ConeGeometry(0.18, 0.30, 12),
            new THREE.MeshStandardMaterial({
              color: 0xcccccc, metalness: 0.85, roughness: 0.20,
            }));
          spinner.rotation.z = Math.PI / 2;     // cone points forward
          spinner.position.set(noseTipX - 0.10, 1.45, 0);
          taxi.add(spinner);
          registerPart('evtol_tractor_spinner_0', {
            object: spinner, type: 'cone', kind: 'tractor',
            dims: { l: 0.30, w: 0.36, h: 0.36 },
          });
        } else if (s.rotorPlacement === 'push_pull') {
          // Cessna Skymaster style — TRACTOR on nose + PUSHER on tail.
          // Both props share centerline of fuselage. Anchored at
          // y=1.45 (fuselage centerline), so no floating.
          const propRadius = s.rotorRadius * 1.2;
          // 1. Tractor on nose
          const noseTipX = -(s.fuselageLen / 2 + 0.55);
          const tractorMount = new THREE.Group();
          tractorMount.position.set(noseTipX, 1.45, 0);
          tractorMount.rotation.z = Math.PI / 2;
          const tractor = makeRotor(propRadius, s.fwdBlades);
          tractorMount.add(tractor);
          taxi.add(tractorMount);
          registerPart('evtol_tractor_rotor_0', {
            object: tractor, type: 'rotor', kind: 'rotor',
            dims: { l: propRadius * 2, w: propRadius * 2, h: 0.15 },
          });
          const tractorSpinner = new THREE.Mesh(
            new THREE.ConeGeometry(0.18, 0.30, 12),
            new THREE.MeshStandardMaterial({
              color: 0xcccccc, metalness: 0.85, roughness: 0.20,
            }));
          tractorSpinner.rotation.z = Math.PI / 2;
          tractorSpinner.position.set(noseTipX - 0.10, 1.45, 0);
          taxi.add(tractorSpinner);
          registerPart('evtol_tractor_spinner_0', {
            object: tractorSpinner, type: 'cone', kind: 'tractor',
            dims: { l: 0.30, w: 0.36, h: 0.36 },
          });
          // 2. Pusher on tail
          const pusherMount = new THREE.Group();
          pusherMount.position.set(s.fuselageLen / 2 + 0.45, 1.45, 0);
          pusherMount.rotation.z = Math.PI / 2;
          const pusher = makeRotor(propRadius, s.fwdBlades);
          pusherMount.add(pusher);
          taxi.add(pusherMount);
          registerPart('evtol_pusher_rotor_0', {
            object: pusher, type: 'rotor', kind: 'rotor',
            dims: { l: propRadius * 2, w: propRadius * 2, h: 0.15 },
          });
          const pusherPylon = new THREE.Mesh(
            new THREE.CylinderGeometry(0.10, 0.10, 0.45, 8), materials.gear);
          pusherPylon.position.set(s.fuselageLen / 2 + 0.225, 1.45, 0);
          pusherPylon.rotation.z = Math.PI / 2;
          taxi.add(pusherPylon);
          registerPart('evtol_pusher_pylon_0', {
            object: pusherPylon, type: 'cylinder', kind: 'pusher',
            dims: { l: 0.45, w: 0.20, h: 0.20 },
          });
        } else if (s.rotorPlacement === 'wing_tractor') {
          // Twin-engine turboprop — props mounted on wing leading edge
          // (each side). King Air / Caravan style. Wing is at y=2.45
          // (matches the wing branch elsewhere). Each prop has a nacelle.
          const propRadius = s.rotorRadius * 1.0;
          const wingY = 2.45;
          const span = s.wingSpan || 13.0;
          const wingChord = s.wingChord || 1.4;
          const propX = -wingChord / 2 - 0.45;     // forward of wing leading edge
          for (let side = 0; side < 2; side++) {
            const sign = side === 0 ? 1 : -1;
            const propZ = sign * span * 0.27;
            // Nacelle (engine pod) — visibly mounts the prop to the wing
            const nacelle = new THREE.Mesh(
              new THREE.CylinderGeometry(0.20, 0.18, 1.2, 12),
              materials.housing);
            nacelle.position.set(-wingChord / 4, wingY, propZ);
            nacelle.rotation.z = Math.PI / 2;     // along X axis
            taxi.add(nacelle);
            registerPart(`evtol_wprop_nacelle_${side}`, {
              object: nacelle, type: 'cylinder', kind: 'tractor',
              dims: { l: 1.2, w: 0.40, h: 0.40 },
            });
            // Prop in front of nacelle
            const mount = new THREE.Group();
            mount.position.set(propX, wingY, propZ);
            mount.rotation.z = Math.PI / 2;
            const rotor = makeRotor(propRadius, s.fwdBlades);
            mount.add(rotor);
            taxi.add(mount);
            registerPart(`evtol_wprop_rotor_${side}`, {
              object: rotor, type: 'rotor', kind: 'rotor',
              dims: { l: propRadius * 2, w: propRadius * 2, h: 0.15 },
            });
            // Chrome spinner cone
            const spinner = new THREE.Mesh(
              new THREE.ConeGeometry(0.15, 0.24, 12),
              new THREE.MeshStandardMaterial({
                color: 0xcccccc, metalness: 0.85, roughness: 0.20,
              }));
            spinner.rotation.z = Math.PI / 2;
            spinner.position.set(propX - 0.08, wingY, propZ);
            taxi.add(spinner);
            registerPart(`evtol_wprop_spinner_${side}`, {
              object: spinner, type: 'cone', kind: 'tractor',
              dims: { l: 0.24, w: 0.30, h: 0.30 },
            });
          }
        }

        // ===== 6. TAIL =====
        const tailX = s.fuselageLen/2 + 0.4;
        if (s.tail === 'v') {
          const finLen = 1.6, finChord = 0.65, finThick = 0.07, tailAngle = 0.55;
          for (let side = 0; side < 2; side++) {
            const sign = side === 0 ? 1 : -1;
            const fin = new THREE.Mesh(new THREE.BoxGeometry(finChord, finLen, finThick), materials.primary);
            fin.position.set(tailX, 1.45 + Math.cos(tailAngle) * finLen / 2 - 0.05, sign * Math.sin(tailAngle) * finLen / 2);
            fin.rotation.x = sign * tailAngle;
            fin.castShadow = true;
            taxi.add(fin);
            registerPart(`evtol_vtail_${side}`, { object: fin, type: 'box', kind: 'tail', dims: { l: finChord, w: finThick, h: finLen } });
          }
        } else if (s.tail === 't') {
          const vfin = new THREE.Mesh(new THREE.BoxGeometry(0.7, 1.6, 0.08), materials.primary);
          vfin.position.set(tailX, 2.25, 0);
          taxi.add(vfin);
          registerPart('evtol_t_vfin', { object: vfin, type: 'box', kind: 'tail', dims: { l: 0.7, w: 0.08, h: 1.6 } });
          const hstab = new THREE.Mesh(new THREE.BoxGeometry(0.55, 0.08, 2.2), materials.primary);
          hstab.position.set(tailX, 3.0, 0);
          taxi.add(hstab);
          registerPart('evtol_t_hstab', { object: hstab, type: 'box', kind: 'tail', dims: { l: 0.55, w: 2.2, h: 0.08 } });
        } else if (s.tail === 'conv') {
          const vfin = new THREE.Mesh(new THREE.BoxGeometry(0.7, 1.4, 0.08), materials.primary);
          vfin.position.set(tailX, 2.15, 0);
          taxi.add(vfin);
          registerPart('evtol_conv_vfin', { object: vfin, type: 'box', kind: 'tail', dims: { l: 0.7, w: 0.08, h: 1.4 } });
          const hstab = new THREE.Mesh(new THREE.BoxGeometry(0.65, 0.08, 2.0), materials.primary);
          hstab.position.set(tailX, 1.5, 0);
          taxi.add(hstab);
          registerPart('evtol_conv_hstab', { object: hstab, type: 'box', kind: 'tail', dims: { l: 0.65, w: 2.0, h: 0.08 } });
        }

        // ===== 7. LANDING GEAR =====
        const groundY = 0.18, wheelR = 0.22;
        if (s.gear === 'tricycle') {
          const noseStrut = new THREE.Mesh(new THREE.CylinderGeometry(0.05, 0.05, 0.85, 8), materials.gear);
          noseStrut.position.set(-s.fuselageLen/3, 0.625, 0);
          taxi.add(noseStrut);
          registerPart('evtol_nose_strut', { object: noseStrut, type: 'cylinder', kind: 'gear', dims: { l: 0.85, w: 0.1, h: 0.1 } });
          const noseWheel = new THREE.Mesh(new THREE.TorusGeometry(wheelR, 0.07, 10, 18), materials.gear);
          noseWheel.position.set(-s.fuselageLen/3, groundY + wheelR, 0);
          noseWheel.rotation.y = Math.PI / 2;
          taxi.add(noseWheel);
          registerPart('evtol_nose_wheel', { object: noseWheel, type: 'torus', kind: 'gear', dims: { l: wheelR * 2, w: wheelR * 2, h: 0.14 } });
          for (let side = 0; side < 2; side++) {
            const sign = side === 0 ? 1 : -1;
            const z = sign * 0.85;
            const strut = new THREE.Mesh(new THREE.CylinderGeometry(0.06, 0.06, 0.95, 8), materials.gear);
            strut.position.set(s.fuselageLen/8, 0.625, z);
            taxi.add(strut);
            registerPart(`evtol_main_strut_${side}`, { object: strut, type: 'cylinder', kind: 'gear', dims: { l: 0.95, w: 0.12, h: 0.12 } });
            const wheel = new THREE.Mesh(new THREE.TorusGeometry(wheelR, 0.085, 10, 18), materials.gear);
            wheel.position.set(s.fuselageLen/8, groundY + wheelR, z);
            wheel.rotation.y = Math.PI / 2;
            taxi.add(wheel);
            registerPart(`evtol_main_wheel_${side}`, { object: wheel, type: 'torus', kind: 'gear', dims: { l: wheelR * 2, w: wheelR * 2, h: 0.17 } });
          }
        } else if (s.gear === 'skid') {
          for (let side = 0; side < 2; side++) {
            const sign = side === 0 ? 1 : -1;
            const skid = new THREE.Mesh(new THREE.CylinderGeometry(0.08, 0.08, s.fuselageLen * 0.7, 10), materials.gear);
            skid.rotation.z = Math.PI / 2;
            skid.position.set(0, groundY + 0.08, sign * 0.7);
            taxi.add(skid);
            registerPart(`evtol_skid_${side}`, { object: skid, type: 'cylinder', kind: 'skid', dims: { l: s.fuselageLen * 0.7, w: 0.16, h: 0.16 } });
            const strut = new THREE.Mesh(new THREE.CylinderGeometry(0.04, 0.04, 0.7, 6), materials.gear);
            strut.position.set(0, 0.85, sign * 0.7);
            taxi.add(strut);
            registerPart(`evtol_skid_strut_${side}`, { object: strut, type: 'cylinder', kind: 'gear', dims: { l: 0.7, w: 0.08, h: 0.08 } });
          }
        }

        // ===== 8. INTERIOR — pilot + passenger seats =====
        // Seats use a luxury leather-look material (warm walnut brown
        // with low metalness, slight gloss). Pilot seat is visible
        // through the transparent canopy. User: "the AI team should
        // do interiors such as chairs, indoor luxury."
        const seatMat = new THREE.MeshStandardMaterial({
          color: 0x4a2818,           // dark walnut leather
          roughness: 0.55,
          metalness: 0.10,
          emissive: 0x110800,        // very faint warm glow
          emissiveIntensity: 0.15,
        });
        const makeSeat = (x, z, isPilot = false) => {
          const grp = new THREE.Group();
          const baseW = isPilot ? 0.45 : 0.42;
          const baseD = isPilot ? 0.5 : 0.42;
          const backH = isPilot ? 0.7 : 0.58;
          const base = new THREE.Mesh(new THREE.BoxGeometry(baseD, 0.1, baseW), seatMat);
          const back = new THREE.Mesh(new THREE.BoxGeometry(0.1, backH, baseW), seatMat);
          back.position.set(-baseD/2 + 0.05, backH/2 - 0.05, 0);
          // Headrest cushion — small box on top of backrest. Luxury detail.
          const headrest = new THREE.Mesh(
            new THREE.BoxGeometry(0.12, 0.18, baseW * 0.85), seatMat
          );
          headrest.position.set(-baseD/2 + 0.05, backH + 0.04, 0);
          grp.add(base); grp.add(back); grp.add(headrest);
          grp.position.set(x, 1.3, z);
          return grp;
        };
        const pilot = makeSeat(-1.5, 0, true);
        taxi.add(pilot);
        registerPart('evtol_pilot_seat', { object: pilot, type: 'group', kind: 'interior', dims: { l: 0.5, w: 0.45, h: 0.7 } });
        const paxLayouts = [
          [{x:-0.3,z:0}],
          [{x:-0.3,z:0.35},{x:-0.3,z:-0.35}],
          [{x:-0.3,z:0.35},{x:-0.3,z:-0.35},{x:0.7,z:0}],
          [{x:-0.3,z:0.35},{x:-0.3,z:-0.35},{x:0.7,z:0.35},{x:0.7,z:-0.35}],
          [{x:-0.3,z:0.35},{x:-0.3,z:-0.35},{x:0.7,z:0.35},{x:0.7,z:-0.35},{x:1.6,z:0}],
          [{x:-0.3,z:0.35},{x:-0.3,z:-0.35},{x:0.7,z:0.35},{x:0.7,z:-0.35},{x:1.6,z:0.35},{x:1.6,z:-0.35}]
        ];
        const layout = paxLayouts[Math.min(s.paxCount, 6) - 1] || paxLayouts[3];
        layout.forEach((pos, i) => {
          const seat = makeSeat(pos.x, pos.z, false);
          taxi.add(seat);
          registerPart(`evtol_pax_seat_${i+1}`, { object: seat, type: 'group', kind: 'interior', dims: { l: 0.42, w: 0.42, h: 0.58 } });
        });
      }

      // Backwards-compat alias
      function buildArcherMidnight(opts = {}) {
        return buildEVTOL({ paxCount: opts.paxCount || 4 });
      }

      // ====================================================================
      // AI COMPUTE MODULE — added by the AI manufacturing team after the
      // silent build so every team-built aircraft has a visible AI brain.
      // User: "team needs to work on interior as well. there needs to be
      // AI in it." This is a small glowing box mounted on top of the
      // fuselage behind the canopy. Registered as evtol_ai_module so the
      // piecewise-reveal section "Install AI flight computer" picks it up.
      // ====================================================================
      // Shared helper: read the actual fuselage geometry from the
      // registry. Every mod anchors to this so parts don't float
      // when fuselage shape varies (drone vs rail vs capsule).
      // FLOATING PARTS RULE: nothing uses hardcoded Y altitudes.
      function fuselageGeometry() {
        const fus = (typeof partsRegistry !== 'undefined') ? partsRegistry.get('evtol_fuselage') : null;
        const len    = (fus && fus.dims) ? fus.dims.l : 5.6;
        const radius = (fus && fus.dims) ? fus.dims.w / 2 : 0.7;
        const flat   = (fus && fus.dims && fus.dims.w > 0) ? (fus.dims.h / fus.dims.w) : 0.85;
        return {
          len, radius, flat,
          halfLen: len / 2,
          top:    1.45 + radius * flat,
          bottom: 1.45 - radius * flat,
        };
      }
      if (typeof window !== 'undefined') {
        window.__fuselageGeometry = fuselageGeometry;
      }

      function addEvtolAIModule(spec = {}) {
        const fg = fuselageGeometry();
        // Body — dark housing with cyan emissive panels
        const ai = new THREE.Group();
        const housing = new THREE.Mesh(
          new THREE.BoxGeometry(0.55, 0.20, 0.42),
          new THREE.MeshStandardMaterial({
            color: 0x141a22, roughness: 0.5, metalness: 0.4,
          })
        );
        ai.add(housing);
        // Glowing core panel — cyan, slightly larger emissive intensity
        const core = new THREE.Mesh(
          new THREE.BoxGeometry(0.45, 0.10, 0.30),
          new THREE.MeshStandardMaterial({
            color: 0x00E5FF, emissive: 0x00E5FF, emissiveIntensity: 0.6,
            roughness: 0.3, metalness: 0.6,
          })
        );
        core.position.y = 0.06;
        ai.add(core);
        // Tiny indicator LED — amber
        const led = new THREE.Mesh(
          new THREE.SphereGeometry(0.04, 8, 6),
          new THREE.MeshStandardMaterial({
            color: 0xf59e0b, emissive: 0xf59e0b, emissiveIntensity: 0.9,
          })
        );
        led.position.set(0.20, 0.13, 0.10);
        ai.add(led);
        // Mount BEHIND the canopy on top of the fuselage. Y is
        // fuselage top + half housing height = touches the body.
        ai.position.set(fg.len * 0.10, fg.top + 0.10, 0);
        if (typeof taxi !== 'undefined') taxi.add(ai);
        registerPart('evtol_ai_module', {
          object: ai, type: 'group', kind: 'avionics',
          dims: { l: 0.55, w: 0.42, h: 0.30 },
        });
      }
      // Expose for the AI team handler to call after the silent build
      if (typeof window !== 'undefined') {
        window.__addEvtolAIModule = addEvtolAIModule;
      }

      // ====================================================================
      // WACKY MODIFIERS — random visual flourishes the AI team welds
      // onto every build to make outputs distinctive. User: "I need
      // wacky styles." Each modifier registers parts named
      // evtol_wack_{kind}_* so the piecewise reveal flow's static
      // partGroups picks them up via /^evtol_wack_{kind}/ regexes.
      // ====================================================================
      function pickWackyMods() {
        const all = ['twin_booms', 'dorsal_pod', 'powercore', 'radome',
                     'rocketfins', 'pontoons', 'rollbar', 'grappler'];
        // Weighted count: most builds get 1, some 0/2/3 for variety
        const r = Math.random();
        let count;
        if (r < 0.20)      count = 0;     // 20% vanilla
        else if (r < 0.65) count = 1;     // 45% one mod
        else if (r < 0.92) count = 2;     // 27% two mods
        else               count = 3;     // 8% three mods
        const shuffled = all.slice().sort(() => Math.random() - 0.5);
        return shuffled.slice(0, count);
      }
      function addWackyMod(modId) {
        // Pull fuselage geometry — every mod anchors here. NO floating
        // hardcoded altitudes. User: "the AI needs to know that
        // floating parts is not acceptable."
        const fg = fuselageGeometry();
        switch (modId) {
          case 'twin_booms': {
            // Two longitudinal booms with end fins, anchored on the
            // fuselage shoulder + inboard pylons connecting to body.
            const boomY = fg.top + 0.05;
            const boomLength = Math.max(3.0, fg.len * 0.7);
            const boomCenterX = fg.halfLen * 0.36;
            const boomZ = Math.max(fg.radius + 0.65, 1.4);
            for (let side = 0; side < 2; side++) {
              const sign = side === 0 ? 1 : -1;
              const boomGeom = new THREE.CylinderGeometry(0.10, 0.10, boomLength, 12);
              boomGeom.rotateZ(Math.PI / 2);
              const boom = new THREE.Mesh(boomGeom, materials.gear);
              boom.position.set(boomCenterX, boomY, sign * boomZ);
              boom.castShadow = true;
              taxi.add(boom);
              registerPart(`evtol_wack_twinboom_${side}`, {
                object: boom, type: 'cylinder', kind: 'wack',
                dims: { l: boomLength, w: 0.2, h: 0.2 },
              });
              // Inboard pylon — connects boom to fuselage centerline
              const pylonLen = boomZ;     // span from z=0 to z=boomZ
              const pylonGeom = new THREE.CylinderGeometry(0.07, 0.07, pylonLen, 8);
              const pylon = new THREE.Mesh(pylonGeom, materials.gear);
              pylon.position.set(boomCenterX - boomLength * 0.4, boomY, sign * pylonLen / 2);
              pylon.rotation.x = Math.PI / 2;
              pylon.castShadow = true;
              taxi.add(pylon);
              registerPart(`evtol_wack_twinboom_pylon_${side}`, {
                object: pylon, type: 'cylinder', kind: 'wack',
                dims: { l: pylonLen, w: 0.14, h: 0.14 },
              });
              // End fin at boom rear end
              const fin = new THREE.Mesh(
                new THREE.BoxGeometry(0.6, 1.2, 0.06), materials.primary);
              fin.position.set(boomCenterX + boomLength / 2, boomY + 0.6, sign * boomZ);
              taxi.add(fin);
              registerPart(`evtol_wack_twinboom_fin_${side}`, {
                object: fin, type: 'box', kind: 'wack',
                dims: { l: 0.6, w: 0.06, h: 1.2 },
              });
            }
            return;
          }
          case 'dorsal_pod': {
            // Long cargo pod, BOTTOM flush with fuselage top
            const podHeight = 0.42;
            const pod = new THREE.Mesh(
              new THREE.BoxGeometry(Math.min(2.4, fg.len * 0.5), podHeight, 0.65),
              materials.accent);
            pod.position.set(-fg.halfLen * 0.05, fg.top + podHeight / 2, 0);
            pod.castShadow = true;
            taxi.add(pod);
            registerPart('evtol_wack_dorsal_pod', {
              object: pod, type: 'box', kind: 'wack',
              dims: { l: Math.min(2.4, fg.len * 0.5), w: 0.65, h: podHeight },
            });
            return;
          }
          case 'powercore': {
            // Glowing emissive sphere on a chrome mounting strut. Strut
            // bottom on fuselage top, sphere center above the strut.
            const strutHeight = 0.30;
            const strutMat = new THREE.MeshStandardMaterial({
              color: 0x888888, metalness: 0.7, roughness: 0.3,
            });
            const strut = new THREE.Mesh(
              new THREE.CylinderGeometry(0.10, 0.13, strutHeight, 12), strutMat);
            strut.position.set(0, fg.top + strutHeight / 2, 0);
            taxi.add(strut);
            registerPart('evtol_wack_powercore_strut', {
              object: strut, type: 'cylinder', kind: 'wack',
              dims: { l: 0.26, w: 0.26, h: strutHeight },
            });
            const sphereY = fg.top + strutHeight + 0.30;
            const coreMat = new THREE.MeshStandardMaterial({
              color: 0xff5500, emissive: 0xff5500, emissiveIntensity: 1.5, roughness: 0.3,
            });
            const core = new THREE.Mesh(new THREE.SphereGeometry(0.30, 16, 12), coreMat);
            core.position.set(0, sphereY, 0);
            taxi.add(core);
            registerPart('evtol_wack_powercore_sphere', {
