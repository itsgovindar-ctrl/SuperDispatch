      // Turn a description into a queue of typed commands. Order matters.
      // The function builds in SOLIDWORKS feature-tree order: base body → details → applied features.
      function interpretDescription(text) {
        const lower = text.toLowerCase();
        const commands = [];

        // ===== SHORT-FORM COMMAND FAST-PATH =====
        // BEFORE the spec-driven full-aircraft builder, intercept short commands
        // that should NOT trigger an aircraft rebuild. Otherwise "make it red"
        // (just a paint command, only 11 chars) hits the looksLikeAircraftPrompt
        // gate via the word "make" and the parser rebuilds the entire aircraft
        // before applying paint — destroying whatever the user already had.
        //
        // Heuristic: if the prompt looks like a single edit operation (paint,
        // move, remove, add ONE thing) and is shorter than ~80 chars, route
        // it through the legacy single-action path instead of the spec build.
        const isShortPrompt = text.length < 80;
        const isPureColorCmd = /^\s*(paint|color|make)\s+(it|the|its|this|that|primary|accent|trim|airframe|body|fuselage)\s+/.test(lower)
                            || /^\s*(paint|color)\s+/.test(lower)
                            || /^\s*(make|paint|color)\s+\w+\s+\w+\s*$/.test(lower);  // "make it red"
