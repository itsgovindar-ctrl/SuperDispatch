      // =====================================================================
      // FLIGHT TEST CHAMBER — runs hover + stability tests on the design
      // =====================================================================
      //
      // Tuned to be PERMISSIVE: weird-looking but flyable designs should pass.
      // Only genuinely broken configurations (no rotors, severe mass-thrust
      // imbalance, severely unbalanced rotor placement) should fail.
      //
      // Previous version had several rigged-scoring bugs:
      //  1. Every rotor counted as full thrust regardless of size (decoration
      //     rotors got fake-credit, big lift rotors got shortchanged)
      //  2. Pitch/roll thresholds in absolute meters, but geometry scale
      //     varies by design — a long fuselage with wing-mounted rotors got
      //     flagged for pitch imbalance even though it's a valid config
      //  3. Disturbance formula `1 - pitch/0.5 - roll/0.5*0.8 + bonus` would
      //     score a perfectly-flyable quad at 12/100 if both offsets were 30cm

      // Densities (kg per cubic scene-unit). Calibrated against real eVTOL
      // mass benchmarks:
      //   Joby S4 empty: 2178 kg, fuselage ~7m × 1.5m × 1.5m = ~16 m³ bbox
      //   Wisk Gen6 empty: ~1100 kg, smaller fuselage
      //   Volocopter VC2: ~700 kg
      // In our scene 1 unit = 1 meter (roughly). A typical fuselage bbox of
      // 2.5u × 0.8u × 1u = 2 u³ should mass ~250-400 kg (Wisk-class). So
      // fuselage density ~150 kg/u³.
      //
      // Bbox volume includes lots of empty air around the geometry, so these
      // densities are LOWER than true material density. Recalibrated after
      // the screenshot bug — the previous fuselage density of 60 was tuned
      // for the broken old thrust formula, not for actual flying numbers.
      const KIND_DENSITY = {
        fuselage: 150,    // 2u³ fuselage = ~300 kg
        boom:     200,
        arm:      200,
        support:  200,
        rotor:    400,    // motor + hub + blades — relatively dense
        wing:     100,    // composite skin over hollow ribs
        tail:      80,
        nose:     120,
        cockpit:   30,    // mostly air
        gear:     400,
        skid:     350,
        feature:   30,
        interior: 100,
        cargo:    150,
        system:   500,    // batteries + avionics
        primitive: 100
      };
      // Per-rotor thrust at REFERENCE rotor radius. The reference 0.4u
      // matches actual in-game rotor sizes. The standard buildSingleRotor
      // produces 0.33u radius rotors; production tilt-rotor variants use
      // 0.4-0.6u. So 0.4u = "a normal lift rotor".
      //
      // 350 kgf is a urban-air-taxi scale per-rotor thrust. Real Joby S4
      // has 6 rotors lifting ~2200 kg empty + 450 kg payload = ~440 kg per
      // rotor, so 350 kgf is conservative and leaves margin for control.
      //
      // The earlier 1.0u reference made every in-game rotor (0.33u) register
      // as 38 kgf, which was the SCREENSHOT BUG: 8 rotors gave 304 kgf
      // thrust against 2206 kg of mass.
      const THRUST_PER_ROTOR_AT_REF = 350;
      const ROTOR_REF_RADIUS = 0.4;

      // Compute structural and stability metrics from the current parts registry
      function computeFlightMetrics() {
        let totalMass = 0;
        const partInfos = [];
        let hasFuselage = false;

        for (const [name, info] of partsRegistry) {
          if (!info.object) continue;
          if (info.kind === 'fuselage') hasFuselage = true;
          const box = new THREE.Box3().setFromObject(info.object);
          if (box.isEmpty()) continue;
          const size = new THREE.Vector3(); box.getSize(size);
          const center = new THREE.Vector3(); box.getCenter(center);

          // Volume estimation. PROBLEM: `Box3.setFromObject` measures the
          // FULL hierarchy including any child meshes (decoration, helpers,
          // structural members that visually hide inside the parent). That
          // can wildly overestimate volume — e.g. a fuselage Group with an
          // embedded wing-spar child reads as 8u × 1u × 1u = 8 u³ instead of
          // the intended 4u × 1u × 1u = 4 u³. Compounded across many parts
          // this gave the 12,113 kg phantom mass.
          //
          // Fix: prefer the `dims` recorded at registration time (l × w × h
          // in scene units, set explicitly by the part-builder code that
          // KNOWS the intended size). Fall back to bbox only when dims are
          // absent. That keeps fuselage/wing/boom mass close to designer
          // intent regardless of what child meshes get attached later.
          let volume;
          if (info.dims && (info.dims.l || info.dims.w || info.dims.h)) {
            const dl = info.dims.l ?? info.dims.length ?? 1;
            const dw = info.dims.w ?? info.dims.width  ?? 1;
            const dh = info.dims.h ?? info.dims.height ?? 1;
            volume = Math.max(0.0005, Math.abs(dl * dw * dh));
          } else {
            volume = Math.max(0.0005, size.x * size.y * size.z);
          }
          // Hard safety cap: no single part can contribute > 5 u³ of volume.
          // A fuselage in this app is ~4u³ max; anything bigger is almost
          // certainly a hierarchy-bleed artifact (an oversized child mesh
          // counted into the parent's bbox).
          volume = Math.min(volume, 5.0);

          const density = KIND_DENSITY[info.kind] ?? 100;
          const mass = volume * density;
          partInfos.push({ name, kind: info.kind, mass, center, size, volume, density });
          totalMass += mass;
        }

        // Optional debug log (enable via window.__SDX_FLIGHT_DEBUG = true)
        if (window.__SDX_FLIGHT_DEBUG) {
          console.log('[flight-test] Per-part mass breakdown:');
          for (const p of partInfos.sort((a, b) => b.mass - a.mass)) {
            const dimSrc = (partsRegistry.get(p.name)?.dims) ? 'dims' : 'bbox';
            console.log(`  ${p.kind.padEnd(10)} ${p.name.padEnd(30)} ` +
              `bbox=${p.size.x.toFixed(2)}×${p.size.y.toFixed(2)}×${p.size.z.toFixed(2)} ` +
              `vol=${p.volume.toFixed(3)} (${dimSrc}) ρ=${p.density} → ${p.mass.toFixed(0)} kg`);
          }
          console.log(`[flight-test] TOTAL MASS = ${totalMass.toFixed(0)} kg`);
        }

        // Center of mass (mass-weighted average position)
        const com = new THREE.Vector3();
        if (totalMass > 0) {
          for (const p of partInfos) com.add(p.center.clone().multiplyScalar(p.mass));
          com.divideScalar(totalMass);
        }

        // Rotor analysis — thrust scales with rotor SIZE, not just count.
        // This way a 12-inch decorative rotor doesn't count the same as
        // a 6-foot lift rotor.
        const rotors = partInfos.filter(p => p.kind === 'rotor');
        const rotorCount = rotors.length;
        let thrustCapacity = 0;
        const rotorContribs = [];
        for (const r of rotors) {
          // Rotor radius approximated as the larger horizontal half-extent
          // of its bounding box. Real rotors are flat discs in XZ plane.
          const radius = Math.max(r.size.x, r.size.z) / 2;
          // Quadratic thrust scaling — disc-area-proportional, real-world correct.
          // Min clamp at 0.001 means a tiny 0.05u rotor (ratio 0.05) gives
          // 0.0025 × 350 = ~0.9 kgf. Twenty of those gives ~18 kgf — clearly
          // not enough to lift anything. Old min-clamp of 0.05 was set too
          // high and accidentally still let decoration rotors pass minimum.
          const ratio = radius / ROTOR_REF_RADIUS;
          const contrib = THRUST_PER_ROTOR_AT_REF * Math.max(0.001, ratio * ratio);
          thrustCapacity += contrib;
          rotorContribs.push({ name: r.name, radius, contrib });
        }
        if (window.__SDX_FLIGHT_DEBUG) {
          console.log('[flight-test] Per-rotor thrust breakdown ' +
            `(reference radius ${ROTOR_REF_RADIUS}u → ${THRUST_PER_ROTOR_AT_REF} kgf):`);
          for (const r of rotorContribs) {
            console.log(`  ${r.name.padEnd(30)} radius=${r.radius.toFixed(3)}u → ${r.contrib.toFixed(0)} kgf`);
          }
          console.log(`[flight-test] TOTAL THRUST = ${thrustCapacity.toFixed(0)} kgf ` +
            `vs MASS ${totalMass.toFixed(0)} kg → lift margin ${((thrustCapacity - totalMass) / Math.max(1, totalMass) * 100).toFixed(0)}%`);
        }
        const liftMargin = totalMass > 0 ? ((thrustCapacity - totalMass) / totalMass) * 100 : 0;

        // Geometric center of rotor cluster (thrust-weighted, not just simple
        // average — bigger rotors influence the lift centroid more)
        const rotorCenter = new THREE.Vector3();
        let rotorWeightSum = 0;
        for (const r of rotors) {
          const radius = Math.max(r.size.x, r.size.z) / 2;
          const w = Math.max(0.001, (radius / ROTOR_REF_RADIUS) ** 2);
          rotorCenter.add(r.center.clone().multiplyScalar(w));
          rotorWeightSum += w;
        }
        if (rotorWeightSum > 0) rotorCenter.divideScalar(rotorWeightSum);

        // Pitch/roll offsets, NORMALIZED by aircraft size. The previous
        // absolute-meter thresholds (150mm pass, 300mm warn) were unfair
        // for larger designs — a Joby-class aircraft with 150mm CoM offset
        // is fine, but a small quadcopter with 150mm offset is awful. We
        // express the offset as a FRACTION of the rotor cluster's radial
        // span instead.
        const pitchOffsetRaw = Math.abs(rotorCenter.x - com.x);  // X = forward/back
        const rollOffsetRaw  = Math.abs(rotorCenter.z - com.z);  // Z = left/right
        // Compute aircraft characteristic size = rotor cluster's max radial spread
        let rotorSpread = 0;
        for (const r of rotors) {
          const dx = r.center.x - rotorCenter.x;
          const dz = r.center.z - rotorCenter.z;
          rotorSpread = Math.max(rotorSpread, Math.hypot(dx, dz));
        }
        const sizeRef = Math.max(0.5, rotorSpread || 1.0);   // fallback for single-rotor designs
        const pitchOffset = pitchOffsetRaw / sizeRef;        // unitless, 0..many
        const rollOffset  = rollOffsetRaw  / sizeRef;

        // Yaw authority: bigger rotor spread = more yaw control via differential thrust
        const yawAuthority = rotorSpread;

        // Disturbance recovery score — REWORKED.
        // Previous formula `1 - pitch/0.5 - roll/0.5*0.8 + bonus` was both
        // over-penalizing (any decent offset crashed score below passing) and
        // not actually grounded in flight physics.
        //
        // New score: starts at 100, penalizes proportionally to NORMALIZED
        // pitch/roll offset, with diminishing returns past 0.5 (50% off-center
        // is genuinely bad but not "0/100" bad). Plus base bonus for redundancy.
        const pitchPenalty = Math.min(40, 60 * pitchOffset);     // 0% offset = 0 penalty, 50% = 30 penalty, capped at 40
        const rollPenalty  = Math.min(40, 60 * rollOffset);
        const redundancyBonus = rotorCount >= 6 ? 15 : (rotorCount >= 4 ? 10 : 0);
        const liftMarginBonus = liftMargin > 50 ? 5 : (liftMargin > 0 ? 0 : -20);   // big extra thrust helps recovery
        const disturbanceScore = Math.max(0, Math.min(100,
          80 - pitchPenalty - rollPenalty + redundancyBonus + liftMarginBonus
        ));

        return {
          hasFuselage,
          totalMass,
          com,
          rotorCount,
          thrustCapacity,
          liftMargin,
          pitchOffset,
          rollOffset,
          pitchOffsetRaw,    // exposed for display in mm
          rollOffsetRaw,
          sizeRef,
          yawAuthority,
          disturbanceScore
        };
      }

      // ---- Test scene (separate from main viewport) ----
      let testScene = null, testCamera = null, testRenderer = null, testGroup = null;
      let testRotors = []; // rotor meshes in the test scene to spin
      let testRunning = false;
      let testLastResult = null;
      let testStartTime = 0;
      let testPhase = 'idle';
      let testAnimRotation = { x: 0, z: 0 };
      let hoverTargetY = 1.5;
      let resizeTestRenderer = null;     // exposed so openTestChamber can re-fire it after the modal becomes visible

      function ensureTestScene() {
        if (testScene) return;
        const canvas = document.getElementById('test-canvas');
        testRenderer = new THREE.WebGLRenderer({ canvas, antialias: true, alpha: true });
        testRenderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
        testScene = new THREE.Scene();
        testScene.fog = new THREE.Fog(0x030a1a, 6, 22);
        testCamera = new THREE.PerspectiveCamera(40, 1, 0.1, 100);
        testCamera.position.set(5, 2.6, 5);
        testCamera.lookAt(0, 1.5, 0);

        // Lighting matched to the hangar feel
        testScene.add(new THREE.HemisphereLight(0x6688cc, 0x0a1428, 0.45));
        const key = new THREE.DirectionalLight(0xffffff, 0.85);
        key.position.set(4, 8, 5);
        key.castShadow = true;
        key.shadow.mapSize.set(1024, 1024);
        testScene.add(key);
        const fill = new THREE.DirectionalLight(0xa0c8ff, 0.35);
        fill.position.set(-3, 5, -4);
        testScene.add(fill);
        const rim = new THREE.PointLight(0x00E5FF, 0.7, 12);
        rim.position.set(-3, 1.5, 3);
        testScene.add(rim);

        // Floor grid
        const gridHelper = new THREE.GridHelper(16, 16, 0x1a3a55, 0x0a2030);
        gridHelper.position.y = 0;
        testScene.add(gridHelper);
        // Faint floor disc
        const floor = new THREE.Mesh(
          new THREE.CircleGeometry(8, 48),
          new THREE.MeshStandardMaterial({ color: 0x040b18, roughness: 0.95, metalness: 0 })
        );
        floor.rotation.x = -Math.PI / 2;
        floor.receiveShadow = true;
        testScene.add(floor);

        // The aircraft container — we'll stuff a clone of the built craft here
        testGroup = new THREE.Group();
        testScene.add(testGroup);

        resizeTestRenderer = () => {
          if (!canvas.parentElement) return;
          const w = canvas.parentElement.clientWidth;
          const h = canvas.parentElement.clientHeight;
          // Bail if the parent has no layout yet (modal still transitioning in).
          // Without this guard, setSize(0, 0) wedges the renderer at zero size
          // and the user sees an empty test chamber every time.
          if (w < 4 || h < 4) return;
          testRenderer.setSize(w, h, false);
          testCamera.aspect = w / h;
          testCamera.updateProjectionMatrix();
        };
        resizeTestRenderer();
        window.addEventListener('resize', resizeTestRenderer);
        // ResizeObserver catches the case where the modal animates open AFTER
        // ensureTestScene runs — without it, the canvas stays at 0×0 if the
        // first sizing attempt happened before the parent had a layout.
        if (typeof ResizeObserver !== 'undefined' && canvas.parentElement) {
          const ro = new ResizeObserver(() => resizeTestRenderer());
          ro.observe(canvas.parentElement);
        }

        // Render loop — runs continuously so the scene stays drawn even when
        // testRunning is false (animation is gated, but rendering is not, so
        // the user always sees the current frame including the parked aircraft
        // before testRunning flips on).
        function tickTest() {
          requestAnimationFrame(tickTest);
          if (testRunning) {
            const elapsed = (performance.now() - testStartTime) / 1000;
            updateTestAnimation(elapsed);
          }
          // Always render — a frame with no animation is still a frame.
          if (testScene && testCamera && testRenderer) {
            testRenderer.render(testScene, testCamera);
          }
        }
        tickTest();
      }

      function clearTestScene() {
        if (!testGroup) return;
        while (testGroup.children.length) {
          const c = testGroup.children[0];
          testGroup.remove(c);
          c.traverse?.(o => { if (o.geometry?.dispose) o.geometry.dispose(); });
        }
        testRotors.length = 0;
      }

      // Build a test rendering of the aircraft from a deep clone of `taxi`
      function loadTestAircraft() {
        clearTestScene();
        const cloned = taxi.clone(true);
        // Identify rotors in the clone for spinning animation
        cloned.traverse(o => {
          if (o.userData?.partName) {
            const info = partsRegistry.get(o.userData.partName);
            if (info?.kind === 'rotor') testRotors.push(o);
          }
        });
        testGroup.add(cloned);
        testGroup.position.set(0, 0, 0);
        testGroup.rotation.set(0, 0, 0);
        // Frame the camera around the aircraft using its bounding sphere.
        // The previous formula (dist = radius * 3.2 + diagonal contribution)
        // placed the camera ~5× the aircraft radius from the bbox center,
        // putting it past the fog far plane (22u) for any aircraft wider than
        // ~9u. With Archer-style 12-rotor designs (12u wingspan), the entire
        // craft was rendered as solid fog color → empty chamber.
        //
        // Fix: position camera at a distance derived from FOV and radius so
        // the aircraft fills ~70% of the frame, and scale the fog so it always
        // sits BEYOND the camera's far edge of the aircraft.
        const box = new THREE.Box3().setFromObject(cloned);
        const sphere = new THREE.Sphere();
        box.getBoundingSphere(sphere);
        const radius = Math.max(sphere.radius, 1.0);
        // Distance to fit the bounding sphere at ~70% of vertical FOV
        const fovRad = testCamera.fov * Math.PI / 180;
        const fitDist = radius / Math.sin(fovRad / 2) * 0.85;
        // Place camera at an oblique angle (45° azimuth, ~22° elevation)
        const camAng = Math.PI / 4;
        const camElev = 0.4;
        const camDist = Math.max(5, fitDist);
        testCamera.position.set(
          Math.cos(camAng) * camDist,
          radius * 0.6 + camElev * camDist,
          Math.sin(camAng) * camDist
        );
        testCamera.lookAt(sphere.center.x, sphere.center.y, sphere.center.z);
        // Push fog out to be just BEYOND the far edge of the aircraft so the
        // whole craft is visible. Use the camera-to-far-edge distance plus
        // some room for the falloff to look natural.
        const farEdge = camDist + radius;
        testScene.fog.near = Math.max(2, farEdge * 0.4);
        testScene.fog.far  = farEdge * 1.6;
        // Also push camera far plane out so we don't clip
        testCamera.far = Math.max(100, farEdge * 4);
        testCamera.updateProjectionMatrix();
        // Diagnostic logging — surfaces in browser console so users can verify
        // their cached HTML has the fix. If you see "[test-chamber]" with NaN
        // values or impossible camera positions, the bug is back. If you don't
        // see this log at all, you're on a cached HTML — hard-refresh to fix.
        console.log('[test-chamber] Loaded aircraft:', {
          meshCount: (() => { let n = 0; cloned.traverse(o => { if (o.isMesh) n++; }); return n; })(),
          bboxRadius: +radius.toFixed(2),
          cameraDist: +camDist.toFixed(2),
          fogNear: +testScene.fog.near.toFixed(2),
          fogFar: +testScene.fog.far.toFixed(2),
          farEdge: +farEdge.toFixed(2)
        });
      }

      // Drives the hover animation as a function of elapsed seconds
      function updateTestAnimation(t) {
        if (!testGroup) return;
        // Phase machine — phases are set by runTestSequence
        if (testPhase === 'spinup') {
          testGroup.position.y = 0;
          // Rotors spool up
          testRotors.forEach(r => r.rotation.y += Math.min(1.0, t / 1.0) * 0.6);
        } else if (testPhase === 'liftoff') {
          // 1.5s smooth ascent from 0 to hoverTargetY
          const phaseT = Math.min(1, (t - phaseStarts.liftoff) / 1.5);
          const eased = phaseT < 0.5
            ? 2 * phaseT * phaseT
            : 1 - Math.pow(-2 * phaseT + 2, 2) / 2;
          testGroup.position.y = eased * hoverTargetY;
          testRotors.forEach(r => r.rotation.y += 0.7);
        } else if (testPhase === 'hover') {
          // Steady hover with subtle bob and wobble proportional to instability
          const wobble = testLastResult ? (1 - testLastResult.disturbanceScore / 100) : 0;
          testGroup.position.y = hoverTargetY + Math.sin(t * 1.6) * (0.04 + wobble * 0.18);
          testGroup.rotation.x = Math.sin(t * 1.3) * (0.02 + wobble * 0.10);
          testGroup.rotation.z = Math.cos(t * 1.7) * (0.02 + wobble * 0.08);
          testRotors.forEach(r => r.rotation.y += 0.85);
        } else if (testPhase === 'disturbance') {
          // Apply a sharp tilt then recover (or fail to recover)
          const phaseT = (t - phaseStarts.disturbance);
          const recovery = testLastResult ? testLastResult.disturbanceScore / 100 : 0;
          // Initial impulse for first 0.4s
          if (phaseT < 0.4) {
            testGroup.rotation.z = -0.30 * (phaseT / 0.4);
            testGroup.position.x = -0.6 * (phaseT / 0.4);
          } else {
            // Recovery phase — lerp back proportional to score
            const recT = Math.min(1, (phaseT - 0.4) / (1.4 - recovery * 1.0));
            testGroup.rotation.z = -0.30 * (1 - recT * recovery);
            testGroup.position.x = -0.6 * (1 - recT * recovery);
            // Maintain hover bob
            testGroup.position.y = hoverTargetY + Math.sin(t * 1.6) * 0.05;
          }
          testRotors.forEach(r => r.rotation.y += 0.95);
        } else if (testPhase === 'failed') {
          // Drop and tilt
          const phaseT = t - phaseStarts.failed;
          testGroup.position.y = Math.max(0.05, hoverTargetY - phaseT * phaseT * 1.5);
          testGroup.rotation.z = Math.min(Math.PI / 3, phaseT * 0.7);
          testGroup.rotation.x = Math.min(0.4, phaseT * 0.3);
          testRotors.forEach(r => r.rotation.y += Math.max(0, 0.85 - phaseT * 0.4));
        } else if (testPhase === 'passed') {
          // Triumphant slow rotation and steady hover
          testGroup.position.y = hoverTargetY + Math.sin(t * 1.4) * 0.05;
          testGroup.rotation.y += 0.004;
          testGroup.rotation.x *= 0.92;
          testGroup.rotation.z *= 0.92;
          testRotors.forEach(r => r.rotation.y += 0.85);
        }
        // Update telemetry readouts
        updateTelemetry(t);
      }

      const phaseStarts = {};

      function updateTelemetry(t) {
        const set = (id, v) => { const el = document.getElementById(id); if (el) el.textContent = v; };
        const altitude = testGroup ? testGroup.position.y : 0;
        const pitch = testGroup ? THREE.MathUtils.radToDeg(testGroup.rotation.x) : 0;
        const roll  = testGroup ? THREE.MathUtils.radToDeg(testGroup.rotation.z) : 0;
        const yaw   = testGroup ? THREE.MathUtils.radToDeg(testGroup.rotation.y) : 0;
        set('ro-alt',   altitude.toFixed(2) + ' m');
        set('ro-pitch', (pitch >= 0 ? '+' : '') + pitch.toFixed(1) + '°');
        set('ro-roll',  (roll  >= 0 ? '+' : '') + roll.toFixed(1)  + '°');
        set('ro-yaw',   (yaw   >= 0 ? '+' : '') + (yaw % 360).toFixed(1) + '°');
        // Velocity = derivative; approximate from y movement frame to frame
        const dt = t - (lastTeleT || t);
        const dy = altitude - (lastTeleAlt || 0);
        const vy = dt > 0 ? dy / dt : 0;
        set('ro-vel', (Math.abs(vy) < 0.01 ? '0.00' : vy.toFixed(2)) + ' m/s');
        lastTeleT = t; lastTeleAlt = altitude;
        const thrustPct = testPhase === 'spinup' ? Math.min(100, t * 70) :
                          testPhase === 'idle' ? 0 :
                          testPhase === 'failed' ? Math.max(0, 100 - (t - phaseStarts.failed) * 80) :
                          testLastResult && testLastResult.totalMass > 0
                            ? Math.min(100, (testLastResult.totalMass / testLastResult.thrustCapacity) * 100)
                            : 100;
        set('ro-thrust', Math.round(thrustPct) + '%');
        set('ro-stab', testLastResult ? Math.round(testLastResult.disturbanceScore) + '/100' : '—');
        set('ro-phase', testPhase.toUpperCase());
        const mins = Math.floor(t / 60).toString().padStart(2, '0');
        const secs = (t % 60).toFixed(2).padStart(5, '0');
        set('ro-time', `${mins}:${secs}`);
      }
      let lastTeleT = 0, lastTeleAlt = 0;

      // ---- UI helpers ----
      function setRow(testKey, value, status) {
        const row = document.querySelector(`.test-row[data-test="${testKey}"]`);
        if (!row) return;
        row.classList.remove('running', 'pass', 'fail', 'warn');
        if (status) row.classList.add(status);
        const valEl = row.querySelector('.test-value');
        if (valEl && value !== undefined) valEl.textContent = value;
      }
      function setStatus(text, cls) {
        const el = document.getElementById('test-status');
        if (!el) return;
        el.textContent = text;
        el.className = 'test-status-pill';
        if (cls) el.classList.add(cls);
      }
      const sleep = (ms) => new Promise(r => setTimeout(r, ms));

      // Open the test chamber and kick off the test sequence
      async function openTestChamber() {
        const tail = document.getElementById('tail-number')?.value || 'SDX-0001';
        document.getElementById('test-unit-id').textContent = `UNIT ${tail}`;
        const modal = document.getElementById('test-modal');
        modal.classList.add('active');

        // Wait two frames so the modal's CSS scale transition has a chance to
        // settle and the canvas has a real layout. One frame is sometimes not
        // enough — the modal has a transform: scale animation, and reading
        // clientWidth/clientHeight too early returns 0 → renderer initializes
        // at 0×0 and never recovers (the user sees an empty chamber).
        await new Promise(r => requestAnimationFrame(r));
        await new Promise(r => requestAnimationFrame(r));
        ensureTestScene();
        // Re-fire resize now that the modal is visible — covers re-opens after
        // a window resize, and the case where the first sizing in ensureTestScene
        // happened before the parent had a layout.
        if (resizeTestRenderer) resizeTestRenderer();
        loadTestAircraft();
        // Reset all rows to neutral
        ['mass','com','rotors','thrust','lift','hover','pitch','roll','yaw','dist'].forEach(k => setRow(k, '—', null));
        document.getElementById('test-submit').disabled = true;
        document.getElementById('test-verdict').className = 'test-verdict';
        document.getElementById('test-verdict').innerHTML = '<div class="verdict-icon">⏳</div><div class="verdict-text">Tests in progress…</div>';
        document.getElementById('test-summary').textContent = 'Initializing test sequence…';

        await runTestSequence();
      }

      function closeTestChamber() {
        document.getElementById('test-modal').classList.remove('active');
        testRunning = false;
        testPhase = 'idle';
      }

      async function runTestSequence() {
        // Reset state
        testRunning = true;
        testStartTime = performance.now();
        testPhase = 'idle';
        Object.keys(phaseStarts).forEach(k => delete phaseStarts[k]);
        if (testGroup) { testGroup.position.set(0,0,0); testGroup.rotation.set(0,0,0); }

        const m = computeFlightMetrics();
        testLastResult = m;

        // PHASE 1 — Structural analysis
        setStatus('STRUCTURAL ANALYSIS', 'running');
        testPhase = 'spinup';
        await sleep(400);

        setRow('mass', '...', 'running');
        await sleep(500);
        setRow('mass', m.totalMass.toFixed(0) + ' kg', m.hasFuselage ? 'pass' : 'fail');

        setRow('com', '...', 'running');
        await sleep(400);
        setRow('com', `(${m.com.x.toFixed(2)}, ${m.com.y.toFixed(2)}, ${m.com.z.toFixed(2)})`, 'pass');

        setRow('rotors', '...', 'running');
        await sleep(400);
        const rotorOk = m.rotorCount >= 3;
        const rotorWarn = m.rotorCount >= 3 && m.rotorCount < 4;
        setRow('rotors', `${m.rotorCount} units`, rotorOk ? (rotorWarn ? 'warn' : 'pass') : 'fail');

        setRow('thrust', '...', 'running');
        await sleep(400);
        setRow('thrust', m.thrustCapacity.toFixed(0) + ' kgf', m.thrustCapacity > 0 ? 'pass' : 'fail');

        // If basic structural fails, we can't even attempt hover
        if (!m.hasFuselage || m.rotorCount === 0) {
          await sleep(500);
          setStatus('STRUCTURAL FAIL', 'failed');
          testPhase = 'failed'; phaseStarts.failed = (performance.now() - testStartTime) / 1000;
          showVerdict(false, [
            !m.hasFuselage ? 'No fuselage detected — cannot test airframe' : null,
            m.rotorCount === 0 ? 'No rotors detected — propulsion required for hover' : null
          ].filter(Boolean));
          return;
        }

        // PHASE 2 — Liftoff and hover
        setStatus('HOVER TEST', 'running');
        testPhase = 'liftoff'; phaseStarts.liftoff = (performance.now() - testStartTime) / 1000;
        await sleep(300);

        setRow('lift', '...', 'running');
        await sleep(700);
        const liftPass = m.liftMargin >= 20;
        const liftWarn = m.liftMargin >= 0 && m.liftMargin < 20;
        setRow('lift', (m.liftMargin >= 0 ? '+' : '') + m.liftMargin.toFixed(0) + '%', liftPass ? 'pass' : (liftWarn ? 'warn' : 'fail'));

        await sleep(700); // wait for liftoff animation to finish
        testPhase = 'hover'; phaseStarts.hover = (performance.now() - testStartTime) / 1000;

        setRow('hover', '...', 'running');
        await sleep(900);
        const canHover = m.thrustCapacity > m.totalMass;
        setRow('hover', canHover ? 'AIRBORNE' : 'GROUNDED', canHover ? 'pass' : 'fail');

        if (!canHover) {
          await sleep(700);
          setStatus('LIFT INSUFFICIENT', 'failed');
          testPhase = 'failed'; phaseStarts.failed = (performance.now() - testStartTime) / 1000;
          const need = (m.totalMass - m.thrustCapacity).toFixed(0);
          // Per-rotor thrust varies with rotor SIZE (disc-area-proportional),
          // so we report the average per-rotor contribution from THIS design
          // rather than a fixed number. A 0.4u-radius reference rotor gives
          // 350 kgf; smaller rotors give proportionally less, larger ones more.
          const avgPerRotor = m.rotorCount > 0 ? (m.thrustCapacity / m.rotorCount).toFixed(0) : 0;
          showVerdict(false, [
            `Insufficient thrust: short by ${need} kgf (mass ${m.totalMass.toFixed(0)} kg vs thrust ${m.thrustCapacity.toFixed(0)} kgf)`,
            `Each rotor on this design provides ~${avgPerRotor} kgf — add more rotors, increase rotor size, or reduce mass`
          ]);
          return;
        }

        // PHASE 3 — Stability tests
        setStatus('STABILITY TESTS', 'running');
        await sleep(400);

        setRow('pitch', '...', 'running');
        await sleep(600);
        // pitchOffset is now unitless (ratio of CoM-to-rotor-cluster offset
        // divided by rotor cluster radial spread). 0 = perfectly balanced;
        // 0.3 = 30% off-center (fine for control); 0.6+ = genuinely struggle.
        const pitchMm = (m.pitchOffsetRaw * 1000);
        const pitchPass = m.pitchOffset < 0.30;
        const pitchWarn = m.pitchOffset >= 0.30 && m.pitchOffset < 0.55;
        setRow('pitch', `${pitchMm.toFixed(0)} mm (${(m.pitchOffset*100).toFixed(0)}% off-axis)`,
          pitchPass ? 'pass' : (pitchWarn ? 'warn' : 'fail'));

        setRow('roll', '...', 'running');
        await sleep(600);
        const rollMm = (m.rollOffsetRaw * 1000);
        const rollPass = m.rollOffset < 0.30;
        const rollWarn = m.rollOffset >= 0.30 && m.rollOffset < 0.55;
        setRow('roll', `${rollMm.toFixed(0)} mm (${(m.rollOffset*100).toFixed(0)}% off-axis)`,
          rollPass ? 'pass' : (rollWarn ? 'warn' : 'fail'));

        setRow('yaw', '...', 'running');
        await sleep(500);
        // Yaw authority threshold relaxed — single-rotor or close-to-axis
        // designs can still be flyable with cyclic control. Only call out
        // truly minimal arm length.
        const yawPass = m.yawAuthority > 0.4;
        const yawWarn = m.yawAuthority > 0.2 && m.yawAuthority <= 0.4;
        setRow('yaw', m.yawAuthority.toFixed(2) + ' m·arm', yawPass ? 'pass' : (yawWarn ? 'warn' : 'fail'));

        // Disturbance test — apply tilt and watch recovery
        setRow('dist', '...', 'running');
        testPhase = 'disturbance'; phaseStarts.disturbance = (performance.now() - testStartTime) / 1000;
        await sleep(1800);
        // New disturbance score is calibrated 0..100 with 50 = passable.
        // Pass at 50+, warn at 30+, fail below 30. Previous thresholds
        // (60/35) were too strict given the now-realistic score formula.
        const distPass = m.disturbanceScore >= 50;
        const distWarn = m.disturbanceScore >= 30 && m.disturbanceScore < 50;
        setRow('dist', m.disturbanceScore.toFixed(0) + '/100', distPass ? 'pass' : (distWarn ? 'warn' : 'fail'));

        // Verdict
        await sleep(400);
        const issues = [];
        if (!liftPass && !liftWarn) issues.push('Insufficient lift margin (< 0%)');
        else if (!liftPass && liftWarn) issues.push(`Marginal lift (${m.liftMargin.toFixed(0)}% — recommend 20%+ for control authority)`);
        if (!pitchPass) issues.push(`Pitch imbalance: rotor cluster ${(m.pitchOffset*100).toFixed(0)}% off CoM forward-axis (target < 30%)`);
        if (!rollPass)  issues.push(`Roll imbalance: rotor cluster ${(m.rollOffset*100).toFixed(0)}% off CoM lateral-axis (target < 30%)`);
        if (!yawPass)   issues.push(`Limited yaw authority (${m.yawAuthority.toFixed(2)}m arm — extend booms or spread rotors)`);
        if (!distPass)  issues.push(`Poor disturbance recovery (${m.disturbanceScore.toFixed(0)}/100 — improve symmetry or add rotors)`);
        if (rotorWarn)  issues.push('Only 3 rotors — minimum for control. 4+ recommended for redundancy.');

        const blocking = !liftPass && !liftWarn || !pitchPass && !pitchWarn || !rollPass && !rollWarn || !distPass && !distWarn;
        const passed = !blocking;

        if (passed) {
          testPhase = 'passed'; phaseStarts.passed = (performance.now() - testStartTime) / 1000;
          setStatus('CERTIFIED FOR FLIGHT', 'passed');
        } else {
          testPhase = 'failed'; phaseStarts.failed = (performance.now() - testStartTime) / 1000;
          setStatus('TESTS FAILED', 'failed');
        }
        showVerdict(passed, issues);
      }

      function showVerdict(passed, issues) {
        const v = document.getElementById('test-verdict');
        const submitBtn = document.getElementById('test-submit');
        if (!v) return;
        if (passed) {
          v.className = 'test-verdict pass';
          v.innerHTML = `<div class="verdict-icon">✓</div><div class="verdict-text"><strong>FLIGHT CERTIFIED.</strong>${issues.length ? ' Minor advisories logged.' : ' All tests passed cleanly.'}</div>`;
          submitBtn.disabled = false;
          document.getElementById('test-summary').textContent = `${issues.length} advisor${issues.length===1?'y':'ies'} · cleared for manufacturing`;
        } else {
          v.className = 'test-verdict fail';
          const issueList = issues.slice(0, 3).map(s => `<div>• ${s}</div>`).join('');
          v.innerHTML = `<div class="verdict-icon">✕</div><div class="verdict-text"><strong>NOT CERTIFIED.</strong>${issueList}</div>`;
          submitBtn.disabled = true;
          document.getElementById('test-summary').textContent = `${issues.length} blocking issue${issues.length===1?'':'s'} · revise design and re-run`;
        }
      }

      // Wire test chamber buttons
      document.getElementById('test-close')?.addEventListener('click', closeTestChamber);
      document.getElementById('test-modal')?.addEventListener('click', (e) => {
        if (e.target.id === 'test-modal') closeTestChamber();   // click backdrop
      });
      document.getElementById('test-rerun')?.addEventListener('click', () => {
        loadTestAircraft();
        runTestSequence();
      });
      // AUTO-BALANCE button: applies symmetry + rotor rebalancing, reloads test aircraft, re-runs tests
      document.getElementById('test-autofix')?.addEventListener('click', () => {
        if (typeof pushUndo === 'function') pushUndo();
        const result = applyAutoBalance();
        // Visual confirmation in the chat history
        const hist = document.getElementById('ai-history');
        if (hist) {
          const div = document.createElement('div');
          div.className = 'chat-msg ai info';
          const list = result.fixes.length
            ? result.fixes.map(f => `<div>• ${f}</div>`).join('')
            : '<div>• design already balanced</div>';
          div.innerHTML = `<div class="chat-result"><span class="check">⚙</span>auto-balance applied${list}</div>`;
          hist.appendChild(div);
          hist.scrollTop = hist.scrollHeight;
        }
        // Re-load + re-run tests with the rebalanced design
        setTimeout(() => {
          loadTestAircraft();
          runTestSequence();
        }, 250);
      });
      document.getElementById('test-submit')?.addEventListener('click', () => {
        const tail = document.getElementById('tail-number').value || 'SDX-0001';
        closeTestChamber();
        // Show manufacturing-complete modal — stays open until user clicks the deploy button
        document.getElementById('modal-detail').textContent = `UNIT ${tail} · LINE 03 · 14 DAYS`;
        document.getElementById('modal').classList.add('active');
      });

      // SYMMETRY button — mirror parts across centerline so left = right
      document.getElementById('btn-symmetry')?.addEventListener('click', (e) => {
        if (partsRegistry.size === 0) return;
        if (typeof pushUndo === 'function') pushUndo();
        const result = applySymmetry();
        e.currentTarget.classList.add('flash');
        setTimeout(() => e.currentTarget.classList.remove('flash'), 500);
        const hist = document.getElementById('ai-history');
        if (hist) {
          const div = document.createElement('div');
          div.className = 'chat-msg ai info';
          const created = result.created.length;
          const snapped = result.snapped.length / 2;
          div.innerHTML = `<div class="chat-result"><span class="check">⇋</span>symmetry applied · ${created ? `mirrored ${created} new part${created===1?'':'s'}` : ''}${created && snapped ? ' · ' : ''}${snapped ? `aligned ${snapped} pair${snapped===1?'':'s'}` : ''}${!created && !snapped ? 'design was already symmetric' : ''}</div>`;
          hist.appendChild(div);
          hist.scrollTop = hist.scrollHeight;
        }
      });
      // EQUALIZE button — same-kind parts get matching dimensions
      document.getElementById('btn-equalize')?.addEventListener('click', (e) => {
        if (partsRegistry.size === 0) return;
        if (typeof pushUndo === 'function') pushUndo();
        const result = applyEqualizeDimensions();
        e.currentTarget.classList.add('flash');
        setTimeout(() => e.currentTarget.classList.remove('flash'), 500);
        const hist = document.getElementById('ai-history');
        if (hist) {
          const div = document.createElement('div');
          div.className = 'chat-msg ai info';
          const count = result.equalized.length;
          div.innerHTML = `<div class="chat-result"><span class="check">⏛</span>equalized dimensions · ${count ? `${count} part${count===1?'':'s'} resized to group average across ${result.kinds.length} kind${result.kinds.length===1?'':'s'}` : 'no equalizable groups found (need at least 2 parts of the same kind)'}</div>`;
          hist.appendChild(div);
          hist.scrollTop = hist.scrollHeight;
        }
      });
      // Esc closes the test chamber
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && document.getElementById('test-modal')?.classList.contains('active')) {
          closeTestChamber();
        }
      });

      // ====================================================================
      // COMMERCIAL HUB FLEET — post-manufacturing deployment view
      // The aircraft enters service, gets a route, telemetry streams live.
      // ====================================================================
      let fleetScene = null, fleetCamera = null, fleetRenderer = null, fleetGroup = null;
      let fleetRotors = [];
      let fleetActive = false;
      let fleetStartTime = 0;
      let fleetClockInterval = null;
      let fleetTelemInterval = null;

      // Telemetry simulation state — slowly evolving so it feels live
      const fleetTelem = {
        altitude: 320,        // meters — typical urban air taxi cruise altitude
        targetAltitude: 320,
        groundSpeed: 145,     // km/h
        heading: 47,          // degrees
        battery: 78,          // percent
        rangeRemaining: 92,   // km
        passengers: 3,
        capacity: 4,
        etaMinutes: 14,
        distanceKm: 28.4,
        flightHours: 0,
        flightMinutes: 0,
        verticalRate: 0,
        phase: 'cruise',      // takeoff | climb | cruise | descent | landing
      };

      function ensureFleetScene() {
        if (fleetScene) return;
        const canvas = document.getElementById('fleet-canvas');
        fleetRenderer = new THREE.WebGLRenderer({ canvas, antialias: true, alpha: true });
        fleetRenderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
        fleetRenderer.toneMapping = THREE.ACESFilmicToneMapping;
        fleetRenderer.toneMappingExposure = 1.4;
        fleetScene = new THREE.Scene();
        fleetScene.fog = new THREE.Fog(0x050a18, 12, 38);
        fleetCamera = new THREE.PerspectiveCamera(38, 1, 0.1, 100);
        fleetCamera.position.set(7, 4.5, 9);
        fleetCamera.lookAt(0, 1.5, 0);

        // Cinematic lighting — sunset-over-city vibe
        fleetScene.add(new THREE.HemisphereLight(0xb88a6f, 0x1a2848, 0.6));
        fleetScene.add(new THREE.AmbientLight(0xffd0a0, 0.18));
        const sun = new THREE.DirectionalLight(0xffb070, 1.4);
        sun.position.set(5, 6, 4);
        sun.castShadow = true;
        sun.shadow.mapSize.set(1024, 1024);
        fleetScene.add(sun);
        const cool = new THREE.DirectionalLight(0x6080c0, 0.55);
        cool.position.set(-4, 5, -3);
        fleetScene.add(cool);
        const accent = new THREE.PointLight(0x00E5FF, 0.7, 18);
        accent.position.set(-5, 3, 4);
        fleetScene.add(accent);

        // Ground plane — concentric range rings to suggest a city map
        const ringMat = new THREE.LineBasicMaterial({ color: 0x00E5FF, transparent: true, opacity: 0.16 });
        for (const r of [4, 8, 12, 16]) {
          const pts = [];
          for (let i = 0; i <= 64; i++) {
            const a = (i / 64) * Math.PI * 2;
            pts.push(new THREE.Vector3(Math.cos(a) * r, -1, Math.sin(a) * r));
          }
          const g = new THREE.BufferGeometry().setFromPoints(pts);
          fleetScene.add(new THREE.Line(g, ringMat));
        }
        // Crosshair lines through center (cardinal directions)
        const crossMat = new THREE.LineBasicMaterial({ color: 0x00E5FF, transparent: true, opacity: 0.2 });
        for (const [a, b] of [[[-16, -1, 0], [16, -1, 0]], [[0, -1, -16], [0, -1, 16]]]) {
          const g = new THREE.BufferGeometry().setFromPoints([new THREE.Vector3(...a), new THREE.Vector3(...b)]);
          fleetScene.add(new THREE.Line(g, crossMat));
        }
        // Dark floor disc
        const floor = new THREE.Mesh(
          new THREE.CircleGeometry(20, 64),
          new THREE.MeshStandardMaterial({ color: 0x040a18, roughness: 1, metalness: 0 })
        );
        floor.rotation.x = -Math.PI / 2;
        floor.position.y = -1.001;
        floor.receiveShadow = true;
        fleetScene.add(floor);
        // Distant city blocks — random low boxes scattered around
        const buildingMat = new THREE.MeshStandardMaterial({ color: 0x081429, roughness: 0.9, metalness: 0.05, emissive: 0x000810, emissiveIntensity: 0.4 });
        for (let i = 0; i < 32; i++) {
          const ang = Math.random() * Math.PI * 2;
          const dist = 8 + Math.random() * 9;
          const w = 0.6 + Math.random() * 1.4;
          const h = 0.8 + Math.random() * 2.6;
          const d = 0.6 + Math.random() * 1.4;
          const b = new THREE.Mesh(new THREE.BoxGeometry(w, h, d), buildingMat);
          b.position.set(Math.cos(ang) * dist, -1 + h / 2, Math.sin(ang) * dist);
          b.rotation.y = Math.random() * Math.PI;
          fleetScene.add(b);
        }

        // Aircraft container
        fleetGroup = new THREE.Group();
        fleetScene.add(fleetGroup);

        function resize() {
          if (!canvas.parentElement) return;
          const w = canvas.parentElement.clientWidth;
          const h = canvas.parentElement.clientHeight;
          fleetRenderer.setSize(w, h, false);
          fleetCamera.aspect = w / h;
          fleetCamera.updateProjectionMatrix();
        }
        resize();
        window.addEventListener('resize', resize);

        function tickFleet() {
          requestAnimationFrame(tickFleet);
          if (!fleetActive) return;
          const t = (performance.now() - fleetStartTime) / 1000;
          // Aircraft slowly orbits the camera target while gently bobbing
          const orbitR = 2.5;
          const orbitSpeed = 0.18;
          fleetGroup.position.x = Math.cos(t * orbitSpeed) * orbitR;
          fleetGroup.position.z = Math.sin(t * orbitSpeed) * orbitR;
          fleetGroup.position.y = 1.3 + Math.sin(t * 0.6) * 0.08;
          fleetGroup.rotation.y = t * orbitSpeed + Math.PI / 2;
          // Gentle bank into the turn
          fleetGroup.rotation.z = -0.08;
          fleetGroup.rotation.x = Math.sin(t * 0.7) * 0.015;
          fleetRotors.forEach(r => r.rotation.y += 0.95);
          // Camera also slowly orbits for cinematic feel
          fleetCamera.position.x = Math.cos(t * 0.05 + 0.5) * 9;
          fleetCamera.position.z = Math.sin(t * 0.05 + 0.5) * 9;
          fleetCamera.lookAt(0, 1.5, 0);
          fleetRenderer.render(fleetScene, fleetCamera);
        }
        tickFleet();
      }

      function loadAircraftIntoFleet() {
        if (!fleetGroup) return;
        // Wipe previous
        while (fleetGroup.children.length) {
          fleetGroup.remove(fleetGroup.children[0]);
        }
        fleetRotors.length = 0;
        const cloned = taxi.clone(true);
        cloned.traverse(o => {
          if (o.userData?.partName) {
            const info = partsRegistry.get(o.userData.partName);
            if (info?.kind === 'rotor') fleetRotors.push(o);
          }
          if (o.isMesh) o.castShadow = true;
        });
        fleetGroup.add(cloned);
      }

      // Realistic-feeling random pad names + routes
      const PAD_POOL = [
        'SFO-PAD-01', 'OAK-VERT-3', 'SJC-NORTH', 'PALO ALTO-A',
        'BERKELEY-2', 'EMERY-PAD', 'MISSION BAY', 'FREMONT-VPAD',
        'MARIN-PAD-N', 'PRESIDIO-1', 'EMBARCADERO-7', 'MENLO-PARK-2'
      ];
      function pickRoute() {
        const a = PAD_POOL[Math.floor(Math.random() * PAD_POOL.length)];
        let b;
        do { b = PAD_POOL[Math.floor(Math.random() * PAD_POOL.length)]; } while (b === a);
        return { from: a, to: b };
      }

      // Generate sister fleet vehicles (just IDs and statuses for the list)
      function generateFleet(activeId) {
        const states = ['CRUISING', 'CHARGING', 'STANDBY', 'CRUISING', 'BOARDING'];
        const list = [];
        // Active vehicle first
        list.push({ id: activeId, status: 'CRUISING', battery: fleetTelem.battery, active: true });
        // 4 sister aircraft with derived IDs
        for (let i = 0; i < 4; i++) {
          const idNum = (Math.floor(Math.random() * 9000) + 1000).toString();
          const id = `SDX-${idNum}`;
          const status = states[Math.floor(Math.random() * states.length)];
          const battery = status === 'CHARGING' ? 30 + Math.floor(Math.random() * 40) :
                          status === 'STANDBY' ? 95 + Math.floor(Math.random() * 5) :
                          50 + Math.floor(Math.random() * 45);
          list.push({ id, status, battery, active: false });
        }
        return list;
      }

      function renderFleetList(list) {
        const el = document.getElementById('fleet-list');
        if (!el) return;
        el.innerHTML = '';
        for (const v of list) {
          const item = document.createElement('div');
          item.className = 'fleet-list-item' + (v.active ? ' active' : '');
          const dotClass = v.status === 'CHARGING' ? 'charging' : v.status === 'STANDBY' ? 'standby' : '';
          item.innerHTML = `
            <span class="dot ${dotClass}"></span>
            <span class="id">${v.id}</span>
            <span class="stat">${v.status}</span>
            <span class="pct">${v.battery}%</span>
          `;
          el.appendChild(item);
        }
      }

      function startFleetTelemetry() {
        // Pick a route
        const route = pickRoute();
        document.getElementById('rt-from').textContent = route.from;
        document.getElementById('rt-to').textContent = route.to;
        const tail = document.getElementById('tail-number')?.value || 'SDX-0001';
        const op = document.getElementById('operator')?.value || 'SDX OPERATIONS';
        document.getElementById('tm-tail').textContent = tail;
        document.getElementById('tm-op').textContent = op || '—';
        document.getElementById('vtag-id').textContent = tail;

        // Initial telemetry seed
        fleetTelem.altitude = 280 + Math.random() * 80;
        fleetTelem.targetAltitude = fleetTelem.altitude;
        fleetTelem.groundSpeed = 130 + Math.random() * 30;
        fleetTelem.heading = Math.floor(Math.random() * 360);
        fleetTelem.battery = 72 + Math.random() * 18;
        fleetTelem.passengers = 1 + Math.floor(Math.random() * 4);
        fleetTelem.capacity = Math.max(fleetTelem.passengers, 4);
        fleetTelem.etaMinutes = 8 + Math.floor(Math.random() * 18);
        fleetTelem.distanceKm = fleetTelem.etaMinutes * (fleetTelem.groundSpeed / 60);
        fleetTelem.rangeRemaining = (fleetTelem.battery / 100) * 120; // 120km full charge
        fleetTelem.flightHours = 0;
        fleetTelem.flightMinutes = 0;
        fleetTelem.verticalRate = 0;
        fleetTelem.phase = 'cruise';

        renderFleetList(generateFleet(tail));
        updateFleetTelemetryDisplay();

        // Tick telemetry every second
        if (fleetTelemInterval) clearInterval(fleetTelemInterval);
        fleetTelemInterval = setInterval(() => {
          // Drift altitude target every ~10s
          if (Math.random() < 0.1) {
            fleetTelem.targetAltitude = 220 + Math.random() * 180;
          }
          // Move toward target altitude
          const altDelta = fleetTelem.targetAltitude - fleetTelem.altitude;
          fleetTelem.verticalRate = Math.sign(altDelta) * Math.min(Math.abs(altDelta) * 0.1, 4);
          fleetTelem.altitude += fleetTelem.verticalRate;
          // Speed wanders
          fleetTelem.groundSpeed += (Math.random() - 0.5) * 4;
          fleetTelem.groundSpeed = Math.max(80, Math.min(180, fleetTelem.groundSpeed));
          // Heading slowly drifts
          fleetTelem.heading = (fleetTelem.heading + (Math.random() - 0.5) * 6 + 360) % 360;
          // Battery depletes — about 1% per 90 sec (relative to a full 60min flight)
          fleetTelem.battery = Math.max(0, fleetTelem.battery - 0.012);
          fleetTelem.rangeRemaining = (fleetTelem.battery / 100) * 120;
          // ETA + distance count down
          fleetTelem.distanceKm = Math.max(0, fleetTelem.distanceKm - (fleetTelem.groundSpeed / 3600));
          fleetTelem.etaMinutes = fleetTelem.distanceKm > 0
            ? (fleetTelem.distanceKm / (fleetTelem.groundSpeed / 60))
            : 0;
          // Flight time accumulates
          fleetTelem.flightMinutes++;
          if (fleetTelem.flightMinutes >= 60) {
            fleetTelem.flightMinutes = 0;
            fleetTelem.flightHours++;
          }
          // If we arrived, pick a new route
          if (fleetTelem.distanceKm < 0.5) {
            const newRoute = pickRoute();
            document.getElementById('rt-from').textContent = newRoute.to; // we just came from there
            document.getElementById('rt-to').textContent = newRoute.from === newRoute.to ? PAD_POOL[0] : newRoute.from;
            fleetTelem.distanceKm = 15 + Math.random() * 25;
            fleetTelem.etaMinutes = fleetTelem.distanceKm / (fleetTelem.groundSpeed / 60);
            fleetTelem.passengers = Math.floor(Math.random() * (fleetTelem.capacity + 1));
          }
          updateFleetTelemetryDisplay();
        }, 1000);

        // Clock ticks at real time
        if (fleetClockInterval) clearInterval(fleetClockInterval);
        fleetClockInterval = setInterval(() => {
          const d = new Date();
          const hh = d.getUTCHours().toString().padStart(2, '0');
          const mm = d.getUTCMinutes().toString().padStart(2, '0');
          const ss = d.getUTCSeconds().toString().padStart(2, '0');
          document.getElementById('fleet-clock').textContent = `${hh}:${mm}:${ss} UTC`;
        }, 1000);
        // First tick now
        const d = new Date();
        document.getElementById('fleet-clock').textContent =
          `${d.getUTCHours().toString().padStart(2,'0')}:${d.getUTCMinutes().toString().padStart(2,'0')}:${d.getUTCSeconds().toString().padStart(2,'0')} UTC`;
      }

      function stopFleetTelemetry() {
        if (fleetTelemInterval) { clearInterval(fleetTelemInterval); fleetTelemInterval = null; }
        if (fleetClockInterval) { clearInterval(fleetClockInterval); fleetClockInterval = null; }
      }

      function updateFleetTelemetryDisplay() {
        const set = (id, v) => { const el = document.getElementById(id); if (el) el.textContent = v; };
        set('tm-alt', Math.round(fleetTelem.altitude) + ' m');
        set('tm-spd', Math.round(fleetTelem.groundSpeed) + ' km/h');
        set('tm-hdg', Math.round(fleetTelem.heading) + '°');
        const vrSign = fleetTelem.verticalRate >= 0 ? '+' : '';
        set('tm-vrate', vrSign + fleetTelem.verticalRate.toFixed(1) + ' m/s');
        set('tm-batt', Math.round(fleetTelem.battery) + '%');
        // Battery bar color shifts as it drains
