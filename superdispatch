            return {
              parsed: `<span class="pkey">action:</span> <span class="pval">SET_TAIL_NUMBER</span>`,
              result: `<span class="check">✓</span>tail: <span class="val">${cmd.value}</span> &nbsp; build: <span class="val">${buildId}</span>`
