      }

      function startMaintPatrol() {
        if (padCrewMaintInterval) return;
        const tick = () => {
          try {
            const target = pickRandomParkedDesignId();
            if (target && typeof window.__assignCrewWork === 'function') {
              window.__assignCrewWork('MAINT', target, 2000 + Math.random() * 1500);
              // Post a contextually accurate text message too — the
              // mechanic visibly walks AND the chat panel reflects
              // what they're doing, so the player gets confirmation
              // from two sources.
              try {
                const designs = (typeof getAllSavedDesigns === 'function') ? getAllSavedDesigns() : [];
                const ac = designs.find(d => d.id === target);
                const tail = (ac && ac.tailNumber) || 'SDX-####';
                const mech = pickCrewByRole('MAINT');
                if (mech) {
                  const actions = [
                    `inspecting <span class="tail">${tail}</span> rotor assembly`,
                    `running diagnostics on <span class="tail">${tail}</span>`,
                    `checking <span class="tail">${tail}</span> battery thermals`,
                    `verifying <span class="tail">${tail}</span> firmware version`,
                    `clearing <span class="tail">${tail}</span> for next flight`,
                  ];
                  postCrewMessage(mech, actions[Math.floor(Math.random() * actions.length)]);
                }
              } catch (_) {}
            } else {
              // No parked aircraft — entire fleet is airborne. Mechanic
              // wanders to a random spot so they don't freeze in place
              // until something lands. The user reported workers
              // "frozen" after launches; this prevents that visual.
              if (typeof window.__assignCrewWanderTo === 'function') {
                window.__assignCrewWanderTo('MAINT');
              }
            }
          } catch (_) {}
