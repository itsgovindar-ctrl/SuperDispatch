      // Serialize the design into a saveable object
      function serializeDesign(name) {
        const partsMeta = {};
        // Walk the taxi tree and capture name/kind/type for every named part
        for (const [pname, info] of partsRegistry) {
          if (info.object) {
            partsMeta[info.object.uuid] = {
              name: pname,
              kind: info.kind,
              type: info.type
            };
          }
        }
        // Bake geometry transforms before serialization. Three.js's toJSON for
        // primitive geometries (CapsuleGeometry, SphereGeometry, CylinderGeometry,
        // etc.) stores only the CONSTRUCTOR PARAMETERS, NOT the actual vertex
        // positions. Any geo.rotateZ()/scale()/translate() calls applied after
        // creation are baked into the vertex buffer but LOST when toJSON only
        // serializes (radius, length, segments). On reload, the loader calls
        // new CapsuleGeometry(...) and gets a fresh default-orientation primitive.
        //
        // This is the root cause of: booms turning vertical, fuselages rotating
        // 90°, cockpits reverting to unit-sphere scale, and the design changing
        // between mfg and pad views.
        //
        // Fix: walk the taxi tree, replace each primitive geometry with a generic
        // BufferGeometry that contains the actual baked vertex data. Save originals
        // so we can restore them after the JSON snapshot is taken (otherwise the
        // mfg view's live meshes would lose their primitive-type metadata).
        const geomBackups = [];
        const PRIMITIVE_TYPES = new Set([
          'BoxGeometry', 'CapsuleGeometry', 'CircleGeometry', 'ConeGeometry',
          'CylinderGeometry', 'DodecahedronGeometry', 'IcosahedronGeometry',
          'OctahedronGeometry', 'PlaneGeometry', 'RingGeometry', 'SphereGeometry',
          'TetrahedronGeometry', 'TorusGeometry', 'TorusKnotGeometry',
          'TubeGeometry', 'LatheGeometry', 'ShapeGeometry', 'ExtrudeGeometry',
          'EdgesGeometry', 'WireframeGeometry'
        ]);
        function bakeGeometryToBuffer(mesh) {
          const g = mesh.geometry;
          if (!g || !g.type || !PRIMITIVE_TYPES.has(g.type)) return;
          // OPTIMIZATION: most parts use their primitive's default vertex data
          // unchanged — toJSON serializes those as just the constructor params
          // (~10 numbers). Only bake to a full BufferGeometry if the vertex
          // data has actually been DEFORMED (geo.rotateZ/scale/translate
          // applied after construction). Without this gate, every saved
          // design balloons because every primitive's full vertex grid
          // (positions + normals + uvs, often 1000+ floats each) gets
          // serialized — easily blowing past localStorage's quota with
          // a few designs.
          //
          // Detection: rebuild a fresh primitive with the same params, then
          // compare its position attribute to the live mesh's. If they
          // match within float tolerance, the geo is undeformed and we
          // skip baking. If they differ, bake (the deformation needs to
          // survive the save/load round-trip — that's the booms-vertical
          // bug being prevented).
          let isDeformed = true;     // assume worst case
          try {
            const params = g.parameters;
            if (params && THREE[g.type]) {
              const FreshCtor = THREE[g.type];
              // Construct a fresh primitive using the same parameters.
              // Different geometry types have different param orders; we use
              // the param object's own values in their stored order.
              const paramVals = Object.values(params);
              const fresh = new FreshCtor(...paramVals);
              const a = g.attributes.position?.array;
              const b = fresh.attributes.position?.array;
              if (a && b && a.length === b.length) {
                let diff = 0;
                for (let i = 0; i < a.length; i++) {
                  const d = Math.abs(a[i] - b[i]);
                  if (d > 1e-5) { diff++; if (diff > 0) break; }
                }
                isDeformed = diff > 0;
              }
              // Free the temporary fresh geometry's GPU buffers
              fresh.dispose && fresh.dispose();
            }
          } catch (e) {
            // If we can't construct a fresh primitive (unusual params, etc.)
            // fall back to bake-always behavior — correctness over size.
            isDeformed = true;
          }
          if (!isDeformed) {
            // Primitive is at its default — keep it as a primitive so toJSON
            // serializes only constructor params (tiny). No bake needed.
            return;
          }
          // Build a plain BufferGeometry holding the actual current vertex data.
          // toJSON on a plain BufferGeometry serializes the attribute arrays.
          const baked = new THREE.BufferGeometry();
          for (const attrName of Object.keys(g.attributes)) {
            const src = g.attributes[attrName];
            // Clone the typed array so the baked copy is independent
            const arr = src.array.constructor.from(src.array);
            baked.setAttribute(attrName, new THREE.BufferAttribute(arr, src.itemSize, src.normalized));
          }
          if (g.index) {
            const idxArr = g.index.array.constructor.from(g.index.array);
            baked.setIndex(new THREE.BufferAttribute(idxArr, 1));
          }
          if (g.groups && g.groups.length) {
            baked.groups = g.groups.map(grp => ({ ...grp }));
          }
          if (g.boundingBox) baked.boundingBox = g.boundingBox.clone();
          if (g.boundingSphere) baked.boundingSphere = g.boundingSphere.clone();
          // Stash original for restore-after-save
          geomBackups.push({ mesh, original: g });
          mesh.geometry = baked;
        }
        try {
          taxi.traverse(o => {
            if (o.isMesh || o.isLineSegments) bakeGeometryToBuffer(o);
          });
        } catch (e) {
          console.warn('[save] geometry-bake failed:', e);
        }
        let sceneJson;
        try {
          sceneJson = taxi.toJSON();
        } finally {
          // Always restore originals — mfg view must keep its primitive geometries
          // unchanged so the live editor continues to work normally.
          for (const { mesh, original } of geomBackups) {
            mesh.geometry = original;
          }
        }
        return {
          version: 1,
          id: 'design_' + Date.now(),
          name: name,
          tailNumber: document.getElementById('tail-number')?.value || '',
          operator:   document.getElementById('operator')?.value   || '',
          savedAt: Date.now(),
          scene: sceneJson,
          partsMeta,
          materials: {
            primary: materials.primary.color.getHex(),
            accent:  materials.accent.color.getHex(),
            trim:    materials.trim.color.getHex()
          }
        };
      }

      function performSave() {
        const nameInput = document.getElementById('save-name-input');
        const status = document.getElementById('save-status');
        const tail = document.getElementById('tail-number')?.value || 'SDX';
        const name = (nameInput.value || nameInput.placeholder || `${tail} ${new Date().toLocaleDateString()}`).trim();
        if (!name) {
          status.textContent = 'Please enter a name.';
          status.className = 'save-status err';
          return;
        }
        let design;
        try {
          design = serializeDesign(name);
        } catch (e) {
          status.textContent = 'Serialization failed: ' + e.message;
          status.className = 'save-status err';
          return;
        }
        const existing = getAllSavedDesigns();
        existing.push(design);
        const ok = persistDesigns(existing);
        const recoveryMsg = (typeof getLastPersistStatusMsg === 'function')
          ? getLastPersistStatusMsg() : '';
        if (!ok) {
          // True failure — even after dropping everything else, this design
          // alone is too big. Surface the specific reason so the user knows
          // it's not just generic "storage full." This is the only case
          // that should ever still show an error after recovery.
          status.textContent = recoveryMsg || 'Storage full or unavailable.';
          status.className = 'save-status err';
          return;
        }
        // Save succeeded — but maybe required dropping old designs. Surface
        // that message clearly (yellow warning, not red error) so the user
        // knows what happened.
        if (recoveryMsg) {
          status.textContent = `✓ Saved "${name}" — ${recoveryMsg}`;
          status.className = 'save-status warn';
        } else {
          status.textContent = `✓ Saved as "${name}"`;
          status.className = 'save-status ok';
        }
        designJustSaved = { id: design.id, name: design.name, tailNumber: design.tailNumber, operator: design.operator };
        // Close save dialog after a brief moment, then close fleet → open launch pad.
        // Give the user longer to read the recovery message if there was one.
        const closeDelay = recoveryMsg ? 2400 : 800;
        setTimeout(() => {
          closeSaveDialog();
          closeFleetView();
          openLaunchPad();
        }, closeDelay);
      }

      document.getElementById('fleet-save')?.addEventListener('click', openSaveDialog);
      document.getElementById('save-cancel')?.addEventListener('click', closeSaveDialog);
      document.getElementById('save-confirm')?.addEventListener('click', performSave);
      document.getElementById('save-name-input')?.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') { e.preventDefault(); performSave(); }
        else if (e.key === 'Escape') { e.preventDefault(); closeSaveDialog(); }
      });

      // ====================================================================
      // LAUNCH PAD — aircraft sitting on a pad waiting for orders
      // ====================================================================
      let padScene = null, padCamera = null, padRenderer = null, padGroup = null;
      let padControls = null;          // OrbitControls — user can drag/zoom around the scene
      let padManualCam = false;        // true when user is manually controlling the camera
      let padManualCamTime = 0;        // last interaction timestamp; auto-cam resumes 4s after
      // padStickyCam — set when the user explicitly picks a preset
      // button (TOP / SIDE / BACK / GROUND). Sticky views DON'T expire
      // after 4 seconds — only AUTO or another preset clears them.
      // Without this, picking a preset gave a 4-second preview before
      // auto-cam yanked the camera back, which the user reported as the
      // bird's-eye view being "obstructed".
      let padStickyCam = false;
      // ===== GROUND CAM (first-person on the street) =====
      // When active, the camera becomes a person walking the streets between buildings.
      // WASD moves on the ground plane, mouse rotates the view. Gravity-locked at eye height.
      // OrbitControls is disabled while in ground mode.
      let padGroundCam = false;
      // Expose a setter so outer-scope code (cabin view) can turn off
      // ground walk mode without needing direct access to this lexical
      // variable. Also handles the side-effects (overlay, cursor,
      // OrbitControls) consistently with the GROUND/AUTO button handlers.
      window.__setPadGroundCam = (on) => {
        padGroundCam = !!on;
        if (padControls) padControls.enabled = !padGroundCam;
        const overlay = document.getElementById('pad-ground-hud');
        if (overlay) overlay.style.display = padGroundCam ? 'flex' : 'none';
        const canvas = document.getElementById('pad-canvas');
        if (canvas) canvas.style.cursor = padGroundCam ? 'grab' : '';
      };
      const padGroundState = {
        pos: new THREE.Vector3(8, 1.7, 8),     // start near hub, eye height ~1.7m
        yaw: -Math.PI * 0.75,                   // facing toward hub
        pitch: 0.15,                            // slight upward tilt to see flying taxi
        keys: { w: false, a: false, s: false, d: false, shift: false },
        mouseLook: false,                       // pointer-locked mouse-look mode
        speed: 4.5                              // m/s walking speed (sprint ×2)
      };

      // ============================================================================
      // CABIN INTERIOR — luxury eVTOL cabin built procedurally and parented
      // to the customer's aircraft. Visible only in cabin view (toggled via
      // visible flag from the cabin-cam block). Otherwise the user looking
      // around inside their saved aircraft would see only the raw mesh
      // parts they built (rotors, fuselage struts) which looks like
      // floating pieces — not a cohesive interior.
      //
      // Geometry conventions:
      //   - origin at aircraft center (cabinAircraft.position)
      //   - +X is to the right of the cabin from the seated passenger's POV
      //   - +Y is up
      //   - -Z is forward (toward the cockpit / direction of travel)
      //
      // The seat camera sits at (0, 0.6, +0.4) in this local frame: a touch
      // back from center and 0.6u up. Interior is sized to wrap that point
      // comfortably without clipping into the user's view.
      // ============================================================================
      let cabinInteriorGroup = null;     // current interior, or null

      // Detect whether an aircraft has a Joby/Wisk/Archer-style fuselage —
      // i.e., a mesh part that is clearly shaped like a passenger body
      // (long, narrow, tall enough for a seated person). If yes, the user's
      // design is eligible for the luxury cabin interior. If no, we skip
      // the luxury build because overlaying a fancy cabin on a quadcopter,
      // hexacopter, or other non-fuselage form factor looks wrong — the
      // luxury walls + windows don't fit the vehicle's actual shape.
      //
      // Heuristic: walk every mesh, compute its world-frame bounding box,
      // and look for ONE mesh whose proportions are clearly fuselage-like.
      // Thresholds (post-fitScale, world frame):
      //   length >= 2.0u  — substantial body, not a small frame strut
      //   aspect >= 1.8   — clearly longer than wide (rotor blades fail
      //                     on this because their height is too low)
      //   height >= 0.4u  — tall enough to plausibly hold a seated person
      // A lone wing or rotor blade fails the height test (typically <0.3u).
      // A central body of a multirotor fails the length+aspect test.
      function hasFuselageMesh(acGroup) {
        if (!acGroup) return false;
        let found = false;
        const tempBox = new THREE.Box3();
        const tempSize = new THREE.Vector3();
        // Measure in LOCAL frame (acGroup scale = 1) so the heuristic
        // doesn't reject legitimate fuselages whose world-frame size is
        // shrunk by fitScale below the 2.0u length threshold.
        const prevScale = acGroup.scale.clone();
        acGroup.scale.set(1, 1, 1);
        acGroup.updateMatrixWorld(true);
        try {
          acGroup.traverse((obj) => {
            if (found || !obj.isMesh || !obj.geometry) return;
            try {
              tempBox.setFromObject(obj);
              tempBox.getSize(tempSize);
            } catch (_) { return; }
            const length = Math.max(tempSize.x, tempSize.z);
            const width = Math.min(tempSize.x, tempSize.z);
            if (width < 0.001) return;
            const aspect = length / width;
            if (aspect >= 1.8 && length >= 2.0 && tempSize.y >= 0.4) {
              found = true;
            }
          });
        } finally {
          acGroup.scale.copy(prevScale);
          acGroup.updateMatrixWorld(true);
        }
        return found;
      }

      // Find the largest fuselage-like mesh and return its size in the
      // aircraft's LOCAL frame (so it doesn't include any acGroup scaling).
      // Used by buildCabinInterior to size the cabin proportionally to the
      // actual aircraft body, instead of using fixed real-world dimensions
      // that may overshoot designs with widely-spaced rotors (the "brown
      // blob" bug — cabin walls visibly bigger than the aircraft fuselage).
      // Returns { length, height, width } in local units, or null if no
      // fuselage qualifies.
      function getFuselageBoundsLocal(acGroup) {
        if (!acGroup) return null;
        // Measure entirely in LOCAL frame so we both qualify the fuselage
        // AND get its true (unscaled) dimensions in one pass.
        const prevScale = acGroup.scale.clone();
        acGroup.scale.set(1, 1, 1);
        acGroup.updateMatrixWorld(true);
        let bestMesh = null;
        let bestVolume = 0;
        const tempBox = new THREE.Box3();
        const tempSize = new THREE.Vector3();
        try {
          acGroup.traverse((obj) => {
            if (!obj.isMesh || !obj.geometry) return;
            try {
              tempBox.setFromObject(obj);
              tempBox.getSize(tempSize);
            } catch (_) { return; }
            const length = Math.max(tempSize.x, tempSize.z);
            const width = Math.min(tempSize.x, tempSize.z);
            if (width < 0.001) return;
            const aspect = length / width;
            if (aspect >= 1.8 && length >= 2.0 && tempSize.y >= 0.4) {
              const vol = tempSize.x * tempSize.y * tempSize.z;
              if (vol > bestVolume) {
                bestVolume = vol;
                bestMesh = obj;
              }
            }
          });
        } catch (_) {}
        if (!bestMesh) {
          acGroup.scale.copy(prevScale);
          acGroup.updateMatrixWorld(true);
          return null;
        }
        // Measure best fuselage in local frame
        let result = null;
        try {
          tempBox.setFromObject(bestMesh);
          tempBox.getSize(tempSize);
          // Aircraft nose points along local -X, so length is on X axis
          result = {
            length: tempSize.x,
            height: tempSize.y,
            width:  tempSize.z,
          };
        } catch (_) {}
        acGroup.scale.copy(prevScale);
        acGroup.updateMatrixWorld(true);
        return result;
      }
      // Expose for debugging + tests
      window.__hasFuselageMesh = hasFuselageMesh;
      window.__getFuselageBoundsLocal = getFuselageBoundsLocal;

      function buildCabinInterior(acGroup) {
        if (!acGroup || !padScene) return;
        // Tear down any previous instance so we don't stack interiors
        destroyCabinInterior();
        // Gate: only Joby/Wisk/Archer-style designs (with a real fuselage)
        // get the luxury cabin. Other designs (multirotors, weird configs)
        // skip the luxury build — the user sees their actual aircraft mesh,
        // which is more honest than overlaying luxury walls + windows that
        // don't fit the vehicle's form factor.
        if (!hasFuselageMesh(acGroup)) {
          cabinInteriorGroup = null;
          return;
        }
        const cabin = new THREE.Group();
        cabin.name = 'cabinInterior';
        cabin.userData.isCabinInterior = true;

        // ===== Materials (luxury palette) =====
        const carpetMat = new THREE.MeshStandardMaterial({
          color: 0x1a1f2e, roughness: 0.92, metalness: 0.0
        });
        const ceilingMat = new THREE.MeshStandardMaterial({
          color: 0xe8d8b8, roughness: 0.55, metalness: 0.05,
          emissive: 0xfff0d0, emissiveIntensity: 0.08
        });
        const wallMat = new THREE.MeshStandardMaterial({
          color: 0x3a4150, roughness: 0.65, metalness: 0.15
        });
        const trimMat = new THREE.MeshStandardMaterial({
          color: 0xc8a878, roughness: 0.35, metalness: 0.85,
          emissive: 0x4a3818, emissiveIntensity: 0.15
        });
        const seatMat = new THREE.MeshStandardMaterial({
          color: 0x6a5440, roughness: 0.55, metalness: 0.05
        });
        const seatCushionMat = new THREE.MeshStandardMaterial({
          color: 0x4a3828, roughness: 0.7, metalness: 0.0
        });
        const glassMat = new THREE.MeshStandardMaterial({
          color: 0x88aacc, roughness: 0.05, metalness: 0.1,
          transparent: true, opacity: 0.18,
          envMapIntensity: 1.0, side: THREE.DoubleSide
        });
        const dashMat = new THREE.MeshStandardMaterial({
          color: 0x1a1d24, roughness: 0.4, metalness: 0.55
        });
        const screenMat = new THREE.MeshStandardMaterial({
          color: 0x081224, roughness: 0.2, metalness: 0.0,
          emissive: 0x00b0cc, emissiveIntensity: 0.6
        });

        // ===== Cabin shell — floor, ceiling, walls, bulkheads =====
        // Size the cabin to fit INSIDE the aircraft's fuselage, not at
        // arbitrary real-world dimensions. Without this, designs whose
        // fuselage is smaller than 1.6 × 1.5 × 3.0u would have cabin
        // walls poking out through the aircraft skin (the "brown blob"
        // bug — gigantic seats and walls visible from outside).
        // Falls back to defaults only if we can't measure (which would
        // also have failed the hasFuselageMesh gate above).
        const fuseBounds = getFuselageBoundsLocal(acGroup);
        // Cabin sits INSIDE the fuselage with margin so walls don't clip
        // through the aircraft skin. 92% inset on all axes.
        const INSET = 0.92;
        // Fall back to fixed dimensions only if measurement failed
        const W = fuseBounds ? fuseBounds.width  * INSET : 1.6;
        const H = fuseBounds ? fuseBounds.height * INSET : 1.5;
        const L = fuseBounds ? fuseBounds.length * INSET : 3.0;
        const HALF_W = W / 2, HALF_L = L / 2;

        // Floor (carpet)
        const floor = new THREE.Mesh(new THREE.BoxGeometry(W, 0.05, L), carpetMat);
        floor.position.set(0, -0.025, 0);
        cabin.add(floor);

        // Ceiling (warm leather/headliner) — slightly emissive for ambient
        const ceiling = new THREE.Mesh(new THREE.BoxGeometry(W, 0.04, L), ceilingMat);
        ceiling.position.set(0, H - 0.02, 0);
        cabin.add(ceiling);

        // Side walls — use thinner side panels with window cutouts. Build
        // each side as: lower wall (below window), upper wall (above
        // window), front wall section (between front edge and front of
        // window), back wall section.
        // Window dimensions: 0.65u tall, 1.6u long, runs from -0.8 to +0.8 z
        const WIN_TOP = 1.15, WIN_BOTTOM = 0.5;
        const WIN_FRONT = -0.8, WIN_BACK = 0.8;
        const WALL_THICKNESS = 0.04;

        function buildSideWall(xPos) {
          const sideGroup = new THREE.Group();
          // Lower panel (floor to window bottom)
          const lower = new THREE.Mesh(
            new THREE.BoxGeometry(WALL_THICKNESS, WIN_BOTTOM, L), wallMat);
          lower.position.set(xPos, WIN_BOTTOM / 2, 0);
          sideGroup.add(lower);
          // Upper panel (window top to ceiling)
          const upper = new THREE.Mesh(
            new THREE.BoxGeometry(WALL_THICKNESS, H - WIN_TOP, L), wallMat);
          upper.position.set(xPos, (WIN_TOP + H) / 2, 0);
          sideGroup.add(upper);
          // Front panel (front of cabin to front of window)
          const front = new THREE.Mesh(
            new THREE.BoxGeometry(WALL_THICKNESS, WIN_TOP - WIN_BOTTOM,
              HALF_L + WIN_FRONT), wallMat);
          front.position.set(xPos, (WIN_TOP + WIN_BOTTOM) / 2,
            -HALF_L + (HALF_L + WIN_FRONT) / 2);
          sideGroup.add(front);
          // Back panel (back of window to back of cabin)
          const back = new THREE.Mesh(
            new THREE.BoxGeometry(WALL_THICKNESS, WIN_TOP - WIN_BOTTOM,
              HALF_L - WIN_BACK), wallMat);
          back.position.set(xPos, (WIN_TOP + WIN_BOTTOM) / 2,
            HALF_L - (HALF_L - WIN_BACK) / 2);
          sideGroup.add(back);
          // Window glass (covers the cutout)
          const glass = new THREE.Mesh(
            new THREE.PlaneGeometry(WIN_BACK - WIN_FRONT, WIN_TOP - WIN_BOTTOM),
            glassMat);
          glass.position.set(xPos, (WIN_TOP + WIN_BOTTOM) / 2,
            (WIN_FRONT + WIN_BACK) / 2);
          glass.rotation.y = xPos > 0 ? -Math.PI / 2 : Math.PI / 2;
          sideGroup.add(glass);
          // Window trim (gold accent around window)
          const trimT = 0.025;
          // Top trim
          const trimTop = new THREE.Mesh(
            new THREE.BoxGeometry(0.005, trimT, WIN_BACK - WIN_FRONT), trimMat);
          trimTop.position.set(xPos + (xPos > 0 ? -0.003 : 0.003),
            WIN_TOP, (WIN_FRONT + WIN_BACK) / 2);
          sideGroup.add(trimTop);
          // Bottom trim
          const trimBot = trimTop.clone();
          trimBot.position.y = WIN_BOTTOM;
          sideGroup.add(trimBot);
          return sideGroup;
        }
        cabin.add(buildSideWall(HALF_W));      // right
        cabin.add(buildSideWall(-HALF_W));     // left

        // Front bulkhead — solid divider between cabin and "cockpit", with
        // a large windscreen viewport so the user sees forward through it.
        const frontBulkhead = new THREE.Group();
        // Lower bulkhead (below windscreen)
        const fbLower = new THREE.Mesh(
          new THREE.BoxGeometry(W, 0.45, WALL_THICKNESS), wallMat);
        fbLower.position.set(0, 0.225, -HALF_L);
        frontBulkhead.add(fbLower);
        // Upper bulkhead (above windscreen)
        const fbUpper = new THREE.Mesh(
          new THREE.BoxGeometry(W, H - 1.25, WALL_THICKNESS), wallMat);
        fbUpper.position.set(0, (1.25 + H) / 2, -HALF_L);
        frontBulkhead.add(fbUpper);
        // Windscreen (between 0.45 and 1.25 in y)
        const windscreen = new THREE.Mesh(
          new THREE.PlaneGeometry(W * 0.92, 0.78), glassMat);
        windscreen.position.set(0, 0.85, -HALF_L + 0.001);
        frontBulkhead.add(windscreen);
        cabin.add(frontBulkhead);

        // Rear wall (solid)
        const rearWall = new THREE.Mesh(
          new THREE.BoxGeometry(W, H, WALL_THICKNESS), wallMat);
        rearWall.position.set(0, H / 2, HALF_L);
        cabin.add(rearWall);

        // ===== Dashboard / center console =====
        // Mounted on the front bulkhead, gold-trimmed, with an active screen
        const dash = new THREE.Group();
        const dashBody = new THREE.Mesh(
          new THREE.BoxGeometry(W * 0.85, 0.18, 0.35), dashMat);
        dashBody.position.set(0, 0.55, -HALF_L + 0.18);
        dash.add(dashBody);
        // Screen face (emissive)
        const screen = new THREE.Mesh(
          new THREE.PlaneGeometry(W * 0.55, 0.12), screenMat);
        screen.position.set(0, 0.6, -HALF_L + 0.36);
        dash.add(screen);
        // Trim strip
        const dashTrim = new THREE.Mesh(
          new THREE.BoxGeometry(W * 0.85, 0.012, 0.018), trimMat);
        dashTrim.position.set(0, 0.64, -HALF_L + 0.36);
        dash.add(dashTrim);
        cabin.add(dash);

        // ===== Seats =====
        // User's seat at +0.4 z (toward back, facing forward), one opposing
        // seat at -0.4 z facing the user (face-to-face style cabin).
        function buildSeat(zPos, facingForward) {
          const seat = new THREE.Group();
          // Base / cushion
          const cushion = new THREE.Mesh(
            new THREE.BoxGeometry(0.7, 0.12, 0.55), seatCushionMat);
          cushion.position.set(0, 0.30, 0);
          seat.add(cushion);
          // Seat sides / bolsters
          for (const x of [-0.32, 0.32]) {
            const side = new THREE.Mesh(
              new THREE.BoxGeometry(0.06, 0.10, 0.55), seatMat);
            side.position.set(x, 0.40, 0);
            seat.add(side);
          }
          // Backrest (slight recline)
          const back = new THREE.Mesh(
            new THREE.BoxGeometry(0.7, 0.85, 0.12), seatCushionMat);
          const reclineDir = facingForward ? 1 : -1;
          back.position.set(0, 0.78, reclineDir * 0.22);
          back.rotation.x = facingForward ? -0.08 : 0.08;
          seat.add(back);
          // Headrest (small cushion above backrest)
          const head = new THREE.Mesh(
            new THREE.BoxGeometry(0.45, 0.18, 0.10), seatCushionMat);
          head.position.set(0, 1.18, reclineDir * 0.18);
          head.rotation.x = facingForward ? -0.08 : 0.08;
          seat.add(head);
          // Armrests
          for (const x of [-0.35, 0.35]) {
            const arm = new THREE.Mesh(
              new THREE.BoxGeometry(0.08, 0.08, 0.45), seatMat);
            arm.position.set(x, 0.55, reclineDir * 0.05);
            seat.add(arm);
          }
          seat.position.z = zPos;
          if (!facingForward) seat.rotation.y = Math.PI;
          return seat;
        }
        // User's seat — at +0.4 z, facing forward (so cabin cam at +0.4 z
        // and 0.6 y looks forward over the seatback toward the windscreen).
        cabin.add(buildSeat(0.4, true));
        // Opposing seat — at -0.4 z, facing the user (rotated 180°)
        cabin.add(buildSeat(-0.85, false));

        // ===== Interior lighting =====
        // Soft warm point light at ceiling center for ambient glow
        const interiorLight = new THREE.PointLight(0xfff0d0, 0.4, 4);
        interiorLight.position.set(0, H - 0.1, 0);
        cabin.add(interiorLight);
        // Subtle fill from cockpit dashboard
        const dashLight = new THREE.PointLight(0x88ccff, 0.18, 2);
        dashLight.position.set(0, 0.7, -HALF_L + 0.4);
        cabin.add(dashLight);

        // ===== Mount on the aircraft =====
        // Parent to acGroup so it moves and rotates with the aircraft.
        // The cabin was modeled with -Z = forward (windscreen direction)
        // but the aircraft's forward is local -X. Rotate by -90° around Y
        // so the cabin's local axes align: cabin -Z → aircraft -X (forward),
        // cabin +Z → aircraft +X (back), seat ends up at the aircraft's
        // back where the cabin cam pins the camera.
        cabin.rotation.y = -Math.PI / 2;
        // Cabin dimensions are derived from the fuselage's LOCAL bbox
        // above (W/H/L set from fuseBounds), so the cabin already lives
        // in the right frame. No counter-scale needed — when acGroup is
        // scaled by fitScale, the cabin scales identically and stays
        // proportional to the aircraft body. (The previous counter-scale
        // approach assumed fixed real-world dimensions, which made the
        // cabin balloon for designs with small fitScale, producing the
        // "brown blob" bug.)
        // Hidden by default; cabin-cam block shows when in cabin view.
        cabin.visible = false;
        acGroup.add(cabin);
        cabinInteriorGroup = cabin;
      }

      function destroyCabinInterior() {
        if (!cabinInteriorGroup) return;
        const parent = cabinInteriorGroup.parent;
        if (parent) parent.remove(cabinInteriorGroup);
        // Dispose geometries/materials to release GPU memory
        cabinInteriorGroup.traverse((obj) => {
          if (obj.geometry) obj.geometry.dispose();
          if (obj.material) {
            if (Array.isArray(obj.material)) obj.material.forEach(m => m.dispose());
            else obj.material.dispose();
          }
        });
        cabinInteriorGroup = null;
      }

      // Show/hide the interior — called by enterCabinView / exitCabinView
      // via the window-exposed setter so outer-scope code (where the cabin
      // functions live) can drive it without touching padScene directly.
      window.__buildCabinInterior = buildCabinInterior;
      window.__destroyCabinInterior = destroyCabinInterior;
      window.__setCabinInteriorVisible = (visible) => {
        if (cabinInteriorGroup) cabinInteriorGroup.visible = !!visible;
      };

      // ============================================================================
      // PROPELLER AUDIO SYNTH — simulates real-life multirotor / eVTOL motor noise.
      // Web Audio synthesis: stacked detuned sawtooth oscillators (motor whine) +
      // bandpass-filtered white noise (blade air-chop). Filter freq + master gain
      // modulate from flight state to capture idle / hover / cruise / descent.
      // ============================================================================
      // ============================================================================
      // PROPELLER AUDIO SYNTH — eVTOL motor hum with ESC variation and dynamics.
      //
      // Real BLDC motors produce a SMOOTH hum (not buzzy saw waves), with the
      // ESC constantly making tiny RPM corrections to maintain attitude under load.
      // Multiple rotors at slightly different RPMs create the natural "wobble"
      // beat. Random gust events produce brief throttle spikes.
      //
      // Architecture:
      //   - 4 rotor "voices" each = sine fundamental + triangle 2nd harmonic +
      //     thin sine 3rd harmonic + slow LFO modulating pitch (ESC hunting)
      //   - 1 BLDC electrical-whine sine layer (~400-1700Hz, scales with throttle)
      //   - 1 air-rush highpass noise layer
      //   - Random gust events: brief throttle bumps every 1-3 seconds
      //   - Distance lowpass + volume attenuation
      // ============================================================================
      class PropellerSynth {
        constructor() {
          this.ctx = null;
          this.masterGain = null;
          this.distFilter = null;
          this.voices = [];
          this.whine = null;
          this.whineGain = null;
          this.noise = null;
          this.noiseFilter = null;
          this.noiseGain = null;
          this.muted = false;
          this.initialized = false;
          this._throttleSmooth = 0;
          this._gustEnd = 0;
          this._gustAmp = 0;
          this._nextGust = 0;
          // ----- Doppler effect state -----
          // User: "now add the doppler effect." The synth tracks the
          // closest aircraft frame-to-frame; we compute radial velocity
          // (rate of distance change) and apply a pitch shift to every
          // oscillator. Closing range = pitch up, opening = pitch down.
          this._prevDistance = null;       // null until first frame
          this._prevDistanceTime = 0;       // ctx.currentTime of last sample
          this._dopplerRatio = 1.0;         // smoothed multiplier on all frequencies
        }
        _ensure() {
          if (this.initialized) return true;
          try {
            const Ctx = window.AudioContext || window.webkitAudioContext;
            if (!Ctx) return false;
            const ctx = new Ctx();
            this.ctx = ctx;
            // Master volume + distance filter chain
            this.masterGain = ctx.createGain();
            this.masterGain.gain.value = 0;
            this.masterGain.connect(ctx.destination);
            this.distFilter = ctx.createBiquadFilter();
            this.distFilter.type = 'lowpass';
            this.distFilter.frequency.value = 2400;
            this.distFilter.Q.value = 0.5;
            this.distFilter.connect(this.masterGain);
            // ===== 4 ROTOR VOICES =====
            // Each is a smooth BLDC motor: sine fund + triangle 2nd + sine 3rd
            // with its own slow LFO doing ESC pitch hunting at ~1-3 Hz.
            // Detuned base frequencies create natural beating between rotors.
            this.voices = [];
            for (let i = 0; i < 4; i++) {
              const baseFreq = 92 + i * 9;     // 92, 101, 110, 119 Hz
              // Fundamental — pure sine for clean hum
              const fund = ctx.createOscillator();
              fund.type = 'sine';
              fund.frequency.value = baseFreq;
              const fundGain = ctx.createGain();
              fundGain.gain.value = 0.055;
              fund.connect(fundGain);
              fundGain.connect(this.distFilter);
              // 2nd harmonic — triangle, gives warm body without the saw buzz
              const h2 = ctx.createOscillator();
              h2.type = 'triangle';
              h2.frequency.value = baseFreq * 2;
              const h2Gain = ctx.createGain();
              h2Gain.gain.value = 0.024;
              h2.connect(h2Gain);
              h2Gain.connect(this.distFilter);
              // 3rd harmonic — thin sine for top-end definition
              const h3 = ctx.createOscillator();
              h3.type = 'sine';
              h3.frequency.value = baseFreq * 3;
              const h3Gain = ctx.createGain();
              h3Gain.gain.value = 0.011;
              h3.connect(h3Gain);
              h3Gain.connect(this.distFilter);
              // ESC hunting LFO — slow pitch modulation per voice (each unique rate)
              const lfo = ctx.createOscillator();
              lfo.type = 'sine';
              lfo.frequency.value = 1.1 + Math.random() * 1.6;     // 1.1-2.7 Hz
              const lfoGain = ctx.createGain();
              lfoGain.gain.value = baseFreq * 0.025;     // ±2.5% pitch
              lfo.connect(lfoGain);
              lfoGain.connect(fund.frequency);
              lfoGain.connect(h2.frequency);
              lfoGain.connect(h3.frequency);
              fund.start(); h2.start(); h3.start(); lfo.start();
              this.voices.push({
                fund, h2, h3, lfo, baseFreq,
                fundGain, h2Gain, h3Gain, lfoGain
              });
            }
            // ===== BLDC ELECTRICAL WHINE =====
            // Thin high-frequency sine that scales with throttle. Gives the
            // characteristic "electric motor" sheen on top of the rotor hum.
            this.whine = ctx.createOscillator();
            this.whine.type = 'sine';
            this.whine.frequency.value = 600;
            this.whineGain = ctx.createGain();
            this.whineGain.gain.value = 0;
            this.whine.connect(this.whineGain);
            this.whineGain.connect(this.distFilter);
            this.whine.start();
            // ===== AIR-RUSH NOISE =====
            // Highpass-filtered white noise = wind/airflow sound from the props.
            // (Replaces the bandpass "blade chop" — that was too clicky.)
            const bufSize = 2 * ctx.sampleRate;
            const noiseBuf = ctx.createBuffer(1, bufSize, ctx.sampleRate);
            const data = noiseBuf.getChannelData(0);
            for (let i = 0; i < bufSize; i++) data[i] = Math.random() * 2 - 1;
            this.noise = ctx.createBufferSource();
            this.noise.buffer = noiseBuf;
            this.noise.loop = true;
            this.noiseFilter = ctx.createBiquadFilter();
            this.noiseFilter.type = 'highpass';
            this.noiseFilter.frequency.value = 1200;
            this.noiseFilter.Q.value = 0.6;
            this.noiseGain = ctx.createGain();
            this.noiseGain.gain.value = 0;
            this.noise.connect(this.noiseFilter);
            this.noiseFilter.connect(this.noiseGain);
            this.noiseGain.connect(this.distFilter);
            this.noise.start();
            // Schedule first gust event 1-3 sec from now
            this._nextGust = ctx.currentTime + 1 + Math.random() * 2;
            this.initialized = true;
            return true;
          } catch (e) {
            console.warn('PropellerSynth init failed:', e);
            return false;
          }
        }
        resume() {
          if (this.ctx && this.ctx.state === 'suspended') this.ctx.resume();
        }
        // throttle: 0..1 (idle to full thrust)
        // distance: world-units from camera (used for distance attenuation)
        // gustsActive: bool — whether to inject random gust corrections (true during
        //   hover/idle, less during smooth cruise)
        setState(throttle, distance = 5, gustsActive = true) {
          if (!this._ensure()) return;
          this.resume();
          // ===== Smooth throttle to avoid clicks/pops =====
          const target = Math.max(0, Math.min(1, throttle));
          this._throttleSmooth += (target - this._throttleSmooth) * 0.06;
          let t = this._throttleSmooth;
          const now = this.ctx.currentTime;
          // ===== DOPPLER EFFECT =====
          // User: "now add the doppler effect." Compute radial velocity
          // from frame-to-frame distance delta, then map to a pitch
          // multiplier via the standard formula:
          //   f_observed = f_source * (c / (c + v_radial))
          // v_radial is +ve when source moves AWAY (lower pitch),
          // -ve when source moves TOWARD camera (higher pitch).
          //
          // Speed-of-sound proxy: the simulation isn't using physical
          // units, so we pick a value that gives a perceptible-but-
          // reasonable pitch shift at typical eVTOL cruise speeds.
          // c=120 means a source approaching at ~24 world-units/sec
          // produces a +20% pitch shift — clearly audible without
          // sounding cartoonish.
          //
          // Guards:
          //  - If dt is 0 or we just initialized, skip the computation.
          //  - If dt is huge (tab-switched, or first frame after a
          //    clone swap teleported the audible source), skip too.
          //  - Smooth heavily (factor 0.18) so individual frame
          //    jitter doesn't oscillate the pitch.
          //  - Clamp the final ratio to [0.75, 1.30] so even a fast
          //    pass produces a musical effect, not a tape-stop.
          let dopplerTarget = 1.0;
          if (this._prevDistance !== null) {
            const dt = now - this._prevDistanceTime;
            // Reject implausible dt (tab return, view switch, init)
            if (dt > 0.001 && dt < 0.5) {
              const dDistDt = (distance - this._prevDistance) / dt;     // +ve = moving away
              // Source-swap detection: when the closest-aircraft pick
              // changes (e.g., a flight lands and a parked taxi becomes
              // the new nearest source), distance jumps discontinuously.
              // If the inferred radial velocity exceeds anything
              // physically plausible (~80 world-units/sec), treat it
              // as a swap and reset the doppler — no chirp.
              if (Math.abs(dDistDt) > 80) {
                dopplerTarget = 1.0;
                this._dopplerRatio = 1.0;     // hard reset, skip the smoothing
              } else {
                const SOUND_SPEED = 120;
                const rawRatio = SOUND_SPEED / (SOUND_SPEED + dDistDt);
                // Clamp before smoothing — even a fast-but-plausible
                // pass produces a musical effect, not a tape-stop.
                dopplerTarget = Math.max(0.75, Math.min(1.30, rawRatio));
              }
            }
          }
          this._prevDistance = distance;
          this._prevDistanceTime = now;
          // Smooth the ratio so per-frame jitter doesn't wobble pitch.
          // Factor 0.18 = ~80ms time constant at 60fps; matches the
          // throttle-smoothing time constant for coherent audio response.
          this._dopplerRatio += (dopplerTarget - this._dopplerRatio) * 0.18;
          const doppler = this._dopplerRatio;
          // ===== Gust events — random brief throttle spikes (ESC compensation) =====
          if (gustsActive && t > 0.1) {
            if (now > this._nextGust) {
              // Schedule a new gust: amplitude 4-10%, duration 0.3-0.7s
              this._gustAmp = 0.04 + Math.random() * 0.06;
              this._gustEnd = now + 0.3 + Math.random() * 0.4;
              this._nextGust = now + 1.0 + Math.random() * 2.5;
            }
            if (now < this._gustEnd) {
              // Half-sine envelope so the gust ramps up and down smoothly
              const remain = this._gustEnd - now;
              const dur = 0.5;
              const env = Math.sin(Math.max(0, Math.min(1, 1 - remain / dur)) * Math.PI);
              t += this._gustAmp * Math.max(0, env);
            }
          }
          t = Math.min(1, t);
          // ===== Distance attenuation =====
          // Inverse-distance curve so volume keeps falling smoothly all the way
          // out to 500+ unit destinations. The previous linear `distance / 30`
          // curve clipped at 30 units — fine for metro hops, useless for ultra-
          // long-range where aircraft fly out to 400+ miles away.
          //
          // Falloff at sample distances:
          //   d=0    → gain 1.00, cutoff 2800 Hz   (right next to camera, fully clear)
          //   d=4    → gain 0.67, cutoff 2010 Hz   (close hover)
          //   d=8    → gain 0.50, cutoff 1500 Hz   (across the plaza)
          //   d=20   → gain 0.29, cutoff  900 Hz   (leaving the area)
          //   d=50   → gain 0.14, cutoff  430 Hz   (distant, low-pass dominates)
          //   d=100  → gain 0.07, cutoff  220 Hz   (faint rumble)
          //   d=300  → gain 0.03, cutoff   75 Hz   (barely audible)
          //   d=500  → gain 0.02, cutoff   45 Hz   (essentially silent)
          const FALLOFF_REF = 8;      // half-volume distance, in world units
          const distGain = 1 / (1 + distance / FALLOFF_REF);
          const cutoff = 100 + 2700 * distGain;     // matches the same curve, mapped to 100-2800 Hz
          // ===== Update voices: pitch each with throttle, then doppler-shift =====
          this.voices.forEach((v, i) => {
            const targetFreq = (v.baseFreq + (110 + i * 22) * t * 1.1) * doppler;
            v.fund.frequency.linearRampToValueAtTime(targetFreq, now + 0.12);
            v.h2.frequency.linearRampToValueAtTime(targetFreq * 2, now + 0.12);
            v.h3.frequency.linearRampToValueAtTime(targetFreq * 3, now + 0.12);
            // LFO depth scales with throttle so ESC hunting is more audible at speed
            v.lfoGain.gain.linearRampToValueAtTime(targetFreq * 0.025 * (0.5 + t * 0.5), now + 0.15);
          });
          // ===== BLDC whine — pitches up with throttle, prominent at hover =====
          // Doppler-shifted along with the rotor voices so the whole
          // sound rises/falls coherently as the source approaches/recedes.
          const whineFreq = (350 + t * 1300) * doppler;
          this.whine.frequency.linearRampToValueAtTime(whineFreq, now + 0.1);
          this.whineGain.gain.linearRampToValueAtTime(this.muted ? 0 : t * 0.022 * distGain, now + 0.1);
          // ===== Air rush =====
          // Air-rush noise filter cutoff also gets the doppler shift —
          // the spectral peak of the noise tracks the source's apparent
          // pitch, completing the effect.
          this.noiseGain.gain.linearRampToValueAtTime(this.muted ? 0 : t * 0.038 * distGain, now + 0.08);
          this.noiseFilter.frequency.linearRampToValueAtTime((1100 + t * 1400) * doppler, now + 0.1);
          // ===== Master volume + distance filter =====
          this.distFilter.frequency.linearRampToValueAtTime(cutoff, now + 0.1);
          const targetVol = this.muted ? 0 : t * 0.30 * distGain;
          this.masterGain.gain.linearRampToValueAtTime(targetVol, now + 0.08);
        }
        setMuted(muted) {
          this.muted = !!muted;
          if (!this.initialized) return;
          const now = this.ctx.currentTime;
          if (this.muted) {
            this.masterGain.gain.linearRampToValueAtTime(0, now + 0.1);
            this.whineGain.gain.linearRampToValueAtTime(0, now + 0.1);
            this.noiseGain.gain.linearRampToValueAtTime(0, now + 0.1);
          }
        }
        // Apply a design profile so each aircraft sounds different.
        // Driven by rotor count + average rotor size.
        // Design intuitions baked in:
        //   - Many rotors (8, 12) → lower base freq (heavier, slower RPM per rotor)
        //   - Few rotors (2, 3, 4) → higher base freq (zippy drones, fast RPM)
        //   - Smaller rotors → higher BLDC whine
        //   - More rotors → faster, more chaotic ESC chatter LFOs
        //   - More rotors → wider detuning between voices (more rich beating)
        setDesignProfile(profile) {
          if (!this._ensure()) return;
          const rotorCount = Math.max(1, Math.min(profile.rotorCount || 4, 24));
          const avgRotorRadius = profile.avgRotorRadius || 0.55;
          // Base freq: 2 rotors = ~115Hz (zippy quad), 12 rotors = ~78Hz (deep eVTOL)
          const baseFund = Math.max(70, 130 - rotorCount * 4);
          // Detune spacing: more rotors → wider variation between voices
          const detuneStep = 7 + Math.min(rotorCount, 12) * 0.6;
          // BLDC whine: smaller rotors → higher whine (small drones whine higher)
          const whineFund = 480 + (1 - Math.min(avgRotorRadius / 0.7, 1)) * 700;
          // ESC LFO rate: more rotors → faster chatter
          const lfoBaseRate = 1.0 + Math.min(rotorCount, 12) * 0.18;
          const now = this.ctx.currentTime;
          this.voices.forEach((v, i) => {
            v.baseFreq = baseFund + i * detuneStep;
            // Set fundamental immediately so the change is audible
            v.fund.frequency.setValueAtTime(v.baseFreq, now);
            v.h2.frequency.setValueAtTime(v.baseFreq * 2, now);
            v.h3.frequency.setValueAtTime(v.baseFreq * 3, now);
            // Each voice's LFO gets its own offset for natural irregularity
            v.lfo.frequency.setValueAtTime(lfoBaseRate + i * 0.4 + Math.random() * 0.3, now);
            v.lfoGain.gain.setValueAtTime(v.baseFreq * 0.025, now);
          });
          this.whine.frequency.setValueAtTime(whineFund, now);
          // Cache profile so setState's per-frame ramps don't fight the new defaults
          this._currentProfile = { baseFund, detuneStep, whineFund };
        }
      }
      const propellerSynth = new PropellerSynth();
      // Initialize on first user click anywhere (browser autoplay policy requires gesture)
      window.addEventListener('click', () => { propellerSynth._ensure(); propellerSynth.resume(); }, { passive: true });

      // Compute audio profile from a saved design — counts rotors, estimates size.
      function computeDesignProfile(designSummary) {
        if (typeof getAllSavedDesigns !== 'function') return { rotorCount: 4, avgRotorRadius: 0.55 };
        const all = getAllSavedDesigns();
        const full = all.find(d => d.id === designSummary.id);
        if (!full || !full.partsMeta) return { rotorCount: 4, avgRotorRadius: 0.55 };
        let rotorCount = 0, totalRadius = 0;
        for (const meta of Object.values(full.partsMeta)) {
          if (meta.kind === 'rotor') {
            rotorCount++;
            // dims.l is the longest dimension — use as 2× radius proxy
            const r = (meta.dims?.l || meta.dims?.w || 1.1) / 2;
            totalRadius += r;
          }
        }
        return {
          rotorCount: Math.max(1, rotorCount),
          avgRotorRadius: rotorCount > 0 ? totalRadius / rotorCount : 0.55
        };
      }


      // Smooth-lerp camera state — the camera position glides toward this target each frame
      // so phase transitions don't cause visible "blips" or jumps.
      const padCamTarget    = { x: 8, y: 5, z: 10 };
      const padCamLookTarget = { x: 0, y: 0.4, z: 0 };
      let padRotors = [];
      let padActive = false;
      let padStartTime = 0;
      let padClockInterval = null;

      function ensurePadScene() {
        if (padScene) return;
        const canvas = document.getElementById('pad-canvas');
        padRenderer = new THREE.WebGLRenderer({ canvas, antialias: true, alpha: true });
        padRenderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
        padRenderer.toneMapping = THREE.ACESFilmicToneMapping;
        padRenderer.toneMappingExposure = 1.05;
        padRenderer.shadowMap.enabled = true;
        padRenderer.shadowMap.type = THREE.PCFSoftShadowMap;
        padScene = new THREE.Scene();
        // ===== DAYLIGHT WORLD =====
        // Bright sky-blue background instead of midnight; haze fog tinted to match
        // so distant buildings dissolve into the horizon naturally on a clear day.
        padScene.background = new THREE.Color(0x9cc4e8);
        // Atmospheric haze tuned for ULR-only geography. Linear fog from 80
        // (just past the hub plaza) to 550 (just past the farthest dispatchable
        // destination at ~477mi). At sample distances:
        //   100mi: ~4% faded — barely affected
        //   158mi (closest city, Fresno): ~17% faded — light haze
        //   250mi (mid-range, Big Sur):  ~36% faded — clear silhouette
        //   354mi (Toronto):              ~58% faded — strong silhouette
        //   477mi (Albuquerque):          ~85% faded — ghost on horizon
        //   550mi+:                        100% — fully merged with sky
        // Without this, the 60→180 setting we had was too aggressive: cities
        // beyond 180 units became fully invisible instead of silhouettes,
        // contradicting the "I can see them but only as silhouettes" intent.
        padScene.fog = new THREE.Fog(0xb8d4ec, 80, 550);
        padCamera = new THREE.PerspectiveCamera(42, 1, 0.1, 600);
        padCamera.position.set(8, 5, 10);
        padCamera.lookAt(0, 0.4, 0);

        // OrbitControls — drag to rotate, scroll to zoom, right-click drag to pan.
        // When the user interacts, we switch to MANUAL camera mode (pauses auto-cam).
        // After 4 seconds of no interaction during a flight, auto-cam resumes.
        padControls = new OrbitControls(padCamera, padRenderer.domElement);
        padControls.enableDamping = true;
        padControls.dampingFactor = 0.08;
        padControls.minDistance = 3;
        padControls.maxDistance = 80;
        padControls.maxPolarAngle = Math.PI * 0.49;   // don't let user look from below ground
        padControls.target.set(0, 0.4, 0);
        padControls.addEventListener('start', () => {
          padManualCam = true;
          padManualCamTime = performance.now();
        });
        padControls.addEventListener('change', () => {
          padManualCamTime = performance.now();
        });

        // ===== DAYLIGHT LIGHTING =====
        // Sky/ground hemisphere (warm sun + cool ground bounce) + bright sun directional
        // + soft sky fill. No more dark cyan rim — that was the night-mode look.
        padScene.add(new THREE.HemisphereLight(0xfff4d8, 0x4a6a5e, 0.85));
        padScene.add(new THREE.AmbientLight(0xffffff, 0.45));
        const key = new THREE.DirectionalLight(0xfff0d0, 2.1);     // sun
        key.position.set(20, 35, 18);
        key.castShadow = true;
        key.shadow.mapSize.set(2048, 2048);
        key.shadow.camera.near = 1;
        key.shadow.camera.far = 80;
        key.shadow.camera.left = -50;
        key.shadow.camera.right = 50;
        key.shadow.camera.top = 50;
        key.shadow.camera.bottom = -50;
        key.shadow.bias = -0.0005;
        padScene.add(key);
        const fill = new THREE.DirectionalLight(0xc8e0ff, 0.6);     // sky fill from opposite side
        fill.position.set(-12, 20, -8);
        padScene.add(fill);

        // Ground floor — daylight-toned (light grey-green, like aerial city view).
        // Radius 600 must cover ALL pad placements so distant cities render
        // on solid ground instead of floating in mid-air. The farthest city
        // (Portland at -490u from origin) needs the floor extended to at
        // least 491u; we use 600u for buffer + room for building clusters
        // around each pad.
        const floor = new THREE.Mesh(
          new THREE.CircleGeometry(600, 128),
          // Urban ground — dark gray-green concrete/parkland mix.
          // Replaces the previous warm-tan that read as desert.
          // User: "the environment looks like a desert. It needs to
          // be like a city with highways, traffic, cars going on the
          // ground all animated."
          new THREE.MeshStandardMaterial({ color: 0x3a4a44, roughness: 0.92, metalness: 0 })
        );
        floor.rotation.x = -Math.PI / 2;
        floor.position.y = -0.001;
        floor.receiveShadow = true;
        padScene.add(floor);

        // Octagonal launch pad — raised platform with cyan trim
        const padGeo = new THREE.CylinderGeometry(2.0, 2.0, 0.18, 8);
        const padMat = new THREE.MeshStandardMaterial({ color: 0x182438, roughness: 0.7, metalness: 0.3 });
        const platform = new THREE.Mesh(padGeo, padMat);
        platform.position.y = 0.09;
        platform.castShadow = true;
        platform.receiveShadow = true;
        padScene.add(platform);
        // Glowing edge ring on top of pad
        const ringGeo = new THREE.TorusGeometry(2.0, 0.025, 8, 8);
        const ringMat = new THREE.MeshStandardMaterial({ color: 0x00E5FF, emissive: 0x00b5cc, emissiveIntensity: 1.5 });
        const ring = new THREE.Mesh(ringGeo, ringMat);
        ring.rotation.x = -Math.PI / 2;
        ring.position.y = 0.18;
        padScene.add(ring);
        // Pad center marker — large H
        const hMat = new THREE.MeshStandardMaterial({ color: 0xfff0c0, emissive: 0xfff0c0, emissiveIntensity: 0.4, roughness: 0.4 });
        const hBars = [
          { x: -0.5, w: 0.08, h: 0.005, d: 1.0 },
          { x:  0.5, w: 0.08, h: 0.005, d: 1.0 },
          { x:  0.0, w: 1.08, h: 0.005, d: 0.10 }
        ];
        for (const b of hBars) {
          const bar = new THREE.Mesh(new THREE.BoxGeometry(b.w, b.h, b.d), hMat);
          bar.position.set(b.x, 0.181, 0);
          padScene.add(bar);
        }
        // Pulsing pad lights at the 8 corners
        const lightDots = [];
        for (let i = 0; i < 8; i++) {
          const a = (i / 8) * Math.PI * 2 + Math.PI / 8;
          const dotMat = new THREE.MeshStandardMaterial({ color: 0x00E5FF, emissive: 0x00E5FF, emissiveIntensity: 1.6 });
          const dot = new THREE.Mesh(new THREE.SphereGeometry(0.04, 8, 6), dotMat);
          dot.position.set(Math.cos(a) * 1.95, 0.20, Math.sin(a) * 1.95);
          padScene.add(dot);
          lightDots.push(dot);
        }
        padScene.userData.lightDots = lightDots;

        // ============================================================
        // AI CREW FIGURES — small humanoids stationed around the pad
        //
        // The user wanted to "see the operators as humans working" in
        // the hub. The OPS CREW text panel shows their activity, and
        // these 3D figures make them physically visible: 5 small
        // humanoids stand around the pad's perimeter, each color-coded
        // to a role (cyan dispatcher, amber mechanic, etc.). They idle
        // with subtle bob/sway animations, and occasionally turn or
        // gesture so they don't look static. When a dispatch event
        // fires, the dispatcher figure plays a brief gesture animation
        // that's visible from the camera.
        //
        // Geometry is intentionally chunky/low-poly — these are
        // background presence, not focal characters. Each figure is
        // ~1.7m tall in scene units (the pad is 4m diameter so they're
        // legibly human-scale next to it).
        // ============================================================
        const crewFigures = [];
        const CREW_FIGURE_COLORS = {
          DISPATCH: 0x00E5FF,   // cyan
          MAINT:    0xf59e0b,   // amber
          GROUND:   0x4ade80,   // green
          OPS:      0xa78bfa,   // purple
          ATC:      0x60a5fa,   // blue
          IR:       0xef4444,   // crimson — Incident Response (recovery vehicle crew)
          VO:       0xfbbf24,   // gold — Visual Observer (off-hub lookout)
        };
        function buildCrewFigure(roleColor) {
          // Group origin sits at the figure's feet so we can place it
          // directly on the ground floor (y=0) without offset math.
          const fig = new THREE.Group();
          // Body — torso (vest, role-colored)
          const torsoMat = new THREE.MeshStandardMaterial({
            color: roleColor, emissive: roleColor, emissiveIntensity: 0.15,
            roughness: 0.6, metalness: 0.1,
          });
          const torso = new THREE.Mesh(new THREE.BoxGeometry(0.42, 0.62, 0.28), torsoMat);
          torso.position.y = 1.05;
          torso.castShadow = true;
          fig.add(torso);
          // Head — pale flesh tone
          const headMat = new THREE.MeshStandardMaterial({ color: 0xd9c2a6, roughness: 0.7 });
          const head = new THREE.Mesh(new THREE.SphereGeometry(0.16, 12, 10), headMat);
          head.position.y = 1.55;
          head.castShadow = true;
          fig.add(head);
          // Helmet/hat — dark cap on top of head, role-colored stripe
          const capMat = new THREE.MeshStandardMaterial({ color: 0x111820, roughness: 0.85 });
          const cap = new THREE.Mesh(new THREE.CylinderGeometry(0.17, 0.17, 0.06, 16), capMat);
          cap.position.y = 1.69;
          fig.add(cap);
          const stripeMat = new THREE.MeshStandardMaterial({
            color: roleColor, emissive: roleColor, emissiveIntensity: 0.7,
          });
          const stripe = new THREE.Mesh(new THREE.TorusGeometry(0.165, 0.012, 6, 16), stripeMat);
          stripe.rotation.x = Math.PI / 2;
          stripe.position.y = 1.71;
          fig.add(stripe);
          // Arms — simple cylinders, attached at shoulder height. Stored
          // on userData so the per-frame loop can swing them.
          const armMat = new THREE.MeshStandardMaterial({ color: 0x2a3848, roughness: 0.8 });
          const armGeo = new THREE.CylinderGeometry(0.07, 0.06, 0.55, 8);
          const armL = new THREE.Mesh(armGeo, armMat);
          armL.position.set(-0.27, 1.05, 0);
          armL.castShadow = true;
          fig.add(armL);
          const armR = new THREE.Mesh(armGeo, armMat);
          armR.position.set(0.27, 1.05, 0);
          armR.castShadow = true;
          fig.add(armR);
          // Legs — slightly tapered, dark trousers
          const legMat = new THREE.MeshStandardMaterial({ color: 0x1a242e, roughness: 0.9 });
          const legGeo = new THREE.CylinderGeometry(0.09, 0.07, 0.7, 8);
          const legL = new THREE.Mesh(legGeo, legMat);
          legL.position.set(-0.11, 0.4, 0);
          legL.castShadow = true;
          fig.add(legL);
          const legR = new THREE.Mesh(legGeo, legMat);
          legR.position.set(0.11, 0.4, 0);
          legR.castShadow = true;
          fig.add(legR);
          // Save part references for animation
          fig.userData.parts = { torso, head, armL, armR, legL, legR };
          // Animation state — phase offset so figures don't all bob in sync
          fig.userData.anim = {
            phase: Math.random() * Math.PI * 2,
            baseY: 0,
            facing: 0,
            gestureUntil: 0,
          };
          return fig;
        }
        // Expose for the mfg scene's AI build-team figures so they
        // visually match the launchpad crew figures.
        if (typeof window !== 'undefined') {
          window.__buildCrewFigure = buildCrewFigure;
          window.__crewFigureColors = CREW_FIGURE_COLORS;
        }
        // Place crew figures at role-specific HOME STATIONS instead of
        // a uniform circle. Each station puts the figure where their
        // job actually happens:
        //   - DISPATCH: just inside the pad ring, facing aprons
        //     (dispatches aircraft; walks toward aircraft to prep it)
        //   - MAINT: out by the apron row (patrols between aircraft)
        //   - GROUND: between pad and aprons (escorts aircraft to pad)
        //   - OPS: behind the pad facing the airfield (overview position)
        //   - ATC: standing back-corner at the "tower" position
        //
        // These stations are still around the pad area but spread out
        // along the play of work — not the symmetric ring that looked
        // like "ring around the rosie". Workers leave their station to
        // perform tasks (walk to aircraft) then return when done.
        // MAINT has 3 stations because the user (Head of Operations)
        // requested more maintenance workers — they're the busiest crew
        // and 1 figure couldn't keep up with a full hangar.
        const CREW_STATIONS = {
          DISPATCH: { x:  0.0, z:  3.0 },     // near pad, faces aprons
          MAINT_1:  { x:  6.0, z:  6.0 },     // by aprons, ready to patrol
          MAINT_2:  { x:  7.5, z:  4.0 },     // second mechanic, further out
          MAINT_3:  { x:  4.5, z:  7.5 },     // third mechanic, deep apron
          GROUND:   { x: -4.0, z:  2.5 },     // between pad and aprons
          OPS:      { x:  0.0, z: -4.5 },     // behind pad, overview
          ATC:      { x: -7.0, z: -3.0 },     // back-corner "tower" spot
          // IR · Incident Response — two crew sit in/near a recovery
          // vehicle parked at a "garage" spot just outside the apron
          // ring. When a fault triggers they drive out to the lost
          // taxi and bring it back in. User: "IR, who are people who
          // are sitting in a vehicle, if an air taxi is lost, they
          // go out and find it, and bring back."
          IR_1:     { x: -8.0, z:  6.5 },
          IR_2:     { x: -7.2, z:  6.5 },
          // VO · Visual Observer — single figure on a small platform
          // way out from the hub at the perimeter, with a clear sight
          // line back to the apron. User: "VO, standing in a separate
          // area away from the HUB, reporting information to me, the
          // owner."
          VO:       { x: 14.0, z: -10.0 },
        };
        // Map slot keys → role keys (multiple slots can share a role)
        const CREW_SLOT_TO_ROLE = {
          DISPATCH: 'DISPATCH',
          MAINT_1: 'MAINT', MAINT_2: 'MAINT', MAINT_3: 'MAINT',
          GROUND: 'GROUND', OPS: 'OPS', ATC: 'ATC',
          IR_1: 'IR', IR_2: 'IR',
          VO: 'VO',
        };
        const crewSlots = ['DISPATCH', 'MAINT_1', 'MAINT_2', 'MAINT_3', 'GROUND', 'OPS', 'ATC', 'IR_1', 'IR_2', 'VO'];
        for (let i = 0; i < crewSlots.length; i++) {
          const slotKey = crewSlots[i];
          const roleKey = CREW_SLOT_TO_ROLE[slotKey];
          const station = CREW_STATIONS[slotKey];
          const fig = buildCrewFigure(CREW_FIGURE_COLORS[roleKey]);
          fig.position.set(station.x, 0, station.z);
          // Face the pad (origin) — workers naturally orient toward
          // their work area
          fig.rotation.y = Math.atan2(0 - station.x, 0 - station.z);
          fig.userData.role = roleKey;
          fig.userData.slotKey = slotKey;     // unique slot id for multi-MAINT addressing
          fig.userData.anim.facing = fig.rotation.y;
          // Task/state machine state:
          //   state: 'idle' | 'walking_to' | 'working' | 'walking_back'
          //   homeX, homeZ: station coordinates (to return to)
          //   targetX, targetZ: current walk destination
          //   workUntil: timestamp when current 'working' state ends
          //   walkSpeed: meters per second
          //   taskQueue: array of pending tasks (FIFO)
          fig.userData.task = {
            state: 'idle',
            homeX: station.x,
            homeZ: station.z,
            targetX: station.x,
            targetZ: station.z,
            workUntil: 0,
            walkSpeed: 1.6,     // realistic human walking speed
            taskQueue: [],
            // Per-frame footstep phase — used by leg/arm swing while walking
            stepPhase: 0,
          };
          padScene.add(fig);
          crewFigures.push(fig);
        }
        padScene.userData.crewFigures = crewFigures;

        // ============================================================
        // IR RECOVERY VEHICLE — simple boxy 4-wheel truck parked at
        // the IR station. Two IR figures sit beside it (their station
        // coords already place them next to it). When a fault fires
        // the vehicle drives out toward the aborting aircraft and
        // returns when it docks. Construction here is the static rig;
        // the dispatch animation lives in __dispatchIRVehicle.
        // ============================================================
        let irVehicle = null;
        try {
          const irStation = CREW_STATIONS.IR_1;
          const truckGroup = new THREE.Group();
          // Body — main cargo box
          const bodyMat = new THREE.MeshStandardMaterial({
            color: 0xc01818, roughness: 0.55, metalness: 0.2,
            emissive: 0x300000, emissiveIntensity: 0.25,
          });
          const body = new THREE.Mesh(new THREE.BoxGeometry(1.2, 0.9, 2.0), bodyMat);
          body.position.y = 0.7;
          body.castShadow = true;
          truckGroup.add(body);
          // Cab — slightly smaller, raised, dark glass
          const cabMat = new THREE.MeshStandardMaterial({
            color: 0xa01010, roughness: 0.5, metalness: 0.25,
            emissive: 0x200000, emissiveIntensity: 0.35,
          });
          const cab = new THREE.Mesh(new THREE.BoxGeometry(1.05, 0.7, 0.85), cabMat);
          cab.position.set(0, 0.95, -0.7);
          cab.castShadow = true;
          truckGroup.add(cab);
          // Windshield — emissive cyan slab at front of cab
          const glassMat = new THREE.MeshStandardMaterial({
            color: 0x60a5fa, emissive: 0x60a5fa, emissiveIntensity: 0.7,
            transparent: true, opacity: 0.55,
          });
          const glass = new THREE.Mesh(new THREE.BoxGeometry(0.9, 0.4, 0.06), glassMat);
          glass.position.set(0, 1.05, -1.13);
          truckGroup.add(glass);
          // Light bar on cab roof — flashes cyan when responding to a fault
          const lightBarMat = new THREE.MeshStandardMaterial({
            color: 0xff5050, emissive: 0xff2020, emissiveIntensity: 0.5,
          });
          const lightBar = new THREE.Mesh(new THREE.BoxGeometry(0.7, 0.08, 0.20), lightBarMat);
          lightBar.position.set(0, 1.34, -0.7);
          truckGroup.add(lightBar);
          // 4 wheels — black cylinders
          const wheelMat = new THREE.MeshStandardMaterial({ color: 0x101010, roughness: 0.95 });
          const wheelGeo = new THREE.CylinderGeometry(0.28, 0.28, 0.18, 14);
          const wheelOffsets = [
            { x:  0.55, z:  0.7 }, { x: -0.55, z:  0.7 },
            { x:  0.55, z: -0.7 }, { x: -0.55, z: -0.7 },
          ];
          for (const wo of wheelOffsets) {
            const wheel = new THREE.Mesh(wheelGeo, wheelMat);
            wheel.rotation.z = Math.PI / 2;
            wheel.position.set(wo.x, 0.28, wo.z);
            wheel.castShadow = true;
            truckGroup.add(wheel);
          }
          truckGroup.position.set(irStation.x - 0.8, 0, irStation.z + 0.8);
          truckGroup.rotation.y = Math.PI * 0.15;       // angle slightly so it doesn't look perfectly aligned
          // Animation state — dispatch state machine reads this
          truckGroup.userData = {
            isIRVehicle: true,
            homeX: truckGroup.position.x,
            homeZ: truckGroup.position.z,
            homeRotY: truckGroup.rotation.y,
            state: 'parked',          // 'parked' | 'driving_out' | 'on_scene' | 'driving_back'
            targetX: 0, targetZ: 0,
            stateUntil: 0,
            lightBar,                  // ref so animation can flash it
          };
          padScene.add(truckGroup);
          irVehicle = truckGroup;
          padScene.userData.irVehicle = irVehicle;
        } catch (err) { console.warn('[IR vehicle] build failed:', err); }

        // ============================================================
        // VO OBSERVATION PLATFORM — a small raised platform with
        // railing where the Visual Observer stands away from the hub.
        // Just decorative scene geometry; the VO figure was already
        // placed at CREW_STATIONS.VO above and is bumped up onto it.
        // ============================================================
        try {
          const voStation = CREW_STATIONS.VO;
          const platGroup = new THREE.Group();
          // Base post (gray pillar)
          const postMat = new THREE.MeshStandardMaterial({ color: 0x444c5a, roughness: 0.85 });
          const post = new THREE.Mesh(new THREE.BoxGeometry(0.5, 0.8, 0.5), postMat);
          post.position.y = 0.4;
          post.castShadow = true;
          platGroup.add(post);
          // Deck (small platform)
          const deckMat = new THREE.MeshStandardMaterial({ color: 0x6b7384, roughness: 0.7 });
          const deck = new THREE.Mesh(new THREE.BoxGeometry(2.4, 0.12, 2.4), deckMat);
          deck.position.y = 0.85;
          deck.castShadow = true; deck.receiveShadow = true;
          platGroup.add(deck);
          // Railing — thin strips around 3 sides (open toward hub)
          const railMat = new THREE.MeshStandardMaterial({
            color: 0xfbbf24, emissive: 0xfbbf24, emissiveIntensity: 0.4, roughness: 0.6,
          });
          const railGeo = new THREE.BoxGeometry(2.4, 0.06, 0.06);
          const railBack = new THREE.Mesh(railGeo, railMat);
          railBack.position.set(0, 1.45, 1.17);
          platGroup.add(railBack);
          const railLeft = new THREE.Mesh(new THREE.BoxGeometry(0.06, 0.06, 2.4), railMat);
          railLeft.position.set(-1.17, 1.45, 0);
          platGroup.add(railLeft);
          const railRight = new THREE.Mesh(new THREE.BoxGeometry(0.06, 0.06, 2.4), railMat);
          railRight.position.set(1.17, 1.45, 0);
          platGroup.add(railRight);
          platGroup.position.set(voStation.x, 0, voStation.z);
          padScene.add(platGroup);
          // Bump the VO figure up onto the deck (deck top y = 0.91)
          const voFig = crewFigures.find(f => f.userData.role === 'VO');
          if (voFig) {
            voFig.position.y = 0.91;
            voFig.userData.task.homeX = voStation.x;
            voFig.userData.task.homeZ = voStation.z;
            // VO faces the hub (origin)
            voFig.rotation.y = Math.atan2(0 - voStation.x, 0 - voStation.z);
            voFig.userData.anim.facing = voFig.rotation.y;
            voFig.userData.task.walkSpeed = 0;     // VO doesn't leave the platform
          }
        } catch (err) { console.warn('[VO platform] build failed:', err); }

        // Helper: queue a task for a specific role's worker.
        // task = { aircraftIdx, workMs, gesture: bool }
        // The worker walks to the apron position of that aircraft,
        // works for workMs, then walks back to their home station.
        // Multiple tasks queue up FIFO.
        //
        // For roles with multiple figures (MAINT has 3), pick the
        // LEAST BUSY one — prefer idle figures, otherwise the one with
        // the shortest queue. This way the 3 mechanics actually share
        // the load instead of all tasks piling on figure #1.
        function queueCrewTask(roleKey, task) {
          if (!padScene || !padScene.userData.crewFigures) return;
          const candidates = padScene.userData.crewFigures.filter(
            f => f.userData.role === roleKey
          );
          if (candidates.length === 0) return;
          let bestFig = candidates[0];
          let bestScore = scoreFigBusyness(bestFig);
          for (let i = 1; i < candidates.length; i++) {
            const score = scoreFigBusyness(candidates[i]);
            if (score < bestScore) { bestFig = candidates[i]; bestScore = score; }
          }
          bestFig.userData.task.taskQueue.push(task);
        }
        // Lower score = less busy. Idle figures with empty queues score 0.
        function scoreFigBusyness(fig) {
          const tk = fig.userData.task;
          // Each queued task adds 1; non-idle state adds 0.5 (mid-task)
          return tk.taskQueue.length + (tk.state === 'idle' ? 0 : 0.5);
        }
        padScene.userData.queueCrewTask = queueCrewTask;

        // ===== CREW ACTIVITY READOUT =====
        // Walk every crew figure and produce a snapshot of what each
        // is doing. Splash uses this to show live "what's happening"
        // status. User: "the splash screen needs to update what all
        // is happening and what the workers are working on."
        // Returns: [{ slotKey, role, name, state, label, tailNumber }, ...]
        window.__getCrewActivity = function() {
          const out = [];
          if (!padScene || !padScene.userData.crewFigures) return out;
          const roster = (typeof window !== 'undefined' && window.__opsCrewRoster) || [];
          // Build a slot → name lookup once
          const slotName = {};
          for (const r of roster) if (r && r.slotKey) slotName[r.slotKey] = r.name;
          for (const fig of padScene.userData.crewFigures) {
            const ud = fig.userData || {};
            const tk = ud.task || {};
            const cur = tk._currentTask || null;
            // State copy that's safe for splash to consume
            let state = tk.state || 'idle';
            // Translate to UI-friendly verbs
            let label, tailNumber = null;
            if (state === 'idle' && tk.taskQueue && tk.taskQueue.length > 0) {
              // About to start the next queued task — preview that task
              const next = tk.taskQueue[0];
              label = next && next.label ? `Queued: ${next.label}` : 'Queued';
              if (next && next.tailNumber) tailNumber = next.tailNumber;
            } else if (state === 'idle') {
              label = 'Idle';
            } else if (state === 'walking_to') {
              label = (cur && cur.label) ? `Walking → ${cur.label.toLowerCase()}` : 'Walking out';
              if (cur && cur.tailNumber) tailNumber = cur.tailNumber;
            } else if (state === 'working') {
              label = (cur && cur.label) ? cur.label : 'Working';
              if (cur && cur.tailNumber) tailNumber = cur.tailNumber;
            } else if (state === 'walking_back') {
              label = 'Returning';
            } else {
              label = state;
            }
            out.push({
              slotKey: ud.slotKey || ud.role || '?',
              role: ud.role || '?',
              name: slotName[ud.slotKey] || slotName[ud.role] || ud.slotKey || ud.role,
              state,
              label,
              tailNumber,
              queueLen: (tk.taskQueue && tk.taskQueue.length) || 0,
            });
          }
          return out;
        };

        // Expose dispatcher gesture trigger — the ops crew text panel's
        // dispatch hook will call this to play a brief "pointing"
        // gesture on the dispatcher figure when a flight is dispatched.
        // Lookup is by role so any figure can be triggered. For roles
        // with multiple figures, gestures fire on a random one.
        window.__triggerCrewGesture = function(roleKey) {
          if (!padScene || !padScene.userData.crewFigures) return;
          const candidates = padScene.userData.crewFigures.filter(
            f => f.userData.role === roleKey
          );
          if (candidates.length === 0) return;
          const fig = candidates[Math.floor(Math.random() * candidates.length)];
          fig.userData.anim.gestureUntil = performance.now() + 1500;
        };

        // Trigger a real WORK task for a role. The worker walks to
        // the given aircraft's apron, works for a few seconds, then
        // returns. This is what makes them visibly active — not just
        // a hand wave, but actual locomotion across the scene.
        // designId optional — when provided, target that specific
        // aircraft's apron position; otherwise pick a random one.
        // onArrive optional — a callback fired the moment the worker
        // reaches the target. The dispatcher uses this to fire the
        // actual aircraft takeoff so the launch is visibly worker-
        // caused (worker walks → arrives → aircraft launches).
        window.__assignCrewWork = function(roleKey, designId, workMs, onArrive, label) {
          if (!padScene || !padScene.userData.queueCrewTask) return;
          const designs = (typeof getAllSavedDesigns === 'function') ? getAllSavedDesigns() : [];
          if (designs.length === 0) return;
          let target = null;
          if (designId) {
            target = designs.find(d => d.id === designId);
          }
          if (!target) {
            target = designs[Math.floor(Math.random() * designs.length)];
          }
          if (!target) return;
          let pos;
          try {
            pos = apronPosition(target.id);
          } catch (_) {
            return;
          }
          // Default label per role — used by the splash activity panel
          // so the user sees what each worker is actually doing rather
          // than a generic "working." User: "the splash screen needs
          // to update what all is happening and what the workers are
          // working on."
          const defaultLabels = {
            MAINT: 'Inspecting',
            GROUND: 'Prepping',
            DISPATCH: 'Dispatching',
            OPS: 'Coordinating',
            ATC: 'Clearing',
          };
          padScene.userData.queueCrewTask(roleKey, {
            targetX: pos.x,
            targetZ: pos.z + 1.2,     // stand BESIDE aircraft, not on top
            workMs: workMs || (1500 + Math.random() * 1500),
            gesture: true,
            onArrive: typeof onArrive === 'function' ? onArrive : null,
            label: label || defaultLabels[roleKey] || 'Working',
            designId: target.id,
            tailNumber: target.tailNumber || target.id,
          });
        };

        // Wander target — when no actual aircraft work exists (entire
        // fleet airborne), workers pick a random spot in the hub area
        // and walk there briefly so they don't visually freeze in place.
        // The user explicitly reported workers "frozen" after launches;
        // this fallback keeps the scene alive even when there's no
        // real work to do.
        window.__assignCrewWanderTo = function(roleKey) {
          if (!padScene || !padScene.userData.queueCrewTask) return;
          // Random spot in a 6m × 6m box around the pad. Stay outside
          // the pad ring (radius 2) so the worker doesn't stand on the
          // platform itself.
          let wx, wz;
          let attempts = 0;
          do {
            wx = (Math.random() - 0.5) * 12;     // -6..6
            wz = (Math.random() - 0.5) * 12;
            attempts++;
          } while (Math.sqrt(wx * wx + wz * wz) < 2.5 && attempts < 8);
          padScene.userData.queueCrewTask(roleKey, {
            targetX: wx,
            targetZ: wz,
            workMs: 1000 + Math.random() * 1000,     // brief stop
            gesture: false,
          });
        };

        // City buildings — densely populated cluster around the hub, then sparser at distance.
        // Builds the impression of a metropolitan area with the hub at downtown center.
        // Skips placing buildings within CLEARANCE miles of any pad so the aircraft has
        // a clear descent path into pickup/dropoff/hub.
        // Daylight palette: warm beige + cool concrete, no emissive glow (sun lights them).
        const buildingMat = new THREE.MeshStandardMaterial({ color: 0xc8c0a8, roughness: 0.92, metalness: 0.05 });
        const buildingMatLit = new THREE.MeshStandardMaterial({ color: 0xa0a8b4, roughness: 0.88, metalness: 0.08 });
        const PAD_CLEARANCE = 2.5;     // minimum distance from any pad
        // Snapshot all pad positions so we can check distance for each building candidate
        const padPositions = Object.values(PAD_GEOGRAPHY);
        // Helper: returns true if (x, z) is too close to any pad
        const tooCloseToAnyPad = (x, z) => {
          for (const p of padPositions) {
            const dx = p.x - x, dz = p.z - z;
            if (dx*dx + dz*dz < PAD_CLEARANCE * PAD_CLEARANCE) return true;
          }
          return false;
        };
        // Hub plaza — cleared area around the launch pad. NO buildings within
        // HUB_PLAZA_RADIUS units of origin. The launch pad, the apron row of
        // saved aircraft (at z=8), and any close-in metro destination pads all
        // sit inside this clearing. Cities cluster AROUND distant destination
        // pads instead of randomly ringing the hub.
        // (HUB_PLAZA_RADIUS is declared at script-tag scope above so chatPadPool
        // can also use it for filtering — keeps scene composition and dispatch
        // rules in sync: anywhere a city is shown, dispatch can target it.)
        const inHubPlaza = (x, z) => Math.hypot(x, z) <= HUB_PLAZA_RADIUS;

        // Subtle ring marking the hub plaza boundary — visible to the user
        // walking around in ground-cam mode so they can orient themselves.
        {
          const plazaRingPts = [];
          for (let i = 0; i <= 96; i++) {
            const a = (i / 96) * Math.PI * 2;
            plazaRingPts.push(new THREE.Vector3(Math.cos(a) * HUB_PLAZA_RADIUS, 0.02, Math.sin(a) * HUB_PLAZA_RADIUS));
          }
          const plazaRingMat = new THREE.LineBasicMaterial({ color: 0x00E5FF, transparent: true, opacity: 0.35 });
          padScene.add(new THREE.Line(new THREE.BufferGeometry().setFromPoints(plazaRingPts), plazaRingMat));
        }

        // City clusters — for each destination pad OUTSIDE the hub plaza,
        // place 12-16 buildings within 2.5-7 units of the pad center. Closer
        // to pad center = "downtown" (taller); farther = "outskirts" (shorter).
        // Pads inside the plaza render as bare landing zones (they're treated
        // as part of the vertiport facility, not separate cities).
        for (const [padName, padPos] of Object.entries(PAD_GEOGRAPHY)) {
          if (padName === MAIN_HUB_NAME) continue;
          if (Math.hypot(padPos.x, padPos.z) <= HUB_PLAZA_RADIUS) continue;

          const CITY_MIN_R = 1.5;
          const CITY_MAX_R = 6.0;     // keeps adjacent-city gap ≥2u (RENO/TAHOE-SOUTH centers are 15.8 apart, so 6+6+2 ≤ 15.8 holds)
          // User: "the cities and destinations needs to be bigger,
          // not just a few buildings." Bumped from 10-14 to 35-50
          // buildings per destination so each city reads as a real
          // metropolitan area rather than a token cluster.
          const cityCount = 35 + Math.floor(Math.random() * 16);  // 35-50
          let placed = 0, attempts = 0;
          while (placed < cityCount && attempts < 350) {
            attempts++;
            const a = Math.random() * Math.PI * 2;
            const d = CITY_MIN_R + Math.random() * (CITY_MAX_R - CITY_MIN_R);
            const x = padPos.x + Math.cos(a) * d;
            const z = padPos.z + Math.sin(a) * d;
            if (inHubPlaza(x, z)) continue;
            if (tooCloseToAnyPad(x, z)) continue;
            const downtownish = d < 3.0;
            const skyscraperRoll = downtownish && Math.random() < 0.18;
            const w = 0.5 + Math.random() * (downtownish ? 1.0 : 1.2);
            // Skyscrapers up to 8u for visual presence; regular downtown 1.5-5.5;
            // outskirts stay small (0.7-2.7)
            const h = skyscraperRoll
              ? 5.5 + Math.random() * 3.0
              : (downtownish ? 1.5 + Math.random() * 4.0 : 0.7 + Math.random() * 2.0);
            const dpth = 0.5 + Math.random() * (downtownish ? 1.0 : 1.2);
            const mat = (downtownish && Math.random() < 0.4) ? buildingMatLit : buildingMat;
            const b = new THREE.Mesh(new THREE.BoxGeometry(w, h, dpth), mat);
            b.position.set(x, h / 2, z);
            b.rotation.y = Math.random() * Math.PI;
            b.castShadow = true;
            padScene.add(b);
            placed++;
          }
        }

        // ============================================================
        // HIGHWAYS + GROUND TRAFFIC
        //
        // User: "the environment looks like a desert. It needs to be
        // like a city with highways, traffic, cars going on the
        // ground all animated."
        //
        // Architecture:
        //   1. For each non-hub destination, lay a wide asphalt strip
        //      from the hub to the pad. Long thin plane along the
        //      route axis, dark gray, dashed yellow centerline.
        //   2. Spawn 4-6 cars per highway. Each car is a small box
        //      mesh with a parametric position along the route (t
        //      0→1). Speed varies per car. When a car reaches t=1
        //      it loops back to t=0.
        //   3. Cars stored on window.__padCars; tickPad advances
        //      each car's t each frame (frame-rate independent
        //      via dt).
        // ============================================================
        const padCars = [];
        const ROAD_WIDTH = 0.45;
        const roadMat = new THREE.MeshStandardMaterial({
          color: 0x1a1d22, roughness: 1, metalness: 0
        });
        const stripeMat = new THREE.MeshStandardMaterial({
          color: 0xd4b545, emissive: 0x4a3a10, emissiveIntensity: 0.3,
          roughness: 0.7, metalness: 0
        });
        const carColors = [0xc0392b, 0x2980b9, 0xf1c40f, 0xecf0f1, 0x16a085, 0x8e44ad, 0xe67e22, 0x34495e];

        for (const [padName, padPos] of Object.entries(PAD_GEOGRAPHY)) {
          if (padName === MAIN_HUB_NAME) continue;
          const dx = padPos.x;
          const dz = padPos.z;
          const len = Math.hypot(dx, dz);
          // Pads inside the hub plaza are part of the launch facility
          // itself — no separate highway runs to them. User: "the
          // cars can't be going through the hub." Skipping in-plaza
          // pads here also matches the city-building loop behavior.
          if (len <= HUB_PLAZA_RADIUS + 1) continue;
          const angle = Math.atan2(dz, dx);

          // Road starts at the hub-plaza edge along the route axis
          // (not at origin), so traffic never enters the plaza.
          // Direction unit vector × HUB_PLAZA_RADIUS = start point.
          const startX = (dx / len) * HUB_PLAZA_RADIUS;
          const startZ = (dz / len) * HUB_PLAZA_RADIUS;
          const segLen = len - HUB_PLAZA_RADIUS;

          // Asphalt strip — built along +X then rotated to point at pad
          const road = new THREE.Mesh(
            new THREE.PlaneGeometry(segLen, ROAD_WIDTH),
            roadMat
          );
          road.rotation.x = -Math.PI / 2;
          road.rotation.z = -angle;     // align along the route
          // Place midpoint between plaza edge and pad
          road.position.set((startX + dx) / 2, 0.005, (startZ + dz) / 2);
          road.receiveShadow = true;
          padScene.add(road);

          // Dashed centerline — short yellow segments evenly spaced
          // along the segment from plaza edge to pad
          const dashCount = Math.max(8, Math.floor(segLen / 3));
          for (let i = 0; i < dashCount; i++) {
            const tt = (i + 0.5) / dashCount;
            const dash = new THREE.Mesh(
              new THREE.PlaneGeometry(0.4, 0.06),
              stripeMat
            );
            dash.rotation.x = -Math.PI / 2;
            dash.rotation.z = -angle;
            dash.position.set(
              startX + (dx - startX) * tt,
              0.012,
              startZ + (dz - startZ) * tt
            );
            padScene.add(dash);
          }

          // Cars — 4 to 6 per highway, evenly distributed but with
          // randomized speeds and offsets so traffic feels organic
          const carCount = 4 + Math.floor(Math.random() * 3);
          for (let i = 0; i < carCount; i++) {
            const carColor = carColors[Math.floor(Math.random() * carColors.length)];
            const carMat = new THREE.MeshStandardMaterial({
              color: carColor, roughness: 0.5, metalness: 0.3
            });
            const carBody = new THREE.Mesh(
              new THREE.BoxGeometry(0.42, 0.16, 0.22),
              carMat
            );
            carBody.castShadow = true;
            // Cabin/roof for silhouette readability
            const carRoof = new THREE.Mesh(
              new THREE.BoxGeometry(0.24, 0.12, 0.2),
              carMat
            );
            carRoof.position.set(-0.02, 0.12, 0);
            carBody.add(carRoof);
            carBody.position.y = 0.08;
            // Initial orientation matches the road
            carBody.rotation.y = -angle + (Math.random() < 0.5 ? 0 : Math.PI);     // half going each way
            const direction = carBody.rotation.y === -angle ? 1 : -1;
            const lateralOffset = direction === 1 ? -ROAD_WIDTH * 0.22 : ROAD_WIDTH * 0.22;
            // Stagger initial positions along the route
            const t0 = (i + Math.random()) / carCount;
            padScene.add(carBody);
            padCars.push({
              mesh: carBody,
              // Route endpoints are now plaza-edge → pad (NOT origin → pad)
              // so cars never enter the hub plaza.
              startX, startZ,
              padX: padPos.x, padZ: padPos.z,
              angle,
              direction,
              lateralOffset,
              t: t0,
              // Speed is fraction-of-route per second. Range chosen
              // so cars take 8-15 seconds to traverse — visible but
              // not distracting.
              speed: (1 / (8 + Math.random() * 7)) * direction,
            });
          }
        }
        // Expose for tickPad to animate each frame
        window.__padCars = padCars;
        // Distant horizon rings (multiple, suggests city skyline at varying distances)
        const skyMat1 = new THREE.LineBasicMaterial({ color: 0x00E5FF, transparent: true, opacity: 0.20 });
        const skyMat2 = new THREE.LineBasicMaterial({ color: 0x00E5FF, transparent: true, opacity: 0.10 });
        for (const [r, mat] of [[40, skyMat1], [70, skyMat2], [100, skyMat2]]) {
          const pts = [];
          for (let i = 0; i <= 96; i++) {
            const a = (i / 96) * Math.PI * 2;
            pts.push(new THREE.Vector3(Math.cos(a) * r, 0.05, Math.sin(a) * r));
          }
          padScene.add(new THREE.Line(new THREE.BufferGeometry().setFromPoints(pts), mat));
        }

        // Aircraft container — sits ON the pad
        padGroup = new THREE.Group();
        padGroup.position.y = 0.18;     // top of pad
        padScene.add(padGroup);

        function resize() {
          if (!canvas.parentElement) return;
          const w = canvas.parentElement.clientWidth;
          const h = canvas.parentElement.clientHeight;
          padRenderer.setSize(w, h, false);
          padCamera.aspect = w / h;
          padCamera.updateProjectionMatrix();
        }
        resize();
        window.addEventListener('resize', resize);

        // ===== Ground-cam input handlers — WASD + mouse-look =====
        // Only fire when ground cam is active so they don't interfere with editor.
        const onKeyDown = (e) => {
          if (!padGroundCam) return;
          // CRITICAL: don't fire WASD movement when the user is typing in
          // an input/textarea (chat field, save dialog, region select, etc).
          // Otherwise the same keypress would simultaneously type the letter
          // AND trigger walking — extremely disorienting if you're in the
          // SMS chat trying to message the operator and the camera also
          // strafes around as you type.
          const activeTag = document.activeElement?.tagName;
          if (activeTag === 'INPUT' || activeTag === 'TEXTAREA') return;
          const k = e.key.toLowerCase();
          if (k === 'w') padGroundState.keys.w = true;
          else if (k === 'a') padGroundState.keys.a = true;
          else if (k === 's') padGroundState.keys.s = true;
          else if (k === 'd') padGroundState.keys.d = true;
          else if (k === 'shift') padGroundState.keys.shift = true;
          else if (k === 'escape') {
            // Exit ground mode — restore orbit controls and click AUTO.
            padGroundCam = false;
            if (padControls) padControls.enabled = true;
            const overlay = document.getElementById('pad-ground-hud');
            if (overlay) overlay.style.display = 'none';
            const canvas = document.getElementById('pad-canvas');
            if (canvas) canvas.style.cursor = '';
            document.querySelectorAll('.pad-cam-btn').forEach(b => b.classList.remove('active'));
            const autoBtn = document.querySelector('.pad-cam-btn[data-cam="auto"]');
            if (autoBtn) autoBtn.classList.add('active');
            padManualCam = false;
            return;
          }
          else return;
          e.preventDefault();
        };
        const onKeyUp = (e) => {
          if (!padGroundCam) return;
          // Same input-focus check as keydown so released keys don't get
          // stuck in the "down" state if the user pressed them while
          // focused on an input. Without this, typing W in chat would
          // not register the down press but WOULD register the keyup,
          // potentially leaving keys.w in a stuck state from a prior frame.
          const activeTag = document.activeElement?.tagName;
          if (activeTag === 'INPUT' || activeTag === 'TEXTAREA') {
            // Defensively clear any stuck state on focus return
            padGroundState.keys.w = false;
            padGroundState.keys.a = false;
            padGroundState.keys.s = false;
            padGroundState.keys.d = false;
            padGroundState.keys.shift = false;
            return;
          }
          const k = e.key.toLowerCase();
          if (k === 'w') padGroundState.keys.w = false;
          else if (k === 'a') padGroundState.keys.a = false;
          else if (k === 's') padGroundState.keys.s = false;
          else if (k === 'd') padGroundState.keys.d = false;
          else if (k === 'shift') padGroundState.keys.shift = false;
        };
        window.addEventListener('keydown', onKeyDown);
        window.addEventListener('keyup', onKeyUp);

        // Mouse-look — click and drag to rotate the camera (no pointer lock,
        // cursor stays visible). Hold the left mouse button and drag to look around.
        // Active in BOTH ground walk mode AND cabin chair view; the move
        // handler routes the dx/dy to the appropriate state object.
        // ESC exits ground mode via the keydown handler above.
        const padCanvasEl = document.getElementById('pad-canvas');
        if (padCanvasEl) {
          let isDragging = false;
          let lastX = 0, lastY = 0;
          const inMouseLookMode = () => padGroundCam || window.__padCabinCam;
          padCanvasEl.addEventListener('mousedown', (e) => {
            if (!inMouseLookMode()) return;
            if (e.button !== 0) return;     // left button only
            isDragging = true;
            lastX = e.clientX;
            lastY = e.clientY;
            padCanvasEl.style.cursor = 'grabbing';
          });
          window.addEventListener('mouseup', () => {
            if (isDragging) {
              isDragging = false;
              if (padCanvasEl) padCanvasEl.style.cursor = inMouseLookMode() ? 'grab' : '';
            }
          });
          window.addEventListener('mousemove', (e) => {
            if (!inMouseLookMode() || !isDragging) return;
            const dx = e.clientX - lastX;
            const dy = e.clientY - lastY;
            lastX = e.clientX;
            lastY = e.clientY;
            const sens = 0.005;
            const maxPitch = Math.PI / 2 - 0.05;
            if (window.__padCabinCam && window.__padCabinPan) {
              // Cabin pan — yaw/pitch deltas added on top of aircraft heading
              window.__padCabinPan.yaw   -= dx * sens;
              window.__padCabinPan.pitch -= dy * sens;
              window.__padCabinPan.pitch = Math.max(-maxPitch, Math.min(maxPitch, window.__padCabinPan.pitch));
            } else if (padGroundCam) {
              // Ground walk — same input goes to ground state
              padGroundState.yaw   -= dx * sens;
              padGroundState.pitch -= dy * sens;
              padGroundState.pitch = Math.max(-maxPitch, Math.min(maxPitch, padGroundState.pitch));
            }
          });
        }

        function tickPad() {
          requestAnimationFrame(tickPad);
          if (!padActive) return;
          const t = (performance.now() - padStartTime) / 1000;

          // ============================================================
          // IR RECOVERY VEHICLE — state machine
          // ============================================================
          // States: parked (idle at home) → driving_out (heading to
          // abort scene) → on_scene (holding for ~6s while taxi
          // settles) → driving_back (returning home) → parked.
          // Movement is a simple lerp on XZ; the truck rotates to
          // face its travel direction. The light bar pulses while
          // the vehicle is non-parked so the user can see it's
          // responding.
          // ============================================================
          try {
            const veh = padScene && padScene.userData && padScene.userData.irVehicle;
            if (veh && veh.userData && veh.userData.state !== 'parked') {
              const ud = veh.userData;
              const nowMs = performance.now();
              const driveSpeed = 4.5;     // m/s
              const dt = (window.__irLastTickMs ? (nowMs - window.__irLastTickMs) / 1000 : 0.016);
              window.__irLastTickMs = nowMs;
              if (ud.state === 'driving_out' || ud.state === 'driving_back') {
                const tx = ud.targetX;
                const tz = ud.targetZ;
                const dx = tx - veh.position.x;
                const dz = tz - veh.position.z;
                const dist = Math.sqrt(dx * dx + dz * dz);
                if (dist < 0.1) {
                  veh.position.x = tx;
                  veh.position.z = tz;
                  if (ud.state === 'driving_out') {
                    ud.state = 'on_scene';
                    ud.stateUntil = nowMs + 6000;
                  } else {
                    ud.state = 'parked';
                    veh.rotation.y = ud.homeRotY;
                  }
                } else {
                  const step = Math.min(dist, driveSpeed * dt);
                  veh.position.x += (dx / dist) * step;
                  veh.position.z += (dz / dist) * step;
                  // Face direction of travel
                  veh.rotation.y = Math.atan2(dx, dz);
                }
              } else if (ud.state === 'on_scene') {
                if (nowMs >= ud.stateUntil) {
                  ud.state = 'driving_back';
                  ud.targetX = ud.homeX;
                  ud.targetZ = ud.homeZ;
                }
              }
              // Pulsing light bar while non-parked
              if (ud.lightBar && ud.lightBar.material && ud.lightBar.material.emissive) {
                const pulse = 0.5 + 0.5 * Math.sin(nowMs * 0.012);
                ud.lightBar.material.emissiveIntensity = 0.6 + pulse * 1.6;
              }
            } else if (veh && veh.userData && veh.userData.lightBar) {
              // Parked — dim light bar
              veh.userData.lightBar.material.emissiveIntensity = 0.5;
            }
          } catch (_) { /* never break the render loop on vehicle errors */ }

          // ============================================================
          // GROUND TRAFFIC ANIMATION
          // Each car's t advances by (speed × dt) per frame. When t
          // exceeds 1 or drops below 0, wrap to the other end so cars
          // continuously cycle along their route. Cars hold a fixed
          // perpendicular offset so opposing-direction traffic stays
          // in its own lane.
          // ============================================================
          {
            const cars = window.__padCars;
            if (cars && cars.length > 0) {
              const lastTime = window.__padCarsLastTime || performance.now();
              const now = performance.now();
              const dt = Math.min(0.1, (now - lastTime) / 1000);     // cap dt to avoid jumps
              window.__padCarsLastTime = now;
              for (const car of cars) {
                car.t += car.speed * dt;
                if (car.t > 1) car.t -= 1;
                if (car.t < 0) car.t += 1;
                // Position along the route — segment is plaza-edge
                // (startX, startZ) → pad (padX, padZ). User: "the
                // cars can't be going through the hub", so the
                // segment no longer starts at origin.
                const px = car.startX + (car.padX - car.startX) * car.t;
                const pz = car.startZ + (car.padZ - car.startZ) * car.t;
                // Apply perpendicular lateral offset so cars stay in lanes
                const cosA = Math.cos(car.angle);
                const sinA = Math.sin(car.angle);
                // Perpendicular direction: rotate route direction +90°
                const perpX = -sinA * car.lateralOffset;
                const perpZ =  cosA * car.lateralOffset;
                car.mesh.position.x = px + perpX;
                car.mesh.position.z = pz + perpZ;
              }
            }
          }

          // Cabin interior visibility sync — the luxury cabin is parented
          // to the customer's aircraft and persists in the scene from the
          // moment they board until they fully disembark. But it should
          // only be VISIBLE when the camera is actually inside the cabin.
          // Without this sync, switching to chase/auto/top camera while
          // inCabin (or briefly between phase transitions) shows the
          // cabin's exterior surfaces (brown seats, walls) clipping
          // through the aircraft body — exactly the "brown blob" bug.
          if (cabinInteriorGroup) {
            const shouldBeVisible = !!(window.__padCabinCam &&
              window.__customerModeState && window.__customerModeState.inCabin);
            if (cabinInteriorGroup.visible !== shouldBeVisible) {
              cabinInteriorGroup.visible = shouldBeVisible;
            }
          }

          // Audio phase tracking — shared between the flight branch (sets it) and
          // the unified end-of-tick block (reads it to drive PropellerSynth).
          let audioPhaseKind = null;     // 'cruise' | 'hover' | 'docked' | null
          let audioPhaseLocalT = 0;       // 0..1 progress within the current phase

          // ===== LANDING CLEANUP CATCH-UP (RACE FIX) =====
          // The 2D animator and the 3D animator both poll independently
          // each frame. Both reach mission-complete at the same scaled
          // time, but whichever fires FIRST on that frame wins.
          // - 3D fires first → its `if (!activePhase)` block runs,
          //   schedules the 1.5s settle setTimeout. Good.
          // - 2D fires first → flips `flight.active = false` BEFORE the
          //   3D block runs. On the next tickPad frame, the entire 3D
          //   block is skipped because of `if (...active)` guard. The
          //   flying clone is STRANDED at whatever position the last
          //   3D animation frame put it (mid-descent? hover pose?)
          //   and never reaches the apron, never gets removed, never
          //   gets replaced with the parked apron group. The user sees
          //   "the taxi disappears" — actually the clone is somewhere
          //   else in the scene (often invisible due to being below
          //   ground or out of frame).
          //
          // This catch-up block runs OUTSIDE the active-gate. It looks
          // for flights where active just flipped to false but the 3D
          // cleanup hasn't fired yet, and triggers the cleanup right
          // here. _3dCompleted gates against re-firing.
          if (padFlightStates && padFlightStates.length) {
            for (const f of padFlightStates) {
              if (!f) continue;
              if (f.active) continue;            // still flying — primary loop handles it
              if (f._3dCompleted) continue;      // 3D side already cleaned up
              if (!f.isClone || !f.acGroup) continue;     // nothing to settle
              // Catch up: do the same cleanup the active block would
              // have done if it had won the race.
              f._3dCompleted = true;
              f.transitioning = true;
              // Snap the stranded clone to its apron position. The
              // apronPosition for this design is where the flight
              // SHOULD have ended — not wherever the last 3D frame
              // happened to leave it.
              try {
                const ap = apronPosition(f.designId);
                f.acGroup.position.set(ap.x, 0, ap.z);
                if (typeof settleOnPad === 'function') {
                  settleOnPad(f.acGroup, 0, 0.02);
                }
              } catch (_) { /* settling is best-effort */ }
              const completedFlightCatchup = f;
              setTimeout(() => {
                completedFlightCatchup.transitioning = false;
                padFlightStates = padFlightStates.filter(ff => ff.active || ff.transitioning);
                window.__padFlightStates = padFlightStates;
                if (typeof renderFleetAprons === 'function') renderFleetAprons();
                requestAnimationFrame(() => {
                  if (completedFlightCatchup.acGroup && completedFlightCatchup.acGroup.parent) {
                    completedFlightCatchup.acGroup.parent.remove(completedFlightCatchup.acGroup);
                  }
                });
              }, 1500);
            }
          }

          // ===== Active 3D flight =====
          // If a flight is in progress, the aircraft animates along a real flight path:
          // HUB pad → climb → cruise to pickup → descend → hover → climb → cruise to dropoff →
          // descend → hover → climb → cruise back to HUB → descend → land.
          if (padFlightState && padFlightState.active) {
            const f = padFlightState;
            // Apply time scale so user can fast-forward long missions
            const elapsed = ((performance.now() - f.startTime) / 1000) * padTimeScale;
            const PHASES = f.phases;

            // Sync padFlightStates to window each frame so outer-scope
            // handlers (E-key boarding) can find flights via designId.
            // We re-sync every frame because the array reference changes
            // when filters reassign it (e.g. on completion cleanup).
            window.__padFlightStates = padFlightStates;

            // ===== CUSTOMER MODE: TRACK USER POSITION =====
            // The user can move (ground-mode walking, or just initial spawn
            // wherever they were placed). The taxi must land at their actual
            // location, not at a pre-baked city pad coordinate. Each frame,
            // update phases 2-5 (inbound cruise, descent, hover, post-hover
            // climb) to point at __customerGroundPos. Lock the waypoint at
            // the start of vertical_descent (phase 3) — once the taxi is
            // committing to a touchdown, it can't re-target without
            // looking insane. After lock the phases stay frozen.
            if (window.__customerModeActive && f.designId === window.__customerAircraftId &&
                window.__customerGroundPos && !window.__customerPickupLocked) {
              const gp = window.__customerGroundPos;
              const newTo = { x: gp.x, z: gp.z };
              if (PHASES[2]) PHASES[2].to   = newTo;     // hub → pickup cruise
              if (PHASES[3]) { PHASES[3].from = newTo; PHASES[3].to = newTo; }  // vertical_descent at pickup
              if (PHASES[4]) { PHASES[4].from = newTo; PHASES[4].to = newTo; }  // hover at pickup
              if (PHASES[5]) { PHASES[5].from = newTo; PHASES[5].to = newTo; }  // vertical_climb after pickup
              if (PHASES[6]) PHASES[6].from = newTo;     // pickup → dropoff cruise starts here
              // Recompute miles for the inbound leg so battery / status text
              // reflects the actual flown distance (the user might be at a
              // slightly different point than the original pad).
              const hub = PHASES[0]?.from;
              if (hub && PHASES[2]) {
                PHASES[2].miles = Math.hypot(newTo.x - hub.x, newTo.z - hub.z);
              }
            }
            // LOCK final-approach waypoint at the start of phase 3 (vertical
            // descent at pickup). The taxi has committed; no further updates.
            if (window.__customerModeActive && f.designId === window.__customerAircraftId &&
                !window.__customerPickupLocked) {
              // Find which phase we'd be in given current elapsed
              let pt = 0;
              for (let i = 0; i < PHASES.length; i++) {
                if (elapsed < pt + PHASES[i].dur) {
                  if (i >= 3) window.__customerPickupLocked = true;
                  break;
                }
                pt += PHASES[i].dur;
              }
            }

            // Find which phase we're in
            let phaseTime = 0;
            let activePhase = null;
            let phaseIndex = -1;
            for (let i = 0; i < PHASES.length; i++) {
              const p = PHASES[i];
              if (elapsed < phaseTime + p.dur) {
                activePhase = p;
                activePhase.localT = (elapsed - phaseTime) / p.dur;
                phaseIndex = i;
                // Expose to audio code outside the flight branch
                audioPhaseKind = activePhase.kind;
                audioPhaseLocalT = activePhase.localT;
                break;
              }
              phaseTime += p.dur;
            }

            // ===== CUSTOMER MODE PHASE-TRANSITION HOOKS =====
            // When the customer's aircraft enters its first cruise leg
            // (after pickup), auto-engage cabin view. When it lands at
            // dropoff or returns home, auto-exit. We detect transitions by
            // comparing this phase's kind to the previous frame's.
            if (activePhase && f && f.designId === window.__customerAircraftId &&
                window.__customerModeActive) {
              const prevKind = f._lastPhaseKind || null;
              const curKind = activePhase.kind;
              // Count how many hover phases we've passed (1=pickup boarding,
              // 2=dropoff disembark) so we know which leg we're on
              let hoverCount = 0;
              for (let k = 0; k <= phaseIndex; k++) {
                if (PHASES[k] && PHASES[k].kind === 'hover') hoverCount++;
              }

              // STAGE TRACKING: write a single stage label to the customer
              // state so other consumers (ground-mode spawn, HUD text, etc.)
              // can read where the customer "is" in the flow without
              // recomputing hoverCount themselves.
              //   hoverCount 0          → 'inbound_to_pickup' (user at pickup, waiting)
              //   hoverCount 1, !inCabin → 'at_pickup' (board prompt visible)
              //   hoverCount 1+, inCabin → 'in_cabin' (riding)
              //   hoverCount 2+, !inCabin → 'at_dropoff' (disembarked, watching taxi go home)
              //   isAbortLeg            → 'aborting' (fault injected, taxi returning to hub)
              if (window.__customerModeState) {
                const isAbortPhase = !!(activePhase && activePhase.isAbortLeg);
                if (isAbortPhase) {
                  // Customer flight aborted — taxi is returning home with
                  // the failure announced. Push a recent-activity event
                  // ONCE per failure (guard with f._failureAnnounced).
                  if (!f._failureAnnounced && f.failure) {
                    f._failureAnnounced = true;
                    if (typeof window.__pushRecentEvent === 'function') {
                      try {
                        window.__pushRecentEvent('failure',
                          `${(f.tail || 'TAXI')} ABORT — ${f.failure.label}`);
                      } catch (_) {}
                    }
                    // Persistent per-kind fault counter — increments
                    // the splash-screen tally. Survives page reloads.
                    if (typeof window.__recordFault === 'function') {
                      try { window.__recordFault(f.failure.kind); } catch (_) {}
                    }
                    // Trigger fault-aware crew conversation. The crew at
                    // the hub "detects" the failure and discusses it with
                    // failure-specific terminology (motor out → MAINT
                    // flags it to DISPATCH; control link loss → OPS to
                    // ATC; etc). Comic bubbles render at the hub; the
                    // text feed updates either way so the customer also
                    // sees their crew reacting.
                    if (typeof window.__triggerCrewFaultConversation === 'function') {
                      try {
                        window.__triggerCrewFaultConversation(f.failure.kind, f.tail);
                      } catch (err) { console.warn('[crew fault convo] failed:', err); }
                    }
                    // Physically converge crew on the landing pad to
                    // receive the inbound aborting taxi. User: "the AI
                    // workers need to ensure that the Taxi is docking
                    // ASAP." The dialogue says it; this makes the user
                    // SEE it — GROUND, MAINT, and DISPATCH walk to
                    // pad-side stations and stand by until the taxi
                    // docks. Runs for any fault kind, not just motor_out.
                    if (typeof window.__dispatchCrewForEmergencyLanding === 'function') {
                      try {
                        window.__dispatchCrewForEmergencyLanding(f.tail);
                      } catch (err) { console.warn('[emergency landing dispatch] failed:', err); }
                    }
                    // VISIBLE motor failure for motor_out specifically.
                    // User: "the motor out is seen clearly not just
                    // hearsay." Pick a random rotor on this flight and
                    // mark it dead — it freezes mid-spin, tilts visibly,
                    // gets a red emissive damage ring, and the blade
                    // material darkens. The rest of the rotors keep
                    // spinning, so the asymmetry sells the failure even
                    // from a distance.
                    if (f.failure.kind === 'motor_out' &&
                        f.rotors && f.rotors.length > 0 &&
                        typeof window.__markRotorDead === 'function') {
                      try {
                        const idx = Math.floor(Math.random() * f.rotors.length);
                        window.__markRotorDead(f.rotors[idx]);
                      } catch (err) { console.warn('[markRotorDead] failed:', err); }
                    }
                    // IR (Incident Response) recovery — drive the truck
                    // out toward where the aircraft is currently. The
                    // taxi auto-flies back via abort phases; the IR
                    // vehicle visually escorts the recovery, then
                    // returns home when the aircraft has docked. User:
                    // "if an air taxi is lost, they go out and find it,
                    // and bring back."
                    try {
                      if (typeof window.__dispatchIRVehicle === 'function') {
                        // Aim the vehicle toward the aircraft's current XZ
                        // (clamped to a reasonable ground-traversal radius
                        // so the truck doesn't drive off into the city).
                        const ax = (f.acGroup && f.acGroup.position) ? f.acGroup.position.x : 0;
                        const az = (f.acGroup && f.acGroup.position) ? f.acGroup.position.z : 0;
                        const MAX_R = 18;
                        const r = Math.sqrt(ax * ax + az * az);
                        const tx = r > MAX_R ? (ax / r) * MAX_R : ax;
                        const tz = r > MAX_R ? (az / r) * MAX_R : az;
                        window.__dispatchIRVehicle(tx, tz);
                      }
                      // IR crew posts an owner-addressed message — the
                      // boss should see field response in their own
                      // panel, not buried in crew-to-crew chatter.
                      const irCrew = pickCrewByRole('IR');
                      if (irCrew && typeof postCrewMessageToOwner === 'function') {
                        const T = `<span class="tail">${f.tail || 'SDX-####'}</span>`;
                        postCrewMessageToOwner(irCrew,
                          `Boss, IR rolling out for ${T}. Will escort her in and check the airframe.`);
                        // Also push an owner-addressed bubble at the IR figure
                        try {
                          const fig = findCrewFigureByName(irCrew.name);
                          if (fig) spawnCrewBubble(fig, `Rolling out for ${(f.tail || 'SDX-####')}`, { holdMs: 5500 });
                        } catch (_) {}
                      }
                    } catch (err) { console.warn('[IR response] failed:', err); }
                  }
                  window.__customerModeState.stage = 'aborting';
                } else if (window.__customerModeState.inCabin) {
                  window.__customerModeState.stage = 'in_cabin';
                } else if (hoverCount === 0) {
                  window.__customerModeState.stage = 'inbound_to_pickup';
                } else if (hoverCount === 1) {
                  window.__customerModeState.stage = 'at_pickup';
                } else {
                  window.__customerModeState.stage = 'at_dropoff';
                }
                // Re-hail button visibility — visible at dropoff so the
                // user can place another request from where they are now.
                // Hidden in all other states (in cabin, waiting at pickup,
                // or pre-launch).
                const rehailBtn = document.getElementById('customer-rehail-btn');
                if (rehailBtn) {
                  const showRehail = window.__customerModeState.stage === 'at_dropoff'
                                     && !window.__customerModeState.inCabin;
                  rehailBtn.hidden = !showRehail;
                }
                // Notify SMS chat — operator sends proactive messages
                // when the stage changes ("your taxi has arrived",
                // "you've boarded", "arrived at dropoff").
                if (typeof window.__customerChatOnStageChange === 'function') {
                  window.__customerChatOnStageChange(window.__customerModeState.stage);
                }
              }

              // Trigger 1: BOARD PROMPT during pickup hover (hoverCount===1
              // AND we're at the pickup pad). User sees a floating "PRESS E
              // TO BOARD" prompt; pressing E enters cabin view.
              //
              // We ALSO stash the flight reference on __customerModeState
              // so the E key handler (which lives at outer scope and can't
              // see padFlightStates lexically) has access to the right
              // aircraft object when boarding. We use `activeFlight` for
              // the dispatch-loop stash; `cabinAircraft` is the acGroup
              // set by enterCabinView once the user actually boards.
              if (window.__customerModeState) {
                window.__customerModeState.activeFlight = f;
              }
              const promptEl = document.getElementById('cabin-board-prompt');
              if (promptEl) {
                if (curKind === 'hover' && hoverCount === 1 && !window.__customerModeState.inCabin) {
                  promptEl.classList.add('active');
                  document.getElementById('cabin-board-prompt-text').innerHTML =
                    'TAXI ARRIVED · PRESS <kbd>E</kbd> TO BOARD';
                } else if (curKind === 'hover' && hoverCount === 2 && window.__customerModeState.inCabin) {
                  // Dropoff hover — show "press E to disembark" once landed
                  promptEl.classList.add('active');
                  document.getElementById('cabin-board-prompt-text').innerHTML =
                    'ARRIVED AT DROPOFF · PRESS <kbd>E</kbd> TO DISEMBARK';
                } else {
                  promptEl.classList.remove('active');
                }
              }

              // Trigger 2: AUTO-EXIT cabin on mission complete or return-home cruise
              // Once aircraft is past the dropoff hover, the customer is no
              // longer riding (they got off). Use disembarkAtDropoff so the
              // user transitions to ground walk mode at the dropoff city
              // (same UX as pickup spawn), not a chase-cam fallback.
              if (hoverCount >= 2 && curKind !== 'hover' && window.__customerModeState.inCabin &&
                  curKind !== 'cruise') {
                if (typeof window.__disembarkAtDropoff === 'function') {
                  window.__disembarkAtDropoff();
                } else if (typeof window.__exitCabinView === 'function') {
                  window.__exitCabinView();
                }
                if (promptEl) promptEl.classList.remove('active');
              }

              f._lastPhaseKind = curKind;
            }

            if (!activePhase) {
              // 3D phase animation has run past the last phase. Do the
              // visual cleanup (settle clone on apron, schedule removal)
              // but DO NOT set flight.active = false here. The 2D
              // animator is the single source of truth for "this flight
              // is officially complete" — it sets active=false AND
              // calls recordFlightCompletion for the global flight
              // counter. Killing active here would race the 2D animator's
              // `if (!flight.active) return` short-circuit which fires
              // BEFORE its completion path, so flights would never count
              // toward the splash counter.
              const completedFlight = padFlightState;     // capture before reassign
              if (completedFlight._3dCompleted) {
                // 3D side already cleaned up — wait for 2D animator
              } else {
                completedFlight._3dCompleted = true;
                // CRITICAL: flip THIS object's active flag.
                //
                // padFlightStates[i] (this object, completedFlight) and
                // padDispatchedFlights[j] (the 2D animator's `flight`)
                // are SEPARATE objects despite sharing some fields.
                // The 2D animator's `flight.active = false` only flips
                // its own (padDispatchedFlights) entry. If we don't
                // flip ours here, padFlightStates entry's `active`
                // stays true forever and the map "X/N IN FLIGHT"
                // badge filter (`f.active && f.designId`) keeps
                // counting completed flights — looks frozen at the
                // peak count. The "2D is single source of truth"
                // comment was about ensuring recordFlightCompletion
                // (global splash counter) fires exactly once via the
                // 2D path; that's still true. Flipping our own active
                // doesn't affect the 2D animator's short-circuit.
                completedFlight.active = false;

                // If the flight had its own cloned acGroup, fade and remove it.
                // The descent + docked phases ended AT the apron pad (we patched
                // those phases' targets at launch time), so the clone is already
                // sitting where it belongs. No teleport needed — only a settle
                // for skid clearance, then schedule cleanup.
                if (completedFlight.isClone && completedFlight.acGroup) {
                  completedFlight.transitioning = true;
                  // Snap to exact apron pad top Y. The descent phase already
                  // has the clone at the right XZ from phase patching; this
                  // ensures the Y matches the apron pad surface. Then settleOnPad
                  // applies skid clearance so the geometry doesn't clip into
                  // the pad during the 1.5s fade.
                  completedFlight.acGroup.position.y = 0;
                  settleOnPad(completedFlight.acGroup, 0, 0.02);
                  setTimeout(() => {
                    // FIX for "disappearing on landing": build the apron
                    // group BEFORE removing the flying clone. There's a
                    // frame between clone removal and apron rebuild
                    // where nothing was visible at the apron position
                    // — caused the aircraft to look like it vanished
                    // briefly. Now both meshes coexist for one frame
                    // during the swap.
                    completedFlight.transitioning = false;
                    padFlightStates = padFlightStates.filter(f => f.active || f.transitioning);
                    window.__padFlightStates = padFlightStates;
                    if (typeof renderFleetAprons === 'function') renderFleetAprons();
                    // Remove the flying clone in the next animation
                    // frame so the new apron group renders alongside it
                    // (no empty-frame gap)
                    requestAnimationFrame(() => {
                      if (completedFlight.acGroup && completedFlight.acGroup.parent) {
                        completedFlight.acGroup.parent.remove(completedFlight.acGroup);
                      }
                    });
                    // padGroup visibility recomputes per-frame — see animation tick.
                  }, 1500);
                } else if (padGroup) {
                  // Fallback path — primary used padGroup directly
                  padGroup.position.set(0, 0, 0);
                }

                // Remove destination pads + customer markers (these are unique per flight)
                if (completedFlight.sceneAdds) {
                  completedFlight.sceneAdds.forEach(o => padScene.remove(o));
                }
              }

              // Drop fully-completed flights from the array. Transitioning
              // flights (active=false but clone still in scene during 1.5s
              // fade) are KEPT — visibility logic + apron filter both need
              // to see them to avoid duplicating the aircraft at hub+apron.
              // (This filter still runs every frame in this branch so the
              // array stays clean once the 2D animator marks active=false.)
              padFlightStates = padFlightStates.filter(f => f.active || f.transitioning);
              window.__padFlightStates = padFlightStates;
              // Promote the next active flight to primary (camera tracks it),
              // or null when nothing is actively flying
              const nextActive = padFlightStates.find(f => f.active);
              padFlightState = nextActive || null;
            } else {
              // Smooth ease-in-out
              // ===== Smooth simultaneous motion =====
              // Vertical climb/descent and horizontal motion happen TOGETHER, both governed
              // by a single smooth-step curve so there's no "hold horizontal then jump."
              // Climb/descent durations scale with trip distance so short trips have
              // proportionally short climbs (no jumpy fixed-duration climb on a 2-mile hop).

              // Cubic smooth-step (3x² − 2x³): zero velocity at endpoints, peaks in middle
              const smoothStep = (x) => x * x * (3 - 2 * x);

              let horizontalT;
              const PAD_TOP_Y = 0;
              // Per-flight cruise altitude offset. Each flight gets a
              // unique vertical layer so multiple AI taxis crossing the
              // same airspace are stacked vertically rather than mashed
              // together at the same altitude (the "mid-air collision"
              // visual the user reported). Offset is set at dispatch time
              // and stored on the flight object so it stays consistent
              // across phases. Range: ±6 units around base CRUISE_ALT,
              // distributed pseudo-randomly. Customer's flight uses 0
              // offset (sits at the canonical cruise altitude).
              const BASE_CRUISE_ALT = 28;
              const altOffset = (typeof f.cruiseAltOffset === 'number')
                ? f.cruiseAltOffset
                : 0;
              const CRUISE_ALT = BASE_CRUISE_ALT + altOffset;
              let altitude = PAD_TOP_Y;

              if (activePhase.kind === 'preflight') {
                // Aircraft sits on pad. No movement, no altitude change.
                // Rotors are spinning up — handled in spinRate below. Slight
                // ground-effect bob simulates rotor wash / settling.
                altitude = PAD_TOP_Y + Math.sin(t * 6) * 0.005 * smoothStep(activePhase.localT);
                horizontalT = 0;
              } else if (activePhase.kind === 'vertical_climb') {
                // Pure vertical lift from pad to cruise altitude. No horizontal motion.
                altitude = PAD_TOP_Y + (CRUISE_ALT - PAD_TOP_Y) * smoothStep(activePhase.localT);
                horizontalT = 0;
              } else if (activePhase.kind === 'vertical_descent') {
                // Pure vertical descent from cruise altitude to pad.
                altitude = PAD_TOP_Y + (CRUISE_ALT - PAD_TOP_Y) * smoothStep(1 - activePhase.localT);
                horizontalT = 0;
              } else if (activePhase.kind === 'cruise') {
                // Cruise is now LEVEL FLIGHT only — climb is handled by the
                // preceding vertical_climb phase, descent by the following
                // vertical_descent phase. So altitude stays at cruise constant
                // and we only interpolate horizontally with smooth-step easing.
                altitude = CRUISE_ALT;
                horizontalT = smoothStep(activePhase.localT);
              } else if (activePhase.kind === 'hover') {
                altitude = 0.45 + Math.sin(t * 4) * 0.03;
                horizontalT = 0;
              } else if (activePhase.kind === 'docked') {
                altitude = PAD_TOP_Y;
                horizontalT = 0;
              } else {
                horizontalT = smoothStep(activePhase.localT);
              }

              const fx = activePhase.from.x + (activePhase.to.x - activePhase.from.x) * horizontalT;
              const fz = activePhase.from.z + (activePhase.to.z - activePhase.from.z) * horizontalT;
              const animGroup = f.acGroup || padGroup;
              if (animGroup) {
                animGroup.position.set(fx, altitude, fz);
                if (activePhase.kind === 'cruise') {
                  // Aircraft model's wide nose (bulbous cabin) points along -X axis locally,
                  // so we need atan2(-dz, dx) + π to align the nose with travel direction.
                  const dx = activePhase.to.x - activePhase.from.x;
                  const dz = activePhase.to.z - activePhase.from.z;
                  if (Math.abs(dx) > 0.01 || Math.abs(dz) > 0.01) {
                    animGroup.rotation.y = Math.atan2(-dz, dx) + Math.PI;
                  }
                  animGroup.rotation.z = Math.sin(t * 0.4) * 0.04;
                  animGroup.rotation.x = -0.05;
                } else {
                  animGroup.rotation.z = 0;
                  animGroup.rotation.x = 0;
                }
              }
              // Rotor spin rate matches phase kind. Preflight ramps up gradually
              // from idle to hover-power so the visual + audio "spool up" matches
              // the aircraft preparing to lift off — without this, rotors instantly
              // hit hover speed at t=0 of preflight.
              let spinRate;
              if (activePhase.kind === 'preflight') {
                // Linear ramp from 0.05 (idle) to 0.40 (hover) over preflight phase
                spinRate = 0.05 + (0.40 - 0.05) * activePhase.localT;
              } else if (activePhase.kind === 'vertical_climb' || activePhase.kind === 'vertical_descent') {
                spinRate = 0.50;     // slightly more thrust than hover for vertical motion
              } else if (activePhase.kind === 'cruise') {
                spinRate = 0.55;
              } else if (activePhase.kind === 'hover') {
                spinRate = 0.40;
              } else {
                spinRate = 0.18;
              }
              const flightRotors = (f.rotors && f.rotors.length > 0) ? f.rotors : padRotors;
              flightRotors.forEach((r, i) => {
                // Dead rotors stay still — set by markRotorDead when a
                // motor_out fault fires. Other rotors keep spinning at
                // the phase rate so the asymmetry is visible (one
                // frozen, the rest humming).
                if (r && r.userData && r.userData.isDead) return;
                r.rotation.y += spinRate + (i % 2) * 0.02;
              });

              // ===== ANIMATE CUSTOMER FIGURE =====
              // Phase 0: customer waits at pickup pad (idle bob)
              // Phase 1: hover/boarding — customer walks toward aircraft, then is "loaded" (moves up + vanishes)
              // Phase 3: hover/disembarking at dropoff — customer reappears at dropoff pad and walks away
              if (f.customerFigure) {
                const cust = f.customerFigure;
                // Helper to switch the articulated figure between standing and
                // sitting poses without re-applying every frame (cheap idempotent).
                const setPose = (sit) => {
                  if (cust.userData?.setSittingPose && cust.userData.isSitting !== sit) {
                    cust.userData.setSittingPose(sit);
                    cust.userData.isSitting = sit;
                  }
                };
                // The figure's hip-joint is at HIP_Y = 0.22 in figure-local coords.
                // For SITTING: position figure root so hip lands AT the cushion top
                //   → root.y = cushionY - 0.22
                // For STANDING (walking on ground): root.y = 0 means feet on ground
                //   → root.y = walking-bob amount
                const FIGURE_HIP_HEIGHT = 0.22;
                // Customer figure animation logic — keyed on phase KIND and
                // mission leg (which hover phase is this — boarding or
                // disembarking?) rather than fixed indices, so it adapts
                // automatically to the new 13-phase mission structure.
                // Find which "stage" of the mission we're in:
                //   - waitingAtPickup: any phase before the pickup hover
                //   - boarding:        the FIRST hover phase (at pickup)
                //   - cruising:        between the boarding hover and disembarking hover
                //   - disembarking:    the SECOND hover phase (at dropoff)
                //   - hidden:          after disembark
                let stage = 'waitingAtPickup';
                let hoverCount = 0;
                for (let k = 0; k <= phaseIndex; k++) {
                  const pk = f.phases[k];
                  if (pk && pk.kind === 'hover') hoverCount++;
                }
                if (activePhase.kind === 'hover' && hoverCount === 1) stage = 'boarding';
                else if (activePhase.kind === 'hover' && hoverCount === 2) stage = 'disembarking';
                else if (hoverCount === 0) stage = 'waitingAtPickup';
                else if (hoverCount === 1) stage = 'cruising';        // post-boarding, pre-disembark
                else stage = 'hidden';                                  // post-disembark

                if (stage === 'waitingAtPickup') {
                  // Waiting at pickup pad — small idle bob, look toward incoming aircraft
                  setPose(false);
                  cust.visible = true;
                  cust.position.set(f.pickupPos.x + 0.8, Math.sin(t * 2) * 0.02, f.pickupPos.z + 0.3);
                  cust.lookAt(fx, 0.3, fz);
                } else if (stage === 'boarding') {
                  // Boarding — walk to aircraft, climb up, sit on cushion
                  cust.visible = true;
                  const lt = activePhase.localT;
                  // Compute the SEAT cushion-top world position this frame.
                  // boardingOffset.y already points at the cushion top. To make
                  // the figure sit ON the cushion, position the figure root so
                  // its hip-joint (at FIGURE_HIP_HEIGHT in figure-local) lands
                  // there: root.y = cushionY - FIGURE_HIP_HEIGHT.
                  const ac = f.acGroup;
                  let cushionX = fx, cushionY = 0.4, cushionZ = fz;
                  if (f.boardingOffset && ac) {
                    cushionX = ac.position.x + f.boardingOffset.x;
                    cushionY = ac.position.y + f.boardingOffset.y;
                    cushionZ = ac.position.z + f.boardingOffset.z;
                  }
                  const seatedRootY = cushionY - FIGURE_HIP_HEIGHT;
                  // Phase split:
                  //   0.00 → 0.45  walk on the ground from waiting spot to under aircraft (STANDING)
                  //   0.45 → 0.70  climb up to cushion height, still STANDING
                  //   0.70 → 1.00  switch to SITTING pose, settle on cushion
                  if (lt < 0.45) {
                    setPose(false);     // standing while walking
                    const walkT = lt / 0.45;
                    const sx = f.pickupPos.x + 0.8;
                    const sz = f.pickupPos.z + 0.3;
                    cust.position.x = sx + (fx - sx) * walkT;
                    cust.position.z = sz + (fz - sz) * walkT;
                    // Walking bob
                    cust.position.y = Math.abs(Math.sin(t * 8)) * 0.04;
                    cust.lookAt(fx, 0.3, fz);
                    cust.scale.set(1, 1, 1);
                  } else if (lt < 0.70) {
                    // Climb up to cushion height — still standing pose for now
                    setPose(false);
                    const climbT = (lt - 0.45) / 0.25;
                    const eased = climbT * climbT * (3 - 2 * climbT);
                    cust.position.x = fx + (cushionX - fx) * eased;
                    cust.position.y = 0 + (seatedRootY - 0) * eased;
                    cust.position.z = fz + (cushionZ - fz) * eased;
                    cust.rotation.y = (ac?.rotation.y) || 0;
                    cust.scale.set(1, 1, 1);
                  } else {
                    // Sitting down — pose the figure as seated (legs forward/down)
                    setPose(true);
                    cust.position.x = cushionX;
                    cust.position.y = seatedRootY;
                    cust.position.z = cushionZ;
                    cust.rotation.y = (ac?.rotation.y) || 0;
                    cust.scale.set(1, 1, 1);
                  }
                } else if (stage === 'cruising') {
                  // Cruising — customer is SEATED in the cushion, riding along.
                  // Track the aircraft's current world position so they stay in
                  // the seat as the aircraft moves.
                  const ac = f.acGroup;
                  if (f.boardingOffset && ac) {
                    setPose(true);
                    const cushionY = ac.position.y + f.boardingOffset.y;
                    cust.position.x = ac.position.x + f.boardingOffset.x;
                    cust.position.y = cushionY - FIGURE_HIP_HEIGHT;
                    cust.position.z = ac.position.z + f.boardingOffset.z;
                    cust.rotation.y = ac.rotation.y;
                    cust.visible = true;
                    cust.scale.set(1, 1, 1);
                  } else {
                    // No seat — hide during cruise (legacy behavior)
                    cust.visible = false;
                    cust.scale.set(1, 1, 1);
                  }
                } else if (stage === 'disembarking') {
                  // Disembarking at dropoff — stand up from seat, drop to ground,
                  // walk to dropoff pad
                  cust.visible = true;
                  const lt = activePhase.localT;
                  const ac = f.acGroup;
                  // Where the figure was sitting (seated root y)
                  let startX = fx, startY = 0.4 - FIGURE_HIP_HEIGHT, startZ = fz;
                  if (f.boardingOffset && ac) {
                    startX = ac.position.x + f.boardingOffset.x;
                    startY = ac.position.y + f.boardingOffset.y - FIGURE_HIP_HEIGHT;
                    startZ = ac.position.z + f.boardingOffset.z;
                  }
                  if (lt < 0.4) {
                    // Stand up out of the seat (switch pose), drop from seat
                    // height to ground beside aircraft
                    setPose(false);
                    const dropT = lt / 0.4;
                    const eased = dropT * dropT * (3 - 2 * dropT);
                    cust.position.x = startX + (fx - startX) * eased;
                    cust.position.y = startY + (0 - startY) * eased;
                    cust.position.z = startZ + (fz - startZ) * eased;
                    cust.scale.set(1, 1, 1);
                  } else {
                    // Walk away from aircraft to a spot near the dropoff pad
                    setPose(false);
                    const walkT = (lt - 0.4) / 0.6;
                    const sx = f.dropoffPos.x;
                    const sz = f.dropoffPos.z;
                    const tx = f.dropoffPos.x + 0.9;
                    const tz = f.dropoffPos.z + 0.5;
                    cust.position.x = sx + (tx - sx) * walkT;
                    cust.position.z = sz + (tz - sz) * walkT;
                    cust.position.y = Math.abs(Math.sin(t * 8)) * 0.04;
                    cust.scale.set(1, 1, 1);
                    cust.lookAt(tx + 1, 0.3, tz + 1);
                  }
                } else {
                  cust.visible = false;
                }
              }

              // Camera target — chase cam behind aircraft. We compute the IDEAL camera
              // position here, but actual camera lerps toward it (see end of tick) so phase
              // transitions don't snap.
              if (activePhase.kind === 'cruise' || activePhase.kind === 'hover') {
                // Camera height is ALWAYS at least 8 units (above the 5.7-unit max building height)
                // so buildings can never sit between the camera and the aircraft. When the
                // aircraft is low (descent/hover), we look down at it from above; when cruising
                // high, we trail behind at altitude+3.5.
                // Chase camera scales with altitude so high cruise stays visible.
                // Camera height is always 4-7u above the aircraft, with a minimum
                // floor of 8.5u to clear buildings during low approaches.
                const camHeight = Math.max(altitude + 5, 8.5);
                // Chase distance grows with altitude so the framing stays good.
                // Higher cruise → camera further back so the city stays in shot.
                const camOffsetDist = 4.5 + Math.min(8, altitude * 0.35);
                let backX = -1, backZ = 0;
                if (activePhase.kind === 'cruise') {
                  const dx = activePhase.to.x - activePhase.from.x;
                  const dz = activePhase.to.z - activePhase.from.z;
                  const mag = Math.hypot(dx, dz);
                  if (mag > 0.01) { backX = -dx / mag; backZ = -dz / mag; }
                }
                padCamTarget.x = fx + backX * camOffsetDist + Math.cos(t * 0.15) * 0.6;
                padCamTarget.z = fz + backZ * camOffsetDist + Math.sin(t * 0.15) * 0.6;
                padCamTarget.y = camHeight;
                padCamLookTarget.x = fx; padCamLookTarget.y = altitude; padCamLookTarget.z = fz;
              } else {
                // Docked or other: orbit around the aircraft's current position from above
                padCamTarget.x = fx + Math.cos(t * 0.06) * 8;
                padCamTarget.z = fz + Math.sin(t * 0.06) * 8;
                padCamTarget.y = 8.5;        // always above buildings
                padCamLookTarget.x = fx; padCamLookTarget.y = altitude; padCamLookTarget.z = fz;
              }

              // ===== CABIN VIEW CAMERA OVERRIDE =====
              // If we're in customer mode AND this is the customer's aircraft
              // AND the cabin view is active, override the chase cam: sit the
              // camera AT the seat, looking forward in the direction of travel.
              // The seat position is the aircraft's center + an upward offset
              // (0.6u for chair height) + a forward offset along the heading.
              if (window.__customerModeState && window.__customerModeState.inCabin &&
                  f && f.designId === window.__customerAircraftId) {
                const seatY = altitude + 0.6;
                // Compute forward direction
                let fwdX = 1, fwdZ = 0;
                if (activePhase.kind === 'cruise') {
                  const dx = activePhase.to.x - activePhase.from.x;
                  const dz = activePhase.to.z - activePhase.from.z;
                  const mag = Math.hypot(dx, dz);
                  if (mag > 0.01) { fwdX = dx / mag; fwdZ = dz / mag; }
                }
                // Camera sits slightly back from aircraft center (at "rear seat"),
                // looking forward over the nose
                padCamTarget.x = fx - fwdX * 0.4;
                padCamTarget.y = seatY;
                padCamTarget.z = fz - fwdZ * 0.4;
                padCamLookTarget.x = fx + fwdX * 12;     // looking far forward
                padCamLookTarget.y = altitude + 0.4;     // slight downward look
                padCamLookTarget.z = fz + fwdZ * 12;
                // Restore normal fog while in cabin — at cruise altitude the
                // user is high above haze and should see the world go by
                if (padScene && padScene.fog) {
                  padScene.fog.near = 80;
                  padScene.fog.far = 550;
                }
              }

              // ===== CUSTOMER WAITING-AT-PICKUP CAMERA OVERRIDE =====
              // BEFORE the customer boards the taxi, the user IS at their
              // ground position — they hailed a ride and are now standing
              // there. We pin the camera to that exact point. After dropoff,
              // when they exit the cabin, we anchor at the dropoff city
              // (since the user got teleported back to ground level there).
              //
              // Note: when ground walk mode is active, padGroundCam owns the
              // camera and returns early before reaching here, so this
              // override only runs for non-ground (chase-cam) mode. That's
              // correct — ground mode is its own first-person camera.
              if (window.__customerModeActive && !window.__customerModeState?.inCabin &&
                  f && f.designId === window.__customerAircraftId) {
                let hoversPassed = 0;
                for (let k = 0; k <= phaseIndex; k++) {
                  if (PHASES[k] && PHASES[k].kind === 'hover') hoversPassed++;
                }
                const region = REGIONS[window.__sdxCurrentRegionKey || 'SF BAY'];
                let anchor = null;
                if (hoversPassed === 0) {
                  // Inbound to pickup — user is at __customerGroundPos
                  anchor = window.__customerGroundPos;
                } else if (hoversPassed === 1 && activePhase.kind === 'hover') {
                  // At pickup hover — user still at pickup ground pos
                  anchor = window.__customerGroundPos;
                } else if (hoversPassed >= 2) {
                  // Past dropoff — user is now at dropoff city pad
                  anchor = region?.pads?.[window.__customerDropoff];
                }
                if (anchor) {
                  const eyeHeight = 1.7;
                  padCamTarget.x = anchor.x;
                  padCamTarget.y = eyeHeight;
                  padCamTarget.z = anchor.z;
                  padCamLookTarget.x = fx;
                  padCamLookTarget.y = Math.max(altitude, 3);
                  padCamLookTarget.z = fz;
                  // FOG TIGHTEN — hide the hub from city ground level
                  if (padScene && padScene.fog) {
                    padScene.fog.near = 12;
                    padScene.fog.far = 60;
                  }
                }
              }
              if (padScene.userData.lightDots) {
                const pulse = 0.7 + Math.abs(Math.sin(t * 3.0)) * 0.6;
                padScene.userData.lightDots.forEach((d, i) => {
                  d.material.emissiveIntensity = pulse * (1 + Math.sin(t * 2.0 + i * 0.4) * 0.3);
                });
              }
              // Fall through to the unified lerp + render block below — no early return.
            }
          }

          // ===== Animate ALL OTHER active flights (multi-flight 3D) =====
          // The primary flight (padFlightState) drives the camera + audio + customer.
          // Other simultaneous flights get a simpler animation: phase-driven position
          // + heading + rotor spin, no camera or audio (they're "background" aircraft).
          if (padFlightStates.length > 1) {
            for (const flight of padFlightStates) {
              if (flight === padFlightState) continue;     // skip primary, already done
              if (!flight.active) continue;
              // If the 3D side already finished cleanup but the 2D animator
              // hasn't fired its canonical completion yet, just skip this
              // flight's per-frame work. The 2D animator will eventually
              // call recordFlightCompletion + flip active=false; we don't
              // want to do either of those things here (would either
              // double-count or skip counting via a race with the 2D loop).
              if (flight._3dCompleted) continue;
              const f2elapsed = ((performance.now() - flight.startTime) / 1000) * padTimeScale;
              const PHASES2 = flight.phases;
              let pTime = 0, p2 = null, phaseIdx2 = -1;
              for (let i = 0; i < PHASES2.length; i++) {
                if (f2elapsed < pTime + PHASES2[i].dur) {
                  p2 = PHASES2[i];
                  p2.localT = (f2elapsed - pTime) / p2.dur;
                  phaseIdx2 = i;
                  break;
                }
                pTime += PHASES2[i].dur;
              }
              if (!p2) {
                // 3D phase animation has run past the last phase. Do the
                // visual cleanup (settle clone on apron, schedule removal)
                // but DO NOT set flight.active = false here. The 2D
                // animator is the single source of truth for "this flight
                // is officially complete" — it sets active=false AND
                // calls recordFlightCompletion. Doing it here too would
                // race the 2D animator (the 2D animator's `if (!flight.active)
                // return` short-circuit fires before its completion path,
                // so killing active here means the recording never happens).
                flight._3dCompleted = true;     // skip this flight in subsequent frames
                // CRITICAL: flip THIS object's active flag (see the
                // matching comment in the primary block). padFlightStates
                // and padDispatchedFlights hold SEPARATE objects; the
                // 2D animator's flight.active=false only affects
                // padDispatchedFlights, leaving padFlightStates entry
                // permanently active=true unless we flip it here.
                // Without this, the map "X/N IN FLIGHT" badge counts
                // completed flights forever and the count looks frozen.
                flight.active = false;
                if (flight.acGroup && flight.isClone) {
                  flight.transitioning = true;
                  flight.acGroup.position.y = 0;
                  // Settle so skids/arms rest on pad surface, not embedded in it
                  settleOnPad(flight.acGroup, 0, 0.02);
                  // Capture local ref so the timeout can find it after array filter
                  const completedFlight2 = flight;
                  setTimeout(() => {
                    // Same swap-order fix — apron rebuild BEFORE clone
                    // removal so there's no empty-frame gap on landing
                    completedFlight2.transitioning = false;
                    padFlightStates = padFlightStates.filter(f => f.active || f.transitioning);
                    window.__padFlightStates = padFlightStates;
                    if (typeof renderFleetAprons === 'function') renderFleetAprons();
                    requestAnimationFrame(() => {
                      if (completedFlight2.acGroup && completedFlight2.acGroup.parent) {
                        completedFlight2.acGroup.parent.remove(completedFlight2.acGroup);
                      }
                    });
                  }, 1500);
                }
                // Clean up scene markers (destination pads + customer figure)
                if (flight.sceneAdds) flight.sceneAdds.forEach(o => padScene.remove(o));
                continue;
              }
              const smoothStep2 = (x) => x * x * (3 - 2 * x);
              const PAD_TOP_Y_2 = 0;
              // Per-flight cruise altitude offset (set at dispatch time).
              // See primary-loop comment — this is what spaces AI flights
              // vertically so they don't clump at one altitude.
              const BASE_CRUISE_ALT_2 = 28;
              const altOffset2 = (typeof flight.cruiseAltOffset === 'number')
                ? flight.cruiseAltOffset
                : 0;
              const CRUISE_ALT_2 = BASE_CRUISE_ALT_2 + altOffset2;
              let alt2 = PAD_TOP_Y_2, hT2 = 0;
              if (p2.kind === 'preflight') {
                alt2 = PAD_TOP_Y_2 + Math.sin(t * 6) * 0.005 * smoothStep2(p2.localT);
              } else if (p2.kind === 'vertical_climb') {
                alt2 = PAD_TOP_Y_2 + (CRUISE_ALT_2 - PAD_TOP_Y_2) * smoothStep2(p2.localT);
              } else if (p2.kind === 'vertical_descent') {
                alt2 = PAD_TOP_Y_2 + (CRUISE_ALT_2 - PAD_TOP_Y_2) * smoothStep2(1 - p2.localT);
              } else if (p2.kind === 'cruise') {
                // Level flight only — vertical phases handle climb/descent
                alt2 = CRUISE_ALT_2;
                hT2 = smoothStep2(p2.localT);
              } else if (p2.kind === 'hover') {
                alt2 = 0.45 + Math.sin(t * 4) * 0.03;
              } else if (p2.kind === 'docked') {
                alt2 = PAD_TOP_Y_2;
              } else {
                hT2 = smoothStep2(p2.localT);
              }
              const fx2 = p2.from.x + (p2.to.x - p2.from.x) * hT2;
              const fz2 = p2.from.z + (p2.to.z - p2.from.z) * hT2;
              if (flight.acGroup) {
                flight.acGroup.position.set(fx2, alt2, fz2);
                if (p2.kind === 'cruise') {
                  const dx = p2.to.x - p2.from.x;
                  const dz = p2.to.z - p2.from.z;
                  if (Math.abs(dx) > 0.01 || Math.abs(dz) > 0.01) {
                    flight.acGroup.rotation.y = Math.atan2(-dz, dx) + Math.PI;
                  }
                  flight.acGroup.rotation.z = Math.sin(t * 0.4) * 0.04;
                  flight.acGroup.rotation.x = -0.05;
                } else {
                  flight.acGroup.rotation.z = 0;
                  flight.acGroup.rotation.x = 0;
                }
              }
              // Rotor spin matches phase kind (same logic as primary loop)
              let spinRate2;
              if (p2.kind === 'preflight')              spinRate2 = 0.05 + (0.40 - 0.05) * p2.localT;
              else if (p2.kind === 'vertical_climb' ||
                       p2.kind === 'vertical_descent')   spinRate2 = 0.50;
              else if (p2.kind === 'cruise')             spinRate2 = 0.55;
              else if (p2.kind === 'hover')              spinRate2 = 0.40;
              else                                        spinRate2 = 0.18;
              if (flight.rotors) flight.rotors.forEach((r, i) => { r.rotation.y += spinRate2 + (i % 2) * 0.02; });

              // ===== Customer figure animation for THIS secondary flight =====
              // Same stage-based logic as primary loop — robust to phase index changes.
              if (flight.customerFigure) {
                const cust = flight.customerFigure;
                let stage2 = 'waitingAtPickup';
                let hoverCount2 = 0;
                for (let k = 0; k <= phaseIdx2; k++) {
                  const pk = flight.phases[k];
                  if (pk && pk.kind === 'hover') hoverCount2++;
                }
                if (p2.kind === 'hover' && hoverCount2 === 1)      stage2 = 'boarding';
                else if (p2.kind === 'hover' && hoverCount2 === 2) stage2 = 'disembarking';
                else if (hoverCount2 === 0)                        stage2 = 'waitingAtPickup';
                else if (hoverCount2 === 1)                        stage2 = 'cruising';
                else                                                stage2 = 'hidden';

                if (stage2 === 'waitingAtPickup') {
                  cust.visible = true;
                  cust.position.set(flight.pickupPos.x + 0.8, Math.sin(t * 2) * 0.02, flight.pickupPos.z + 0.3);
                  cust.lookAt(fx2, 0.3, fz2);
                } else if (stage2 === 'boarding') {
                  cust.visible = true;
                  const lt = p2.localT;
                  if (lt < 0.6) {
                    const walkT = lt / 0.6;
                    const sx = flight.pickupPos.x + 0.8;
                    const sz = flight.pickupPos.z + 0.3;
                    cust.position.x = sx + (fx2 - sx) * walkT;
                    cust.position.z = sz + (fz2 - sz) * walkT;
                    cust.position.y = Math.abs(Math.sin(t * 8)) * 0.04;
                    cust.lookAt(fx2, 0.3, fz2);
                  } else {
                    const liftT = (lt - 0.6) / 0.4;
                    cust.position.x = fx2;
                    cust.position.z = fz2;
                    cust.position.y = liftT * 0.45;
                    const scale = 1 - liftT * 0.85;
                    cust.scale.set(scale, scale, scale);
                  }
                } else if (stage2 === 'cruising') {
                  cust.visible = false;
                  cust.scale.set(1, 1, 1);
                } else if (stage2 === 'disembarking') {
                  cust.visible = true;
                  const lt = p2.localT;
                  if (lt < 0.4) {
                    cust.position.x = fx2;
                    cust.position.z = fz2;
                    cust.position.y = (1 - lt / 0.4) * 0.45;
                    const scale = 0.15 + (lt / 0.4) * 0.85;
                    cust.scale.set(scale, scale, scale);
                  } else {
                    const walkT = (lt - 0.4) / 0.6;
                    const ex = flight.dropoffPos.x - 0.8;
                    const ez = flight.dropoffPos.z - 0.3;
                    cust.position.x = fx2 + (ex - fx2) * walkT;
                    cust.position.z = fz2 + (ez - fz2) * walkT;
                    cust.position.y = Math.abs(Math.sin(t * 8)) * 0.04;
                    cust.scale.set(1, 1, 1);
                    cust.lookAt(ex - 1, 0.3, ez);
                  }
                } else {
                  cust.visible = false;
                }
              }
            }
            // Drop flights that fully completed during this loop iteration.
            // Transitioning flights (post-mission 1.5s settle) are KEPT so
            // visibility logic + apron filter can find them. Without this,
            // the transitioning case stripped out instantly, padGroup popped
            // back to visible at hub while the clone was still at apron =
            // overlap (the screenshot bug from earlier). The completion
            // handler removes them from the array after the 1.5s timeout.
            const beforeCount = padFlightStates.length;
            padFlightStates = padFlightStates.filter(f => f.active || f.transitioning);
            if (padFlightStates.length !== beforeCount && !padFlightState?.active) {
              const nextActive = padFlightStates.find(f => f.active);
              padFlightState = nextActive || null;
            }
          }

          // ===== Parked state (default — aircraft idling on hub pad) =====
          // Only set a parked-state target if NO active flight (otherwise the cruise/hover
          // branch above already updated the target and we'd overwrite it).
          if (!padFlightState || !padFlightState.active) {
            padCamTarget.x = Math.cos(t * 0.06) * 6.5;
            padCamTarget.z = Math.sin(t * 0.06) * 6.5;
            padCamTarget.y = 2.8 + Math.sin(t * 0.08) * 0.3;
            padCamLookTarget.x = 0; padCamLookTarget.y = 0.6; padCamLookTarget.z = 0;
            // Subtle aircraft hover bob — alive but firmly parked
            if (padGroup) {
              padGroup.position.y = 0.18 + Math.sin(t * 1.4) * 0.012;
              padGroup.rotation.y = Math.sin(t * 0.25) * 0.04;
              padGroup.rotation.x = 0;
              padGroup.rotation.z = 0;
            }
            // Rotors spin at idle RPM (pre-flight) — visible but not at full thrust
            padRotors.forEach((r, i) => {
              r.rotation.y += 0.18 + (i % 2) * 0.02;
            });
            // Pulse the pad-light dots
            if (padScene.userData.lightDots) {
              const pulse = 0.7 + Math.abs(Math.sin(t * 1.6)) * 0.5;
              padScene.userData.lightDots.forEach((d, i) => {
                d.material.emissiveIntensity = pulse * (1 + Math.sin(t * 1.2 + i * 0.4) * 0.3);
              });
            }
          }

          // ===== CREW FIGURE STATE MACHINE =====
          // Workers actively move between their home stations and
          // aircraft to perform tasks. This is what makes the hub feel
          // alive: they don't stand in a circle, they walk to aircraft,
          // "work" there, and return when done. Tasks are queued by
          // hooks (dispatcher when dispatch fires, maintenance
          // autonomously patrolling, etc).
          //
          // CRITICAL: this MUST live OUTSIDE the parked-only branch
          // above. Previously the crew animation was nested inside
          // `if (!padFlightState || !padFlightState.active)` which
          // meant the entire state machine stopped running the moment
          // an aircraft was dispatched (the user's takeoff or any AI
          // dispatch flipped padFlightState to the new flight). Result:
          // workers literally froze in place after the first launch.
          // The user reported "I launched 2, they launched 1, and now
          // frozen" — that was this branch being skipped.
          if (padScene.userData.crewFigures) {
            const now = performance.now();
            if (!padScene.userData.__crewLastNow) padScene.userData.__crewLastNow = now;
            const dt = Math.min(0.1, (now - padScene.userData.__crewLastNow) / 1000);
            padScene.userData.__crewLastNow = now;
            padScene.userData.crewFigures.forEach((fig) => {
              const a = fig.userData.anim;
              const parts = fig.userData.parts;
              const task = fig.userData.task;
              if (!a || !parts || !task) return;

                // ===== STATE TRANSITIONS =====
                if (task.state === 'idle' && task.taskQueue.length > 0) {
                  // Pop next task → walk to aircraft
                  const next = task.taskQueue.shift();
                  task._currentTask = next;
                  task.targetX = next.targetX;
                  task.targetZ = next.targetZ;
                  task.state = 'walking_to';
                } else if (task.state === 'working' && now >= task.workUntil) {
                  // Work complete → walk back home
                  task.targetX = task.homeX;
                  task.targetZ = task.homeZ;
                  task.state = 'walking_back';
                }

                // ===== LOCOMOTION (walking_to / walking_back) =====
                if (task.state === 'walking_to' || task.state === 'walking_back') {
                  const dx = task.targetX - fig.position.x;
                  const dz = task.targetZ - fig.position.z;
                  const dist = Math.sqrt(dx * dx + dz * dz);
                  if (dist < 0.08) {
                    // Arrived
                    fig.position.x = task.targetX;
                    fig.position.z = task.targetZ;
                    if (task.state === 'walking_to') {
                      // Begin working
                      const cur = task._currentTask;
                      task.workUntil = now + ((cur && cur.workMs) || 2000);
                      task.state = 'working';
                      // Optional gesture on arrival (point/inspect)
                      if (cur && cur.gesture) {
                        a.gestureUntil = now + 1200;
                      }
                      // Face toward pad center while working
                      a.facing = Math.atan2(0 - fig.position.x, 0 - fig.position.z);
                      // onArrive callback — task creator can supply a
                      // function to fire the moment the worker reaches
                      // the aircraft. This is how the dispatcher triggers
                      // an actual takeoff: the worker walks over, AND
                      // ONLY THEN does the aircraft launch. Wrapped in
                      // try/catch so a callback throwing can never break
                      // the state machine.
                      if (cur && typeof cur.onArrive === 'function') {
                        try { cur.onArrive(); }
                        catch (err) { console.warn('[CREW TASK] onArrive failed:', err); }
                      }
                    } else {
                      // Returned home — go back to idle
                      task.state = 'idle';
                      task._currentTask = null;
                      a.facing = Math.atan2(0 - task.homeX, 0 - task.homeZ);
                    }
                  } else {
                    // Walk toward target. Normalize, multiply by speed*dt
                    const speed = task.walkSpeed;
                    const nx = dx / dist;
                    const nz = dz / dist;
                    fig.position.x += nx * speed * dt;
                    fig.position.z += nz * speed * dt;
                    // Face direction of travel
                    a.facing = Math.atan2(nx, nz);
                    // Footstep phase advances with movement → drives gait
                    task.stepPhase += dt * 6;     // ~6 rad/sec → ~1Hz step cycle
                  }
                }

                // ===== ANIMATION (varies by state) =====
                if (task.state === 'walking_to' || task.state === 'walking_back') {
                  // Walking gait: legs swing fwd/back opposite phase,
                  // arms counter-swing for natural motion
                  const stride = 0.45;
                  parts.legL.rotation.x =  Math.sin(task.stepPhase) * stride;
                  parts.legR.rotation.x = -Math.sin(task.stepPhase) * stride;
                  parts.armL.rotation.x = -Math.sin(task.stepPhase) * 0.35;
                  parts.armR.rotation.x =  Math.sin(task.stepPhase) * 0.35;
                  parts.torso.rotation.x = 0;
                  // Tiny vertical bob from gait (1cm at footfall)
                  fig.position.y = a.baseY + Math.abs(Math.sin(task.stepPhase)) * 0.01;
                  fig.rotation.y = a.facing;
                } else if (task.state === 'working') {
                  // Working: legs still, arms move as if handling tools.
                  parts.legL.rotation.x = 0;
                  parts.legR.rotation.x = 0;
                  parts.armL.rotation.x = -0.3 + Math.sin(t * 4) * 0.15;
                  parts.armR.rotation.x = -0.3 - Math.sin(t * 4) * 0.15;
                  parts.torso.rotation.x = 0.08;     // slight forward lean
                  fig.position.y = a.baseY;
                  fig.rotation.y = a.facing;
                } else {
                  // Idle at home station — gentle bob + sway + arm swing
                  const bob = Math.sin(t * 1.4 + a.phase) * 0.02;
                  fig.position.y = a.baseY + bob;
                  const sway = Math.sin(t * 0.9 + a.phase) * 0.05;
                  fig.rotation.y = a.facing + sway;
                  parts.armL.rotation.x =  Math.sin(t * 1.2 + a.phase) * 0.1;
                  parts.armR.rotation.x = -Math.sin(t * 1.2 + a.phase) * 0.1;
                  parts.legL.rotation.x = 0;
                  parts.legR.rotation.x = 0;
                  parts.torso.rotation.x = 0;
                }

                // Gesture overlay — right arm raise (works in any state).
                // Triggered by window.__triggerCrewGesture or on arrival
                // at a work site.
                if (now < a.gestureUntil) {
                  const remaining = (a.gestureUntil - now) / 1500;
                  const elapsed = 1 - remaining;
                  // Quick rise, slow fall — feels like a deliberate gesture.
                  // ease(0) = 0 (just starting), peaks at ease(0.5) = 1 (mid-gesture
                  // arm fully raised), ease(1) = 0 (back to rest).
                  const ease = elapsed < 0.5
                    ? 1 - Math.pow(1 - elapsed * 2, 2)
                    : 1 - (elapsed - 0.5) * 2;
                  parts.armR.rotation.x = -1.4 * ease;     // raise forward
                  parts.armR.rotation.z = -0.15 * ease;     // out from body
                }
              });
            }

          // ===== Parked aircraft visibility =====
          // padGroup holds the SELECTED aircraft's geometry (sitting at hub
          // for inspection / charging). It should be hidden whenever the
          // selected aircraft has a clone in the scene — either actively
          // flying OR sitting on its apron pad during the 1.5s post-mission
          // settle (transitioning). Other aircraft flying are independent —
          // their clones land at their own apron pads, not at hub, so they
          // never overlap padGroup.
          //
          // Without including the transitioning case here: when the selected
          // aircraft just landed, padGroup at hub + clone at apron would
          // briefly show two copies of the SAME aircraft.
          // Aircraft live on their apron pads. padGroup is no longer used as
          // a "selected aircraft display" — it's only kept as a fallback for
          // the clone-failure path during launch (extremely rare, only if
          // ObjectLoader.parse fails). So padGroup stays hidden in normal
          // operation.
          //
          // The hub LABEL still tracks the selected aircraft — but it now
          // floats above the SELECTED aircraft's apron pad (positioned in
          // updateHubLabel using apronPosition). It hides only when the
          // selected aircraft has a clone in flight.
          {
            const selectedDesignId = padSelectedAircraft?.id;
            const selectedHasClone = selectedDesignId && padFlightStates.some(f =>
              (f.active || f.transitioning) && f.designId === selectedDesignId
            );
            // padGroup-as-flying-aircraft: rare clone-failure fallback. In
            // that case, show padGroup at its current animated position.
            // Otherwise, padGroup is unused and hidden.
            const padGroupIsFlying = (padFlightStates || []).some(f =>
              (f.active || f.transitioning) && f.acGroup === padGroup
            );
            if (padGroup) padGroup.visible = padGroupIsFlying;
            if (padHubLabel) padHubLabel.visible = !selectedHasClone && !!padSelectedAircraft;
            if (window.__SDX_VIS_DEBUG) {
              console.log('[vis]', {
                selectedId: selectedDesignId,
                flights: (padFlightStates || []).map(f => ({
                  designId: f.designId, active: f.active, transitioning: !!f.transitioning
                })),
                selectedHasClone,
                padGroupIsFlying,
                padGroupVisible: padGroup?.visible,
                padHubLabelVisible: padHubLabel?.visible
              });
            }
          }

          // ===== Propeller audio — throttle reflects flight phase, volume scales with cam distance =====
          // Real BLDC motors respond to constant ESC corrections. Gust events
          // simulate the controller compensating for wind/load changes — most
          // audible during hover (fighting gravity) and idle (sitting on pad with
          // tiny wind corrections). Less audible during smooth cruise.
          {
            // ----- Pick the flight whose audio we should play -----
            // ===== AUDIBLE AIRCRAFT — ALL of them, not just one =====
            // User: "the propeller sounds are inconsistent. they need
            // to be simulated all the time with all aircraft not just
            // the one arriving or departing for pickup."
            //
            // The previous logic picked a SINGLE audible aircraft by
            // priority (active flight first, then transitioning, then
            // padGroup at hub) — which made parked aircraft on the
            // apron silent and dropped audio entirely the moment a
            // mission ended. In reality, an apron full of electric
            // aircraft has a constant low-level hum from idle ESCs.
            //
            // New model: enumerate every visible aircraft (parked
            // apron clones + active flight + transitioning clones).
            // Closest-to-camera dominates the distance attenuation.
            // Throttle is the MAX across all aircraft (so a single
            // departing flight still pushes the audio up to cruise/
            // hover level), but the FLOOR is non-zero whenever any
            // parked aircraft is within audible range.
            const audibleSources = [];
            // Active primary flight
            if (padFlightState && padFlightState.active && padFlightState.acGroup) {
              audibleSources.push({
                pos: padFlightState.acGroup.position,
                throttle: (audioPhaseKind === 'cruise')
                  ? 0.55 + Math.max(0, 1 - Math.abs(audioPhaseLocalT - 0.5) * 2) * 0.20
                  : (audioPhaseKind === 'hover') ? 0.85
                  : (audioPhaseKind === 'docked') ? 0.06
                  : 0.12,
                gusts: (audioPhaseKind === 'hover'),
              });
            }
            // Any transitioning flights (parked clone spinning down at apron)
            for (const f of (padFlightStates || [])) {
              if (f && f.transitioning && !f.active && f.acGroup) {
                audibleSources.push({
                  pos: f.acGroup.position,
                  throttle: 0.06,     // docked-spool-down level
                  gusts: false,
                });
              }
            }
            // Every PARKED aircraft on the apron — the addition the
            // user asked for. Each contributes a quiet idle hum. They
            // were silent before; the soundscape went dead between
            // missions despite a fleet of 14 sitting on aprons.
            if (typeof padApronGroups !== 'undefined' && padApronGroups) {
              for (const id of Object.keys(padApronGroups)) {
                const grp = padApronGroups[id];
                if (!grp || !grp.position) continue;
                // Charging aircraft sit at the charger station with a
                // very faint hum (cooling fans + balance circuitry).
                // Idle aircraft on aprons hum at their normal idle
                // level — same as docked.
                const charging = !!(grp.userData && grp.userData.atCharger);
                audibleSources.push({
                  pos: grp.position,
                  throttle: charging ? 0.03 : 0.06,
                  gusts: false,
                });
              }
            }

            // Pick the closest source as the distance reference, and
            // take the MAX throttle across all sources so a nearby
            // flight still dominates over distant idles.
            let acX = 0, acY = 0, acZ = 0;
            let dist = 1000;     // far-away default (effectively silent)
            let throttle = 0;
            let gustsActive = false;
            if (audibleSources.length > 0) {
              for (const s of audibleSources) {
                const sdx = padCamera.position.x - s.pos.x;
                const sdy = padCamera.position.y - s.pos.y;
                const sdz = padCamera.position.z - s.pos.z;
                const sd = Math.sqrt(sdx*sdx + sdy*sdy + sdz*sdz);
                if (sd < dist) {
                  dist = sd;
                  acX = s.pos.x; acY = s.pos.y; acZ = s.pos.z;
                }
                if (s.throttle > throttle) {
                  throttle = s.throttle;
                  gustsActive = !!s.gusts;
                }
              }
            } else if (padGroup) {
              // No aircraft at all (empty hangar): minimal idle from
              // the model parked at hub origin
              acX = padGroup.position.x;
              acY = padGroup.position.y;
              acZ = padGroup.position.z;
              const dx0 = padCamera.position.x - acX;
              const dy0 = padCamera.position.y - acY;
              const dz0 = padCamera.position.z - acZ;
              dist = Math.sqrt(dx0*dx0 + dy0*dy0 + dz0*dz0);
              throttle = 0.05;
              gustsActive = false;
            }
            propellerSynth.setState(throttle, dist, gustsActive);
          }

          // ===== Battery drain — physics-driven by flight phase =====
          // Iterates EVERY flight (primary + secondaries), so each aircraft has
          // its own independent battery state that drains during its own active
          // phase. The PRIMARY flight's battery drives the visible UI display
          // (sidebar telem-row + footer pill); secondary flights' batteries are
          // tracked silently and surface when promoted to primary.
          //
          // Charging logic: when the aircraft is docked or no longer in flight,
          // recharge at -1.5%/sec until battery == MAX_SOC. We SNAP the value
          // to MAX_SOC when within 0.1% to avoid a floating-point dead zone
          // (battery getting stuck at 94.95% forever, so the launch button
          // shows "CHARGING 95% / 95%" but never enables).
          // (MAX_SOC and SOC_EPSILON are now declared at script-tag scope so
          //  the fleet roster status can use the same threshold.)
          for (const flight of (padFlightStates || [])) {
            if (flight.battery === undefined) continue;
            // Determine THIS flight's current phase from its own elapsed time
            const elapsed_b = ((performance.now() - flight.startTime) / 1000) * padTimeScale;
            let phaseTime_b = 0;
            let phaseKind_b = null, phaseLocalT_b = 0;
            const isActive_b = flight.active;
            if (isActive_b) {
              for (const p of flight.phases) {
                if (elapsed_b < phaseTime_b + p.dur) {
                  phaseKind_b = p.kind;
                  phaseLocalT_b = (elapsed_b - phaseTime_b) / p.dur;
                  break;
                }
                phaseTime_b += p.dur;
              }
            }
            // Update timing
            const dtMs = performance.now() - (flight.batteryLastUpdate || performance.now());
            flight.batteryLastUpdate = performance.now();
            const dt = Math.min(dtMs / 1000, 0.1);
            // Drain rate per phase. Recharge is a STEADY 1.5%/sec.
            // Tuned for ULTRA-long-range dispatch (up to 500mi one-way / 1000mi
            // round trip). Drain rate is significantly lower than earlier metro
            // tuning because long missions spend much longer in cruise. With
            // padTimeScale=60 and these rates, approximate drain budget by
            // mission length:
            //   ~14 mi round trip (metro):  ~3-4% drain
            //   ~200 mi round trip:         ~17-22% drain
            //   ~600 mi round trip:         ~45-55% drain
            //   ~1000 mi round trip (max):  ~65-72% drain (plenty of reserve)
            //
            // Hover: 1.2%/sec — fighting gravity, dominant during boarding/
            //   disembark even at long range (still short in time).
            // Cruise: 0.10 → 0.50%/sec edge-curve — high during accel/decel,
            //   low at mid-cruise where wing/lift+cruise efficiency wins.
            // Idle/unknown: 0.10%/sec.
            let drainPerSec = 0;
            const needsCharge = flight.battery < MAX_SOC - SOC_EPSILON;
            if (!isActive_b) {
              if (needsCharge) drainPerSec = -1.5;
            } else if (phaseKind_b === 'docked') {
              if (needsCharge) drainPerSec = -1.5;
            } else if (phaseKind_b === 'hover') {
              drainPerSec = 1.2;
            } else if (phaseKind_b === 'cruise') {
              const edge = Math.max(0, 1 - Math.abs(phaseLocalT_b - 0.5) * 2);
              drainPerSec = 0.10 + edge * 0.4;
            } else {
              drainPerSec = 0.10;
            }
            // Apply drain; snap to MAX_SOC when within epsilon to avoid
            // floating-point asymptote where battery sits at 94.999% forever.
            let next = flight.battery - drainPerSec * dt;
            if (drainPerSec < 0 && next >= MAX_SOC - SOC_EPSILON) next = MAX_SOC;
            flight.battery = Math.max(0, Math.min(100, next));
            flight.isCharging = drainPerSec < 0;
            // Persist this design's battery state across flight completions
            if (flight.designId) {
              padDesignBatteries.set(flight.designId, {
                battery: flight.battery,
                isCharging: flight.isCharging,
                lastUpdate: performance.now()
              });
            }
          }
          // ===== Recharge IDLE designs (saved aircraft that aren't currently flying) =====
          // Each design has a persistent battery state. Designs that aren't in any
          // ACTIVE flight still recharge at the same steady 1.5%/sec rate so the
          // user sees their fleet "topping up" between dispatches.
          //
          // IMPORTANT: only check flight.active (not just presence) — a completed
          // flight whose acGroup still lingers in padFlightStates would otherwise
          // block its design from recharging through the idle path AND through
          // the completed-flight branch above (since after completion flight.active
          // becomes false but it's still in the array).
          {
            const trulyActiveIds = new Set(
              (padFlightStates || []).filter(f => f.active).map(f => f.designId)
            );
            const allDesigns = (typeof getAllSavedDesigns === 'function') ? getAllSavedDesigns() : [];
            for (const d of allDesigns) {
              if (trulyActiveIds.has(d.id)) continue;     // active flight handles its own
              // Initialize idle designs to MAX_SOC on first sight — fresh aircraft never flown
              const entry = padDesignBatteries.get(d.id) || { battery: MAX_SOC, isCharging: false, lastUpdate: performance.now() };
              const dtMs = performance.now() - (entry.lastUpdate || performance.now());
              entry.lastUpdate = performance.now();
              const dt = Math.min(dtMs / 1000, 0.1);
              if (entry.battery < MAX_SOC - SOC_EPSILON) {
                let next = entry.battery + 1.5 * dt;
                if (next >= MAX_SOC - SOC_EPSILON) next = MAX_SOC;     // snap to ceiling
                entry.battery = next;
                entry.isCharging = entry.battery < MAX_SOC;
              } else {
                // Within epsilon of full — snap to exactly MAX_SOC, stop charging
                entry.battery = MAX_SOC;
                entry.isCharging = false;
              }
              padDesignBatteries.set(d.id, entry);
            }
            // Persist to localStorage (throttled; actual write happens ~every 2s)
            persistFleetBatteries();
            // Re-render the apron so aircraft that finished charging
            // visibly leave the charger station (and aircraft just
            // returned from a flight visibly arrive at the charger).
            // Throttled to ~once per 2s — same cadence as the
            // persist write — so we're not destroy-rebuilding meshes
            // every frame. User: "I needs to represent the data."
            if (typeof window !== 'undefined') {
              const nowMs = (typeof performance !== 'undefined' && performance.now)
                ? performance.now() : Date.now();
              if (!window.__apronChargeRefreshLast) window.__apronChargeRefreshLast = 0;
              if (nowMs - window.__apronChargeRefreshLast > 2000) {
                window.__apronChargeRefreshLast = nowMs;
                if (typeof renderFleetAprons === 'function') {
                  try { renderFleetAprons(); } catch (_) {}
                }
              }
            }
          }
          // Update visible UI from PRIMARY flight only (sidebar telem-row + footer pill)
          if (padFlightState && padFlightState.battery !== undefined) {
            const f = padFlightState;
            const isCharging = !!f.isCharging;
            const battEl = document.getElementById('pad-info-battery');
            if (battEl) {
              const bat = f.battery;
              battEl.textContent = `${bat.toFixed(0)}%`;
              if (isCharging)         battEl.style.color = '#00E5FF';
              else if (bat < 20)      battEl.style.color = '#ff5060';
              else if (bat < 50)      battEl.style.color = '#ffb030';
              else                    battEl.style.color = '#30ff60';
            }
            const battPill = document.getElementById('pad-foot-battery');
            if (battPill) {
              battPill.textContent = isCharging
                ? `⚡ CHARGING ${f.battery.toFixed(0)}%`
                : `⚡ CHARGED ${f.battery.toFixed(0)}%`;
            }
          } else if (padSelectedAircraft) {
            // No active flight — show the SELECTED aircraft's battery from the persistent map
            const entry = padDesignBatteries.get(padSelectedAircraft.id);
            if (entry) {
              const battEl = document.getElementById('pad-info-battery');
              if (battEl) {
                battEl.textContent = `${entry.battery.toFixed(0)}%`;
                if (entry.isCharging)        battEl.style.color = '#00E5FF';
                else if (entry.battery < 20) battEl.style.color = '#ff5060';
                else if (entry.battery < 50) battEl.style.color = '#ffb030';
                else                         battEl.style.color = '#30ff60';
              }
              const battPill = document.getElementById('pad-foot-battery');
              if (battPill) {
                battPill.textContent = entry.isCharging
                  ? `⚡ CHARGING ${entry.battery.toFixed(0)}%`
                  : `⚡ CHARGED ${entry.battery.toFixed(0)}%`;
              }
            }
          }
          // ===== Update per-aircraft battery percentage in the FLEET ROSTER =====
          // Every roster row gets a small battery readout next to its status label.
          // Queries by data-design-id which renderFleetRoster sets on each row.
          // Also keeps the status text ("READY" vs "CHARGING") in sync with the
          // battery — without per-frame status update, an aircraft that finishes
          // charging would show "⚡ 95%" but still say "CHARGING" until the next
          // full roster re-render.
          const inFlightIdsForRoster = new Set(
            padFlightStates.filter(f => f && f.active && f.designId).map(f => f.designId)
          );
          // ===== Update LIVE IN-FLIGHT COUNT BADGE on map header =====
          // Badge displays VISIBLE flights (active or transitioning
          // clones in the launchpad scene). Same definition the
          // splash subline uses. User: "1/14 IN FLIGHT" on hub vs
          // "4 in flight" on splash — same words, same meaning.
          //
          // fs.visibleInFlight = active OR transitioning launchpad
          // designs. Color shifts: green (none airborne), cyan
          // (1-49% airborne), amber (50%+ of fleet airborne).
          {
            const flightCountEl = document.getElementById('pad-map-flight-count');
            if (flightCountEl) {
              const fs = (typeof window !== 'undefined' && typeof window.__computeFleetState === 'function')
                ? window.__computeFleetState()
                : { total: 0, visibleInFlight: 0 };
              const total = fs.total;
              const inFlight = fs.visibleInFlight || 0;
              flightCountEl.textContent = `${inFlight}/${total} IN FLIGHT`;
              flightCountEl.classList.remove('partial', 'heavy');
              if (inFlight === 0) { /* default green */ }
              else if (total > 0 && inFlight / total >= 0.5) flightCountEl.classList.add('heavy');
              else flightCountEl.classList.add('partial');
            }
          }
          for (const [designId, entry] of padDesignBatteries) {
            const battSpan = document.querySelector(`.pad-roster-battery[data-design-id="${designId}"]`);
            if (battSpan) {
              const bat = entry.battery;
              battSpan.textContent = `⚡ ${bat.toFixed(0)}%`;
              if (entry.isCharging) battSpan.style.color = '#00E5FF';
              else if (bat < 20)    battSpan.style.color = '#ff5060';
              else if (bat < 50)    battSpan.style.color = '#ffb030';
              else                  battSpan.style.color = '#30ff60';
              // Update status text + charging class to match current charge level
              const rosterRow = battSpan.closest('.pad-roster-item');
              if (rosterRow) {
                const isInFlight = inFlightIdsForRoster.has(designId);
                const undercharged = bat < MAX_SOC - SOC_EPSILON;
                const metaSpan = rosterRow.querySelector('.pad-roster-meta');
                if (metaSpan) {
                  const num = metaSpan.textContent.match(/^#\d+/)?.[0] || '#?';
                  const statusText = isInFlight ? 'IN FLIGHT'
                                  : undercharged ? 'CHARGING'
                                  : 'READY';
                  const newText = `${num} · ${statusText}`;
                  if (metaSpan.textContent !== newText) metaSpan.textContent = newText;
                }
                rosterRow.classList.toggle('charging', undercharged && !isInFlight);
              }
            }
          }

          // ===== Update LAUNCH NOW button enabled state =====
          // The button is disabled (and visually dimmed) when:
          //   - No aircraft is selected (nothing to dispatch)
          //   - Selected aircraft is below 95% charge (charging incomplete)
          //   - Selected aircraft is currently in flight (can't dispatch twice)
          // The label changes to communicate the reason so the user sees WHY
          // they can't launch, not just that the button is greyed.
          //
          // We use a SOC_EPSILON tolerance (0.05%) when comparing — without it,
          // a battery sitting at 94.99% (which displays as "95%" after toFixed(0))
          // would block the button even though the user sees a fully-charged
          // aircraft. This matched the charging snap behavior above.
          const launchBtn = document.getElementById('pad-launch');
          if (launchBtn && padSelectedAircraft) {
            const sel = padSelectedAircraft;
            const entry = padDesignBatteries.get(sel.id);
            const charge = entry?.battery ?? MAX_SOC;
            // Compute in-flight status inline — every tick — by scanning the
            // active flights array. (We can't rely on the inFlightDesignIds
            // Set defined inside renderFleetRoster, since that's function-scoped.)
            const isInFlight = padFlightStates.some(f => f && f.active && f.designId === sel.id);
            // Allow launch when within epsilon of MAX_SOC — otherwise floating-point
            // drift could leave the button perpetually disabled at 94.99%
            const undercharged = charge < MAX_SOC - SOC_EPSILON;
            const blocked = isInFlight || undercharged;
            launchBtn.disabled = blocked;
            launchBtn.classList.toggle('pad-launch-blocked', blocked);
            if (isInFlight) {
              launchBtn.textContent = '✈ IN FLIGHT';
              launchBtn.title = `${sel.tail} is currently airborne`;
            } else if (undercharged) {
              launchBtn.textContent = `⚡ CHARGING · ${charge.toFixed(0)}% / 95%`;
              launchBtn.title = `Aircraft must reach 95% charge before next dispatch (currently ${charge.toFixed(1)}%)`;
            } else {
              launchBtn.textContent = '⬆ LAUNCH NOW';
              launchBtn.title = '';
            }
          } else if (launchBtn) {
            launchBtn.disabled = true;
            launchBtn.classList.add('pad-launch-blocked');
            launchBtn.textContent = '⬆ LAUNCH NOW';
          }

          // ===== Ground cam — first-person walk on city streets =====
          // WASD-driven 3D walking with mouse-look. Position is gravity-locked
          // at eye height (1.7m). Yaw/pitch from mouse, position from keys.
          if (padGroundCam) {
            const dt = 1/60;     // approximate frame delta
            const g = padGroundState;
            // Compute forward/right vectors from yaw (ignore pitch for movement —
            // we want flat ground walking, no flying when looking up)
            const fwdX = -Math.sin(g.yaw);
            const fwdZ = -Math.cos(g.yaw);
            const rightX = Math.cos(g.yaw);
            const rightZ = -Math.sin(g.yaw);
            const speed = g.speed * (g.keys.shift ? 2 : 1);
            let dx = 0, dz = 0;
            if (g.keys.w) { dx += fwdX;   dz += fwdZ;   }
            if (g.keys.s) { dx -= fwdX;   dz -= fwdZ;   }
            if (g.keys.d) { dx += rightX; dz += rightZ; }
            if (g.keys.a) { dx -= rightX; dz -= rightZ; }
            const len = Math.hypot(dx, dz);
            if (len > 0) { dx /= len; dz /= len; g.pos.x += dx * speed * dt; g.pos.z += dz * speed * dt; }
            // Bounds: clamp to a generous city-scale envelope. Customer mode
            // can spawn the user at a city up to ~491u from origin (Portland),
            // so a global ±500 envelope keeps walking sensible without
            // letting the user wander off into uncharted terrain.
            g.pos.x = Math.max(-500, Math.min(500, g.pos.x));
            g.pos.z = Math.max(-500, Math.min(500, g.pos.z));
            g.pos.y = 1.7;     // eye height — gravity locked
            // CUSTOMER MODE: tell the dispatch system where the user
            // physically is so the inbound taxi can track them. Updates
            // are ignored once the taxi has committed to final approach
            // (set by the camera-override block).
            if (window.__customerModeActive && !window.__customerPickupLocked) {
              window.__customerGroundPos = { x: g.pos.x, z: g.pos.z };
            }
            // Apply position + look direction
            padCamera.position.copy(g.pos);
            // Look direction from yaw + pitch
            const lookX = g.pos.x + fwdX * Math.cos(g.pitch) * 10;
            const lookY = g.pos.y + Math.sin(g.pitch) * 10;
            const lookZ = g.pos.z + fwdZ * Math.cos(g.pitch) * 10;
            padCamera.lookAt(lookX, lookY, lookZ);
            padRenderer.render(padScene, padCamera);
            return;     // skip the unified auto/manual camera block — ground cam owns frame
          }

          // ===== Cabin cam — first-person seat view inside the taxi =====
          // Anchored to the customer's aircraft (cabinAircraft acGroup).
          // Position = aircraft.position + small upward + slight rear offset.
          // Drag-to-look-around: mouse drag rotates a yaw/pitch pan applied
          // on top of the aircraft's heading. When the aircraft climbs or
          // descends, the camera goes with it because we anchor to its
          // live world position each frame.
          if (window.__padCabinCam && window.__customerModeState &&
              window.__customerModeState.inCabin &&
              window.__customerModeState.cabinAircraft) {
            const ac = window.__customerModeState.cabinAircraft;
            const acPos = ac.position;
            // Compute aircraft forward direction from its rotation.y (yaw).
            // Aircraft model's nose points along -X locally, so forward in
            // world = rotated(-X) by acRotY. Equivalent vector:
            //   fwd = ( -cos(rotY), -sin(rotY) ) for (X, Z).
            // Edge case: rotation may be 0 during preflight/vertical phases —
            // fall back to direction of travel from active phase.
            let acRotY = ac.rotation?.y ?? 0;
            // Add user's pan yaw on top
            const pan = window.__padCabinPan || { yaw: 0, pitch: 0 };
            const totalYaw = acRotY + pan.yaw;
            const totalPitch = pan.pitch;
            // Seat position scales with the actual aircraft body. Default
            // is "back of cabin, eye height" — but the cabin was sized to
            // fit the fuselage, so we read its dimensions from the live
            // cabinInteriorGroup if present and scale the seat offsets to
            // match. Without this, on a small fuselage the camera would
            // sit OUTSIDE the cabin (because hard-coded 0.4u back was
            // bigger than the cabin itself).
            let seatBackOffset = 0.4;
            let seatUpOffset   = 0.6;
            if (cabinInteriorGroup) {
              try {
                const cBox = new THREE.Box3().setFromObject(cabinInteriorGroup);
                const cSize = new THREE.Vector3();
                cBox.getSize(cSize);
                // cSize is in WORLD frame (post-acGroup-scale), which is
                // exactly the frame we need for adding to acPos. Place
                // seat at ~30% back from center along the long axis,
                // and ~40% up from floor (cabin floor is at acPos.y).
                const longAxisSize = Math.max(cSize.x, cSize.z);
                if (longAxisSize > 0.1) seatBackOffset = longAxisSize * 0.30;
                if (cSize.y > 0.1)      seatUpOffset   = cSize.y * 0.40;
              } catch (_) { /* fall back to defaults */ }
            }
            const fwdX = -Math.cos(acRotY);
            const fwdZ = -Math.sin(acRotY);
            const seatX = acPos.x + fwdX * -seatBackOffset;     // negate fwd to step back
            const seatY = acPos.y + seatUpOffset;
            const seatZ = acPos.z + fwdZ * -seatBackOffset;
            padCamera.position.set(seatX, seatY, seatZ);
            // Look direction = aircraft forward + user's pan (yaw/pitch)
            const lookFwdX = -Math.cos(totalYaw) * Math.cos(totalPitch);
            const lookFwdZ = -Math.sin(totalYaw) * Math.cos(totalPitch);
            const lookFwdY = Math.sin(totalPitch);
            padCamera.lookAt(
              seatX + lookFwdX * 12,
              seatY + lookFwdY * 12,
              seatZ + lookFwdZ * 12
            );
            // Disable OrbitControls — cabin owns the frame
            if (padControls) padControls.enabled = false;
            padRenderer.render(padScene, padCamera);
            return;     // cabin cam owns the frame
          }

          // ===== Unified camera lerp + render =====
          // If the user has dragged/zoomed recently, OrbitControls is in charge — skip
          // auto-cam lerp. Auto-cam resumes 4 seconds after the last interaction
          // UNLESS the user explicitly picked a preset (TOP/SIDE/BACK/GROUND) — those
          // are sticky and stay until the user picks another preset or AUTO.
          const MANUAL_TIMEOUT_MS = 4000;
          if (padManualCam && !padStickyCam &&
              (performance.now() - padManualCamTime) > MANUAL_TIMEOUT_MS) {
            padManualCam = false;  // resume auto-cam after timeout (drag interactions only)
          }
          if (!padManualCam) {
            // Auto-cam: lerp toward target. Disable OrbitControls so it doesn't fight the lerp.
            if (padControls) padControls.enabled = false;
            const LERP = 0.08;
            padCamera.position.x += (padCamTarget.x - padCamera.position.x) * LERP;
            padCamera.position.y += (padCamTarget.y - padCamera.position.y) * LERP;
            padCamera.position.z += (padCamTarget.z - padCamera.position.z) * LERP;
            if (!padCamera.userData._look) padCamera.userData._look = { x: 0, y: 0.6, z: 0 };
            const look = padCamera.userData._look;
            look.x += (padCamLookTarget.x - look.x) * LERP;
            look.y += (padCamLookTarget.y - look.y) * LERP;
            look.z += (padCamLookTarget.z - look.z) * LERP;
            padCamera.lookAt(look.x, look.y, look.z);
            // Sync OrbitControls' internal target so it doesn't snap when re-enabled
            if (padControls) { padControls.target.set(look.x, look.y, look.z); }
          } else {
            // Manual mode: let OrbitControls drive the camera
            if (padControls) {
              padControls.enabled = true;
              padControls.update();
            }
          }
          padRenderer.render(padScene, padCamera);
        }
        tickPad();
      }

      function loadAircraftIntoPad() {
        if (!padGroup) return;
        while (padGroup.children.length) padGroup.remove(padGroup.children[0]);
        padRotors.length = 0;
        const cloned = taxi.clone(true);
        cloned.traverse(o => {
          if (o.userData?.partName) {
            const info = partsRegistry.get(o.userData.partName);
            if (info?.kind === 'rotor') {
              // The rotor's *blades* are usually a child Group (containing two Box blades).
              // Find that child specifically — it's the one we want to spin so the housing
              // stays still and only the blades rotate. Fall back to spinning the whole
              // rotor group if we can't find a matching blade subgroup.
              let bladeChild = null;
              o.traverse(child => {
                if (child === o) return;
                if (child.isGroup && child.children.length >= 2 &&
                    child.children.every(c => c.isMesh && c.geometry?.type === 'BoxGeometry')) {
                  bladeChild = child;
                }
              });
              padRotors.push(bladeChild || o);
            }
          }
          if (o.isMesh) o.castShadow = true;
        });
        padGroup.add(cloned);
        // Force initial render so something appears even before the animation tick fires
        if (padRenderer && padCamera && padScene) {
          padRenderer.render(padScene, padCamera);
        }
      }

      // Render the 2D dispatch network map (sites, hub, routes, current vehicle position)
      // Coordinates are picked deterministically per pad name so the map looks consistent
      // across opens — but the active pad/route/vehicle highlight changes each time.
      let padMapAnimRAF = null;

      // ============================================================================
      // 2D DISPATCH MAP — shared dimensions
      //
      // These constants are read by BOTH renderDispatchMap (static dots/lines/labels)
      // AND animateDispatchedFlight (animated drone marker). They MUST match the
      // SVG element's viewBox (`<svg viewBox="0 0 600 460">`).
      //
      // History: Previously the two functions hardcoded different VIEW_H values
      // (320 vs 460), causing the static hub orange dot to render at y=160 while
      // the animated drone started at y=230 — a 70px vertical offset. The drone
      // appeared to "start somewhere other than the hub" at every dispatch. This
      // hoisting prevents the two functions from drifting apart again.
      // ============================================================================
      const MAP_VIEW_W = 600;
      const MAP_VIEW_H = 460;
      const MAP_VIEW_PAD = 24;
      const MAP_CENTER = { x: MAP_VIEW_W / 2, y: MAP_VIEW_H / 2 };
      function renderDispatchMap(currentPadName, destPadName, tailNumber) {
        const svg = document.getElementById('pad-map');
        if (!svg) return;
        // Cancel any prior animation
        if (padMapAnimRAF) { cancelAnimationFrame(padMapAnimRAF); padMapAnimRAF = null; }

        // Dimensions sourced from the hoisted MAP_* constants — MUST stay in
        // sync with animateDispatchedFlight (and the SVG's viewBox) or the
        // static dots and animated marker will drift apart.
        const VIEW_W = MAP_VIEW_W, VIEW_H = MAP_VIEW_H;
        const CENTER = MAP_CENTER;

        // Site coordinates derived from 3D PAD_GEOGRAPHY so 2D and 3D stay in sync.
        // Find the actual bounding box of the geography to scale-fit the content.
        // PAD_GEOGRAPHY ranges roughly: x in [-10, 26], z in [-22, 45], so the
        // longest extent is ~67 units. We project so that range fills ~85% of
        // the viewBox (with VIEW_PAD margin on each side).
        const VIEW_PAD = MAP_VIEW_PAD;
        let maxAbsX = 0, maxAbsZ = 0;
        for (const pos of Object.values(PAD_GEOGRAPHY)) {
          if (Math.abs(pos.x) > maxAbsX) maxAbsX = Math.abs(pos.x);
          if (Math.abs(pos.z) > maxAbsZ) maxAbsZ = Math.abs(pos.z);
        }
        // Compute scale that makes the WIDER axis fill the available space.
        const availW = (VIEW_W - VIEW_PAD * 2) / 2;     // half-width
        const availH = (VIEW_H - VIEW_PAD * 2) / 2;     // half-height
        const MAP_SCALE = Math.min(availW / Math.max(maxAbsX, 1), availH / Math.max(maxAbsZ, 1));
        // Hub kind is pickup/dropoff metadata for the legend
        const SITES = {};
        const pickupSet = new Set(REGIONS[currentRegionKey]?.pickupNames || []);
        for (const [name, pos] of Object.entries(PAD_GEOGRAPHY)) {
          // 2D map: x grows east (same as 3D), y grows south (3D z grows south, same)
          SITES[name] = {
            x: CENTER.x + pos.x * MAP_SCALE,
            y: CENTER.y + pos.z * MAP_SCALE,
            kind: name === MAIN_HUB_NAME ? 'hub' :
                  pickupSet.has(name) ? 'pickup' :
                  'dropoff'
          };
        }

        // Range rings around hub — sized in pixel units so they read as concentric
        // distance circles regardless of the geographic scale. The ring spacing
        // adapts to the region's max distance (small region = 10/20/30/40mi
        // rings; intercity region with 100+ mi sites gets 25/50/75/100/125 mi).
        const ringsG = document.getElementById('map-rings');
        ringsG.innerHTML = '';
        const maxDist = Math.max(maxAbsX, maxAbsZ);
        let ringMileages;
        if (maxDist > 80) ringMileages = [25, 50, 75, 100, 125];
        else if (maxDist > 40) ringMileages = [15, 30, 50, 75];
        else                    ringMileages = [10, 20, 30, 40];
        for (const miles of ringMileages) {
          const c = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
          c.setAttribute('cx', CENTER.x);
          c.setAttribute('cy', CENTER.y);
          c.setAttribute('r', miles * MAP_SCALE);
          c.setAttribute('fill', 'none');
          c.setAttribute('stroke', 'rgba(0, 229, 255, 0.10)');
          c.setAttribute('stroke-width', '0.6');
          ringsG.appendChild(c);
        }
        // Hub glow
        const hubGlow = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
        hubGlow.setAttribute('cx', CENTER.x);
        hubGlow.setAttribute('cy', CENTER.y);
        hubGlow.setAttribute('r', '40');
        hubGlow.setAttribute('fill', 'url(#hubGlow)');
        ringsG.appendChild(hubGlow);

        // Routes: hub-to-each-site dashed lines
        const routesG = document.getElementById('map-routes');
        routesG.innerHTML = '';
        for (const [name, site] of Object.entries(SITES)) {
          if (name === MAIN_HUB_NAME) continue;
          const line = document.createElementNS('http://www.w3.org/2000/svg', 'line');
          line.setAttribute('x1', CENTER.x);
          line.setAttribute('y1', CENTER.y);
          line.setAttribute('x2', site.x);
          line.setAttribute('y2', site.y);
          line.setAttribute('class', 'route-line');
          routesG.appendChild(line);
        }

        // Sites — render markers + labels
        const sitesG = document.getElementById('map-sites');
        sitesG.innerHTML = '';
        for (const [name, site] of Object.entries(SITES)) {
          const isActive = (name === currentPadName);
          const isDest = (name === destPadName);
          let color, radius, glow;
          if (site.kind === 'hub') {
            color = '#ffd060'; radius = 8; glow = '#ffd060';
          } else if (isActive) {
            color = '#00E5FF'; radius = 7; glow = '#00E5FF';
          } else if (isDest) {
            color = '#f59e0b'; radius = 6; glow = '#f59e0b';
          } else if (site.kind === 'pickup') {
            color = '#4ade80'; radius = 4.5; glow = null;
          } else {
            color = '#f59e0b'; radius = 4.5; glow = null;
          }

          const g = document.createElementNS('http://www.w3.org/2000/svg', 'g');
          g.setAttribute('transform', `translate(${site.x}, ${site.y})`);

          // Pulsing ring for hub + active pad
          if (site.kind === 'hub' || isActive) {
            const pulseRing = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
            pulseRing.setAttribute('r', radius + 4);
            pulseRing.setAttribute('fill', 'none');
            pulseRing.setAttribute('stroke', glow);
            pulseRing.setAttribute('stroke-width', '1');
            pulseRing.setAttribute('class', 'site-pulse');
            pulseRing.style.transformOrigin = '0 0';
            g.appendChild(pulseRing);
          }

          // Outer glow (for hub/active/dest)
          if (glow) {
            const glowCircle = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
            glowCircle.setAttribute('r', radius + 2);
            glowCircle.setAttribute('fill', glow);
            glowCircle.setAttribute('opacity', '0.3');
            g.appendChild(glowCircle);
          }

          // Marker
          const dot = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
          dot.setAttribute('r', radius);
          dot.setAttribute('fill', color);
          if (site.kind === 'hub' || isActive) {
            dot.setAttribute('stroke', '#fff');
            dot.setAttribute('stroke-width', '0.8');
          }
          g.appendChild(dot);

          // For hub, add an X cross
          if (site.kind === 'hub') {
            const cross = document.createElementNS('http://www.w3.org/2000/svg', 'path');
            cross.setAttribute('d', 'M -4 0 L 4 0 M 0 -4 L 0 4');
            cross.setAttribute('stroke', '#02060f');
            cross.setAttribute('stroke-width', '1.5');
            cross.setAttribute('fill', 'none');
            g.appendChild(cross);
          }

          // Label
          const label = document.createElementNS('http://www.w3.org/2000/svg', 'text');
          label.setAttribute('class', 'site-label' + (isActive || isDest || site.kind === 'hub' ? ' active' : ''));
          label.setAttribute('text-anchor', 'middle');
          label.setAttribute('y', radius + 11);
          label.textContent = name;
          g.appendChild(label);

          sitesG.appendChild(g);
        }

        // Active route — solid line from current pad to destination
        const activeRoute = document.getElementById('map-active-route');
        if (currentPadName && destPadName && SITES[currentPadName] && SITES[destPadName]) {
          const a = SITES[currentPadName], b = SITES[destPadName];
          activeRoute.setAttribute('d', `M ${a.x} ${a.y} L ${b.x} ${b.y}`);
        } else {
          activeRoute.setAttribute('d', '');
        }

        // Vehicle marker — currently parked at the active pad. Animate a slow drift along
        // the route so it's clear which way it'll go when it launches.
        const vehicle = document.getElementById('map-vehicle');
        const vlabel  = document.getElementById('map-vehicle-label');
        if (vlabel) vlabel.textContent = tailNumber || 'SDX-0001';
        if (vehicle && currentPadName && SITES[currentPadName]) {
          vehicle.setAttribute('opacity', '1');
          const a = SITES[currentPadName];
          const b = SITES[destPadName] || a;
          // Animate t from 0 → 0.15 → 0 over 8s, so the vehicle "previews" its first 15% of travel
          let startTime = performance.now();
          const animate = () => {
            const elapsed = (performance.now() - startTime) / 1000;
            const phase = (elapsed % 8) / 8;
            // Ease in-out triangle wave
            const wave = phase < 0.5 ? phase * 2 : (1 - phase) * 2;
            const t = wave * 0.18;
            const x = a.x + (b.x - a.x) * t;
            const y = a.y + (b.y - a.y) * t;
            vehicle.setAttribute('transform', `translate(${x}, ${y})`);
            padMapAnimRAF = requestAnimationFrame(animate);
          };
          animate();
        }

        // Status line
        const statusEl = document.getElementById('pad-map-status');
        if (statusEl) {
          statusEl.innerHTML = `<span class="status-current">${currentPadName || '—'}</span> &rarr; ${destPadName || '—'} · ${Object.keys(SITES).length - 1} dispatch sites · ${MAIN_HUB_NAME} centered`;
        }
      }

      // Compute the fleet rank label like "1ST AIRCRAFT OF THE FLEET", "5TH …".
      // This is the position of the CURRENTLY-DISPLAYED aircraft within the
      // saved hangar (sorted by savedAt, oldest = 1st). If the user just saved
      // a new design, it's the position of that new design. If they navigated
      // to the pad without saving anything new, it's the position of the
      // newest saved design (which is what the pad auto-selects as default).
      //
      // Bug history: previous code used `saved.length + 1` to account for the
      // "currently-edited but not yet saved" aircraft, but that was wrong when
      // entering the pad with already-saved designs and no fresh edit — we'd
      // report e.g. "2ND" when the user only had 1 design.
      function fleetRankLabel() {
        let count = 1;
        try {
          const saved = (typeof getAllSavedDesigns === 'function') ? getAllSavedDesigns() : [];
          if (saved.length === 0) {
            // No saves yet — this is the first/only aircraft
            count = 1;
          } else {
            const ordered = saved.slice().sort((a, b) => (a.savedAt || 0) - (b.savedAt || 0));
            // Prefer designJustSaved (the user clicked SAVE, then was routed
            // to the pad — that's the design they expect to see ranked)
            let target = null;
            if (designJustSaved) target = ordered.findIndex(d => d.id === designJustSaved.id);
            // Otherwise, use the currently-selected pad aircraft
            if ((target === null || target < 0) && padSelectedAircraft?.id) {
              target = ordered.findIndex(d => d.id === padSelectedAircraft.id);
            }
            // Otherwise, default to the most recently-saved design (matches
            // the pad's auto-select behavior)
            if (target === null || target < 0) target = ordered.length - 1;
            count = target + 1;
          }
        } catch { count = 1; }
        const ord = (n) => {
          const s = ['TH', 'ST', 'ND', 'RD'], v = n % 100;
          return n + (s[(v - 20) % 10] || s[v] || s[0]);
        };
        return `${ord(count)} AIRCRAFT OF THE FLEET`;
      }

      // ============================================================
      // AI CUSTOMER CHAT + FLEET ROSTER + DISPATCH SYSTEM
      // ============================================================

      // Sample customer names + believable request templates. Real-world apps
      // would pull these from an LLM; we use a small library of variations to
      // give the simulation feel without external dependencies.
      const CUSTOMER_NAMES = [
        'Maya Chen', 'David Park', 'Aiyana Walker', 'Lucas Romano', 'Sophia Reyes',
        'Hiroshi Tanaka', 'Zara Adisa', 'Ethan Brooks', 'Isabella Costa', 'Omar Patel',
        'Nina Volkov', 'Carlos Mendez', 'Priya Sharma', 'Jamal Ross', 'Eva Lindgren'
      ];
      const REQUEST_PHRASES = [
        (from, to) => `Hi, I need a ride from ${from} to ${to}. Stuck in a meeting until 6, can you grab me?`,
        (from, to) => `URGENT — meeting ran late, need pickup from ${from} ASAP, dropoff at ${to}.`,
        (from, to) => `Booking an air taxi from ${from} to ${to} for tonight, around 7pm if possible.`,
        (from, to) => `Anyone available? Need to get from ${from} to ${to} in the next 20 min.`,
        (from, to) => `Pickup at ${from}, dropping off at ${to}. Just one passenger, no luggage.`,
        (from, to) => `Hey — request a ride from ${from} → ${to}. Heading to a dinner reservation.`,
        (from, to) => `Need a quick lift from ${from} to ${to}. I'll be downstairs by the helipad.`,
        (from, to) => `Can someone fly me from ${from} to ${to}? Patient transfer, 2 passengers.`,
        (from, to) => `${from} pickup → ${to} dropoff please. ETA on next available?`,
        (from, to) => `Need transport from ${from} to ${to}. Got a presentation in 45 min.`,
      ];

      // Pad pool used for both chat and map (must match map sites)
      // Chat pad pool — derived dynamically from the active region's pads.
      // Excludes the hub itself (you don't dispatch FROM the hub TO the hub).
      // Also filters destinations to within MAX_DISPATCH_RADIUS_MILES of the
      // hub — this is a long-range BVLOS dispatch operation, not a metro
      // taxi, so destinations beyond ~100 miles are out of operational
      // envelope. Aircraft battery and cruise speed are tuned for this
      // range; flying farther would risk depletion mid-mission.
      //
      // ALSO excludes pads inside the hub plaza (the cleared area around
      // the launch site). Those pads are visualized as bare landing zones
      // — part of the vertiport facility itself — and aren't separate
      // "cities" to dispatch to. Pickup/dropoff happens in the city
      // areas (clusters of buildings around distant pads) where there's
      // an actual urban destination, not at empty spots near the hub.
      // Returns names so generateCustomerOrder can pick from / to.
      const MAX_DISPATCH_RADIUS_MILES = 500;     // ULTRA-long-range eVTOL envelope
      const HUB_PLAZA_RADIUS = 40;        // shared with scene-init code (bumped from 30 for larger aprons)
      // Battery state-of-charge constants — shared across the animation tick,
      // launch button enable logic, AND the fleet roster status display so all
      // three agree on what "fully charged / ready to launch" means. Without
      // this, the roster would say "READY" while the launch button correctly
      // refused with "CHARGING · 63% / 95%".
      const MAX_SOC = 95;
      const SOC_EPSILON = 0.05;

      function _padDistanceToHub(padName) {
        const pads = REGIONS[currentRegionKey]?.pads || PAD_GEOGRAPHY;
        const hub = pads[MAIN_HUB_NAME];
        const pad = pads[padName];
        if (!hub || !pad) return Infinity;
        return Math.hypot(pad.x - hub.x, pad.z - hub.z);
      }

      function chatPadPool() {
        const all = Object.keys(REGIONS[currentRegionKey]?.pads || PAD_GEOGRAPHY);
        return all.filter(n => {
          if (n === MAIN_HUB_NAME) return false;
          const d = _padDistanceToHub(n);
          return d > HUB_PLAZA_RADIUS && d <= MAX_DISPATCH_RADIUS_MILES;
        });
      }

      // Chat state: list of pending orders (each has id, customer, from, to, body, time, status)
      let padChatOrders = [];
      let padChatNextId = 1;
      let padChatGenInterval = null;
      let padSelectedOrder = null;
      let padSelectedAircraft = null;   // {id, name, tail, fromHangar}
      let padDispatchedFlights = [];    // active flights animating on the map
      let padFlightState = null;        // active 3D flight: { phases, startTime, active }
                                          // Kept as the "primary" flight for camera + audio tracking.
      let padFlightStates = [];         // ALL active 3D flights — each has its own acGroup
                                          // so multiple aircraft animate simultaneously.
      // Persistent per-design battery state (designId → { battery, lastUpdate, isCharging }).
      // Survives across flight completions so each aircraft remembers its charge.
      // After a flight ends, the design's entry continues to recharge at 1.5%/sec
      // until it hits MAX_SOC = 95%.
      // PERSISTENCE: also restored from localStorage on open and
      // saved on tick. User: "it starts from scratch when i open.
      // should represent data."
      const padDesignBatteries = new Map();
      try {
        const restored = (typeof window !== 'undefined' && window.__loadFleetBatteryState)
          ? window.__loadFleetBatteryState() : {};
        for (const [id, entry] of Object.entries(restored)) {
          padDesignBatteries.set(id, entry);
        }
      } catch (_) { /* fall through with empty map */ }
      // Throttled saver — battery state ticks every frame; we only
      // persist every 2s of wall-clock to avoid localStorage churn.
      let __padBatteryLastSaveMs = 0;
      function persistFleetBatteries() {
        const now = Date.now();
        if (now - __padBatteryLastSaveMs < 2000) return;
        __padBatteryLastSaveMs = now;
        if (typeof window !== 'undefined' && window.__saveFleetBatteryState) {
          window.__saveFleetBatteryState(padDesignBatteries);
        }
      }
      // Expose for outer-scope splash counter — needs to know charging
      // state to compute accurate available-count
      window.__padDesignBatteries = padDesignBatteries;
      let padTimeScale = 60;            // fixed time compression — tuned for ultra-long-range missions (1000mi RT in ~3.5min real)

      function timeAgoLabel(timestampMs) {
        const sec = Math.max(1, Math.floor((Date.now() - timestampMs) / 1000));
        if (sec < 60) return `${sec}s ago`;
        const min = Math.floor(sec / 60);
        if (min < 60) return `${min}m ago`;
        return `${Math.floor(min / 60)}h ago`;
      }

      // Generate one fake customer order. Optionally biased to use the current pad as pickup.
      // `excludePads` is a list of pad names to AVOID for both pickup and
      // dropoff — used by the AI fleet manager to keep AI orders away
      // from the human customer's pickup/dropoff so the user's view
      // isn't cluttered by AI taxis landing on top of them.
      function generateCustomerOrder(currentPad, excludePads) {
        const customer = CUSTOMER_NAMES[Math.floor(Math.random() * CUSTOMER_NAMES.length)];
        const exclude = new Set(excludePads || []);
        const pool = chatPadPool().filter(n => !exclude.has(n));
        if (pool.length < 2) {
          // Region somehow has no pads — shouldn't happen, but bail safely
          return null;
        }
        // 40% chance pickup is the current pad, otherwise random from current region
        // (only if currentPad isn't excluded — otherwise force-random)
        const useCurrent = currentPad && pool.includes(currentPad) &&
                           !exclude.has(currentPad) && Math.random() < 0.4;
        const from = useCurrent ? currentPad : pool[Math.floor(Math.random() * pool.length)];
        // Pick a `to` pad such that NO single leg exceeds MAX_DISPATCH_RADIUS_MILES.
        // The three legs of every mission are hub→from, from→to, to→hub. The first
        // and third are already bounded by the chatPadPool radius filter. The
        // middle (from→to) can still be too long if `from` and `to` are on
        // opposite sides of the hub, so we explicitly constrain it here.
        const pads = REGIONS[currentRegionKey]?.pads || PAD_GEOGRAPHY;
        const fromPos = pads[from];
        const candidates = pool.filter(n => {
          if (n === from) return false;
          if (exclude.has(n)) return false;
          const toPos = pads[n];
          if (!toPos || !fromPos) return false;
          return Math.hypot(toPos.x - fromPos.x, toPos.z - fromPos.z) <= MAX_DISPATCH_RADIUS_MILES;
        });
        // If filtering removed every option (very small region), fall back to
        // any non-self/non-excluded pad — better to have a slightly out-of-spec
        // mission than no mission at all. Battery may run lower in that edge case.
        const toPool = candidates.length > 0
          ? candidates
          : pool.filter(n => n !== from && !exclude.has(n));
        if (toPool.length === 0) return null;     // truly nowhere to go
        const to = toPool[Math.floor(Math.random() * toPool.length)];
        const phrase = REQUEST_PHRASES[Math.floor(Math.random() * REQUEST_PHRASES.length)](from, to);
        return {
          id: `order_${padChatNextId++}`,
          customer,
          from,
          to,
          body: phrase,
          time: Date.now(),
          status: 'pending'
        };
      }

      function renderChatFeed() {
        const feed = document.getElementById('pad-chat-feed');
        const countEl = document.getElementById('pad-chat-count');
        if (!feed) return;
        const pending = padChatOrders.filter(o => o.status === 'pending').length;
        if (countEl) countEl.textContent = `${pending} pending · ${padChatOrders.length - pending} dispatched`;
        if (padChatOrders.length === 0) {
          feed.innerHTML = '<div class="pad-chat-empty">Awaiting customer requests…</div>';
          return;
        }
        feed.innerHTML = '';
        // newest first
        const sorted = padChatOrders.slice().sort((a, b) => b.time - a.time);
        for (const order of sorted) {
          const div = document.createElement('div');
          div.className = 'pad-chat-msg';
          if (padSelectedOrder?.id === order.id) div.classList.add('selected');
          if (order.status === 'dispatched') div.classList.add('dispatched');
          if (order.status === 'completed') div.classList.add('dispatched');
          const statusLine = order.status === 'dispatched'
            ? `<div class="pad-chat-msg-status">▸ DISPATCHED · ${order.assignedTail || '—'} en route</div>`
            : order.status === 'completed'
              ? `<div class="pad-chat-msg-status">✓ COMPLETED</div>`
              : '';
          div.innerHTML = `
            <div class="pad-chat-msg-head">
              <span class="pad-chat-msg-name">${escapeHtml(order.customer)}</span>
              <span class="pad-chat-msg-time">${timeAgoLabel(order.time)}</span>
            </div>
            <div class="pad-chat-msg-body">${escapeHtml(order.body)}</div>
            <div class="pad-chat-msg-route">
              <span class="from">${escapeHtml(order.from)}</span>
              <span class="arrow">→</span>
              <span class="to">${escapeHtml(order.to)}</span>
            </div>
            ${statusLine}
          `;
          if (order.status === 'pending') {
            div.addEventListener('click', () => selectOrder(order));
          }
          feed.appendChild(div);
        }
      }

      function selectOrder(order) {
        padSelectedOrder = order;
        // Update the map to show pickup → dropoff
        const tail = padSelectedAircraft?.tail || document.getElementById('tail-number')?.value || 'SDX-0001';
        try { renderDispatchMap(order.from, order.to, tail); } catch {}
        // Update map status
        const statusEl = document.getElementById('pad-map-status');
        if (statusEl) {
          statusEl.innerHTML = `<span class="status-current">${order.from}</span> → ${order.to} · order from <span style="color:#fff">${escapeHtml(order.customer)}</span> · click LAUNCH NOW to dispatch`;
        }
        // Update vehicle tag in 3D pad scene
        const detailEl = document.getElementById('pad-info-detail');
        if (detailEl) detailEl.textContent = `${order.from} → ${order.to} · READY`;
        renderChatFeed();
      }

      // Build the fleet roster from saved designs + the current unsaved design.
      function renderFleetRoster() {
        const roster = document.getElementById('pad-fleet-roster');
        if (!roster) return;
        const saved = (typeof getAllSavedDesigns === 'function') ? getAllSavedDesigns() : [];
        // Lock by DESIGN ID — different designs that happen to share a tail number
        // (e.g. two designs both still named SDX-0001) should be independently
        // selectable. Only the exact design that's flying gets locked from selection.
        const inFlightDesignIds = new Set(
          padDispatchedFlights.filter(f => f.active).map(f => f.designId).filter(Boolean)
        );
        // Ordered by save date (oldest first → 1st, 2nd, …) for stable roster numbering
        const ordered = saved.slice().sort((a, b) => (a.savedAt || 0) - (b.savedAt || 0));
        const items = ordered.slice();
        // Empty state: no saved designs yet
        if (items.length === 0) {
          // Allow dispatch using the current in-design aircraft implicitly
          const currentTail = document.getElementById('tail-number')?.value || 'SDX-0001';
          padSelectedAircraft = {
            id: 'current_unsaved',
            name: 'Current aircraft',
            tail: currentTail,
            fromHangar: false
          };
          roster.innerHTML = '<div class="pad-roster-empty">No saved designs yet. Dispatching with the current aircraft (' + escapeHtml(currentTail) + '). Save a design from the editor to build your fleet.</div>';
          return;
        }
        // Auto-select the design the user wants to see — in priority order:
        //   1. designJustSaved — set when the user just clicked SAVE in the
        //      editor and was routed to the launch pad. They expect to see
        //      THAT design rendered, not a different one.
        //   2. The newest saved design — when no specific design was just saved
        //      (e.g. user navigated to pad from a fresh session), the most
        //      recently-saved design is the most likely thing they want to fly.
        // Previously this defaulted to items[0] (the OLDEST design), meaning a
        // user who saved a new bicopter and entered the pad would see their
        // first-ever design from days ago instead of the bicopter they just built.
        if (!padSelectedAircraft || !items.find(i => i.id === padSelectedAircraft.id)) {
          let chosen = null;
          if (designJustSaved && items.find(i => i.id === designJustSaved.id)) {
            chosen = items.find(i => i.id === designJustSaved.id);
          } else {
            // items is sorted oldest→newest, so the last entry is most recent
            chosen = items[items.length - 1];
          }
          padSelectedAircraft = {
            id: chosen.id,
            name: chosen.name,
            tail: chosen.tailNumber || 'SDX-0001',
            fromHangar: true
          };
          // Load this design's geometry into the pad scene right away
          loadDesignIntoPadGroup(padSelectedAircraft);
        }
        roster.innerHTML = '';
        items.forEach((item, idx) => {
          const div = document.createElement('div');
          div.className = 'pad-roster-item';
          const tail = item.tailNumber || 'SDX-0001';
          const inFlight = inFlightDesignIds.has(item.id);
          if (inFlight) div.classList.add('in-flight');
          if (padSelectedAircraft?.id === item.id) div.classList.add('selected');
          const ordNum = idx + 1;
          // Initial battery reading from persistent map (or 95% if first sight)
          const battEntry = padDesignBatteries.get(item.id);
          const initialBatt = battEntry ? battEntry.battery.toFixed(0) : '95';
          // Match the launch button's threshold exactly. The roster previously
          // said "READY" for any non-flying aircraft regardless of charge level,
          // which contradicted the launch button (which correctly refused at
          // "CHARGING · 63% / 95%"). Three states now:
          //   IN FLIGHT — animation is active for this design
          //   CHARGING  — on the ground but battery < MAX_SOC - SOC_EPSILON
          //   READY     — on the ground and topped up (matches launch enable)
          const currentCharge = battEntry?.battery ?? MAX_SOC;
          const undercharged = currentCharge < MAX_SOC - SOC_EPSILON;
          let statusText;
          if (inFlight)             statusText = 'IN FLIGHT';
          else if (undercharged)    statusText = 'CHARGING';
          else                       statusText = 'READY';
          if (undercharged && !inFlight) div.classList.add('charging');
          div.innerHTML = `
            <span class="pad-roster-dot"></span>
            <span class="pad-roster-name" title="${escapeHtml(item.name)}">${escapeHtml(item.name)}</span>
            <span class="pad-roster-tail">${escapeHtml(tail)}</span>
            <span class="pad-roster-meta">#${ordNum} · ${statusText}</span>
            <span class="pad-roster-battery" data-design-id="${escapeHtml(item.id)}">⚡ ${initialBatt}%</span>
          `;
          if (!inFlight) {
            div.addEventListener('click', () => {
              padSelectedAircraft = {
                id: item.id,
                name: item.name,
                tail: tail,
                fromHangar: true
              };
              // Clear designJustSaved — the user has now explicitly chosen a
              // different aircraft, so the "show me what I just saved" intent
              // no longer applies. fleetRankLabel() should now use
              // padSelectedAircraft directly.
              designJustSaved = null;
              renderFleetRoster();
              // Update vehicle info display
              const idEl = document.getElementById('pad-info-id');
              if (idEl) idEl.textContent = tail;
              document.getElementById('pad-tail').textContent = tail;
              document.getElementById('vtag-id') && (document.getElementById('vtag-id').textContent = tail);
              // Update the fleet rank label ("1ST/2ND/Nth AIRCRAFT OF THE FLEET")
              // since a different aircraft is now selected
              const rankEl = document.getElementById('pad-fleet-rank');
              if (rankEl) rankEl.textContent = fleetRankLabel();
              // CRITICAL: actually swap the aircraft displayed in the launch pad scene.
              // Without this, clicking a roster item only updates labels — the 3D scene
              // and dispatch animation keep using whatever was last loaded, so the user
              // can't actually fly different designs from their fleet.
              loadDesignIntoPadGroup(item);
            });
          }
          roster.appendChild(div);
        });
      }

      // Update the launch pad's selection state. With stable per-design apron
      // slots, every aircraft stays parked at its OWN apron pad — selection
      // doesn't physically move anything. We only update:
      //   - The hub label sprite, which floats above the selected aircraft's
      //     apron pad to indicate "this is the one queued for dispatch"
      //   - The audio profile preview (next dispatch will sound like this design)
      //   - The apron rendering (incremental, doesn't re-render unchanged groups)
      //
      // padGroup is preserved as a code-path fallback (clone-failure path during
      // launch) but is left empty in normal operation. The user no longer sees
      // any aircraft teleport to/from the central hub pad on selection.
      function loadDesignIntoPadGroup(designSummary) {
        if (!designSummary) return;
        // Apply the design's audio profile so the next dispatch plays the right
        // sound. (If a flight is currently active, we don't disturb its audio.)
        try {
          const profile = computeDesignProfile(designSummary);
          if (!(padFlightState && padFlightState.active)) {
            propellerSynth.setDesignProfile(profile);
          }
        } catch (e) { console.warn('Audio profile failed:', e); }
        // Update hub label so the user sees which aircraft is selected.
        // The label positions itself above the selected aircraft's apron slot
        // (computed in updateHubLabel using apronPosition).
        updateHubLabel(designSummary);
        // Re-render aprons. With incremental rendering + stable slots, this
        // is essentially a no-op for aircraft that didn't change state — only
        // the previously-selected aircraft (if any) gets a new apron group
        // added at its slot, and the newly-selected one (which already had
        // an apron group) keeps its existing mesh in place.
        if (typeof renderFleetAprons === 'function') renderFleetAprons();
      }

      // Position an aircraft so its lowest point (skid bottom, wheel bottom,
      // boom-arm tip, whatever the design's true ground extent is) rests at
      // padTopWorldY + clearance. Hard-coded Y offsets don't work because
      // each design's bottom-of-geometry sits at a different distance from
      // its model origin — quadcopter arms hang lower than a teardrop body,
      // skids hang lower than retractable wheels, etc. Without this, designs
      // with skids/arms visibly clip into the pad surface.
      //
      // Important: caller MUST add the object to its parent + apply any
      // intended scale/rotation BEFORE calling this. We measure world-space
      // bounds, so all parent transforms must be baked in first.
      function settleOnPad(object, padTopWorldY, clearance = 0.02) {
        if (!object) return;
        object.updateMatrixWorld(true);
        const box = new THREE.Box3().setFromObject(object);
        if (!isFinite(box.min.y)) return;  // empty group, nothing to measure
        const currentBottomY = box.min.y;
        const desiredBottomY = padTopWorldY + clearance;
        object.position.y += (desiredBottomY - currentBottomY);
      }

      // ============================================================================
      // FLEET APRON RENDERING — show all saved designs on visible landing pads
      // arranged in a row behind the main launch pad. The currently-selected
      // aircraft is hidden from the apron (since it's also on the main hub),
      // and other fleet members sit on illuminated pads showing their tail #.
      // ============================================================================
      let padApronGroups = {};      // designId → THREE.Group (pad + aircraft + label)
      // Destination pad markers (pickup green + dropoff amber) persist across
      // missions — once placed at a destination, the pad stays visible so the
      // user can see all served destinations at a glance. Keyed by destination
      // pad NAME (e.g. "FRESNO") so a second flight to the same destination
      // doesn't add a duplicate. Customer figures are NOT persistent (they
      // disappear when the aircraft picks them up, mid-mission).
      const padDestinationPads = {};   // padName → { group, color }

      // Apron pad layout constants — hoisted so the flight-completion handler
      // can compute apron positions too (used to route completing clones to
      // their own parking spot instead of overlapping the hub).
      //
      // Each saved design has its own raw bounding-box size (a designer's
      // narrowbody quadcopter might be 1.8u wide, a wide-bodied tilt-rotor
      // 8u wide). We can't pick a single "full size" that fits all of them.
      // Solution: normalize each aircraft via computeFitScale below — the
      // normalized scale is applied identically to the apron static copy
      // AND the in-flight clone, so a given design appears at the SAME
      // visual size at every lifecycle stage. No shrink on landing, no
      // grow on takeoff, no overhang past the pad rim.
      const APRON_BASE_Z = 9;
      const APRON_SPACING = 9.5;     // bumped from 7.0 — accommodates larger fitted aircraft
      const APRON_PAD_RADIUS = 3.6;  // bumped from 2.8 — fits larger aircraft
      // Aircraft normalized so their largest horizontal half-extent fits within
      // this. Bumped from 2.3 to 3.5 so aircraft are CLEARLY larger than a 1.7m
      // human in ground-cam mode — a typical normalized aircraft now spans ~7
      // units across (roughly minivan to small-bus footprint), towering over the
      // ground-cam person. Without this, aircraft looked tiny next to buildings
      // and were easy to miss in the 3D view.
      const FIT_TARGET_HALF_EXTENT = 3.5;
      const FIT_MIN_SCALE = 0.15;
      const FIT_MAX_SCALE = 1.0;

      // Compute a uniform scale factor that fits a 3D group within
      // ±FIT_TARGET_HALF_EXTENT in the horizontal (X, Z) plane. Used
      // identically for apron static copies AND in-flight clones, so a
      // given design is the SAME size at every lifecycle stage. Without
      // this normalization, "full size 1.0" makes wide-bodied designs
      // overhang the pad by 3+ units (and crash into adjacent aircraft),
      // while narrow designs look small and lost in the middle of an
      // oversized pad.
      function computeFitScale(group, targetHalfExtent = FIT_TARGET_HALF_EXTENT) {
        try {
          // Measure unscaled bbox: temporarily reset scale to 1, measure, restore.
          const prevScale = group.scale.clone();
          group.scale.set(1, 1, 1);
          group.updateMatrixWorld(true);
          const box = new THREE.Box3().setFromObject(group);
          group.scale.copy(prevScale);
          group.updateMatrixWorld(true);
          const halfX = Math.max(Math.abs(box.min.x), Math.abs(box.max.x));
          const halfZ = Math.max(Math.abs(box.min.z), Math.abs(box.max.z));
          const halfMax = Math.max(halfX, halfZ);
          if (!isFinite(halfMax) || halfMax <= 0) return 1.0;
          const raw = targetHalfExtent / halfMax;
          // Clamp to safety bounds — extremely small or pathological designs shouldn't blow up
          return Math.max(FIT_MIN_SCALE, Math.min(FIT_MAX_SCALE, raw));
        } catch (e) {
          console.warn('computeFitScale failed:', e);
          return 1.0;
        }
      }

      // Compute the apron pad position for a given designId. Used both by
      // renderFleetAprons (to place static parked copies) and by the flight-
      // launch + completion code (to know where the aircraft physically
      // takes off from / lands at). Position is STABLE per design — based on
      // the permanent oldest-first ordering of all saved designs, not on
      // which other aircraft happen to be visible. A given design's apron
      // slot never moves regardless of what else is selected/flying. Without
      // this stability, every dispatch caused the rest of the fleet to
      // teleport into compacted positions; every landing caused them to
      // teleport back out.
      function apronPosition(designId) {
        // SCATTER LAYOUT — aircraft are arrayed around a ring inside
        // the hub plaza using golden-angle spacing, not a single file
        // line. User: "all taxi's in the hub should not be in a
        // single file line, they should be scattered within the hub
        // circle." Each design gets a deterministic (designId-based)
        // position so it doesn't jump between renders.
        const all = (typeof getAllSavedDesigns === 'function') ? getAllSavedDesigns() : [];
        const ordered = all.slice().sort((a, b) => (a.savedAt || 0) - (b.savedAt || 0));
        const idx = ordered.findIndex(d => d.id === designId);
        if (idx < 0) return { x: 0, z: APRON_BASE_Z };
        // Golden angle (~137.5°) gives visually pleasing non-line
        // distribution for any count of aircraft up to ~30.
        const goldenAngle = Math.PI * (3 - Math.sqrt(5));
        // Skip the south arc near where customers approach the pad.
        // Start the spiral 90° offset so the first aircraft sits
        // east of the pad, not south of it.
        const angle = (idx * goldenAngle) + (Math.PI / 2);
        // Radius jitter so aircraft don't all lie on a perfect ring.
        // Deterministic from idx — same design always lands at same spot.
        const jitter = ((idx * 31 + 7) % 11) / 10;     // 0.0..1.0
        const r = 13.0 + jitter * 6.0;                 // 13..19u from hub center
        return {
          x: Math.cos(angle) * r,
          z: Math.sin(angle) * r,
        };
      }

      // Hub-aircraft label sprite. padGroup contents get wiped on every
      // selection swap, so the label can't live inside padGroup itself.
      // Instead we keep one persistent sprite parented to padScene, hovering
      // above the hub pad, and just rewrite its texture when selection changes.
      let padHubLabel = null;
      function updateHubLabel(designSummary) {
        if (!padScene) return;
        // Build (or reuse) the label sprite
        if (!padHubLabel) {
          const canvas = document.createElement('canvas');
          canvas.width = 256; canvas.height = 64;
          const tex = new THREE.CanvasTexture(canvas);
          const mat = new THREE.SpriteMaterial({ map: tex, transparent: true, depthWrite: false });
          const sprite = new THREE.Sprite(mat);
          sprite.scale.set(2.8, 0.7, 1);   // slightly larger than apron labels
          sprite.position.set(0, 2.4, 0);  // above the hub aircraft
          sprite.userData.canvas = canvas;
          sprite.userData.texture = tex;
          padScene.add(sprite);
          padHubLabel = sprite;
        }
        if (!designSummary) {
          padHubLabel.visible = false;
          return;
        }
        // Repaint the canvas. Hub label gets a slightly hotter accent (warm
        // amber) vs apron's cyan so user can always tell at a glance which
        // is the SELECTED aircraft.
        const canvas = padHubLabel.userData.canvas;
        const ctx = canvas.getContext('2d');
        ctx.clearRect(0, 0, 256, 64);
        ctx.fillStyle = 'rgba(2, 8, 23, 0.9)';
        ctx.fillRect(0, 0, 256, 64);
        ctx.strokeStyle = '#FFB347';     // amber for selected
        ctx.lineWidth = 2.5;
        ctx.strokeRect(2, 2, 252, 60);
        ctx.fillStyle = '#FFB347';
        ctx.font = 'bold 24px JetBrains Mono, monospace';
        ctx.textAlign = 'center';
        ctx.textBaseline = 'middle';
        ctx.fillText(designSummary.tailNumber || designSummary.tail || 'SELECTED', 128, 22);
        ctx.fillStyle = '#a0b8d8';
        ctx.font = '14px JetBrains Mono, monospace';
        ctx.fillText((designSummary.name || 'unnamed').slice(0, 18), 128, 46);
        padHubLabel.userData.texture.needsUpdate = true;
        padHubLabel.visible = true;
        // Position the label ABOVE the selected aircraft's apron pad —
        // selection no longer moves the aircraft to the hub. The label
        // floats over wherever the chosen aircraft happens to be parked.
        try {
          const apronPos = apronPosition(designSummary.id);
          padHubLabel.position.set(apronPos.x, 2.4, apronPos.z);
        } catch (e) {
          // Fallback to hub if apronPosition fails for any reason
          padHubLabel.position.set(0, 2.4, 0);
        }
      }

      // ===== CHARGER STATION =====
      // User: "there should not be 12 taxi's on the pad when I enter.
      // I needs to represent the data." So aircraft below 95% battery
      // are pulled out of their normal apron slots and parked at a
      // charger station off to the side, where they get a cyan
      // emissive ring under them indicating they're juicing up. This
      // plus the bg-pool union means the apron now shows ONLY
      // aircraft that are actually parked-and-ready: full battery,
      // not currently flying anywhere in the simulated network.
      //
      // Charger station is a row of 6 charging spots arranged along
      // the north edge of the hub, separated from the main scatter
      // pattern so the user can see at a glance what's plugged in.
      const CHARGER_STATION = {
        baseX: 0,             // centered on hub
        baseZ: -22,           // north of hub (negative Z is forward of camera)
        spotSpacing: 3.5,     // x spacing between charge spots
        spotsPerRow: 6,
      };
      function chargerSpotPosition(slotIdx) {
        // Wrap to a second row if we somehow exceed spotsPerRow
        const row = Math.floor(slotIdx / CHARGER_STATION.spotsPerRow);
        const col = slotIdx % CHARGER_STATION.spotsPerRow;
        // Center the row around baseX
        const totalWidth = (CHARGER_STATION.spotsPerRow - 1) * CHARGER_STATION.spotSpacing;
        const x = CHARGER_STATION.baseX - totalWidth / 2 + col * CHARGER_STATION.spotSpacing;
        const z = CHARGER_STATION.baseZ - row * 4.5;
        return { x, z };
      }

      function renderFleetAprons() {
        if (!padScene) return;
        const all = (typeof getAllSavedDesigns === 'function') ? getAllSavedDesigns() : [];
        if (window.__SDX_APRON_DEBUG) console.log('[apron] designs found:', all.length);

        // ===== IN-FLIGHT (VISIBLE FLIGHTS ONLY) =====
        // The apron is a visual representation of the launchpad scene.
        // We hide aircraft whose visible flying clone is currently in
        // the scene — and ONLY those. That's padFlightStates with
        // active=true OR transitioning (clone parked at apron pad
        // spooling down for 1.5s after mission complete).
        //
        // We INTENTIONALLY do NOT hide bg-operator-pool aircraft here.
        // The bg operator pool is an ABSTRACT simulation that ticks
        // the splash counter — it does NOT produce visible flying
        // clones in the launchpad scene. If the user has 14 designs
        // and the bg pool happens to have 6 of them attached at the
        // moment the launchpad opens, hiding those 6 from the apron
        // makes them DISAPPEAR with no corresponding visible flight,
        // which is what the user is seeing as "aircraft disappearing
        // on landing again." User: "did you do a regression, there
        // are multiple bugs, that are making aircraft disappear on
        // landing again, and saying ready, when they are in flight."
        //
        // The splash-counter sync (computeFleetState) correctly unions
        // both pools — that's a different concern. Splash counts every
        // simulated flight; the apron is purely visual and only hides
        // what's visibly flying RIGHT HERE in the scene.
        const launchpadInFlightIds = new Set(
          (padFlightStates || [])
            .filter(f => f.active || f.transitioning)
            .map(f => f.designId)
        );
        const customerAircraftId = (typeof window !== 'undefined' && window.__customerModeActive)
          ? window.__customerAircraftId : null;
        const inFlightIds = new Set(launchpadInFlightIds);
        if (customerAircraftId) inFlightIds.add(customerAircraftId);

        // ===== CHARGING DETECTION =====
        // Aircraft below 95% battery (per padDesignBatteries map) are
        // routed to the charger station instead of their idle apron
        // slot. They're still visible (so the user knows what they
        // own) but they're at the charger with a charge effect.
        const MIN_BATT = 95 - 0.05;
        const chargingIds = new Set();
        if (typeof padDesignBatteries !== 'undefined' && padDesignBatteries) {
          padDesignBatteries.forEach((entry, designId) => {
            if (entry && typeof entry.battery === 'number' && entry.battery < MIN_BATT) {
              chargingIds.add(designId);
            }
          });
        }

        // ===== shouldRender SET =====
        // Render every design EXCEPT those flying. Charging aircraft
        // are still rendered but at the charger station (different
        // position + visual treatment).
        const shouldRender = new Set();
        for (const d of all) {
          if (!d || !d.id) continue;
          if (inFlightIds.has(d.id)) continue;
          shouldRender.add(d.id);
        }

        // ===== PRUNE STALE GROUPS =====
        // Remove any apron group whose design is now flying. We also
        // remove groups for aircraft whose CHARGING STATE flipped
        // (charged↔ready) so the position update cleanly takes
        // effect — destroying-and-rebuilding a tiny group is cheaper
        // than animating a slot transition.
        for (const id of Object.keys(padApronGroups)) {
          const grp = padApronGroups[id];
          const wasCharging = !!(grp && grp.userData && grp.userData.atCharger);
          const isCharging = chargingIds.has(id);
          const stateMismatch = wasCharging !== isCharging;
          if (!shouldRender.has(id) || stateMismatch) {
            padScene.remove(grp);
            grp.traverse(o => { if (o.geometry) o.geometry.dispose(); });
            delete padApronGroups[id];
            if (window.__SDX_APRON_DEBUG) console.log('[apron] removed:', id, stateMismatch ? '(charge-state flipped)' : '(in-flight)');
          }
        }
        if (!all.length) return;

        // ===== UPDATE EXISTING SELECTION RINGS =====
        for (const id of Object.keys(padApronGroups)) {
          const grp = padApronGroups[id];
          if (grp.userData.ring) {
            const isSel = padSelectedAircraft && padSelectedAircraft.id === id;
            grp.userData.ring.material.color.setHex(isSel ? 0xFFB347 : 0x00E5FF);
            grp.userData.ring.material.emissive.setHex(isSel ? 0xFF8800 : 0x00B0CC);
            grp.userData.ring.material.emissiveIntensity = isSel ? 0.9 : 0.0;
            grp.userData.ring.material.opacity = isSel ? 0.55 : 0.0;
          }
        }

        // ===== ASSIGN CHARGER SLOTS =====
        // Charging aircraft get charger-station positions (slot index
        // determined by their order in the saved-designs list, so the
        // assignment is stable). Non-charging aircraft use their
        // normal scatter apronPosition.
        const ordered = all.slice().sort((a, b) => (a.savedAt || 0) - (b.savedAt || 0));
        // Assign charger slots to the SUBSET that's currently charging,
        // packed left-to-right (so charger always looks tidy regardless
        // of how many are plugged in).
        const chargingOrdered = ordered.filter(d => chargingIds.has(d.id));
        const chargerSlotForId = new Map();
        chargingOrdered.forEach((d, slotIdx) => chargerSlotForId.set(d.id, slotIdx));

        ordered.forEach((design, idx) => {
          try {
          if (!shouldRender.has(design.id)) return;
          if (padApronGroups[design.id]) return;
          if (window.__SDX_APRON_DEBUG) console.log('[apron] adding:', design.id, 'at idx', idx);
          // Position: charger station for charging, scatter apron otherwise
          const isCharging = chargingIds.has(design.id);
          let px, pz;
          if (isCharging) {
            const spot = chargerSpotPosition(chargerSlotForId.get(design.id) || 0);
            px = spot.x;
            pz = spot.z;
          } else {
            const apPos = apronPosition(design.id);
            px = apPos.x;
            pz = apPos.z;
          }
          const grp = new THREE.Group();
          grp.position.set(px, 0, pz);
          // NO PAD DISC. Aircraft sits directly on the tan ground at y=0.
          // (Previous version had a 0.16-thick octagonal pad disc + amber/cyan
          // trim ring + 4 corner glow dots. User wanted these removed for a
          // cleaner look — aircraft now rest on terrain like real eVTOLs at
          // a vertiport apron without painted markings.)
          //
          // We KEEP an invisible reference for the selection highlight: a
          // very-low-opacity ring on the ground that brightens when the user
          // clicks this aircraft. This preserves the "amber ring = selected"
          // affordance without a permanent painted pad.
          const isSelectedNow = padSelectedAircraft && padSelectedAircraft.id === design.id;
          const selRing = new THREE.Mesh(
            new THREE.TorusGeometry(APRON_PAD_RADIUS * 0.95, 0.025, 6, 28),
            new THREE.MeshStandardMaterial({
              color: isSelectedNow ? 0xFFB347 : 0x00E5FF,
              emissive: isSelectedNow ? 0xFF8800 : 0x00B0CC,
              emissiveIntensity: isSelectedNow ? 0.9 : 0.0,
              transparent: true,
              opacity: isSelectedNow ? 0.55 : 0.0
            })
          );
          selRing.rotation.x = Math.PI / 2;
          selRing.position.y = 0.005;       // hairline above ground to avoid z-fighting
          grp.add(selRing);
          grp.userData.ring = selRing;     // expose for selection highlight updates
          // Aircraft (deserialized from saved design)
          try {
            const loader = new THREE.ObjectLoader();
            const restored = loader.parse(design.scene);
            const acGroup = new THREE.Group();
            while (restored.children.length) {
              const c = restored.children[0];
              acGroup.add(c);
            }
            acGroup.traverse(o => { if (o.isMesh) o.castShadow = true; });
            grp.add(acGroup);
            const fitScale = computeFitScale(acGroup);
            acGroup.scale.set(fitScale, fitScale, fitScale);
            grp.userData.fitScale = fitScale;
            // Settle the aircraft so its actual bottom (skids/wheels/arms)
            // rests on the GROUND at y=0, not embedded into terrain. The
            // settleOnPad helper now treats padTop=0 as ground level.
            settleOnPad(acGroup, 0, 0.02);
          } catch (e) {
            console.warn('Apron load failed for', design.id, e);
          }
          // Tail-number label using a CanvasTexture sprite. Includes
          // battery % so the user can see fleet state at a glance —
          // charging aircraft show their current charge level
          // (cyan), full aircraft show "READY" (green).
          const labelCanvas = document.createElement('canvas');
          labelCanvas.width = 256; labelCanvas.height = 80;     // taller to fit battery row
          const ctx2 = labelCanvas.getContext('2d');
          ctx2.fillStyle = 'rgba(2, 8, 23, 0.85)';
          ctx2.fillRect(0, 0, 256, 80);
          ctx2.strokeStyle = isCharging ? '#00E5FF' : '#00E5FF';
          ctx2.lineWidth = 2;
          ctx2.strokeRect(2, 2, 252, 76);
          ctx2.fillStyle = '#00E5FF';
          ctx2.font = 'bold 24px JetBrains Mono, monospace';
          ctx2.textAlign = 'center';
          ctx2.textBaseline = 'middle';
          // Tail label. If the design has no tail number, derive a stable
          // short label from its id (e.g. SDX-#A3F2) so two untitled designs
          // never both render as the same "SDX-?" — that collision was the
          // OTHER half of the fleet-duplication bug: visually distinct
          // aircraft showing identical labels.
          const fallbackTail = (() => {
            const raw = String(design.id || '').replace(/[^a-z0-9]/gi, '').toUpperCase();
            return raw ? `SDX-#${raw.slice(-4)}` : 'SDX-?';
          })();
          const labelTopText = design.tailNumber || fallbackTail;
          ctx2.fillText(labelTopText, 128, 18);
          ctx2.fillStyle = '#a0b8d8';
          ctx2.font = '13px JetBrains Mono, monospace';
          ctx2.fillText((design.name || 'unnamed').slice(0, 18), 128, 40);
          // Battery / status row — represents data state per user request
          const batteryEntry = (typeof padDesignBatteries !== 'undefined' && padDesignBatteries)
            ? padDesignBatteries.get(design.id) : null;
          const batteryPct = batteryEntry ? Math.round(batteryEntry.battery) : 95;
          if (isCharging) {
            ctx2.fillStyle = '#00E5FF';
            ctx2.font = 'bold 14px JetBrains Mono, monospace';
            ctx2.fillText(`⚡ CHARGING ${batteryPct}%`, 128, 62);
          } else {
            ctx2.fillStyle = '#4ade80';
            ctx2.font = 'bold 14px JetBrains Mono, monospace';
            ctx2.fillText(`✓ READY  ${batteryPct}%`, 128, 62);
          }
          const labelTex = new THREE.CanvasTexture(labelCanvas);
          const labelMat = new THREE.SpriteMaterial({ map: labelTex, transparent: true });
          const labelSprite = new THREE.Sprite(labelMat);
          labelSprite.scale.set(3.2, 1.0, 1);     // taller proportions for new label
          labelSprite.position.set(0, 2.7, 0);
          grp.add(labelSprite);

          // ===== CHARGER VISUAL EFFECT =====
          // For aircraft at the charger station, add a pulsing cyan
          // ring on the ground beneath them. Distinguishes "plugged
          // in" from "ready to fly" at a glance — exactly the data
          // state representation the user asked for.
          if (isCharging) {
            const chargerRing = new THREE.Mesh(
              new THREE.TorusGeometry(APRON_PAD_RADIUS * 0.85, 0.04, 8, 32),
              new THREE.MeshStandardMaterial({
                color: 0x00E5FF,
                emissive: 0x00B0CC,
                emissiveIntensity: 1.4,
                transparent: true,
                opacity: 0.7,
              })
            );
            chargerRing.rotation.x = Math.PI / 2;
            chargerRing.position.y = 0.008;     // hairline above ground, above selRing
            grp.add(chargerRing);
            grp.userData.chargerRing = chargerRing;
            // A second outer ring for the pulse effect
            const pulseRing = new THREE.Mesh(
              new THREE.TorusGeometry(APRON_PAD_RADIUS * 1.1, 0.025, 6, 24),
              new THREE.MeshStandardMaterial({
                color: 0x00E5FF,
                emissive: 0x00E5FF,
                emissiveIntensity: 0.6,
                transparent: true,
                opacity: 0.35,
              })
            );
            pulseRing.rotation.x = Math.PI / 2;
            pulseRing.position.y = 0.012;
            grp.add(pulseRing);
            grp.userData.pulseRing = pulseRing;
          }

          // Tag the group so the next render-call's prune logic knows
          // whether to destroy-and-rebuild on charge-state flip.
          grp.userData.atCharger = isCharging;

          padScene.add(grp);
          padApronGroups[design.id] = grp;
          } catch (err) {
            console.warn('[apron] forEach failed for', design?.id, err);
          }
        });
      }

      function animateDispatchedFlight(flight) {
        const svg = document.getElementById('pad-map');
        if (!svg) return;
        // Use the hoisted MAP_* constants so we project the drone marker into
        // the SAME coordinate space as renderDispatchMap. Without this, the
        // drone icon ends up at a different Y than the static hub orange dot
        // at elapsed=0, making it look like the drone is starting from
        // somewhere other than the hub.
        const VIEW_W = MAP_VIEW_W, VIEW_H = MAP_VIEW_H;
        const CENTER = MAP_CENTER;
        const VIEW_PAD = MAP_VIEW_PAD;
        let maxAbsX_m = 0, maxAbsZ_m = 0;
        for (const pos of Object.values(PAD_GEOGRAPHY)) {
          if (Math.abs(pos.x) > maxAbsX_m) maxAbsX_m = Math.abs(pos.x);
          if (Math.abs(pos.z) > maxAbsZ_m) maxAbsZ_m = Math.abs(pos.z);
        }
        const availW_m = (VIEW_W - VIEW_PAD * 2) / 2;
        const availH_m = (VIEW_H - VIEW_PAD * 2) / 2;
        const MAP_SCALE = Math.min(availW_m / Math.max(maxAbsX_m, 1), availH_m / Math.max(maxAbsZ_m, 1));
        const SITES = {};
        for (const [name, pos] of Object.entries(PAD_GEOGRAPHY)) {
          SITES[name] = {
            x: CENTER.x + pos.x * MAP_SCALE,
            y: CENTER.y + pos.z * MAP_SCALE
          };
        }
        // Build a top-down aircraft silhouette — looks like an eVTOL with 4 rotor disks +
        // a tinted body, so the user can see the actual designed aircraft "flying" rather
        // than a generic dot. Wrapped in a sub-group so we can rotate it to face direction.
        const flightG = document.createElementNS('http://www.w3.org/2000/svg', 'g');
        flightG.setAttribute('class', 'flight-marker');
        // The inner group is what we rotate to point in the direction of travel
        const aircraftG = document.createElementNS('http://www.w3.org/2000/svg', 'g');
        aircraftG.setAttribute('class', 'flight-aircraft');
        aircraftG.innerHTML = `
          <!-- Soft glow halo -->
          <circle r="11" fill="#00E5FF" opacity="0.15"/>
          <!-- Fuselage body (oval, points "up" in local coords = forward) -->
          <ellipse cx="0" cy="0" rx="3" ry="6" fill="#9bd4f0" stroke="#00E5FF" stroke-width="0.6"/>
          <!-- Rotor disks at four corners — give the eVTOL silhouette -->
          <g class="flight-rotors">
            <circle cx="-5" cy="-3.5" r="2.4" fill="rgba(0,229,255,0.4)" stroke="#00E5FF" stroke-width="0.5"/>
            <circle cx="5"  cy="-3.5" r="2.4" fill="rgba(0,229,255,0.4)" stroke="#00E5FF" stroke-width="0.5"/>
            <circle cx="-5" cy="3.5"  r="2.4" fill="rgba(0,229,255,0.4)" stroke="#00E5FF" stroke-width="0.5"/>
            <circle cx="5"  cy="3.5"  r="2.4" fill="rgba(0,229,255,0.4)" stroke="#00E5FF" stroke-width="0.5"/>
          </g>
          <!-- Center hub dot -->
          <circle cx="0" cy="0" r="1.2" fill="#fff"/>
          <!-- Forward indicator (small triangle at the nose) -->
          <path d="M 0 -7.5 L -1.6 -5.5 L 1.6 -5.5 Z" fill="#fff"/>
        `;
        flightG.appendChild(aircraftG);
        // Tail label
        const labelEl = document.createElementNS('http://www.w3.org/2000/svg', 'text');
        labelEl.setAttribute('y', '-13');
        labelEl.setAttribute('text-anchor', 'middle');
        labelEl.setAttribute('fill', '#00E5FF');
        labelEl.setAttribute('font-family', 'JetBrains Mono');
        labelEl.setAttribute('font-size', '8');
        labelEl.textContent = flight.tail;
        flightG.appendChild(labelEl);
        svg.appendChild(flightG);
        flight.markerEl = flightG;

        // Full mission cycle: HUB → pickup → dropoff → HUB (return for charging)
        const hub     = SITES[MAIN_HUB_NAME];
        const pickup  = SITES[flight.from] || hub;
        const dropoff = SITES[flight.to]   || hub;

        // Use the shared phase array attached to the flight by dispatchSelectedOrder.
        // This is the SAME array driving the 3D scene — both views stay in lockstep
        // regardless of trip distance.
        const phases = flight.phases || [];
        // Convert phase durations from seconds to milliseconds and build cumulative
        // timeline for fast lookup at each frame.
        const PHASE_MS = phases.map(p => p.dur * 1000);
        const cumulative = [];
        let acc = 0;
        for (const ms of PHASE_MS) { acc += ms; cumulative.push(acc); }
        const TOTAL_MS = acc;

        // Map each 2D phase to its from/to pads (must match 3D phase order
        // from computeMissionPhases). The mission now has 13 phases including
        // explicit preflight + vertical climb/descent. The 2D map shows the
        // drone "at" the location during these phases (no horizontal motion):
        //  0: preflight@hub          1: vertical_climb@hub
        //  2: hub→pickup (cruise)    3: vertical_descent@pickup
        //  4: hover@pickup (board)   5: vertical_climb@pickup
        //  6: pickup→dropoff         7: vertical_descent@dropoff
        //  8: hover@dropoff          9: vertical_climb@dropoff
        // 10: dropoff→hub            11: vertical_descent@hub
        // 12: docked@hub
        const phaseRoutes = [
          { from: hub,     to: hub,     hovering: true,  label: () => `${flight.tail} preflight checks at ${MAIN_HUB_NAME} · spooling rotors` },
          { from: hub,     to: hub,     hovering: true,  label: () => `${flight.tail} vertical climb · ${MAIN_HUB_NAME}` },
          { from: hub,     to: pickup,  hovering: false, label: () => `${flight.tail} → pickup at ${flight.from}` },
          { from: pickup,  to: pickup,  hovering: true,  label: () => `${flight.tail} vertical descent · ${flight.from} approach` },
          { from: pickup,  to: pickup,  hovering: true,  label: () => `${flight.tail} boarding ${flight.customer} at ${flight.from}` },
          { from: pickup,  to: pickup,  hovering: true,  label: () => `${flight.tail} vertical climb · departing ${flight.from}` },
          { from: pickup,  to: dropoff, hovering: false, label: () => `${flight.tail} → dropoff at ${flight.to} · passenger onboard` },
          { from: dropoff, to: dropoff, hovering: true,  label: () => `${flight.tail} vertical descent · ${flight.to} approach` },
          { from: dropoff, to: dropoff, hovering: true,  label: () => `${flight.tail} disembarking ${flight.customer} at ${flight.to}` },
          { from: dropoff, to: dropoff, hovering: true,  label: () => `${flight.tail} vertical climb · departing ${flight.to}` },
          { from: dropoff, to: hub,     hovering: false, label: () => `${flight.tail} returning to ${MAIN_HUB_NAME} for charging` },
          { from: hub,     to: hub,     hovering: true,  label: () => `${flight.tail} vertical descent · ${MAIN_HUB_NAME} approach` },
          { from: hub,     to: hub,     hovering: true,  label: () => `${flight.tail} docked at ${MAIN_HUB_NAME} · charging` }
        ];

        const startTime = performance.now();
        flight.startTime = startTime;
        flight.active = true;

        // Smooth-step curve (matches 3D motion in tickPad) — zero velocity at endpoints,
        // peak velocity in the middle. So 2D map and 3D scene have identical motion curves.
        const ease = (x) => x * x * (3 - 2 * x);

        const animate = () => {
          if (!flight.active) return;
          // Apply time scale so user can fast-forward
          const elapsed = (performance.now() - startTime) * padTimeScale;

          // Find which phase we're in
          if (elapsed >= TOTAL_MS) {
            // Mission complete — full cycle finished
            flight.active = false;
            const order = padChatOrders.find(o => o.id === flight.orderId);
            if (order) order.status = 'completed';
            // Record the flight in persistent storage — increments the global
            // total counter and pushes an entry onto this design's per-aircraft
            // log. The hangar panel + splash counter pick this up next render.
            try {
              recordFlightCompletion({
                designId: flight.designId,
                tail: flight.tail,
                from: flight.from,
                to: flight.to,
                customer: flight.customer,
                totalMiles: flight.totalMiles || 0,
                durSec: TOTAL_MS / 1000,
              });
              // Ops crew chatter — operations logs the landing, ground
              // crew sometimes follows up with the turnaround.
              try {
                if (typeof window.__opsCrewLogCompletion === 'function') {
                  window.__opsCrewLogCompletion(flight.tail || 'SDX-####', flight.to, flight.designId);
                }
              } catch (_) { /* crew sim must not break completion bookkeeping */ }
            } catch (e) { console.warn('flight log record failed:', e); }
            // Fade out then remove the marker
            flightG.style.transition = 'opacity 0.6s';
            flightG.style.opacity = '0';
            setTimeout(() => { flightG.remove(); }, 700);
            renderChatFeed();
            renderFleetRoster();
            const statusEl = document.getElementById('pad-map-status');
            if (statusEl) statusEl.innerHTML = `<span style="color:#4ade80">✓ ${escapeHtml(flight.tail)} mission complete · charged at ${MAIN_HUB_NAME} · ready for next dispatch</span>`;

            // Customer mode cleanup: if this was the customer's flight,
            // exit cabin (if still in it), hide board prompt, and clear the
            // customer-mode flags so a fresh dispatch behaves normally.
            if (window.__customerModeActive && flight.designId === window.__customerAircraftId) {
              if (window.__customerModeState && window.__customerModeState.inCabin &&
                  typeof window.__exitCabinView === 'function') {
                window.__exitCabinView();
              }
              const prompt = document.getElementById('cabin-board-prompt');
              if (prompt) prompt.classList.remove('active');
              window.__customerModeActive = false;
              window.__customerPickup = null;
              window.__customerDropoff = null;
              window.__customerAircraftId = null;
              window.__customerGroundPos = null;
              window.__customerPickupLocked = false;
              if (window.__customerModeState) window.__customerModeState.stage = null;
              // Hide the re-hail button — mission is done, customer flow
              // ends here. (If the user wanted another ride they'd have
              // hit the button while at dropoff, before this cleanup.)
              const rehailBtn = document.getElementById('customer-rehail-btn');
              if (rehailBtn) rehailBtn.hidden = true;
              // Restore default fog so subsequent operator-mode dispatches
              // get the wide-view (silhouettes-on-horizon) atmosphere.
              if (padScene && padScene.fog) {
                padScene.fog.near = 80;
                padScene.fog.far = 550;
              }
              // Close & reset SMS chat — operator session is over
              try {
                if (typeof window.__customerChatClose === 'function') window.__customerChatClose();
                if (typeof window.__customerChatReset === 'function') window.__customerChatReset();
              } catch (err) { console.warn('[customer chat] close failed:', err); }
              // Stop the AI fleet manager — no more AI dispatches after
              // the user's mission ends. Any in-flight AI taxis finish
              // their current missions naturally; we just stop SPAWNING
              // new ones.
              try {
                if (typeof window.__stopAiFleetManager === 'function') window.__stopAiFleetManager();
              } catch (_) {}
            }
            return;
          }

          let phaseIdx = 0;
          let phaseStart = 0;
          for (let i = 0; i < cumulative.length; i++) {
            if (elapsed < cumulative[i]) { phaseIdx = i; phaseStart = i === 0 ? 0 : cumulative[i - 1]; break; }
          }
          // Phase-transition detection — tick CUSTOMER FLIGHTS counter
          // when entering a phase marked customerDelivered:true (the
          // disembark hover for single-stop, plus any additional
          // dropoff phases for multistop missions). flight._lastPhaseIdx
          // tracks the previous frame's phase so we tick exactly once
          // per phase entry, regardless of frame rate or padTimeScale.
          if (phaseIdx !== flight._lastPhaseIdx) {
            const enteredPhase = phases[phaseIdx];
            if (enteredPhase && enteredPhase.customerDelivered) {
              try {
                if (typeof incrementCustomerFlights === 'function') {
                  incrementCustomerFlights();
                }
              } catch (_) { /* counter best-effort */ }
            }
            flight._lastPhaseIdx = phaseIdx;
          }
          const route = phaseRoutes[phaseIdx];
          const phaseDur = PHASE_MS[phaseIdx];
          const localT = phaseDur > 0 ? (elapsed - phaseStart) / phaseDur : 0;
          const t = route.hovering ? 0 : ease(localT);
          const remainingS = Math.max(0, Math.round((cumulative[phaseIdx] - elapsed) / 1000));
          const statusText = route.hovering
            ? route.label()
            : `${route.label()} (${remainingS}s)`;

          const x = route.from.x + (route.to.x - route.from.x) * t;
          const y = route.from.y + (route.to.y - route.from.y) * t;

          // Heading angle — face direction of travel (only during cruise)
          let angleDeg = 0;
          if (!route.hovering) {
            const dx = route.to.x - route.from.x;
            const dy = route.to.y - route.from.y;
            angleDeg = Math.atan2(dy, dx) * 180 / Math.PI + 90;
          }
          flightG.setAttribute('transform', `translate(${x}, ${y})`);
          aircraftG.setAttribute('transform', `rotate(${angleDeg})`);

          // Update map status
          const statusEl = document.getElementById('pad-map-status');
          if (statusEl) statusEl.innerHTML = `<span class="status-current">▸</span> ${escapeHtml(statusText)}`;
          requestAnimationFrame(animate);
        };
        animate();
      }

      // Dispatch the selected order with the selected aircraft
      // Map pad name → 3D world coordinates (relative to hub at origin, in MILES).
      // 1 scene unit = 1 mile. All pads are at minimum 8 miles from the hub so
      // they're visually distinct from it; the longest mission is ~120 miles round trip.
      // ============================================================================
      // MULTI-REGION GEOGRAPHY
      //
      // Three regions, each with a single MAIN HUB at (0,0) and a set of
      // ULTRA-LONG-RANGE cities — every destination sits at minimum 150 miles
      // from the hub. Closer pads were removed because at 1 unit = 1 mile,
      // anything within ~100mi of the hub renders as visible buildings, which
      // destroys the "hub is alone in a clearing, cities are silhouettes on
      // the horizon" effect. With the 150mi floor + atmospheric fog, the
      // closest city renders as a faint silhouette and far cities (400+mi)
      // are barely visible against the sky. 1 world unit = 1 mile.
      //
      // NOTE: REGIONS is now declared at OUTER (script-tag) scope above so the
      // customer-mode controller can see it without depending on
      // initManufacturing() having run first. We just reference it here.
      // ============================================================================
      // (REGIONS is hoisted — see top of script tag)

      // Active region — defaults to SF BAY (the original) so existing flows
      // continue to work without breakage. User can switch via region selector.
      let currentRegionKey = 'SF BAY';

      // PAD_GEOGRAPHY is a derived view of the current region, keyed by pad name.
      // We keep the variable for backward compatibility — any existing code that
      // reads PAD_GEOGRAPHY[name] still works after a region switch.
      let PAD_GEOGRAPHY = REGIONS[currentRegionKey].pads;
      let MAIN_HUB_NAME = REGIONS[currentRegionKey].hubName;

      function setActiveRegion(key) {
        if (!REGIONS[key]) return false;
        currentRegionKey = key;
        PAD_GEOGRAPHY = REGIONS[key].pads;
        MAIN_HUB_NAME = REGIONS[key].hubName;
        // Sync the outer-scope mirror that the customer-mode controller reads
        window.__sdxCurrentRegionKey = key;
        return true;
      }

      function pad3DCoord(padName) {
        if (PAD_GEOGRAPHY[padName]) return { ...PAD_GEOGRAPHY[padName] };
        // Fallback for unknown names — derive from string hash
        let h = 0;
        for (let i = 0; i < padName.length; i++) h = ((h << 5) - h) + padName.charCodeAt(i);
        const angle = (Math.abs(h) % 360) * Math.PI / 180;
        const dist = 15 + (Math.abs(h >> 8) % 200) / 10;
        return { x: Math.cos(angle) * dist, z: Math.sin(angle) * dist };
      }


      // Compute mission duration based on real distances.
      // Tuned for BVLOS long-range dispatch (up to 100mi one-way), not metro
      // taxi hops. Cruise speeds reflect advanced eVTOL targets — faster than
      // current production aircraft (~200 mph), closer to where the technology
      // is heading for autonomous long-haul.
      // Effective scaled speed: configurable via padTimeScale (1× = real time, higher = faster).
      function computeMissionPhases(pickupName, dropoffName) {
        const hub = pad3DCoord(MAIN_HUB_NAME);
        const pickup = pad3DCoord(pickupName);
        const dropoff = pad3DCoord(dropoffName);
        const dist = (a, b) => Math.hypot(a.x - b.x, a.z - b.z);
        const milesToPickup = dist(hub, pickup);
        const milesToDropoff = dist(pickup, dropoff);
        const milesReturn = dist(dropoff, hub);
        const totalMiles = milesToPickup + milesToDropoff + milesReturn;
        // Speeds calibrated for advanced BVLOS-capable eVTOL:
        //   - Empty (cargo deadhead / return) cruises at ~327 mph
        //   - Loaded (passenger leg) cruises at ~257 mph (slower for comfort)
        //   - Accel/decel buffer is fixed per leg and matters less proportionally
        //     on long legs, so 100mi flights spend 95%+ of their time at full cruise.
        // Any leg ≥30 miles is flagged BVLOS in the status display so the user
        // knows the aircraft is operating beyond visual line-of-sight under
        // autonomous remote-piloted authority.
        const ACCEL_DECEL_SEC = 8;
        const CRUISE_SEC_PER_MILE_EMPTY     = 11;
        const CRUISE_SEC_PER_MILE_PASSENGER = 14;
        const BVLOS_THRESHOLD_MILES = 30;
        const legDuration = (miles, secPerMile) => ACCEL_DECEL_SEC + miles * secPerMile;
        const cruise1 = legDuration(milesToPickup,  CRUISE_SEC_PER_MILE_EMPTY);
        const cruise2 = legDuration(milesToDropoff, CRUISE_SEC_PER_MILE_PASSENGER);
        const cruise3 = legDuration(milesReturn,    CRUISE_SEC_PER_MILE_EMPTY);
        const avgMph = (miles, dur) => Math.round((miles / dur) * 3600);
        const tag = (miles) => miles >= BVLOS_THRESHOLD_MILES ? ' · BVLOS' : '';

        // Preflight + takeoff phases. Real eVTOLs don't blink into the air —
        // they spin up rotors, pause for systems checks, then lift vertically
        // before transitioning to forward flight. We model this with three
        // pre-cruise phases so the user sees the aircraft prepare and lift
        // off naturally instead of jumping straight to cruise altitude.
        //
        //   preflight:        rotors spool up, no movement, no altitude change
        //   vertical_climb:   pure vertical lift from pad to cruise altitude
        //   cruise (flat):    horizontal-only at cruise altitude
        //   vertical_descent: pure vertical drop from cruise to pad (at landing)
        //
        // CRITICAL TIMING NOTE: padTimeScale (60×) compresses mission seconds
        // into visible seconds — a 5-mission-second phase plays in 0.083 visible
        // seconds, which makes vertical climbs look like rocket launches. To
        // make takeoff/landing PERCEIVABLE in real time, we inflate vertical
        // phase durations by ~padTimeScale so they expand to ~6-8 visible
        // seconds of motion. Cruise legs can stay heavily compressed (a
        // 50-mile leg at 11s/mile = 550 mission-sec compresses to ~9 visible
        // seconds, perfect). Vertical phases must NOT be heavily compressed
        // because the user is watching the aircraft physically lift off.
        //
        // Battery drain uses real-time dt (not phase.dur) so inflating these
        // durations does NOT change battery math.
        const PREFLIGHT_SEC    = 360;   // ~6 visible sec at 60× (rotor spool-up)
        const VERT_CLIMB_SEC   = 480;   // ~8 visible sec at 60× (slow lift-off)
        const VERT_DESCENT_SEC = 540;   // ~9 visible sec at 60× (deliberate touchdown — slower than climb)
        // Hover phases (boarding + disembarking) need REAL visible time so
        // the user can register the prompt and press E. At 60× compression
        // the old 80 mission-sec hover ran for 1.33 visible seconds —
        // not enough to read "PRESS E TO BOARD" let alone act on it.
        // 600 mission-sec = 10 visible sec at 60× — comfortable room to
        // see the taxi land, see the prompt, and press E.
        const HOVER_PICKUP_SEC   = 600;   // ~10 visible sec at 60× (boarding window)
        const HOVER_DROPOFF_SEC  = 600;   // ~10 visible sec at 60× (disembark window)

        // Cruise legs are NOT reduced by these inflated durations — the
        // vertical phases run on a separate visible-time budget. Cruise leg
        // duration still encodes flight distance, which battery drain reads.
        const cruise1Net = cruise1;
        const cruise2Net = cruise2;
        const cruise3Net = cruise3;

        return {
          totalMiles,
          milesToPickup,
          milesToDropoff,
          milesReturn,
          phases: [
            // Pre-takeoff: rotor spool-up, no movement, no altitude
            { kind: 'preflight',      from: hub,    to: hub,     dur: PREFLIGHT_SEC,    label: 'preflight checks · spooling rotors' },
            // Vertical lift to cruise altitude (no horizontal motion)
            { kind: 'vertical_climb', from: hub,    to: hub,     dur: VERT_CLIMB_SEC,   label: 'vertical climb to cruise altitude' },
            // Forward flight at cruise altitude (no climb/descent — already up)
            { kind: 'cruise',         from: hub,    to: pickup,  dur: cruise1Net, miles: milesToPickup,  label: `outbound to pickup (${milesToPickup.toFixed(1)} mi @ avg ${avgMph(milesToPickup, cruise1)} mph${tag(milesToPickup)})`, withPassenger: false, levelFlight: true },
            // Vertical descent at pickup
            { kind: 'vertical_descent', from: pickup, to: pickup, dur: VERT_DESCENT_SEC, label: 'vertical descent · pickup approach' },
            // Hover for boarding
            { kind: 'hover',          from: pickup, to: pickup,  dur: HOVER_PICKUP_SEC, label: 'boarding passenger' },
            // Vertical climb again
            { kind: 'vertical_climb', from: pickup, to: pickup,  dur: VERT_CLIMB_SEC,   label: 'vertical climb · departing pickup' },
            // Cruise to dropoff
            { kind: 'cruise',         from: pickup, to: dropoff, dur: cruise2Net, miles: milesToDropoff, label: `en route to dropoff (${milesToDropoff.toFixed(1)} mi @ avg ${avgMph(milesToDropoff, cruise2)} mph${tag(milesToDropoff)})`, withPassenger: true, levelFlight: true },
            // Vertical descent at dropoff
            { kind: 'vertical_descent', from: dropoff, to: dropoff, dur: VERT_DESCENT_SEC, label: 'vertical descent · dropoff approach' },
            // Hover for disembark — CUSTOMER FLIGHTS counter ticks
            // when the 2D animator enters this phase (one increment
            // per customer delivered). Multistop missions would add
            // more pickup→hover@dropoff→climb segments, each carrying
            // customerDelivered: true so the customer counter ticks
            // once per delivery.
            { kind: 'hover',          from: dropoff, to: dropoff, dur: HOVER_DROPOFF_SEC, label: 'disembarking', customerDelivered: true },
            // Vertical climb to head home
            { kind: 'vertical_climb', from: dropoff, to: dropoff, dur: VERT_CLIMB_SEC,   label: 'vertical climb · departing dropoff' },
            // Cruise back to hub
            { kind: 'cruise',         from: dropoff, to: hub,    dur: cruise3Net, miles: milesReturn,    label: `returning to hub (${milesReturn.toFixed(1)} mi @ avg ${avgMph(milesReturn, cruise3)} mph${tag(milesReturn)})`, withPassenger: false, levelFlight: true },
            // Final vertical descent at hub apron
            { kind: 'vertical_descent', from: hub,  to: hub,     dur: VERT_DESCENT_SEC, label: 'vertical descent · hub approach' },
            // Charging
            { kind: 'docked',         from: hub,    to: hub,     dur: 32,      label: 'docked, charging' }
          ]
        };
      }

      // Build a destination pad marker at a 3D position — simple lit landing platform
      // so the user can SEE where the aircraft is going. Returns the THREE.Group.
      function buildDestinationPad(name, color = 0x4ade80) {
        const grp = new THREE.Group();
        // NO PLATFORM — destination markers are now just a vertical beam of
        // light + a glow ring at ground level, so the user can see WHERE the
        // aircraft is going without painted pads cluttering the terrain.
        // Ground glow ring (no disc beneath it)
        const ringG = new THREE.Mesh(
          new THREE.TorusGeometry(0.6, 0.025, 6, 24),
          new THREE.MeshStandardMaterial({ color, emissive: color, emissiveIntensity: 1.6, transparent: true, opacity: 0.65 })
        );
        ringG.rotation.x = -Math.PI / 2;
        ringG.position.y = 0.005;       // hairline above ground, no z-fighting
        grp.add(ringG);
        // Center beacon — bright spot
        const beacon = new THREE.PointLight(color, 1.2, 4);
        beacon.position.y = 0.5;
        grp.add(beacon);
        // Vertical column of light shooting up — visible from far away
        const beam = new THREE.Mesh(
          new THREE.CylinderGeometry(0.04, 0.04, 6, 8),
          new THREE.MeshBasicMaterial({ color, transparent: true, opacity: 0.4 })
        );
        beam.position.y = 3;
        grp.add(beam);
        return grp;
      }

      // Build a small humanoid customer figure (capsule body + sphere head)
      // Articulated humanoid for the customer figure. Body parts are organized
      // as nested Groups so we can rotate joints (hips, knees, shoulders) to
      // pose between STANDING (walking on ground) and SITTING (in the seat).
      //
      // Skeleton: figure-root → torso (at hip) → head, shoulders, hipPivots
      //   torso     anchored at hip-height
      //   head      sphere on top of torso
      //   shoulderL/R   small spheres + arm pivot groups
      //   armL/R    upper-arm Group → forearm Group (rotates at elbow)
      //   hipL/R    pivot Group → thigh mesh + knee Group → shin mesh
      //
      // The figure's GROUP ORIGIN is at the FEET of a STANDING pose. When
      // sitting, the hips lift slightly (we pose at the hip-pivots), so the
      // group origin still aligns with where the feet would naturally be.
      function buildCustomerFigure() {
        const grp = new THREE.Group();
        const skinMat = new THREE.MeshStandardMaterial({ color: 0xe8c8a0, roughness: 0.7 });
        const shirtMat = new THREE.MeshStandardMaterial({ color: 0x6a9bd6, roughness: 0.85 });   // light blue shirt
        const pantsMat = new THREE.MeshStandardMaterial({ color: 0x3a4f70, roughness: 0.85 });   // navy pants
        const shoeMat  = new THREE.MeshStandardMaterial({ color: 0x2a1810, roughness: 0.6 });    // dark brown shoes

        // --- Skeleton dimensions (rough realistic proportions, scaled to figure ~0.5u tall) ---
        const HIP_Y      = 0.22;     // hip height (where legs meet torso) when standing
        const TORSO_LEN  = 0.18;     // hip-to-shoulder
        const HEAD_R     = 0.06;
        const NECK_LEN   = 0.04;
        const UPPER_ARM  = 0.11;
        const FOREARM    = 0.10;
        const THIGH_LEN  = 0.13;
        const SHIN_LEN   = 0.13;
        const SHOULDER_W = 0.11;     // half-width across shoulders
        const HIP_W      = 0.07;     // half-width across hips

        // === TORSO (anchored at hips) ===
        // The torso group sits at hip height. Sitting: torso stays at the same
        // height (we lift the WHOLE figure up so feet hang properly).
        const torso = new THREE.Group();
        torso.position.y = HIP_Y;
        grp.add(torso);
        const torsoMesh = new THREE.Mesh(
          new THREE.CapsuleGeometry(0.08, TORSO_LEN - 0.04, 4, 8),
          shirtMat
        );
        torsoMesh.position.y = TORSO_LEN / 2;
        torsoMesh.castShadow = true;
        torso.add(torsoMesh);

        // === HEAD ===
        const head = new THREE.Mesh(new THREE.SphereGeometry(HEAD_R, 14, 12), skinMat);
        head.position.y = TORSO_LEN + NECK_LEN + HEAD_R * 0.7;
        head.castShadow = true;
        torso.add(head);

        // === ARMS — pivot at shoulder, elbow joint between upper/forearm ===
        function makeArm(side) {
          const shoulder = new THREE.Group();
          shoulder.position.set(side * SHOULDER_W, TORSO_LEN, 0);
          // Upper arm — pivot is the shoulder; mesh hangs DOWN from it
          const upperArm = new THREE.Mesh(
            new THREE.CapsuleGeometry(0.025, UPPER_ARM - 0.015, 3, 6),
            shirtMat
          );
          upperArm.position.y = -UPPER_ARM / 2;
          upperArm.castShadow = true;
          shoulder.add(upperArm);
          // Elbow group — pivot at the elbow, holds forearm + hand
          const elbow = new THREE.Group();
          elbow.position.y = -UPPER_ARM;
          shoulder.add(elbow);
          const forearm = new THREE.Mesh(
            new THREE.CapsuleGeometry(0.022, FOREARM - 0.015, 3, 6),
            skinMat
          );
          forearm.position.y = -FOREARM / 2;
          forearm.castShadow = true;
          elbow.add(forearm);
          // Hand
          const hand = new THREE.Mesh(new THREE.SphereGeometry(0.025, 8, 6), skinMat);
          hand.position.y = -FOREARM - 0.01;
          hand.castShadow = true;
          elbow.add(hand);
          return { shoulder, elbow };
        }
        const armL = makeArm(-1);
        const armR = makeArm(+1);
        torso.add(armL.shoulder, armR.shoulder);

        // === LEGS — hip pivot at top, knee pivot mid-thigh ===
        function makeLeg(side) {
          const hip = new THREE.Group();
          hip.position.set(side * HIP_W, 0, 0);
          // Thigh — pivot at hip; mesh hangs DOWN
          const thigh = new THREE.Mesh(
            new THREE.CapsuleGeometry(0.035, THIGH_LEN - 0.02, 3, 6),
            pantsMat
          );
          thigh.position.y = -THIGH_LEN / 2;
          thigh.castShadow = true;
          hip.add(thigh);
          // Knee group — pivot at the knee
          const knee = new THREE.Group();
          knee.position.y = -THIGH_LEN;
          hip.add(knee);
          // Shin
          const shin = new THREE.Mesh(
            new THREE.CapsuleGeometry(0.030, SHIN_LEN - 0.02, 3, 6),
            pantsMat
          );
          shin.position.y = -SHIN_LEN / 2;
          shin.castShadow = true;
          knee.add(shin);
          // Foot
          const foot = new THREE.Mesh(
            new THREE.BoxGeometry(0.06, 0.025, 0.085),
            shoeMat
          );
          foot.position.set(0, -SHIN_LEN - 0.01, 0.025);
          foot.castShadow = true;
          knee.add(foot);
          return { hip, knee };
        }
        const legL = makeLeg(-1);
        const legR = makeLeg(+1);
        torso.add(legL.hip, legR.hip);

        // === SUITCASE (visible while walking, hidden while seated) ===
        const bag = new THREE.Mesh(
          new THREE.BoxGeometry(0.06, 0.10, 0.05),
          new THREE.MeshStandardMaterial({ color: 0x1a2840, roughness: 0.6 })
        );
        bag.position.set(0.10, 0.10, 0);
        bag.castShadow = true;
        grp.add(bag);

        // === POSE CONTROL ===
        // Apply standing or sitting pose by rotating joint Groups.
        // STANDING:
        //   - hips: rotation 0 (legs straight down)
        //   - knees: rotation 0 (shins straight down)
        //   - shoulders: small inward rotation (arms hang naturally)
        // SITTING (from reference image):
        //   - hips rotated +90° around X (thighs forward, parallel to ground)
        //   - knees rotated -90° (shins back down to ground)
        //   - shoulders forward + elbows bent so hands rest on lap
        function applyPose(sitting) {
          if (sitting) {
            // Thighs forward (rotate hip +π/2 around X axis = thighs rotate 90°
            // toward +Z which is "forward" in the figure's local frame)
            legL.hip.rotation.x = Math.PI / 2;
            legR.hip.rotation.x = Math.PI / 2;
            // Knees bend so shins point down again (relative to thigh, rotate -π/2)
            legL.knee.rotation.x = -Math.PI / 2;
            legR.knee.rotation.x = -Math.PI / 2;
            // Arms: shoulders rotate forward slightly, elbows bend so forearms
            // rest across the lap. Hands ~1/3 down the thigh.
            armL.shoulder.rotation.x = Math.PI / 3;       // 60° forward
            armR.shoulder.rotation.x = Math.PI / 3;
            armL.shoulder.rotation.z = -0.15;             // slight inward
            armR.shoulder.rotation.z =  0.15;
            armL.elbow.rotation.x = -Math.PI / 2.5;       // forearms across lap
            armR.elbow.rotation.x = -Math.PI / 2.5;
            // Hide suitcase while seated (passenger has stowed it)
            bag.visible = false;
          } else {
            // Standing — straight limbs
            legL.hip.rotation.set(0, 0, 0);
            legR.hip.rotation.set(0, 0, 0);
            legL.knee.rotation.set(0, 0, 0);
            legR.knee.rotation.set(0, 0, 0);
            armL.shoulder.rotation.set(0, 0, -0.08);
            armR.shoulder.rotation.set(0, 0,  0.08);
            armL.elbow.rotation.set(0, 0, 0);
            armR.elbow.rotation.set(0, 0, 0);
            bag.visible = true;
          }
        }
        // Default: standing
        applyPose(false);
        // Expose pose toggle on userData so the boarding animation can call it
        grp.userData.setSittingPose = applyPose;
        // Track current pose so we don't keep re-applying every frame
        grp.userData.isSitting = false;

        return grp;
      }

      function dispatchSelectedOrder() {
        // Dispatch hold — set by /hold slash command, cleared by /resume.
        // User: "execute with a confirm tap" — when held, dispatch is
        // blocked until the user explicitly resumes. The crew also posts
        // an acknowledgement to the chat feed when the gate fires.
        if (typeof window !== 'undefined' && window.__dispatchHold) {
          alert('Dispatch is on HOLD. Type /resume in the crew chat to lift the hold.');
          return;
        }
        const order = padSelectedOrder;
        const aircraft = padSelectedAircraft;
        if (!order) {
          alert('Select a customer order first (click one in the INCOMING ORDERS panel).');
          return;
        }
        if (!aircraft) {
          alert('Select an aircraft from the FLEET ROSTER first.');
          return;
        }
        if (order.status !== 'pending') {
          alert('This order is already dispatched.');
          return;
        }
        // Charge gate — block dispatch until the selected aircraft reaches 95%
        // (AIAA spec MAX_SOC). Real eVTOL operators wait for full charge before
        // releasing an aircraft for the next mission to maintain reserve and
        // protect Li-ion cell life. The aircraft's persistent battery state is
        // tracked in padDesignBatteries (Map<designId, {battery, isCharging, ...}>).
        // Use the same epsilon (0.05%) the launch button uses to avoid
        // floating-point drift blocking dispatch when the user sees "95%".
        const batt = padDesignBatteries.get(aircraft.id)?.battery ?? 95;
        if (batt < 95 - 0.05) {
          alert(
            `${aircraft.tail} is at ${batt.toFixed(1)}% charge.\n\n` +
            `Per operating procedure, aircraft must be at 95% State of Charge ` +
            `before next dispatch. Wait for charging to complete or select a ` +
            `different aircraft from the roster.`
          );
          return;
        }
        // Also block if aircraft is currently in flight (a different design
        // sharing the same tail # could pass the charge check above otherwise)
        if (padFlightStates.some(f => f && f.active && f.designId === aircraft.id)) {
          alert(`${aircraft.tail} is already in flight. Select a different aircraft.`);
          return;
        }
        // Mark order as dispatched, assign aircraft
        order.status = 'dispatched';
        order.assignedTail = aircraft.tail;
        order.assignedAircraft = aircraft.name;
        // Get current pad
        const padEl = document.getElementById('pad-location');
        const padOrigin = padEl?.textContent || 'EMBARCADERO-7';

        // Compute mission phases FIRST — both 2D and 3D animations read the same data
        // so they stay perfectly synchronized regardless of trip distance.
        const mission = computeMissionPhases(order.from, order.to);

        // ===== FAULT INJECTION =====
        // User: "lets add failures going from navigation only when the
        // taxi is on the way to pickup the customer for now. add random
        // failures that cause the air taxi to return back mainly motor
        // outs, and other critical failures. the failure rate should
        // be proportional to the fleet count. but not high, not low
        // like 3-5%."
        //
        // Only customer flights are eligible for fault injection right
        // now (per user "going from navigation only when the taxi is
        // on the way to pickup the customer for now"). The failure
        // manifests during the outbound-to-pickup cruise — partial
        // progress, then abort and return to hub. Customer never gets
        // picked up; the operator counter still tickets the dispatch
        // but the customer counter does NOT (no dropoff occurred).
        const isCustomerFlight = (typeof window !== 'undefined' &&
                                  window.__customerModeActive &&
                                  aircraft.id === window.__customerAircraftId);
        let injectedFailure = null;
        if (isCustomerFlight && typeof window !== 'undefined' && typeof window.__rollFlightFailure === 'function') {
          try {
            const fleetSize = (typeof getAllSavedDesigns === 'function')
              ? getAllSavedDesigns().length : 0;
            injectedFailure = window.__rollFlightFailure(fleetSize);
            if (injectedFailure) {
              window.__applyFailureToMission(mission, injectedFailure);
            }
          } catch (e) { /* fault injection is best-effort; never block dispatch */ }
        }

        // Create flight record (phases attached so 2D animation can read them)
        const flight = {
          orderId: order.id,
          tail: aircraft.tail,
          designId: aircraft.id,            // lets the roster lock the right design,
                                            // not every design that shares a tail number
          aircraft: aircraft.name,
          customer: order.customer,
          padOrigin: padOrigin,
          from: order.from,
          to: order.to,
          phases: mission.phases,
          totalMiles: mission.totalMiles,
          active: true,                      // explicit flag so renderFleetRoster filter is reliable
          // If a failure was injected, the flight carries it so the UI
          // can announce it when the abort phase begins.
          failure: injectedFailure,
        };
        padDispatchedFlights.push(flight);
        // Animate the 2D map marker (uses flight.phases for sync)
        animateDispatchedFlight(flight);

        // ===== Set up 3D flight state =====
        const hub3D     = pad3DCoord(MAIN_HUB_NAME);
        const pickup3D  = pad3DCoord(order.from);
        const dropoff3D = pad3DCoord(order.to);

        // Destination pads (pickup green + dropoff amber) PERSIST across
        // missions — once a pad is placed at a destination, it stays visible
        // for subsequent flights. Stored in padDestinationPads keyed by
        // destination name so a second flight to the same destination doesn't
        // duplicate the marker. Only the customer figure is per-mission
        // (gets removed at completion since the customer leaves with the
        // aircraft on pickup).
        const sceneAdds = [];     // tracks only THIS-flight transient items (customer figure)
        let customerFigure = null;
        if (padScene) {
          // Pickup pad (green) — persistent
          if (!padDestinationPads[order.from]) {
            const pickupPad = buildDestinationPad(order.from, 0x4ade80);
            pickupPad.position.set(pickup3D.x, 0, pickup3D.z);
            padScene.add(pickupPad);
            padDestinationPads[order.from] = { group: pickupPad, color: 0x4ade80 };
          }
          // Dropoff pad (amber) — persistent
          if (!padDestinationPads[order.to]) {
            const dropoffPad = buildDestinationPad(order.to, 0xf59e0b);
            dropoffPad.position.set(dropoff3D.x, 0, dropoff3D.z);
            padScene.add(dropoffPad);
            padDestinationPads[order.to] = { group: dropoffPad, color: 0xf59e0b };
          }
          // Customer figure waiting at the pickup pad — this IS per-mission
          customerFigure = buildCustomerFigure();
          customerFigure.position.set(pickup3D.x + 0.8, 0, pickup3D.z + 0.3);
          customerFigure.lookAt(pickup3D.x, 0, pickup3D.z);
          padScene.add(customerFigure);
          sceneAdds.push(customerFigure);
        }

        // ===== Build aircraft mesh for THIS flight =====
        // Clone the currently-loaded saved design geometry so multiple aircraft
        // can be in flight simultaneously, each with its own animated Group.
        // The padGroup remains as the "default" parked aircraft when no flight active.
        let acGroup = null;
        try {
          const allDesigns = (typeof getAllSavedDesigns === 'function') ? getAllSavedDesigns() : [];
          const fullDesign = allDesigns.find(d => d.id === aircraft.id);
          if (fullDesign && fullDesign.scene) {
            const loader = new THREE.ObjectLoader();
            const restored = loader.parse(fullDesign.scene);
            acGroup = new THREE.Group();
            while (restored.children.length) acGroup.add(restored.children[0]);
            acGroup.traverse(o => { if (o.isMesh) o.castShadow = true; });
            // CRITICAL: apply the SAME fit-scale used by the apron static
            // copy. computeFitScale is deterministic — given the same group
            // contents it returns the same scale — so the in-flight clone
            // ends up the SAME visual size as the apron parked copy. This
            // is what eliminates "shrink on landing": when the clone
            // disappears at mission complete and the apron static copy
            // takes its place, both are at identical scale.
            const fitScale = computeFitScale(acGroup);
            acGroup.scale.set(fitScale, fitScale, fitScale);
            // Position clone at takeoff start — the aircraft's apron pad,
            // ALWAYS. With the new "stay-on-apron" model, every aircraft is
            // parked at its own apron slot regardless of selection. The
            // first cruise phase's `from` is patched to match this start
            // position so there's no first-frame snap.
            const apronStart = apronPosition(aircraft.id);
            const startX = apronStart.x;
            const startZ = apronStart.z;
            acGroup.position.set(startX, 0, startZ);
            acGroup.userData.takeoffStart = { x: startX, z: startZ };
            acGroup.userData.fitScale = fitScale;
            padScene.add(acGroup);
            // Settle so skids/wheels rest on apron surface from the very
            // first frame (matches what the apron static copy does).
            settleOnPad(acGroup, 0, 0.02);
          }
        } catch (err) { console.warn('Per-flight geometry clone failed:', err); }
        // Fallback: if cloning failed, use padGroup directly (single-flight behavior)
        if (!acGroup) acGroup = padGroup;

        // Find rotors in this aircraft for blade-spin animation
        const flightRotors = [];
        acGroup.traverse(o => {
          if (o.userData?.partName && typeof o.userData.partName === 'string'
              && o.userData.partName.toLowerCase().includes('rotor')) {
            let bladeChild = null;
            o.traverse(child => {
              if (child === o) return;
              if (child.isGroup && child.children.length >= 2 &&
                  child.children.every(c => c.isMesh && c.geometry?.type === 'BoxGeometry')) {
                bladeChild = child;
              }
            });
            flightRotors.push(bladeChild || o);
          }
        });

        // Find the boarding target — a seat's interior position so the customer
        // walks to a real seat instead of a generic "fuselage origin". We pick
        // the FIRST passenger seat we find (preference: bench → bucket → captain).
        // Stored as offsets relative to the aircraft origin so the boarding
        // animation can transform it to the aircraft's current world position
        // each frame (the aircraft moves during the flight).
        //
        // Important coordinate-frame note: `seat.userData.boardingTarget` is
        // stored in AIRCRAFT-LOCAL coordinates — the seat's position relative
        // to the aircraft origin (taxi/acGroup). It was computed in the mfg
        // view where taxi sits at world (0,0,0), so the saved target's
        // values ARE the aircraft-local offset. We use them directly as
        // `boardingOffset`. (Earlier code mistakenly subtracted acGroup.position,
        // which double-corrected and put the target underground.)
        let boardingOffset = null;
        const seatPriority = { bench_seat: 1, bucket_seat: 2, captain_seat: 3 };
        let bestPriority = 99;
        acGroup.traverse(o => {
          const pname = o.userData?.partName;
          if (!pname) return;
          // Strip _N suffix to match the type
          const base = pname.replace(/_\d+$/, '');
          if (!(base in seatPriority)) return;
          if (seatPriority[base] >= bestPriority) return;
          let local;
          if (o.userData.boardingTarget) {
            // Already aircraft-local from save time — use directly
            local = { ...o.userData.boardingTarget };
          } else {
            // Older designs (no boardingTarget): derive from the seat's
            // current world bbox center, then convert to aircraft-local
            // by subtracting acGroup's world position.
            const box = new THREE.Box3().setFromObject(o);
            const center = new THREE.Vector3();
            box.getCenter(center);
            local = {
              x: center.x - acGroup.position.x,
              y: box.min.y + (box.max.y - box.min.y) * 0.4 - acGroup.position.y,
              z: center.z - acGroup.position.z
            };
          }
          boardingOffset = { x: local.x, y: local.y, z: local.z, partName: pname };
          bestPriority = seatPriority[base];
        });

        const newFlightState = {
          tail: aircraft.tail,
          designId: aircraft.id,
          customer: order.customer,
          startTime: performance.now(),
          active: true,
          // Per-flight cruise altitude offset for vertical separation.
          // The customer's own flight stays on the canonical cruise
          // layer (offset 0) so the chase camera doesn't have to climb
          // to follow it. Other AI flights are spread across ±6 units
          // pseudo-randomly so multiple AI taxis crossing the same
          // horizontal airspace are stacked at different altitudes
          // (no more "mid-air collision" visual). 6 units ≈ 600 ft of
          // vertical separation in mission-scale terms.
          cruiseAltOffset: order.isCustomerMode ? 0 : ((Math.random() - 0.5) * 12),
          sceneAdds,
          customerFigure,
          pickupPos: pickup3D,
          dropoffPos: dropoff3D,
          hubPos: hub3D,
          totalMiles: mission.totalMiles,
          // Clone phases so we can patch the 3D return target without
          // affecting the 2D map (which uses its own phaseRoutes table).
          // We override:
          //   - First cruise phase's `from` → apron pad (takeoff origin),
          //     so the aircraft cruises smoothly away from where it's parked
          //     rather than snapping to hub on frame 1.
          //   - Final cruise phase's `to` → apron pad, so the aircraft
          //     descends physically to its parking slot.
          //   - Docked phase's `from`/`to` → apron pad, so the post-mission
          //     idle holds it at apron rather than hub.
          // Selection no longer affects takeoff origin — every aircraft
          // lives at its apron slot, period.
          // Override phase coordinates so the aircraft physically takes off
          // from and lands at its apron pad (not the logical hub center).
          // Phases come from computeMissionPhases as a 13-phase sequence:
          //   preflight, vertical_climb, cruise→pickup, vertical_descent,
          //   hover, vertical_climb, cruise→dropoff, vertical_descent,
          //   hover, vertical_climb, cruise→hub, vertical_descent, docked
          // Patches:
          //   - All hub-anchored phases (preflight, first vertical_climb,
          //     final vertical_descent, docked) → from/to = apron coord
          //   - First cruise leg's `from` → apron coord
          //   - Final cruise leg's `to` → apron coord
          // Without these patches the aircraft would teleport between apron
          // and hub at every phase boundary involving the hub.
          //
          // POST-MISSION PARKING — TELEPORT FIX
          // Any flight drains battery below the 95% charging threshold,
          // so when the aircraft lands renderFleetAprons classifies it
          // as charging and parks the static copy at the charger station
          // (z=-22) — completely separate from the apron. If the descent
          // ended at the apron, the user sees the clone land at the
          // apron, sit briefly, then "teleport" 22m to the charger when
          // the parked copy materializes. User: "when it lands, it has
          // to land and stay there. no dillydally."
          //
          // Fix: project this aircraft's charger slot at dispatch time
          // (mirroring renderFleetAprons' assignment logic — sort by
          // savedAt, slot = index in the charging-after-this-mission
          // subset) and route the LAST descent + docked phases — plus
          // the last cruise's `to` — to that charger slot instead of
          // the apron. Now the clone touches down exactly where the
          // parked copy will live, and the swap is invisible.
          phases: (() => {
            const apronPos = apronPosition(aircraft.id);
            const apronCoord = { x: apronPos.x, z: apronPos.z };
            const hubPos = pad3DCoord(MAIN_HUB_NAME);
            const isHubAnchored = (p) =>
              Math.abs(p.from.x - hubPos.x) < 0.01 && Math.abs(p.from.z - hubPos.z) < 0.01 &&
              Math.abs(p.to.x   - hubPos.x) < 0.01 && Math.abs(p.to.z   - hubPos.z) < 0.01;

            // ---- Project post-mission parking position ----
            // Mirror renderFleetAprons' charger slot assignment: the
            // charging subset is `chargingIds`, sorted by design.savedAt
            // ascending. This aircraft's slot = its index in that list
            // AFTER we add it to the charging set (because it'll be
            // sub-95% the moment it lands).
            let parkingCoord = apronCoord;
            try {
              const all = (typeof getAllSavedDesigns === 'function') ? getAllSavedDesigns() : [];
              const ordered = all.slice().sort((a, b) => (a.savedAt || 0) - (b.savedAt || 0));
              const MIN_BATT = 95 - 0.05;
              const chargingProjected = new Set([aircraft.id]);
              if (typeof padDesignBatteries !== 'undefined' && padDesignBatteries) {
                padDesignBatteries.forEach((entry, designId) => {
                  if (entry && typeof entry.battery === 'number' && entry.battery < MIN_BATT) {
                    chargingProjected.add(designId);
                  }
                });
              }
              const chargingOrderedProjected = ordered.filter(d => chargingProjected.has(d.id));
              const projectedSlot = chargingOrderedProjected.findIndex(d => d.id === aircraft.id);
              if (projectedSlot >= 0 && typeof chargerSpotPosition === 'function') {
                const spot = chargerSpotPosition(projectedSlot);
                parkingCoord = { x: spot.x, z: spot.z };
              }
            } catch (err) {
              // Charger projection is best-effort. If anything blows up
              // we fall back to the apron — old behavior, teleport
              // returns, but flight still completes safely.
              console.warn('[parking projection] failed, falling back to apron:', err);
            }

            // ---- Phase index discovery ----
            let firstCruiseIdx = -1, lastCruiseIdx = -1;
            let lastVertDescentAtHubIdx = -1, dockedIdx = -1;
            mission.phases.forEach((p, i) => {
              if (p.kind === 'cruise') {
                if (firstCruiseIdx === -1) firstCruiseIdx = i;
                lastCruiseIdx = i;
              }
              if (p.kind === 'vertical_descent' && isHubAnchored(p)) {
                lastVertDescentAtHubIdx = i;     // last hub-anchored descent (return to hub)
              }
              if (p.kind === 'docked') {
                dockedIdx = i;
              }
            });
            return mission.phases.map((p, i) => {
              // The LAST hub-anchored descent + docked phase land at the
              // projected parking spot (charger if charging-after-mission,
              // else apron). This is where the aircraft physically rests
              // after the mission, no post-touchdown movement.
              if (i === lastVertDescentAtHubIdx || i === dockedIdx) {
                return { ...p, from: parkingCoord, to: parkingCoord };
              }
              // Other hub-anchored stationary phases (preflight + takeoff
              // climb) run BEFORE the mission while the aircraft is still
              // sitting at its pre-mission slot — keep using apron coord.
              if ((p.kind === 'preflight' || p.kind === 'vertical_climb' ||
                   p.kind === 'vertical_descent' || p.kind === 'docked') && isHubAnchored(p)) {
                return { ...p, from: apronCoord, to: apronCoord };
              }
              // First cruise leg: starts at apron (where aircraft was parked)
              if (i === firstCruiseIdx) {
                return { ...p, from: apronCoord };
              }
              // Last cruise leg: ends at parking spot (where aircraft will rest)
              if (i === lastCruiseIdx) {
                return { ...p, to: parkingCoord };
              }
              return p;
            });
          })(),
          boardingOffset,                // local-space target inside the aircraft (or null)
          // Battery: read from per-design persistent map. If this design has flown
          // before, pick up where it left off (so a recently-flown aircraft starts
          // at whatever charge it had when it parked). First flight starts at 95%
          // (AIAA spec — never 100% to avoid accelerated Li-ion degradation).
          battery: (padDesignBatteries.get(aircraft.id)?.battery) ?? 95,
          batteryLastUpdate: performance.now(),
          acGroup: acGroup,            // per-flight 3D mesh (cloned aircraft)
          rotors: flightRotors,        // per-flight rotor spin targets
          isClone: acGroup !== padGroup  // true if we cloned, false if using padGroup
        };
        padFlightStates.push(newFlightState);
        // Refresh the splash flight counter — its displayed value sums
        // persisted completions + currently-active flights, so adding a
        // new active flight should bump the visible total by 1 right
        // now (not wait for completion). The element only exists if the
        // splash is in DOM, so the call is a no-op if not.
        try {
          if (typeof updateSplashTotalFlights === 'function') updateSplashTotalFlights();
        } catch (_) {}
        // Promote new dispatch to primary (camera tracks it) UNLESS the
        // current primary is the customer's mid-mission flight — in that
        // case the user's flight stays primary so audio, the E/Enter
        // boarding prompt, and the customer-mode phase hooks (which all
        // gate on `padFlightState === user's flight`) keep firing for
        // them. AI fleet dispatches go into the secondary loop, which
        // animates them visually without stealing the camera/audio/HUD.
        const userFlightId = window.__customerAircraftId;
        const customerFlightIsPrimary = (
          window.__customerModeActive &&
          padFlightState && padFlightState.active &&
          padFlightState.designId === userFlightId
        );
        const newDispatchIsCustomerFlight = (newFlightState.designId === userFlightId);
        if (!customerFlightIsPrimary || newDispatchIsCustomerFlight) {
          padFlightState = newFlightState;     // primary = the one just dispatched (camera tracks it)
        }
        // Otherwise: leave padFlightState alone (user's flight stays primary).
        // The AI dispatch is still in padFlightStates and will animate via
        // the secondary-flights loop.

        // Belt-and-suspenders padGroup hide. The per-frame visibility logic in
        // tickPad already handles this, but it can lag by 1 frame after launch
        // — and if that frame happens to be when the user looks at the scene
        // (especially with vsync stalls or browser-tab-visibility transitions),
        // the user sees padGroup at hub AND the flying clone simultaneously.
        // We explicitly hide here so the very next render is correct.
        // The per-frame logic still owns the long-term state — this is just
        // for the initial frame after launch.
        if (acGroup !== padGroup && padGroup) {
          padGroup.visible = false;
          if (padHubLabel) padHubLabel.visible = false;
        }

        // Log mission summary to chat history
        const realMissionMin = (mission.phases.reduce((s, p) => s + p.dur, 0) / 60).toFixed(1);
        flight.totalMiles = mission.totalMiles;
        flight.realMissionMin = realMissionMin;

        // Reset selection
        padSelectedOrder = null;
        renderChatFeed();
        renderFleetRoster();
        // Re-render aprons so the dispatched aircraft is hidden from the static
        // apron display (it's now visibly flying overhead instead).
        if (typeof renderFleetAprons === 'function') renderFleetAprons();
        // Tick OPERATOR FLIGHTS counter — user said: "the mission gets
        // sent to the aircraft at that moment the operator count
        // should update." One increment per dispatch, regardless of
        // how many stops the mission contains. CUSTOMER FLIGHTS will
        // tick separately at each dropoff hover (so single-stop
        // missions: operator+1 + customer+1, multistop: operator+1 +
        // customer+N where N = number of dropoffs).
        try {
          if (typeof incrementOperatorFlights === 'function') {
            incrementOperatorFlights();
          }
        } catch (_) { /* counter best-effort */ }
      }

      function startCustomerChatSimulation(currentPad) {
        // Seed with 2 starter orders so the panel isn't empty
        padChatOrders = [
          generateCustomerOrder(currentPad),
          generateCustomerOrder(currentPad)
        ];
        renderChatFeed();
        // New order every 6-12 seconds. Faster than the original
        // 18-32s so the dispatcher always has incoming demand to
        // respond to. The user explicitly wanted activity driven
        // "based on orders and demand" — this is the demand stream.
        // Cap at 8 pending so the panel doesn't overflow.
        if (padChatGenInterval) clearInterval(padChatGenInterval);
        const tick = () => {
          const pending = padChatOrders.filter(o => o.status === 'pending').length;
          if (pending < 8) {
            padChatOrders.push(generateCustomerOrder(currentPad));
            renderChatFeed();
          }
        };
        padChatGenInterval = setInterval(tick, 6000 + Math.random() * 6000);
      }

      function stopCustomerChatSimulation() {
        if (padChatGenInterval) { clearInterval(padChatGenInterval); padChatGenInterval = null; }
        // Stop all active flight animations (2D and 3D)
        padDispatchedFlights.forEach(f => { f.active = false; if (f.markerEl) f.markerEl.remove(); });
        // Tear down all 3D flight clones too (otherwise they'd be orphaned on next pad open)
        if (padFlightStates && padFlightStates.length) {
          for (const f of padFlightStates) {
            if (f.isClone && f.acGroup && f.acGroup.parent) f.acGroup.parent.remove(f.acGroup);
            if (f.sceneAdds) f.sceneAdds.forEach(o => padScene && padScene.remove(o));
          }
        }
        padFlightStates = [];
        padFlightState = null;
        // Restore the parked-on-hub aircraft visibility for next pad open
        if (padGroup) padGroup.visible = true;
      }

      // ============================================================
      // AI OPS CREW SIMULATION
      //
      // The user wanted to feel like they're not alone in the hub —
      // there should be other operators visibly working: dispatchers
      // sending missions, mechanics doing maintenance, ground crew
      // moving aircraft, ops responding to orders. This panel posts
      // live messages from a roster of named AI workers so the hub
      // feels populated and alive.
      //
      // The crew is procedurally rostered when the launch pad opens.
      // Roster size scales with hangar size (more aircraft = more
      // crew needed). Activity hooks into real events:
      //   - tryDispatchOneAiOrder posts a Dispatcher message
      //   - recordFlightCompletion posts an Operations log
      //   - In addition, idle chatter ticks every 4-9s with
      //     contextually-relevant maintenance / ground / ATC chatter
      // ============================================================
      const CREW_ROLES = [
        { role: 'DISPATCH',  cls: 'role-dispatcher', icon: '📡' },
        { role: 'MAINT',     cls: 'role-mechanic',   icon: '🔧' },
        { role: 'GROUND',    cls: 'role-ground',     icon: '🛬' },
        { role: 'OPS',       cls: 'role-ops',        icon: '📋' },
        { role: 'ATC',       cls: 'role-atc',        icon: '🗼' },
      ];
      const CREW_FIRST_NAMES = [
        'Reyes','Okafor','Tanaka','Petrov','Chen','Hassan','Singh','Walker',
        'Mendoza','Park','Novak','Larsen','Khan','Nguyen','Becker','Morales',
        'Thompson','Gupta','Saito','Rivera','Volkov','Lim','Adeyemi','Brennan',
      ];
      // Active crew roster + activity feed state
      let padCrewRoster = [];      // [{name, role, cls, icon}]
      let padCrewMessages = [];    // [{name, role, cls, body, t}]
      let padCrewGenInterval = null;
      let padCrewCountInterval = null;     // periodic "X working" refresh
      const PAD_CREW_MAX_MESSAGES = 40;     // ring buffer cap so DOM doesn't bloat

      // Roster size: at least 7 (matching the 3D figure count: 1 dispatch
      // + 3 maint + 1 ground + 1 ops + 1 atc), up to ~12 for big fleets.
      // Maintenance gets 3 named slots minimum since the user asked for
      // more maintenance workers.
      //
      // CACHED on window.__opsCrewRoster so mfg view (AI manufacturing
      // team) and launchpad view (OPS CREW LIVE feed) show the same
      // people — the user's expectation: "It should be the like same
      // members who are out at the HUB." Without caching, each view
      // would generate fresh random names and feel disconnected.
      function buildCrewRoster() {
        if (typeof window !== 'undefined' && window.__opsCrewRoster &&
            Array.isArray(window.__opsCrewRoster) && window.__opsCrewRoster.length > 0) {
          return window.__opsCrewRoster;
        }
        const designs = (typeof getAllSavedDesigns === 'function') ? getAllSavedDesigns() : [];
        const n = designs.length;
        const usedNames = new Set();
        const roster = [];
        function uniqueName() {
          let name, attempts = 0;
          do {
            name = CREW_FIRST_NAMES[Math.floor(Math.random() * CREW_FIRST_NAMES.length)];
          } while (usedNames.has(name) && ++attempts < 20);
          usedNames.add(name);
          return name;
        }
        // Required base roster — matches 3D figure count
        const baseSlots = [
          { role: 'DISPATCH', cls: 'role-dispatch', icon: '📡' },
          { role: 'MAINT',    cls: 'role-maint',    icon: '🔧' },
          { role: 'MAINT',    cls: 'role-maint',    icon: '🔧' },
          { role: 'MAINT',    cls: 'role-maint',    icon: '🔧' },
          { role: 'GROUND',   cls: 'role-ground',   icon: '🦺' },
          { role: 'OPS',      cls: 'role-ops',      icon: '📋' },
          { role: 'ATC',      cls: 'role-atc',      icon: '🗼' },
          // Two IR (Incident Response) — sit in the recovery vehicle
          { role: 'IR',       cls: 'role-ir',       icon: '🚐' },
          { role: 'IR',       cls: 'role-ir',       icon: '🚐' },
          // One VO (Visual Observer) — stationed on a remote platform
          { role: 'VO',       cls: 'role-vo',       icon: '🔭' },
        ];
        for (const slot of baseSlots) {
          roster.push({ name: uniqueName(), role: slot.role, cls: slot.cls, icon: slot.icon });
        }
        // Extra crew scaling with hangar size — distribute across roles
        const extras = Math.min(Math.floor(n / 2), 5);     // up to 5 extras
        for (let i = 0; i < extras; i++) {
          const role = CREW_ROLES[i % CREW_ROLES.length];
          roster.push({ name: uniqueName(), role: role.role, cls: role.cls, icon: role.icon });
        }
        if (typeof window !== 'undefined') window.__opsCrewRoster = roster;
        return roster;
      }
      // Expose globally so the mfg view's AI team button can use the
      // same roster the launchpad sees
      if (typeof window !== 'undefined') window.__buildCrewRoster = buildCrewRoster;

      // ============================================================
      // OPERATOR ↔ CREW CHAT
      // The user is the Head of Operations. They can type messages to
      // their crew. The crew responds in plain English with operationally
      // relevant replies based on simple intent classification + the
      // current state of the fleet (parked aircraft, in-flight count,
      // pending orders, etc).
      //
      // Intent router: keyword-based, deterministic per intent but with
      // multiple response templates so replies don't feel canned. Falls
      // back to a generic acknowledgement if no intent matches.
      // ============================================================

      // Pick a phrase from a list, avoiding the most-recent if possible
      const __recentPhrases = new Set();
      function pickFresh(arr) {
        if (!arr || arr.length === 0) return '';
        if (arr.length === 1) return arr[0];
        let attempts = 0, choice;
        do {
          choice = arr[Math.floor(Math.random() * arr.length)];
        } while (__recentPhrases.has(choice) && ++attempts < 5);
        __recentPhrases.add(choice);
        // Cap recent set so we don't permanently exclude phrases
        if (__recentPhrases.size > 20) {
          const first = __recentPhrases.values().next().value;
          __recentPhrases.delete(first);
        }
        return choice;
      }

      // Snapshot the current fleet state for response context
      function snapshotOps() {
        const designs = (typeof getAllSavedDesigns === 'function') ? getAllSavedDesigns() : [];
        const inFlight = [];
        const parked = [];
        try {
          if (typeof padFlightStates !== 'undefined' && Array.isArray(padFlightStates)) {
            for (const d of designs) {
              const isFlying = padFlightStates.some(f => f && f.active && f.designId === d.id);
              if (isFlying) inFlight.push(d); else parked.push(d);
            }
          } else {
            parked.push(...designs);
          }
        } catch (_) { parked.push(...designs); }
        const pendingOrders = (typeof padChatOrders !== 'undefined' && Array.isArray(padChatOrders))
          ? padChatOrders.filter(o => o.status === 'pending').length : 0;
        return { designs, inFlight, parked, pendingOrders };
      }

      // Find which aircraft (if any) the user is asking about. Matches
      // by tail number (SDX-####) or by name (case-insensitive substring).
      function findReferencedAircraft(text) {
        const designs = (typeof getAllSavedDesigns === 'function') ? getAllSavedDesigns() : [];
        if (!designs.length) return null;
        const lower = text.toLowerCase();
        // Tail number match first (most specific)
        for (const d of designs) {
          const tail = (d.tailNumber || '').toLowerCase();
          if (tail && lower.includes(tail)) return d;
          // Also match the digit portion (e.g. "0042" or "42")
          const digits = (d.tailNumber || '').match(/\d+/);
          if (digits && lower.includes(digits[0])) return d;
        }
        // Name match — require ≥4 chars to avoid false positives on "the"
        for (const d of designs) {
          const name = (d.name || '').toLowerCase();
          if (name && name.length >= 4 && lower.includes(name)) return d;
        }
        return null;
      }

      // Classify the user's query into an intent
      function classifyOperatorQuery(text) {
        const t = text.toLowerCase().trim();
        // Greeting (more permissive — matches "hello there", "hey crew", etc)
        if (/^(hi|hello|hey|yo|morning|afternoon|good\s+(morning|afternoon|evening))(\s|[!.,?]|$)/i.test(t)) {
          return 'greeting';
        }
        // Help (early so it isn't shadowed by other intents)
        if (/\b(help|commands|what can|what (do|can) you do)\b/.test(t)) {
          return 'help';
        }
        // Stand down / break
        if (/\b(stand down|take a break|go on break|rest|pause|stop work)\b/.test(t)) {
          return 'stand_down';
        }
        // Praise / thanks (early — "thanks team" shouldn't classify as something else)
        if (/\b(thank|thanks|ty|good (job|work)|nice (work|job)|well done|appreciate)\b/.test(t)) {
          return 'praise';
        }
        // Maintenance commands FIRST (specific patterns before generic aircraft mention)
        if (/\b(inspect|check|service|repair|maintenance).*(all|fleet|aircraft|every|line|hangar)\b/.test(t)
            || /\b(inspect|check)\s+(the\s+)?(entire|whole)\s+/.test(t)) {
          return 'maint_inspect_all';
        }
        // Dispatch/launch commands BEFORE aircraft_status (so "launch SDX-0001"
        // is treated as a command, not a status query)
        if (/\b(dispatch|launch|send|fly out|get .* in the air)\b/.test(t)) {
          return 'dispatch_command';
        }
        // Aircraft-specific queries
        if (findReferencedAircraft(text)) {
          if (/\b(battery|charge|charging|charged|soc|power|fuel)\b/.test(t)) return 'aircraft_battery';
          if (/\b(problem|issue|wrong|broken|fault|fail|trouble|squawk)s?\b/.test(t)) return 'aircraft_problem';
          if (/\b(when|how long|eta|return|back)\b/.test(t)) return 'aircraft_eta';
          return 'aircraft_status';     // default for any aircraft mention
        }
        // Airborne / in-flight queries (before fleet_count so "how many in
        // the air" routes here, not to count)
        if (/\b(airborne|in (the )?air|flying|in flight|out flying|in the sky)\b/.test(t)) {
          return 'fleet_airborne';
        }
        // Hangar / fleet count
        if (/\b(fleet|hangar|how many|count|aircraft).*(parked|idle|ready|available|grounded|charging)\b/.test(t)
            || /\b(how many|count).*(aircraft|planes|fleet)\b/.test(t)) {
          return 'fleet_count';
        }
        // Orders / queue (before status so "queue status" isn't generic status)
        if (/\b(order|queue|pending|demand|customer|booking)/.test(t)) {
          return 'orders';
        }
        // Status/sitrep request
        if (/\b(status|sitrep|report|update|how('?s| is) it going|situation|overview)\b/.test(t)) {
          return 'status';
        }
        if (/\b(inspect|check|look at)\b/.test(t) && /\b(it|that|this)\b/.test(t)) {
          return 'maint_acknowledge';
        }
        // Question (ends with ?)
        if (/\?\s*$/.test(text)) return 'question_generic';
        return 'generic';
      }

      // Look up battery state for an aircraft (returns null if no entry)
      function batteryFor(designId) {
        try {
          const map = (typeof window !== 'undefined' && window.__padDesignBatteries) || null;
          if (!map || !map.get) return null;
          const entry = map.get(designId);
          if (!entry || entry.battery === undefined) return null;
          return { battery: entry.battery, isCharging: !!entry.isCharging };
        } catch (_) { return null; }
      }

      // Build a response for an intent. Returns { roleKey, body }.
      function buildCrewReply(intent, text) {
        const ops = snapshotOps();
        const ac = findReferencedAircraft(text);
        switch (intent) {
          case 'greeting': {
            const lines = [
              'Morning, boss. Crew\'s ready.',
              'Hey chief. We\'re on it.',
              'All hands present and accounted for.',
              'Standing by, sir.',
            ];
            return { roleKey: 'DISPATCH', body: pickFresh(lines) };
          }
          case 'status': {
            const tails = ops.inFlight.slice(0, 3).map(d => `<span class="tail">${d.tailNumber}</span>`).join(', ');
            const flightLine = ops.inFlight.length === 0
              ? 'No aircraft airborne right now.'
              : `${ops.inFlight.length} airborne (${tails}${ops.inFlight.length > 3 ? ', plus more' : ''}).`;
            const parkedLine = ops.parked.length === 0
              ? 'Hangar empty, fleet\'s out.'
              : `${ops.parked.length} parked and charging.`;
            const orderLine = ops.pendingOrders === 0
              ? 'Order queue is clean.'
              : `${ops.pendingOrders} order${ops.pendingOrders === 1 ? '' : 's'} in the queue.`;
            const body = `Sitrep: ${flightLine} ${parkedLine} ${orderLine}`;
            return { roleKey: 'OPS', body };
          }
          case 'aircraft_battery': {
            if (!ac) return buildCrewReply('generic', text);
            const bat = batteryFor(ac.id);
            const isFlying = ops.inFlight.some(d => d.id === ac.id);
            if (isFlying) {
              return {
                roleKey: 'DISPATCH',
                body: `<span class="tail">${ac.tailNumber}</span> is airborne — last reading was full charge at takeoff.`,
              };
            }
            if (!bat) {
              return {
                roleKey: 'MAINT',
                body: `<span class="tail">${ac.tailNumber}</span> reads full charge, ready to launch.`,
              };
            }
            const pct = bat.battery.toFixed(0);
            if (bat.isCharging) {
              const eta = Math.max(1, Math.ceil((95 - bat.battery) / 1.5));
              return {
                roleKey: 'MAINT',
                body: `<span class="tail">${ac.tailNumber}</span> is at ${pct}%, charging steadily. ETA to full: ~${eta}s.`,
              };
            }
            return {
              roleKey: 'MAINT',
              body: `<span class="tail">${ac.tailNumber}</span> reads ${pct}%, fully charged and ready.`,
            };
          }
          case 'aircraft_status': {
            if (!ac) return buildCrewReply('generic', text);
            const isFlying = ops.inFlight.some(d => d.id === ac.id);
            if (isFlying) {
              const lines = [
                `<span class="tail">${ac.tailNumber}</span> is currently airborne — last reported nominal.`,
                `<span class="tail">${ac.tailNumber}</span> is mid-mission, all systems green.`,
                `<span class="tail">${ac.tailNumber}</span>'s out flying right now, no faults reported.`,
              ];
              return { roleKey: 'DISPATCH', body: pickFresh(lines) };
            } else {
              // Parked → mention charge state too. Workers know the
              // state of charge of every taxi (per the user's request).
              const bat = batteryFor(ac.id);
              const chargeLine = bat
                ? (bat.isCharging
                    ? `at ${bat.battery.toFixed(0)}%, still charging`
                    : `${bat.battery.toFixed(0)}% charged, ready to go`)
                : 'fully charged, ready to go';
              const lines = [
                `<span class="tail">${ac.tailNumber}</span> is parked — ${chargeLine}.`,
                `<span class="tail">${ac.tailNumber}</span>'s on its apron — ${chargeLine}, pre-flight passed.`,
                `<span class="tail">${ac.tailNumber}</span> is good to go whenever you call it (${chargeLine}).`,
                `Just walked around <span class="tail">${ac.tailNumber}</span>, no squawks. ${chargeLine}.`,
              ];
              return { roleKey: 'MAINT', body: pickFresh(lines) };
            }
          }
          case 'aircraft_problem': {
            if (!ac) return buildCrewReply('generic', text);
            const lines = [
              `Pulling <span class="tail">${ac.tailNumber}</span> out of rotation now. I'll run diagnostics — charging stays on while I work.`,
              `On it. Walking out to <span class="tail">${ac.tailNumber}</span> to check it over. Charge isn't interrupted.`,
              `Got it, boss. Inspecting <span class="tail">${ac.tailNumber}</span> in place — battery keeps charging meanwhile.`,
            ];
            try {
              if (typeof window.__assignCrewWork === 'function') {
                window.__assignCrewWork('MAINT', ac.id, 4000);
              }
            } catch (_) {}
            return { roleKey: 'MAINT', body: pickFresh(lines) };
          }
          case 'aircraft_eta': {
            if (!ac) return buildCrewReply('generic', text);
            const isFlying = ops.inFlight.some(d => d.id === ac.id);
            if (isFlying) {
              const lines = [
                `<span class="tail">${ac.tailNumber}</span> should be wheels-down in a few minutes.`,
                `Estimating <span class="tail">${ac.tailNumber}</span> back at the hub shortly — keeping you posted.`,
                `<span class="tail">${ac.tailNumber}</span>'s on approach to drop. Will recharge and re-rotate after.`,
              ];
              return { roleKey: 'OPS', body: pickFresh(lines) };
            }
            const lines = [
              `<span class="tail">${ac.tailNumber}</span>'s parked here — ready when you need it.`,
              `<span class="tail">${ac.tailNumber}</span>'s already home, boss.`,
            ];
            return { roleKey: 'DISPATCH', body: pickFresh(lines) };
          }
          case 'fleet_count': {
            const total = ops.designs.length;
            const body = `${total} aircraft on the books · ${ops.parked.length} parked · ${ops.inFlight.length} airborne.`;
            return { roleKey: 'OPS', body };
          }
          case 'fleet_airborne': {
            if (ops.inFlight.length === 0) {
              return { roleKey: 'DISPATCH', body: 'Nothing airborne right now. Whole fleet is parked.' };
            }
            const tails = ops.inFlight.slice(0, 4).map(d => `<span class="tail">${d.tailNumber}</span>`).join(', ');
            const more = ops.inFlight.length > 4 ? `, plus ${ops.inFlight.length - 4} more` : '';
            return { roleKey: 'DISPATCH', body: `Currently airborne: ${tails}${more}.` };
          }
          case 'orders': {
            if (ops.pendingOrders === 0) {
              return { roleKey: 'DISPATCH', body: 'Queue\'s clean. We\'ll grab the next one when it comes in.' };
            }
            const body = `${ops.pendingOrders} pending order${ops.pendingOrders === 1 ? '' : 's'} — working through them as fast as the fleet allows.`;
            return { roleKey: 'DISPATCH', body };
          }
          case 'maint_inspect_all': {
            const lines = [
              'Copy that — running a sweep across the entire parked fleet.',
              'On it, boss. Walking the line now.',
              'Inspections coming right up. I\'ll flag anything that doesn\'t pass.',
            ];
            // Queue MAINT visits to all parked aircraft
            try {
              if (typeof window.__assignCrewWork === 'function') {
                for (const d of ops.parked) {
                  window.__assignCrewWork('MAINT', d.id, 2500);
                }
              }
            } catch (_) {}
            return { roleKey: 'MAINT', body: pickFresh(lines) };
          }
          case 'maint_acknowledge': {
            const lines = [
              'On it.',
              'Walking out now.',
              'Copy, heading over.',
              'Got it, taking a look.',
            ];
            try {
              if (typeof window.__assignCrewWork === 'function') {
                const target = ops.parked[0];
                if (target) window.__assignCrewWork('MAINT', target.id, 3000);
              }
            } catch (_) {}
            return { roleKey: 'MAINT', body: pickFresh(lines) };
          }
          case 'dispatch_command': {
            if (ac) {
              const isFlying = ops.inFlight.some(d => d.id === ac.id);
              if (isFlying) {
                return { roleKey: 'DISPATCH', body: `<span class="tail">${ac.tailNumber}</span> is already out, boss.` };
              }
              const lines = [
                `Copy, queuing <span class="tail">${ac.tailNumber}</span> for the next available order.`,
                `Roger that. <span class="tail">${ac.tailNumber}</span>'s cued up.`,
              ];
              return { roleKey: 'DISPATCH', body: pickFresh(lines) };
            }
            const lines = [
              'Copy. Pulling the next aircraft for dispatch.',
              'On it — sending the next available bird.',
            ];
            return { roleKey: 'DISPATCH', body: pickFresh(lines) };
          }
          case 'praise': {
            const lines = [
              'Appreciate it, chief.',
              'Thanks, boss. Crew\'s pulling their weight.',
              'All in a day\'s work.',
              'Thanks — we\'ll keep it tight.',
            ];
            const roles = ['DISPATCH', 'MAINT', 'GROUND', 'OPS'];
            return { roleKey: roles[Math.floor(Math.random() * roles.length)], body: pickFresh(lines) };
          }
          case 'stand_down': {
            const lines = [
              'Copy, easing off. Holler if you need us.',
              'Standing down. Fleet\'s in good shape.',
            ];
            return { roleKey: 'OPS', body: pickFresh(lines) };
          }
          case 'help': {
            const body = 'You can ask for status, ask about a specific aircraft (try the tail number), tell us to inspect the fleet, dispatch the next bird, or just check the order queue. We\'ll respond plain English.';
            return { roleKey: 'OPS', body };
          }
          case 'question_generic': {
            const lines = [
              'Not sure I follow, boss — can you rephrase?',
              'Didn\'t catch that — try a tail number or ask for status.',
              'Could you say that another way? I want to make sure I get it right.',
            ];
            return { roleKey: 'DISPATCH', body: pickFresh(lines) };
          }
          case 'generic':
          default: {
            const lines = [
              'Copy that.',
              'Roger.',
              'On it, boss.',
              'Acknowledged.',
              'Heard you — we\'re tracking.',
            ];
            const roles = ['DISPATCH', 'MAINT', 'GROUND', 'OPS'];
            return { roleKey: roles[Math.floor(Math.random() * roles.length)], body: pickFresh(lines) };
          }
        }
      }

      // Submit handler — called by Enter key + SEND button click
      // ============================================================
      // SLASH COMMANDS — at-a-glance fleet control
      // ============================================================
      // User: "I can't tell what's happening at a glance" + "execute
      // with a confirm tap." The chat input now intercepts slash
      // commands. Typing one pops a confirm bar above the input
      // showing the parsed action; tap CONFIRM to execute.
      //
      // Available commands:
      //   /status           — print enriched fleet status to chat
      //   /hold             — block all dispatches (sets __dispatchHold)
      //   /resume           — clear the hold
      //   /recall <tail>    — flag an aircraft to return (advisory: crew
      //                       acknowledges; flight engine doesn't actually
      //                       short-circuit mid-mission yet — risky to
      //                       retrofit without breaking phase machinery)
      //   /recall all       — flag every active flight (same advisory)
      //   /dispatch <tail>  — same advisory; just selects the aircraft
      //                       and tells the user to use the launch button
      //   /help             — show available commands
      //
      // /hold and /resume actually execute. /recall and /dispatch are
      // tagged "advisory" in the confirm bar so the user knows the crew
      // is acknowledging but not forcing trajectory changes mid-flight.
      // ============================================================
      const SLASH_COMMANDS = {
        '/status':   { label: 'Print fleet status to chat',          action: 'status',     advisory: false },
        '/hold':     { label: 'HOLD all dispatch (block launch button)', action: 'hold',     advisory: false },
        '/resume':   { label: 'RESUME dispatch (clear hold)',         action: 'resume',     advisory: false },
        '/recall':   { label: 'RECALL aircraft (advisory — crew acknowledges)', action: 'recall', advisory: true, takesArg: true },
        '/dispatch': { label: 'DISPATCH aircraft (advisory — select + launch)', action: 'dispatch', advisory: true, takesArg: true },
        '/help':     { label: 'Show available slash commands',       action: 'help',       advisory: false },
      };

      // Parse a typed slash command. Returns null if not a slash, or
      // a parsed { command, action, arg, label, advisory } object.
      function parseSlashCommand(text) {
        const m = (text || '').trim().match(/^\/(\w+)(?:\s+(.+))?$/);
        if (!m) return null;
        const cmdKey = '/' + m[1].toLowerCase();
        const arg = m[2] ? m[2].trim() : '';
        const def = SLASH_COMMANDS[cmdKey];
        if (!def) {
          return { command: cmdKey, action: 'unknown', arg, label: `Unknown command "${cmdKey}". Try /help.`, advisory: false, valid: false };
        }
        let label = def.label;
        if (def.takesArg) {
          if (!arg) {
            return { command: cmdKey, action: def.action, arg: '', label: `${cmdKey} needs an argument (e.g. ${cmdKey} SDX-0001 or ${cmdKey} all).`, advisory: def.advisory, valid: false };
          }
          label = `${def.label} → ${arg.toUpperCase()}`;
        }
        return { command: cmdKey, action: def.action, arg, label, advisory: def.advisory, valid: true };
      }

      // Confirm-bar UI. Shows the parsed command label + CONFIRM/CANCEL.
      // CONFIRM runs the action; CANCEL just hides the bar. Pending
      // command lives on a closure variable.
      let __pendingSlashCommand = null;
      function showConfirmBar(parsed) {
        const bar = document.getElementById('pad-crew-confirm');
        const lbl = document.getElementById('pad-crew-confirm-label');
        if (!bar || !lbl) return;
        __pendingSlashCommand = parsed;
        const advisoryTag = parsed.advisory ? ' <em style="color:#888;font-size:9px">(advisory)</em>' : '';
        lbl.innerHTML = `Confirm: <b>${parsed.label}</b>${advisoryTag}`;
        bar.style.display = 'flex';
      }
      function hideConfirmBar() {
        const bar = document.getElementById('pad-crew-confirm');
        if (bar) bar.style.display = 'none';
        __pendingSlashCommand = null;
      }
      function executePendingSlashCommand() {
        const parsed = __pendingSlashCommand;
        hideConfirmBar();
        if (!parsed || !parsed.valid) return;
        executeSlashAction(parsed);
      }

      // Actually run the action. Posts a chat-feed message describing
      // what happened (so the crew chat history stays a record of
      // command activity, just like a real ops log).
      function executeSlashAction(parsed) {
        const operator = { name: 'You', role: 'OPERATOR', cls: 'role-operator', icon: '👤' };
        // Echo the command into the feed for record
        try { postCrewMessage(operator, `<code style="color:#ffb347">${parsed.command}${parsed.arg ? ' ' + parsed.arg : ''}</code>`); } catch (_) {}

        switch (parsed.action) {
          case 'hold': {
            window.__dispatchHold = true;
            const wrap = document.getElementById('statpill-hold-wrap');
            if (wrap) wrap.style.display = '';
            const responder = (typeof pickCrewByRole === 'function') ? pickCrewByRole('DISPATCH') : null;
            const body = 'Hold acknowledged. All dispatches blocked. Type /resume to lift.';
            if (responder) postCrewMessage(responder, body);
            break;
          }
          case 'resume': {
            window.__dispatchHold = false;
            const wrap = document.getElementById('statpill-hold-wrap');
            if (wrap) wrap.style.display = 'none';
            const responder = (typeof pickCrewByRole === 'function') ? pickCrewByRole('DISPATCH') : null;
            const body = 'Hold lifted. Dispatch is live.';
            if (responder) postCrewMessage(responder, body);
            break;
          }
          case 'status': {
            // Reuse the existing status intent for consistent voice
            const reply = (typeof buildCrewReply === 'function') ? buildCrewReply('status', '/status') : null;
            if (reply) {
              const responder = (typeof pickCrewByRole === 'function') ? pickCrewByRole(reply.roleKey) : null;
              if (responder) postCrewMessage(responder, reply.body);
            }
            break;
          }
          case 'recall': {
            // Advisory: mark flag on matching flights so other systems
            // CAN read it later, but don't truncate the mission. Crew
            // acknowledges so the user knows the message was received.
            const fleet = (typeof window !== 'undefined' && window.__padFlightStates) || [];
            let count = 0;
            const argLower = (parsed.arg || '').toLowerCase();
            for (const f of fleet) {
              if (!f || !f.active) continue;
              const matchAll = argLower === 'all';
              const matchTail = (f.tail || '').toLowerCase().includes(argLower);
              if (matchAll || matchTail) {
                f.recallRequested = true;
                count++;
              }
            }
            const responder = (typeof pickCrewByRole === 'function') ? pickCrewByRole('DISPATCH') : null;
            const body = count === 0
              ? `No active flight matched "${parsed.arg}". Nothing to recall.`
              : `Recall flagged on ${count} flight${count === 1 ? '' : 's'}. (Advisory — flight engine completes mission; flag visible on flight state.)`;
            if (responder) postCrewMessage(responder, body);
            break;
          }
          case 'dispatch': {
            // Advisory: try to select the aircraft by tail. The user
            // still has to pick an order and click LAUNCH.
            const designs = (typeof getAllSavedDesigns === 'function') ? getAllSavedDesigns() : [];
            const argLower = (parsed.arg || '').toLowerCase();
            const found = designs.find(d => (d.tailNumber || '').toLowerCase().includes(argLower));
            const responder = (typeof pickCrewByRole === 'function') ? pickCrewByRole('DISPATCH') : null;
            if (!found) {
              if (responder) postCrewMessage(responder, `No aircraft matching "${parsed.arg}" in the hangar.`);
              break;
            }
            try {
              if (typeof window.__selectAircraftById === 'function') window.__selectAircraftById(found.id);
            } catch (_) {}
            if (responder) postCrewMessage(responder, `${found.tailNumber} selected. Pick an order from the queue and use the LAUNCH button to send.`);
            break;
          }
          case 'help': {
            const cmds = Object.keys(SLASH_COMMANDS).map(k => `<code style="color:#ffb347">${k}</code> — ${SLASH_COMMANDS[k].label}`).join('<br>');
            const responder = (typeof pickCrewByRole === 'function') ? pickCrewByRole('DISPATCH') : null;
            if (responder) postCrewMessage(responder, `Slash commands:<br>${cmds}`);
            break;
          }
          case 'unknown':
          default: {
            const responder = (typeof pickCrewByRole === 'function') ? pickCrewByRole('DISPATCH') : null;
            if (responder) postCrewMessage(responder, parsed.label);
            break;
          }
        }
      }

      // Wire confirm/cancel buttons (delegated so they survive re-renders)
      document.addEventListener('click', (e) => {
        if (!e.target) return;
        if (e.target.id === 'pad-crew-confirm-yes') {
          e.preventDefault();
          executePendingSlashCommand();
        } else if (e.target.id === 'pad-crew-confirm-no') {
          e.preventDefault();
          hideConfirmBar();
        }
      });

      // Status pill updater — reads window.__padFlightStates and
      // window.__padDesignBatteries every 500ms. No DOM scans, no chat
      // queries. Lives next to the chat title so the user can glance.
      function updateStatPill() {
        try {
          const states = (typeof window !== 'undefined' && window.__padFlightStates) || [];
          const visible = states.filter(f => f && (f.active || f.transitioning) && f.designId);
          let air = visible.length;
          // Designs (for charging / ready counts)
          let designs = [];
          try { designs = (typeof getAllSavedDesigns === 'function') ? getAllSavedDesigns() : []; } catch (_) {}
          const flyingIds = new Set(visible.map(f => f.designId));
          const bgFleet = (typeof window !== 'undefined' && window.__backgroundOperatorFleet) || [];
          const bgIds = new Set(bgFleet.filter(f => f && f.designId).map(f => f.designId));
          const batteries = (typeof window !== 'undefined' && window.__padDesignBatteries) || null;
          const MIN_BATT = 95 - 0.05;
          let charge = 0, ready = 0;
          for (const d of designs) {
            if (flyingIds.has(d.id)) continue;
            if (bgIds.has(d.id)) continue;     // abstract — counts as committed, not ready
            const entry = batteries && batteries.get ? batteries.get(d.id) : null;
            const batt = entry && typeof entry.battery === 'number' ? entry.battery : 95;
            if (batt < MIN_BATT) charge++;
            else ready++;
          }
          const setN = (id, val) => { const el = document.getElementById(id); if (el) el.textContent = String(val); };
          setN('statpill-air', air);
          setN('statpill-charge', charge);
          setN('statpill-ready', ready);
          // Activity highlight on the airborne cell when > 0
          const airCell = document.querySelector('.statpill-air');
          if (airCell) airCell.classList.toggle('has-activity', air > 0);
          // Hold cell visibility tracks the global flag (in case it
          // got set by external code without going through executeSlashAction)
          const holdWrap = document.getElementById('statpill-hold-wrap');
          if (holdWrap) holdWrap.style.display = (window.__dispatchHold ? '' : 'none');
        } catch (_) { /* never throw from a UI tick */ }
      }
      // Run every 500ms — same cadence as the unified counter sync.
      // First tick now so the pill isn't blank before the first interval.
      updateStatPill();
      setInterval(updateStatPill, 500);
      // Expose for tests / manual force-refresh
      if (typeof window !== 'undefined') {
        window.__updateStatPill = updateStatPill;
        window.__parseSlashCommand = parseSlashCommand;
        window.__executeSlashAction = executeSlashAction;
      }

      function submitOperatorMessage() {
        const input = document.getElementById('pad-crew-input');
        if (!input) return;
        const text = (input.value || '').trim();
        if (!text) return;
        // ---- SLASH COMMAND INTERCEPT ----
        // If the message starts with "/", route it to the confirm-bar
        // flow instead of the AI chat. User: "execute with a confirm
        // tap" — slash command parses, shows in confirm bar; tap
        // CONFIRM to run it. Empty out the input either way.
        if (text.startsWith('/')) {
          const parsed = parseSlashCommand(text);
          if (parsed) {
            input.value = '';
            if (!parsed.valid) {
              // Show the validation error inline as a fake confirm
              // bar message — same UI, but the CONFIRM button is a no-op
              // (executePendingSlashCommand checks parsed.valid).
              showConfirmBar(parsed);
              // Auto-hide after 2.5s so the bar doesn't linger
              setTimeout(() => {
                if (__pendingSlashCommand && __pendingSlashCommand.command === parsed.command) hideConfirmBar();
              }, 2500);
              return;
            }
            showConfirmBar(parsed);
            return;
          }
        }
        // Sanitize — escape anything HTML-ish so user input can't inject
        // markup into the feed (we render m.body as innerHTML)
        const safeText = text
          .replace(/&/g, '&amp;')
          .replace(/</g, '&lt;')
          .replace(/>/g, '&gt;')
          .replace(/"/g, '&quot;');
        input.value = '';
        // Post as the operator
        postCrewMessage(
          { name: 'You', role: 'OPERATOR', cls: 'role-operator', icon: '👤' },
          safeText
        );
        // Classify and respond after a brief delay (feels human)
        const intent = classifyOperatorQuery(text);
        setTimeout(() => {
          const reply = buildCrewReply(intent, text);
          if (!reply) return;
          const responder = pickCrewByRole(reply.roleKey);
          if (responder) postCrewMessage(responder, reply.body);
        }, 800 + Math.random() * 700);     // 0.8-1.5s — natural reply delay
      }

      // Wire input + button after DOM is ready. Using delegated event
      // listeners on document so we don't need to re-bind on launchpad
      // open/close.
      document.addEventListener('keydown', (e) => {
        if (e.target && e.target.id === 'pad-crew-input' && e.key === 'Enter') {
          e.preventDefault();
          submitOperatorMessage();
        }
      });
      document.addEventListener('click', (e) => {
        if (e.target && e.target.id === 'pad-crew-send') {
          e.preventDefault();
          submitOperatorMessage();
        }
      });

      // Expose for tests
      window.__submitOperatorMessage = submitOperatorMessage;
      window.__classifyOperatorQuery = classifyOperatorQuery;
      window.__buildCrewReply = buildCrewReply;
      window.__findReferencedAircraft = findReferencedAircraft;

      // ============================================================
      // VOICE INPUT — speech-to-text for operator → crew chat
      // ============================================================
      // User: "add a voice to text (that only works when I am in the
      // hub not a customer)... so that I can voice communicate with
      // the AI hub people." Uses the browser's built-in
      // SpeechRecognition (`window.SpeechRecognition` or
      // `window.webkitSpeechRecognition`). On Chrome this routes audio
      // through Google's servers, on Safari through Apple's — both
      // free, no API key, no setup.
      //
      // For real Whisper offline (better accuracy, fully local), the
      // architecture would be: load transformers.js, fetch the
      // Whisper-tiny WASM model (~30MB) on first use, run inference
      // in a Web Worker. That's a 10-100x bigger feature footprint
      // and 30MB extra page load, so it's not the default. Swapping
      // it in later only changes the `recognitionStart` /
      // `recognitionStop` impl — the rest of this code stays the same.
      const padVoiceInputState = {
        recognition: null,
        recording: false,
        supported: typeof window.SpeechRecognition !== 'undefined' ||
                   typeof window.webkitSpeechRecognition !== 'undefined',
        interimText: '',
        finalText: '',
        lastError: null,
        diagnostics: {
          startCalls: 0,
          stopCalls: 0,
          finalsReceived: 0,
          messagesSubmitted: 0,
          blockedCustomerMode: 0,
          errors: 0,
        },
      };

      function initVoiceInput() {
        if (!padVoiceInputState.supported) return;
        const Ctor = window.SpeechRecognition || window.webkitSpeechRecognition;
        const r = new Ctor();
        r.lang = 'en-US';
        r.interimResults = true;
        // continuous=false: one utterance per click. The user clicks
        // the mic, speaks once, recognition ends, transcript submitted.
        // continuous=true would let them speak multiple sentences but
        // makes "when do I auto-submit" ambiguous. Click again to talk
        // again — simpler mental model.
        r.continuous = false;
        r.maxAlternatives = 1;

        r.onstart = () => {
          padVoiceInputState.recording = true;
          padVoiceInputState.interimText = '';
          padVoiceInputState.finalText = '';
          padVoiceInputState.lastError = null;
          updateMicUI();
          showMicStatus('🎤 Listening… speak now', 'recording');
        };
        r.onresult = (event) => {
          let interim = '', final = '';
          for (let i = event.resultIndex; i < event.results.length; i++) {
            const result = event.results[i];
            if (result.isFinal) final += result[0].transcript;
            else                interim += result[0].transcript;
          }
          padVoiceInputState.interimText = interim;
          if (final) padVoiceInputState.finalText += final;
          // Live preview while user is speaking
          const display = (padVoiceInputState.finalText + ' ' + interim).trim();
          if (display) showMicStatus('🎤 ' + display, 'recording');
        };
        r.onerror = (event) => {
          padVoiceInputState.diagnostics.errors++;
          padVoiceInputState.lastError = (event && event.error) || 'unknown';
          const err = padVoiceInputState.lastError;
          // 'no-speech', 'audio-capture', 'not-allowed', 'aborted', 'network'
          let msg = '';
          if (err === 'not-allowed' || err === 'service-not-allowed') {
            msg = '⚠ Microphone permission denied. Allow it in browser settings.';
          } else if (err === 'no-speech') {
            msg = '⚠ No speech detected. Click the mic and try again.';
          } else if (err === 'audio-capture') {
            msg = '⚠ No microphone found. Check macOS Settings → Privacy & Security → Microphone.';
          } else if (err === 'network') {
            msg = '⚠ Network error — speech recognition needs an internet connection.';
          } else if (err === 'aborted') {
            msg = '';     // user-initiated stop, not really an error
          } else {
            msg = '⚠ Speech recognition error: "' + err + '"';
          }
          if (msg) showMicStatus(msg, 'error');
        };
        r.onend = () => {
          padVoiceInputState.recording = false;
          updateMicUI();
          // If we got any final text, push it into the input field and
          // trigger the existing submitOperatorMessage path. The crew's
          // existing classify + reply pipeline handles the response —
          // we just deliver text into the same channel a typed message
          // would use. We also spawn a bubble + speak the reply, which
          // a typed message wouldn't normally do, since voice users
          // expect voice back.
          const final = padVoiceInputState.finalText.trim();
          if (final) {
            padVoiceInputState.diagnostics.finalsReceived++;
            const inp = document.getElementById('pad-crew-input');
            if (inp) {
              inp.value = final;
              // Use the voice-aware submit path so we know to speak the reply
              submitOperatorVoiceMessage();
            }
            showMicStatus('✓ Heard: "' + final + '"', '');
            setTimeout(() => hideMicStatus(), 2500);
          } else if (!padVoiceInputState.lastError) {
            showMicStatus('No speech captured.', '');
            setTimeout(() => hideMicStatus(), 2000);
          }
        };
        padVoiceInputState.recognition = r;
      }

      function showMicStatus(text, cls) {
        const el = document.getElementById('pad-crew-mic-status');
        if (!el) return;
        el.textContent = text;
        el.className = 'pad-crew-mic-status' + (cls ? ' ' + cls : '');
        el.removeAttribute('hidden');
      }
      function hideMicStatus() {
        const el = document.getElementById('pad-crew-mic-status');
        if (el) el.setAttribute('hidden', '');
      }
      function updateMicUI() {
        const btn = document.getElementById('pad-crew-mic');
        if (!btn) return;
        if (padVoiceInputState.recording) {
          btn.classList.add('recording');
          btn.textContent = '🔴';
          btn.title = 'Click to stop';
        } else {
          btn.classList.remove('recording');
          btn.textContent = '🎤';
          btn.title = 'Click to talk to your crew (hub only)';
        }
      }

      function startVoiceInput() {
        // Hub-only — suppressed at remote pickup/dropoff. User: "that
        // only works when I am in the hub not a customer."
        if (window.__customerModeActive) {
          padVoiceInputState.diagnostics.blockedCustomerMode++;
          showMicStatus('Voice chat is hub-only. Return to the hub to talk to your crew.', 'error');
          setTimeout(() => hideMicStatus(), 3000);
          return false;
        }
        if (!padVoiceInputState.supported) {
          showMicStatus('Speech recognition not available in this browser. Try Chrome or Safari.', 'error');
          setTimeout(() => hideMicStatus(), 3500);
          return false;
        }
        if (!padVoiceInputState.recognition) initVoiceInput();
        if (padVoiceInputState.recording) return false;     // already recording
        try {
          padVoiceInputState.diagnostics.startCalls++;
          padVoiceInputState.recognition.start();
          return true;
        } catch (err) {
          // Most common: 'InvalidStateError' if start() is called while
          // already running. Bail silently — UI will reflect actual state.
          padVoiceInputState.diagnostics.errors++;
          padVoiceInputState.lastError = String(err);
          showMicStatus('Could not start: ' + err.message, 'error');
          setTimeout(() => hideMicStatus(), 2500);
          return false;
        }
      }
      function stopVoiceInput() {
        if (!padVoiceInputState.recognition) return;
        if (!padVoiceInputState.recording) return;
        padVoiceInputState.diagnostics.stopCalls++;
        try { padVoiceInputState.recognition.stop(); }
        catch (_) { /* might already be stopped */ }
      }
      function toggleVoiceInput() {
        if (padVoiceInputState.recording) stopVoiceInput();
        else                              startVoiceInput();
      }

      // Voice-aware variant of submitOperatorMessage — goes through the
      // SAME submit path (so slash commands, classification, and reply
      // generation all still work) but ALSO spawns a bubble + speaks
      // the responder's reply, since the user is having a voice
      // conversation and expects voice back.
      function submitOperatorVoiceMessage() {
        const input = document.getElementById('pad-crew-input');
        if (!input) return;
        const text = (input.value || '').trim();
        if (!text) return;
        padVoiceInputState.diagnostics.messagesSubmitted++;
        // Use the existing classify + reply machinery directly so we
        // can intercept the responder and add bubble + TTS.
        const safeText = text.replace(/&/g, '&amp;').replace(/</g, '&lt;')
                             .replace(/>/g, '&gt;').replace(/"/g, '&quot;');
        input.value = '';
        postCrewMessage(
          { name: 'You', role: 'OPERATOR', cls: 'role-operator', icon: '👤' },
          safeText
        );
        // Slash commands bypass voice-reply (just run them silently)
        if (text.startsWith('/')) {
          const parsed = parseSlashCommand(text);
          if (parsed) {
            if (parsed.valid) showConfirmBar(parsed);
            return;
          }
        }
        const intent = classifyOperatorQuery(text);
        setTimeout(() => {
          const reply = buildCrewReply(intent, text);
          if (!reply) return;
          const responder = pickCrewByRole(reply.roleKey);
          if (!responder) return;
          postCrewMessage(responder, reply.body);
          // Speak it — voice in, voice out. spawnCrewBubble already
          // calls speakCrewLine internally, plus pops a comic bubble
          // over the responder's 3D figure. Strip HTML markup the
          // reply might have (bold tail numbers etc.) before speaking.
          try {
            const fig = findCrewFigureByName(responder.name);
            if (fig) {
              const plain = stripBubbleHtml(reply.body);
              spawnCrewBubble(fig, plain, { holdMs: 5500 });
            }
          } catch (_) {}
        }, 700 + Math.random() * 500);
      }

      // Wire the mic button click. Delegated handler so it survives
      // launchpad open/close cycles.
      document.addEventListener('click', (e) => {
        if (e.target && e.target.id === 'pad-crew-mic') {
          e.preventDefault();
          toggleVoiceInput();
        }
      });

      // Expose for tests + manual console use
      if (typeof window !== 'undefined') {
        window.__startVoiceInput = startVoiceInput;
        window.__stopVoiceInput  = stopVoiceInput;
        window.__toggleVoiceInput = toggleVoiceInput;
        window.__padVoiceInputState = padVoiceInputState;
        window.__submitOperatorVoiceMessage = submitOperatorVoiceMessage;
      }

      // ============================================================
      // END OPERATOR ↔ CREW CHAT
      // ============================================================

      function pickCrewByRole(roleKey) {
        const matches = padCrewRoster.filter(c => c.role === roleKey);
        if (matches.length === 0) return null;
        return matches[Math.floor(Math.random() * matches.length)];
      }
      function pickCrewRandom() {
        if (padCrewRoster.length === 0) return null;
        return padCrewRoster[Math.floor(Math.random() * padCrewRoster.length)];
      }

      function postCrewMessage(crew, body) {
        if (!crew) return;
        const msg = {
          name: crew.name,
          role: crew.role,
          cls: crew.cls,
          icon: crew.icon,
          body,
          t: Date.now(),
        };
        // Newest at top — simulates a live ops log
        padCrewMessages.unshift(msg);
        if (padCrewMessages.length > PAD_CREW_MAX_MESSAGES) {
          padCrewMessages.length = PAD_CREW_MAX_MESSAGES;
        }
        renderCrewFeed();
      }

      // Hook called by tryDispatchOneAiOrder when it picks an aircraft
      // and SENDS the dispatcher worker to walk to it. Triple effect:
      //   1. Text panel posts a dispatcher message
      //   2. (the dispatcher figure is already walking — driven by
      //      tryDispatchOneAiOrder itself, not this hook)
      //   3. Sometimes ATC handoff message + gesture follows
      //   4. Ground crew walks over for takeoff support (100% — every
      //      dispatch now has visible ground activity)
      window.__opsCrewLogDispatch = function(tail, from, to, designId) {
        const dispatcher = pickCrewByRole('DISPATCH');
        if (dispatcher) {
          postCrewMessage(dispatcher, `dispatching <span class="tail">${tail}</span> · <span class="pad-name">${from}</span> → <span class="pad-name">${to}</span>`);
        }
        // Sometimes ATC chimes in with the handoff (~40% of dispatches)
        if (Math.random() < 0.4) {
          const atc = pickCrewByRole('ATC');
          if (atc) {
            setTimeout(() => {
              postCrewMessage(atc, `<span class="tail">${tail}</span> cleared for departure, runway 09L`);
              try {
                if (typeof window.__triggerCrewGesture === 'function') {
                  window.__triggerCrewGesture('ATC');
                }
              } catch (_) {}
            }, 1200 + Math.random() * 800);
          }
        }
        // Ground crew ALWAYS walks to the aircraft for takeoff support.
        // Previously gated at 70%, but the user wanted constant visible
        // activity — every dispatch should have a ground crew member
        // visibly attending the aircraft.
        setTimeout(() => {
          try {
            if (typeof window.__assignCrewWork === 'function') {
              window.__assignCrewWork('GROUND', designId, 1500);
            }
          } catch (_) {}
        }, 600 + Math.random() * 600);
      };

      // Hook called by recordFlightCompletion. Triple effect:
      //   1. Text panel posts an ops "wheels-down" message
      //   2. 3D ops figure walks to the aircraft to inspect post-flight
      //   3. Ground crew ALWAYS walks for the turnaround (100% — was
      //      50%; user wanted constant activity)
      window.__opsCrewLogCompletion = function(tail, to, designId) {
        const ops = pickCrewByRole('OPS');
        if (ops) {
          postCrewMessage(ops, `<span class="tail">${tail}</span> wheels-down at <span class="pad-name">${to || 'hub'}</span> · mission complete`);
        }
        let assigned = false;
        try {
          if (typeof window.__assignCrewWork === 'function') {
            window.__assignCrewWork('OPS', designId, 2200);
            assigned = true;
          }
        } catch (_) {}
        if (!assigned) {
          try {
            if (typeof window.__triggerCrewGesture === 'function') {
              window.__triggerCrewGesture('OPS');
            }
          } catch (_) {}
        }
        // Ground crew ALWAYS does the turnaround (every landing gets
        // attended). Plus a maintenance check ~60% of the time so the
        // mechanic is also responsive to flight completions.
        setTimeout(() => {
          const ground = pickCrewByRole('GROUND');
          if (ground) {
            postCrewMessage(ground, `taxiing <span class="tail">${tail}</span> to charging apron`);
            try {
              if (typeof window.__assignCrewWork === 'function') {
                window.__assignCrewWork('GROUND', designId, 1800);
              } else if (typeof window.__triggerCrewGesture === 'function') {
                window.__triggerCrewGesture('GROUND');
              }
            } catch (_) {}
          }
        }, 1500 + Math.random() * 1200);
        // Maintenance follow-up — mechanic does post-flight inspection
        // on the just-landed aircraft (~60% of completions). Spaced
        // after the ground crew turnaround so the workers don't pile.
        if (Math.random() < 0.6) {
          setTimeout(() => {
            const mech = pickCrewByRole('MAINT');
            if (mech) {
              postCrewMessage(mech, `post-flight inspection on <span class="tail">${tail}</span>`);
              try {
