    // ============================================================
    // STORAGE LAYER — persist designs to localStorage
    // ============================================================
    const STORAGE_KEY = 'sdx_designs_v1';

    function getAllSavedDesigns() {
      try {
        const raw = localStorage.getItem(STORAGE_KEY);
        if (!raw) return [];
        const list = JSON.parse(raw);
        if (!Array.isArray(list)) return [];
        // Deduplicate by id — if two entries somehow share an id (legacy
        // double-saves, simultaneous Date.now() collisions, manual storage
        // edits), keep only the most recently saved one. Without this, the
        // apron rendering would place TWO aircraft on TWO pads from a single
        // logical design, manifesting as a "fleet duplication" visual bug.
        const byId = new Map();
        for (const d of list) {
          if (!d || !d.id) continue;
          const existing = byId.get(d.id);
          if (!existing || (d.savedAt || 0) > (existing.savedAt || 0)) {
            byId.set(d.id, d);
          }
        }
        return Array.from(byId.values());
      } catch (e) {
        console.warn('saved-designs read failed:', e);
        return [];
      }
    }

    // Status message visible to UI — set by persistDesigns when it has to
    // take recovery actions (pruning flight logs to fit a save under quota).
    // Read by performSave to surface the message in the save dialog.
    let lastPersistStatusMsg = '';
    function getLastPersistStatusMsg() { return lastPersistStatusMsg; }

    // Lossless design compaction. Old designs (saved before smart-bake)
    // serialize each primitive geometry as a full BufferGeometry with
    // thousands of full-precision floats — easily 10x larger than needed.
    // We can shrink them WITHOUT touching the design's structure or
    // visual appearance:
    //   1. Round all attribute float arrays to 5 decimal places. The
    //      original primitive constructors emit values that round-trip
    //      cleanly at this precision, and 5 decimals = ~10 microns at
    //      meter scale — well below visual perception.
    //   2. Deduplicate identical geometries (12 rotors usually share one
    //      shape). Three.js's serialization gives each geometry a UUID
    //      but the actual data is identical — we hash by attribute
    //      content and merge. Mesh references to dropped UUIDs get
    //      remapped to the survivor.
    // No design is ever deleted; only the in-memory representation gets
    // smaller before being JSON-stringified into localStorage.
    function compactDesignInPlace(design) {
      if (!design || !design.scene || !Array.isArray(design.scene.geometries)) return;
      const geometries = design.scene.geometries;
      const ROUND_DECIMALS = 5;
      const ROUND_FACTOR = Math.pow(10, ROUND_DECIMALS);
      function roundArr(arr) {
        if (!Array.isArray(arr) && !(arr && typeof arr.length === 'number')) return arr;
        const out = new Array(arr.length);
        for (let i = 0; i < arr.length; i++) {
          out[i] = Math.round(arr[i] * ROUND_FACTOR) / ROUND_FACTOR;
        }
        return out;
      }
      // STEP 1: round attribute arrays in every BufferGeometry
      for (const g of geometries) {
        if (!g || !g.data) continue;
        // BufferGeometry serializes as { uuid, type:'BufferGeometry', data: { attributes, index } }
        if (g.data.attributes) {
          for (const attrName of Object.keys(g.data.attributes)) {
            const attr = g.data.attributes[attrName];
            if (attr && attr.array) {
              attr.array = roundArr(attr.array);
            }
          }
        }
        // Index arrays are integers — no rounding, but we keep them as-is
      }
      // STEP 2: dedupe geometries by content hash
      const hashOf = (g) => {
        if (!g || !g.data) return '';
        try {
          // Hash by stringified attributes + index. Geometry type stays
          // the same (e.g. BufferGeometry → BufferGeometry) so we don't
          // need to include type in the hash.
          return JSON.stringify({ a: g.data.attributes, i: g.data.index });
        } catch (_) { return ''; }
      };
      const hashToFirstUuid = new Map();
      const uuidRemap = {};     // dupUuid → keptUuid
      for (const g of geometries) {
        if (!g || !g.uuid) continue;
        const h = hashOf(g);
        if (!h) continue;
        const existingUuid = hashToFirstUuid.get(h);
        if (existingUuid && existingUuid !== g.uuid) {
          uuidRemap[g.uuid] = existingUuid;
        } else {
          hashToFirstUuid.set(h, g.uuid);
        }
      }
      // Drop the duplicate geometries from the array
      design.scene.geometries = geometries.filter(g => !uuidRemap[g.uuid]);
      // Walk the scene's mesh objects and remap any geometry UUIDs that
      // pointed at a dropped duplicate to the kept survivor.
      function walkObj(obj) {
        if (!obj) return;
        if (obj.geometry && uuidRemap[obj.geometry]) {
          obj.geometry = uuidRemap[obj.geometry];
        }
        if (Array.isArray(obj.children)) {
          for (const c of obj.children) walkObj(c);
        }
      }
      walkObj(design.scene.object);
    }

    function persistDesigns(list) {
      lastPersistStatusMsg = '';
      try {
        localStorage.setItem(STORAGE_KEY, JSON.stringify(list));
        return true;
      } catch (e) {
        const isQuota = (e && (e.name === 'QuotaExceededError' ||
                               e.code === 22 || e.code === 1014 ||
                               /quota/i.test(e.message || '')));
        if (!isQuota) {
          console.warn('saved-designs write failed (non-quota):', e);
          return false;
        }
        console.warn('[storage] quota hit — entering recovery (designs untouched)');

        // STEP 1: prune flight logs to newest 10 per design and retry.
        // Lossless. Touches only flight history, not design data.
        try {
          const logsRaw = localStorage.getItem(FLIGHT_LOGS_KEY);
          if (logsRaw) {
            const logs = JSON.parse(logsRaw);
            if (logs && typeof logs === 'object') {
              for (const key of Object.keys(logs)) {
                if (Array.isArray(logs[key]) && logs[key].length > 10) {
                  logs[key] = logs[key].slice(-10);
                }
              }
              localStorage.setItem(FLIGHT_LOGS_KEY, JSON.stringify(logs));
            }
          }
        } catch (_) {}
        try {
          localStorage.setItem(STORAGE_KEY, JSON.stringify(list));
          return true;
        } catch (_) {}

        // STEP 2: drop flight logs entirely (still lossless for designs).
        try { localStorage.removeItem(FLIGHT_LOGS_KEY); } catch (_) {}
        try {
          localStorage.setItem(STORAGE_KEY, JSON.stringify(list));
          lastPersistStatusMsg = 'Cleared flight logs to fit save.';
          return true;
        } catch (_) {}

        // STEP 3: lossless design compaction. For old designs that were
        // saved before smart-bake (each primitive geometry stored as a
        // full BufferGeometry with thousands of full-precision floats),
        // we round vertex precision to 5 decimals and deduplicate
        // identical geometries. Visual appearance unchanged; storage
        // typically drops 5–10x. Mutates the list in place so subsequent
        // reads (and the in-memory design list) reflect the compacted
        // form too. NO design is removed.
        let compactedAny = false;
        for (const d of list) {
          const before = JSON.stringify(d).length;
          compactDesignInPlace(d);
          const after = JSON.stringify(d).length;
          if (after < before) compactedAny = true;
        }
        try {
          localStorage.setItem(STORAGE_KEY, JSON.stringify(list));
          if (compactedAny) {
            lastPersistStatusMsg = 'Compacted older designs to fit save (visual quality unchanged).';
          }
          return true;
        } catch (_) {}

        // STEP 4: even compaction wasn't enough. We still refuse to drop
        // designs. Tell the user clearly so they can manually delete one
        // from the hangar UI. Status message names how many they have.
        const designCount = list.length - 1;
        lastPersistStatusMsg = `Storage full. You have ${designCount} saved designs. ` +
          `Open the hangar and delete one manually, then retry. ` +
          `(I will NOT auto-delete designs — your data is yours.)`;
        console.warn('saved-designs write failed: ' + lastPersistStatusMsg);
        return false;
      }
    }

