          // Reference-based archetype overrides
          const isArcher = /\barcher\b|\bmidnight\b|12.tilt.6|twelve.tilt.six/.test(lower);
          const isJoby = /\bjoby\b|\bs4\b|tilt.rotor|tilting rotors?|wing.tip rotors?/.test(lower);
          const isVolo = /\bvolocopter\b|\bvolo\b|\bhalo\b|ring of rotors?/.test(lower);
          const isEhang = /\behang\b|216|x.?frame/.test(lower);
          const isStol = /\bstol\b|\bhybrid\b|fixed.wing|short take.?off|takeoff.?and.?landing/.test(lower);
          // Twin-boom rail / skycrane / heavy-lift cargo platform
          const isRail = /\b(skycrane|sky.?crane|twin.?boom|rail.?(?:hex|oct)\w*|cargo platform|cargo hauler|twin.?rotor.?rail|rotor rail)\b/.test(lower);
          // Fixed-wing prop placements — different motor types beyond
          // the usual VTOL rotors. User: "make the taxi's fixed wing
          // capable with different kind of motors like push motors."
          const isPushPull  = /\bpush.?pull\b|\bskymaster\b/.test(lower);
          const isPusher    = !isPushPull && /\bpusher( prop| propeller)?\b|push motor|rear.?mount(ed)? (prop|motor|engine)/.test(lower);
