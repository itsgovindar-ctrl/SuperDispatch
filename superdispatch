    .vtag-id { color: var(--accent-cyan); font-size: 13px; font-weight: 700; letter-spacing: 0.05em; }
    .vtag-status { color: var(--text-secondary); font-size: 9px; letter-spacing: 0.18em; }

    .fleet-telemetry {
      width: 360px;
      border-left: 1px solid var(--border);
      background: rgba(0, 0, 0, 0.3);
      overflow-y: auto;
      padding: 6px 0;
    }
    .telem-section {
      padding: 12px 18px 14px;
      border-bottom: 1px solid var(--border);
    }
    .telem-section:last-child { border-bottom: 0; }
    .telem-section-title {
      font-family: var(--font-mono);
      font-size: 9px;
      letter-spacing: 0.18em;
      color: var(--accent-cyan);
      margin-bottom: 8px;
    }
    .telem-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 5px 0;
      font-family: var(--font-mono);
      font-size: 11px;
    }
    .telem-row .t-label { color: var(--text-secondary); letter-spacing: 0.04em; }
    .telem-row .t-value {
      color: var(--text-primary);
      font-variant-numeric: tabular-nums;
    }
