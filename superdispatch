          case 'MOVE': {
            const r = moveByName(cmd.name, cmd.dx, cmd.dy, cmd.dz, cmd.mode);
            if (!r) return { error: `no part named "${cmd.name}"` };
            const sign = cmd.mode === 'to' ? 'now at' : 'shifted by';
            return {
              parsed: `<span class="pkey">action:</span> <span class="pval">MOVE</span> &nbsp; <span class="pkey">name:</span> <span class="pval">${cmd.name}</span> &nbsp; <span class="pkey">${cmd.mode}:</span> <span class="pval">${fmt(cmd.dx)},${fmt(cmd.dy)},${fmt(cmd.dz)}</span>`,
              result: `<span class="check">✓</span>${sign} (${fmt(r.x)}, ${fmt(r.y)}, ${fmt(r.z)})`
            };
          }

          case 'MOVE_BATCH': {
            if (!cmd.names || cmd.names.length === 0) return { error: 'no matching parts found' };
            let count = 0;
            for (const n of cmd.names) {
              if (moveByName(n, cmd.dx, cmd.dy, cmd.dz, cmd.mode)) count++;
            }
            const list = cmd.names.length > 4 ? `${cmd.names.length} parts` : cmd.names.join(', ');
            return {
              parsed: `<span class="pkey">action:</span> <span class="pval">MOVE</span> &nbsp; <span class="pkey">parts:</span> <span class="pval">${list}</span> &nbsp; <span class="pkey">${cmd.mode}:</span> <span class="pval">${fmt(cmd.dx)},${fmt(cmd.dy)},${fmt(cmd.dz)}</span>`,
              result: `<span class="check">✓</span>moved <span class="val">${count}</span> part${count===1?'':'s'}`
            };
