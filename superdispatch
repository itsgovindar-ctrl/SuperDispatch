      updateUndoButton();

      // Join all parts into a single welded assembly. The current behavior:
      // every entry in partsRegistry has its mesh re-parented under a single
      // 'welded_assembly' group. The individual parts remain registered so the
      // inspector and analyzers still see them, but they share one transform
      // anchor — moving the assembly translates everything together. Pressing
      // Cmd+J again toggles back to unjoined state.
      let weldedGroup = null;
      function joinAllParts() {
        if (partsRegistry.size === 0) return;
        // If already welded, UN-WELD: re-parent each part back to taxi while
        // preserving its current world transform. (Two-press toggle.)
        if (weldedGroup) {
          if (typeof pushUndo === 'function') pushUndo();
          // Bake the welded group's transform into each child by reading their
          // world matrices, re-parenting to taxi, and re-applying the world matrix.
          const children = weldedGroup.children.slice();
          for (const c of children) {
            // Compute world matrix of child while still inside weldedGroup
            c.updateMatrixWorld(true);
            const wm = c.matrixWorld.clone();
            // Re-parent to taxi
            taxi.attach(c);   // attach() preserves world transform
            void wm;          // not needed since attach() handles it
          }
          taxi.remove(weldedGroup);
          weldedGroup = null;
          // Reset taxi transform so subsequent moves don't accumulate
          // (parts now hold their world coords directly on themselves)
          if (typeof flashStatus === 'function') flashStatus('Parts un-joined — drag individually');
          else console.log('[join] parts un-joined');
          return;
        }
        // WELD: create a new group, move all part objects into it. Use attach()
        // to preserve each part's world transform during the re-parent.
        if (typeof pushUndo === 'function') pushUndo();
        weldedGroup = new THREE.Group();
        weldedGroup.userData.welded = true;
        taxi.add(weldedGroup);
        for (const [name, info] of partsRegistry) {
          if (!info.object) continue;
          // attach() preserves world transform during re-parent — important so
          // parts don't shift when we change their parent from taxi → weldedGroup
          weldedGroup.attach(info.object);
        }
        if (typeof flashStatus === 'function') flashStatus('Parts joined — Cmd+J again to unjoin');
        else console.log('[join] parts welded — press Cmd+J again to unjoin');
