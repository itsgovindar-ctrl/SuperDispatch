      // ====================================================================
      // LUXURY CABIN — premium touches the AI team always installs.
      // User: "the AI team should do interiors such as chairs, indoor
      // luxury." Adds VISIBLE-FROM-OUTSIDE features:
      //   - Underglow LED strip (cyan emissive, runs under fuselage)
      //   - Chrome accent trim along fuselage waistline (both sides)
      //   - Glowing dashboard panel inside the cockpit (visible
      //     through the bubble canopy)
      // Seats themselves are already upgraded to leather material with
      // headrests in buildEVTOL.
      // ====================================================================
      function addLuxuryCabin(spec = {}) {
        // Pull fuselage geometry from the actual build if not in spec.
        // This lets click handler call __addLuxuryCabin({}) without
        // knowing the fuselage details — they're already in the
        // registry from buildEVTOL's registerPart('evtol_fuselage', …).
        let fuselageLen = spec.fuselageLen;
        let fuselageRadius = spec.fuselageRadius;
        let fuselageFlat = spec.fuselageFlat;
        if (typeof fuselageLen !== 'number' ||
            typeof fuselageRadius !== 'number' ||
            typeof fuselageFlat !== 'number') {
          const fus = (typeof partsRegistry !== 'undefined') ? partsRegistry.get('evtol_fuselage') : null;
          if (fus && fus.dims) {
            fuselageLen = fus.dims.l;
            fuselageRadius = fus.dims.w / 2;
            // dims.h = radius*2 * flat → flat = h/w
            fuselageFlat = (fus.dims.w > 0) ? (fus.dims.h / fus.dims.w) : 0.85;
          }
        }
        // Defaults if registry lookup failed
        if (typeof fuselageLen    !== 'number') fuselageLen    = 5.6;
        if (typeof fuselageRadius !== 'number') fuselageRadius = 0.7;
        if (typeof fuselageFlat   !== 'number') fuselageFlat   = 0.85;
        // Anchor every luxury part to the ACTUAL fuselage geometry,
        // not hardcoded altitudes — otherwise parts float below
        // squashed (raft-style) fuselages. User: "the AI needs to
        // know that floating parts is not acceptable."
        const fuselageBottom = 1.45 - fuselageRadius * fuselageFlat;
        const fuselageTop = 1.45 + fuselageRadius * fuselageFlat;
        // 1. Underglow LED strip — sits flush against fuselage bottom
        const underglowMat = new THREE.MeshStandardMaterial({
          color: 0x00ddff, emissive: 0x00ddff, emissiveIntensity: 1.2,
        });
        const underglow = new THREE.Mesh(
          new THREE.BoxGeometry(fuselageLen * 0.7, 0.04, 0.5), underglowMat
        );
        underglow.position.set(0, fuselageBottom + 0.02, 0);     // FLUSH (was 0.85 → floated)
        taxi.add(underglow);
        registerPart('evtol_lux_underglow', {
          object: underglow, type: 'box', kind: 'lux',
          dims: { l: fuselageLen * 0.7, w: 0.5, h: 0.04 },
        });
        // 2. Chrome trim stripes along fuselage waistline (both sides)
        const chromeMat = new THREE.MeshStandardMaterial({
          color: 0xeeeeee, metalness: 0.95, roughness: 0.10,
        });
        for (let side = 0; side < 2; side++) {
          const sign = side === 0 ? 1 : -1;
          const trim = new THREE.Mesh(
            new THREE.BoxGeometry(fuselageLen * 0.85, 0.05, 0.05), chromeMat
          );
          // Anchor to fuselage equator (y=1.45 is fuselage centerline)
          // and z=±radius so trim sits ON the fuselage skin
          trim.position.set(0, 1.45, sign * (fuselageRadius + 0.02));
          taxi.add(trim);
          registerPart(`evtol_lux_trim_${side}`, {
            object: trim, type: 'box', kind: 'lux',
            dims: { l: fuselageLen * 0.85, w: 0.05, h: 0.05 },
          });
        }
        // 3. Glowing dashboard panel inside cockpit (in front of pilot)
        const dashMat = new THREE.MeshStandardMaterial({
          color: 0x00ff88, emissive: 0x00ff88, emissiveIntensity: 0.9,
        });
        const dash = new THREE.Mesh(
          new THREE.BoxGeometry(0.5, 0.08, 0.55), dashMat
        );
        dash.position.set(-1.85, 1.55, 0);
        taxi.add(dash);
        registerPart('evtol_lux_dashboard', {
          object: dash, type: 'box', kind: 'lux',
          dims: { l: 0.5, w: 0.55, h: 0.08 },
        });
      }
      if (typeof window !== 'undefined') {
        window.__addLuxuryCabin = addLuxuryCabin;
      }

      // Auto-balance: fix the design so it passes the test suite.
      // Strategies (applied as needed):
      //   1. Pitch/roll imbalance → recenter rotor cluster X/Z to match the CoM
      //   2. Too few rotors → add rotors symmetrically until count >= 4
      //   3. Disturbance score low → ensure left/right symmetry of all parts
      function applyAutoBalance(opts = {}) {
        const skipRotorPadding = !!opts.skipRotorPadding;
        const fixes = [];
        const m = (typeof computeFlightMetrics === 'function') ? computeFlightMetrics() : null;

        // Step 1: rotors — count and rebalance
        const rotorEntries = [];
        for (const [name, info] of partsRegistry) {
          if (info.kind === 'rotor' && info.object) rotorEntries.push({ name, info });
        }

        // If fewer than 4 rotors, add more — UNLESS the user explicitly asked for a
        // specific count (e.g. "tricopter" → 3 rotors, "bicopter" → 2). Respect intent.
        if (!skipRotorPadding && rotorEntries.length < 4) {
          const needed = 4 - rotorEntries.length;
          for (let i = 0; i < needed; i++) {
            // Find a rotor whose mirror doesn't already exist; clone it across Z
            const src = rotorEntries[i % rotorEntries.length];
            if (!src) break;
            const newName = mirrorByName(src.name, 'z');
            if (newName) {
              fixes.push(`added mirrored rotor ${newName}`);
              rotorEntries.push({ name: newName, info: partsRegistry.get(newName) });
            } else {
              // Fallback: duplicate at offset
              const clone = src.info.object.clone(true);
              clone.position.x += 0.5;
              const dup = uniqueName('rotor_balance');
              clone.userData = { ...src.info.object.userData, partName: dup };
              taxi.add(clone);
              registerPart(dup, { ...src.info, object: clone });
              fixes.push(`added rotor ${dup}`);
              rotorEntries.push({ name: dup, info: partsRegistry.get(dup) });
            }
          }
        }

        // Step 2: recenter rotor cluster to CoM (X and Z axis pitch/roll balance)
        if (rotorEntries.length > 0) {
          // Recompute CoM with current state
          const m2 = computeFlightMetrics();
          // Current rotor cluster center
          const cluster = new THREE.Vector3();
          for (const { info } of rotorEntries) {
            const box = new THREE.Box3().setFromObject(info.object);
            const c = new THREE.Vector3(); box.getCenter(c);
            cluster.add(c);
          }
          cluster.divideScalar(rotorEntries.length);
          // Required shift
          const shiftX = m2.com.x - cluster.x;
          const shiftZ = m2.com.z - cluster.z;
          if (Math.abs(shiftX) > 0.05 || Math.abs(shiftZ) > 0.05) {
            for (const { info } of rotorEntries) {
              info.object.position.x += shiftX;
              info.object.position.z += shiftZ;
            }
            // Booms too, since rotors usually sit on them
            for (const [, info] of partsRegistry) {
              if ((info.kind === 'boom' || info.kind === 'arm') && info.object) {
                info.object.position.x += shiftX;
                info.object.position.z += shiftZ;
              }
            }
            fixes.push(`shifted rotor cluster ${(Math.hypot(shiftX, shiftZ) * 1000).toFixed(0)}mm to match CoM`);
          }
        }

        // Step 3: enforce left/right symmetry on everything else (fixes disturbance recovery)
        const symResult = applySymmetry();
        if (symResult.created.length) fixes.push(`mirrored ${symResult.created.length} part${symResult.created.length===1?'':'s'} for symmetry`);
        if (symResult.snapped.length) fixes.push(`snapped ${symResult.snapped.length / 2} pair${symResult.snapped.length===2?'':'s'} to symmetric positions`);

        if (selectionBoxHelper && selectedPartName) selectionBoxHelper.update();
        refreshGeometryStats();
        return { fixes };
      }

      // ==================== TRANSFORMS BY NAME ====================
      function moveByName(name, dx, dy, dz, mode) {
        const p = partsRegistry.get(name);
        if (!p) return null;
        const o = p.object;
        if (mode === 'to') o.position.set(dx, dy, dz);
        else { o.position.x += dx; o.position.y += dy; o.position.z += dz; }
        return { x: o.position.x, y: o.position.y, z: o.position.z };
      }

      function rotateByName(name, rxDeg, ryDeg, rzDeg) {
        const p = partsRegistry.get(name);
        if (!p) return null;
        const o = p.object;
        o.rotation.x += rxDeg * Math.PI / 180;
        o.rotation.y += ryDeg * Math.PI / 180;
        o.rotation.z += rzDeg * Math.PI / 180;
        return { x: o.rotation.x, y: o.rotation.y, z: o.rotation.z };
      }

      function scaleByName(name, sx, sy, sz) {
        const p = partsRegistry.get(name);
        if (!p) return null;
        const o = p.object;
        o.scale.set(o.scale.x * sx, o.scale.y * sy, o.scale.z * sz);
        return { x: o.scale.x, y: o.scale.y, z: o.scale.z };
      }

      function mirrorByName(name, axis, newName) {
        const p = partsRegistry.get(name);
        if (!p) return null;
        const o = p.object;
        const final = uniqueName(newName || `${name}_mirror`);
        const cloned = o.clone(true);
        // Mirror = scale -1 on the axis. Note scaling a Group works.
        if (axis === 'x') cloned.scale.x *= -1;
        else if (axis === 'y') cloned.scale.y *= -1;
        else if (axis === 'z') cloned.scale.z *= -1;
        // Mirror position too (so a left-side part becomes right-side)
        if (axis === 'x') cloned.position.x = -o.position.x;
        else if (axis === 'y') cloned.position.y = -o.position.y;
        else if (axis === 'z') cloned.position.z = -o.position.z;
        taxi.add(cloned);
        // Copy registry data so the mirrored part can be referenced
        const dup = Object.assign({}, p, { object: cloned });
        if (p.tips) {
          dup.tips = p.tips.map(t => ({ ...t, [axis]: -t[axis] }));
        }
        if (p.side) dup.side = (p.side === 'left' ? 'right' : 'left');
        registerPart(final, dup);
        refreshGeometryStats();
        return { name: final, position: cloned.position };
      }

      // ==================== MATERIAL ====================
      function lerpColor(material, hex, dur = 500) {
        return new Promise(resolve => {
          const start = material.color.clone();
          const end = new THREE.Color(hex);
          const t0 = performance.now();
          (function step() {
            const t = Math.min(1, (performance.now() - t0) / dur);
            material.color.lerpColors(start, end, t);
            if (t < 1) requestAnimationFrame(step); else resolve();
          })();
        });
      }

      async function setColor(target, hex) {
        const m = materials[target];
        if (!m) return;
        await lerpColor(m, hex, 500);
        if (target === 'trim') {
          m.emissive.set(hex);
          m.emissive.multiplyScalar(0.7);
        }
        const cMap = { primary: 'color-primary', accent: 'color-accent', trim: 'color-trim' };
        const hMap = { primary: 'hex-primary',   accent: 'hex-accent',   trim: 'hex-trim' };
        document.getElementById(cMap[target]).value = hex;
        document.getElementById(hMap[target]).value = hex.replace('#', '').toUpperCase();
        document.querySelectorAll('.preset-card.active').forEach(el => el.classList.remove('active'));
      }

      // ==================== SCENE STATS ====================
      function refreshGeometryStats() {
        let v = 0, f = 0;
        taxi.traverse(o => {
          if (o.geometry?.attributes?.position) {
            v += o.geometry.attributes.position.count;
            if (o.geometry.index) f += o.geometry.index.count / 3;
            else f += o.geometry.attributes.position.count / 3;
          }
        });
        const set = (id, val) => { const el = document.getElementById(id); if (el) el.textContent = val; };
        set('geo-verts', Math.round(v).toLocaleString());
        set('geo-faces', Math.round(f).toLocaleString());
        set('geo-mats', '7');
        set('render-mode', document.getElementById('toggle-wireframe')?.classList.contains('active') ? 'WIREFRAME' : 'SOLID');
      }

      function refreshSpecsFromFuselage() {
        const D = getFuselageDims();
        const set = (id, v) => { const el = document.getElementById(id); if (el) el.textContent = v; };
        set('spec-length', (D.L * 2).toFixed(1) + ' m');
        set('spec-width', (D.W * 2 + 1.5).toFixed(1) + ' m');
        set('spec-height', (D.H * 2.4).toFixed(1) + ' m');
        set('spec-ceiling', '3,000 m');
        if (D.pax) set('spec-pax', D.pax + ' pax');
        if (D.mass) set('spec-mass', D.mass.toLocaleString() + ' kg');
      }

      function clearScene() {
        for (const [n] of partsRegistry) disposeRegistered(n);
        partsRegistry.clear();
        rotors = [];
        document.getElementById('viewport').classList.remove('has-vehicle');
        document.querySelectorAll('[data-fuselage]').forEach(b => b.classList.remove('active'));
        document.getElementById('rotor-hexacopter')?.classList.remove('active');
        const blank = (id, v) => { const el = document.getElementById(id); if (el) el.textContent = v; };
        ['spec-length','spec-width','spec-height','spec-mass','spec-pax','spec-range','spec-cruise','spec-ceiling'].forEach(id => blank(id, '—'));
        blank('geo-verts', '0'); blank('geo-faces', '0'); blank('geo-mats', '—'); blank('render-mode', '—');
        blank('build-id', '—'); blank('unit-cost', '—'); blank('lead-time', '—');
      }

      // ==================== UNDO SYSTEM ====================
      const undoStack = [];
      const MAX_UNDO = 200;
      const NON_STATEFUL_ACTIONS = new Set(['LIST', 'HELP', 'INFO', 'NOOP']);

      function snapshotState() {
        const parts = [];
        for (const [name, info] of partsRegistry) {
          if (!info.object) continue;
          parts.push({
            name,
            info,                                  // shared reference — object stays alive
            pos:   info.object.position.clone(),
            rot:   info.object.rotation.clone(),
            scale: info.object.scale.clone(),
            visible: info.object.visible
          });
        }
        return {
          parts,
          materials: {
            primary: materials.primary.color.getHex(),
            accent:  materials.accent.color.getHex(),
            trim:    materials.trim.color.getHex(),
            trimEm:  materials.trim.emissive.getHex()
          },
          rotors: rotors.slice(),
          ui: {
            tail:     document.getElementById('tail-number')?.value ?? '',
            operator: document.getElementById('operator')?.value ?? '',
            activeFuselage: document.querySelector('[data-fuselage].active')?.dataset.fuselage || null,
            rotorActive: document.getElementById('rotor-hexacopter')?.classList.contains('active') || false
          }
        };
      }

      function restoreState(snap) {
        // Drop selection first — selected part might be removed/altered by the restore
        if (typeof deselectPart === 'function') deselectPart();
        const snapByName = new Map(snap.parts.map(p => [p.name, p]));

        // 1. Detach parts that exist now but shouldn't (no dispose — object stays alive)
        for (const name of Array.from(partsRegistry.keys())) {
          if (!snapByName.has(name)) {
            const info = partsRegistry.get(name);
            if (info.object) taxi.remove(info.object);
            partsRegistry.delete(name);
          }
        }
        // 2. Re-attach + restore transforms
        for (const p of snap.parts) {
          if (!partsRegistry.has(p.name)) {
            taxi.add(p.info.object);
            partsRegistry.set(p.name, p.info);
          }
          p.info.object.position.copy(p.pos);
          p.info.object.rotation.copy(p.rot);
          p.info.object.scale.copy(p.scale);
          p.info.object.visible = p.visible;
        }
        // 3. Restore materials
        materials.primary.color.setHex(snap.materials.primary);
        materials.accent.color.setHex(snap.materials.accent);
        materials.trim.color.setHex(snap.materials.trim);
        materials.trim.emissive.setHex(snap.materials.trimEm);
        // 4. Restore rotors array
        rotors.length = 0;
        for (const r of snap.rotors) rotors.push(r);
        // 5. Restore UI fields
        const tailEl = document.getElementById('tail-number');
        const opEl   = document.getElementById('operator');
        if (tailEl) tailEl.value = snap.ui.tail;
        if (opEl)   opEl.value   = snap.ui.operator;
        // 6. Restore active states
        document.querySelectorAll('[data-fuselage]').forEach(b => b.classList.remove('active'));
        if (snap.ui.activeFuselage) {
          document.querySelector(`[data-fuselage="${snap.ui.activeFuselage}"]`)?.classList.add('active');
        }
        const rotorRow = document.getElementById('rotor-hexacopter');
        if (rotorRow) {
          if (snap.ui.rotorActive) rotorRow.classList.add('active');
          else rotorRow.classList.remove('active');
        }
        // 7. Sync color pickers
        const syncPicker = (id, hexId, hex) => {
          const v = '#' + hex.toString(16).padStart(6, '0').toUpperCase();
          const colorEl = document.getElementById(id);
          const hexEl   = document.getElementById(hexId);
          if (colorEl) colorEl.value = v;
          if (hexEl)   hexEl.value   = v.replace('#', '');
        };
        syncPicker('color-primary', 'hex-primary', snap.materials.primary);
        syncPicker('color-accent',  'hex-accent',  snap.materials.accent);
        syncPicker('color-trim',    'hex-trim',    snap.materials.trim);
        // 8. Refresh derived state
        refreshGeometryStats?.();
        if (partsRegistry.has('fuselage')) refreshSpecsFromFuselage?.();
        // 9. Update has-vehicle class
        const vp = document.getElementById('viewport');
        if (vp) {
          if (partsRegistry.size === 0) vp.classList.remove('has-vehicle');
          else vp.classList.add('has-vehicle');
        }
        updateUndoButton();
      }

      function pushUndo() {
        undoStack.push(snapshotState());
        if (undoStack.length > MAX_UNDO) undoStack.shift();
        updateUndoButton();
      }

      function performUndo() {
        if (undoStack.length === 0) return false;
        const snap = undoStack.pop();
        restoreState(snap);
        const hist = document.getElementById('ai-history');
        if (hist) {
          const div = document.createElement('div');
          div.className = 'chat-msg ai info';
          div.innerHTML = `<div class="chat-result"><span class="check">↶</span>reverted last change <span style="opacity:0.5">·</span> <span style="opacity:0.7">${undoStack.length} step${undoStack.length===1?'':'s'} remaining</span></div>`;
          hist.appendChild(div);
          hist.scrollTop = hist.scrollHeight;
        }
        return true;
      }

