        const looksLikeJustColorChange = isShortPrompt && colorParseResult && (
          isPureColorCmd ||
          /^\s*(paint|color)\b/.test(lower) ||
          // "<color>" or "all <color>" alone
          lower.trim().split(/\s+/).length <= 4 && /\b(red|blue|green|yellow|orange|purple|black|white|silver|gold|cyan|teal|navy|crimson|magenta|charcoal|gray|grey|pink|brown|maroon|olive)\b/.test(lower)
        );
