    .fleet-network-pill {
      font-family: var(--font-mono);
      font-size: 10px;
      letter-spacing: 0.16em;
      padding: 3px 8px;
      border-radius: 2px;
      background: rgba(74, 222, 128, 0.1);
      color: #4ade80;
      border: 1px solid rgba(74, 222, 128, 0.3);
