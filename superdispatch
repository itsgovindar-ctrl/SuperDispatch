      // Drag the inspector by its header so it never blocks the gizmo handles
      (function makeInspectorDraggable() {
        const header = insEl?.querySelector('.inspector-header');
        if (!insEl || !header) return;
        let dragging = false, startX = 0, startY = 0, startLeft = 0, startTop = 0;
        header.addEventListener('pointerdown', (e) => {
          // Don't start drag if user clicked the close button or any input
          if (e.target.closest('button, input')) return;
          const rect = insEl.getBoundingClientRect();
          const parentRect = insEl.offsetParent.getBoundingClientRect();
          // Convert to absolute left/top so we can drag freely (clear right/bottom)
          insEl.style.left = (rect.left - parentRect.left) + 'px';
          insEl.style.top  = (rect.top  - parentRect.top)  + 'px';
          insEl.style.right = 'auto';
          insEl.style.bottom = 'auto';
          startLeft = rect.left - parentRect.left;
          startTop  = rect.top  - parentRect.top;
          startX = e.clientX; startY = e.clientY;
          dragging = true;
          insEl.classList.add('dragging');
          header.setPointerCapture(e.pointerId);
        });
        header.addEventListener('pointermove', (e) => {
          if (!dragging) return;
          const dx = e.clientX - startX;
          const dy = e.clientY - startY;
          const parent = insEl.offsetParent;
          // Clamp to viewport bounds with a small margin
          const maxLeft = parent.clientWidth - insEl.offsetWidth - 8;
          const maxTop  = parent.clientHeight - insEl.offsetHeight - 8;
          const newLeft = Math.max(8, Math.min(maxLeft, startLeft + dx));
          const newTop  = Math.max(8, Math.min(maxTop, startTop + dy));
          insEl.style.left = newLeft + 'px';
          insEl.style.top  = newTop  + 'px';
        });
        const endDrag = (e) => {
          if (!dragging) return;
          dragging = false;
          insEl.classList.remove('dragging');
          try { header.releasePointerCapture(e.pointerId); } catch {}
        };
        header.addEventListener('pointerup', endDrag);
        header.addEventListener('pointercancel', endDrag);
