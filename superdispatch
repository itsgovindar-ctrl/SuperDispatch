    function showManufacturing() {
      document.getElementById('splash-view').classList.remove('active');
      document.getElementById('mfg-view').classList.add('active');
      if (!mfgInitialized) {
        initManufacturing();
        mfgInitialized = true;
      } else if (window.__pendingLoadDesign && typeof window.__loadSavedDesign === 'function') {
        // Already initialized — load the pending design directly
        const toLoad = window.__pendingLoadDesign;
        window.__pendingLoadDesign = null;
        setTimeout(() => window.__loadSavedDesign(toLoad), 60);
      }
      requestAnimationFrame(() => { if (window.__mfgResize) window.__mfgResize(); });
      // Refresh AI manufacturing team roster — if the user has been to
      // the launchpad, the cached roster is now populated and the team
      // chip list should reflect those names.
      try {
        if (typeof window.__renderAiTeamRoster === 'function') {
          window.__renderAiTeamRoster();
