      // Role-appropriate narration phrases — picked at random by the
      // narration interval so the user sees WHO is doing WHAT during
      // the build. The team feels alive instead of static chips.
      const AI_TEAM_NARRATION = {
        DISPATCH: [
          'clearing the design with FAA',
          'filing build paperwork',
          'registering tail number',
          'requesting hangar slot',
          'verifying weight & balance',
        ],
        OPS: [
          'reviewing the parts list',
          'approving the assembly order',
          'QA-ing the geometry',
          'cross-checking the spec',
          'signing off on the airframe',
        ],
        MAINT: [
          'torquing fasteners on the fuselage',
          'mounting the rotor assemblies',
          'installing avionics rack',
          'routing battery harness',
          'aligning the tail surfaces',
          'pre-flight checks underway',
          'fitting the canopy',
        ],
        GROUND: [
          'staging components on the line',
          'moving the cart into position',
          'prepping the tow bar',
          'clearing FOD around the build',
        ],
        ATC: [
          'logging the build for the manifest',
          'reserving departure slot',
          'noting the new airframe ID',
