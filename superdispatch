      const ADD_VERBS    = ['add','create','make','build','put','attach','install','give','slap','throw','place','include','need','want','should have','must have','start with','begin with'];
      const REMOVE_VERBS = ['remove','delete','drop','take off','get rid of','scrap','kill','strip','lose'];

      function escRegex(s) { return s.replace(/[.*+?^${}()|[\]\\]/g, '\\$&'); }

      function findFirstKey(text, map) {
        for (const [key, kws] of Object.entries(map)) {
          for (const kw of kws) {
            if (new RegExp(`\\b${escRegex(kw)}\\b`, 'i').test(text)) return key;
          }
        }
        return null;
      }

      function findAllKeys(text, map) {
        const found = {};
        for (const [key, kws] of Object.entries(map)) {
          for (const kw of kws) {
            if (new RegExp(`\\b${escRegex(kw)}\\b`, 'i').test(text)) {
              found[key] = true; break;
            }
          }
        }
        return found;
      }

      function detectArmPosition(text) {
        if (/\bsides?\b/.test(text)) return 'sides';
        if (/\b(front|forward)\b/.test(text)) return 'front';
        if (/\b(back|rear|aft)\b/.test(text)) return 'rear';
        if (/\bcorners?\b/.test(text)) return 'corners';
        return 'around';
      }

      // Pull a multiplier out of phrases like "2 times", "twice", "thrice", "3x", "1.5×"
      function extractFactor(text, fallback = 1.5) {
        if (/\bdouble\b|\btwice\b/.test(text)) return 2;
        if (/\btriple\b|\bthrice\b/.test(text)) return 3;
        if (/\bquadruple\b/.test(text)) return 4;
        if (/\bhalf\b/.test(text)) return 2;       // returns positive; caller decides direction
        const m = text.match(/(\d+(?:\.\d+)?)\s*(?:times|x|×)/);
        if (m) return parseFloat(m[1]);
        return fallback;
      }

      function detectRotorPosition(text) {
        // Wing-tip placement (Joby-style — rotors on the outer wing tips)
        if (/on\s+(?:each|every|the|all)?\s*wing\s*(?:tips?)?/.test(text) || /\bwing\s+tips?\b/.test(text)) return 'wing_tips';
        if (/on\s+(?:each|every|the|all)\s+(?:boom|tip)/.test(text) || /\bboom\s+tips?\b/.test(text)) return 'boom_tips';
        if (/on\s+(?:each|every|the)\s+arm/.test(text)) return 'arm_tips';
        if (/\btop\b/.test(text) && !/arm|boom/.test(text)) return 'top';
        if (/\bcorners?\b/.test(text)) return 'corners';
        return 'arm_tips';
      }

      // ==================== COMMAND PARSER (permissive) ====================
      function parseCommand(text) {
        const t = text.trim();
        if (!t) return { action: 'EMPTY' };
        const lower = t.toLowerCase();

        // ---------- Tier 1: structured commands (highest priority) ----------

        // HELP / RESET / LIST
        if (/^(help|\?|commands?|usage)\b/.test(lower)) return { action: 'HELP' };
        if (/^(reset|clear|wipe|empty|start over|delete all|remove all)\b/.test(lower)) return { action: 'CLEAR' };
        if (/^(list|parts|show parts|inventory)\b/.test(lower)) return { action: 'LIST' };

        // Tail number / operator
        const nm = t.match(/(?:tail\s*number|name\s+(?:it|to)|call\s+it|registration|reg)\s+([A-Z0-9\-]+)/i);
        if (nm) return { action: 'SET_TAIL_NUMBER', value: nm[1].toUpperCase() };
        const op = t.match(/^operator\s+(.+)/i);
        if (op) return { action: 'SET_OPERATOR', value: op[1].toUpperCase() };

        // CAD primitive: "create box NAME 2x0.7x0.6"
        const cm = lower.match(/^(?:create|make|build)\s+(box|cube|cylinder|tube|sphere|cone|torus|disc|disk)\s+(\w+)?\s*(.*)/);
        if (cm) {
          const shape = cm[1] === 'cube' ? 'box' : cm[1];
          const name = cm[2] || shape;
          const rest = cm[3] || '';
          const dim = parseDimString(rest);
          const kvs = parseKVs(rest);
          const params = {};
          if (dim) { params.w = dim.w; params.h = dim.h; if (dim.d !== null) params.d = dim.d; }
          Object.assign(params, kvs);
          const at = rest.match(/at\s+(-?[\d.]+)\s*,\s*(-?[\d.]+)\s*,\s*(-?[\d.]+)/);
          if (at) { params.x = parseFloat(at[1]); params.y = parseFloat(at[2]); params.z = parseFloat(at[3]); }
          if (/along\s+x/.test(rest)) params.along = 'x';
          else if (/along\s+z/.test(rest)) params.along = 'z';
          else if (/along\s+y/.test(rest)) params.along = 'y';
          return { action: 'CREATE_PRIMITIVE', shape, name, params };
        }

        // Map of natural-language part references to kinds (or specific names).
        // First match wins; ordered specific-first.
        const PART_REF = [
          { rx: /\b(landing\s+gears?|undercarriage|gears?|wheels?)\b/i, kinds: ['gear', 'skid'] },
          { rx: /\bskids?\b/i, kinds: ['skid'] },
          { rx: /\b(rotors?|motors?|propellers?|props?|fans?|thrusters?)\b/i, kinds: ['rotor'] },
          { rx: /\bbooms?\b/i, kinds: ['boom'] },
          { rx: /\barms?\b/i, kinds: ['arm'] },
          { rx: /\bwings?\b/i, kinds: ['wing'] },
          { rx: /\b(tail|empennage|fin|stabili[sz]er)\b/i, kinds: ['tail'] },
          { rx: /\b(canopy|cockpit|windshield)\b/i, kinds: ['cockpit'] },
          { rx: /\bnose\b/i, kinds: ['nose'] },
          { rx: /\bdoors?\b/i, kinds: ['feature'], typeFilter: 'door' },
          { rx: /\bwindows?\b/i, kinds: ['feature'], typeFilter: 'window' },
          { rx: /\bantennas?\b/i, kinds: ['feature'], typeFilter: 'antenna' },
          { rx: /\b(pylons?|crossbeams?|fairings?|supports?)\b/i, kinds: ['support'] },
          { rx: /\b(fuselage|body|hull|airframe|chassis|cabin)\b/i, kinds: ['fuselage'] }
        ];
        // Resolve a piece of text like "the landing gears" to a list of part names
        function resolvePartRefs(text) {
          // Try first word as exact name (handles "boom_left by 15 degrees")
          const firstWord = text.trim().split(/\s+/)[0];
          if (firstWord && partsRegistry.has(firstWord)) return [firstWord];
          // Then kind/type
          for (const ref of PART_REF) {
            if (ref.rx.test(text)) {
              const matches = [];
              for (const [n, p] of partsRegistry) {
                const kindMatch = ref.kinds.includes(p.kind);
                const typeMatch = !ref.typeFilter || p.type === ref.typeFilter;
                if (kindMatch && typeMatch) matches.push(n);
              }
              return matches;
            }
          }
          return [];
        }
        // Pull "N degrees" / "N°" / "N deg" out of text
        function extractDegrees(text) {
          const m = text.match(/(-?[\d.]+)\s*(?:°|deg(?:ree)?s?\b)/i);
          return m ? parseFloat(m[1]) : null;
        }
        // Detect axis from natural-language text
        function detectAxis(text, fallback = 'y') {
          if (/\b(?:on|around|about|along|over)\s+(?:the\s+)?x[\-\s]*axis\b/i.test(text) || /\bx[\-\s]*axis\b/i.test(text) || /\bpitch\b/i.test(text)) return 'x';
          if (/\b(?:on|around|about|along|over)\s+(?:the\s+)?z[\-\s]*axis\b/i.test(text) || /\bz[\-\s]*axis\b/i.test(text) || /\broll\b/i.test(text)) return 'z';
          if (/\b(?:on|around|about|along|over)\s+(?:the\s+)?y[\-\s]*axis\b/i.test(text) || /\by[\-\s]*axis\b/i.test(text) || /\byaw\b/i.test(text)) return 'y';
          return fallback;
        }

        // ---- MOVE ----
        const mvMatch = lower.match(/^(move|translate|position|place|put|shift|nudge)\s+(.+)/);
        if (mvMatch) {
          const verb = mvMatch[1], rest = mvMatch[2];
          let mode = (verb === 'position' || verb === 'place' || verb === 'put') ? 'to' : 'by';
          if (/^to\b/.test(rest)) mode = 'to';
          // Try to find part references in the rest of the command
          const targets = resolvePartRefs(rest);
          if (targets.length > 0) {
            const coords = parseCoords(rest);
            if (coords) return { action: 'MOVE_BATCH', names: targets, mode, dx: coords[0], dy: coords[1], dz: coords[2] };
            const dirs = parseDirections(rest);
            if (dirs.dx || dirs.dy || dirs.dz) return { action: 'MOVE_BATCH', names: targets, mode: 'by', dx: dirs.dx, dy: dirs.dy, dz: dirs.dz };
          }
        }

        // ---- ROTATE ----
        const rotMatch = lower.match(/^(rotate|turn|spin|tilt|pitch|yaw|roll)\s+(.+)/);
        if (rotMatch) {
          const verb = rotMatch[1], rest = rotMatch[2];
          const targets = resolvePartRefs(rest);
          if (targets.length > 0) {
            // Explicit (x,y,z) form
            const coords = parseCoords(rest);
            if (coords) return { action: 'ROTATE_BATCH', names: targets, rx: coords[0], ry: coords[1], rz: coords[2] };
            // x=N y=N z=N form
            const kvs = parseKVs(rest);
            if (kvs.x !== undefined || kvs.y !== undefined || kvs.z !== undefined) {
              return { action: 'ROTATE_BATCH', names: targets, rx: kvs.x || 0, ry: kvs.y || 0, rz: kvs.z || 0 };
            }
            // Single-axis natural-language: "by 90 degrees" / "90°" — pick axis from verb or text
            const deg = extractDegrees(rest);
            if (deg !== null) {
              let axis = detectAxis(rest, verb === 'tilt' || verb === 'pitch' ? 'x' : verb === 'roll' ? 'z' : 'y');
              const r = { rx: 0, ry: 0, rz: 0 };
              r['r' + axis] = deg;
              return { action: 'ROTATE_BATCH', names: targets, ...r };
            }
            // Bare number (no "degrees" suffix): "rotate the booms 45"
            const bare = rest.match(/(-?[\d.]+)/);
            if (bare) {
              const axis = detectAxis(rest, verb === 'tilt' || verb === 'pitch' ? 'x' : verb === 'roll' ? 'z' : 'y');
              const r = { rx: 0, ry: 0, rz: 0 };
              r['r' + axis] = parseFloat(bare[1]);
              return { action: 'ROTATE_BATCH', names: targets, ...r };
            }
          }
        }

        // ---- SCALE ----
        const scMatch = lower.match(/^(scale|resize|grow|shrink|enlarge)\s+(.+)/);
        if (scMatch) {
          const rest = scMatch[2];
          const targets = resolvePartRefs(rest);
          if (targets.length > 0) {
            const coords = parseCoords(rest);
            if (coords) return { action: 'SCALE_BATCH', names: targets, sx: coords[0], sy: coords[1], sz: coords[2] };
            const f = extractFactor(rest, null);
            if (f !== null) return { action: 'SCALE_BATCH', names: targets, sx: f, sy: f, sz: f };
            const num = rest.match(/(-?[\d.]+)/);
            if (num) {
              const factor = parseFloat(num[1]);
              return { action: 'SCALE_BATCH', names: targets, sx: factor, sy: factor, sz: factor };
            }
          }
        }

        const mirrMatch = lower.match(/^mirror\s+(\w+)(?:\s+(?:along|across|on)\s+(x|y|z))?(?:\s+as\s+(\w+))?/);
        if (mirrMatch && partsRegistry.has(mirrMatch[1])) {
          return { action: 'MIRROR', name: mirrMatch[1], axis: mirrMatch[2] || 'z', newName: mirrMatch[3] || null };
        }

        // ============================================================
        // CAD OPERATIONS (SOLIDWORKS-inspired vocabulary)
        // ============================================================

        // Helper: extract a measurement in mm or scene-units. Returns scene-units.
        // SOLIDWORKS users often type in mm; default to mm if 'mm' is present.
        function extractDistance(t) {
          const mm = t.match(/(-?\d+(?:\.\d+)?)\s*mm\b/);
          if (mm) return parseFloat(mm[1]) / 1000;          // mm → meters (scene units)
          const cm = t.match(/(-?\d+(?:\.\d+)?)\s*cm\b/);
          if (cm) return parseFloat(cm[1]) / 100;
          const m  = t.match(/(-?\d+(?:\.\d+)?)\s*m\b/);
          if (m) return parseFloat(m[1]);
          // Fallback: bare number assumed to be already in scene units
          const num = t.match(/(-?\d+(?:\.\d+)?)/);
          return num ? parseFloat(num[1]) : null;
        }

        // FILLET — round sharp edges (e.g. "fillet the fuselage 50mm" / "round the edges of the cabin")
        if (/^(?:fillet|round(?:\s+(?:off|the|edges))?|round\s+edges)\b/.test(lower) ||
            /\bfillet\b/.test(lower) || /\bround\s+(?:the\s+)?edges?\b/.test(lower)) {
          // Resolve target part
          const targets = resolvePartRefs(lower) || [];
          const name = targets[0] || selectedPartName || (partsRegistry.has('fuselage') ? 'fuselage' : null);
          if (!name) return { error: 'fillet: no target part — select one or specify (e.g. "fillet the fuselage 50mm")' };
          const r = extractDistance(lower) ?? 0.06;
          return { action: 'FILLET', name, radius: Math.abs(r) };
        }

        // CHAMFER — bevel sharp edges (e.g. "chamfer the cabin 25mm")
        if (/^(?:chamfer|bevel)\b/.test(lower) || /\bchamfer\b/.test(lower) || /\bbevel(?:ed|s)?\s+edges?\b/.test(lower)) {
          const targets = resolvePartRefs(lower) || [];
          const name = targets[0] || selectedPartName || (partsRegistry.has('fuselage') ? 'fuselage' : null);
          if (!name) return { error: 'chamfer: no target part' };
          const d = extractDistance(lower) ?? 0.05;
          return { action: 'CHAMFER', name, distance: Math.abs(d) };
        }

        // SHELL — hollow out (e.g. "shell the fuselage 5mm")
        if (/^(?:shell|hollow(?:\s+out)?)\b/.test(lower) || /\bshell\s+(?:the|it)\b/.test(lower) || /\bhollow\s+out\b/.test(lower)) {
          const targets = resolvePartRefs(lower) || [];
          const name = targets[0] || selectedPartName || (partsRegistry.has('fuselage') ? 'fuselage' : null);
          if (!name) return { error: 'shell: no target part' };
          const t = extractDistance(lower) ?? 0.05;
          return { action: 'SHELL', name, thickness: Math.abs(t) };
        }

        // CUT-EXTRUDE / EXTRUDED CUT — carve a hole through (e.g. "cut-extrude through the fuselage")
        if (/^(?:cut[\-\s]?extrude|extruded?\s+cut)\b/.test(lower) || /\bcut\s+(?:through|out)\b/.test(lower)) {
          const targets = resolvePartRefs(lower) || [];
          const name = targets[0] || selectedPartName || (partsRegistry.has('fuselage') ? 'fuselage' : null);
          if (!name) return { error: 'cut-extrude: no target part' };
          const depth = extractDistance(lower) ?? 0.18;
          return { action: 'CUT_EXTRUDE', name, depth: Math.abs(depth) };
        }

        // LINEAR PATTERN — repeat along an axis (e.g. "linear pattern of 4 at 0.5m along x")
        if (/\blinear\s+pattern\b/.test(lower) || (/\bpattern\b/.test(lower) && /\balong\b/.test(lower))) {
          const targets = resolvePartRefs(lower) || [];
          const name = targets[0] || selectedPartName;
          if (!name) return { error: 'linear pattern: select a part to pattern' };
          const count = parseCount(lower, 3);
          const spacingMatch = lower.match(/(?:at|spacing|every|step)\s+(-?\d+(?:\.\d+)?(?:\s*mm|\s*cm|\s*m)?)/);
          let spacing = 0.5;
          if (spacingMatch) {
            const v = extractDistance(spacingMatch[1]);
            if (v !== null) spacing = v;
          }
          let axis = 'x';
          if (/\b(?:along|on)\s+(?:the\s+)?y\b|\bvertical\b|\bup\b/.test(lower)) axis = 'y';
          else if (/\b(?:along|on)\s+(?:the\s+)?z\b|\bsideways\b/.test(lower)) axis = 'z';
          return { action: 'PATTERN_LINEAR', name, count, spacing, axis };
        }

        // CIRCULAR PATTERN — repeat around an axis (e.g. "circular pattern of 6")
        if (/\bcircular\s+pattern\b/.test(lower) || /\bradial\s+pattern\b/.test(lower) ||
            /\bpattern\s+around\b/.test(lower)) {
          const targets = resolvePartRefs(lower) || [];
          const name = targets[0] || selectedPartName;
          if (!name) return { error: 'circular pattern: select a part to pattern' };
          const count = parseCount(lower, 4);
          let axis = 'y';
          if (/\b(?:around|about)\s+(?:the\s+)?x\b|\bpitch\b/.test(lower)) axis = 'x';
          else if (/\b(?:around|about)\s+(?:the\s+)?z\b|\broll\b/.test(lower)) axis = 'z';
          return { action: 'PATTERN_CIRCULAR', name, count, axis };
        }

        // SUPPRESS / UNSUPPRESS — toggle visibility without deleting
        if (/^suppress\b/.test(lower) || /\bsuppress\s+(?:the\s+)?\w+/.test(lower)) {
          const targets = resolvePartRefs(lower) || [];
          const name = targets[0] || selectedPartName;
          if (!name) return { error: 'suppress: no target part' };
          return { action: 'SUPPRESS', name };
        }
        if (/^unsuppress\b/.test(lower) || /\bunsuppress\s+(?:the\s+)?\w+/.test(lower) || /\bshow\s+suppressed\b/.test(lower)) {
          const targets = resolvePartRefs(lower) || [];
          const name = targets[0] || selectedPartName;
          if (!name) return { error: 'unsuppress: no target part' };
          return { action: 'SUPPRESS', name };  // toggle
        }

        // Removal — by exact name first, then by kind keyword
        const rmMatch = lower.match(/^(?:remove|delete|drop|take\s+off|get\s+rid\s+of|scrap|kill|strip|lose)\s+(?:the\s+)?(\w+)/);
        if (rmMatch) return { action: 'REMOVE', name: rmMatch[1] };


        // ---------- Tier 1.5: Motor / propulsion housings ----------
        // Distinct from bare "rotor" / "propeller". A motor is the electric
        // drive housing (nacelle), not the spinning blade disk. We MUST check
        // these qualifiers BEFORE the rotor parser below — otherwise "tilt motor"
        // gets caught by the rotor synonym list (which includes "motor"→rotor)
        // and becomes ADD_ROTORS instead of ADD_LIBRARY:tilt-motor.
        if (/\b(tilt(?:ing)?|tiltrotor)\s*(?:motor|nacelle|pod)\b/i.test(lower) ||
            /\bnacelle\b/i.test(lower)) {
          return { action: 'ADD_LIBRARY', kind: 'tilt-motor' };
        }
        if (/\b(lift(?:ing)?|vertical)\s*(?:motor|drive|unit)\b/i.test(lower)) {
          return { action: 'ADD_LIBRARY', kind: 'lift-motor' };
        }
        if (/\bducted\s*fan\b/i.test(lower) || /\bshrouded\s*(?:fan|propeller|prop)\b/i.test(lower)) {
          return { action: 'ADD_LIBRARY', kind: 'ducted-fan' };
        }
        if (/\bpusher\s*(?:motor|prop|propeller|fan)\b/i.test(lower) ||
            /\bcruise\s*(?:motor|prop|propeller)\b/i.test(lower)) {
          return { action: 'ADD_LIBRARY', kind: 'pusher-motor' };
        }


        // ---------- Tier 2: permissive intent extraction ----------

        const partType = findFirstKey(lower, PART_KEYWORDS);
        const shape = findFirstKey(lower, SHAPE_KEYWORDS);
        const mods = findAllKeys(lower, MODIFIER_KEYWORDS);
        const tailType = findFirstKey(lower, TAIL_TYPE_KEYWORDS);
        const dim = parseDimString(lower);

        const isRemove = REMOVE_VERBS.some(v => new RegExp(`\\b${escRegex(v)}\\b`).test(lower));

        // Color detection
        const color = parseColor(lower);
        const hasColorVerb = /\b(paint|color)\b/.test(lower);
        const hasMakeIt = /\b(make|paint|color)\s+(it|the|its|this|that)\b/.test(lower);
        const hasColorTarget = /\b(accent|trim|primary)\b/.test(lower);

        // Color command takes priority when there's a color and either a color-verb or "make it"
        if (color && (hasColorVerb || hasMakeIt || hasColorTarget)) {
          let target = 'primary';
          if (/\baccent\b/.test(lower)) target = 'accent';
          else if (/\btrim\b/.test(lower)) target = 'trim';
          return { action: 'SET_COLOR', target, color: color.hex, colorName: color.name };
        }

        // Removing by kind
        if (isRemove && partType) {
          // Try to remove by kind keyword
          return { action: 'REMOVE', name: partType };
        }

        // ---------- Part-specific routing ----------

        // Cockpit / canopy
        if (partType === 'cockpit') return { action: 'ADD_COCKPIT' };

        // Nose (require part keyword to avoid catching just "tip" as nose)
        if (partType === 'nose') return { action: 'ADD_NOSE' };

        // Tricycle gear (more specific than skid)
        if (partType === 'tricycle' || /\btricycle\b/i.test(lower)) return { action: 'ADD_TRICYCLE' };

        // Tail (after tricycle; "tail number" already caught above)
        if (partType === 'tail') {
          return { action: 'ADD_TAIL', type: tailType || 'T' };
        }

        // Booms
        if (partType === 'boom') {
          const count = parseCount(lower, 2);
          const kvs = parseKVs(lower);
          const lenMatch = lower.match(/length\s+(-?[\d.]+)/);
          if (lenMatch) kvs.length = parseFloat(lenMatch[1]);
          return { action: 'ADD_BOOMS', count, placement: 'above', opts: kvs };
        }

        // Rotors
        if (partType === 'rotor') {
          const booms = Array.from(partsRegistry.values()).filter(p => p.kind === 'boom');
          const arms  = Array.from(partsRegistry.values()).filter(p => p.kind === 'arm');
          // 'append' mode: user said "add a single/another/one more rotor" —
          // adds rotors WITHOUT wiping existing. Useful for individual placement
          // (drag the new rotor wherever you want).
          const isAppend = /\b(single|another|one more|individual|extra|additional)\b/.test(lower);
          if (isAppend) {
            const explicitCount = parseCount(lower, null);
            return { action: 'ADD_ROTORS', count: explicitCount ?? 1, position: 'append' };
          }
          const position = detectRotorPosition(lower);
          const explicitCount = parseCount(lower, null);  // null if no number given
          let count;
          if (explicitCount !== null) {
            count = explicitCount;  // user said a specific number — honor it
          } else if (position === 'boom_tips') {
            count = booms.reduce((n, b) => n + (b.tips?.length || 0), 0) || 4;
          } else if (position === 'arm_tips' && /each|every|all/.test(lower)) {
            count = arms.length || 4;
          } else {
            count = booms.length ? booms.reduce((n, b) => n + (b.tips?.length || 0), 0) : 4;
          }
          return { action: 'ADD_ROTORS', count, position };
        }

        // Arms
        if (partType === 'arm') {
          const count = parseCount(lower, 4);
          return { action: 'ADD_ARMS', count, position: detectArmPosition(lower) };
        }

        // Wings
        if (partType === 'wing') return { action: 'ADD_WINGS' };

        // Door / cutout
        if (partType === 'door') {
          let s = 'left';
          if (/\bright\b|\bstarboard\b/.test(lower)) s = 'right';
          return { action: 'ADD_DOOR', side: s };
        }
        // Windows / portholes
        if (partType === 'window') {
          let s = 'left';
          if (/\bright\b|\bstarboard\b/.test(lower)) s = 'right';
          return { action: 'ADD_WINDOW', side: s };
        }
        // Antenna
        if (partType === 'antenna') return { action: 'ADD_ANTENNA' };

        // ====== Library parts (interior, equipment, cutouts) ======
        if (partType === 'bench_seat')        return { action: 'ADD_LIBRARY', kind: 'bench-seat' };
        if (partType === 'captain_seat')      return { action: 'ADD_LIBRARY', kind: 'captain-seat' };
        if (partType === 'bucket_seat')       return { action: 'ADD_LIBRARY', kind: 'bucket-seat' };
        if (partType === 'seat') {
          // Generic "seat" with optional count — pick captain seat by default
          const count = parseCount(lower, 1);
          return { action: 'ADD_LIBRARY', kind: 'captain-seat', count };
        }
        if (partType === 'instrument_panel')  return { action: 'ADD_LIBRARY', kind: 'instrument-panel' };
        if (partType === 'control_yoke')      return { action: 'ADD_LIBRARY', kind: 'control-yoke' };
        if (partType === 'cargo_crate') {
          const count = parseCount(lower, 1);
          return { action: 'ADD_LIBRARY', kind: 'cargo-crate', count };
        }
        if (partType === 'battery_pack')      return { action: 'ADD_LIBRARY', kind: 'battery-pack' };
        if (partType === 'fuel_tank')         return { action: 'ADD_LIBRARY', kind: 'fuel-tank' };
        if (partType === 'avionics_rack')     return { action: 'ADD_LIBRARY', kind: 'avionics-rack' };
        if (partType === 'cutout')            return { action: 'ADD_LIBRARY', kind: 'cutout' };
        if (partType === 'round_hole')        return { action: 'ADD_LIBRARY', kind: 'round-hole' };
        if (partType === 'vent')              return { action: 'ADD_LIBRARY', kind: 'vent' };
        if (partType === 'nav_light') {
          // Pick color from prompt: red (port), green (starboard), or white (default)
          if (/\bgreen|starboard\b/.test(lower)) return { action: 'ADD_LIBRARY', kind: 'nav-light-green' };
          if (/\bred|port\b/.test(lower))       return { action: 'ADD_LIBRARY', kind: 'nav-light-red' };
          return { action: 'ADD_LIBRARY', kind: 'nav-light-white' };
        }
        if (partType === 'landing_light')     return { action: 'ADD_LIBRARY', kind: 'landing-light' };
        if (partType === 'sensor_pod')        return { action: 'ADD_LIBRARY', kind: 'sensor-pod' };
        if (partType === 'strut')             return { action: 'ADD_LIBRARY', kind: 'strut' };
        if (partType === 'spoiler')           return { action: 'ADD_LIBRARY', kind: 'spoiler' };
        if (partType === 'hatch_panel')       return { action: 'ADD_LIBRARY', kind: 'hatch' };
        if (partType === 'pylon')             return { action: 'ADD_LIBRARY', kind: 'pylon' };
        if (partType === 'heat_exchanger')    return { action: 'ADD_LIBRARY', kind: 'heat-exchanger' };
        if (partType === 'exhaust')           return { action: 'ADD_LIBRARY', kind: 'exhaust' };

        // Skids / gear (after tricycle)
        if (partType === 'skid' || partType === 'gear') return { action: 'ADD_SKIDS' };

        // Tail-type-only mention without part keyword: treat as ADD_TAIL
        if (tailType) return { action: 'ADD_TAIL', type: tailType };

        // Fuselage / body — explicit OR shape-only mention defaults here
        if (partType === 'fuselage' || shape) {
          let finalShape = shape || 'aircraft';
          // No explicit shape but modifiers suggest one
          if (!shape) {
            if (mods.aerodynamic) finalShape = 'aircraft';
            else if (mods.boxy) finalShape = 'cuboid';
            else if (mods.round) finalShape = 'sphere';
            else if (mods.long) finalShape = 'capsule';
          }
          return { action: 'ADD_FUSELAGE', shape: finalShape, dims: dim, modifiers: mods };
        }

        // Modifier-only command — apply to existing fuselage if present
        if (partsRegistry.has('fuselage') || /\bfuselage\b/.test(lower)) {
          // Find target part name (default: fuselage)
          let target = 'fuselage';
          const explicitTarget = lower.match(/(?:make|scale|grow|shrink)\s+(?:the\s+)?(\w+)\b/);
          if (explicitTarget && explicitTarget[1] !== 'it' && partsRegistry.has(explicitTarget[1])) {
            target = explicitTarget[1];
          }
          const factor = extractFactor(lower);
          // Axis-specific
          if (mods.taller)   return { action: 'SCALE', name: target, sx: 1, sy: factor, sz: 1, mod: 'taller' };
          if (mods.shorter)  return { action: 'SCALE', name: target, sx: 1, sy: 1/factor, sz: 1, mod: 'shorter' };
          if (mods.wide)     return { action: 'SCALE', name: target, sx: 1, sy: 1, sz: factor, mod: 'wider' };
          if (mods.narrow)   return { action: 'SCALE', name: target, sx: 1, sy: 1, sz: 1/factor, mod: 'narrower' };
          if (mods.longer)   return { action: 'SCALE', name: target, sx: factor, sy: 1, sz: 1, mod: 'longer' };
          if (mods.stubbier) return { action: 'SCALE', name: target, sx: 1/factor, sy: 1, sz: 1, mod: 'stubbier' };
          // Uniform
          if (mods.big)      return { action: 'SCALE', name: target, sx: factor, sy: factor, sz: factor, mod: 'bigger' };
          if (mods.small)    return { action: 'SCALE', name: target, sx: 1/factor, sy: 1/factor, sz: 1/factor, mod: 'smaller' };
          if (mods.long)     return { action: 'SCALE', name: target, sx: factor, sy: 1, sz: 1, mod: 'longer' };
          if (mods.stubby)   return { action: 'SCALE', name: target, sx: 1/factor, sy: 1, sz: 1, mod: 'stubbier' };
          if (mods.aerodynamic) return { action: 'ADD_FUSELAGE', shape: 'aircraft', dims: null, modifiers: mods };
        }

        // Pure color command (no verb, no target)
        if (color) {
          let target = 'primary';
          if (/\baccent\b/.test(lower)) target = 'accent';
          else if (/\btrim\b/.test(lower)) target = 'trim';
          return { action: 'SET_COLOR', target, color: color.hex, colorName: color.name };
        }

        return { action: 'UNKNOWN', text: t };
      }

      // ==================== EXECUTOR ====================
      function fmt(n) { return Number.isFinite(n) ? n.toFixed(2).replace(/\.00$/, '') : '0'; }

      async function executeCommand(cmd) {
        switch (cmd.action) {
          case 'EMPTY': return null;

          case 'HELP': {
            const help = [
              '<span class="pkey">CAD primitives:</span>',
              'create box NAME 2x0.7x0.6',
              'create cylinder NAME r=0.05 l=2',
              'create sphere NAME r=0.5',
              'create cone NAME r=0.3 h=1',
              '',
              '<span class="pkey">Transforms:</span>',
              'move NAME up 0.3 / forward 1.5',
              'position NAME to 0,0.5,0.4',
              'rotate NAME by 0,0,15  /  rotate landing gears 90°',
              'scale NAME 1.5    or   scale NAME 1,2,1',
              'mirror NAME along z [as NEWNAME]',
              '',
              '<span class="pkey">CAD operations (SOLIDWORKS-style):</span>',
              'fillet the fuselage 80mm     · round sharp edges',
              'chamfer the cabin 25mm       · bevel edges',
              'shell the fuselage 5mm       · hollow out',
              'cut-extrude through body 100mm · carve a recess',
              'linear pattern of 4 along x at 0.5m',
              'circular pattern of 6 around y',
              'suppress NAME / unsuppress NAME · hide without delete',
              '',
              '<span class="pkey">Smart parts:</span>',
              'add aircraft fuselage 2.5x0.7x0.7',
              'add canopy / nose / T-tail / V-tail',
              'add 2 booms above fuselage',
              'add 4 rotors on boom tips',
              'add tricycle gear / skids / wing',
              '',
              '<span class="pkey">Library parts (also clickable in left panel):</span>',
              'add captain seat / bench / bucket seat',
              'add instrument panel / control yoke',
              'add battery / fuel tank / cargo crate',
              'add antenna / windows / doors',
              '',
              '<span class="pkey">Misc:</span>',
              'paint it COLOR / make trim COLOR',
              'remove NAME / delete NAME',
              'list / reset',
              'name it TAIL-7'
            ].join('\n');
            return { parsed: '<span class="pkey">action:</span> <span class="pval">HELP</span>', result: help };
          }

          case 'CLEAR':
            clearScene();
            return {
              parsed: '<span class="pkey">action:</span> <span class="pval">CLEAR</span>',
              result: '<span class="check">✓</span>scene cleared'
            };

          case 'LIST': {
            if (partsRegistry.size === 0) {
              return { parsed: '<span class="pkey">action:</span> <span class="pval">LIST</span>', result: 'no parts in scene' };
            }
            const lines = [];
            for (const [name, p] of partsRegistry) {
              const pos = p.object?.position;
              const posStr = pos ? `(${fmt(pos.x)}, ${fmt(pos.y)}, ${fmt(pos.z)})` : '';
              lines.push(`<span class="val">${name}</span> · <span class="pkey">${p.type || p.kind}</span> ${posStr}`);
            }
            return { parsed: `<span class="pkey">action:</span> <span class="pval">LIST</span> &nbsp; <span class="pkey">parts:</span> <span class="pval">${partsRegistry.size}</span>`, result: lines.join('\n') };
          }

          case 'CREATE_PRIMITIVE': {
            const r = createPrimitive(cmd.shape, cmd.name, cmd.params);
            if (!r) return { error: `couldn't create ${cmd.shape}` };
            const dimsStr = Object.entries(r.dims).filter(([k, v]) => v != null).map(([k, v]) => `${k}=${fmt(v)}`).join(', ');
            return {
              parsed: `<span class="pkey">action:</span> <span class="pval">CREATE</span> &nbsp; <span class="pkey">shape:</span> <span class="pval">${cmd.shape.toUpperCase()}</span> &nbsp; <span class="pkey">name:</span> <span class="pval">${r.name}</span>`,
              result: `<span class="check">✓</span>created <span class="val">${r.name}</span> (${dimsStr})`
            };
          }

          case 'ADD_FUSELAGE': {
            const r = addFuselage(cmd.shape, cmd.dims);
            const dimsStr = `${fmt(r.dims.L * 2)} × ${fmt(r.dims.H * 2)} × ${fmt(r.dims.W * 2)}`;
            return {
              parsed: `<span class="pkey">action:</span> <span class="pval">ADD_FUSELAGE</span> &nbsp; <span class="pkey">shape:</span> <span class="pval">${r.shape.toUpperCase()}</span>`,
              result: `<span class="check">✓</span>built <span class="val">${r.shape}</span> fuselage (${dimsStr})`
            };
          }

          case 'ADD_COCKPIT':
            if (!partsRegistry.has('fuselage')) return { error: 'no fuselage yet — add a fuselage first' };
            addCockpit();
            return { parsed: '<span class="pkey">action:</span> <span class="pval">ADD_COCKPIT</span>', result: '<span class="check">✓</span>added bubble canopy on forward fuselage' };

          case 'ADD_NOSE':
            if (!partsRegistry.has('fuselage')) return { error: 'no fuselage yet — add a fuselage first' };
            addNose();
            return { parsed: '<span class="pkey">action:</span> <span class="pval">ADD_NOSE</span>', result: '<span class="check">✓</span>added nose cone at +X tip' };

          case 'ADD_TAIL':
            if (!partsRegistry.has('fuselage')) return { error: 'no fuselage yet — add a fuselage first' };
            addTail(cmd.type);
            return {
              parsed: `<span class="pkey">action:</span> <span class="pval">ADD_TAIL</span> &nbsp; <span class="pkey">type:</span> <span class="pval">${cmd.type}</span>`,
              result: `<span class="check">✓</span>built <span class="val">${cmd.type}-tail</span> at rear of fuselage`
            };

          case 'ADD_BOOMS': {
            if (!partsRegistry.has('fuselage')) addFuselage('aircraft', null);
            const names = addBoomsPair(cmd.opts);
            return {
              parsed: `<span class="pkey">action:</span> <span class="pval">ADD_BOOMS</span> &nbsp; <span class="pkey">count:</span> <span class="pval">2</span> &nbsp; <span class="pkey">layout:</span> <span class="pval">${cmd.placement.toUpperCase()}</span>`,
              result: `<span class="check">✓</span>installed <span class="val">${names.join(' + ')}</span> on pylons above fuselage`
            };
          }

          case 'ADD_ARMS':
            addArms(cmd.count, cmd.position);
            return {
              parsed: `<span class="pkey">action:</span> <span class="pval">ADD_ARMS</span> &nbsp; <span class="pkey">count:</span> <span class="pval">${cmd.count}</span> &nbsp; <span class="pkey">layout:</span> <span class="pval">${cmd.position.toUpperCase()}</span>`,
              result: `<span class="check">✓</span>extended <span class="val">${cmd.count} arms</span>`
            };

          case 'ADD_ROTORS': {
            const placed = addRotors(cmd.count, cmd.position);
            return {
              parsed: `<span class="pkey">action:</span> <span class="pval">ADD_ROTORS</span> &nbsp; <span class="pkey">count:</span> <span class="pval">${placed}</span> &nbsp; <span class="pkey">layout:</span> <span class="pval">${cmd.position.toUpperCase()}</span>`,
              result: `<span class="check">✓</span>installed <span class="val">${placed} rotors</span>`
            };
          }

          case 'ADD_TRICYCLE':
            addTricycleGear();
            return {
              parsed: '<span class="pkey">action:</span> <span class="pval">ADD_TRICYCLE</span>',
              result: '<span class="check">✓</span>deployed tricycle gear (1 nose wheel, 2 mains)'
            };

          case 'ADD_SKIDS':
            addSkids();
            return {
              parsed: '<span class="pkey">action:</span> <span class="pval">ADD_SKIDS</span>',
              result: '<span class="check">✓</span>deployed dual-skid landing gear'
            };

          case 'ADD_WINGS':
            addWings();
            return {
              parsed: '<span class="pkey">action:</span> <span class="pval">ADD_WINGS</span>',
              result: '<span class="check">✓</span>attached fixed wings port + starboard'
            };

          case 'ADD_DOOR':
            if (!partsRegistry.has('fuselage')) return { error: 'no fuselage yet — add a fuselage first' };
            addDoor({ side: cmd.side });
            return {
              parsed: `<span class="pkey">action:</span> <span class="pval">ADD_DOOR</span> &nbsp; <span class="pkey">side:</span> <span class="pval">${cmd.side.toUpperCase()}</span>`,
              result: `<span class="check">✓</span>added <span class="val">${cmd.side}</span> entry door with frame trim`
            };

          case 'ADD_WINDOW':
            if (!partsRegistry.has('fuselage')) return { error: 'no fuselage yet — add a fuselage first' };
            addWindow({ side: cmd.side });
            return {
              parsed: `<span class="pkey">action:</span> <span class="pval">ADD_WINDOW</span> &nbsp; <span class="pkey">side:</span> <span class="pval">${cmd.side.toUpperCase()}</span>`,
              result: `<span class="check">✓</span>added <span class="val">${cmd.side}</span>-side passenger windows (3 panes)`
            };

          case 'ADD_ANTENNA':
            if (!partsRegistry.has('fuselage')) return { error: 'no fuselage yet — add a fuselage first' };
            addAntenna();
            return {
              parsed: '<span class="pkey">action:</span> <span class="pval">ADD_ANTENNA</span>',
              result: '<span class="check">✓</span>installed dorsal antenna mast'
            };

          case 'ADD_LIBRARY': {
            const builders = {
              'bench-seat':       { fn: addBenchSeat,       label: 'bench seat (3 passengers)' },
              'captain-seat':     { fn: addCaptainSeat,     label: 'captain seat with armrests' },
              'bucket-seat':      { fn: addBucketSeat,      label: 'sport bucket seat' },
              'instrument-panel': { fn: addInstrumentPanel, label: 'instrument panel with 3 displays' },
              'control-yoke':     { fn: addControlYoke,     label: 'control yoke' },
              'cargo-crate':      { fn: addCargoCrate,      label: 'cargo crate' },
              'battery-pack':     { fn: addBatteryPack,     label: 'battery pack with cooling fins' },
              'fuel-tank':        { fn: addFuelTank,        label: 'pressurized fuel tank' },
              'avionics-rack':    { fn: addAvionicsRack,    label: 'avionics rack' },
              'cutout':           { fn: addCutout,          label: 'rectangular cutout / hole' },
              'round-hole':       { fn: addRoundHole,       label: 'round porthole / circular cutout' },
              'vent':             { fn: addVent,            label: 'cooling vent / louvered grille' },
              'nav-light-red':    { fn: () => addNavLight(0xff3030),  label: 'red navigation light (port side)' },
              'nav-light-green':  { fn: () => addNavLight(0x30ff60),  label: 'green nav light (starboard)' },
              'nav-light-white':  { fn: () => addNavLight(0xffffff),  label: 'white tail light' },
              'landing-light':    { fn: addLandingLight,    label: 'forward landing light' },
              'sensor-pod':       { fn: addSensorPod,       label: 'sensor pod (camera/lidar)' },
              'strut':            { fn: addStrut,           label: 'diagonal support strut' },
              'spoiler':          { fn: addSpoiler,         label: 'spoiler / control flap' },
              'hatch':            { fn: addHatch,           label: 'access hatch / panel' },
              'pylon':            { fn: addPylon,           label: 'vertical pylon / mast' },
              'heat-exchanger':   { fn: addHeatExchanger,   label: 'heat exchanger / radiator grille' },
              'exhaust':          { fn: addExhaustNozzle,   label: 'exhaust nozzle / outflow port' },
              // PROPULSION — distinct from rotors (the spinning blade disks).
              // Motors are the electric drive housings that mount on wing/boom/fuselage.
              'tilt-motor':       { fn: addTiltingMotor,    label: 'tilting motor pod (Joby/Archer style)' },
              'lift-motor':       { fn: addLiftMotor,       label: 'vertical lift motor (quad-arm tip)' },
              'ducted-fan':       { fn: addDuctedFan,       label: 'ducted fan / shrouded propeller' },
              'pusher-motor':     { fn: addPusherMotor,     label: 'pusher motor (rear cruise propeller)' }
            };
            const def = builders[cmd.kind];
            if (!def) return { error: `unknown library part "${cmd.kind}"` };
            const count = Math.max(1, Math.min(cmd.count || 1, 8));
            const placed = [];
            for (let i = 0; i < count; i++) {
              const name = def.fn();
              placed.push(name);
              // Stagger position slightly when adding multiple
              if (count > 1) {
                const part = partsRegistry.get(name);
                if (part?.object) part.object.position.x += (i - (count - 1) / 2) * 0.5;
              }
            }
            return {
              parsed: `<span class="pkey">action:</span> <span class="pval">ADD_LIBRARY</span> &nbsp; <span class="pkey">part:</span> <span class="pval">${cmd.kind.toUpperCase()}</span>${count > 1 ? ` &nbsp; <span class="pkey">count:</span> <span class="pval">${count}</span>` : ''}`,
