          case 'ROTATE_BATCH': {
            if (!cmd.names || cmd.names.length === 0) return { error: 'no matching parts found' };
            let count = 0;
            for (const n of cmd.names) {
              if (rotateByName(n, cmd.rx, cmd.ry, cmd.rz)) count++;
            }
            const list = cmd.names.length > 4 ? `${cmd.names.length} parts` : cmd.names.join(', ');
            return {
              parsed: `<span class="pkey">action:</span> <span class="pval">ROTATE</span> &nbsp; <span class="pkey">parts:</span> <span class="pval">${list}</span> &nbsp; <span class="pkey">deg:</span> <span class="pval">${fmt(cmd.rx)},${fmt(cmd.ry)},${fmt(cmd.rz)}</span>`,
              result: `<span class="check">✓</span>rotated <span class="val">${count}</span> part${count===1?'':'s'}`
            };
          }

          case 'SCALE_BATCH': {
            if (!cmd.names || cmd.names.length === 0) return { error: 'no matching parts found' };
            let count = 0;
            for (const n of cmd.names) {
              if (scaleByName(n, cmd.sx, cmd.sy, cmd.sz)) count++;
            }
            const list = cmd.names.length > 4 ? `${cmd.names.length} parts` : cmd.names.join(', ');
            return {
              parsed: `<span class="pkey">action:</span> <span class="pval">SCALE</span> &nbsp; <span class="pkey">parts:</span> <span class="pval">${list}</span> &nbsp; <span class="pkey">factor:</span> <span class="pval">${fmt(cmd.sx)},${fmt(cmd.sy)},${fmt(cmd.sz)}</span>`,
              result: `<span class="check">✓</span>scaled <span class="val">${count}</span> part${count===1?'':'s'}`
            };
          }

          case 'ROTATE': {
            const r = rotateByName(cmd.name, cmd.rx, cmd.ry, cmd.rz);
            if (!r) return { error: `no part named "${cmd.name}"` };
            return {
              parsed: `<span class="pkey">action:</span> <span class="pval">ROTATE</span> &nbsp; <span class="pkey">name:</span> <span class="pval">${cmd.name}</span> &nbsp; <span class="pkey">deg:</span> <span class="pval">${fmt(cmd.rx)},${fmt(cmd.ry)},${fmt(cmd.rz)}</span>`,
              result: `<span class="check">✓</span>rotated <span class="val">${cmd.name}</span>`
            };
          }

          case 'SCALE': {
            const r = scaleByName(cmd.name, cmd.sx, cmd.sy, cmd.sz);
            if (!r) return { error: `no part named "${cmd.name}"` };
            return {
              parsed: `<span class="pkey">action:</span> <span class="pval">SCALE</span> &nbsp; <span class="pkey">name:</span> <span class="pval">${cmd.name}</span> &nbsp; <span class="pkey">factor:</span> <span class="pval">${fmt(cmd.sx)},${fmt(cmd.sy)},${fmt(cmd.sz)}</span>`,
              result: `<span class="check">✓</span>now scale (${fmt(r.x)}, ${fmt(r.y)}, ${fmt(r.z)})`
            };
