      document.getElementById('btn-queue').addEventListener('click', () => {
        if (partsRegistry.size === 0) {
          // Nothing built yet — bounce
          const btn = document.getElementById('btn-queue');
          btn.style.borderColor = '#f87171';
          setTimeout(() => { btn.style.borderColor = ''; }, 600);
          return;
        }
        openTestChamber();
      });

      // ============================================================
      // AI DESIGN ENGINEER v4 — CAD command interpreter
      // Primitives · transforms · named parts · smart aircraft templates
      // ============================================================

      // Named parts registry — every created mesh lives here
      const partsRegistry = new Map(); // name -> { object, type, dims, kind }

      // Test bridge for headless verification of build/dispatch flows
      window.__SDX_MFG_TEST = () => ({
        partsRegistry,
        taxi: typeof taxi !== 'undefined' ? taxi : null,
        scene: typeof scene !== 'undefined' ? scene : null,
        Vector3: THREE.Vector3
      });

      function uniqueName(base) {
        if (!partsRegistry.has(base)) return base;
        let n = 1;
        while (partsRegistry.has(`${base}_${n}`)) n++;
        return `${base}_${n}`;
      }

      function registerPart(name, data) {
        partsRegistry.set(name, data);
        if (data.object) data.object.userData.partName = name;
      }

      // =====================================================================
      // CAD-style SNAP placement
      //
      // Replaces "drag the part by hand to the exact spot" with a picker that
      // places parts at named anchor points on a target part. For example:
      //   snapPartToAnchor('rotor1', 'boom', 'tip-pos-z')
      // moves rotor1 so its center sits at the +Z tip of `boom`'s bounding box,
      // resting on top of the boom.
      //
      // Anchors (computed in world space from the target's Box3):
      //   'center'      → middle of the target
      //   'tip-pos-x'   → +X end (e.g. starboard wing tip, forward boom end)
      //   'tip-neg-x'   → -X end (e.g. port wing tip, aft boom end)
      //   'tip-pos-z'   → +Z end (boom tip when boom runs along Z)
      //   'tip-neg-z'   → -Z end (boom tail when boom runs along Z)
      //   'top'         → top surface (Y max)
      //   'bottom'      → bottom surface (Y min)
      //   'corner-fl'   → forward-left   (max X, min Z)
      //   'corner-fr'   → forward-right  (max X, max Z)
      //   'corner-bl'   → back-left      (min X, min Z)
      //   'corner-br'   → back-right     (min X, max Z)
      //
      // The snapped part rests on TOP of the target by default — its bottom
      // sits flush with the target's top surface, so rotors don't clip into
      // booms/wings.
      //
      // findBoomLikePart() picks a sensible target if none is named explicitly:
      //   prefers 'boom' kind, then 'arm', then 'wing', then 'fuselage'.
      function findBoomLikePart() {
        // Preference order — first kind found wins
        const kinds = ['boom', 'arm', 'support', 'wing', 'fuselage'];
        for (const k of kinds) {
          for (const [name, info] of partsRegistry) {
            if (info.kind === k) return name;
          }
        }
        return null;
      }

      function partWorldBounds(name) {
        const info = partsRegistry.get(name);
        if (!info || !info.object) return null;
        info.object.updateMatrixWorld(true);
        const box = new THREE.Box3().setFromObject(info.object);
        if (box.isEmpty()) return null;
        return box;
      }

      function anchorPointOnTarget(targetBox, anchor) {
        const center = new THREE.Vector3(); targetBox.getCenter(center);
        const min = targetBox.min, max = targetBox.max;
        const yTop = max.y;
        switch (anchor) {
          case 'center':    return new THREE.Vector3(center.x, yTop, center.z);
          case 'tip-pos-x': return new THREE.Vector3(max.x,    yTop, center.z);
          case 'tip-neg-x': return new THREE.Vector3(min.x,    yTop, center.z);
          case 'tip-pos-z': return new THREE.Vector3(center.x, yTop, max.z);
          case 'tip-neg-z': return new THREE.Vector3(center.x, yTop, min.z);
          case 'top':       return new THREE.Vector3(center.x, yTop, center.z);
          case 'bottom':    return new THREE.Vector3(center.x, min.y, center.z);
          case 'corner-fl': return new THREE.Vector3(max.x,    yTop, min.z);
          case 'corner-fr': return new THREE.Vector3(max.x,    yTop, max.z);
          case 'corner-bl': return new THREE.Vector3(min.x,    yTop, min.z);
          case 'corner-br': return new THREE.Vector3(min.x,    yTop, max.z);
          default:          return new THREE.Vector3(center.x, yTop, center.z);
        }
      }

      // Snap a part to an anchor on a target. The part is moved so its
      // BOTTOM rests on the target's anchor Y (i.e. it sits ON the target,
      // not embedded in it). XZ position matches the anchor's XZ. Returns
      // true on success, false if either part isn't found.
      function snapPartToAnchor(partName, targetName, anchor) {
        const partInfo = partsRegistry.get(partName);
        if (!partInfo || !partInfo.object) return false;
        const targetBox = partWorldBounds(targetName);
        if (!targetBox) return false;
        const targetAnchor = anchorPointOnTarget(targetBox, anchor);
        // Measure the part's current bbox (in world space, taking any
        // existing transforms into account)
        partInfo.object.updateMatrixWorld(true);
        const partBox = new THREE.Box3().setFromObject(partInfo.object);
        if (partBox.isEmpty()) return false;
        const partCenter = new THREE.Vector3(); partBox.getCenter(partCenter);
        const partBottomOffset = partCenter.y - partBox.min.y;     // distance from center to bottom
        // World-space target position for the part's CENTER
        const targetCenterWorld = new THREE.Vector3(
          targetAnchor.x,
          targetAnchor.y + partBottomOffset,    // sit ON the anchor surface
          targetAnchor.z
        );
        // Convert world-space center target into local-space POSITION delta.
        // partInfo.object.position is local to its parent (taxi). We need to
        // figure out how much to shift the local position so the world bbox
        // center moves to targetCenterWorld.
        const currentWorldCenter = partCenter.clone();
        const delta = targetCenterWorld.sub(currentWorldCenter);
        partInfo.object.position.add(delta);
        partInfo.object.updateMatrixWorld(true);
        return true;
      }

      // Snap a list of parts to a list of anchors on the same target. Used
      // for "place 4 rotors at corners of boom" or "place 2 rotors at tips
      // of wing".
      function snapPartsToAnchors(partNames, targetName, anchors) {
        if (!Array.isArray(partNames) || !Array.isArray(anchors)) return 0;
        const n = Math.min(partNames.length, anchors.length);
        let placed = 0;
        for (let i = 0; i < n; i++) {
          if (snapPartToAnchor(partNames[i], targetName, anchors[i])) placed++;
        }
        return placed;
      }

      // High-level helper: snap all currently-loose rotors to the corners /
      // tips of the best available boom-like part. If there are 4 rotors,
      // they go to the 4 corners. 2 rotors go to opposing tips. 1 rotor
      // goes to center. 6+ rotors get distributed along the target.
      // Find all boom-like parts (every part whose kind is in the boom-family).
      // Returns names sorted by descending length-along-long-axis so the user's
      // "main" boom is preferred for single-target operations.
      function findAllBoomLikeParts() {
        const kinds = ['boom', 'arm', 'support'];     // wings/fuselage handled separately
        const matches = [];
        for (const [name, info] of partsRegistry) {
          if (kinds.includes(info.kind)) {
            const box = partWorldBounds(name);
            if (!box) continue;
            const sizeX = box.max.x - box.min.x;
            const sizeY = box.max.y - box.min.y;
            const sizeZ = box.max.z - box.min.z;
            const longAxis = Math.max(sizeX, sizeZ);     // long axis is horizontal
            matches.push({ name, longAxis, sizeX, sizeY, sizeZ, box });
          }
        }
        // Fallback to wings if no boom/arm/support
        if (!matches.length) {
          for (const [name, info] of partsRegistry) {
            if (info.kind === 'wing') {
              const box = partWorldBounds(name);
              if (!box) continue;
              const sizeX = box.max.x - box.min.x;
              const sizeZ = box.max.z - box.min.z;
              matches.push({ name, longAxis: Math.max(sizeX, sizeZ), sizeX, sizeY: box.max.y - box.min.y, sizeZ, box });
            }
          }
        }
        matches.sort((a, b) => b.longAxis - a.longAxis);
        return matches;
      }

      function autoSnapRotorsToBoom(targetName) {
        const rotorNames = [];
        for (const [name, info] of partsRegistry) {
          if (info.kind === 'rotor') rotorNames.push(name);
        }
        if (!rotorNames.length) return { placed: 0, error: 'no rotors to snap — add some first' };

        // ===== Multi-boom distribution =====
        // If the user has multiple booms/arms, distribute rotors across ALL
        // of them. Two rotors per boom (one at each long-axis tip). This
        // matches the visual model: 3 boom-pairs × 2 tips = 6 rotor slots.
        // Leftover rotors get clustered at remaining mid-points or at the
        // first boom's center.
        if (!targetName) {
          const booms = findAllBoomLikeParts();
          if (!booms.length) {
            return { placed: 0, error: 'no boom/arm/wing found — add one first' };
          }

          // If exactly one boom-like part, fall through to the existing
          // single-target placement logic (corners, mid-points, etc.)
          if (booms.length > 1) {
            // Build a list of (target, anchor) slots based on boom count.
            // Each boom contributes 2 tip slots along its long axis.
            const slots = [];
            for (const b of booms) {
              const longIsX = b.sizeX >= b.sizeZ;
              const tipNeg = longIsX ? 'tip-neg-x' : 'tip-neg-z';
              const tipPos = longIsX ? 'tip-pos-x' : 'tip-pos-z';
              slots.push({ target: b.name, anchor: tipNeg });
              slots.push({ target: b.name, anchor: tipPos });
            }
            // Assign each rotor to a slot. If we have more rotors than slots,
            // additional rotors go to per-boom centers. If we have fewer
            // rotors than slots, leave some slots empty (closest tips win
            // first — the longer booms get filled first since they sort to
            // the top of the list).
            let placed = 0;
            const placements = [];
            const n = Math.min(rotorNames.length, slots.length);
            for (let i = 0; i < n; i++) {
              if (snapPartToAnchor(rotorNames[i], slots[i].target, slots[i].anchor)) {
                placed++;
                placements.push({ rotor: rotorNames[i], target: slots[i].target, anchor: slots[i].anchor });
              }
            }
            // Overflow: distribute remaining rotors at boom centers, cycling
            // through booms so each boom gets one extra before any boom gets
            // two extras.
            let overflowIdx = n;
            let boomCycle = 0;
            while (overflowIdx < rotorNames.length) {
              const target = booms[boomCycle % booms.length].name;
              if (snapPartToAnchor(rotorNames[overflowIdx], target, 'center')) {
                placed++;
                placements.push({ rotor: rotorNames[overflowIdx], target, anchor: 'center' });
              }
              overflowIdx++;
              boomCycle++;
            }
            return { placed, target: booms.map(b => b.name).join(' + '), placements };
          }
          // Single boom — let the rest of the function handle it
          targetName = booms[0].name;
        }

        const target = targetName;
        // ===== Single-target placement (existing logic) =====
        // Pick anchor pattern by rotor count
        let anchors;
        if (rotorNames.length === 1) {
          anchors = ['center'];
        } else if (rotorNames.length === 2) {
          // Determine whether target is wider in X or Z and pick the long axis tips
          const box = partWorldBounds(target);
          const sizeX = box.max.x - box.min.x;
          const sizeZ = box.max.z - box.min.z;
          anchors = sizeX >= sizeZ ? ['tip-neg-x', 'tip-pos-x'] : ['tip-neg-z', 'tip-pos-z'];
        } else if (rotorNames.length === 3) {
          // Center + two tips along the long axis
          const box = partWorldBounds(target);
          const sizeX = box.max.x - box.min.x;
          const sizeZ = box.max.z - box.min.z;
          anchors = sizeX >= sizeZ ? ['tip-neg-x', 'center', 'tip-pos-x']
                                   : ['tip-neg-z', 'center', 'tip-pos-z'];
        } else if (rotorNames.length === 4) {
          // Four corners — proper quadcopter layout
          anchors = ['corner-fl', 'corner-fr', 'corner-bl', 'corner-br'];
        } else if (rotorNames.length === 6) {
          // 4 corners + 2 mid-axis points (hexacopter-ish)
          anchors = ['corner-fl', 'corner-fr', 'corner-bl', 'corner-br', 'tip-neg-x', 'tip-pos-x'];
        } else {
          // Fallback: distribute evenly between the two long-axis tips
          const box = partWorldBounds(target);
          const sizeX = box.max.x - box.min.x;
          const sizeZ = box.max.z - box.min.z;
          anchors = [];
          for (let i = 0; i < rotorNames.length; i++) {
            const t = i / (rotorNames.length - 1);
            // Pick the longer axis as the strung-out one
            if (sizeX >= sizeZ) {
              const x = box.min.x + (box.max.x - box.min.x) * t;
              anchors.push({ x, y: box.max.y, z: (box.min.z + box.max.z) / 2 });
            } else {
              const z = box.min.z + (box.max.z - box.min.z) * t;
              anchors.push({ x: (box.min.x + box.max.x) / 2, y: box.max.y, z });
            }
          }
          // Apply the raw-coord anchors directly
          let placed = 0;
          for (let i = 0; i < rotorNames.length; i++) {
            const a = anchors[i];
            const p = partsRegistry.get(rotorNames[i]);
            if (!p || !p.object) continue;
            p.object.updateMatrixWorld(true);
            const pBox = new THREE.Box3().setFromObject(p.object);
            const pCenter = new THREE.Vector3(); pBox.getCenter(pCenter);
            const pBottomOffset = pCenter.y - pBox.min.y;
            const wantWorld = new THREE.Vector3(a.x, a.y + pBottomOffset, a.z);
            const delta = wantWorld.sub(pCenter);
            p.object.position.add(delta);
            placed++;
          }
          return { placed, target };
        }
        const placed = snapPartsToAnchors(rotorNames, target, anchors);
        return { placed, target };
      }
      // Expose on window for chat-command + UI button bindings
      window.snapPartToAnchor = snapPartToAnchor;
      window.autoSnapRotorsToBoom = autoSnapRotorsToBoom;
      window.findBoomLikePart = findBoomLikePart;
      window.findAllBoomLikeParts = findAllBoomLikeParts;

      function disposeRegistered(name) {
        const p = partsRegistry.get(name);
        if (!p) return false;
        // If the deleted part is currently selected, drop the selection cleanly first
        if (typeof selectedPartName !== 'undefined' && selectedPartName === name) {
          if (typeof deselectPart === 'function') deselectPart();
        }
        const obj = p.object;
        if (obj) taxi.remove(obj);   // detach only — keep geometry alive in case undo needs it
        partsRegistry.delete(name);
        return true;
      }

      const COLOR_NAMES = {
        red: '#DC2626', crimson: '#B91C1C', scarlet: '#EF4444', maroon: '#7F1D1D',
        blue: '#2563EB', navy: '#1E3A8A', azure: '#0EA5E9', cobalt: '#1E40AF', sapphire: '#1E3A8A',
        green: '#16A34A', forest: '#14532D', emerald: '#10B981', lime: '#84CC16', mint: '#5EEAD4', olive: '#4D7C0F',
        yellow: '#FACC15', gold: '#D4A574', amber: '#F59E0B', mustard: '#CA8A04',
        orange: '#EA580C', coral: '#FB7185', tangerine: '#F97316',
        purple: '#9D4EDD', violet: '#7C3AED', magenta: '#FF006E', lavender: '#A78BFA', indigo: '#4F46E5',
        pink: '#EC4899', rose: '#FB7185', fuchsia: '#D946EF',
        black: '#0E0E14', charcoal: '#181820', anthracite: '#1F1F28', onyx: '#0A0A12',
        white: '#FFFFFF', silver: '#E5E7EB', ivory: '#FFFEF7', cream: '#FFF8DC', pearl: '#F8FAFC',
        gray: '#6B7280', grey: '#6B7280', slate: '#475569', gunmetal: '#2A2A38',
        cyan: '#00E5FF', teal: '#0F766E', turquoise: '#5EEAD4', aqua: '#22D3EE',
        brown: '#92400E', tan: '#D4A574', beige: '#F5F5DC', sand: '#FBBF24', khaki: '#A8A29E',
        midnight: '#0E0E14', ocean: '#0C4A6E', sky: '#0EA5E9'
      };

      const NUM_WORDS = { one:1, two:2, three:3, four:4, five:5, six:6, seven:7, eight:8, nine:9, ten:10, twelve:12 };

      // ==================== PARSING HELPERS ====================
      function parseColor(text) {
        const hex = text.match(/#([A-Fa-f0-9]{6})\b/);
        if (hex) return { hex: '#' + hex[1].toUpperCase(), name: hex[1].toUpperCase() };
        const lower = text.toLowerCase();
        let best = null;
        for (const [name, h] of Object.entries(COLOR_NAMES)) {
          if (new RegExp(`\\b${name}\\b`).test(lower) && (!best || name.length > best.name.length)) {
            best = { name, hex: h };
          }
        }
        return best;
      }

      function parseCount(text, fallback = 1) {
        const m = text.match(/\b(\d+)\b/);
        if (m) return Math.max(1, Math.min(20, parseInt(m[1])));
        for (const [w, n] of Object.entries(NUM_WORDS)) if (new RegExp(`\\b${w}\\b`, 'i').test(text)) return n;
        return fallback;
      }

      // "2x1x0.5" or "2 x 1 x 0.5" → {w, h, d}
      function parseDimString(text) {
        const m = text.match(/([\d.]+)\s*[x×]\s*([\d.]+)(?:\s*[x×]\s*([\d.]+))?/);
        if (!m) return null;
        return {
          w: parseFloat(m[1]),
          h: parseFloat(m[2]),
          d: m[3] ? parseFloat(m[3]) : null,
          raw: m[0]
        };
      }

      // "key=value" pairs from text
      function parseKVs(text) {
        const out = {};
        for (const m of text.matchAll(/(\w+)\s*=\s*(-?[\d.]+)/g)) {
          out[m[1]] = parseFloat(m[2]);
        }
        return out;
      }

      // "0,0.5,0.3" → [0, 0.5, 0.3]
      function parseCoords(text) {
        const m = text.match(/(-?[\d.]+)\s*,\s*(-?[\d.]+)\s*,\s*(-?[\d.]+)/);
        return m ? [parseFloat(m[1]), parseFloat(m[2]), parseFloat(m[3])] : null;
      }

      // Direction keywords with magnitudes: "up 0.5", "forward 2"
      function parseDirections(text) {
        let dx = 0, dy = 0, dz = 0;
        const dirs = [
          [/up\s+(-?[\d.]+)/, (n) => dy += n],
          [/down\s+(-?[\d.]+)/, (n) => dy -= n],
          [/forward\s+(-?[\d.]+)/, (n) => dx += n],
          [/back(?:ward)?\s+(-?[\d.]+)/, (n) => dx -= n],
          [/right\s+(-?[\d.]+)/, (n) => dz += n],
          [/left\s+(-?[\d.]+)/, (n) => dz -= n]
        ];
        for (const [re, apply] of dirs) {
          const m = text.match(re);
          if (m) apply(parseFloat(m[1]));
        }
        return { dx, dy, dz };
      }

      // ==================== PRIMITIVE BUILDERS ====================
      function makePrimitiveMesh(shape, params) {
        let geo;
        const w = params.w ?? params.width ?? 1;
        const h = params.h ?? params.height ?? 1;
        const d = params.d ?? params.depth ?? params.w ?? 1;
        const r = params.r ?? params.radius ?? 0.5;
        const l = params.l ?? params.length ?? 1;

        if (shape === 'box' || shape === 'cube') {
          geo = new THREE.BoxGeometry(w, h, d);
        } else if (shape === 'cylinder' || shape === 'tube') {
          geo = new THREE.CylinderGeometry(r, r, l, 32);
        } else if (shape === 'sphere') {
          geo = new THREE.SphereGeometry(r, 32, 16);
        } else if (shape === 'cone') {
          geo = new THREE.ConeGeometry(r, h, 24);
        } else if (shape === 'torus') {
          const tube = params.tube ?? params.t ?? 0.1;
          geo = new THREE.TorusGeometry(r, tube, 12, 36);
        } else if (shape === 'disc' || shape === 'disk') {
          geo = new THREE.CylinderGeometry(r, r, 0.04, 36);
        } else {
          return null;
        }
        const mesh = new THREE.Mesh(geo, materials.primary);
        mesh.castShadow = true;
        mesh.receiveShadow = true;
        return { mesh, geo, dims: { w, h, d, r, l } };
      }

      function createPrimitive(shape, name, params) {
        const finalName = uniqueName(name || shape);
        const built = makePrimitiveMesh(shape, params);
        if (!built) return null;
        if (params.x !== undefined || params.y !== undefined || params.z !== undefined) {
          built.mesh.position.set(params.x ?? 0, params.y ?? 0, params.z ?? 0);
        }
        if (params.along === 'x' && (shape === 'cylinder' || shape === 'tube')) {
          built.mesh.rotation.z = Math.PI / 2;
        } else if (params.along === 'z' && (shape === 'cylinder' || shape === 'tube')) {
          built.mesh.rotation.x = Math.PI / 2;
        }
        taxi.add(built.mesh);
        registerPart(finalName, { object: built.mesh, type: shape, kind: 'primitive', dims: built.dims });
        document.getElementById('viewport').classList.add('has-vehicle');
        refreshGeometryStats();
        return { name: finalName, dims: built.dims };
      }

      // ==================== AIRCRAFT FUSELAGE (lofted) ====================
      function buildAircraftFuselageGeo(L, W, H) {
        // Cross-sectional profile: x ranges -1..+1, ry = vertical radius, rz = horizontal radius
        // Front (cockpit) is fuller, tail boom tapers toward the rear
        const profile = [
          { x: -1.00, ry: 0.05, rz: 0.05 },
          { x: -0.86, ry: 0.22, rz: 0.18 },
          { x: -0.66, ry: 0.36, rz: 0.30 },
          { x: -0.40, ry: 0.42, rz: 0.36 },
          { x: -0.10, ry: 0.42, rz: 0.36 },
          { x:  0.18, ry: 0.36, rz: 0.32 },
          { x:  0.42, ry: 0.24, rz: 0.20 },
          { x:  0.62, ry: 0.14, rz: 0.12 },
          { x:  0.84, ry: 0.09, rz: 0.07 },
          { x:  1.00, ry: 0.05, rz: 0.05 }
        ];
        const SEG = 28;
        const verts = [];
        const idx = [];
        profile.forEach((cs) => {
          for (let j = 0; j <= SEG; j++) {
            const a = (j / SEG) * Math.PI * 2;
            const y = Math.sin(a) * cs.ry * H;
            const z = Math.cos(a) * cs.rz * W;
            verts.push(cs.x * L, y, z);
          }
        });
        for (let i = 0; i < profile.length - 1; i++) {
          for (let j = 0; j < SEG; j++) {
            const a = i * (SEG + 1) + j;
            const b = i * (SEG + 1) + j + 1;
            const c = (i + 1) * (SEG + 1) + j;
            const d = (i + 1) * (SEG + 1) + j + 1;
            idx.push(a, c, b, b, c, d);
          }
        }
        const geo = new THREE.BufferGeometry();
        geo.setAttribute('position', new THREE.BufferAttribute(new Float32Array(verts), 3));
        geo.setIndex(idx);
        geo.computeVertexNormals();
        return geo;
      }

      function getFuselageDims() {
        const fp = partsRegistry.get('fuselage');
        if (fp?.object) {
          // Read the LIVE bounding box of the mesh — accounts for scale + transforms
          const box = new THREE.Box3().setFromObject(fp.object);
          const size = new THREE.Vector3();
          box.getSize(size);
          const center = new THREE.Vector3();
          box.getCenter(center);
          const D = { L: size.x / 2, H: size.y / 2, W: size.z / 2, cx: center.x, cy: center.y, cz: center.z };
          D.l = D.L; D.h = D.H; D.w = D.W;
          if (fp.dims?.pax) D.pax = fp.dims.pax;
          if (fp.dims?.mass) D.mass = fp.dims.mass;
          return D;
        }
        return { L: 1.30, W: 0.70, H: 0.45, l: 1.30, w: 0.70, h: 0.45, cx: 0, cy: 0, cz: 0 };
      }

      // ==================== HIGH-LEVEL PART BUILDERS ====================
      function addFuselage(shape, dims) {
        // No replacement — first fuselage gets the canonical name "fuselage" (used as positioning anchor).
        // Subsequent ones get auto-suffixed names so they stack instead of overwriting.

        // Default dims (axis-half-extents in scene units)
        const D = { L: 1.30, W: 0.70, H: 0.45, mass: 920, pax: 4 };
        if (dims?.w) D.L = dims.w / 2;     // input is full-length, store as half-extent
        if (dims?.h) D.H = dims.h / 2;
        if (dims?.d) D.W = dims.d / 2;

        let geo;
        if (shape === 'aircraft' || shape === 'tapered' || shape === 'lofted') {
          geo = buildAircraftFuselageGeo(D.L, D.W, D.H);
        } else if (shape === 'cuboid' || shape === 'box') {
          geo = new THREE.BoxGeometry(D.L * 2, D.H * 2, D.W * 2);
        } else if (shape === 'cylinder') {
          geo = new THREE.CylinderGeometry(D.H, D.H, D.L * 2, 36);
          geo.rotateZ(Math.PI / 2);
          D.W = D.H;
        } else if (shape === 'sphere') {
          const r = (D.L + D.W + D.H) / 3;
          geo = new THREE.SphereGeometry(r, 48, 24);
          D.L = D.W = D.H = r;
        } else if (shape === 'teardrop') {
          geo = new THREE.SphereGeometry(1, 48, 24);
          const pos = geo.attributes.position;
          for (let i = 0; i < pos.count; i++) {
            const x = pos.getX(i), y = pos.getY(i), z = pos.getZ(i);
            const taper = x > 0 ? (1 - x * 0.35) : (1 + x * 0.15);
            pos.setX(i, x * D.L); pos.setY(i, y * D.H * taper); pos.setZ(i, z * D.W * taper);
          }
          geo.computeVertexNormals();
        } else if (shape === 'wedge') {
          const v = new Float32Array([
            D.L, 0, 0, -D.L, D.H, D.W, -D.L, D.H, -D.W, -D.L, -D.H, D.W, -D.L, -D.H, -D.W
          ]);
          geo = new THREE.BufferGeometry();
          geo.setAttribute('position', new THREE.BufferAttribute(v, 3));
          geo.setIndex([0,1,2, 0,3,1, 0,2,4, 0,4,3, 1,3,4, 1,4,2]);
          geo.computeVertexNormals();
        } else if (shape === 'capsule') {
          geo = THREE.CapsuleGeometry ? new THREE.CapsuleGeometry(D.H, D.L * 1.4, 8, 24)
                                      : new THREE.CylinderGeometry(D.H, D.H, D.L * 1.6, 28);
          geo.rotateZ(Math.PI / 2);
          D.W = D.H;
        } else {
          // ellipsoid (default)
          geo = new THREE.SphereGeometry(1, 56, 28);
          geo.scale(D.L, D.H, D.W);
        }

        const mesh = new THREE.Mesh(geo, materials.primary);
        mesh.castShadow = true;
        mesh.receiveShadow = true;
        // Mirror legacy lowercase aliases
        D.l = D.L; D.w = D.W; D.h = D.H;
        taxi.add(mesh);
        const fuselageName = uniqueName('fuselage');
        registerPart(fuselageName, { object: mesh, type: 'fuselage', kind: 'fuselage', shape, dims: D });
        document.getElementById('viewport').classList.add('has-vehicle');
        refreshSpecsFromFuselage();
        refreshGeometryStats();
        return { shape, dims: D, name: fuselageName };
      }

      function addCockpit() {
        const D = getFuselageDims();
        // Bubble canopy on top of forward third
        const geo = new THREE.SphereGeometry(1, 36, 18, 0, Math.PI * 2, 0, Math.PI * 0.62);
        geo.scale(D.L * 0.36, D.H * 0.85, D.W * 0.78);
        const mesh = new THREE.Mesh(geo, materials.glass);
        mesh.position.set(D.L * -0.05, D.H * 0.55, 0);
        taxi.add(mesh);
        registerPart(uniqueName('cockpit'), { object: mesh, type: 'cockpit', kind: 'cockpit' });
        refreshGeometryStats();
      }

      function addNose() {
        const D = getFuselageDims();
        const geo = new THREE.ConeGeometry(D.H * 0.45, D.L * 0.4, 24);
        geo.rotateZ(-Math.PI / 2);
        const mesh = new THREE.Mesh(geo, materials.accent);
        mesh.position.set(D.L * 1.05, 0, 0);
        mesh.castShadow = true;
        taxi.add(mesh);
        registerPart(uniqueName('nose'), { object: mesh, type: 'nose', kind: 'nose' });
        refreshGeometryStats();
      }

      function addTail(type) {
        const D = getFuselageDims();
        const xRear = -D.L * 0.95;
        const group = new THREE.Group();

        if (type === 'T') {
          // Position T-tail at 70% rear (where body still has volume)
          const finX = -D.L * 0.70;
          // Fin base sits BELOW fuselage center (embeds INTO body) so it visibly emerges through the top
          const finBaseY = -D.H * 0.20;
          const finTopY  =  D.H * 1.95;
          const finHeight = finTopY - finBaseY;
          const finGeo = new THREE.BoxGeometry(0.36, finHeight, 0.07);
          const fin = new THREE.Mesh(finGeo, materials.primary);
          fin.position.set(finX, (finBaseY + finTopY) / 2, 0);
          fin.castShadow = true;
          group.add(fin);
          // Horizontal stabilizer mounted on top of the fin
          const stabGeo = new THREE.BoxGeometry(0.34, 0.06, 0.74);
          const stab = new THREE.Mesh(stabGeo, materials.primary);
          stab.position.set(finX, finTopY - 0.04, 0);
          stab.castShadow = true;
          group.add(stab);
        } else if (type === 'V') {
          const finGeo = new THREE.BoxGeometry(0.50, 0.05, 0.45);
          for (const side of [1, -1]) {
            const f = new THREE.Mesh(finGeo, materials.primary);
            f.position.set(xRear, D.H * 0.4, side * 0.16);
            f.rotation.z = side * 0.5;
            f.rotation.x = side * 0.55;
            f.castShadow = true;
            group.add(f);
          }
        } else if (type === 'H') {
          const stab = new THREE.Mesh(new THREE.BoxGeometry(0.36, 0.04, 0.95), materials.primary);
          stab.position.set(xRear, D.H * 0.4, 0);
          stab.castShadow = true;
          group.add(stab);
          for (const side of [1, -1]) {
            const fin = new THREE.Mesh(new THREE.BoxGeometry(0.36, 0.45, 0.04), materials.primary);
            fin.position.set(xRear, D.H * 0.4 + 0.22, side * 0.45);
            fin.castShadow = true;
            group.add(fin);
          }
        } else if (type === 'delta') {
          const finGeo = new THREE.BoxGeometry(0.65, 0.04, 0.45);
          for (const side of [1, -1]) {
            const f = new THREE.Mesh(finGeo, materials.primary);
            f.position.set(xRear + 0.1, D.H * 0.3, side * 0.40);
            f.rotation.z = 0.32;
            f.rotation.y = side * -0.4;
            f.castShadow = true;
            group.add(f);
          }
        } else {
          // conventional cross
          const fin = new THREE.Mesh(new THREE.BoxGeometry(0.45, 0.50, 0.04), materials.primary);
          fin.position.set(xRear, D.H * 0.45, 0);
          fin.castShadow = true;
          group.add(fin);
          const stab = new THREE.Mesh(new THREE.BoxGeometry(0.36, 0.04, 0.75), materials.primary);
          stab.position.set(xRear, D.H * 0.35, 0);
          stab.castShadow = true;
          group.add(stab);
        }
        taxi.add(group);
        registerPart(uniqueName('tail'), { object: group, type: 'tail', kind: 'tail', tailType: type });
        refreshGeometryStats();
      }

      // Longitudinal boom mounted above the fuselage on a pylon
      function addBoom(side, opts = {}) {
        const D = getFuselageDims();
        const length = opts.length ?? Math.max(2.5, D.L * 2.4);
        const offset = opts.offset ?? Math.max(D.W * 1.5, 0.85);  // booms clearly OUTSIDE fuselage
        // Cap elevation: sit just above fuselage top, not scaled by height.
        // Tall fuselages used to push booms way overhead, making pylons look
        // like flagpoles in the launch pad render.
        const fuselageTop_b = D.H * 0.5;
        const elev   = opts.elev   ?? (fuselageTop_b + 0.35);
        const radius = opts.radius ?? 0.055;

        const z = side === 'left' ? -offset : offset;
        const group = new THREE.Group();

        // The boom — long thin cylinder along X
        const boomGeo = new THREE.CylinderGeometry(radius, radius, length, 16);
        boomGeo.rotateZ(Math.PI / 2);
        const boom = new THREE.Mesh(boomGeo, materials.accent);
        boom.position.set(0, elev, z);
        boom.castShadow = true;
        group.add(boom);

        taxi.add(group);
        const name = uniqueName(`boom_${side}`);
        registerPart(name, {
          object: group,
          type: 'boom',
          kind: 'boom',
          side, length, offset, elev,
          tips: [
            { x: -length / 2, y: elev, z: z },
            { x:  length / 2, y: elev, z: z }
          ]
        });
        refreshGeometryStats();
        return { name, offset, elev };
      }

      // Add a pair of booms WITH a clearly-visible structural assembly attached to the fuselage.
      // Returns ONE unified Group registered as a single 'boom_assembly' part — so the
      // fairing + 2 pylons + 2 booms move/rotate/scale as one piece when dragged in the
      // inspector. The internal pieces are still tagged with their roles via userData
      // so analyzers (rotor placement, mass calc) can still find them.
      function addBoomsPair(opts = {}) {
        const D = getFuselageDims();
        const offset = opts.offset ?? Math.max(D.W * 1.4, 0.85);
        const fuselageTop = D.H * 0.5;
        const elev   = opts.elev   ?? (fuselageTop + 0.35);
        const length = opts.length ?? Math.max(2.5, D.L * 2.4);
        const radius = opts.radius ?? 0.055;

        // Build everything as children of one unified group.
        const group = new THREE.Group();

        // 1. Wing-root fairing — chunky block sitting ON TOP of fuselage
        const fairingW = D.L * 0.55;
        const fairingH = Math.min(D.H * 0.35, 0.25);
        const fairingD = offset * 2 + 0.30;
        const fairingY = fuselageTop - fairingH * 0.3;
        const fairing = new THREE.Mesh(
          new THREE.BoxGeometry(fairingW, fairingH, fairingD),
          materials.primary
        );
        fairing.position.set(0, fairingY, 0);
        fairing.castShadow = true;
        fairing.receiveShadow = true;
        fairing.userData.role = 'crossbeam';
        group.add(fairing);

        // 2. Pylons — short vertical struts from fairing top up to boom level
        const pylonBottom = fairingY + fairingH / 2 - 0.04;
        const pylonH = Math.max(elev - pylonBottom, 0.1);
        for (const side of ['left', 'right']) {
          const z = side === 'left' ? -offset : offset;
          const pylonGeo = new THREE.BoxGeometry(0.28, pylonH, 0.18);
          const pylon = new THREE.Mesh(pylonGeo, materials.primary);
          pylon.position.set(0, pylonBottom + pylonH / 2, z);
          pylon.castShadow = true;
          pylon.userData.role = `pylon_${side}`;
          group.add(pylon);
        }

        // 3. Booms — long thin cylinders along X
        const tips = [];
        for (const side of ['left', 'right']) {
          const z = side === 'left' ? -offset : offset;
          const boomGeo = new THREE.CylinderGeometry(radius, radius, length, 16);
          boomGeo.rotateZ(Math.PI / 2);
          const boom = new THREE.Mesh(boomGeo, materials.accent);
          boom.position.set(0, elev, z);
          boom.castShadow = true;
          boom.userData.role = `boom_${side}`;
          group.add(boom);
          // Track tip world coordinates for rotor placement
          tips.push({ x: -length / 2, y: elev, z });
          tips.push({ x:  length / 2, y: elev, z });
        }

        taxi.add(group);
        const name = uniqueName('boom_assembly');
        registerPart(name, {
          object: group,
          type: 'boom',
          kind: 'boom',
          length, offset, elev,
          tips     // both booms' tips, used by addRotors when position='boom_tips'
        });
        refreshGeometryStats();
        return [name];
      }

      // Add rotors with smart placement
      function addRotors(count, position) {
        // 'append' mode: keep existing rotors and just add `count` more nearby.
        // Standard modes wipe and re-place all rotors at canonical positions.
        const append = (position === 'append');
        if (!append) {
          for (const [n, p] of Array.from(partsRegistry.entries())) {
            if (p.kind === 'rotor') { disposeRegistered(n); }
          }
          rotors = [];
        } else {
          // Append mode: place each new rotor at a free spot — start with the
          // fuselage top, offset to the side if there's already a rotor there.
          const D = getFuselageDims();
          const existing = Array.from(partsRegistry.entries()).filter(([_, p]) => p.kind === 'rotor').length;
          const mounts = [];
          for (let i = 0; i < count; i++) {
            const idx = existing + i;
            // Spiral out from origin: alternate left/right, advance forward
            const ring = Math.floor(idx / 4);
            const slot = idx % 4;
            const ringR = (ring + 1) * 0.7;
            const angle = (slot / 4) * Math.PI * 2 + Math.PI / 4;
            mounts.push({
              x: Math.cos(angle) * ringR,
              y: D.H * 0.5 + 0.25,
              z: Math.sin(angle) * ringR
            });
          }
          // Build each rotor at its mount point
          for (let i = 0; i < count; i++) {
            const m = mounts[i];
            buildSingleRotor(m.x, m.y, m.z);
          }
          refreshGeometryStats();
          return;
        }

        // Determine mount points
        const mounts = [];
        const booms = Array.from(partsRegistry.entries()).filter(([_, p]) => p.kind === 'boom');
        const wings = Array.from(partsRegistry.entries()).filter(([_, p]) => p.kind === 'wing');

        if (position === 'wing_tips' && wings.length > 0) {
          // Joby-style: mount rotors at the OUTER tip of each wing, plus distribute extras
          // along the wing span if more rotors than wing tips.
          const D = getFuselageDims();
          // For each wing, derive its outer tip (the end farthest from the fuselage centerline)
          const wingTips = [];
          const wingMid = [];     // midpoints (used when count > 2)
          for (const [_, w] of wings) {
            const box = new THREE.Box3().setFromObject(w.object);
            const size = new THREE.Vector3(); box.getSize(size);
            const center = new THREE.Vector3(); box.getCenter(center);
            // Wing's long axis is typically Z (span). Tip is at center.z ± size.z/2 — use
            // whichever is farther from origin.
            const tipZ = (center.z >= 0) ? (center.z + size.z * 0.45) : (center.z - size.z * 0.45);
            const midZ = (center.z >= 0) ? (center.z + size.z * 0.18) : (center.z - size.z * 0.18);
            // Rotors on Joby sit ABOVE the wing (tilting nacelles)
            const rotorY = center.y + 0.05;
            wingTips.push({ x: center.x - 0.05, y: rotorY, z: tipZ });
            wingMid.push({ x: center.x - 0.15, y: rotorY, z: midZ });
          }
          // Take outer-tip mounts first
          for (const m of wingTips) mounts.push(m);
          // If more rotors needed, add midpoint mounts (Joby S4 has 4 wing-tip + 2 wing-root forward = 6)
          if (count > mounts.length) {
            for (const m of wingMid) {
              if (mounts.length >= count) break;
              mounts.push(m);
            }
          }
          // If still need more, distribute along inner wing span
          if (count > mounts.length) {
            for (const [_, w] of wings) {
              if (mounts.length >= count) break;
              const box = new THREE.Box3().setFromObject(w.object);
              const size = new THREE.Vector3(); box.getSize(size);
              const center = new THREE.Vector3(); box.getCenter(center);
              const innerZ = (center.z >= 0) ? (center.z - size.z * 0.20) : (center.z + size.z * 0.20);
              mounts.push({ x: center.x + 0.18, y: center.y + 0.05, z: innerZ });
            }
          }
        } else if ((position === 'arm_tips' || position === 'boom_tips' || position === undefined) && booms.length > 0) {
          // Mount on every tip of every boom (2 per boom)
          for (const [_, b] of booms) {
            for (const tip of b.tips) mounts.push({ x: tip.x, y: tip.y, z: tip.z });
          }
        } else {
          // Fallback: distribute around fuselage at standard armY
          const D = getFuselageDims();
          const r = Math.max(D.L, D.W * 1.7) + 0.55;
          const armY = D.H * 0.42 + 0.225;
          for (let i = 0; i < count; i++) {
            const a = (i / count) * Math.PI * 2 + Math.PI / count;
            mounts.push({ x: Math.cos(a) * r, y: armY, z: Math.sin(a) * r });
          }
        }

        // Limit/pad mounts to exactly match the requested count
        if (mounts.length > count) {
          mounts.length = count;
        } else if (mounts.length < count) {
          // Need more mount points — pad with radial positions around the fuselage
          const D = getFuselageDims();
          const r = Math.max(D.L, D.W * 1.7) + 0.55;
          const armY = D.H * 0.42 + 0.225;
          const extra = count - mounts.length;
          for (let i = 0; i < extra; i++) {
            const a = (i / extra) * Math.PI * 2 + Math.PI / extra;
            mounts.push({ x: Math.cos(a) * r, y: armY, z: Math.sin(a) * r });
          }
        }
        const finalMounts = mounts;

        finalMounts.forEach((p, i) => {
          buildSingleRotor(p.x, p.y, p.z);
        });

        document.getElementById('rotor-hexacopter')?.classList.add('active');
        refreshGeometryStats();
        return finalMounts.length;
      }

      // Build one rotor at the given world XYZ. Used by addRotors() (which builds
      // many at canonical positions) and by addRotors(count, 'append') (which
      // adds rotors WITHOUT wiping existing — for individual rotor placement).
      function buildSingleRotor(x, y, z) {
        const group = new THREE.Group();
        const housing = new THREE.Mesh(new THREE.CylinderGeometry(0.34, 0.34, 0.14, 32), materials.housing);
        housing.position.y = -0.115;
        housing.castShadow = true;
        group.add(housing);

        const ring = new THREE.Mesh(new THREE.TorusGeometry(0.32, 0.014, 8, 32), materials.trim);
        ring.rotation.x = Math.PI / 2;
        ring.position.y = -0.035;
        group.add(ring);

        const hub = new THREE.Mesh(new THREE.CylinderGeometry(0.05, 0.05, 0.07, 12), materials.trim);
        group.add(hub);

        const blades = new THREE.Group();
        const bladeGeo = new THREE.BoxGeometry(0.66, 0.012, 0.05);
        const b1 = new THREE.Mesh(bladeGeo, materials.blade);
        const b2 = new THREE.Mesh(bladeGeo, materials.blade);
        b2.rotation.y = Math.PI / 2;
        blades.add(b1, b2);
        group.add(blades);
        rotors.push(blades);

        group.position.set(x, y, z);
        taxi.add(group);
        // Use a numeric counter that doesn't conflict with existing rotor_N names
        const existingRotors = Array.from(partsRegistry.keys()).filter(n => n.startsWith('rotor_')).length;
        const name = uniqueName(`rotor_${existingRotors + 1}`);
        registerPart(name, { object: group, type: 'rotor', kind: 'rotor', position: { x, y, z } });
        return name;
      }

      function addArms(count, position) {
        // Wipe existing arms
        for (const [n, p] of Array.from(partsRegistry.entries())) {
          if (p.kind === 'arm') disposeRegistered(n);
        }

        const D = getFuselageDims();
        const armR = Math.max(D.L, D.W * 1.7) + 0.55;
        const armY = D.H * 0.42;
        const angles = [];

        if (position === 'sides') {
          const half = Math.ceil(count / 2);
          for (let i = 0; i < half; i++) {
            const t = (i + 0.5) / half;
            const off = (t - 0.5) * Math.PI * 0.6;
            angles.push(Math.PI / 2 + off);
            if (angles.length < count) angles.push(-Math.PI / 2 - off);
          }
        } else if (position === 'corners') {
          const slot = [Math.PI / 4, 3 * Math.PI / 4, -3 * Math.PI / 4, -Math.PI / 4];
          for (let i = 0; i < count; i++) angles.push(slot[i % 4]);
        } else if (position === 'front') {
          for (let i = 0; i < count; i++) angles.push(((i + 0.5) / count - 0.5) * Math.PI * 0.7);
        } else if (position === 'rear') {
          for (let i = 0; i < count; i++) angles.push(Math.PI + ((i + 0.5) / count - 0.5) * Math.PI * 0.7);
        } else {
          for (let i = 0; i < count; i++) angles.push((i / count) * Math.PI * 2 + Math.PI / count);
        }

        angles.forEach((angle, i) => {
          const x = Math.cos(angle) * armR;
          const z = Math.sin(angle) * armR;
          const innerX = Math.cos(angle) * 0.45;
          const innerZ = Math.sin(angle) * 0.45;
          const armLen = Math.hypot(x - innerX, z - innerZ);
          const geo = new THREE.CylinderGeometry(0.065, 0.085, armLen, 14);
          const arm = new THREE.Mesh(geo, materials.accent);
          arm.castShadow = true;
          arm.position.set((x + innerX) / 2, armY, (z + innerZ) / 2);
          arm.rotation.z = Math.PI / 2;
          arm.rotation.y = -angle;
          taxi.add(arm);
          const name = uniqueName(`arm_${i + 1}`);
          registerPart(name, { object: arm, type: 'arm', kind: 'arm', tip: { x, y: armY + 0.225, z } });
        });
        refreshGeometryStats();
      }

      function addSkids() {
        const D = getFuselageDims();
        const skidLen = D.L * 1.4;
        const skidGeo = new THREE.CylinderGeometry(0.055, 0.055, skidLen, 14);
        let i = 0;
        [-D.W * 0.55, D.W * 0.55].forEach(z => {
          const skid = new THREE.Mesh(skidGeo, materials.gear);
          skid.position.set(0, -D.H * 0.92, z);
          skid.rotation.z = Math.PI / 2;
          skid.castShadow = true;
          taxi.add(skid);
          registerPart(uniqueName(`skid_${++i}`), { object: skid, type: 'skid', kind: 'skid' });
          [-D.L * 0.4, D.L * 0.4].forEach(x => {
            const strut = new THREE.Mesh(new THREE.CylinderGeometry(0.038, 0.038, D.H * 0.55, 8), materials.gear);
            strut.position.set(x, -D.H * 0.62, z);
            taxi.add(strut);
            registerPart(uniqueName(`strut_${++i}`), { object: strut, type: 'strut', kind: 'skid' });
          });
        });
        refreshGeometryStats();
      }

      function addTricycleGear() {
        const D = getFuselageDims();
        const wheelR = 0.10;
        const strutH = 0.28;
        const groundY = -D.H - strutH - wheelR;

        // Nose wheel — forward of CG
        const noseX = D.L * 0.5;
        const nStrut = new THREE.Mesh(new THREE.CylinderGeometry(0.025, 0.025, strutH, 8), materials.gear);
        nStrut.position.set(noseX, -D.H - strutH / 2, 0);
        taxi.add(nStrut);
        registerPart(uniqueName('nose_strut'), { object: nStrut, type: 'strut', kind: 'gear' });

        const nWheel = new THREE.Mesh(new THREE.TorusGeometry(wheelR * 0.85, 0.035, 12, 24), materials.gear);
        nWheel.position.set(noseX, groundY + wheelR * 0.85, 0);
        nWheel.rotation.y = Math.PI / 2;
        taxi.add(nWheel);
        registerPart(uniqueName('nose_wheel'), { object: nWheel, type: 'wheel', kind: 'gear' });

        // Main wheels — aft of CG, lateral spread
        const mainX = -D.L * 0.18;
        const mainZ = D.W * 0.85;
        let i = 0;
        for (const z of [-mainZ, mainZ]) {
          const strut = new THREE.Mesh(new THREE.CylinderGeometry(0.03, 0.03, strutH, 8), materials.gear);
          strut.position.set(mainX, -D.H - strutH / 2, z);
          taxi.add(strut);
          registerPart(uniqueName(`main_strut_${++i}`), { object: strut, type: 'strut', kind: 'gear' });
          const wheel = new THREE.Mesh(new THREE.TorusGeometry(wheelR, 0.045, 12, 24), materials.gear);
          wheel.position.set(mainX, groundY + wheelR, z);
          wheel.rotation.y = Math.PI / 2;
          taxi.add(wheel);
          registerPart(uniqueName(`main_wheel_${i}`), { object: wheel, type: 'wheel', kind: 'gear' });
        }
        refreshGeometryStats();
      }

      function addWings() {
        const D = getFuselageDims();
        // Wing length 1.6 in Z; center placed so the wing INTERSECTS the fuselage body
        const wingLen = 1.6;
        const wingGeo = new THREE.BoxGeometry(0.55, 0.05, wingLen);
        let i = 0;
        for (const side of [1, -1]) {
          const w = new THREE.Mesh(wingGeo, materials.primary);
          // Inner edge of wing sits at z = ±D.W*0.4 (clearly INSIDE fuselage), tip extends outward
          const innerEdge = D.W * 0.4;
          const center = side * (innerEdge + wingLen / 2);
          w.position.set(0, -D.H * 0.05, center);
          w.castShadow = true;
          taxi.add(w);
          registerPart(uniqueName(`wing_${++i}`), { object: w, type: 'wing', kind: 'wing' });
        }
        refreshGeometryStats();
      }

      // Door panel — a recessed-looking rectangle on the fuselage side
      function addDoor(opts = {}) {
        const D = getFuselageDims();
        const side = opts.side === 'right' ? 1 : -1;
        const doorMat = new THREE.MeshStandardMaterial({
          color: 0x0E1424, roughness: 0.35, metalness: 0.55, emissive: 0x0E1424
        });
        const w = D.L * 0.30;     // width along fuselage X
        const h = D.H * 1.10;     // height (cabin)
        const t = 0.025;
        const panel = new THREE.Mesh(new THREE.BoxGeometry(w, h, t), doorMat);
        panel.position.set(D.L * 0.05, D.H * 0.05, side * (D.W + t * 0.5));
        panel.castShadow = true;
        taxi.add(panel);
        // Door frame outline (thin trim ring around the panel for visibility)
        const frameMat = materials.trim;
        const frame = new THREE.Mesh(new THREE.TorusGeometry(0.001, 0.005, 4, 4), frameMat);
        // Approximate frame with 4 thin bars
        const grp = new THREE.Group();
        grp.add(panel);
        const barT = 0.012;
        const bars = [
          { x: D.L * 0.05, y: D.H * 0.05 + h / 2, w, h: barT, z: side * (D.W + t * 0.6) }, // top
          { x: D.L * 0.05, y: D.H * 0.05 - h / 2, w, h: barT, z: side * (D.W + t * 0.6) }, // bottom
          { x: D.L * 0.05 + w / 2, y: D.H * 0.05, w: barT, h, z: side * (D.W + t * 0.6) }, // right
          { x: D.L * 0.05 - w / 2, y: D.H * 0.05, w: barT, h, z: side * (D.W + t * 0.6) }, // left
        ];
        for (const b of bars) {
          const bar = new THREE.Mesh(new THREE.BoxGeometry(b.w, b.h, t * 0.6), frameMat);
          bar.position.set(b.x, b.y, b.z);
          grp.add(bar);
        }
        taxi.add(grp);
        const name = uniqueName(opts.side === 'right' ? 'door_right' : 'door_left');
        registerPart(name, { object: grp, type: 'door', kind: 'feature' });
        refreshGeometryStats();
        return name;
      }

      // Window — a glassy rectangular pane on the fuselage side
      function addWindow(opts = {}) {
        const D = getFuselageDims();
        const side = opts.side === 'right' ? 1 : -1;
        const winMat = new THREE.MeshStandardMaterial({
          color: 0x0a1a2e, transparent: true, opacity: 0.55, metalness: 0.85, roughness: 0.08, emissive: 0x122036
        });
        const grp = new THREE.Group();
        // Three side windows
        const w = D.L * 0.16;
        const h = D.H * 0.45;
        const t = 0.02;
        for (let i = -1; i <= 1; i++) {
          const pane = new THREE.Mesh(new THREE.BoxGeometry(w, h, t), winMat);
          pane.position.set(D.L * 0.0 + i * (w * 1.25), D.H * 0.25, side * (D.W + t * 0.5));
          grp.add(pane);
        }
        taxi.add(grp);
        const name = uniqueName(opts.side === 'right' ? 'windows_right' : 'windows_left');
        registerPart(name, { object: grp, type: 'window', kind: 'feature' });
        refreshGeometryStats();
        return name;
      }

      function addAntenna() {
        const D = getFuselageDims();
        const grp = new THREE.Group();
        const mast = new THREE.Mesh(new THREE.CylinderGeometry(0.012, 0.012, 0.32, 8), materials.gear);
        mast.position.set(-D.L * 0.4, D.H * 0.55 + 0.16, 0);
        const tip = new THREE.Mesh(new THREE.SphereGeometry(0.024, 12, 8), materials.trim);
        tip.position.set(-D.L * 0.4, D.H * 0.55 + 0.32, 0);
        grp.add(mast, tip);
        taxi.add(grp);
        registerPart(uniqueName('antenna'), { object: grp, type: 'antenna', kind: 'feature' });
        refreshGeometryStats();
      }

      // ==================== PARTS LIBRARY ====================
      // Each builder returns the registered name, places the part at a sensible default
      // position (often inside/under the fuselage), and selects it for immediate edit.

      // Shared materials used across library parts
      const libMaterials = {
        upholstery:    new THREE.MeshStandardMaterial({ color: 0x3a4d6a, roughness: 0.62, metalness: 0.05 }),
        upholsteryLt:  new THREE.MeshStandardMaterial({ color: 0x4a5d7d, roughness: 0.65, metalness: 0.05 }),
        seatFrame:     new THREE.MeshStandardMaterial({ color: 0x12161e, roughness: 0.4, metalness: 0.6 }),
        consoleBody:   new THREE.MeshStandardMaterial({ color: 0x0e1424, roughness: 0.45, metalness: 0.3 }),
        consoleScreen: new THREE.MeshStandardMaterial({ color: 0x00E5FF, emissive: 0x00B5CC, emissiveIntensity: 0.55, roughness: 0.2 }),
        crateWood:     new THREE.MeshStandardMaterial({ color: 0x6b4a2a, roughness: 0.85, metalness: 0.0 }),
        crateBand:     new THREE.MeshStandardMaterial({ color: 0x3a2818, roughness: 0.7, metalness: 0.2 }),
        battery:       new THREE.MeshStandardMaterial({ color: 0x1c2638, roughness: 0.55, metalness: 0.3 }),
        terminalPos:   new THREE.MeshStandardMaterial({ color: 0xc7281e, emissive: 0x661510, emissiveIntensity: 0.25, roughness: 0.4 }),
        terminalNeg:   new THREE.MeshStandardMaterial({ color: 0x9aac28, emissive: 0x4a5614, emissiveIntensity: 0.25, roughness: 0.4 }),
        tank:          new THREE.MeshStandardMaterial({ color: 0xc0c8d4, roughness: 0.35, metalness: 0.7 }),
        tankBand:      new THREE.MeshStandardMaterial({ color: 0xea580c, roughness: 0.6, metalness: 0.1 }),
        rack:          new THREE.MeshStandardMaterial({ color: 0x0a1018, roughness: 0.45, metalness: 0.6 }),
        // Cutout: dark matte panel that visually reads as a hole when placed flush against a surface
        cutoutDark:    new THREE.MeshStandardMaterial({ color: 0x000000, roughness: 0.95, metalness: 0.0 }),
        cutoutEdge:    new THREE.MeshStandardMaterial({ color: 0xf59e0b, emissive: 0xc77f06, emissiveIntensity: 0.4, roughness: 0.3 })
      };

      function _placeAndSelect(grp, baseName, type, kind, extra = {}) {
        taxi.add(grp);
        const name = uniqueName(baseName);
        registerPart(name, { object: grp, type, kind, library: true, ...extra });
        document.getElementById('viewport').classList.add('has-vehicle');
        refreshGeometryStats();
        // Auto-select so user can immediately position with gizmo / inspector
        if (typeof selectPart === 'function') {
          setTimeout(() => selectPart(name), 0);
        }
        return name;
      }

      // Snap a freshly-built seat group so its base sits on the fuselage cabin
      // floor instead of poking out the top, AND scale the seat to fit inside
      // the cabin interior height. The default seat geometry (cushion + back +
      // headrest) is ~0.7-0.9u tall, but a typical aircraft fuselage is only
      // ~0.3u tall internally. Scaling the seat to ~85% of cabin height makes
      // it look like a proper seated passenger inside the cabin.
      //
      // Also stores a "boardingTarget" world coordinate on the seat's userData
      // so the customer-boarding animation walks a passenger to the actual
      // seat position rather than a generic fuselage origin.
      function _snapSeatIntoCabin(seatGrp, defaultXZ = { x: -0.2, z: 0 }) {
        if (!partsRegistry.has('fuselage')) {
          // No fuselage yet — drop seat at origin; user will likely add fuselage later
          seatGrp.position.set(defaultXZ.x, 0, defaultXZ.z);
          return;
        }
        const D = getFuselageDims();
        // Cabin interior: roughly the inner 80% of the fuselage's vertical extent.
        // We avoid the very floor and the very ceiling (where curve narrows).
        const cabinTop    = (D.cy ?? 0) + D.H * 0.92;     // just below fuselage top
        const cabinFloor  = (D.cy ?? 0) - D.H * 0.92 + 0.02;  // small inset above floor
        const cabinHeight = cabinTop - cabinFloor;

        // Measure the seat's natural (pre-scale) height
        seatGrp.updateMatrixWorld(true);
        const seatBoxRaw = new THREE.Box3().setFromObject(seatGrp);
        const seatHeightRaw = seatBoxRaw.max.y - seatBoxRaw.min.y;

        // Scale seat to ~85% of cabin height, but never larger than original
        // and never smaller than 0.25× (so tiny fuselages don't squish seats
        // to invisibility — they just look big-for-the-cabin)
        let seatScale = 1.0;
        if (seatHeightRaw > 0 && cabinHeight > 0) {
          const targetH = cabinHeight * 0.85;
          seatScale = Math.min(1.0, Math.max(0.25, targetH / seatHeightRaw));
        }
        seatGrp.scale.set(seatScale, seatScale, seatScale);

        // After scaling, re-measure to get the new bottom offset
        seatGrp.updateMatrixWorld(true);
        const seatBox = new THREE.Box3().setFromObject(seatGrp);
        const seatMinY = seatBox.min.y;
        const seatRootY = seatGrp.position.y;
        const seatBottomBelowRoot = seatMinY - seatRootY;
        // Place root so seat bottom lands on the cabin floor
        const newRootY = cabinFloor - seatBottomBelowRoot;
        seatGrp.position.set(defaultXZ.x, newRootY, defaultXZ.z);

        // Compute final boarding target — the cushion surface where a passenger
        // would actually sit. Scale-aware: when the seat is shrunk to fit a
        // small cabin, the cushion is at a proportional fraction of the seat's
        // bbox. For all 3 seat types (bench/captain/bucket), the cushion top
        // sits roughly 30% above the seat's lowest point (above pedestals/legs,
        // below the backrest).
        seatGrp.updateMatrixWorld(true);
        const finalBox = new THREE.Box3().setFromObject(seatGrp);
        const center = new THREE.Vector3();
        finalBox.getCenter(center);
        const seatBottom = finalBox.min.y;
        const seatTop    = finalBox.max.y;
        // Cushion-top fraction across all three seat designs:
        //   captain: pedestal -0.20 → headrest +0.68 (height 0.88), cushion top ~0.09 → 33% up
        //   bench:   legs -0.16 → backrest +0.49 (height 0.65), cushion top ~0.10 → 40% up
        //   bucket:  pedestal -0.16 → bolster +0.59 (height 0.75), cushion top ~0.08 → 32% up
        const cushionTopY = seatBottom + (seatTop - seatBottom) * 0.35;
        seatGrp.userData.boardingTarget = {
          x: center.x,
          y: cushionTopY,
          z: center.z
        };
      }

      function addBenchSeat() {
        // 3-passenger bench: cushion + backrest + 2 dividers + base frame
        const grp = new THREE.Group();
        const W = 0.95, D = 0.4, H = 0.10;     // cushion size
        const cushion = new THREE.Mesh(new THREE.BoxGeometry(W, H, D), libMaterials.upholsteryLt);
        cushion.position.set(0, 0.04, 0);
        const backrest = new THREE.Mesh(new THREE.BoxGeometry(W, 0.42, 0.06), libMaterials.upholstery);
        backrest.position.set(0, 0.28, -D / 2 + 0.03);
        // Dividers
        const div1 = new THREE.Mesh(new THREE.BoxGeometry(0.02, 0.45, D), libMaterials.seatFrame);
        div1.position.set(-W / 6, 0.22, 0);
        const div2 = div1.clone();
        div2.position.x = W / 6;
        // Base frame
        const baseF = new THREE.Mesh(new THREE.BoxGeometry(W, 0.04, D), libMaterials.seatFrame);
        baseF.position.set(0, -0.04, 0);
        // Legs
        const legGeo = new THREE.BoxGeometry(0.04, 0.10, 0.04);
        for (const x of [-W/2 + 0.05, W/2 - 0.05]) {
          for (const z of [-D/2 + 0.05, D/2 - 0.05]) {
            const leg = new THREE.Mesh(legGeo, libMaterials.seatFrame);
            leg.position.set(x, -0.11, z);
            grp.add(leg);
          }
        }
        grp.add(cushion, backrest, div1, div2, baseF);
        grp.traverse(o => { if (o.isMesh) o.castShadow = true; });
        // Snap seat into cabin interior so it doesn't poke through the fuselage top.
        // Default XZ stays in passenger area (slightly aft of center).
        _snapSeatIntoCabin(grp, { x: -0.2, z: 0 });
        return _placeAndSelect(grp, 'bench_seat', 'bench-seat', 'interior');
      }

      function addCaptainSeat() {
        // Single tall-back captain's seat with armrests and headrest
        const grp = new THREE.Group();
        const cushion = new THREE.Mesh(new THREE.BoxGeometry(0.40, 0.09, 0.42), libMaterials.upholsteryLt);
        cushion.position.set(0, 0.045, 0);
        const back = new THREE.Mesh(new THREE.BoxGeometry(0.40, 0.50, 0.07), libMaterials.upholstery);
        back.position.set(0, 0.30, -0.18);
        const headrest = new THREE.Mesh(new THREE.BoxGeometry(0.28, 0.12, 0.08), libMaterials.upholstery);
        headrest.position.set(0, 0.62, -0.17);
        // Armrests
        const armGeo = new THREE.BoxGeometry(0.06, 0.05, 0.30);
        for (const x of [-0.21, 0.21]) {
          const arm = new THREE.Mesh(armGeo, libMaterials.upholstery);
          arm.position.set(x, 0.18, 0);
          grp.add(arm);
        }
        // Pedestal base
