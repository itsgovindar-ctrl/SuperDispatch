        document.getElementById('color-primary').value = '#F0F4FF';
        document.getElementById('color-accent').value = '#1E3A8A';
        document.getElementById('color-trim').value = '#00E5FF';
        document.getElementById('hex-primary').value = 'F0F4FF';
        document.getElementById('hex-accent').value = '1E3A8A';
        document.getElementById('hex-trim').value = '00E5FF';
        materials.primary.color.set('#F0F4FF');
        materials.accent.color.set('#1E3A8A');
        materials.trim.color.set('#00E5FF');
        materials.trim.emissive.set('#00E5FF'); materials.trim.emissive.multiplyScalar(0.7);
        document.getElementById('ai-prompt').value = '';
      });

      document.getElementById('btn-save').addEventListener('click', () => {
        // Open the save-design modal — the real save flow that prompts for a
