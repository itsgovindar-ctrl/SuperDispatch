      };
      function pickNarrationPhrase(role) {
        const arr = AI_TEAM_NARRATION[role] || AI_TEAM_NARRATION.OPS;
        return arr[Math.floor(Math.random() * arr.length)];
      }

      // Start a narration interval. Returns a function to stop it.
      function startTeamNarration(team, statusEl) {
        if (!team || team.length === 0 || !statusEl) return () => {};
        let i = 0;
        const cycle = () => {
          // Highlight current worker, dim others
          document.querySelectorAll('.ai-team-member.assigned').forEach(el => {
            el.classList.remove('active-worker');
          });
          const current = team[i % team.length];
          // Find chip for this member (by name match in the chip text)
          document.querySelectorAll('.ai-team-member.assigned').forEach(el => {
            if (el.textContent.includes(current.name)) {
              el.classList.add('active-worker');
            }
          });
          // Update the status line with what they're doing
          const phrase = pickNarrationPhrase(current.role);
          statusEl.className = 'ai-team-status';
          statusEl.textContent = `${current.name} (${current.role}) · ${phrase}`;
          i++;
        };
        cycle();     // immediate
        const handle = setInterval(cycle, 850);
        return () => {
          clearInterval(handle);
          // Clear active-worker highlight on stop
          document.querySelectorAll('.ai-team-member.active-worker').forEach(el => {
            el.classList.remove('active-worker');
          });
        };
      }

      // Pick a random subset, biased toward design-relevant roles
      function pickAiDesignTeam(roster, count) {
        if (!Array.isArray(roster) || roster.length === 0) return [];
        // Prefer roles that would plausibly own a design assignment
        const PRIORITY = ['DISPATCH', 'OPS', 'MAINT', 'GROUND', 'ATC'];
        const sorted = [...roster].sort((a, b) =>
          PRIORITY.indexOf(a.role) - PRIORITY.indexOf(b.role)
        );
        // Take top-N by priority but inject some randomness so the team
        // varies between clicks. Take 2x then random-sample down to count.
        const pool = sorted.slice(0, Math.min(roster.length, count * 2));
        // Shuffle pool
        for (let i = pool.length - 1; i > 0; i--) {
          const j = Math.floor(Math.random() * (i + 1));
          [pool[i], pool[j]] = [pool[j], pool[i]];
        }
        return pool.slice(0, count);
      }

      // Render the roster chips into the team panel
      function renderAiTeamRoster(highlightNames, isWorking) {
        const rosterEl = document.getElementById('ai-team-roster');
        if (!rosterEl) return;
        const buildFn = (typeof window !== 'undefined' && window.__buildCrewRoster) || null;
        const roster = buildFn ? buildFn() : [];
        if (!roster || roster.length === 0) {
          rosterEl.innerHTML = '<span class="ai-team-roster-loading">Crew not yet assembled — open hub at least once.</span>';
          return;
        }
        const highlightSet = new Set(highlightNames || []);
        rosterEl.innerHTML = roster.map(m => {
          const isAssigned = highlightSet.has(m.name);
          const cls = isAssigned ? (isWorking ? ' assigned working' : ' assigned') : '';
          return `<span class="ai-team-member${cls}">
            <span class="ai-team-member-role">${m.role}</span>
            <span>${m.name}</span>
          </span>`;
        }).join('');
      }

      // Generate a 4-character alphanumeric tag (like "A4B2")
      function aiDesignTag() {
        const A = 'ABCDEFGHJKMNPQRSTUVWXYZ23456789';     // no confusing chars
        let s = '';
        for (let i = 0; i < 4; i++) s += A[Math.floor(Math.random() * A.length)];
        return s;
      }

      // Click handler — runs an end-to-end build + save with team narration
      async function runAiTeamDesign() {
        const btn = document.getElementById('ai-team-design-btn');
        const btnText = btn?.querySelector('.ai-team-btn-text');
        const status = document.getElementById('ai-team-status');
        if (!btn || btn.classList.contains('working')) return;

        // No preview / confirmation — user: "should not show a
        // preview, just start building." If parts are present, push
        // an undo entry so the user can recover their previous design
        // with Cmd+Z, then clear silently.
        if (partsRegistry.size > 0) {
          if (typeof pushUndo === 'function') pushUndo();
          clearVehicle();
          partsRegistry.clear();
        }

        btn.classList.add('working');
        btnText.textContent = '◌ TEAM IS DESIGNING…';

        // Auto-frame the camera onto the build action. At default
        // zoom-out the figures are too small to see — pull in to a
        // close construction view. User: "people need to come as
        // real animations." This restores at the end.
        let savedCamPos = null, savedCamTarget = null;
        try {
          if (window.__mfgCamera && window.__mfgControls) {
            savedCamPos = window.__mfgCamera.position.clone();
            savedCamTarget = window.__mfgControls.target.clone();
            window.__mfgCamera.position.set(7, 3.5, 7);
            window.__mfgControls.target.set(0, 0.5, 0);
            window.__mfgControls.update();
          }
        } catch (_) {}

        // Show + reset build-team figures so they walk in for each step
        const figures = (typeof window !== 'undefined' && window.__mfgBuildTeamFigures) || [];
        for (const fig of figures) {
          fig.visible = true;
          if (fig.userData && fig.userData.buildTask) {
            const t = fig.userData.buildTask;
            fig.position.x = t.homeX;
            fig.position.z = t.homeZ;
            t.targetX = t.homeX;
            t.targetZ = t.homeZ;
            t.state = 'idle';
          }
        }
        // Step-event hook — executeBuildPlan calls window.__onBuildStep
        // for each step. The hook dispatches a figure to walk to the
        // build site WITH the next part in their hands, and returns a
        // Promise that resolves when the figure ARRIVES. The build
        // step pauses until the figure puts the part down, so the
        // user sees the figure deliver the part visibly.
        let figureRoundRobin = 0;
        window.__onBuildStep = function(stepIdx, totalSteps) {
          if (!figures || figures.length === 0) return;
          const fig = figures[figureRoundRobin % figures.length];
          figureRoundRobin++;
          if (!fig || !fig.userData || !fig.userData.buildTask) return;
          // Pick a build-spot near origin with a bit of jitter so the
          // figures don't stack in the exact same spot
          const angle = (figureRoundRobin * 1.7) % (Math.PI * 2);
          const radius = 1.3 + (figureRoundRobin % 3) * 0.25;
          const t = fig.userData.buildTask;
          // Start fresh at the home station so each delivery has the
          // full walk-in animation (instead of teleporting from
          // wherever the figure last was)
          fig.position.x = t.homeX;
          fig.position.z = t.homeZ;
          t.targetX = Math.cos(angle) * radius;
          t.targetZ = Math.sin(angle) * radius;
          t.state = 'walking_in';
          // Show carried part — color it with a slight tint for the
          // current build phase. (Tint is purely aesthetic.)
          if (fig.userData.carriedPart) {
            fig.userData.carriedPart.visible = true;
          }
          // Return a Promise that resolves when the figure arrives.
          // The mfg tick calls task.arrivalResolver() on transition
          // to 'placing'. Add a safety timeout in case anything
          // goes wrong — we never want to deadlock the build.
          return new Promise((resolve) => {
            t.arrivalResolver = resolve;
            // Safety timeout: max 4s for the figure to arrive (a
            // station-to-build walk at 1.4u/s over ~5u takes ~3.5s).
            // If the resolver hasn't fired by then, force-resolve so
            // the build keeps moving.
            setTimeout(() => {
              if (t.arrivalResolver === resolve) {
                t.arrivalResolver = null;
                resolve();
              }
            }, 4000);
          });
        };

        // Build (or recall) the roster and pick the assigned team
        const buildFn = (typeof window !== 'undefined' && window.__buildCrewRoster) || null;
        const roster = buildFn ? buildFn() : [];
        const team = pickAiDesignTeam(roster, 3);
        const teamNames = team.map(m => m.name);
        // Render WITH working class so the chips pulse during the build
        renderAiTeamRoster(teamNames, true);

        // Generate a UNIQUE brief — random fuselage, rotor count,
        // tail, color palette, purpose. User: "different everytime.
        // Like what I have made." Each click produces a fresh combo
        // instead of looking up one of six canned templates.
        const archetypeText = (typeof window !== 'undefined' && window.__generateRandomBrief)
          ? window.__generateRandomBrief()
          : 'A standard 4-passenger eVTOL with a teardrop fuselage, bubble canopy, 6 rotors, V-tail, tricycle gear, white airframe with cyan trim.';
        // Extract a short label for the status line — pull the first
        // 2-3 keyword tokens out of the brief
        const archetypeKey = (() => {
          const m = archetypeText.match(/A ([^,]+),/);
          if (m) return m[1].replace(/^a /i, '').trim().toUpperCase().replace(/\s+/g, ' ');
          return 'CUSTOM';
        })();

        // Status: who's on the job + what they picked
        const teamLine = team.length > 0
          ? team.map(m => `${m.name} (${m.role})`).join(' · ')
          : 'AI team';
        if (status) {
          status.className = 'ai-team-status';
          status.textContent = `${teamLine} → archetype: ${archetypeKey.toUpperCase()}`;
        }

        // Tiny pause for UX so the assignment is visible before the build kicks off
        await new Promise(r => setTimeout(r, 400));

        // Start narration — cycles status messages by role through the
        // build, e.g. "Walker (MAINT) · torquing fasteners on the
        // fuselage". Currently-narrating member's chip highlights
        // brighter via .active-worker. This is what makes the team
        // feel alive instead of static chips while executeBuildPlan
        // is running in parallel.
        const stopNarration = startTeamNarration(team, status);

        // Drive the existing description → plan → build pipeline.
        // CRITICAL: executeBuildPlan calls buildEVTOL() which builds
        // ALL ~30 parts in a SINGLE synchronous call (one plan step).
        // That's why the aircraft was popping into existence in 3
        // seconds even though figures were animating. Per the user:
        // "you can't just generate the aircraft in 3 seconds not how
        // it works. it needs to be piece by piece wings, tail,
        // propellers, motor etc. one by one."
        //
        // Fix: after executeBuildPlan completes, every part is in
        // partsRegistry. We HIDE them all, then REVEAL them
        // group-by-group, with each reveal paced to a figure
        // walk-in. The user sees a fully-defined plan that the team
        // physically delivers, one section at a time.
        let buildOk = true;
        try {
          const plan = interpretDescription(archetypeText);
          // Suppress per-step figure dispatch during the silent
          // build — all parts get registered fast, hidden, then
          // revealed by the section loop below.
          const savedHook = window.__onBuildStep;
          window.__onBuildStep = null;
          await executeBuildPlan(plan, archetypeText);
          // Add the AI compute module — every team-built aircraft
          // gets one. User: "there needs to be AI in it."
          try {
            if (typeof window.__addEvtolAIModule === 'function') {
              window.__addEvtolAIModule({});
            }
          } catch (e) { console.warn('[AI team] AI module failed:', e); }
          // Always install luxury cabin features. User: "the AI team
          // should do interiors such as chairs, indoor luxury."
          try {
            if (typeof window.__addLuxuryCabin === 'function') {
              window.__addLuxuryCabin({});
            }
          } catch (e) { console.warn('[AI team] luxury cabin failed:', e); }
          // ----- WACKY MODS -----
          // Pick 0-3 random mods (twin booms, dorsal pod, glowing
          // power core, sensor radome, rocket fins, pontoons, roll
          // bar, cargo grappler) and weld them onto the aircraft.
          // User: "I need wacky styles."
          const wackyMods = (typeof window.__pickWackyMods === 'function')
            ? window.__pickWackyMods() : [];
          for (const modId of wackyMods) {
            try {
              if (typeof window.__addWackyMod === 'function') {
                window.__addWackyMod(modId);
              }
            } catch (e) { console.warn('[AI team] wacky mod failed:', modId, e); }
          }
          // ----- COLOR FLAIR -----
          // 60% of the time, override the primary color with a
          // punchier palette so consecutive builds don't all look
          // like the same dark airframe. User: "needs to be unique
          // everytime ... or more funky." The parser's color
          // vocabulary is limited (red/blue/black/etc.) so we apply
          // these via direct material override after the build.
          try {
            if (typeof materials !== 'undefined' && materials.primary &&
                Math.random() < 0.6) {
              const FLAIR = [
                0xFF2D8A,    // hot pink
                0x00FF9F,    // neon green
                0xFFD700,    // gold
                0xFF5E1F,    // sunset orange
                0x9B00FF,    // electric purple
                0x00D4FF,    // electric cyan
                0xFF0033,    // pure crimson
                0xFFE600,    // bright yellow
                0xFF00AA,    // magenta
                0x39FF14,    // electric lime
              ];
              const flair = FLAIR[Math.floor(Math.random() * FLAIR.length)];
              materials.primary.color.setHex(flair);
              // Also update the matching color picker so the UI agrees
              const picker = document.getElementById('color-primary');
              const hex    = document.getElementById('hex-primary');
              const hexStr = '#' + flair.toString(16).padStart(6, '0');
              if (picker) picker.value = hexStr;
              if (hex) hex.value = hexStr.toUpperCase();
            }
          } catch (e) { console.warn('[AI team] color flair failed:', e); }
          window.__onBuildStep = savedHook;
          // ----- PIECE-BY-PIECE REVEAL -----
          // Group parts by section. The Map preserves insertion
          // order, so partsRegistry iteration gives parts in the
          // exact order buildEVTOL added them.
          const partGroups = [
            { label: 'Mount fuselage',       match: /^evtol_fuselage$/ },
            { label: 'Attach nose cone',     match: /^evtol_nose$/ },
            { label: 'Install canopy',       match: /^evtol_canopy$/ },
            { label: 'Mount main wing',      match: /^evtol_wing/ },
            { label: 'Install front rotors', match: /^evtol_fwd_/ },
            { label: 'Install rear rotors',  match: /^evtol_rear_/ },
            { label: 'Install tip rotors',   match: /^evtol_tip_/ },
            { label: 'Install rotor halo',   match: /^evtol_halo/ },
            { label: 'Mount rotor arms',     match: /^evtol_(arm|arm_hub)/ },
            // Twin-boom rail / skycrane sections
            { label: 'Lay rail booms',       match: /^evtol_rail_(boom|strut)/ },
            { label: 'Mount rail rotors',    match: /^evtol_rail_(post|rotor)/ },
            // Fixed-wing pusher / tractor sections
            { label: 'Mount pusher props',   match: /^evtol_pusher_/ },
            { label: 'Mount tractor prop',   match: /^evtol_tractor_/ },
            { label: 'Mount wing turboprops',match: /^evtol_wprop_/ },
            // CRITICAL: regex must match the ACTUAL part names that
            // buildEVTOL registers. Earlier this was /^evtol_tail/
            // and /^evtol_gear/ — neither matched real names. Tails
            // and landing gear were built, hidden, then NEVER
            // revealed because the section group skipped them.
            // User: "what did I say about the tail driling etc.
            // All those things are not there bro."
            { label: 'Bolt on tail surfaces',match: /^evtol_(vtail|t_vfin|t_hstab|conv_vfin|conv_hstab)/ },
            { label: 'Lower landing gear',   match: /^evtol_(nose_strut|nose_wheel|main_strut|main_wheel|skid)/ },
            { label: 'Fit pilot seat',       match: /^evtol_pilot_seat$/ },
            { label: 'Fit passenger seats',  match: /^evtol_pax_seat_/ },
            { label: 'Outfit luxury cabin',  match: /^evtol_lux_/ },
            { label: 'Install AI flight computer', match: /^evtol_ai_module$/ },
            // ===== WACKY MODS =====
            // Always defined; reveal loop skips groups with no
            // matching parts. Picked mods get applied above; their
            // parts then surface here as their own figure walks.
            { label: 'Weld twin tail booms',         match: /^evtol_wack_twinboom/ },
            { label: 'Bolt on dorsal cargo pod',     match: /^evtol_wack_dorsal_pod/ },
            { label: 'Install glowing power core',   match: /^evtol_wack_powercore/ },
            { label: 'Mount sensor radome',          match: /^evtol_wack_radome/ },
            { label: 'Add rocket-style tail fins',   match: /^evtol_wack_rocketfin/ },
            { label: 'Attach amphibious pontoons',   match: /^evtol_wack_pontoon/ },
            { label: 'Weld external roll bar',       match: /^evtol_wack_rollbar/ },
            { label: 'Attach underslung cargo hook', match: /^evtol_wack_grappler/ },
          ];
          // Hide every registered part — aircraft becomes invisible
          for (const [, entry] of partsRegistry.entries()) {
            if (entry && entry.object) entry.object.visible = false;
          }
          // For each non-empty section, dispatch a figure to walk
          // in, wait for arrival, then reveal that section
          const figures = (typeof window !== 'undefined' && window.__mfgBuildTeamFigures) || [];
          let section = 0;
          for (const group of partGroups) {
            const matches = [];
            for (const [name, entry] of partsRegistry.entries()) {
              if (entry && entry.object && group.match.test(name)) matches.push(entry);
            }
            if (matches.length === 0) continue;
            // Update the status line to show what's being delivered
            if (status) {
              const member = team[section % team.length];
              status.textContent = `${member.name} (${member.role}) · ${group.label.toLowerCase()}…`;
            }
            // Dispatch a figure
            if (figures.length > 0) {
              const fig = figures[section % figures.length];
              section++;
              if (fig && fig.userData && fig.userData.buildTask) {
                const t = fig.userData.buildTask;
                // Reset to home so each delivery has a full walk-in
                fig.position.x = t.homeX;
                fig.position.z = t.homeZ;
                fig.visible = true;
                const angle = (section * 1.7) % (Math.PI * 2);
                const radius = 1.4 + (section % 3) * 0.3;
                t.targetX = Math.cos(angle) * radius;
                t.targetZ = Math.sin(angle) * radius;
                t.state = 'walking_in';
                if (fig.userData.carriedPart) {
                  fig.userData.carriedPart.visible = true;
                }
                // Wait for the figure to ARRIVE before revealing parts
                await new Promise((resolve) => {
                  t.arrivalResolver = resolve;
                  // Safety timeout — never deadlock if figure stuck
                  setTimeout(() => {
                    if (t.arrivalResolver === resolve) {
                      t.arrivalResolver = null;
                      resolve();
                    }
                  }, 5000);
                });
                // Hide the carried placeholder — the part was just
                // "handed off" to the aircraft. The figure's drilling
                // animation continues in the tick loop.
                if (fig.userData.carriedPart) {
                  fig.userData.carriedPart.visible = false;
                }
                // Drilling pause — the part appears DURING the drill
                // motion, not before. User: "screwing in parts,
                // drilling, not parts just appearing in air."
                await new Promise(r => setTimeout(r, 700));
              }
            } else {
              // No figures available — pace with a small delay
              await new Promise(r => setTimeout(r, 800));
              section++;
            }
            // REVEAL the parts in this section
            for (const entry of matches) entry.object.visible = true;
            // Brief pause so the user actually sees the new piece
            // appear before the next figure starts walking
            await new Promise(r => setTimeout(r, 350));
          }
          // ----- TEST FLIGHT -----
          // After all sections revealed, the AI team takes the
          // finished aircraft on a real test flight. User: "flight
          // test characteristic involves spinning the motors too and
          // flying it." Sequence:
          //   1. Spool rotors up (rotors spin throughout the flight)
          //   2. Hover up 1.5u
          //   3. Yaw 360° at altitude (showing all sides)
          //   4. Forward sweep ~2u and back (real flight motion)
          //   5. Descend back to ground
          //   6. Spool rotors down
          if (status) {
            status.textContent = `✓ build complete · running test flight…`;
          }
          try {
            const taxiGroup = (typeof taxi !== 'undefined') ? taxi : null;
            if (taxiGroup && taxiGroup.position) {
              // Collect every rotor in the registry so we can spin them
              const flightRotors = [];
              for (const [, entry] of partsRegistry.entries()) {
                if (entry && entry.kind === 'rotor' && entry.object) {
                  flightRotors.push(entry.object);
                }
              }
              const baseY = taxiGroup.position.y;
              const baseX = taxiGroup.position.x;
              const baseRotY = taxiGroup.rotation.y;
              // Rotor spin velocity ramp helper
              let rotorRPM = 0;     // rad/s, ramps up to 30 then down
              const stepRotors = (dt) => {
                for (const r of flightRotors) {
                  // rotateY() rotates around the rotor's LOCAL Y axis,
                  // which is the spin axis for both vertical lift
                  // rotors AND tilted pusher/tractor props. Using
                  // rotation.y += would tumble tilted props instead
                  // of spinning them.
                  r.rotateY(rotorRPM * dt);
                }
              };
              // 1. Spool up rotors over 0.6s while still on ground
              const spoolFrames = 36;     // 0.6s
              for (let f = 1; f <= spoolFrames; f++) {
                rotorRPM = 30 * (f / spoolFrames);
                stepRotors(0.016);
                await new Promise(r => setTimeout(r, 16));
              }
              // 2. Hover up 1.5u (1s)
              const hoverFrames = 60;
              for (let f = 1; f <= hoverFrames; f++) {
                taxiGroup.position.y = baseY + 1.5 * (f / hoverFrames);
                stepRotors(0.016);
                await new Promise(r => setTimeout(r, 16));
              }
              // 3. Yaw 360° while at altitude (2s)
              const yawFrames = 120;
              for (let f = 1; f <= yawFrames; f++) {
                taxiGroup.rotation.y = baseRotY + (Math.PI * 2) * (f / yawFrames);
                taxiGroup.position.y = baseY + 1.5 + Math.sin(f * 0.18) * 0.05;
                stepRotors(0.016);
                await new Promise(r => setTimeout(r, 16));
              }
              taxiGroup.rotation.y = baseRotY;     // exact reset
              // 4. Forward sweep: pitch slightly, translate +X 2u and back (2s)
              const sweepHalf = 60;     // 1s each direction
              for (let f = 1; f <= sweepHalf; f++) {
                const t = f / sweepHalf;
                taxiGroup.position.x = baseX + 2.0 * t;
                taxiGroup.rotation.z = -0.10 * t;     // nose-down forward
                stepRotors(0.016);
                await new Promise(r => setTimeout(r, 16));
              }
              for (let f = 1; f <= sweepHalf; f++) {
                const t = f / sweepHalf;
                taxiGroup.position.x = baseX + 2.0 * (1 - t);
                taxiGroup.rotation.z = -0.10 * (1 - t);
                stepRotors(0.016);
                await new Promise(r => setTimeout(r, 16));
              }
              taxiGroup.rotation.z = 0;
              // 5. Descend (1s)
              for (let f = 1; f <= hoverFrames; f++) {
                taxiGroup.position.y = baseY + 1.5 * (1 - f / hoverFrames);
                stepRotors(0.016);
                await new Promise(r => setTimeout(r, 16));
              }
              taxiGroup.position.y = baseY;
              taxiGroup.position.x = baseX;
              // 6. Spool down rotors (0.6s)
              for (let f = spoolFrames; f >= 0; f--) {
                rotorRPM = 30 * (f / spoolFrames);
                stepRotors(0.016);
                await new Promise(r => setTimeout(r, 16));
              }
            }
          } catch (e) { console.warn('[AI team] test flight failed:', e); }
        } catch (err) {
          buildOk = false;
          console.error('[AI team] build failed:', err);
          stopNarration();
          // Make sure no parts are left hidden if we errored
