          // gets a distinct spot so they don't pile on top of each
          // other; together they form a reception arc.
          const STATIONS = [
            { role: 'GROUND',   x:  1.7, z:  1.7, label: 'Receiving' },
            { role: 'MAINT',    x: -1.7, z:  1.7, label: 'Standby maint' },
            { role: 'DISPATCH', x:  0.0, z:  2.6, label: 'Coordinating dock' },
          ];
