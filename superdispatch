        }
      };

      // Autonomous maintenance patrol — mechanic walks between random
      // aircraft, inspects each for ~2-3s, then moves to the next. This
      // runs continuously so the mechanic is never idle for long even
      // when no dispatches/completions are firing. Different cadence
      // than the chat sim so the worker activity doesn't sync up.
      let padCrewMaintInterval = null;
      // Filter helpers — patrols use these to avoid walking to aircraft
      // that are currently in the air (the apron position is empty
      // there, so the worker would walk to nothing).
      function getParkedDesignIds() {
        const designs = (typeof getAllSavedDesigns === 'function') ? getAllSavedDesigns() : [];
        const inFlight = new Set();
        if (typeof padFlightStates !== 'undefined' && Array.isArray(padFlightStates)) {
