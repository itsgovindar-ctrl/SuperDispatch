            spec.rotorPlacement = 'halo';
            spec.wingPresent = false;
            spec.fwdRotors = totalRotors || 18;
            spec.rearRotors = 0;
            spec.fwdBlades = 2;
            spec.tail = 'none';
            spec.gear = 'skid';
            spec.fuselageLen = 3.5;
          } else if (isEhang) {
            spec.rotorPlacement = 'arms';
            spec.wingPresent = false;
            spec.fwdRotors = totalRotors || 8;
            spec.rearRotors = 0;
            spec.fwdBlades = 2;
            spec.tail = 'none';
            spec.gear = 'skid';
            spec.fuselageLen = 3.0;
          } else if (isRail) {
            // Twin-boom rotor rail / skycrane: 6-8 rotors mounted on
            // parallel longitudinal booms. RAFT profile — flat, wide
            // body, not a tall capsule. User showed a screenshot of
            // this exact layout.
            spec.rotorPlacement = 'rail';
            spec.wingPresent = false;
            spec.fwdRotors = totalRotors || 8;
            spec.rearRotors = 0;
            spec.fwdBlades = 2;
            spec.tail = 'none';
            spec.gear = 'skid';
            spec.fuselageLen = 4.5;       // longer cargo-hauler hull
            spec.fuselageRadius = 0.55;
            spec.fuselageFlat = 0.55;     // RAFT — squashed vertically (0.85 default = capsule)
          } else if (isPushPull) {
            // Cessna Skymaster style — tractor on nose + pusher on tail.
            // Most specific fixed-wing keyword: "push-pull" or "skymaster"
            spec.rotorPlacement = 'push_pull';
            spec.fwdRotors = 1; spec.rearRotors = 1;
            spec.fwdBlades = 3;
            spec.tail = 'conv';
            spec.wingSpan = 11.0;
            spec.wingPresent = true;
            spec.gear = 'tricycle';
            spec.wingChord = 1.4;
          } else if (isTurboprop) {
            // Twin-engine turboprop — 2 props on wing (King Air /
            // Beechcraft / Cessna Caravan style). Catches "turboprop"
            // before the broader "tractor" keyword.
            spec.rotorPlacement = 'wing_tractor';
            spec.fwdRotors = 2; spec.rearRotors = 0;
            spec.fwdBlades = 4;
            spec.tail = 't';     // T-tail typical for turboprops
            spec.wingSpan = 13.0;
            spec.wingPresent = true;
            spec.gear = 'tricycle';
            spec.wingChord = 1.4;
          } else if (isPusher) {
            // Fixed-wing aircraft with PUSHER prop(s) at the rear.
            // User: "make the taxi's fixed wing capable with
            // different kind of motors like push motors."
            spec.rotorPlacement = 'pusher';
            spec.wingPresent = true;
            spec.fwdRotors = totalRotors || 1;     // 1 = rear pusher; 2 = wing-mounted twins
            spec.rearRotors = 0;
            spec.fwdBlades = 3;                    // 3-blade prop, classic
            spec.tail = 'conv';
            spec.gear = 'tricycle';
            spec.wingSpan = 10.0;
            spec.wingChord = 1.4;
          } else if (isTractor) {
            // Fixed-wing aircraft with TRACTOR prop on the nose
            // (front-mounted, pulls air forward — Cessna/turboprop style)
            spec.rotorPlacement = 'tractor';
            spec.wingPresent = true;
            spec.fwdRotors = 1;     // tractor is single nose prop
            spec.rearRotors = 0;
            spec.fwdBlades = 3;
            spec.tail = 'conv';
            spec.gear = 'tricycle';
            spec.wingSpan = 10.5;
            spec.wingChord = 1.5;
          } else if (isStol) {
            spec.rotorPlacement = 'wing';   // single forward prop on wing
            spec.fwdRotors = 1; spec.rearRotors = 0;
            spec.fwdBlades = 3;
            spec.tail = 'conv';
            spec.wingSpan = 11.0;
          } else if (isCopterSuffix) {
            // "X-copter" suffix (hexacopter, octocopter, etc) ALWAYS means a drone-style
            // multi-rotor: arms radiating from a central pod, no wing, no tail.
            // This is the standard interpretation in the drone/UAV community.
            spec.rotorPlacement = 'arms';
            spec.wingPresent = false;
            spec.fwdRotors = totalRotors;
            spec.rearRotors = 0;
            spec.fwdBlades = 2;
            spec.tail = 'none';
            spec.gear = 'skid';
            spec.fuselageLen = 2.4 + paxCount * 0.45;
            spec.fuselageRadius = 0.55;
          } else if (totalRotors) {
            // Generic "N rotors" without -copter suffix: count drives placement
            if (totalRotors >= 10) {
              spec.rotorPlacement = 'wing';
              const half = Math.floor(totalRotors / 2);
              spec.fwdRotors = half; spec.rearRotors = totalRotors - half;
              spec.fwdBlades = 5; spec.rearBlades = 2;
              spec.tail = 'v';
            } else if (totalRotors <= 4) {
              spec.rotorPlacement = 'arms';
              spec.wingPresent = false;
              spec.fwdRotors = totalRotors;
              spec.rearRotors = 0;
              spec.fwdBlades = 2;
              spec.tail = 'none';
              spec.gear = 'skid';
              spec.fuselageLen = 3.0 + paxCount * 0.4;
            } else {
              // 5-9 rotors without -copter: distributed on wing (Archer-ish)
              spec.rotorPlacement = 'wing';
              const half = Math.floor(totalRotors / 2);
              spec.fwdRotors = half; spec.rearRotors = totalRotors - half;
              spec.fwdBlades = 3; spec.rearBlades = 2;
              spec.tail = 'v';
            }
          }
          // Style overrides
          if (/\bno wing|wingless\b/.test(lower)) spec.wingPresent = false;
          if (/\bno tail|tailless\b/.test(lower)) spec.tail = 'none';
          if (/\bskids?\b/.test(lower)) spec.gear = 'skid';
          if (/\btricycle gear|tricycle landing|wheels?\b/.test(lower)) spec.gear = 'tricycle';
          if (/\bt.?tail\b/.test(lower)) spec.tail = 't';
          if (/\bv.?tail\b/.test(lower)) spec.tail = 'v';
          if (/\bconventional tail\b/.test(lower)) spec.tail = 'conv';
          if (/\bbubble canopy\b/.test(lower)) spec.canopy = 'bubble';
          if (/\bno canopy\b/.test(lower)) spec.canopy = 'none';
          // Scale fuselage to pax
          if (paxCount >= 5) spec.fuselageLen = Math.max(spec.fuselageLen || 5.6, 6.2);
          if (paxCount >= 6) spec.fuselageLen = Math.max(spec.fuselageLen || 5.6, 6.8);

          commands.push({ label: 'Build aircraft from spec (coordinated geometry)', cmd: '__build_evtol__', __opts: spec });

          // Color
          if (/\byellow\b/.test(lower))      commands.push({ label: 'Apply yellow paint', cmd: 'paint it #FFD200' });
          else if (/\bred\b/.test(lower))    commands.push({ label: 'Apply red paint', cmd: 'paint it #D02020' });
          else if (/\bblue\b/.test(lower))   commands.push({ label: 'Apply blue paint', cmd: 'paint it #1E40AF' });
          else if (/\bblack\b/.test(lower))  commands.push({ label: 'Apply black paint', cmd: 'paint it #1A1A1A' });
          else if (/\bwhite\b/.test(lower))  commands.push({ label: 'Apply white paint', cmd: 'paint it #F0F4FF' });
          else if (/\bgreen\b/.test(lower))  commands.push({ label: 'Apply green paint', cmd: 'paint it #2E7D32' });
          else if (/\borange\b/.test(lower)) commands.push({ label: 'Apply orange paint', cmd: 'paint it #F97316' });
          else if (/\bpurple\b/.test(lower))commands.push({ label: 'Apply purple paint', cmd: 'paint it #7C3AED' });
          else if (/\bsilver\b/.test(lower))commands.push({ label: 'Apply silver paint', cmd: 'paint it #C0C0C8' });
          // Transparency
          if (/\bsee.?through|see-?thru|transparent body|transparent fuselage|glass body|crystal body|plexi(?:glass)?\b/.test(lower)) {
            commands.push({ label: 'Apply transparent body finish', cmd: '__transparent__' });
          }
          // Callsign / tail number
          const callsignMatch = lower.match(/(?:callsign|tail.?(?:number)?|registration)\s*[:\s]*([a-z0-9-]+)/i);
          if (callsignMatch) {
            commands.push({ label: `Set callsign ${callsignMatch[1].toUpperCase()}`, cmd: `__set_callsign__${callsignMatch[1].toUpperCase()}` });
          }
          commands.__archetype = isArcher ? 'archer' : isJoby ? 'joby' : isVolo ? 'volo' : isEhang ? 'ehang' : isStol ? 'stol' : 'generic';
          commands.__paxCount = paxCount;
          return commands;
        }

        // ===== ARCHETYPE DETECTION (legacy part-by-part path for raw CAD commands) =====
        const archKey = detectArchetype(lower);
        const arch = { ...ARCHETYPE_LIBRARY[archKey] };

        // Allow free-form overrides on top of the archetype defaults
        if (/\bteardrop\b/.test(lower)) arch.fuselageShape = 'teardrop';
        else if (/\bwedge|delta\b/.test(lower)) arch.fuselageShape = 'wedge';
        else if (/\bcuboid|boxy|rectangular|box-shaped\b/.test(lower)) arch.fuselageShape = 'cuboid';
        else if (/\bcylinder|tube-shaped\b/.test(lower)) arch.fuselageShape = 'cylinder';
        else if (/\bsphere|spherical|pod\b/.test(lower)) arch.fuselageShape = 'sphere';
        else if (/\bellipsoid|oval|egg-shaped\b/.test(lower)) arch.fuselageShape = 'ellipsoid';
        else if (/\bcapsule\b/.test(lower)) arch.fuselageShape = 'capsule';

        // Passenger count is the strongest dimension hint — sized to fit them
        const paxMatch = lower.match(/(\d+)[-\s]*(?:passenger|pax|seater?)/);
        const paxCount = paxMatch ? parseInt(paxMatch[1]) : null;

        // Apply size hints to dims, but always keep them realistic
        let { L, H, W } = arch.fuselageDims;
        if (paxCount) {
          // Each row of seats needs ~0.95m of cabin length; assume 2 seats per row
          const rows = Math.ceil(paxCount / 2);
          L = Math.max(L, 1.6 + rows * 0.95);   // 1.6m for cockpit + rows for seats
          W = Math.max(W, 1.50);                // need at least 1.5m wide for two seats abreast
          H = Math.max(H, 1.30);                // need at least 1.3m for headroom
        }
        if (/\bsmall|tiny|compact\b/.test(lower))            { L *= 0.85; W *= 0.92; H *= 0.92; }
        if (/\blong|elongated|stretched\b/.test(lower))      { L *= 1.18; }
        if (/\bshort|stubby\b/.test(lower))                  { L *= 0.85; }
        if (/\bwide|broad\b/.test(lower))                    { W *= 1.18; }
        if (/\bnarrow|slim\b/.test(lower))                   { W *= 0.85; }
        if (/\btall|deep\b/.test(lower))                     { H *= 1.15; }

        // Convert from real-world meters to scene units (the scene uses ~1 unit = 1m, but
        // existing builders expect smaller dimensions — so divide by ~2.5 for legibility)
        const scale = 0.45;
        const sL = L * scale, sH = H * scale, sW = W * scale;
        commands.push({
          label: `Build ${arch.fuselageShape} fuselage (${L.toFixed(1)}m × ${W.toFixed(1)}m × ${H.toFixed(1)}m)`,
          cmd:   `add ${arch.fuselageShape} fuselage ${sL.toFixed(2)}x${sH.toFixed(2)}x${sW.toFixed(2)}`
        });

        // ===== CANOPY / NOSE =====
        if (arch.canopy && !/\bno canopy|no cockpit\b/.test(lower)) {
          if (/\bbubble|panoramic|glass dome\b/.test(lower) || archKey === 'joby' || archKey === 'volo') {
            commands.push({ label: 'Add panoramic canopy', cmd: 'add canopy' });
          } else {
            commands.push({ label: 'Add cockpit', cmd: 'add cockpit' });
          }
        }
        if (/\bnose\b/.test(lower) && !/\bno nose\b/.test(lower)) {
          commands.push({ label: 'Add nose cone', cmd: 'add nose' });
        }

        // ===== ROTOR LAYOUT (the most important geometry decision) =====
        // Named rotor configs: bi/tri/quad/hex/oct copter → 2/3/4/6/8 rotors
        const NAMED_ROTOR_COUNTS = {
          'bicopter': 2, 'bi-copter': 2,
          'tricopter': 3, 'tri-copter': 3, 'tri copter': 3,
          'quadcopter': 4, 'quad-copter': 4, 'quadrotor': 4,
          'pentacopter': 5,
          'hexacopter': 6, 'hex-copter': 6, 'hexarotor': 6,
          'septacopter': 7, 'septcopter': 7,
          'octocopter': 8, 'oct-copter': 8, 'octacopter': 8, 'octorotor': 8,
          'decacopter': 10
        };
        let namedCount = null;
        for (const [name, n] of Object.entries(NAMED_ROTOR_COUNTS)) {
          if (lower.includes(name)) { namedCount = n; break; }
        }
        if (namedCount !== null) arch.rotors.count = namedCount;
        // Override rotor count if explicitly specified in description
        const rotorCountMatch = lower.match(/(\d+)\s*(?:rotors?|propellers?|motors?|fans?|thrusters?|ducts?)/);
        if (rotorCountMatch) arch.rotors.count = parseInt(rotorCountMatch[1]);
        const perBoomMatch = lower.match(/(\d+)\s*per\s*boom/);
        if (perBoomMatch) arch.rotors.count = parseInt(perBoomMatch[1]) * 2;

        // Layout-specific build sequence
        const r = arch.rotors;
        switch (r.layout) {
          case 'wing_tips':                   // Joby: rotors on wing tips (no booms — wings serve as the spar)
            commands.push({ label: 'Build wing structure', cmd: 'add wings' });
            commands.push({ label: `Mount ${r.count} rotors on wing tips`, cmd: `add ${r.count} rotors on wing tips` });
            break;
          case 'wing_high_density':           // Archer: many rotors mounted along the wing
          case 'wing_embedded':               // Lilium: rotors embedded inside the wing
            commands.push({ label: 'Build wing structure', cmd: 'add wings' });
            commands.push({ label: `Mount ${r.count} rotors along wings`, cmd: `add ${r.count} rotors on wing tips` });
            break;
          case 'twin_booms':                  // Standard: 2 longitudinal booms, rotors at tips
          case 'paired_pylons':               // Bell-style: paired rotors on pylons above wings
            commands.push({ label: 'Add twin booms above fuselage', cmd: 'add 2 booms above fuselage' });
            commands.push({ label: `Mount ${r.count} rotors on boom tips`, cmd: `add ${r.count} rotors on boom tips` });
            break;
          case 'x_frame_arms':                // EHang: X-shaped arm frame, rotors at corners
            // Arm count matches rotor count — tricopter gets 3 arms + 3 rotors, etc.
            commands.push({ label: `Add ${r.count} X-frame arms`, cmd: `add ${r.count} arms on corners` });
            commands.push({ label: `Mount ${r.count} rotors on arm tips`, cmd: `add ${r.count} rotors on arm tips` });
            break;
          case 'halo_ring':                   // Volocopter: rotors on a circular halo above the body
            commands.push({ label: `Mount ${r.count} rotors in halo ring`, cmd: `add ${r.count} rotors` });
            break;
          case 'embedded_concealed':          // Stealth: rotors hidden inside body
          default:
            commands.push({ label: `Mount ${r.count} rotors`, cmd: `add ${r.count} rotors` });
        }

        // ===== TAIL (after rotors so it can attach to the rear) =====
        if (arch.tail && !/\bno tail|tailless\b/.test(lower)) {
          // Allow override
          let tailType = arch.tail;
          if (/\bt-?tail\b/.test(lower)) tailType = 'T';
          else if (/\bv-?tail|butterfly tail\b/.test(lower)) tailType = 'V';
          else if (/\bh-?tail\b/.test(lower)) tailType = 'H';
          else if (/\bdelta tail\b/.test(lower)) tailType = 'delta';
          else if (/\bconventional tail|standard tail|regular tail\b/.test(lower)) tailType = 'conventional';
          commands.push({ label: `Add ${tailType}-tail`, cmd: `add ${tailType}-tail` });
        }

        // ===== EXTRA WINGS if not already added by rotor layout =====
        const alreadyHaveWings = ['wing_tips', 'wing_high_density', 'wing_embedded'].includes(r.layout);
        if (!alreadyHaveWings && (arch.wings || /\bfixed wings?|airfoils?\b/.test(lower))) {
          commands.push({ label: 'Add fixed wings', cmd: 'add wings' });
        }

        // ===== LANDING GEAR =====
        let gear = arch.gear;
        if (/\btricycle gear|tricycle landing\b/.test(lower)) gear = 'tricycle';
        else if (/\bskids?\b/.test(lower)) gear = 'skids';
        else if (/\bno (?:landing )?gear|gearless\b/.test(lower)) gear = null;
        if (gear === 'tricycle') commands.push({ label: 'Add tricycle gear', cmd: 'add tricycle gear' });
        else if (gear === 'skids') commands.push({ label: 'Add skids', cmd: 'add skids' });

        // ===== INTERIOR =====
        // Only add seats if the fuselage is large enough to hide them inside (W >= 1.4m, H >= 1.2m)
        const fuselageBigEnough = W >= 1.4 && H >= 1.2;
        if (paxCount && paxCount > 0 && paxCount <= 8 && fuselageBigEnough) {
          let seatType = 'captain seat';
          if (/\bbench seats?\b|\brow seats?\b/.test(lower)) seatType = 'bench seat';
          else if (/\bbucket seats?\b|\bsport seats?\b|\bracing seats?\b/.test(lower)) seatType = 'bucket seat';
          // Note: seats are placed at fuselage center; they'll be visible through the canopy from the front
          commands.push({
            label: `Place ${paxCount} ${seatType}${paxCount > 1 ? 's' : ''} (interior)`,
            cmd: `add ${paxCount} ${seatType}${paxCount > 1 ? 's' : ''}`
          });
        } else if (paxCount && !fuselageBigEnough) {
          // Skip seat placement — would protrude through the body
          commands.push({ label: `Skip interior — fuselage too small for ${paxCount} seats`, cmd: '__noop__' });
        }

        if (/\binstrument panel|dashboard|console|glass cockpit\b/.test(lower) && fuselageBigEnough) {
          commands.push({ label: 'Add instrument panel', cmd: 'add instrument panel' });
        }
        if (/\b(?:control )?yoke|control stick|joystick\b/.test(lower) && fuselageBigEnough) {
          commands.push({ label: 'Add control yoke', cmd: 'add control yoke' });
        }

        // ===== CARGO / SYSTEMS (placed inside fuselage if it's large enough) =====
        const cargoMatch = lower.match(/(\d+)\s+cargo\s+(?:crates?|boxes?)/);
        if (cargoMatch && fuselageBigEnough) {
          commands.push({ label: `Place ${cargoMatch[1]} cargo crates`, cmd: `add ${cargoMatch[1]} cargo crates` });
        } else if (/\bcargo|crate\b/.test(lower) && fuselageBigEnough) {
          commands.push({ label: 'Add cargo crate', cmd: 'add cargo crate' });
        }
        // Battery/fuel/avionics — these are SYSTEM parts, fine to place even on small craft (they tuck under)
        if (/\bbattery|power pack|cell pack\b/.test(lower)) {
          commands.push({ label: 'Install battery', cmd: 'add battery pack' });
        }
        if (/\bfuel tank\b/.test(lower)) {
          commands.push({ label: 'Install fuel tank', cmd: 'add fuel tank' });
        }
        if (/\bavionics rack\b/.test(lower)) {
          commands.push({ label: 'Install avionics rack', cmd: 'add avionics rack' });
        }

        // ===== FEATURES — doors, windows, antenna =====
        if (/\bcargo doors?\b|\bdoors? on both sides\b/.test(lower)) {
          commands.push({ label: 'Add left door',  cmd: 'add a door on the left' });
          commands.push({ label: 'Add right door', cmd: 'add a door on the right' });
        } else if (/\bside doors?\b|\bdoors?\b/.test(lower) && !/\bno doors?\b/.test(lower)) {
          if (/\bright (?:side )?doors?\b/.test(lower)) commands.push({ label: 'Add right door', cmd: 'add a door on the right' });
          else commands.push({ label: 'Add door', cmd: 'add a door on the left' });
        }
        if (/\bwindows?|portholes?\b/.test(lower) && !/\bno windows?\b/.test(lower)) {
          if (/\bwindows? on both sides\b/.test(lower)) {
            commands.push({ label: 'Add left windows', cmd: 'add windows on the left' });
            commands.push({ label: 'Add right windows', cmd: 'add windows on the right' });
          } else {
            commands.push({ label: 'Add windows', cmd: /\bright\b/.test(lower) ? 'add windows on the right' : 'add windows on the left' });
          }
        }
        if (/\bantennas?|aerials?\b/.test(lower)) {
          commands.push({ label: 'Add antenna', cmd: 'add an antenna' });
        }

        // ===== APPLIED FEATURES =====
        const filletMatch = lower.match(/fillet[a-z\s]*?(\d+)\s*mm/);
        const filletAmount = filletMatch ? parseInt(filletMatch[1]) :
                             (/\bsleek|smooth lines|aerodynamic\b/.test(lower) && !/\bsharp|angular|boxy\b/.test(lower)) ? arch.fillet : 0;
        if (filletAmount > 0) {
          commands.push({ label: `Fillet edges (${filletAmount}mm)`, cmd: `fillet the fuselage ${filletAmount}mm` });
        }
        const chamferMatch = lower.match(/chamfer[a-z\s]*?(\d+)\s*mm/);
        if (chamferMatch) {
          commands.push({ label: `Chamfer ${chamferMatch[1]}mm`, cmd: `chamfer the fuselage ${chamferMatch[1]}mm` });
        }
        const shellMatch = lower.match(/shell[a-z\s]*?(\d+)\s*mm/);
        if (shellMatch) {
          commands.push({ label: `Shell ${shellMatch[1]}mm`, cmd: `shell the fuselage ${shellMatch[1]}mm` });
        }

        // ===== LIVERY =====
        const liveryMatch = lower.match(/([\w\s]+?)\s+(?:airframe|paint|fuselage|body)?\s*(?:with|and)\s+([\w\s]+?)\s+(?:trim|accents?|highlights?)/);
        let primaryColor = null, trimColor = null;
        if (liveryMatch) {
          primaryColor = colorFromPhrase(liveryMatch[1]);
          trimColor    = colorFromPhrase(liveryMatch[2]);
        } else {
          const simpleMatch = lower.match(/([\w\s]+?)\s+(?:airframe|paint|fuselage|body)/);
          if (simpleMatch) primaryColor = colorFromPhrase(simpleMatch[1]);
          else primaryColor = colorFromPhrase(lower);
        }
        // Fall back to archetype defaults if no color in description
        if (!primaryColor) primaryColor = arch.color;
        if (!trimColor)    trimColor    = arch.trimColor;
        if (primaryColor) commands.push({ label: `Paint primary ${primaryColor}`, cmd: `paint it ${primaryColor}` });
        if (trimColor)    commands.push({ label: `Paint trim ${trimColor}`,       cmd: `make trim ${trimColor}` });

        // ===== FINAL PASSES =====
        commands.push({ label: 'Apply symmetry', cmd: '__symmetry__' });
        // Auto-balance: if user explicitly asked for fewer than 4 rotors (tricopter, bicopter,
        // or "3 rotors"), respect that. Otherwise pad to 4 for flight cert.
        const userSpecifiedFewRotors = (namedCount !== null && namedCount < 4)
          || (rotorCountMatch && parseInt(rotorCountMatch[1]) < 4);
        commands.push({
          label: 'Auto-balance for flight certification',
          cmd: userSpecifiedFewRotors ? '__autobalance_skip_rotors__' : '__autobalance__'
        });
        // See-through / transparent body
        if (/\bsee.?through|see-?thru|transparent body|transparent fuselage|glass body|crystal body|plexi(?:glass)?\b/.test(lower)) {
          commands.push({ label: 'Apply transparent body finish', cmd: '__transparent__' });
        }

        // Tag the plan with its detected archetype for chat feedback
        commands.__archetype = archKey;
        commands.__paxCount = paxCount;
        return commands;
        }   // close `} else {` opened above the spec-driven fast-path
      }

      // Run the interpreted commands one at a time, with progress UI
      async function executeBuildPlan(plan, originalDescription) {
        // Progress UI is OPTIONAL — the IDs `ai-build-progress`,
        // `build-progress-current`, etc. are wired in CSS but not
        // currently in the DOM. Without these guards, executeBuildPlan
        // crashes on `progressEl.hidden = false` the moment it's called.
        // The AI manufacturing team button hit this in production —
        // user reported "Cannot set properties of null (setting
        // 'hidden')". The describe+generate UI also relied on these
        // (probably also broken) but nobody was triggering it.
        const progressEl = document.getElementById('ai-build-progress');
        const labelEl    = document.getElementById('build-progress-current');
        const countEl    = document.getElementById('build-progress-count');
        const fillEl     = document.getElementById('build-progress-fill');
        if (progressEl) progressEl.hidden = false;
        // Single undo snapshot so the entire build can be rolled back as one operation
        if (typeof pushUndo === 'function') pushUndo();

        // Echo the description as a user message + announce the detected archetype
        const hist = document.getElementById('ai-history');
        if (hist) {
          const archName = plan.__archetype || 'default';
          const archLabels = {
            joby: 'JOBY-style (wing-tip tilting rotors)',
            bell: 'BELL NEXUS-style (paired ducted fans on pylons)',
            lilium: 'LILIUM-style (wing-embedded ducts)',
            ehang: 'EHANG-style (X-frame octocopter)',
            archer: 'ARCHER-style (high-density wing rotors)',
            wisk: 'WISK AERO Gen 6 (autonomous, 12 fixed lift rotors, skids)',
            volo: 'VOLOCOPTER-style (rotor halo)',
            stealth: 'STEALTH-style (concealed lift fans)',
            default: 'STANDARD eVTOL (twin-boom hexacopter)'
          };
          const div = document.createElement('div');
          div.className = 'chat-msg user';
          div.innerHTML = `<div class="chat-result"><span style="color:#ffb03c">◆</span> describe → generate · <span style="opacity:0.85">${escapeHtml(originalDescription)}</span></div>`;
          hist.appendChild(div);
          const archDiv = document.createElement('div');
          archDiv.className = 'chat-msg ai info';
          archDiv.innerHTML = `<div class="chat-result"><span class="check">▸</span>archetype: <span class="val">${archLabels[archName]}</span> · ${plan.__paxCount ? plan.__paxCount + ' passengers · ' : ''}${plan.length} build steps</div>`;
          hist.appendChild(archDiv);
        }

        let success = 0, failed = 0;
        for (let i = 0; i < plan.length; i++) {
          const step = plan[i];
          if (labelEl) labelEl.textContent = step.label;
          if (countEl) countEl.textContent = `${i + 1} / ${plan.length}`;
          if (fillEl)  fillEl.style.width = `${((i + 1) / plan.length) * 100}%`;
          // Step event — external choreography (e.g., AI team build
          // figures walking in to place each part) hooks here. The
          // hook may return a Promise that resolves when a figure
          // ARRIVES at the build site — we await that so the part
          // appears in sync with the figure putting it down. User:
          // "people need to come as real animations and bring in
          // parts to assemble the aircraft."
          try {
            if (typeof window.__onBuildStep === 'function') {
              const result = window.__onBuildStep(i, plan.length);
              if (result && typeof result.then === 'function') {
                await result;
              }
            }
          } catch (_) {}

          // No-op pseudo-command (used to display informational labels in the progress bar)
          if (step.cmd === '__noop__') {
            await new Promise(r => setTimeout(r, 120));
            continue;
          }

          // Special pseudo-command: monolithic eVTOL builder (any spec)
          if (step.cmd === '__build_evtol__' || step.cmd === '__build_archer__') {
            try {
              buildEVTOL(step.__opts || {});
              success++;
            } catch (e) {
              console.error('eVTOL build failed:', e);
              failed++;
            }
            await new Promise(r => setTimeout(r, 320));
            continue;
          }

          // Special pseudo-command: set tail number / callsign
          if (step.cmd && step.cmd.startsWith('__set_callsign__')) {
            try {
              const callsign = step.cmd.replace('__set_callsign__', '');
              const tailInput = document.getElementById('tail-number');
              if (tailInput) tailInput.value = callsign;
              success++;
            } catch (e) { failed++; }
            await new Promise(r => setTimeout(r, 100));
            continue;
          }

          // Special pseudo-command: symmetry pass
          if (step.cmd === '__symmetry__') {
            try { applySymmetry(); success++; } catch (e) { failed++; }
            await new Promise(r => setTimeout(r, 180));
            continue;
          }

          // Special pseudo-command: auto-balance pass (post-generation flight cert)
          if (step.cmd === '__autobalance__') {
            try { applyAutoBalance(); success++; } catch (e) { failed++; }
            await new Promise(r => setTimeout(r, 220));
            continue;
          }
          // Auto-balance variant that respects user's explicit small rotor count
          // (e.g. tricopter — don't pad up to 4)
          if (step.cmd === '__autobalance_skip_rotors__') {
            try { applyAutoBalance({ skipRotorPadding: true }); success++; } catch (e) { failed++; }
            await new Promise(r => setTimeout(r, 220));
            continue;
          }

          // Special pseudo-command: make body transparent (see-through)
          if (step.cmd === '__transparent__') {
            try {
              materials.primary.transparent = true;
              materials.primary.opacity = 0.35;
              materials.primary.depthWrite = false;   // avoid sort artifacts
              materials.primary.needsUpdate = true;
              success++;
            } catch (e) { failed++; }
            await new Promise(r => setTimeout(r, 120));
            continue;
          }

          // Otherwise run as a normal AI command
          try {
            const cmd = parseCommand(step.cmd);
            const out = await executeCommand(cmd);
            if (out?.error) failed++;
            else success++;
          } catch (e) {
            failed++;
          }
          // Animate one step at a time so the user sees the build happen progressively
          await new Promise(r => setTimeout(r, 220));
        }

        // Final summary
        if (labelEl) labelEl.textContent = 'Complete';
        const summaryDiv = document.createElement('div');
        summaryDiv.className = 'chat-msg ai success';
        summaryDiv.innerHTML = `<div class="chat-parsed"><span class="pkey">action:</span> <span class="pval">GENERATE_AIRCRAFT</span> &nbsp; <span class="pkey">steps:</span> <span class="pval">${plan.length}</span> &nbsp; <span class="pkey">ok:</span> <span class="pval">${success}</span>${failed ? ` &nbsp; <span class="pkey">failed:</span> <span class="pval">${failed}</span>` : ''}</div><div class="chat-result"><span class="check">✓</span>aircraft assembled · ${partsRegistry.size} parts in registry · drag the gizmo to fine-tune any piece</div>`;
        if (hist) {
          hist.appendChild(summaryDiv);
          hist.scrollTop = hist.scrollHeight;
        }
        // Hide progress bar after a beat
        setTimeout(() => { if (progressEl) progressEl.hidden = true; }, 1400);
      }

      async function generateFromDescription() {
        const promptEl = document.getElementById('ai-describe-prompt');
        const text = promptEl.value.trim();
        if (!text) {
          promptEl.focus();
          promptEl.placeholder = 'Please describe what you want to build…';
          return;
        }
        const btn = document.getElementById('ai-generate-btn');
        if (btn.classList.contains('analyzing')) return;

        // If there's an existing design, ask the user to confirm before clearing
        if (partsRegistry.size > 0) {
          const ok = confirm(`Clear current design (${partsRegistry.size} parts) and generate a new aircraft?\n\nOK to replace · Cancel to keep current design`);
          if (!ok) return;
          // Push undo so user can restore old design with Cmd+Z
          if (typeof pushUndo === 'function') pushUndo();
          clearVehicle();
          partsRegistry.clear();
        }

        btn.classList.add('analyzing');
        const btnText = btn.querySelector('.ai-btn-text');
        btnText.textContent = 'GENERATING…';

        const plan = interpretDescription(text);
        try {
          await executeBuildPlan(plan, text);
        } finally {
          btn.classList.remove('analyzing');
          btnText.textContent = 'GENERATE AIRCRAFT ▸';
        }
      }

      document.getElementById('ai-generate-btn')?.addEventListener('click', generateFromDescription);
      document.getElementById('ai-describe-prompt')?.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' && (e.metaKey || e.ctrlKey)) {
          e.preventDefault();
          generateFromDescription();
        }
      });
      // Template buttons — fill the textarea with canned descriptions
      document.querySelectorAll('.ai-template').forEach(btn => {
        btn.addEventListener('click', () => {
          const tpl = AIRCRAFT_TEMPLATES[btn.dataset.tpl];
          if (tpl) {
            document.getElementById('ai-describe-prompt').value = tpl;
            // Auto-trigger generation after a brief preview moment
            setTimeout(generateFromDescription, 300);
