          // almost always either walking or actively inspecting an
          // aircraft. Previously 8-14s left them idle too long.
          padCrewMaintInterval = setTimeout(tick, 4000 + Math.random() * 4000);
        };
        padCrewMaintInterval = setTimeout(tick, 2000 + Math.random() * 2000);
      }
      function stopMaintPatrol() {
        if (padCrewMaintInterval) { clearTimeout(padCrewMaintInterval); padCrewMaintInterval = null; }
      }

      // Ground crew patrol — pre-flight checks on idle aircraft so the
      // ground figure is also actively walking around between dispatch
      // events. Runs in parallel with the mechanic. Different cadence
      // and slightly different message stable so the two roles don't
      // feel like duplicates.
      let padCrewGroundPatrolInterval = null;
      function startGroundPatrol() {
        if (padCrewGroundPatrolInterval) return;
        const tick = () => {
          try {
            const target = pickRandomParkedDesignId();
            if (target && typeof window.__assignCrewWork === 'function') {
              window.__assignCrewWork('GROUND', target, 1500 + Math.random() * 1000);
              try {
                const designs = (typeof getAllSavedDesigns === 'function') ? getAllSavedDesigns() : [];
                const ac = designs.find(d => d.id === target);
                const tail = (ac && ac.tailNumber) || 'SDX-####';
                const ground = pickCrewByRole('GROUND');
                if (ground) {
                  const actions = [
                    `<span class="tail">${tail}</span> chocks set, ready for departure`,
                    `pre-flight walkaround on <span class="tail">${tail}</span>`,
                    `topping off <span class="tail">${tail}</span> coolant`,
                    `clearing FOD around <span class="tail">${tail}</span>`,
                  ];
                  postCrewMessage(ground, actions[Math.floor(Math.random() * actions.length)]);
                }
              } catch (_) {}
            } else if (typeof window.__assignCrewWanderTo === 'function') {
              // No parked aircraft — ground crew wanders to stay active
              window.__assignCrewWanderTo('GROUND');
            }
          } catch (_) {}
          // 5-10s cadence — slightly slower than maintenance so the
          // two patrols don't beat in lockstep.
          padCrewGroundPatrolInterval = setTimeout(tick, 5000 + Math.random() * 5000);
        };
        padCrewGroundPatrolInterval = setTimeout(tick, 3500 + Math.random() * 2500);
      }
      function stopGroundPatrol() {
        if (padCrewGroundPatrolInterval) { clearTimeout(padCrewGroundPatrolInterval); padCrewGroundPatrolInterval = null; }
      }

      // Idle chatter — runs on a timer, posts contextually-flavored
      // messages from random crew members. Pulls real aircraft tails
      // / pad names when available so messages feel grounded.
      function generateIdleCrewChatter() {
        const designs = (typeof getAllSavedDesigns === 'function') ? getAllSavedDesigns() : [];
        const tails = designs.map(d => d.tailNumber).filter(Boolean);
        const padNames = (REGIONS[currentRegionKey]?.pickupNames || []).slice();
        const tail = () => tails.length ? tails[Math.floor(Math.random() * tails.length)] : 'SDX-####';
        const pad = () => padNames.length ? padNames[Math.floor(Math.random() * padNames.length)] : 'HUB';
        // Each role has a stable of canned actions
        const TEMPLATES = {
          DISPATCH: [
            () => `prepping schedule for next window · ${1 + Math.floor(Math.random() * 4)} pending`,
            () => `routing optimization complete · saved ${4 + Math.floor(Math.random() * 12)} min`,
            () => `pulled <span class="tail">${tail()}</span> from standby`,
          ],
          MAINT: [
            () => `<span class="tail">${tail()}</span> battery cells nominal · ${88 + Math.floor(Math.random() * 12)}% capacity`,
            () => `rotor inspection on <span class="tail">${tail()}</span> complete`,
            () => `firmware update pushed to <span class="tail">${tail()}</span>`,
            () => `replacing <span class="tail">${tail()}</span> motor controller · 20 min ETA`,
            () => `cleared <span class="tail">${tail()}</span> for return-to-service`,
          ],
          GROUND: [
            () => `marshalling <span class="tail">${tail()}</span> to pad ${1 + Math.floor(Math.random() * 6)}`,
            () => `<span class="tail">${tail()}</span> chocked and secured`,
            () => `pre-flight walkaround on <span class="tail">${tail()}</span> done`,
            () => `de-icing rig staged at <span class="pad-name">${pad()}</span>`,
          ],
          OPS: [
            () => `daily uptime ${94 + Math.floor(Math.random() * 6)}%`,
            () => `${2 + Math.floor(Math.random() * 8)} flights queued for next hour`,
            () => `<span class="pad-name">${pad()}</span> link confirmed · all green`,
            () => `weather check · viz 10mi · winds 8kt`,
          ],
          ATC: [
            () => `<span class="tail">${tail()}</span> contact tower 124.3`,
            () => `traffic alert · two birds inbound from <span class="pad-name">${pad()}</span>`,
            () => `holding <span class="tail">${tail()}</span> at 800ft for spacing`,
            () => `pattern clear · cleared for arrival`,
          ],
        };
        const crew = pickCrewRandom();
        if (!crew) return;
        const choices = TEMPLATES[crew.role] || [];
        if (choices.length === 0) return;
        const body = choices[Math.floor(Math.random() * choices.length)]();
        postCrewMessage(crew, body);
      }

      // ============================================================
      // COMIC SPEECH BUBBLES OVER 3D CREW FIGURES
      // ============================================================
      // The user wanted the crew to visibly talk to each other in the
      // 3D scene — "like in comics" — instead of only conversing in
      // the text feed. So each conversation turn now also pops a DOM
      // speech bubble above the speaker's head, projected from world
      // coords to screen coords every frame. Bubble follows the figure
      // if they walk while speaking, fades out after a hold time.
      //
      // Mapping crew NAME → 3D figure: assigned at startOpsCrewSimulation
      // time. Roster and crewFigures are built in parallel order
      // (DISPATCH, MAINT×3, GROUND, OPS, ATC) so we can stamp names
      // onto figure.userData.name at sim start.

      const padSpeechBubbles = [];     // [{el, figure, expiresAt, fadingAt}]
      let padSpeechRafId = null;

      // Strip HTML tags and decode the few entities that show up in our
      // message bodies. Speech bubbles are plain text only — no spans.
      function stripBubbleHtml(html) {
        if (!html) return '';
        const text = String(html)
          .replace(/<[^>]+>/g, '')
          .replace(/&amp;/g, '&')
          .replace(/&lt;/g, '<')
          .replace(/&gt;/g, '>')
          .replace(/&quot;/g, '"')
          .replace(/&#39;/g, "'")
          .replace(/\s+/g, ' ')
          .trim();
        return text;
      }

      // Find the 3D figure object for a roster entry by name. Names are
      // stamped onto figure.userData.name at startOpsCrewSimulation time.
      function findCrewFigureByName(name) {
        if (!name || !padScene || !padScene.userData || !Array.isArray(padScene.userData.crewFigures)) return null;
        return padScene.userData.crewFigures.find(f => f && f.userData && f.userData.name === name) || null;
      }
      if (typeof window !== 'undefined') window.__findCrewFigureByName = findCrewFigureByName;

      // Pair roster names ↔ figures. Both arrays are built in the same
      // canonical order (DISPATCH, MAINT, MAINT, MAINT, GROUND, OPS, ATC)
      // so a 1:1 zip works for the base 7. Extras (roster entries beyond
      // index 6) don't have figures and won't get bubbles — that's fine,
      // they only chatter in the text feed.
      function pairCrewNamesToFigures() {
        try {
          if (!padScene || !padScene.userData || !Array.isArray(padScene.userData.crewFigures)) return;
          const figures = padScene.userData.crewFigures;
          const N = Math.min(figures.length, padCrewRoster.length);
          for (let i = 0; i < N; i++) {
            const f = figures[i];
            const r = padCrewRoster[i];
            if (f && r) {
              // Sanity: the roles should match thanks to parallel ordering.
              // If they don't (defensive — someone reordered the slots
              // without updating the other), prefer matching by role
              // instead of by index so names still attach to the right kind
              // of crew member.
              if (f.userData.role === r.role) {
                f.userData.name = r.name;
              }
            }
          }
          // Second pass: any figure still missing a name, find the first
          // roster member with matching role + no figure-name yet.
          const usedNames = new Set(figures.map(f => f.userData.name).filter(Boolean));
          for (const f of figures) {
            if (f.userData.name) continue;
            const candidate = padCrewRoster.find(r => r.role === f.userData.role && !usedNames.has(r.name));
            if (candidate) { f.userData.name = candidate.name; usedNames.add(candidate.name); }
          }
        } catch (err) { console.warn('[OPS CREW] pair names failed:', err); }
      }
      if (typeof window !== 'undefined') window.__pairCrewNamesToFigures = pairCrewNamesToFigures;

      // Spawn a comic speech bubble above a figure. Returns the bubble
      // element (or null if unable). holdMs is how long the bubble stays
      // fully visible before starting its fade-out.
      // ============================================================
      // CREW VOICE SYNTHESIS
      // ============================================================
      // User: "Ok as well as the comic's lets had audio so I can hear
      // them talking. All should be different kinds of male voices,
      // not robotic but enhanced." Browser SpeechSynthesis API gives
      // us a free pool of system voices — on macOS that includes the
      // "Enhanced" / "Premium" voices the user is asking for. We
      // build a male-leaning pool from the available voices, assign
      // each crew member a deterministic voice + pitch + rate combo
      // (same crew name → same voice across the session), and speak
      // every bubble line. Honors the existing pad-audio-toggle mute
      // state so propeller + voice mute together with one click.
      const padCrewVoiceState = {
        enabled: true,                // global voice on/off (separate from mute)
        voicePool: [],                // ordered list of preferred voices
        assignments: new Map(),       // crewName → {voice, rate, pitch}
        recentUtterances: [],         // for queue cap
        loaded: false,
      };

      // Voice-name hint lists. Web Speech API doesn't expose gender,
      // so we score by name. These cover the common voice catalogs
      // shipped with macOS, Windows 10/11, ChromeOS, and Google Cloud.
      const VOICE_MALE_HINTS = [
        // macOS English male voices (many available as Enhanced/Premium):
        'Daniel', 'Alex', 'Aaron', 'Arthur', 'Bruce', 'Eddy', 'Fred',
        'Gordon', 'Lee', 'Markus', 'Nicky', 'Oliver', 'Reed', 'Ralph',
        'Tom', 'Rishi', 'Rocko',
        // Microsoft / Windows English male voices:
        'David', 'Mark', 'Guy', 'James', 'Brandon', 'Christopher',
        'Eric', 'Andrew', 'Microsoft David', 'Microsoft Mark',
        'Microsoft Guy', 'Microsoft James',
        // Google English voices that lean male:
        'Google UK English Male',
      ];
      const VOICE_FEMALE_HINTS = [
        'Samantha', 'Karen', 'Victoria', 'Susan', 'Allison', 'Ava',
        'Catherine', 'Fiona', 'Kate', 'Linda', 'Moira', 'Tessa',
        'Veena', 'Lekha', 'Princess', 'Whisper', 'Microsoft Zira',
        'Microsoft Hazel', 'Zira', 'Hazel', 'Jenny', 'Aria', 'Emma',
        'Nora', 'Google UK English Female',
      ];
      // Novelty / robotic voices to avoid even if they're male-sounding —
      // user explicitly said "not robotic."
      const VOICE_NOVELTY_HINTS = [
        'Bahh', 'Bells', 'Boing', 'Bubbles', 'Cellos', 'Deranged',
        'Hysterical', 'Pipe Organ', 'Trinoids', 'Whisper', 'Zarvox',
        'Albert', 'Bad News', 'Good News', 'Junior', 'Kathy', 'Ralph',
      ];

      function loadCrewVoicePool() {
        if (typeof speechSynthesis === 'undefined') {
          padCrewVoiceState.loaded = true;
          return;
        }
        const all = speechSynthesis.getVoices() || [];
        if (all.length === 0) return;     // try again on voiceschanged
        // English-language only (any region — en-US, en-GB, en-AU all OK)
        const en = all.filter(v => /^en[-_]/i.test(v.lang || ''));
        const candidates = en.length > 0 ? en : all.slice(0, 8);
        // Score each voice. Higher = preferred.
        const scored = candidates.map(v => {
          const n = (v.name || '').toLowerCase();
          let s = 0;
          if (VOICE_MALE_HINTS.some(h => n.includes(h.toLowerCase())))    s += 4;
          if (VOICE_FEMALE_HINTS.some(h => n.includes(h.toLowerCase())))  s -= 6;
          if (VOICE_NOVELTY_HINTS.some(h => n.includes(h.toLowerCase()))) s -= 8;
          // "Enhanced" / "Premium" / "Natural" / "Neural" → modern
          // higher-quality voice. User wants "enhanced not robotic."
          if (/enhanced|premium|natural|neural/i.test(v.name || ''))      s += 3;
          // Local voices avoid network round-trip latency
          if (v.localService)                                              s += 1;
          return { voice: v, score: s };
        });
        scored.sort((a, b) => b.score - a.score);
        // Keep voices with non-negative score (or fallback to top 6 if
        // nothing scored well enough — rare edge case on barebones
        // browsers).
        let pool = scored.filter(s => s.score >= 0).map(s => s.voice);
        if (pool.length === 0) pool = scored.slice(0, 6).map(s => s.voice);
        // Cap pool size — having 6+ distinct voices is plenty for the
        // 10-person roster (slight rate/pitch variation differentiates
        // crew that share a voice).
        pool = pool.slice(0, 6);
        padCrewVoiceState.voicePool = pool;
        padCrewVoiceState.loaded = true;
        // Voice change — re-assign anyone who had a voice that's no
        // longer in the pool (e.g., a region change loaded a new set).
        for (const [name, asg] of padCrewVoiceState.assignments) {
          if (!pool.includes(asg.voice)) padCrewVoiceState.assignments.delete(name);
        }
      }

      // Voice availability is async on Chrome — voices populate after
      // the voiceschanged event fires. Trigger loadCrewVoicePool on
      // both immediate call (for browsers that have voices ready) and
      // the event (for Chrome).
      try {
        if (typeof speechSynthesis !== 'undefined') {
          loadCrewVoicePool();
          if (typeof speechSynthesis.addEventListener === 'function') {
            speechSynthesis.addEventListener('voiceschanged', loadCrewVoicePool);
          } else {
            // Older browsers expose onvoiceschanged property
            speechSynthesis.onvoiceschanged = loadCrewVoicePool;
          }
        }
      } catch (err) { console.warn('[crew voice] init failed:', err); }

      function assignCrewVoice(crewName) {
        if (padCrewVoiceState.assignments.has(crewName)) {
          return padCrewVoiceState.assignments.get(crewName);
        }
        const pool = padCrewVoiceState.voicePool;
        if (pool.length === 0) return null;
        // Stable hash: same crew name always picks the same voice
        let h = 0;
        for (let i = 0; i < crewName.length; i++) {
          h = ((h * 31) + crewName.charCodeAt(i)) | 0;
        }
        const voiceIdx = Math.abs(h) % pool.length;
        // Per-crew rate + pitch variation so even crew sharing a voice
        // sound distinct. Pitch stays ≤1.0 to preserve the male timbre.
        // Rate near 1.0 keeps speech natural; 0.92-1.04 is a subtle
        // range that still varies perceptibly.
        const rate  = 0.92 + ((Math.abs(h >> 4) % 13) / 100);    // 0.92 - 1.04
        const pitch = 0.78 + ((Math.abs(h >> 8) % 22) / 100);    // 0.78 - 0.99
        const assignment = { voice: pool[voiceIdx], rate, pitch };
        padCrewVoiceState.assignments.set(crewName, assignment);
        return assignment;
      }

      // Diagnostic counters — useful when the user reports "I can't
      // hear the voices." Inspect via __padCrewVoiceState.diagnostics.
      padCrewVoiceState.diagnostics = {
        speakCalls: 0,
        spoken: 0,
        blockedNoSynth: 0,
        blockedDisabled: 0,
        blockedCustomerMode: 0,
        blockedMuted: 0,
        blockedEmpty: 0,
        blockedQueueFull: 0,            // new: dropped due to backed-up queue
        primed: false,
        lastError: null,
      };

      // SPEECH PRIMER
      // Chrome and Safari may silently swallow the first speak() if it
      // arrives before any user gesture has touched the SpeechSynthesis
      // API specifically. We call this from the launchpad's first user
      // click to "warm up" the API — empty utterance, zero volume, but
      // it counts as a gesture for the autoplay policy.
      function primeCrewVoice() {
        if (padCrewVoiceState.diagnostics.primed) return;
        try {
          if (typeof speechSynthesis === 'undefined') return;
          if (typeof SpeechSynthesisUtterance === 'undefined') return;
          const warmup = new SpeechSynthesisUtterance(' ');
          warmup.volume = 0.01;
          warmup.rate = 1;
          warmup.pitch = 1;
          speechSynthesis.speak(warmup);
          padCrewVoiceState.diagnostics.primed = true;
        } catch (err) { padCrewVoiceState.diagnostics.lastError = String(err); }
      }
      if (typeof window !== 'undefined') window.__primeCrewVoice = primeCrewVoice;

      function speakCrewLine(crewName, text) {
        const D = padCrewVoiceState.diagnostics;
        D.speakCalls++;
        // Voice has its OWN enable state — independent from propellers.
        // Earlier version coupled to propellerSynth.muted, which was
        // fragile (if the audio button was ever toggled, voices died
        // silently). Now they're separate: mute the speaker icon to
        // mute propellers; voices have their own toggle via
        // __setCrewVoiceEnabled / the audio button still cancels both.
        if (!padCrewVoiceState.enabled) { D.blockedDisabled++; return; }
        if (typeof speechSynthesis === 'undefined' ||
            typeof SpeechSynthesisUtterance === 'undefined') {
          D.blockedNoSynth++; return;
        }
        if (typeof window !== 'undefined' && window.__customerModeActive) {
          D.blockedCustomerMode++; return;
        }
        if (!text || !crewName) { D.blockedEmpty++; return; }

        const assignment = assignCrewVoice(crewName);
        const u = new SpeechSynthesisUtterance(String(text));
        // Volume 1.0 — matches what the browser exposes for system audio.
        // The previous 0.55 was inaudible on quiet systems where the
        // propeller audio (Tone.js) was already running near unity gain.
        u.volume = 1.0;
        if (assignment && assignment.voice) {
          u.voice = assignment.voice;
          u.rate  = assignment.rate;
          u.pitch = assignment.pitch;
        } else {
          // No voice pool yet — voices might still be loading async.
          // Try to pick ANY available voice synchronously so the
          // utterance has a concrete voice attached. Some browsers
          // refuse to speak when `voice` is null even though the
          // spec says null should fall back to the default.
          if (typeof speechSynthesis !== 'undefined') {
            const allVoices = speechSynthesis.getVoices() || [];
            if (allVoices.length > 0) {
              // Prefer en-* if any available, else first voice in list.
              const en = allVoices.find(v => /^en[-_]/i.test(v.lang || ''));
              u.voice = en || allVoices[0];
            }
          }
          u.rate  = 0.96;
          u.pitch = 0.85;
        }
        // STALE-QUEUE SWEEP — before checking the queue length, drop
        // any utterances older than 8 seconds. If Chrome's synth
        // zombies (a known bug after cancel-then-speak), onend/onerror
        // events never fire and the queue would otherwise grow forever
        // and permanently block all future audio. The user's screenshot
        // showed exactly this: 7 spoken / 6 dropped / queue full /
        // last_error="canceled" / no audio. Time-based cleanup ensures
        // the queue can always drain even when events don't.
        const _now = (typeof performance !== 'undefined' && performance.now)
          ? performance.now() : Date.now();
        const STALE_MS = 8000;
        padCrewVoiceState.recentUtterances =
          padCrewVoiceState.recentUtterances.filter(entry => {
            const ts = entry && entry.t;
            return typeof ts === 'number' && (_now - ts) < STALE_MS;
          });
        // Queue-full handling: DROP the new utterance instead of
        // cancelling the in-flight ones. Calling speechSynthesis.cancel()
        // followed quickly by speak() triggers a Chrome bug where the
        // new utterance is queued but silently never plays. Dropping
        // a single voice line is preferable — the bubble is still
        // visible. Cap raised to 6 so the bar's a bit more forgiving.
        if (padCrewVoiceState.recentUtterances.length > 6) {
          D.blockedQueueFull++;
          return;
        }
        // Push as {u, t} so the staleness sweep above can age entries
        // out. (Was just `u` — fine when onend always fires, but the
        // entire point of this fix is the case where it doesn't.)
        const _entry = { u: u, t: _now };
        padCrewVoiceState.recentUtterances.push(_entry);
        const cleanup = () => {
          padCrewVoiceState.recentUtterances =
            padCrewVoiceState.recentUtterances.filter(e => e !== _entry);
        };
        u.onend = cleanup;
        u.onerror = (ev) => {
          D.lastError = (ev && ev.error) ? ev.error : 'unknown';
          cleanup();
        };
        try {
          // CHROME STUCK-STATE WORKAROUND
          // After ~15s of idle, Chrome can leave SpeechSynthesis in
          // a "paused" or zombie-pending state where speak() queues
          // utterances that never play. The fix is to call resume()
          // before every speak — it's a no-op when not paused but
          // unblocks the synth when it is. Cheap and silent if not
          // needed; the only thing that breaks audio if we DON'T
          // do this.
          if (speechSynthesis.paused) speechSynthesis.resume();
          speechSynthesis.speak(u);
          D.spoken++;
        } catch (err) {
          D.lastError = String(err);
          console.warn('[crew voice] speak failed:', err);
          cleanup();
        }
      }

      function setCrewVoiceEnabled(on) {
        padCrewVoiceState.enabled = !!on;
        if (!on) {
          try { speechSynthesis.cancel(); } catch (_) {}
          padCrewVoiceState.recentUtterances.length = 0;
        }
      }

      // Diagnostic + manual-test helpers — for when the user can't hear
      // voices and we need to triangulate where it's blocked.
      function testCrewVoice(text) {
        const t = text || 'Crew voice test. If you can hear this, audio is working.';
        const crew = (padCrewRoster && padCrewRoster[0]) || { name: 'TEST' };
