    }
    .pad-map .route-line {
      stroke-dasharray: 2 4;
      stroke: rgba(0, 229, 255, 0.18);
      stroke-width: 0.5;
      fill: none;
    }
    .pad-map-status {
      padding: 6px 14px 8px;
      font-family: var(--font-mono);
      font-size: 10px;
      letter-spacing: 0.06em;
      color: var(--text-secondary);
      border-top: 1px solid var(--border);
      background: rgba(0, 0, 0, 0.2);
      flex-shrink: 0;
    }
    .pad-map-status .status-current {
      color: var(--accent-cyan);
    }

    /* ===== LOWER ROW: chat + map side by side ===== */
    .pad-lower-row {
      flex: 1;                  /* lower row takes ~30% — chat + map fit comfortably */
      display: flex;
      min-height: 0;
      border-top: 1px solid var(--border);
    }
    .pad-lower-row .pad-map-wrap {
      flex: 1;
      border-top: 0;
      border-left: 1px solid var(--border);
    }

    /* ===== AI CUSTOMER CHAT PANEL ===== */
    .pad-chat-panel {
      width: 340px;     /* slimmed from 380 to fit ops crew panel alongside */
      display: flex;
      flex-direction: column;
      background: rgba(2, 8, 18, 0.85);
      flex-shrink: 0;
      min-height: 0;
    }
    .pad-chat-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 10px 14px;
      border-bottom: 1px solid var(--border);
      background: rgba(0, 229, 255, 0.04);
    }
    .pad-chat-title {
      font-family: var(--font-mono);
      font-size: 10px;
      letter-spacing: 0.18em;
      color: var(--accent-cyan);
    }
    .pad-chat-status {
      font-family: var(--font-mono);
      font-size: 9px;
      letter-spacing: 0.1em;
      color: var(--text-secondary);
      padding: 2px 8px;
      background: rgba(0, 0, 0, 0.3);
      border: 1px solid var(--border);
      border-radius: 2px;
    }
    .pad-chat-feed {
      flex: 1;
      overflow-y: auto;
      padding: 10px 12px;
      display: flex;
      flex-direction: column;
      gap: 10px;
      min-height: 0;
    }
    .pad-chat-empty {
      color: var(--text-secondary);
      font-family: var(--font-mono);
      font-size: 11px;
      text-align: center;
      padding: 30px 10px;
      letter-spacing: 0.04em;
    }
    .pad-chat-msg {
      display: flex;
      flex-direction: column;
      gap: 4px;
      padding: 10px 12px;
      background: rgba(255, 255, 255, 0.03);
      border: 1px solid var(--border);
      border-left: 3px solid var(--accent-cyan);
      border-radius: 3px;
      cursor: pointer;
      transition: all 0.15s;
      animation: chatSlideIn 0.35s ease-out;
    }
    @keyframes chatSlideIn {
      from { opacity: 0; transform: translateY(8px); }
      to   { opacity: 1; transform: translateY(0); }
    }
    .pad-chat-msg:hover {
      background: rgba(0, 229, 255, 0.06);
      border-left-color: #4adef0;
      transform: translateX(-2px);
    }
    .pad-chat-msg.selected {
      background: rgba(0, 229, 255, 0.10);
      border: 1px solid var(--accent-cyan);
      border-left: 3px solid var(--accent-cyan);
      box-shadow: 0 0 8px rgba(0, 229, 255, 0.18);
    }
    .pad-chat-msg.dispatched {
      opacity: 0.55;
      cursor: default;
      border-left-color: #4ade80;
    }
    .pad-chat-msg.dispatched:hover { transform: none; background: rgba(255, 255, 255, 0.03); }
    .pad-chat-msg-head {
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-family: var(--font-mono);
    }
    .pad-chat-msg-name {
      color: var(--accent-cyan);
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.05em;
    }
    .pad-chat-msg-time {
      color: var(--text-secondary);
      font-size: 9px;
      letter-spacing: 0.08em;
    }
    .pad-chat-msg-body {
      color: var(--text-primary);
      font-family: var(--font-mono);
      font-size: 11px;
      line-height: 1.45;
      letter-spacing: 0.01em;
    }
    .pad-chat-msg-route {
      display: flex;
      align-items: center;
      gap: 6px;
      font-family: var(--font-mono);
      font-size: 10px;
      letter-spacing: 0.04em;
      padding-top: 4px;
      border-top: 1px dashed var(--border);
      margin-top: 4px;
    }
    .pad-chat-msg-route .from { color: #4ade80; }
    .pad-chat-msg-route .arrow { color: var(--accent-cyan); }
    .pad-chat-msg-route .to { color: #f59e0b; }
    .pad-chat-msg-status {
      font-family: var(--font-mono);
      font-size: 9px;
      letter-spacing: 0.1em;
      color: #4ade80;
      padding-top: 4px;
    }
    .pad-chat-footer {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 8px 12px;
      border-top: 1px solid var(--border);
      background: rgba(0, 0, 0, 0.25);
      flex-shrink: 0;
    }
    .pad-chat-hint {
      font-family: var(--font-mono);
      font-size: 9px;
      letter-spacing: 0.05em;
      color: var(--text-secondary);
    }

    /* ===== AI OPS CREW PANEL — live worker activity feed =====
       Mirrors the chat panel structure but shows crew/ops messages
       instead of customer orders. Each role is color-coded so the
       user can see at a glance who's doing what (dispatcher in cyan,
       mechanic in amber, ground crew in green, etc). */
    .pad-crew-panel {
      width: 320px;
      display: flex;
      flex-direction: column;
      background: rgba(2, 8, 18, 0.85);
      flex-shrink: 0;
      min-height: 0;
      border-left: 1px solid var(--border);
    }
    .pad-crew-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 10px 14px;
      border-bottom: 1px solid var(--border);
      background: rgba(74, 222, 128, 0.04);
      gap: 10px;
    }
    .pad-crew-title {
      font-family: var(--font-mono);
      font-size: 11px;
      letter-spacing: 0.16em;
      color: #4ade80;
      font-weight: 600;
      flex-shrink: 0;
    }
    /* Live fleet-state pill — at-a-glance counts (airborne, charging,
       ready, hold). Tight spacing, mono font, color-coded. The user
       asked for "tell what's happening at a glance" so this pill
       lives in the chat header and updates every 500ms. */
    .pad-crew-statpill {
      display: inline-flex;
      gap: 6px;
      align-items: center;
      flex: 1;
      justify-content: center;
      font-family: var(--font-mono);
      font-size: 10px;
      letter-spacing: 0.04em;
    }
    .statpill-cell {
      display: inline-flex;
      align-items: baseline;
      gap: 3px;
      padding: 2px 6px;
      border-radius: 3px;
      background: rgba(255,255,255,0.04);
      border: 1px solid rgba(255,255,255,0.08);
      transition: background 0.18s, border-color 0.18s;
    }
    .statpill-cell b {
      font-size: 12px;
      font-weight: 600;
      color: #fff;
    }
    .statpill-cell em {
      font-style: normal;
      font-size: 10px;
      opacity: 0.8;
    }
    .statpill-air b    { color: #ff8800; }
    .statpill-air em   { color: #ff8800; }
    .statpill-charge b { color: #00E5FF; }
    .statpill-charge em{ color: #00E5FF; }
    .statpill-ready b  { color: #4ade80; }
    .statpill-ready em { color: #4ade80; }
    .statpill-hold b   { color: #ffb347; }
    .statpill-hold em  { color: #ffb347; font-weight: 600; letter-spacing: 0.1em; font-size: 9px; }
    .statpill-cell.has-activity {
      background: rgba(255,136,0,0.10);
      border-color: rgba(255,136,0,0.35);
    }
    .pad-crew-status {
      font-family: var(--font-mono);
      font-size: 9px;
      letter-spacing: 0.1em;
      color: var(--text-secondary);
      flex-shrink: 0;
    }
    /* Confirm bar — appears between feed and input when the user
       types a slash command. Shows the parsed intent + a confirm/
       cancel pair. Tap CONFIRM to execute. */
    .pad-crew-confirm {
      display: flex;
      align-items: center;
      gap: 8px;
      padding: 8px 12px;
      background: rgba(255,179,71,0.08);
      border-top: 1px solid rgba(255,179,71,0.30);
      border-bottom: 1px solid rgba(255,179,71,0.20);
      font-family: var(--font-mono);
      font-size: 11px;
      color: #ffb347;
    }
    .pad-crew-confirm .confirm-label {
      flex: 1;
      letter-spacing: 0.08em;
      color: #ffb347;
    }
    .pad-crew-confirm .confirm-label b {
      color: #fff;
      font-weight: 600;
    }
    .pad-crew-confirm .confirm-yes,
    .pad-crew-confirm .confirm-no {
      font-family: var(--font-mono);
      font-size: 10px;
      letter-spacing: 0.12em;
      padding: 5px 12px;
      border-radius: 3px;
      cursor: pointer;
      border: 1px solid;
      background: transparent;
      transition: background 0.15s, color 0.15s;
    }
    .pad-crew-confirm .confirm-yes {
      color: #4ade80;
      border-color: rgba(74,222,128,0.5);
    }
    .pad-crew-confirm .confirm-yes:hover {
      background: rgba(74,222,128,0.18);
    }
    .pad-crew-confirm .confirm-no {
      color: #888;
      border-color: rgba(255,255,255,0.18);
    }
    .pad-crew-confirm .confirm-no:hover {
      background: rgba(255,255,255,0.06);
      color: #ccc;
    }
    .pad-crew-feed {
      flex: 1;
      overflow-y: auto;
      padding: 8px 10px;
      display: flex;
      flex-direction: column;
      gap: 6px;
      min-height: 0;
    }
    .pad-crew-empty {
      font-family: var(--font-mono);
      font-size: 10px;
      color: var(--text-secondary);
      text-align: center;
      padding: 20px 0;
      letter-spacing: 0.1em;
    }
    .pad-crew-msg {
      padding: 7px 10px;
      background: rgba(255, 255, 255, 0.03);
      border-left: 2px solid var(--accent-cyan);
      border-radius: 0 3px 3px 0;
      font-family: var(--font-mono);
      font-size: 10px;
      line-height: 1.4;
      animation: crew-msg-in 0.3s ease-out;
    }
    @keyframes crew-msg-in {
      from { opacity: 0; transform: translateX(-8px); }
      to   { opacity: 1; transform: translateX(0); }
    }
    .pad-crew-msg-head {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      gap: 8px;
      margin-bottom: 3px;
    }
    .pad-crew-msg-name {
      font-weight: 600;
      letter-spacing: 0.04em;
      color: #fff;
    }
    .pad-crew-msg-role {
      font-size: 8px;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      opacity: 0.85;
    }
    .pad-crew-msg-time {
      font-size: 9px;
      color: var(--text-secondary);
      margin-left: auto;
    }
    .pad-crew-msg-body {
      color: var(--text-secondary);
      letter-spacing: 0.02em;
    }
    .pad-crew-msg-body .tail {
      color: var(--accent-cyan);
      font-weight: 600;
    }
    .pad-crew-msg-body .pad-name {
      color: #f59e0b;
      font-weight: 600;
    }
    /* Role accents */
    .pad-crew-msg.role-dispatcher,
    .pad-crew-msg.role-dispatch  { border-left-color: var(--accent-cyan); }
    .pad-crew-msg.role-dispatcher .pad-crew-msg-role,
    .pad-crew-msg.role-dispatch  .pad-crew-msg-role { color: var(--accent-cyan); }
    .pad-crew-msg.role-mechanic,
    .pad-crew-msg.role-maint     { border-left-color: #f59e0b; }
    .pad-crew-msg.role-mechanic  .pad-crew-msg-role,
    .pad-crew-msg.role-maint     .pad-crew-msg-role { color: #f59e0b; }
    .pad-crew-msg.role-ground    { border-left-color: #4ade80; }
    .pad-crew-msg.role-ground    .pad-crew-msg-role { color: #4ade80; }
    .pad-crew-msg.role-ops       { border-left-color: #a78bfa; }
    .pad-crew-msg.role-ops       .pad-crew-msg-role { color: #a78bfa; }
    .pad-crew-msg.role-atc       { border-left-color: #60a5fa; }
    .pad-crew-msg.role-atc       .pad-crew-msg-role { color: #60a5fa; }
    /* IR · Incident Response — crimson red. Drives a recovery vehicle out
       of the hub when a fault triggers and an aircraft is aborting. */
    .pad-crew-msg.role-ir        { border-left-color: #ef4444; }
    .pad-crew-msg.role-ir        .pad-crew-msg-role { color: #ef4444; }
    /* VO · Visual Observer — amber. Stationed away from the hub on a
       lookout platform. Reports aircraft sightings directly to the owner. */
    .pad-crew-msg.role-vo        { border-left-color: #fbbf24; }
    .pad-crew-msg.role-vo        .pad-crew-msg-role { color: #fbbf24; }
    /* Bubble role colors for IR + VO so comic bubbles match feed colors */
    .pad-speech-bubble.role-IR   .speaker-name { color: #c41e1e; }
    .pad-speech-bubble.role-VO   .speaker-name { color: #b67308; }

    /* Owner-addressed messages (VO field reports + select MAINT updates).
       Visually distinguished so the user can scan for messages directed
       at them specifically vs. crew-to-crew chatter. User: "VO reporting
       information to me, the owner. Maintenance should also communicate
       with me too." */
    .pad-crew-msg.addressed-to-owner {
      background: rgba(251, 191, 36, 0.08);
      box-shadow: inset 3px 0 0 rgba(251, 191, 36, 0.6);
    }
    .pad-crew-msg.addressed-to-owner .pad-crew-msg-body::before {
      content: '@ OWNER · ';
      font-family: var(--font-mono);
      font-size: 9px;
      letter-spacing: 0.14em;
      color: #fbbf24;
      font-weight: 700;
      margin-right: 4px;
    }
    /* Operator (the user, Head of Operations) — distinct styling so
       the user's own messages stand out in the feed */
    .pad-crew-msg.role-operator  {
      border-left-color: #ffffff;
      background: rgba(255, 255, 255, 0.08);
    }
    .pad-crew-msg.role-operator  .pad-crew-msg-role { color: #ffffff; }
    .pad-crew-msg.role-operator  .pad-crew-msg-name { color: #ffffff; }

    /* Operator chat input — bottom of crew panel */
    .pad-crew-input-wrap {
      display: flex;
      gap: 6px;
      padding: 8px 10px;
      border-top: 1px solid var(--border);
      background: rgba(0, 0, 0, 0.3);
    }
    .pad-crew-input {
      flex: 1;
      min-width: 0;
      background: rgba(0, 0, 0, 0.4);
      border: 1px solid var(--border);
      color: var(--text-primary);
      padding: 6px 10px;
      font-family: var(--font-mono);
      font-size: 11px;
      letter-spacing: 0.04em;
      border-radius: 3px;
      outline: none;
    }
    .pad-crew-input:focus {
      border-color: var(--accent-cyan);
      box-shadow: 0 0 0 1px rgba(0, 229, 255, 0.3);
    }
    .pad-crew-input::placeholder {
      color: var(--text-secondary);
      letter-spacing: 0.06em;
    }
    .pad-crew-send {
      background: rgba(0, 229, 255, 0.15);
      border: 1px solid var(--accent-cyan);
      color: var(--accent-cyan);
      font-family: var(--font-mono);
      font-size: 10px;
      letter-spacing: 0.12em;
      padding: 6px 12px;
      cursor: pointer;
      border-radius: 3px;
      font-weight: 600;
      transition: background 0.15s;
    }
    .pad-crew-send:hover {
      background: rgba(0, 229, 255, 0.28);
    }
    .pad-crew-send:active {
      background: rgba(0, 229, 255, 0.4);
    }
    /* VOICE INPUT — mic button next to SEND. User: "add a voice to text
       (that only works when I am in the hub not a customer)... so that
       I can voice communicate with the AI hub people." Uses the browser's
       built-in SpeechRecognition (Chrome via Google's servers, Safari via
       Apple's). Suppressed in customer mode. */
    .pad-crew-mic {
      background: rgba(74, 222, 128, 0.10);
      border: 1px solid rgba(74, 222, 128, 0.5);
      color: #4ade80;
      font-size: 14px;
      padding: 6px 10px;
      cursor: pointer;
      border-radius: 3px;
      transition: background 0.12s, color 0.12s;
      flex-shrink: 0;
    }
    .pad-crew-mic:hover {
      background: rgba(74, 222, 128, 0.22);
    }
    .pad-crew-mic:disabled {
      opacity: 0.35;
      cursor: not-allowed;
    }
    .pad-crew-mic.recording {
      background: rgba(239, 68, 68, 0.20);
      border-color: #ef4444;
      color: #ef4444;
      animation: mic-pulse 1.1s ease-in-out infinite;
    }
    @keyframes mic-pulse {
      0%, 100% { box-shadow: 0 0 0 0 rgba(239, 68, 68, 0.55); }
      50%      { box-shadow: 0 0 0 6px rgba(239, 68, 68, 0); }
    }
    .pad-crew-mic-status {
      margin-top: 4px;
      padding: 5px 8px;
      background: rgba(74, 222, 128, 0.08);
      border: 1px solid rgba(74, 222, 128, 0.25);
      border-radius: 3px;
      font-size: 11px;
      color: #d8efff;
      font-style: italic;
      min-height: 18px;
    }
    .pad-crew-mic-status.recording {
      background: rgba(239, 68, 68, 0.10);
      border-color: rgba(239, 68, 68, 0.35);
      color: #fecaca;
    }
    .pad-crew-mic-status.error {
      background: rgba(239, 68, 68, 0.10);
      border-color: rgba(239, 68, 68, 0.35);
      color: #ef4444;
    }
    .pad-crew-mic-status[hidden] { display: none; }

    /* ===== FLEET ROSTER (sidebar list of selectable aircraft) ===== */
    .pad-fleet-roster {
      display: flex;
      flex-direction: column;
      gap: 6px;
      max-height: 260px;
      overflow-y: auto;
    }
    .pad-roster-item {
      display: grid;
      grid-template-columns: auto 1fr auto;
      gap: 8px;
      align-items: center;
      padding: 8px 10px;
      background: rgba(255, 255, 255, 0.025);
      border: 1px solid var(--border);
      border-radius: 3px;
      cursor: pointer;
      transition: all 0.15s;
      font-family: var(--font-mono);
    }
    .pad-roster-item:hover {
      border-color: var(--accent-cyan);
      background: rgba(0, 229, 255, 0.06);
    }
    .pad-roster-item.selected {
      border-color: var(--accent-cyan);
      background: rgba(0, 229, 255, 0.12);
      box-shadow: 0 0 8px rgba(0, 229, 255, 0.2);
    }
    .pad-roster-item.in-flight {
      opacity: 0.5;
      cursor: not-allowed;
    }
    .pad-roster-dot {
      width: 8px; height: 8px;
      border-radius: 50%;
      background: #4ade80;
    }
    .pad-roster-item.in-flight .pad-roster-dot {
      background: #f59e0b;
      animation: pulse 1.4s ease-in-out infinite;
    }
    .pad-roster-item.charging .pad-roster-dot {
      background: #00E5FF;
      animation: pulse 1.4s ease-in-out infinite;
    }
    .pad-roster-name {
      font-size: 11px;
      color: var(--text-primary);
      letter-spacing: 0.04em;
      grid-column: 2;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
    .pad-roster-tail {
      font-size: 9px;
      color: var(--accent-cyan);
      letter-spacing: 0.1em;
      grid-column: 3;
    }
    .pad-roster-meta {
      font-size: 9px;
      color: var(--text-secondary);
      letter-spacing: 0.04em;
      grid-column: 2;
    }
    .pad-roster-battery {
      font-size: 9px;
      letter-spacing: 0.04em;
      grid-column: 3;
      color: #30ff60;
      text-align: right;
      font-weight: 500;
    }
    .pad-roster-empty {
      padding: 12px;
      text-align: center;
      font-family: var(--font-mono);
      font-size: 10px;
      color: var(--text-secondary);
      letter-spacing: 0.05em;
    }
    .pad-sidebar {
      width: 340px;
      border-left: 1px solid var(--border);
      background: rgba(0, 0, 0, 0.3);
      overflow-y: auto;
      padding: 6px 0;
    }
    .pad-queue-item {
      padding: 10px 0;
      font-family: var(--font-mono);
    }
    .pad-queue-label {
      font-size: 9px;
      letter-spacing: 0.18em;
      color: var(--text-secondary);
      margin-bottom: 4px;
    }
    .pad-queue-route {
      font-size: 13px;
      color: var(--text-primary);
      letter-spacing: 0.04em;
      margin-bottom: 4px;
    }
    .pad-queue-eta {
      font-size: 10px;
      color: var(--text-secondary);
      letter-spacing: 0.04em;
    }
    .pad-queue-eta strong { color: var(--accent-cyan); font-weight: 700; }
    .pad-dispatch-buttons { display: flex; flex-direction: column; gap: 8px; }
    .pad-dispatch-btn { padding: 12px; font-size: 12px; letter-spacing: 0.1em; }
    /* Charge gate: when the selected aircraft is below 95% SoC or already in
       flight, the LAUNCH NOW button is disabled and visually dimmed. The label
       changes to indicate the blocking condition so the user understands. */
    .pad-launch-blocked,
    button.pad-dispatch-btn:disabled {
      background: rgba(15, 23, 42, 0.6) !important;
      color: rgba(0, 229, 255, 0.45) !important;
      border-color: rgba(0, 229, 255, 0.20) !important;
      cursor: not-allowed !important;
      opacity: 0.7;
      transform: none !important;
      box-shadow: none !important;
    }
    .pad-launch-blocked:hover,
    button.pad-dispatch-btn:disabled:hover {
      background: rgba(15, 23, 42, 0.6) !important;
      color: rgba(0, 229, 255, 0.45) !important;
      border-color: rgba(0, 229, 255, 0.20) !important;
    }
    .pad-footer {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 12px 20px;
      border-top: 1px solid var(--border);
      background: rgba(0, 0, 0, 0.3);
    }

    /* ===== SAVED DESIGNS PANEL (splash) ===== */
    .saved-designs-panel {
      position: absolute;
      top: 90px;
      right: 36px;
      width: 320px;
      background: rgba(8, 12, 24, 0.78);
      border: 1px solid var(--border-hi);
      border-radius: 4px;
      backdrop-filter: blur(8px);
      padding: 14px 16px;
      max-height: 60vh;
      overflow-y: auto;
      z-index: 5;
      animation: slideIn 0.5s cubic-bezier(0.2, 0.8, 0.2, 1);
      /* When dragging, suppress the slide-in entrance + transitions so the
         panel snaps to the cursor instead of easing toward it. */
    }
    .saved-designs-panel.dragging {
      animation: none;
      transition: none;
      cursor: grabbing;
      box-shadow: 0 8px 32px rgba(0, 229, 255, 0.18);
    }
    /* Make the header act as the drag grip */
    .saved-designs-header {
      cursor: grab;
      user-select: none;
    }
    .saved-designs-panel.dragging .saved-designs-header {
      cursor: grabbing;
    }
    /* Tiny visual hint that the header is draggable */
    .saved-designs-drag-hint {
      font-family: var(--font-mono);
      font-size: 9px;
      letter-spacing: 0.12em;
      color: var(--text-secondary);
      opacity: 0.55;
      margin-left: 8px;
    }

    /* ===== TOTAL FLIGHTS COUNTER (splash hero) ===== */
    .splash-flight-counter {
      display: inline-flex;
      flex-direction: column;
      align-items: center;
      gap: 4px;
      margin-top: 18px;
      padding: 12px 28px;
      background: rgba(0, 229, 255, 0.04);
      border: 1px solid rgba(0, 229, 255, 0.22);
      border-radius: 4px;
      backdrop-filter: blur(4px);
    }
    .splash-flight-counter .counter-label {
      font-family: var(--font-mono);
      font-size: 10px;
      letter-spacing: 0.24em;
      color: var(--accent-cyan);
      opacity: 0.85;
    }
    .splash-flight-counter .counter-value {
      font-family: var(--font-mono);
      font-size: 32px;
      font-weight: 600;
      letter-spacing: 0.06em;
      color: #fff;
      line-height: 1;
      font-variant-numeric: tabular-nums;
    }
    .splash-flight-counter .counter-live {
      font-family: var(--font-mono);
      font-size: 10px;
      letter-spacing: 0.16em;
      color: #fbbf24;     /* amber — matches "in flight" pill color elsewhere */
      margin-top: 4px;
      animation: counter-live-pulse 2s ease-in-out infinite;
    }
    .splash-flight-counter .counter-sublabel {
      font-family: var(--font-mono);
      font-size: 9px;
      letter-spacing: 0.12em;
      color: var(--text-secondary);
      margin-top: 4px;
      text-transform: uppercase;
      opacity: 0.7;
    }
    .splash-flight-counters {
      display: flex;
      gap: 16px;
      justify-content: center;
      flex-wrap: wrap;
      margin-top: 18px;
    }
    .splash-flight-counters .splash-flight-counter {
      margin-top: 0;     /* parent flex container handles spacing */
    }
    @keyframes counter-live-pulse {
      0%, 100% { opacity: 1; }
      50%      { opacity: 0.55; }
    }

    /* ===== LIVE ACTIVITY PANEL — what's happening + crew status =====
       User: "the splash screen needs to update what all is happening
       and what the workers are working on, as well as the counters
       like a summary." */
    .splash-activity {
      display: flex;
      gap: 12px;
      justify-content: center;
      flex-wrap: wrap;
      margin: 18px auto 0;
      width: 100%;
      max-width: 1080px;
      position: relative;
      z-index: 6;     /* above the saved-designs hangar panel (z-index 5) so the activity panel is never hidden behind it when the user drags the hangar over the center column */
    }
    .splash-network-counts {
      grid-template-columns: repeat(4, 1fr) !important;
    }
    .splash-network-summary b {
      color: #7dd3fc;     /* slightly cyan tint to differentiate from fleet */
    }
    .splash-activity-section {
      flex: 1 1 320px;
      min-width: 260px;
      background: rgba(10, 22, 44, 0.78);     /* more opaque so hangar behind doesn't bleed through */
      border: 1px solid rgba(0, 229, 255, 0.18);
      border-radius: 4px;
      padding: 10px 12px 11px;     /* tighter — keeps customer button on screen */
      display: flex;
      flex-direction: column;
      gap: 6px;
      backdrop-filter: blur(4px);
    }
    .splash-activity-title {
      font-family: var(--font-mono);
      font-size: 10px;
      letter-spacing: 0.18em;
      color: rgba(0, 229, 255, 0.72);
      text-transform: uppercase;
    }
    .splash-fleet-counts {
      display: grid;
      grid-template-columns: repeat(5, 1fr);
      gap: 8px;
    }
    .splash-fleet-count {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 2px;
      padding: 5px 3px;
      background: rgba(0, 229, 255, 0.04);
      border: 1px solid rgba(0, 229, 255, 0.10);
      border-radius: 3px;
      min-width: 0;     /* allow shrinking below content size in narrow flex */
    }
    .splash-fleet-count b {
      font-family: var(--font-mono);
      font-size: 17px;
      font-weight: 600;
      color: #d8efff;
      line-height: 1.1;
    }
    .splash-fleet-count em {
      font-family: var(--font-mono);
      font-size: 8.5px;
      letter-spacing: 0.08em;
      color: rgba(216, 239, 255, 0.55);
      font-style: normal;
      text-transform: uppercase;
      text-align: center;
      line-height: 1.15;
    }
    .splash-crew-list {
      display: flex;
      flex-direction: column;
      gap: 3px;
      max-height: 120px;
      overflow-y: auto;
    }
    /* Fault counter — red-tinted variant of the fleet counts grid.
       Headline number sits inline with the section title; the per-kind
       cells live in the breakdown grid below. User asked for fault
       injections to show on the splash. */
    .splash-fault-summary { }
    .splash-fault-total {
      font-family: var(--font-mono);
      font-size: 14px;
      font-weight: 700;
      letter-spacing: 0.06em;
      color: #ef4444;
      margin-left: 8px;
      padding: 1px 7px;
      background: rgba(239, 68, 68, 0.12);
      border: 1px solid rgba(239, 68, 68, 0.32);
      border-radius: 3px;
    }
    .splash-fault-breakdown {
      grid-template-columns: repeat(5, 1fr);
    }
    .splash-fault-cell {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 2px;
      padding: 4px 3px;
      background: rgba(239, 68, 68, 0.06);
      border: 1px solid rgba(239, 68, 68, 0.14);
      border-radius: 3px;
      min-width: 0;
    }
    .splash-fault-cell b {
      font-family: var(--font-mono);
      font-size: 14px;
      font-weight: 600;
      color: #fecaca;
      line-height: 1.1;
    }
    .splash-fault-cell em {
      font-family: var(--font-mono);
      font-size: 8px;
      letter-spacing: 0.08em;
      color: rgba(254, 202, 202, 0.55);
      font-style: normal;
      text-transform: uppercase;
      text-align: center;
      line-height: 1.15;
    }
    .splash-crew-row {
      display: grid;
      grid-template-columns: 88px 1fr auto;
      gap: 8px;
      align-items: center;
      padding: 4px 6px;
      font-family: var(--font-mono);
      font-size: 11px;
      border-bottom: 1px dashed rgba(255, 255, 255, 0.05);
    }
    .splash-crew-row:last-child { border-bottom: none; }
    .splash-crew-role {
      color: rgba(0, 229, 255, 0.85);
      letter-spacing: 0.08em;
      font-size: 10px;
    }
    .splash-crew-status {
      color: #c5e0ff;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
    .splash-crew-status .tail {
      color: #ffd166;
      font-weight: 600;
    }
    .splash-crew-status.is-idle { color: rgba(197, 224, 255, 0.45); }
    .splash-crew-status.is-walking { color: #7dd3fc; }
    .splash-crew-status.is-working { color: #4ade80; }
    .splash-crew-status.is-returning { color: rgba(197, 224, 255, 0.55); }
    .splash-crew-dot {
      width: 7px; height: 7px; border-radius: 50%;
      background: rgba(216, 239, 255, 0.20);
    }
    .splash-crew-dot.is-walking { background: #7dd3fc; box-shadow: 0 0 6px #7dd3fc; }
    .splash-crew-dot.is-working { background: #4ade80; box-shadow: 0 0 6px #4ade80; animation: counter-live-pulse 1s ease-in-out infinite; }
    .splash-crew-dot.is-returning { background: rgba(197, 224, 255, 0.45); }
    .splash-activity-empty {
      font-family: var(--font-mono);
      font-size: 11px;
      color: rgba(216, 239, 255, 0.40);
      padding: 8px 0;
      text-align: center;
    }
    @media (max-width: 640px) {
      .splash-fleet-counts { grid-template-columns: repeat(3, 1fr); }
    }

    /* ===== PER-DESIGN FLIGHT BADGE + LOGS BUTTON ===== */
    .saved-design-flight-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 8px;
      margin-top: 6px;
      padding-top: 6px;
      border-top: 1px dashed rgba(255, 255, 255, 0.06);
    }
    .saved-design-flight-count {
      font-family: var(--font-mono);
      font-size: 10px;
      letter-spacing: 0.1em;
      color: var(--accent-cyan);
    }
    .saved-design-flight-count .num {
      color: #fff;
      font-weight: 600;
      margin-right: 4px;
    }
    .saved-design-logs-btn {
      font-family: var(--font-mono);
      font-size: 9px;
      letter-spacing: 0.14em;
      padding: 3px 8px;
      background: transparent;
      border: 1px solid var(--border);
      border-radius: 2px;
      color: var(--text-secondary);
      cursor: pointer;
      transition: all 0.15s;
    }
    .saved-design-logs-btn:hover {
      border-color: var(--accent-cyan);
      color: var(--accent-cyan);
      background: rgba(0, 229, 255, 0.05);
    }

    /* ===== FLIGHT LOGS MODAL ===== */
    .flight-logs-modal-backdrop {
      position: fixed;
      inset: 0;
      background: rgba(2, 6, 14, 0.78);
      backdrop-filter: blur(6px);
      z-index: 100;
      display: flex;
      align-items: center;
      justify-content: center;
      animation: fadeIn 0.2s ease;
    }
    @keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
    .flight-logs-modal {
      width: min(640px, 90vw);
      max-height: 80vh;
      background: rgba(8, 12, 24, 0.96);
      border: 1px solid var(--border-hi);
      border-radius: 4px;
      padding: 20px 24px;
      display: flex;
      flex-direction: column;
      gap: 12px;
      overflow: hidden;
    }
    .flight-logs-modal-header {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      padding-bottom: 12px;
      border-bottom: 1px solid var(--border);
    }
    .flight-logs-modal-title {
      font-family: var(--font-mono);
      font-size: 12px;
      letter-spacing: 0.18em;
      color: var(--accent-cyan);
    }
    .flight-logs-modal-close {
      background: transparent;
      border: 1px solid var(--border);
      color: var(--text-secondary);
      font-family: var(--font-mono);
      font-size: 10px;
      padding: 4px 10px;
      cursor: pointer;
      letter-spacing: 0.1em;
    }
    .flight-logs-modal-close:hover {
      border-color: var(--accent-red, #ff5060);
      color: var(--accent-red, #ff5060);
    }
    .flight-logs-modal-summary {
      font-family: var(--font-mono);
      font-size: 11px;
      color: var(--text-secondary);
      letter-spacing: 0.06em;
    }
    .flight-logs-modal-summary .total {
      color: #fff;
      font-weight: 600;
      font-size: 14px;
      margin: 0 4px;
    }
    .flight-logs-modal-list {
      overflow-y: auto;
      max-height: 60vh;
      padding-right: 4px;
    }
    .flight-log-row {
      display: grid;
      grid-template-columns: 100px 1fr 1fr 1fr 80px;
      gap: 12px;
      padding: 10px 8px;
      font-family: var(--font-mono);
      font-size: 11px;
      border-bottom: 1px dashed rgba(255, 255, 255, 0.06);
      color: var(--text-secondary);
      align-items: center;
    }
    .flight-log-row:last-child { border-bottom: none; }
    .flight-log-row .log-when { color: var(--accent-cyan); }
    .flight-log-row .log-route { color: #fff; }
    .flight-log-row .log-route .arrow { color: var(--text-secondary); margin: 0 6px; }
    .flight-log-row .log-customer { font-style: italic; }
    .flight-log-row .log-miles { text-align: right; }
    .flight-logs-empty {
      padding: 32px 0;
      text-align: center;
      color: var(--text-secondary);
      font-family: var(--font-mono);
      font-size: 12px;
      letter-spacing: 0.08em;
    }
    @keyframes slideIn {
      from { opacity: 0; transform: translateY(-8px); }
      to   { opacity: 1; transform: translateY(0); }
    }
    .saved-designs-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding-bottom: 10px;
      margin-bottom: 12px;
      border-bottom: 1px solid var(--border);
    }
    .saved-designs-label {
      font-family: var(--font-mono);
      font-size: 11px;
      letter-spacing: 0.18em;
      color: var(--accent-cyan);
    }
    .saved-designs-count {
      font-family: var(--font-mono);
      font-size: 10px;
      letter-spacing: 0.08em;
      color: var(--text-secondary);
    }
    .saved-designs-list {
      display: flex;
      flex-direction: column;
      gap: 6px;
    }
    .saved-design-card {
      display: grid;
      grid-template-columns: 1fr auto;
      gap: 4px;
      padding: 10px 12px;
      background: rgba(255, 255, 255, 0.025);
      border: 1px solid var(--border);
      border-radius: 3px;
      cursor: pointer;
      transition: all 0.18s;
      text-align: left;
      font-family: var(--font-mono);
    }
    .saved-design-card:hover {
      border-color: var(--accent-cyan);
      background: rgba(0, 229, 255, 0.06);
      transform: translateX(-2px);
    }
    .saved-design-name {
      font-size: 13px;
      color: var(--text-primary);
      letter-spacing: 0.04em;
      grid-column: 1;
    }
    .saved-design-tail {
      font-size: 9px;
      color: var(--accent-cyan);
      letter-spacing: 0.12em;
      grid-column: 2;
      grid-row: 1;
      align-self: start;
    }
    .saved-design-meta {
      font-size: 9px;
      color: var(--text-secondary);
      letter-spacing: 0.06em;
      grid-column: 1 / -1;
      display: flex;
      gap: 10px;
    }
    .saved-design-delete {
      grid-column: 2;
      grid-row: 2;
      background: transparent;
      border: 0;
      color: var(--text-secondary);
      font-family: var(--font-mono);
      font-size: 9px;
      cursor: pointer;
      padding: 0;
      letter-spacing: 0.1em;
    }
    .saved-design-delete:hover { color: #f87171; }

    .saved-designs-empty {
      padding: 18px 12px;
      text-align: center;
      font-family: var(--font-mono);
      font-size: 11px;
      color: var(--text-secondary);
      letter-spacing: 0.04em;
      background: rgba(255, 255, 255, 0.02);
      border: 1px dashed var(--border);
      border-radius: 3px;
      line-height: 1.5;
    }

    .splash-launchpad-btn {
      width: 100%;
      margin-top: 12px;
      padding: 12px 16px;
      background: rgba(0, 229, 255, 0.08);
      border: 1px solid rgba(0, 229, 255, 0.45);
      color: var(--accent-cyan);
      font-family: var(--font-mono);
      font-size: 11px;
      letter-spacing: 0.16em;
      cursor: pointer;
      border-radius: 3px;
      transition: all 0.18s;
      text-transform: uppercase;
    }
    .splash-launchpad-btn:hover {
      background: rgba(0, 229, 255, 0.18);
      border-color: var(--accent-cyan);
      box-shadow: 0 0 12px rgba(0, 229, 255, 0.3);
      transform: translateY(-1px);
    }
    .splash-launchpad-btn:active {
      transform: translateY(0);
    }

    /* ===== CUSTOMER MODE — splash button + view + cabin HUD ===== */
    .splash-customer-mode-row {
      display: flex;
      justify-content: center;
      margin-top: 14px;
    }
    .splash-customer-btn {
      display: inline-flex;
      flex-direction: row;     /* icon + label inline (no sublabel anymore) */
      align-items: center;
      gap: 10px;
      padding: 12px 32px;
      background: linear-gradient(180deg, rgba(255, 176, 60, 0.14), rgba(255, 176, 60, 0.04));
      border: 1px solid rgba(255, 176, 60, 0.50);
      border-radius: 4px;
      color: #FFB347;
      font-family: var(--font-mono);
      cursor: pointer;
      transition: all 0.18s;
      backdrop-filter: blur(6px);
    }
    .splash-customer-btn:hover {
      background: linear-gradient(180deg, rgba(255, 176, 60, 0.22), rgba(255, 176, 60, 0.08));
      border-color: rgba(255, 176, 60, 0.85);
      box-shadow: 0 6px 24px rgba(255, 176, 60, 0.18);
      transform: translateY(-1px);
    }
    .splash-customer-btn:active { transform: translateY(0); }
    .splash-customer-btn .customer-icon { font-size: 20px; line-height: 1; }
    .splash-customer-btn .customer-label {
      font-size: 14px;
      letter-spacing: 0.20em;
      font-weight: 600;
      color: #FFD580;
    }

    /* Customer-mode view (fullscreen overlay) */
    #customer-view {
      position: fixed;
      inset: 0;
      background: linear-gradient(180deg, #04080F 0%, #0A1428 100%);
      z-index: 50;
      display: none;
      flex-direction: column;
    }
    #customer-view.active { display: flex; }
    .customer-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 20px 32px;
      border-bottom: 1px solid var(--border);
    }
    .customer-title {
      font-family: var(--font-mono);
      font-size: 14px;
      letter-spacing: 0.20em;
      color: #FFB347;
    }
    .customer-back-btn {
      font-family: var(--font-mono);
      font-size: 11px;
      letter-spacing: 0.14em;
      padding: 8px 14px;
      background: transparent;
      border: 1px solid var(--border);
      color: var(--text-secondary);
      border-radius: 3px;
      cursor: pointer;
      transition: all 0.15s;
    }
    .customer-back-btn:hover {
      border-color: var(--accent-cyan);
      color: var(--accent-cyan);
    }
    .customer-body {
      flex: 1;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 24px;
      padding: 28px 40px;
      max-width: 1200px;
      margin: 0 auto;
      width: 100%;
      box-sizing: border-box;
    }
    .customer-section {
      background: rgba(8, 12, 24, 0.65);
      border: 1px solid var(--border-hi);
      border-radius: 4px;
      padding: 18px 20px;
      backdrop-filter: blur(8px);
    }
    .customer-section h3 {
      font-family: var(--font-mono);
      font-size: 11px;
      letter-spacing: 0.20em;
      color: var(--accent-cyan);
      margin: 0 0 14px 0;
      padding-bottom: 8px;
      border-bottom: 1px dashed var(--border);
    }
    .customer-pickup-grid,
    .customer-dropoff-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 6px;
    }
    .customer-city-btn {
      padding: 8px 10px;
      background: rgba(255, 255, 255, 0.025);
      border: 1px solid var(--border);
      border-radius: 3px;
      color: var(--text-primary);
      font-family: var(--font-mono);
      font-size: 11px;
      letter-spacing: 0.04em;
      text-align: left;
      cursor: pointer;
      transition: all 0.15s;
    }
    .customer-city-btn:hover {
      border-color: var(--accent-cyan);
      background: rgba(0, 229, 255, 0.05);
    }
    .customer-city-btn.selected {
      border-color: #FFB347;
      background: rgba(255, 176, 60, 0.10);
      color: #FFB347;
    }
    .customer-city-btn .city-distance {
      display: block;
      font-size: 9px;
      letter-spacing: 0.06em;
      color: var(--text-secondary);
      margin-top: 2px;
    }
    .customer-city-btn.selected .city-distance { color: rgba(255, 176, 60, 0.7); }
    .customer-aircraft-list {
      max-height: 280px;
      overflow-y: auto;
      display: flex;
      flex-direction: column;
      gap: 6px;
    }
    .customer-aircraft-card {
      display: grid;
      grid-template-columns: 1fr auto;
      gap: 4px;
      padding: 10px 12px;
      background: rgba(255, 255, 255, 0.025);
      border: 1px solid var(--border);
      border-radius: 3px;
      cursor: pointer;
      transition: all 0.15s;
      font-family: var(--font-mono);
      text-align: left;
    }
    .customer-aircraft-card:hover {
      border-color: var(--accent-cyan);
      background: rgba(0, 229, 255, 0.05);
    }
    .customer-aircraft-card.selected {
      border-color: #FFB347;
      background: rgba(255, 176, 60, 0.10);
    }
    .customer-aircraft-name {
      font-size: 12px;
      color: #fff;
      font-weight: 500;
    }
    .customer-aircraft-tail {
      font-size: 11px;
      color: var(--accent-cyan);
    }
    .customer-aircraft-meta {
      grid-column: 1 / -1;
      font-size: 9px;
      letter-spacing: 0.06em;
      color: var(--text-secondary);
    }
    .customer-aircraft-card.selected .customer-aircraft-tail { color: #FFB347; }

    /* Per-state visual treatment. AVAILABLE looks normal; IN FLIGHT and
       CHARGING are dimmed with desaturation + not-allowed cursor so the
       user can't pick them. The pill color picks up the same color
       families: cyan for available, amber for in-flight, blue for
       charging. */
    .customer-aircraft-card.status-in_flight,
    .customer-aircraft-card.status-charging {
      opacity: 0.55;
      cursor: not-allowed;
      filter: grayscale(0.4);
    }
    .customer-aircraft-card.status-in_flight:hover,
    .customer-aircraft-card.status-charging:hover {
      border-color: var(--border);
      background: transparent;
    }
    .customer-aircraft-card.status-available {
      /* Subtle green-tinted left border to highlight available aircraft */
      box-shadow: inset 3px 0 0 0 #4ade80;
    }
    .customer-aircraft-card.status-available.selected {
      box-shadow: inset 3px 0 0 0 #FFB347;     /* selection overrides green hint */
    }

    /* Top row: name + status pill aligned horizontally */
    .customer-aircraft-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 12px;
      grid-column: 1 / -1;
    }

    /* Status pills — small inline badges */
    .status-pill {
      font-family: var(--font-mono);
      font-size: 9px;
      font-weight: 600;
      letter-spacing: 0.08em;
      padding: 2px 8px;
      border-radius: 3px;
      white-space: nowrap;
    }
    .pill-available {
      color: #4ade80;
      background: rgba(74, 222, 128, 0.12);
      border: 1px solid rgba(74, 222, 128, 0.35);
    }
    .pill-flight {
      color: #fbbf24;
      background: rgba(251, 191, 36, 0.12);
      border: 1px solid rgba(251, 191, 36, 0.35);
    }
    .pill-charging {
      color: #60a5fa;
      background: rgba(96, 165, 250, 0.12);
      border: 1px solid rgba(96, 165, 250, 0.35);
    }

    .customer-aircraft-status {
      grid-column: 1 / -1;
      font-size: 9px;
      letter-spacing: 0.08em;
      color: var(--text-secondary);
      font-family: var(--font-mono);
    }
    .customer-aircraft-card.status-in_flight .customer-aircraft-status {
      color: #fbbf24;
    }
    .customer-aircraft-card.status-charging .customer-aircraft-status {
      color: #60a5fa;
    }

    /* Fleet summary header above the list — at-a-glance tally */
    .customer-fleet-summary {
      display: flex;
      gap: 14px;
      padding: 8px 12px;
      margin-bottom: 8px;
      background: rgba(0, 229, 255, 0.04);
      border: 1px solid var(--border);
      border-radius: 4px;
      font-family: var(--font-mono);
      font-size: 10px;
      letter-spacing: 0.06em;
      flex-wrap: wrap;
    }
    .fleet-stat-available { color: #4ade80; }
    .fleet-stat-flight    { color: #fbbf24; }
    .fleet-stat-charging  { color: #60a5fa; }
    .customer-no-aircraft {
      padding: 24px 12px;
      text-align: center;
      color: var(--text-secondary);
      font-family: var(--font-mono);
      font-size: 11px;
      letter-spacing: 0.06em;
      line-height: 1.6;
    }
    .customer-summary {
      padding: 16px 20px;
      background: rgba(255, 176, 60, 0.05);
      border: 1px solid rgba(255, 176, 60, 0.30);
      border-radius: 4px;
      font-family: var(--font-mono);
      font-size: 11px;
      letter-spacing: 0.06em;
      color: var(--text-secondary);
      margin-top: 12px;
    }
    .customer-summary .pickup, .customer-summary .dropoff, .customer-summary .aircraft {
      color: #FFB347;
      font-weight: 500;
    }
    .customer-hail-btn {
      width: 100%;
      padding: 14px;
      background: linear-gradient(180deg, rgba(255, 176, 60, 0.20), rgba(255, 176, 60, 0.08));
      border: 1px solid rgba(255, 176, 60, 0.65);
      border-radius: 4px;
      color: #FFD580;
      font-family: var(--font-mono);
      font-size: 14px;
      font-weight: 600;
      letter-spacing: 0.20em;
      cursor: pointer;
      transition: all 0.18s;
      margin-top: 18px;
    }
    .customer-hail-btn:hover:not(:disabled) {
      background: linear-gradient(180deg, rgba(255, 176, 60, 0.30), rgba(255, 176, 60, 0.12));
      box-shadow: 0 8px 32px rgba(255, 176, 60, 0.25);
      transform: translateY(-1px);
    }
    .customer-hail-btn:disabled {
      opacity: 0.4;
      cursor: not-allowed;
      filter: saturate(0.5);
    }

    /* Cabin HUD — overlays the dispatch view when in cabin chair view */
    .cabin-hud {
      position: fixed;
      inset: 0;
      pointer-events: none;
      z-index: 40;
      display: none;
    }
    .cabin-hud.active { display: block; }
    .cabin-hud-frame {
      position: absolute;
      inset: 16px;
      border: 2px solid rgba(255, 176, 60, 0.35);
      border-radius: 6px;
      box-shadow: inset 0 0 80px rgba(0, 0, 0, 0.45);
    }
    .cabin-hud-status {
      position: absolute;
      top: 30px;
      left: 50%;
      transform: translateX(-50%);
      padding: 10px 22px;
      background: rgba(2, 6, 14, 0.78);
      border: 1px solid rgba(255, 176, 60, 0.50);
      border-radius: 3px;
      font-family: var(--font-mono);
      font-size: 12px;
      letter-spacing: 0.18em;
      color: #FFD580;
      backdrop-filter: blur(6px);
    }
    .cabin-hud-bottom {
      position: absolute;
      bottom: 28px;
      left: 50%;
      transform: translateX(-50%);
      display: flex;
      gap: 12px;
      align-items: center;
    }
    .cabin-hud-exit {
      pointer-events: auto;
      padding: 12px 22px;
      background: rgba(255, 80, 96, 0.12);
      border: 1px solid rgba(255, 80, 96, 0.55);
      border-radius: 3px;
      color: #FF8090;
      font-family: var(--font-mono);
      font-size: 11px;
      letter-spacing: 0.20em;
      cursor: pointer;
      backdrop-filter: blur(6px);
      transition: all 0.15s;
    }
    .cabin-hud-exit:hover {
      background: rgba(255, 80, 96, 0.22);
      border-color: rgba(255, 80, 96, 0.85);
    }
    /* Cabin lock toast — flashes when the user tries to exit the cabin
       midflight. Auto-hides after 1.8s. */
    .cabin-locked-toast {
      position: fixed;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%) scale(0.85);
      padding: 18px 28px;
      background: rgba(20, 14, 10, 0.92);
      border: 1px solid rgba(255, 200, 80, 0.85);
      border-radius: 4px;
      color: #FFC850;
      font-family: var(--font-mono);
      font-size: 13px;
      letter-spacing: 0.22em;
      font-weight: 600;
      box-shadow: 0 8px 32px rgba(0, 0, 0, 0.55), 0 0 24px rgba(255, 200, 80, 0.2);
      pointer-events: none;
      opacity: 0;
      z-index: 9999;
      transition: opacity 0.18s ease, transform 0.18s ease;
      backdrop-filter: blur(8px);
    }
    .cabin-locked-toast.show {
      opacity: 1;
      transform: translate(-50%, -50%) scale(1);
    }
    .cabin-hud-tip {
      font-family: var(--font-mono);
      font-size: 10px;
      letter-spacing: 0.14em;
      color: rgba(255, 255, 255, 0.55);
      padding: 8px 14px;
      background: rgba(2, 6, 14, 0.6);
      border: 1px solid rgba(255, 255, 255, 0.10);
      border-radius: 3px;
    }

    /* Board / disembark prompt — appears when aircraft is at apron during boarding/disembark */
    .cabin-board-prompt {
      position: fixed;
      bottom: 100px;
      left: 50%;
      transform: translateX(-50%);
      padding: 18px 28px;
      background: rgba(2, 6, 14, 0.85);
      border: 2px solid #FFB347;
      border-radius: 6px;
      font-family: var(--font-mono);
      letter-spacing: 0.16em;
      z-index: 35;
      display: none;
      flex-direction: column;
      align-items: center;
      gap: 8px;
      pointer-events: auto;
      animation: pulseGlow 2s ease-in-out infinite;
    }
    .cabin-board-prompt.active { display: flex; }
    @keyframes pulseGlow {
      0%, 100% { box-shadow: 0 0 0 rgba(255, 176, 60, 0); }
      50%      { box-shadow: 0 0 32px rgba(255, 176, 60, 0.45); }
    }
    .cabin-board-prompt .prompt-text {
      font-size: 13px;
      color: #FFD580;
    }
    .cabin-board-prompt .prompt-keys {
      font-size: 10px;
      color: rgba(255, 255, 255, 0.6);
    }
    .cabin-board-prompt kbd {
      display: inline-block;
      padding: 2px 8px;
      margin: 0 2px;
      background: rgba(255, 176, 60, 0.18);
      border: 1px solid rgba(255, 176, 60, 0.5);
      border-radius: 2px;
      color: #FFD580;
      font-family: var(--font-mono);
      font-size: 10px;
    }

    ::-webkit-scrollbar { width: 5px; }
    ::-webkit-scrollbar-track { background: transparent; }
    ::-webkit-scrollbar-thumb { background: var(--border); border-radius: 2px; }
    ::-webkit-scrollbar-thumb:hover { background: var(--border-hi); }

    /* ============================================================ */
    /* CUSTOMER ↔ OPERATOR SMS CHAT
       Floating phone-like chat panel shown in customer mode. User types
       messages, operator auto-responds with context-aware canned replies.
       Lower-right corner so it doesn't cover the cabin HUD or board prompt.
       Collapsible (header click toggles between minimized and expanded).
       ============================================================ */
    .customer-chat-panel {
      position: fixed;
      bottom: 16px;
      right: 16px;
      width: 320px;
      max-height: 480px;
      background: rgba(8, 12, 22, 0.95);
      border: 1px solid var(--border-hi);
      border-radius: 12px;
      box-shadow: 0 8px 32px rgba(0, 0, 0, 0.6);
      font-family: var(--font-system, -apple-system, sans-serif);
      z-index: 36;
      display: none;
      flex-direction: column;
      overflow: hidden;
      backdrop-filter: blur(8px);
    }
    .customer-chat-panel.active { display: flex; }
    .customer-chat-panel.collapsed { max-height: 56px; }
    .customer-chat-panel.collapsed .customer-chat-body,
    .customer-chat-panel.collapsed .customer-chat-input-row { display: none; }
    .customer-chat-header {
      display: flex; align-items: center; gap: 10px;
      padding: 12px 14px;
      background: linear-gradient(180deg, rgba(0, 229, 255, 0.18), rgba(0, 229, 255, 0.06));
      border-bottom: 1px solid var(--border);
      cursor: pointer;
      user-select: none;
    }
    .customer-chat-avatar {
      width: 32px; height: 32px; border-radius: 50%;
      background: linear-gradient(135deg, #00E5FF, #0095b3);
      display: flex; align-items: center; justify-content: center;
      font-weight: 700; color: #042; font-size: 14px;
      flex-shrink: 0;
    }
    .customer-chat-header-text {
      flex: 1; min-width: 0;
    }
    .customer-chat-name {
      font-size: 13px; color: #fff; font-weight: 600;
      white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    }
    .customer-chat-status {
      font-size: 10px; color: #6ee7b7; letter-spacing: 0.05em;
      display: flex; align-items: center; gap: 4px;
    }
    .customer-chat-status::before {
      content: ''; width: 6px; height: 6px; border-radius: 50%;
      background: #6ee7b7; box-shadow: 0 0 6px #6ee7b7;
    }
    .customer-chat-toggle {
      color: var(--text-secondary);
      font-size: 16px;
      padding: 4px 8px;
      border-radius: 4px;
    }
    .customer-chat-body {
      flex: 1;
      overflow-y: auto;
      padding: 10px 12px;
      display: flex; flex-direction: column; gap: 6px;
      min-height: 200px;
      max-height: 340px;
    }
    .customer-chat-msg {
      max-width: 78%;
      padding: 8px 12px;
      border-radius: 16px;
      font-size: 13px;
      line-height: 1.35;
      word-wrap: break-word;
      animation: smsBubbleIn 0.18s ease-out;
    }
    @keyframes smsBubbleIn {
      from { opacity: 0; transform: translateY(4px); }
      to   { opacity: 1; transform: translateY(0); }
    }
    .customer-chat-msg.them {
      align-self: flex-start;
      background: rgba(255, 255, 255, 0.08);
      color: #e8f4f8;
      border-bottom-left-radius: 4px;
    }
    .customer-chat-msg.me {
      align-self: flex-end;
      background: linear-gradient(135deg, #00E5FF, #0095b3);
      color: #042;
      border-bottom-right-radius: 4px;
    }
    .customer-chat-msg.system {
      align-self: center;
      background: transparent;
      color: rgba(255,255,255,0.5);
      font-size: 11px;
      font-style: italic;
      padding: 4px 8px;
    }
    .customer-chat-typing {
      align-self: flex-start;
      background: rgba(255, 255, 255, 0.08);
      padding: 8px 14px;
      border-radius: 16px;
      border-bottom-left-radius: 4px;
      display: none;
    }
    .customer-chat-typing.active { display: inline-block; }
    .customer-chat-typing span {
      display: inline-block;
      width: 6px; height: 6px;
      border-radius: 50%;
      background: rgba(255,255,255,0.6);
      margin: 0 1px;
      animation: smsTypingDot 1.2s infinite;
    }
    .customer-chat-typing span:nth-child(2) { animation-delay: 0.15s; }
    .customer-chat-typing span:nth-child(3) { animation-delay: 0.3s; }
    @keyframes smsTypingDot {
      0%, 60%, 100% { transform: translateY(0); opacity: 0.4; }
      30%           { transform: translateY(-4px); opacity: 1; }
    }
    .customer-chat-input-row {
      display: flex; gap: 6px;
      padding: 10px 12px;
      border-top: 1px solid var(--border);
      background: rgba(0, 0, 0, 0.3);
    }
    .customer-chat-input {
      flex: 1;
      padding: 8px 12px;
      background: rgba(255, 255, 255, 0.06);
      border: 1px solid var(--border);
      border-radius: 18px;
      color: #fff;
      font-family: inherit;
      font-size: 13px;
      outline: none;
    }
    .customer-chat-input:focus {
      border-color: #00E5FF;
      background: rgba(0, 229, 255, 0.08);
    }
    .customer-chat-send {
      padding: 8px 14px;
      background: linear-gradient(135deg, #00E5FF, #0095b3);
      border: none;
      border-radius: 18px;
      color: #042;
      font-weight: 600;
      font-size: 12px;
      cursor: pointer;
      letter-spacing: 0.04em;
    }
    .customer-chat-send:hover { filter: brightness(1.15); }
    .customer-chat-send:disabled { opacity: 0.4; cursor: not-allowed; }

    /* HAIL ANOTHER RIDE button — appears when user is at dropoff city.
       Sits at the top-center of the screen so it's prominent without
       blocking the chat panel or cabin HUD. Hidden by default; shown
       via [hidden] removal when stage === 'at_dropoff' && !inCabin. */
    .customer-rehail-btn {
      position: fixed;
      top: 80px;
      left: 50%;
      transform: translateX(-50%);
      padding: 12px 24px;
      background: linear-gradient(135deg, #00E5FF, #0095b3);
      border: none;
      border-radius: 28px;
      color: #042;
      font-family: var(--font-mono);
      font-weight: 700;
      font-size: 13px;
      letter-spacing: 0.12em;
      cursor: pointer;
      box-shadow: 0 4px 24px rgba(0, 229, 255, 0.4);
      z-index: 36;
      display: flex;
      align-items: center;
      gap: 8px;
      animation: rehailPulse 2.4s ease-in-out infinite;
    }
    .customer-rehail-btn[hidden] { display: none; }
    .customer-rehail-btn:hover {
      filter: brightness(1.15);
      transform: translateX(-50%) translateY(-1px);
    }
    .customer-rehail-btn .rehail-icon {
      font-size: 16px;
      filter: drop-shadow(0 0 4px rgba(255, 255, 255, 0.5));
    }
    @keyframes rehailPulse {
      0%, 100% { box-shadow: 0 4px 24px rgba(0, 229, 255, 0.4); }
      50%      { box-shadow: 0 4px 36px rgba(0, 229, 255, 0.7); }
    }

    /* ============================================================ */
    /* AI DESIGN ENGINEER                                           */
    /* ============================================================ */
    .ai-section {
      background: linear-gradient(180deg, rgba(0, 229, 255, 0.05) 0%, transparent 100%);
      border-bottom: 1px solid var(--border-hi);
    }
    .ai-generate-section {
      background: linear-gradient(180deg, rgba(255, 176, 60, 0.06) 0%, rgba(0, 229, 255, 0.04) 50%, transparent 100%);
      border-bottom: 1px solid var(--border-hi);
    }
    .ai-generate-section .section-label > span:first-of-type::before {
      content: '◆';
      color: #ffb03c;
      font-size: 9px;
      margin-right: 4px;
    }
    .ai-describe {
      min-height: 64px;
      border-color: rgba(255, 176, 60, 0.3) !important;
    }
    .ai-describe:focus {
      border-color: #ffb03c !important;
      background: rgba(255, 176, 60, 0.05) !important;
    }
    /* ===== AI MANUFACTURING TEAM SECTION ===== */
    .ai-team-section {
      background: linear-gradient(180deg, rgba(0, 229, 255, 0.04), rgba(0, 229, 255, 0.01));
      border: 1px solid rgba(0, 229, 255, 0.20);
    }
    .ai-team-badge {
      background: rgba(74, 222, 128, 0.15) !important;
      border-color: rgba(74, 222, 128, 0.40) !important;
      color: #4ade80 !important;
    }
    .ai-team-hint {
      font-family: var(--font-mono);
      font-size: 10.5px;
      letter-spacing: 0.04em;
      line-height: 1.5;
      color: rgba(220, 230, 240, 0.65);
      margin: 6px 0 10px;
    }
    .ai-team-roster {
      display: flex;
      flex-wrap: wrap;
      gap: 4px;
      margin-bottom: 10px;
      min-height: 22px;
    }
    .ai-team-member {
      display: inline-flex;
      align-items: center;
      gap: 4px;
      padding: 3px 7px 3px 5px;
      background: rgba(0, 229, 255, 0.06);
      border: 1px solid rgba(0, 229, 255, 0.22);
      border-radius: 3px;
      font-family: var(--font-mono);
      font-size: 9.5px;
      letter-spacing: 0.05em;
      color: rgba(220, 235, 245, 0.85);
    }
    .ai-team-member .ai-team-member-role {
      font-size: 8.5px;
      letter-spacing: 0.10em;
      color: var(--accent-cyan);
      opacity: 0.75;
    }
    .ai-team-member.assigned {
      background: rgba(74, 222, 128, 0.10);
      border-color: rgba(74, 222, 128, 0.50);
    }
    .ai-team-member.assigned .ai-team-member-role {
      color: #4ade80;
    }
    /* Working pulse — assigned chips glow + brighten in a 1.4s cycle
       so the team visibly looks like they're on the job. User: "do
       they actually build aircraft or they just stand there?" */
    .ai-team-member.assigned.working {
      animation: ai-team-pulse 1.4s ease-in-out infinite;
      box-shadow: 0 0 0 1px rgba(74, 222, 128, 0.40);
    }
    @keyframes ai-team-pulse {
      0%, 100% {
        background: rgba(74, 222, 128, 0.10);
        box-shadow: 0 0 0 1px rgba(74, 222, 128, 0.30), 0 0 0 rgba(74, 222, 128, 0);
      }
      50% {
        background: rgba(74, 222, 128, 0.22);
        box-shadow: 0 0 0 1px rgba(74, 222, 128, 0.65), 0 0 12px rgba(74, 222, 128, 0.35);
      }
    }
    /* The "active worker" — currently-narrating member shines a touch
       brighter so the user can see who's doing what right now. */
    .ai-team-member.assigned.working.active-worker {
      animation-duration: 0.9s;
      background: rgba(74, 222, 128, 0.30);
      border-color: rgba(74, 222, 128, 0.85);
    }
    .ai-team-roster-loading {
      font-family: var(--font-mono);
      font-size: 10px;
      letter-spacing: 0.10em;
      color: rgba(255, 255, 255, 0.4);
    }
    .ai-team-design-btn {
      width: 100%;
      padding: 12px 14px;
      background: linear-gradient(180deg, rgba(0, 229, 255, 0.18), rgba(0, 229, 255, 0.08));
      border: 1px solid rgba(0, 229, 255, 0.55);
      border-radius: 3px;
      color: var(--accent-cyan);
      font-family: var(--font-mono);
      font-size: 11.5px;
      letter-spacing: 0.16em;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.15s;
    }
    .ai-team-design-btn:hover {
      background: linear-gradient(180deg, rgba(0, 229, 255, 0.30), rgba(0, 229, 255, 0.14));
      border-color: var(--accent-cyan);
    }
    .ai-team-design-btn:disabled,
    .ai-team-design-btn.working {
      cursor: progress;
      opacity: 0.85;
      background: linear-gradient(180deg, rgba(255, 200, 80, 0.18), rgba(255, 200, 80, 0.06));
      border-color: rgba(255, 200, 80, 0.55);
      color: #FFC850;
    }
    .ai-team-status {
      margin-top: 8px;
      min-height: 14px;
      font-family: var(--font-mono);
      font-size: 10px;
      letter-spacing: 0.06em;
      line-height: 1.5;
      color: rgba(220, 230, 240, 0.65);
    }
    .ai-team-status.success { color: #4ade80; }
    .ai-team-status.error   { color: #ff8090; }
    .ai-templates {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 4px;
      margin: 8px 0;
    }
    .ai-template {
      background: transparent;
      border: 1px solid var(--border);
      color: var(--text-secondary);
      font-family: var(--font-mono);
      font-size: 9px;
      padding: 6px 5px;
      cursor: pointer;
      border-radius: 3px;
      letter-spacing: 0.04em;
      transition: all 0.15s;
      text-align: left;
    }
    .ai-template:hover {
      border-color: #ffb03c;
      background: rgba(255, 176, 60, 0.08);
      color: var(--text-primary);
    }
    .ai-generate-btn {
      background: linear-gradient(90deg, rgba(255, 176, 60, 0.15) 0%, rgba(0, 229, 255, 0.15) 100%);
      border-color: rgba(255, 176, 60, 0.5);
      color: #ffb03c;
      font-weight: 700;
    }
    .ai-generate-btn:hover {
      background: linear-gradient(90deg, rgba(255, 176, 60, 0.3) 0%, rgba(0, 229, 255, 0.3) 100%);
      box-shadow: 0 0 16px rgba(255, 176, 60, 0.25);
    }
    .ai-generate-btn.analyzing {
      animation: generatePulse 1.4s ease-in-out infinite;
    }
    @keyframes generatePulse {
      0%, 100% { box-shadow: 0 0 8px rgba(255, 176, 60, 0.3); }
      50%      { box-shadow: 0 0 24px rgba(255, 176, 60, 0.6); }
    }
    .ai-build-progress {
      margin-top: 10px;
      font-family: var(--font-mono);
    }
    .build-progress-label {
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 10px;
      color: var(--text-secondary);
      letter-spacing: 0.04em;
      margin-bottom: 4px;
    }
    #build-progress-current {
      color: #ffb03c;
      letter-spacing: 0.06em;
    }
    #build-progress-count {
      color: var(--accent-cyan);
      font-variant-numeric: tabular-nums;
    }
    .build-progress-bar {
      height: 4px;
      background: var(--border);
      border-radius: 2px;
      overflow: hidden;
    }
    .build-progress-fill {
      height: 100%;
      background: linear-gradient(90deg, #ffb03c 0%, #00E5FF 100%);
      transition: width 0.3s ease;
      width: 0%;
    }
    .ai-section .section-label {
      display: flex;
      align-items: center;
      justify-content: space-between;
    }
    .ai-section .section-label > span:first-of-type {
      display: flex;
      align-items: center;
      gap: 8px;
    }
    .ai-section .section-label > span:first-of-type::before {
      content: '';
      width: 4px; height: 4px;
      background: var(--accent-cyan);
      display: inline-block;
    }
    .ai-section .section-label::before { display: none; }
    .ai-badge {
      background: rgba(0, 229, 255, 0.1);
      border: 1px solid var(--accent-cyan-dim);
      color: var(--accent-cyan);
      padding: 3px 7px;
      font-size: 8px;
      letter-spacing: 1.5px;
      border-radius: 2px;
      font-weight: 500;
    }

    .ai-prompt {
      width: 100%;
      background: var(--bg-deep);
      border: 1px solid var(--border);
      color: var(--text-primary);
      font-family: var(--font-mono);
      font-size: 12px;
      padding: 11px 12px;
      border-radius: 4px;
      resize: none;
      min-height: 96px;
      line-height: 1.55;
      transition: border-color 0.18s, box-shadow 0.18s;
    }
    .ai-prompt:focus {
      outline: none;
      border-color: var(--accent-cyan);
      box-shadow: 0 0 0 1px rgba(0, 229, 255, 0.25);
    }
    .ai-prompt::placeholder {
      color: var(--text-muted);
      line-height: 1.55;
    }

    .ai-suggestions {
      display: flex;
      flex-wrap: wrap;
      gap: 5px;
      margin: 10px 0 12px;
    }
    .ai-suggestion {
      background: var(--bg-panel-hi);
      border: 1px solid var(--border);
      color: var(--text-secondary);
      font-family: var(--font-mono);
      font-size: 9.5px;
      letter-spacing: 1.2px;
      text-transform: uppercase;
      padding: 5px 9px;
      border-radius: 3px;
      cursor: pointer;
      transition: all 0.15s;
    }
    .ai-suggestion:hover {
      border-color: var(--accent-cyan);
      color: var(--accent-cyan);
      background: rgba(0, 229, 255, 0.05);
    }

    /* ===== PARTS BANK ===== */
    .parts-category {
      font-family: var(--font-mono);
      font-size: 9px;
      letter-spacing: 2px;
      color: var(--accent-cyan);
      text-transform: uppercase;
      margin: 14px 0 6px;
      padding-bottom: 4px;
      border-bottom: 1px solid rgba(0, 229, 255, 0.18);
      opacity: 0.85;
    }
    .parts-category:first-of-type {
      margin-top: 8px;
    }
    .parts-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 6px;
    }
    .part-btn {
      background: var(--bg-panel-hi);
      border: 1px solid var(--border);
      color: var(--text-secondary);
      font-family: var(--font-mono);
      font-size: 10px;
      letter-spacing: 0.8px;
      text-transform: uppercase;
      padding: 9px 8px;
      border-radius: 3px;
      cursor: pointer;
      transition: all 0.15s;
      text-align: center;
      line-height: 1.25;
      /* Draggable parts: thumbnail above label */
      position: relative;
    }
    .part-btn[draggable="true"] {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: flex-end;
      gap: 6px;
      padding: 6px 4px 7px;
      min-height: 78px;
      cursor: grab;
    }
    .part-btn[draggable="true"]:active {
      cursor: grabbing;
    }
    .part-btn .part-thumb-preview {
      width: 56px;
      height: 44px;
      pointer-events: none;
      image-rendering: -webkit-optimize-contrast;
      image-rendering: crisp-edges;
      filter: drop-shadow(0 1px 2px rgba(0, 229, 255, 0.15));
      transition: transform 0.18s, filter 0.18s;
    }
    .part-btn:hover .part-thumb-preview {
      transform: scale(1.08);
      filter: drop-shadow(0 2px 6px rgba(0, 229, 255, 0.45));
    }
    .part-btn .part-label {
      font-size: 9px;
      letter-spacing: 0.6px;
      opacity: 0.85;
    }
    .part-btn.dragging {
      opacity: 0.4;
      border-style: dashed;
    }
    /* Drop indicator on viewport while dragging */
    .viewport.drop-active {
      box-shadow: inset 0 0 0 2px var(--accent-cyan);
      background: rgba(0, 229, 255, 0.03);
    }
    .viewport.drop-active::after {
      content: 'DROP TO PLACE PART';
      position: absolute;
      top: 50%; left: 50%;
      transform: translate(-50%, -50%);
      font-family: var(--font-mono);
      font-size: 11px;
      letter-spacing: 0.2em;
      color: var(--accent-cyan);
      background: rgba(2, 8, 23, 0.85);
      padding: 8px 16px;
      border: 1px solid var(--accent-cyan);
      border-radius: 3px;
      pointer-events: none;
      z-index: 9;
      animation: dropPulse 1.2s ease-in-out infinite;
    }
    @keyframes dropPulse {
      0%, 100% { opacity: 0.7; }
      50% { opacity: 1; }
    }
    .part-btn:hover {
      border-color: var(--accent-cyan);
      color: var(--accent-cyan);
      background: rgba(0, 229, 255, 0.07);
      transform: translateY(-1px);
    }
    .part-btn:active {
      transform: translateY(0);
      background: rgba(0, 229, 255, 0.15);
    }
    .part-btn-preset {
      background: rgba(0, 229, 255, 0.04);
      border-color: rgba(0, 229, 255, 0.35);
      color: var(--accent-cyan);
      font-weight: 500;
    }
    .part-btn-preset:hover {
      background: rgba(0, 229, 255, 0.12);
      border-color: var(--accent-cyan);
    }
    .parts-bank-section {
      max-height: none;
    }

    .ai-design-btn {
      width: 100%;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      padding: 12px 18px;
      background: rgba(0, 229, 255, 0.08);
      border: 1px solid var(--accent-cyan);
      color: var(--accent-cyan);
      font-family: var(--font-mono);
      font-size: 12px;
      letter-spacing: 2.5px;
      font-weight: 500;
      text-transform: uppercase;
      cursor: pointer;
      border-radius: 3px;
      transition: all 0.18s;
    }
    .ai-design-btn:hover {
      background: var(--accent-cyan);
      color: var(--bg-deep);
      box-shadow: 0 0 24px rgba(0, 229, 255, 0.45);
    }
    .ai-design-btn:disabled,
    .ai-design-btn.analyzing {
      pointer-events: none;
      background: transparent;
      color: var(--accent-cyan);
    }
    .ai-design-btn .ai-glyph {
      display: inline-block;
      width: 10px;
      height: 10px;
      border: 1.5px solid currentColor;
      transform: rotate(45deg);
    }
    .ai-design-btn.analyzing .ai-glyph {
      animation: ai-spin 1.2s linear infinite;
    }
    @keyframes ai-spin { to { transform: rotate(405deg); } }

    .ai-hint {
      font-family: var(--font-mono);
      font-size: 10px;
      letter-spacing: 0.8px;
      color: var(--text-muted);
      margin-bottom: 10px;
      line-height: 1.5;
    }
    .ai-hint .hint-cmd {
      color: var(--accent-cyan);
      background: rgba(0, 229, 255, 0.08);
      padding: 1px 5px;
      border-radius: 2px;
      font-weight: 500;
    }

    .ai-history {
      margin-top: 14px;
      max-height: 540px;
      overflow-y: auto;
      padding-right: 4px;
    }
    .ai-history:empty { display: none; }

    .chat-msg {
      margin-bottom: 11px;
      font-family: var(--font-mono);
      font-size: 11px;
      line-height: 1.55;
      animation: chat-in 0.28s ease-out;
    }
    @keyframes chat-in {
      from { opacity: 0; transform: translateY(-3px); }
      to { opacity: 1; transform: translateY(0); }
    }

    .chat-msg.user {
      color: var(--text-primary);
      border-left: 2px solid var(--accent-cyan);
      padding: 5px 0 5px 9px;
      background: rgba(0, 229, 255, 0.04);
    }
    .chat-msg.user::before {
      content: 'YOU';
      display: block;
      font-size: 8px;
      color: var(--accent-cyan);
      letter-spacing: 1.6px;
      font-weight: 500;
      margin-bottom: 3px;
    }

    .chat-msg.ai {
      color: var(--text-secondary);
      border-left: 2px solid var(--text-muted);
      padding: 5px 0 5px 9px;
    }
    .chat-msg.ai::before {
      content: 'ENGINEER';
      display: block;
      font-size: 8px;
      color: var(--text-muted);
      letter-spacing: 1.6px;
      font-weight: 500;
      margin-bottom: 3px;
    }
    .chat-msg.ai.error { border-left-color: #f59e0b; }
    .chat-msg.ai.error::before {
      content: 'ENGINEER · UNRECOGNIZED';
      color: #f59e0b;
    }
    .chat-msg.ai.success { border-left-color: var(--accent-success); }
    .chat-msg.ai.info { border-left-color: var(--accent-cyan); }
    .chat-msg.ai.info::before {
      content: 'ENGINEER · UNDO';
      display: block;
      font-size: 10px;
      letter-spacing: 0.12em;
      color: var(--accent-cyan);
      margin-bottom: 4px;
    }

    .chat-parsed {
      font-size: 9.5px;
      letter-spacing: 1px;
      color: var(--accent-cyan);
      text-transform: uppercase;
      margin-bottom: 4px;
      opacity: 0.85;
    }
    .chat-parsed .pkey { color: var(--text-muted); }
    .chat-parsed .pval { color: var(--accent-cyan); font-weight: 500; }

    .chat-result {
      color: var(--text-primary);
      font-size: 11px;
    }
    .chat-result .check { color: var(--accent-success); margin-right: 4px; }
    .chat-result .swatch {
      display: inline-block;
      width: 10px; height: 10px;
      vertical-align: middle;
      margin: 0 5px 0 3px;
      border: 1px solid var(--border-hi);
      border-radius: 2px;
    }
    .chat-result .val { color: var(--accent-cyan); }

    /* ============================================================ */
    /* EMPTY VIEWPORT STATE                                         */
    /* ============================================================ */
    .empty-state {
      position: absolute;
      inset: 0;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      pointer-events: none;
      z-index: 4;
      transition: opacity 0.6s ease;
    }
    .viewport.has-vehicle .empty-state {
      opacity: 0;
    }
    .empty-icon {
      width: 96px;
      height: 96px;
      margin-bottom: 28px;
      animation: empty-pulse 3.2s ease-in-out infinite;
      opacity: 0.5;
    }
    @keyframes empty-pulse {
      0%, 100% { transform: scale(1); opacity: 0.4; }
      50% { transform: scale(1.06); opacity: 0.75; }
    }
    .empty-title {
      font-family: var(--font-mono);
      font-size: 13px;
      letter-spacing: 5px;
      text-transform: uppercase;
      color: var(--text-secondary);
      margin-bottom: 10px;
    }
    .empty-subtitle {
      font-family: var(--font-mono);
      font-size: 10px;
      letter-spacing: 2px;
      text-transform: uppercase;
      color: var(--text-muted);
      max-width: 280px;
      text-align: center;
      line-height: 1.6;
    }
    .empty-arrow {
      margin-top: 24px;
      display: flex;
      align-items: center;
      gap: 8px;
      font-family: var(--font-mono);
      font-size: 9px;
      letter-spacing: 2px;
      text-transform: uppercase;
      color: var(--accent-cyan);
      opacity: 0.6;
    }
  </style>
</head>

<body>

  <!-- ====================================================== -->
  <!-- SPLASH VIEW                                            -->
  <!-- ====================================================== -->
  <div class="view active" id="splash-view">
    <div class="grid-bg"></div>
    <div class="stars" id="stars" aria-hidden="true"></div>

    <div class="corner-bracket tl"></div>
    <div class="corner-bracket tr"></div>
    <div class="corner-bracket bl"></div>
    <div class="corner-bracket br"></div>

    <header class="splash-hud-top">
      <div class="group">
        <span class="system-id">
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
            <path d="M7 1L13 7L7 13L1 7Z" stroke="currentColor" stroke-width="1.4"/>
            <circle cx="7" cy="7" r="2" fill="currentColor"/>
          </svg>
          SUPERDISPATCH
        </span>
        <span class="divider"></span>
        <span>SYS-ID 0X4A7C</span>
        <span class="divider"></span>
        <span>BUILD 2026.05.06.R2</span>
      </div>
      <div class="group">
        <span><span class="status-dot"></span>NETWORK ONLINE</span>
        <span class="divider"></span>
        <span id="splash-clock">00:00:00 UTC</span>
      </div>
    </header>

    <main class="hero">
      <h1 class="wordmark"><span class="super">Super</span><span class="dispatch">Dispatch</span></h1>
      <p class="tagline">Manufacture<span class="sep">/</span>Dispatch<span class="sep">/</span>Fly</p>

      <!-- TWO counters side by side:
           OPERATOR — flights YOU dispatched as an operator. Starts at 0,
             only increments when you launch a flight from the launchpad.
             Does NOT tick live; static between dispatch events.
           CUSTOMER — global air-taxi-network activity. Simulates flights
             from other operators across the network. Ticks live, with
             rate scaled by your hangar size (more designs = busier
             network simulation).
           Two separate localStorage keys so they're independent. -->
      <div class="splash-flight-counters">
        <div class="splash-flight-counter" aria-label="Operator flights — yours plus other operators">
          <span class="counter-label">OPERATOR FLIGHTS</span>
          <span class="counter-value" id="splash-operator-flights">0</span>
          <span class="counter-live" id="splash-operator-live" style="display:none"></span>
          <span class="counter-sublabel" id="splash-operator-available">— available to send</span>
        </div>
        <div class="splash-flight-counter" aria-label="Live customer network activity">
          <span class="counter-label">CUSTOMER FLIGHTS</span>
          <span class="counter-value" id="splash-customer-flights">0</span>
          <span class="counter-live" id="splash-flights-live" style="display:none"></span>
        </div>
      </div>

      <!-- LIVE ACTIVITY: live crew status + fleet summary. User asked
           for the splash to show "what all is happening and what the
           workers are working on, as well as the counters like a
           summary." Updates every 600ms when splash is active. -->
      <div class="splash-activity" id="splash-activity" aria-label="Live operations summary">
        <div class="splash-activity-section splash-fleet-summary" id="splash-fleet-summary">
          <span class="splash-activity-title">FLEET</span>
          <div class="splash-fleet-counts" id="splash-fleet-counts">
            <span class="splash-fleet-count"><b id="splash-fleet-total">0</b><em>total</em></span>
            <span class="splash-fleet-count"><b id="splash-fleet-available">0</b><em>ready</em></span>
            <span class="splash-fleet-count"><b id="splash-fleet-flying">0</b><em>airborne</em></span>
            <span class="splash-fleet-count"><b id="splash-fleet-charging">0</b><em>charging</em></span>
            <span class="splash-fleet-count"><b id="splash-fleet-prepping">0</b><em>prepping</em></span>
          </div>
        </div>
        <div class="splash-activity-section splash-network-summary" id="splash-network-summary">
          <span class="splash-activity-title">NETWORK ACTIVITY</span>
          <div class="splash-fleet-counts splash-network-counts">
            <span class="splash-fleet-count"><b id="splash-network-yours">0</b><em>yours flying</em></span>
            <span class="splash-fleet-count"><b id="splash-network-others">0</b><em>other ops</em></span>
            <span class="splash-fleet-count"><b id="splash-network-customers">0</b><em>customer flights</em></span>
            <span class="splash-fleet-count"><b id="splash-network-eta">—</b><em>next event</em></span>
          </div>
        </div>
        <!-- FAULTS — persistent tally of all injected aircraft failures
             (motor out, battery thermal, control link loss, avionics
             fault, compressor stall). Each cell is a per-kind counter;
             the headline number is the total. User: "Fault injections
             need to be counted on the splash screen." -->
        <div class="splash-activity-section splash-fault-summary" id="splash-fault-summary">
          <span class="splash-activity-title">FAULTS · LIFETIME
            <span class="splash-fault-total" id="splash-fault-total">0</span>
          </span>
          <div class="splash-fleet-counts splash-fault-breakdown" id="splash-fault-breakdown"></div>
        </div>
        <div class="splash-activity-section splash-crew-activity">
          <span class="splash-activity-title">RECENT ACTIVITY</span>
          <div class="splash-crew-list" id="splash-crew-list">
            <span class="splash-activity-empty">Watching network. Activity feed populates as flights complete.</span>
          </div>
        </div>
      </div>

      <!-- Customer mode entrypoint — placed BEFORE the launch button
           so it's always visible. The launch button's 340x280 SVG was
           pushing this below the fold when placed after it. User said
           "move up the customer button" 3 times — moving the HTML up
           is the only fix; CSS margin tweaks don't help when there's
           a giant SVG between this and the previous element.
           Customer mode is conceptually parallel to operator dispatch
           (the launch button below), so visual parallelism here is
           appropriate.
           Click behavior: User said "for customer mode change it to
           only say hail taxi, and a random taxi comes and picks you
           up, no option choosing all should be random." So this
           button no longer opens a picker view — it picks a random
           pickup, random different dropoff, and a random AVAILABLE
           aircraft, then dispatches immediately. -->
      <div class="splash-customer-mode-row">
        <button class="splash-customer-btn" id="splash-customer-btn" type="button" aria-label="Hail a random taxi from your fleet">
          <span class="customer-icon">👤</span>
          <span class="customer-label">HAIL TAXI</span>
        </button>
      </div>

      <button class="launch-btn" id="launch-btn" aria-label="Launch SuperDispatch">
        <svg class="air-taxi" width="340" height="280" viewBox="0 0 320 270" xmlns="http://www.w3.org/2000/svg">
          <defs>
            <linearGradient id="bodyGradTop" x1="0%" y1="0%" x2="0%" y2="100%">
              <stop offset="0%" stop-color="#5C9CE2"/>
              <stop offset="55%" stop-color="#2D5391"/>
              <stop offset="100%" stop-color="#0F1F40"/>
            </linearGradient>
            <linearGradient id="bodyGradSide" x1="0%" y1="0%" x2="0%" y2="100%">
              <stop offset="0%" stop-color="#1F3A6B"/>
              <stop offset="100%" stop-color="#050E22"/>
            </linearGradient>
            <linearGradient id="boomGrad" x1="0%" y1="0%" x2="0%" y2="100%">
              <stop offset="0%" stop-color="#3D72BD"/>
              <stop offset="45%" stop-color="#1F3A6B"/>
              <stop offset="100%" stop-color="#0A1A38"/>
            </linearGradient>
            <linearGradient id="boomHi" x1="0%" y1="0%" x2="0%" y2="100%">
              <stop offset="0%" stop-color="#7BB0E8"/>
              <stop offset="100%" stop-color="#3D72BD" stop-opacity="0"/>
            </linearGradient>
            <radialGradient id="rotorBlur">
              <stop offset="0%" stop-color="#85B7EB" stop-opacity="0.55"/>
              <stop offset="60%" stop-color="#85B7EB" stop-opacity="0.25"/>
              <stop offset="100%" stop-color="#85B7EB" stop-opacity="0"/>
            </radialGradient>
            <radialGradient id="domeShine" cx="35%" cy="30%">
              <stop offset="0%" stop-color="#9DC8F5" stop-opacity="0.7"/>
              <stop offset="60%" stop-color="#9DC8F5" stop-opacity="0"/>
            </radialGradient>
            <linearGradient id="sweepGrad" x1="0%" y1="0%" x2="100%" y2="100%">
              <stop offset="0%" stop-color="#00E5FF" stop-opacity="0.45"/>
              <stop offset="100%" stop-color="#00E5FF" stop-opacity="0"/>
            </linearGradient>
            <linearGradient id="playGrad" x1="0%" y1="0%" x2="100%" y2="0%">
              <stop offset="0%" stop-color="#7DF3FF"/>
              <stop offset="100%" stop-color="#00B8D4"/>
            </linearGradient>
            <filter id="softShadow" x="-50%" y="-50%" width="200%" height="200%">
              <feGaussianBlur stdDeviation="4"/>
            </filter>
            <g id="rotor">
              <ellipse cx="0" cy="6" rx="22" ry="11" fill="#000" opacity="0.4" filter="url(#softShadow)"/>
              <path d="M -22 0 L -22 5 Q -22 16 0 16 Q 22 16 22 5 L 22 0 Z" fill="#0A1A38"/>
              <ellipse cx="0" cy="0" rx="22" ry="11" fill="#1F3A6B" stroke="#00E5FF" stroke-width="1.4"/>
              <ellipse cx="0" cy="0" rx="18" ry="9" fill="none" stroke="#0088B0" stroke-width="0.6" opacity="0.7"/>
              <ellipse cx="-6" cy="-3" rx="10" ry="3" fill="#3D72BD" opacity="0.4"/>
              <ellipse cx="0" cy="0" rx="20" ry="10" fill="url(#rotorBlur)"/>
              <g class="rotor-blades">
                <ellipse cx="0" cy="0" rx="20" ry="2" fill="#85B7EB" opacity="0.6"/>
                <ellipse cx="0" cy="0" rx="20" ry="0.8" fill="#FFFFFF" opacity="0.4"/>
              </g>
              <circle cx="0" cy="0" r="3" fill="#00E5FF"/>
              <circle cx="-0.5" cy="-0.5" r="1" fill="#FFFFFF" opacity="0.9"/>
            </g>
          </defs>

          <ellipse class="halo" cx="160" cy="135" rx="135" ry="60" fill="none" stroke="#0088B0" stroke-width="0.6"/>
          <ellipse class="halo-2" cx="160" cy="135" rx="115" ry="51" fill="none" stroke="#0088B0" stroke-width="0.6"/>

          <g stroke="#0088B0" stroke-width="0.8" opacity="0.5">
            <line x1="160" y1="68" x2="160" y2="76"/>
